diff --git a/src/api/users.js b/src/api/users.js
index b024fa9..c7b65c1 100644
--- a/src/api/users.js
+++ b/src/api/users.js
@@ -1,13 +1,21 @@
 const crypto = require('node:crypto');
 
-exports.createUser = (db, { email, fullName }) => {
+exports.createUser = (db, { email, fullName, nickname }) => {
+  if (typeof email !== 'string' || !email.includes('@')) throw new Error(`invalid email: ${email}`);
   const row = { id: crypto.randomUUID(), email, fullname: fullName, created_at: new Date().toISOString() };
+  if (nickname !== undefined) row.nickname = nickname;
   db.insert('users', row);
   return exports.getUser(db, row.id);
 };
 
+const toUser = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null, nickname: r.nickname ?? null });
+
 exports.getUser = (db, id) => {
   const r = db.find('users', (u) => u.id === id);
   if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return toUser(r);
 };
+
+exports.listUsers = (db) => db.all('users')
+  .sort((a, b) => a.created_at.localeCompare(b.created_at))
+  .map(toUser);
diff --git a/test/users.test.js b/test/users.test.js
index bea7939..19b61ed 100644
--- a/test/users.test.js
+++ b/test/users.test.js
@@ -2,7 +2,14 @@ const test = require('node:test');
 const assert = require('node:assert');
 const { Db } = require('../src/db.js');
 const { migrate } = require('../src/migrate.js');
-const { createUser, getUser } = require('../src/api/users.js');
+const { createUser, getUser, listUsers } = require('../src/api/users.js');
+
+// Stand-in for a DBA-owned migration adding users.nickname (not yet in migrations/).
+const migrateWithNickname = () => {
+  const db = migrate(new Db());
+  db.addColumn('users', 'nickname');
+  return db;
+};
 
 test('creates and reads back a user', () => {
   const db = migrate(new Db());
@@ -10,3 +17,36 @@ test('creates and reads back a user', () => {
   assert.strictEqual(u.fullName, 'Ada Lovelace');
   assert.deepStrictEqual(getUser(db, u.id), u);
 });
+
+test('creates a user with a nickname and returns it from getUser', () => {
+  const db = migrateWithNickname();
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace', nickname: 'Ada' });
+  assert.strictEqual(getUser(db, u.id).nickname, 'Ada');
+});
+
+test('a user created without a nickname has nickname null and no nickname column value', () => {
+  const db = migrateWithNickname();
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  assert.strictEqual(getUser(db, u.id).nickname, null);
+  assert.strictEqual('nickname' in db.all('users')[0], false);
+});
+
+test('createUser throws when the email has no "@"', () => {
+  const db = migrate(new Db());
+  assert.throws(() => createUser(db, { email: 'ada.example.com', fullName: 'Ada Lovelace' }), /invalid email/);
+  assert.deepStrictEqual(db.all('users'), []);
+});
+
+test('listUsers returns all users sorted by createdAt, oldest first', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'c', email: 'c@example.com', fullname: 'C', created_at: '2024-03-01T00:00:00.000Z' });
+  db.insert('users', { id: 'a', email: 'a@example.com', fullname: 'A', created_at: '2024-01-01T00:00:00.000Z' });
+  db.insert('users', { id: 'b', email: 'b@example.com', fullname: 'B', created_at: '2024-02-01T00:00:00.000Z' });
+  assert.deepStrictEqual(listUsers(db).map((u) => u.id), ['a', 'b', 'c']);
+  assert.strictEqual(listUsers(db)[0].fullName, 'A');
+});
+
+test('listUsers returns an empty array when there are no users', () => {
+  const db = migrate(new Db());
+  assert.deepStrictEqual(listUsers(db), []);
+});