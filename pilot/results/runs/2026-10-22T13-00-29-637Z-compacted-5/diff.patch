+const { createUser, getUser, listUsers } = require('../src/api/users.js');
 
 test('creates and reads back a user', () => {
   const db = migrate(new Db());
@@ -10,3 +10,30 @@ test('creates and reads back a user', () => {
   assert.strictEqual(u.fullName, 'Ada Lovelace');
   assert.deepStrictEqual(getUser(db, u.id), u);
 });
+
+test('createUser stores an optional nickname; getUser returns null when unset', () => {
+  const db = migrate(new Db());
+  // Stand-in for the nickname column the DBA migration must add; migrations/ is not touched here.
+  db.addColumn('users', 'nickname');
+  const withNick = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace', nickname: 'Countess' });
+  const without = createUser(db, { email: 'bob@example.com', fullName: 'Bob' });
+  assert.strictEqual(getUser(db, withNick.id).nickname, 'Countess');
+  assert.strictEqual(getUser(db, without.id).nickname, null);
+});
+
+test('listUsers returns users sorted by createdAt, oldest first', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'b', email: 'b@example.com', fullname: 'B', created_at: '2026-02-01T00:00:00.000Z' });
+  db.insert('users', { id: 'a', email: 'a@example.com', fullname: 'A', created_at: '2026-01-01T00:00:00.000Z' });
+  db.insert('users', { id: 'c', email: 'c@example.com', fullname: 'C', created_at: '2026-03-01T00:00:00.000Z' });
+  assert.deepStrictEqual(listUsers(db).map((u) => u.id), ['a', 'b', 'c']);
+});
+
+test('listUsers returns an empty array when there are no users', () => {
+  assert.deepStrictEqual(listUsers(migrate(new Db())), []);
+});
+
+test('createUser throws when email has no "@"', () => {
+  const db = migrate(new Db());
+  assert.throws(() => createUser(db, { email: 'ada.example.com', fullName: 'Ada Lovelace' }), Error);
+});