 const crypto = require('node:crypto');
 
-exports.createUser = (db, { email, fullName }) => {
+const toUser = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, nickname: r.nickname ?? null, createdAt: r.created_at, lastLogin: r.last_login ?? null });
+
+exports.createUser = (db, { email, fullName, nickname }) => {
+  if (typeof email !== 'string' || !email.includes('@')) throw new Error(`invalid email: ${email}`);
   const row = { id: crypto.randomUUID(), email, fullname: fullName, created_at: new Date().toISOString() };
+  // Only write nickname when given, so databases without the nickname column still accept users who don't set one.
+  if (nickname !== undefined) row.nickname = nickname;
   db.insert('users', row);
   return exports.getUser(db, row.id);
 };
@@ -9,5 +14,10 @@ exports.createUser = (db, { email, fullName }) => {
 exports.getUser = (db, id) => {
   const r = db.find('users', (u) => u.id === id);
   if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return toUser(r);
 };
+
+// Oldest first. ISO timestamps sort correctly as strings; the sort is stable, so ties keep insertion order.
+exports.listUsers = (db) => db.all('users')
+  .sort((a, b) => (a.created_at < b.created_at ? -1 : a.created_at > b.created_at ? 1 : 0))
+  .map(toUser);
