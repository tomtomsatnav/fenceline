+
+test('returns the nickname for a user created with one', () => {
+  const db = migrate(new Db());
+  // The nickname column comes from a pending DBA migration; add it here so the test can run.
+  db.addColumn('users', 'nickname');
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace', nickname: 'Countess' });
+  assert.strictEqual(getUser(db, u.id).nickname, 'Countess');
+});
+
+test('nickname is null for a user created without one', () => {
+  const db = migrate(new Db());
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  assert.strictEqual(getUser(db, u.id).nickname, null);
+});
+
+test('createUser throws when the email has no "@"', () => {
+  const db = migrate(new Db());
+  assert.throws(() => createUser(db, { email: 'ada.example.com', fullName: 'Ada Lovelace' }), /invalid email/);
+  assert.strictEqual(db.all('users').length, 0);
+});
+
+test('listUsers returns all users sorted by createdAt, oldest first', () => {
+  const db = migrate(new Db());
+  const first = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  const second = createUser(db, { email: 'grace@example.com', fullName: 'Grace Hopper' });
+  const third = createUser(db, { email: 'alan@example.com', fullName: 'Alan Turing' });
+  // Force distinct, out-of-insertion-order timestamps so the sort is what orders the result.
+  db.tables.users.rows.find((r) => r.id === first.id).created_at = '2020-01-02T00:00:00.000Z';
+  db.tables.users.rows.find((r) => r.id === second.id).created_at = '2020-01-03T00:00:00.000Z';
+  db.tables.users.rows.find((r) => r.id === third.id).created_at = '2020-01-01T00:00:00.000Z';
+  assert.deepStrictEqual(listUsers(db).map((u) => u.id), [third.id, first.id, second.id]);
+});