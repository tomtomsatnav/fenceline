+const toUser = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, nickname: r.nickname ?? null, lastLogin: r.last_login ?? null });
+
 exports.getUser = (db, id) => {
   const r = db.find('users', (u) => u.id === id);
