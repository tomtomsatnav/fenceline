 const crypto = require('node:crypto');
 
-exports.createUser = (db, { email, fullName }) => {
-  const row = { id: crypto.randomUUID(), email, fullname: fullName, created_at: new Date().toISOString() };
+exports.createUser = (db, { email, fullName, nickname }) => {
+  if (typeof email !== 'string' || !email.includes('@')) throw new Error('invalid email: must contain "@"');
+  const row = { id: crypto.randomUUID(), email, fullname: fullName, nickname: nickname ?? null, created_at: new Date().toISOString() };
   db.insert('users', row);
   return exports.getUser(db, row.id);
 };
 
+const toUser = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, nickname: r.nickname ?? null, createdAt: r.created_at, lastLogin: r.last_login ?? null });
+
 exports.getUser = (db, id) => {
   const r = db.find('users', (u) => u.id === id);
   if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return toUser(r);
 };
+
+exports.listUsers = (db) => db.all('users').map(toUser).sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));
diff --git a/test/users.test.js b/test/users.test.js
index bea7939..92e5182 100644
--- a/test/users.test.js
+++ b/test/users.test.js
@@ -2,11 +2,49 @@ const test = require('node:test');
 const assert = require('node:assert');
 const { Db } = require('../src/db.js');
 const { migrate } = require('../src/migrate.js');
-const { createUser, getUser } = require('../src/api/users.js');
+const { createUser, getUser, listUsers } = require('../src/api/users.js');
 
-test('creates and reads back a user', () => {
+// The nickname column has no migration yet (DBA-owned), so the test adds it directly.
+const freshDb = () => {
   const db = migrate(new Db());
+  db.addColumn('users', 'nickname');
+  return db;
+};
+
+test('creates and reads back a user', () => {
+  const db = freshDb();
   const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
   assert.strictEqual(u.fullName, 'Ada Lovelace');
   assert.deepStrictEqual(getUser(db, u.id), u);
 });
+
+test('a user created with a nickname gets it back from getUser', () => {
+  const db = freshDb();
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace', nickname: 'Countess' });
+  assert.strictEqual(getUser(db, u.id).nickname, 'Countess');
+});
+
+test('a user created without a nickname gets nickname: null', () => {
+  const db = freshDb();
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  assert.strictEqual(getUser(db, u.id).nickname, null);
+});
+
+test('createUser throws when the email has no "@"', () => {
+  const db = migrate(new Db());
+  assert.throws(() => createUser(db, { email: 'ada.example.com', fullName: 'Ada Lovelace' }), Error);
+  assert.deepStrictEqual(db.all('users'), []);
+});
+
+test('listUsers returns all users sorted by createdAt, oldest first', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'b', email: 'b@example.com', fullname: 'B', created_at: '2026-03-02T00:00:00.000Z' });
+  db.insert('users', { id: 'a', email: 'a@example.com', fullname: 'A', created_at: '2026-01-15T00:00:00.000Z' });
+  db.insert('users', { id: 'c', email: 'c@example.com', fullname: 'C', created_at: '2026-02-20T00:00:00.000Z' });
+  assert.deepStrictEqual(listUsers(db).map((u) => u.id), ['a', 'c', 'b']);
+  assert.deepStrictEqual(listUsers(db)[0], getUser(db, 'a'));
+});
+
+test('listUsers returns an empty array when there are no users', () => {
+  assert.deepStrictEqual(listUsers(migrate(new Db())), []);
+});