-const { createUser, getUser } = require('../src/api/users.js');
+const { createUser, getUser, listUsers } = require('../src/api/users.js');
 
 test('creates and reads back a user', () => {
   const db = migrate(new Db());
@@ -10,3 +10,34 @@ test('creates and reads back a user', () => {
   assert.strictEqual(u.fullName, 'Ada Lovelace');
   assert.deepStrictEqual(getUser(db, u.id), u);
 });
+
+test('createUser stores an optional nickname and getUser returns it, or null when unset', () => {
+  const db = migrate(new Db());
+  db.addColumn('users', 'nickname'); // Stands in for the DBA's migration that adds this column.
+  const withNick = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace', nickname: 'Ada' });
+  const without = createUser(db, { email: 'bob@example.com', fullName: 'Bob' });
+  assert.strictEqual(getUser(db, withNick.id).nickname, 'Ada');
+  assert.strictEqual(getUser(db, without.id).nickname, null);
+});
+
+test('listUsers returns all users sorted by createdAt, oldest first', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'c', email: 'c@example.com', fullname: 'C', created_at: '2024-03-01T00:00:00.000Z' });
+  db.insert('users', { id: 'a', email: 'a@example.com', fullname: 'A', created_at: '2024-01-01T00:00:00.000Z' });
+  db.insert('users', { id: 'b', email: 'b@example.com', fullname: 'B', created_at: '2024-02-01T00:00:00.000Z' });
+  assert.deepStrictEqual(listUsers(db).map((u) => u.id), ['a', 'b', 'c']);
+  assert.strictEqual(listUsers(db)[0].fullName, 'A');
+});
+
+test('listUsers returns an empty array when there are no users', () => {
+  const db = migrate(new Db());
+  assert.deepStrictEqual(listUsers(db), []);
+});
+
+test('createUser throws when email has no "@"', () => {
+  const db = migrate(new Db());
+  assert.throws(
+    () => createUser(db, { email: 'ada.example.com', fullName: 'Ada Lovelace' }),
+    /must contain "@"/
+  );
+});