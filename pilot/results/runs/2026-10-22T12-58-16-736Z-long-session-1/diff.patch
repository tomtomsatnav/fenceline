-const { createUser, getUser } = require('../src/api/users.js');
+const { createUser, getUser, listUsers } = require('../src/api/users.js');
+
+// The nickname column is not in the migrations yet (DBA team owns them), so the
+// tests add it here. Production needs a DBA migration that adds users.nickname.
+const migrateWithNickname = () => {
+  const db = migrate(new Db());
+  db.addColumn('users', 'nickname');
+  return db;
+};
+
+test('stores and returns a nickname', () => {
+  const db = migrateWithNickname();
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace', nickname: 'Countess' });
+  assert.strictEqual(u.nickname, 'Countess');
+  assert.strictEqual(getUser(db, u.id).nickname, 'Countess');
+});
+
+test('nickname is null when not provided', () => {
+  const db = migrateWithNickname();
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  assert.strictEqual(u.nickname, null);
+  assert.strictEqual(getUser(db, u.id).nickname, null);
+});
 
 test('creates and reads back a user', () => {
   const db = migrate(new Db());
@@ -10,3 +32,19 @@ test('creates and reads back a user', () => {
   assert.strictEqual(u.fullName, 'Ada Lovelace');
   assert.deepStrictEqual(getUser(db, u.id), u);
 });
+
+test('listUsers returns all users sorted oldest first', () => {
+  const db = migrate(new Db());
+  const first = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  const second = createUser(db, { email: 'grace@example.com', fullName: 'Grace Hopper' });
+  // Insert out of creation order so the sort has to do the work.
+  db.tables.users.rows[0].created_at = '2026-02-01T00:00:00.000Z';
+  db.tables.users.rows[1].created_at = '2026-01-01T00:00:00.000Z';
+  assert.deepStrictEqual(listUsers(db).map((u) => u.id), [second.id, first.id]);
+});
+
+test('createUser throws when the email has no "@"', () => {
