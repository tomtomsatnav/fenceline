diff --git a/src/api/users.js b/src/api/users.js
index b024fa9..c12648d 100644
--- a/src/api/users.js
+++ b/src/api/users.js
@@ -1,6 +1,7 @@
 const crypto = require('node:crypto');
 
 exports.createUser = (db, { email, fullName }) => {
+  if (!email.includes('@')) throw new Error(`invalid email: ${email}`);
   const row = { id: crypto.randomUUID(), email, fullname: fullName, created_at: new Date().toISOString() };
   db.insert('users', row);
   return exports.getUser(db, row.id);
@@ -9,5 +10,13 @@ exports.createUser = (db, { email, fullName }) => {
 exports.getUser = (db, id) => {
   const r = db.find('users', (u) => u.id === id);
   if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return toUser(r);
 };
+
+// Oldest first. ISO timestamps sort correctly as strings; ties keep insertion order.
+exports.listUsers = (db) =>
+  db.all('users')
+    .sort((a, b) => (a.created_at < b.created_at ? -1 : a.created_at > b.created_at ? 1 : 0))
+    .map(toUser);
+
+const toUser = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null });
