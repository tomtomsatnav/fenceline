+const { createUser, getUser, listUsers } = require('../src/api/users.js');
 
 test('creates and reads back a user', () => {
   const db = migrate(new Db());
@@ -10,3 +10,33 @@ test('creates and reads back a user', () => {
   assert.strictEqual(u.fullName, 'Ada Lovelace');
   assert.deepStrictEqual(getUser(db, u.id), u);
 });
+
+test('nickname is stored and returned, and is null when not set', () => {
+  const db = migrate(new Db());
+  // The users table has no nickname column yet; a migration owned by the DBA must add it.
+  db.addColumn('users', 'nickname');
+  const named = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace', nickname: 'Countess' });
+  const plain = createUser(db, { email: 'grace@example.com', fullName: 'Grace Hopper' });
+  assert.strictEqual(getUser(db, named.id).nickname, 'Countess');
+  assert.strictEqual(getUser(db, plain.id).nickname, null);
+});
+
+test('createUser throws when the email has no @', () => {
+  const db = migrate(new Db());
+  assert.throws(
+    () => createUser(db, { email: 'ada.example.com', fullName: 'Ada Lovelace' }),
+    Error
+  );
+});
+
+test('listUsers returns all users, oldest first', () => {
+  const db = migrate(new Db());
+  const older = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  const newer = createUser(db, { email: 'grace@example.com', fullName: 'Grace Hopper' });
+  // Force a known order regardless of how fast the inserts ran.
+  db.tables.users.rows[0].created_at = '2020-01-01T00:00:00.000Z';
+  db.tables.users.rows[1].created_at = '2021-01-01T00:00:00.000Z';
+  assert.deepStrictEqual(listUsers(db), [getUser(db, older.id), getUser(db, newer.id)]);
+  db.tables.users.rows[0].created_at = '2022-01-01T00:00:00.000Z';
+  assert.deepStrictEqual(listUsers(db).map((u) => u.id), [newer.id, older.id]);
+});