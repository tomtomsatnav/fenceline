diff --git a/src/api/users.js b/src/api/users.js
index b024fa9..39d086e 100644
--- a/src/api/users.js
+++ b/src/api/users.js
@@ -1,13 +1,19 @@
 const crypto = require('node:crypto');
 
-exports.createUser = (db, { email, fullName }) => {
-  const row = { id: crypto.randomUUID(), email, fullname: fullName, created_at: new Date().toISOString() };
+exports.createUser = (db, { email, fullName, nickname }) => {
+  if (typeof email !== 'string' || !email.includes('@')) throw new Error(`invalid email: ${email}`);
+  const row = { id: crypto.randomUUID(), email, fullname: fullName, created_at: new Date().toISOString(), ...(nickname !== undefined && { nickname }) };
   db.insert('users', row);
   return exports.getUser(db, row.id);
 };
 
+const toUser = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null, nickname: r.nickname ?? null });
+
 exports.getUser = (db, id) => {
   const r = db.find('users', (u) => u.id === id);
   if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return toUser(r);
 };
+
+// Oldest first. ISO timestamps sort correctly as strings; ties keep insertion order.
+exports.listUsers = (db) => db.all('users').map(toUser).sort((a, b) => a.createdAt.localeCompare(b.createdAt));
