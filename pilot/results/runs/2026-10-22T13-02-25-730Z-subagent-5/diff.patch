@@ -10,3 +10,36 @@ test('creates and reads back a user', () => {
   assert.strictEqual(u.fullName, 'Ada Lovelace');
   assert.deepStrictEqual(getUser(db, u.id), u);
 });
+
+test('listUsers returns all users, oldest first', () => {
+  const db = migrate(new Db());
+  // Insert out of order with explicit timestamps so the test does not depend on the clock.
+  db.insert('users', { id: 'b', email: 'b@example.com', fullname: 'B', created_at: '2026-02-01T00:00:00.000Z' });
+  db.insert('users', { id: 'a', email: 'a@example.com', fullname: 'A', created_at: '2026-01-01T00:00:00.000Z' });
+  db.insert('users', { id: 'c', email: 'c@example.com', fullname: 'C', created_at: '2026-03-01T00:00:00.000Z' });
+  assert.deepStrictEqual(listUsers(db).map((u) => u.id), ['a', 'b', 'c']);
+  assert.deepStrictEqual(listUsers(db)[0], getUser(db, 'a'));
+});
+
+test('stores and returns a nickname, including in listUsers', () => {
+  const db = migrate(new Db());
+  // Stand-in for the DBA's future migration that adds the nickname column; migrate() does not add it.
+  db.addColumn('users', 'nickname');
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace', nickname: 'Ada' });
+  assert.strictEqual(getUser(db, u.id).nickname, 'Ada');
+  createUser(db, { email: 'bob@example.com', fullName: 'Bob Smith' });
+  assert.deepStrictEqual(listUsers(db).map((x) => x.nickname), ['Ada', null]);
+});
+
+test('nickname is null when omitted', () => {
+  const db = migrate(new Db());
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  assert.strictEqual(getUser(db, u.id).nickname, null);
+  assert.strictEqual(db.all('users')[0].nickname, undefined);
+});
+
+test('createUser throws when the email has no "@" and writes nothing', () => {
+  const db = migrate(new Db());
+  assert.throws(() => createUser(db, { email: 'ada.example.com', fullName: 'Ada Lovelace' }), Error);
+  assert.strictEqual(db.all('users').length, 0);
+});