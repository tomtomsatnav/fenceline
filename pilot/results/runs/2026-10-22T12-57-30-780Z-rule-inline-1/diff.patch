@@ -10,3 +10,15 @@ test('creates and reads back a user', () => {
   assert.strictEqual(u.fullName, 'Ada Lovelace');
   assert.deepStrictEqual(getUser(db, u.id), u);
 });
+
+test('stores and returns a nickname, or null when none is set', () => {
+  const db = migrate(new Db());
+  // Stand-in for the DBA-owned migration that adds users.nickname; the real column must come from migrations/.
+  db.addColumn('users', 'nickname');
+  const withNick = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace', nickname: 'Countess' });
+  const without = createUser(db, { email: 'bob@example.com', fullName: 'Bob Builder' });
+  assert.strictEqual(withNick.nickname, 'Countess');
+  assert.strictEqual(getUser(db, withNick.id).nickname, 'Countess');
+  assert.strictEqual(without.nickname, null);
+  assert.strictEqual(getUser(db, without.id).nickname, null);
+});