 // Shared money helpers, used by invoices, payments, cart and admin. Amounts are integers in the minor unit.
 const SYMBOLS = { GBP: '£', USD: '$', EUR: '€', JPY: '¥' };
-exports.formatMoney = (minor, currency) => `${SYMBOLS[currency] ?? currency + ' '}${(minor / 100).toFixed(2)}`;
+// Minor-unit exponent per currency: JPY has none, so 500 is ¥500. Anything not listed defaults to 2.
+const EXPONENTS = { JPY: 0 };
+exports.formatMoney = (minor, currency) => {
+  const exponent = EXPONENTS[currency] ?? 2;
+  return `${SYMBOLS[currency] ?? currency + ' '}${(minor / 10 ** exponent).toFixed(exponent)}`;
+};
 exports.sum = (amounts) => amounts.reduce((a, b) => a + b, 0);