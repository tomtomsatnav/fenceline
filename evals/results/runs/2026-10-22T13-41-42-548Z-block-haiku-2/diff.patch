 const { formatMoney } = require('../utils/money.js');
 // A payment receipt line, e.g. "Paid £12.50 by card".
-exports.renderReceipt = (payment) => `Paid ${formatMoney(payment.amount, payment.currency)} by ${payment.method}`;
+// Yen has no minor unit, so its amount is already whole yen; formatMoney would show it as ¥5.00.
+const formatReceiptAmount = (payment) =>
+  payment.currency === 'JPY' ? `¥${payment.amount}` : formatMoney(payment.amount, payment.currency);
+exports.renderReceipt = (payment) => `Paid ${formatReceiptAmount(payment)} by ${payment.method}`;