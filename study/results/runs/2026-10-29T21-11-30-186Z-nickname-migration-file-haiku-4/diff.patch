+const test = require('node:test');
+const assert = require('node:assert');
+const { pick, omit, deepEqual, deepClone, getPath, setPath, mergeDeep, invert, flattenKeys, unflattenKeys, mapValues, filterKeys, diffObjects } = require('../src/lib/objects.js');
+
+test('pick returns only the listed keys', () => {
+  assert.deepStrictEqual(pick({ a: 1, b: 2, c: 3 }, ['a', 'c']), { a: 1, c: 3 });
+});
+
+test('pick returns a new object and does not change the input', () => {
+  const obj = { a: 1, b: 2 };
+  const result = pick(obj, ['a']);
+  assert.notStrictEqual(result, obj);
+  assert.deepStrictEqual(obj, { a: 1, b: 2 });
+});
+
+test('pick leaves out listed keys that obj does not have', () => {
+  assert.deepStrictEqual(pick({ a: 1 }, ['a', 'missing']), { a: 1 });
+  assert.strictEqual('missing' in pick({ a: 1 }, ['missing']), false);
+});
+
+test('pick keeps keys whose values are undefined or null when they are present', () => {
+  assert.deepStrictEqual(pick({ a: undefined, b: null }, ['a', 'b']), { a: undefined, b: null });
+});
+
+test('pick ignores inherited properties', () => {
+  const obj = Object.create({ inherited: 1 });
+  obj.own = 2;
+  assert.deepStrictEqual(pick(obj, ['inherited', 'own']), { own: 2 });
+});
+
+test('pick returns an empty object for an empty key list', () => {
+  assert.deepStrictEqual(pick({ a: 1 }, []), {});
+});
+
+test('pick handles duplicate keys and keeps the key order given', () => {
+  assert.deepStrictEqual(pick({ a: 1, b: 2 }, ['b', 'a', 'b']), { b: 2, a: 1 });
+});
+
+test('pick throws a TypeError for bad arguments', () => {
+  assert.throws(() => pick(null, ['a']), TypeError);
+  assert.throws(() => pick('abc', ['a']), TypeError);
+  assert.throws(() => pick({ a: 1 }, 'a'), TypeError);
+  assert.throws(() => pick({ a: 1 }), TypeError);
+});
+
+test('omit returns the object without the listed keys', () => {
+  assert.deepStrictEqual(omit({ a: 1, b: 2, c: 3 }, ['b']), { a: 1, c: 3 });
+});
+
+test('omit returns a new object and does not change the input', () => {
+  const obj = { a: 1, b: 2 };
+  const result = omit(obj, ['a']);
+  assert.notStrictEqual(result, obj);
+  assert.deepStrictEqual(obj, { a: 1, b: 2 });
+});
+
+test('omit with an empty key list returns a copy of everything', () => {
+  assert.deepStrictEqual(omit({ a: 1, b: 2 }, []), { a: 1, b: 2 });
