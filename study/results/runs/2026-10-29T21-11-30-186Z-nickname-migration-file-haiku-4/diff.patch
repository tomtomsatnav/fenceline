+// Returns a new Date n calendar days after date (before it when n is negative). Days are counted in local time, so the time of day is kept across daylight-saving changes. The input is not changed.
+exports.addDays = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError('addDays: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('addDays: date must be a valid Date');
+  if (!Number.isInteger(n)) throw new RangeError('addDays: n must be an integer');
+  const result = new Date(date.getTime());
+  result.setDate(result.getDate() + n);
+  return result;
+};
+
+const MS_PER_DAY = 86400000;
+
+// Whole UTC calendar days from a to b: positive when b is later than a, negative when earlier, 0 for the same day. Time of day is ignored.
+exports.daysBetween = (a, b) => {
+  for (const [name, date] of [['a', a], ['b', b]]) {
+    if (!(date instanceof Date)) throw new TypeError(`daysBetween: ${name} must be a Date`);
+    if (Number.isNaN(date.getTime())) throw new RangeError(`daysBetween: ${name} must be a valid Date`);
+  }
