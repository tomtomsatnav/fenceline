+});
+
+test('addDays crosses the end of a month and year', () => {
+  assert.deepStrictEqual(addDays(new Date(2024, 0, 31), 1), new Date(2024, 1, 1));
+  assert.deepStrictEqual(addDays(new Date(2024, 11, 31), 1), new Date(2025, 0, 1));
+  assert.deepStrictEqual(addDays(new Date(2024, 0, 1), -1), new Date(2023, 11, 31));
