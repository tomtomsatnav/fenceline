+// Limits x to the range from lo to hi, both included. Infinite bounds are allowed.
+exports.clamp = (x, lo, hi) => {
+  for (const [name, value] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof value !== 'number' || Number.isNaN(value)) throw new TypeError(`clamp: ${name} must be a number`);
+  }
+  if (lo > hi) throw new RangeError('clamp: lo must not be greater than hi');
+  return Math.min(Math.max(x, lo), hi);
+};
+
+// Moves the decimal point of v by p places, working on the decimal text so that values such as 1.005 are not disturbed by binary rounding.
+const shift = (v, p) => {
+  const [mantissa, exponent = '0'] = String(v).split('e');
+  return Number(`${mantissa}e${Number(exponent) + p}`);
+};
+
+// Rounds x to the given number of decimal places, with halves rounded away from zero: roundTo(1.005, 2) is 1.01. A negative places rounds to tens, hundreds and so on.
+exports.roundTo = (x, places) => {
+  if (typeof x !== 'number') throw new TypeError('roundTo: x must be a number');
+  if (!Number.isFinite(x)) throw new RangeError('roundTo: x must be finite');
+  if (!Number.isInteger(places)) throw new RangeError('roundTo: places must be an integer');
+  const rounded = Math.sign(x) * shift(Math.round(shift(Math.abs(x), places)), -places);
+  // A negative input that rounds to nothing would otherwise give -0.
+  return rounded === 0 ? 0 : rounded;
+};
+
+// The arithmetic mean of xs, or NaN for an empty array. Every item must be a number.
+exports.mean = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('mean: xs must be an array');
+  if (!xs.every((x) => typeof x === 'number')) throw new TypeError('mean: every item must be a number');
+  if (xs.length === 0) return NaN;
+  return xs.reduce((sum, x) => sum + x, 0) / xs.length;
+};
+
+// The median of xs: the middle value, or the mean of the two middle values when there is an even count. Returns NaN for an empty array. The input is not changed.
+exports.median = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('median: xs must be an array');
+  if (!xs.every((x) => typeof x === 'number')) throw new TypeError('median: every item must be a number');
+  if (xs.length === 0) return NaN;
+  const sorted = [...xs].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+  const mid = Math.floor(sorted.length / 2);
+  return sorted.length % 2 === 1 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2;
+};
+
+// The p-th percentile of xs (p from 0 to 100), by linear interpolation between the two nearest sorted values. Returns NaN for an empty array. The input is not changed.
+exports.percentile = (xs, p) => {
+  if (!Array.isArray(xs)) throw new TypeError('percentile: xs must be an array');
+  if (!xs.every((x) => typeof x === 'number')) throw new TypeError('percentile: every item must be a number');
+  if (typeof p !== 'number' || Number.isNaN(p) || p < 0 || p > 100) throw new RangeError('percentile: p must be a number from 0 to 100');
+  if (xs.length === 0) return NaN;
+  const sorted = [...xs].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+  const rank = (p / 100) * (sorted.length - 1);
+  const lo = Math.floor(rank);
+  const hi = Math.ceil(rank);
+  const frac = rank - lo;
+  if (frac === 0) return sorted[lo];
+  // Weighting both ends, rather than taking their difference, keeps an Infinity end from producing NaN.
+  return (1 - frac) * sorted[lo] + frac * sorted[hi];
+};
+
+const BYTE_UNITS = ['B', 'KB', 'MB', 'GB', 'TB'];
+
+// Formats a byte count with binary (1024) units, to one decimal place with a trailing ".0" dropped: formatBytes(1536) is "1.5 KB".
+exports.formatBytes = (n) => {
+  if (typeof n !== 'number') throw new TypeError('formatBytes: n must be a number');
+  if (!Number.isFinite(n) || n < 0) throw new RangeError('formatBytes: n must be a finite, non-negative number');
+  const last = BYTE_UNITS.length - 1;
+  let i = 0;
+  let value = n;
+  while (i < last && value >= 1024) {
+    value /= 1024;
+    i++;
+  }
+  if (i === 0) return `${Math.round(value)} B`;
+  const text = (v) => v.toFixed(1).replace(/\.0$/, '');
+  // Rounding can carry a value such as 1023.96 KB up to "1024 KB", so move up a unit when that happens.
+  if (Number(text(value)) >= 1024 && i < last) {
+    value /= 1024;
+    i++;
+  }
+  return `${text(value)} ${BYTE_UNITS[i]}`;
+};
