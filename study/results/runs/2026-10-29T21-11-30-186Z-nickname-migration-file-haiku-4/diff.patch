+  return [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][month - 1];
+};
+
+// The calendar quarter, 1 to 4, that contains date in UTC. Time of day does not matter.
+exports.quarterOf = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('quarterOf: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('quarterOf: date must be a valid Date');
