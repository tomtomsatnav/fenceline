+
+test('addDays handles leap days', () => {
+  assert.deepStrictEqual(addDays(new Date(2024, 1, 28), 1), new Date(2024, 1, 29));
+  assert.deepStrictEqual(addDays(new Date(2023, 1, 28), 1), new Date(2023, 2, 1));
