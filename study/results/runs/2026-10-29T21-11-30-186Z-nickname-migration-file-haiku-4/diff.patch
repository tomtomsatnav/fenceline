+  assert.strictEqual(deepClone(null), null);
+  assert.strictEqual(deepClone(undefined), undefined);
+});
+
+test('deepClone copies an empty object and an empty array', () => {
+  assert.deepStrictEqual(deepClone({}), {});
+  assert.deepStrictEqual(deepClone([]), []);
+});
+
+test('deepClone keeps undefined properties and array holes', () => {
