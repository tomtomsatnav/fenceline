+  const total = Number(days) * 86400 + Number(hours) * 3600 + Number(minutes) * 60 + Number(seconds);
+  if (!Number.isSafeInteger(total)) throw new RangeError(`parseDuration: duration too large ${text}`);
+  return total;
+};
