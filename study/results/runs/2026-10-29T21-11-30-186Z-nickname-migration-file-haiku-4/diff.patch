+  // setUTCFullYear sets the year, month and day together, so the clamped day is never rolled into the next month.
+  result.setUTCFullYear(year, month, day);
+  return result;
+};
+
+// Formats a whole number of seconds as days, hours, minutes and seconds, leaving out zero units: 3725 is "1h 2m 5s", and 0 is "0s". Uses the same units as parseDuration. Seconds must be a whole number from 0 up.
+exports.formatDuration = (seconds) => {
+  if (typeof seconds !== 'number') throw new TypeError('formatDuration: seconds must be a number');
+  if (!Number.isSafeInteger(seconds) || seconds < 0) throw new RangeError('formatDuration: seconds must be a whole number from 0 up');
+  if (seconds === 0) return '0s';
+  const units = [['d', 86400], ['h', 3600], ['m', 60], ['s', 1]];
+  const parts = [];
+  let rest = seconds;
+  for (const [label, size] of units) {
+    const count = Math.floor(rest / size);
+    if (count > 0) parts.push(`${count}${label}`);
+    rest -= count * size;
+  }
+  return parts.join(' ');
+};
