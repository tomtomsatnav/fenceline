+  const dayStart = (d) => Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
+  return Math.round((dayStart(b) - dayStart(a)) / MS_PER_DAY);
+};
+
+// True when date falls on a Saturday or Sunday in UTC.
+exports.isWeekend = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('isWeekend: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('isWeekend: date must be a valid Date');
+  const day = date.getUTCDay();
+  return day === 0 || day === 6;
+};
+
+// The Monday at 00:00 UTC of the week that contains date. A Sunday belongs to the week that started on the Monday six days earlier.
+exports.startOfWeek = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('startOfWeek: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('startOfWeek: date must be a valid Date');
+  const daysSinceMonday = (date.getUTCDay() + 6) % 7;
+  return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate() - daysSinceMonday));
+};
+
+// Formats the UTC calendar day of date as YYYY-MM-DD, such as "2024-05-08". Years must be 0 to 9999 so the format holds.
+exports.formatIsoDate = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('formatIsoDate: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('formatIsoDate: date must be a valid Date');
+  const year = date.getUTCFullYear();
+  if (year < 0 || year > 9999) throw new RangeError('formatIsoDate: year must be from 0 to 9999');
