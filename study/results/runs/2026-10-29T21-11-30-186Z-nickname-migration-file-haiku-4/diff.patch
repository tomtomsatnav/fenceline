+// Splits xs into arrays of length n. The last array may be shorter. The input is not changed.
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk: xs must be an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('chunk: n must be a positive integer');
+  const out = [];
+  for (let i = 0; i < xs.length; i += n) out.push(xs.slice(i, i + n));
+  return out;
+};
+
+// Keeps the first item for each key that keyFn returns, in the original order. The input is not changed.
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('uniqueBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('uniqueBy: keyFn must be a function');
+  const seen = new Set();
+  return xs.filter((x) => {
+    const key = keyFn(x);
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+};
+
+// Groups xs into an object of arrays, keyed by the string that keyFn returns for each item. Items keep their original order.
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy: keyFn must be a function');
+  const groups = {};
+  for (const x of xs) {
+    const key = String(keyFn(x));
+    // defineProperty, not assignment, so a key such as "__proto__" becomes an ordinary entry.
+    if (!Object.hasOwn(groups, key)) Object.defineProperty(groups, key, { value: [], enumerable: true, writable: true, configurable: true });
+    groups[key].push(x);
+  }
+  return groups;
+};
+
+// Splits xs into [items where pred is true, items where it is false], each in the original order. The input is not changed.
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition: xs must be an array');
+  if (typeof pred !== 'function') throw new TypeError('partition: pred must be a function');
+  const matching = [];
+  const notMatching = [];
+  for (const x of xs) (pred(x) ? matching : notMatching).push(x);
+  return [matching, notMatching];
+};
+
+// Pairs up the items of a and b by position, stopping at the shorter array. Each pair is [a item, b item].
+exports.zip = (a, b) => {
+  if (!Array.isArray(a)) throw new TypeError('zip: a must be an array');
+  if (!Array.isArray(b)) throw new TypeError('zip: b must be an array');
+  const n = Math.min(a.length, b.length);
+  return Array.from({ length: n }, (_, i) => [a[i], b[i]]);
+};
+
+// Returns the numbers from start up to, but not including, end, moving by step. A negative step counts down.
+exports.range = (start, end, step = 1) => {
+  for (const [name, value] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof value !== 'number') throw new TypeError(`range: ${name} must be a number`);
+    if (!Number.isFinite(value)) throw new RangeError(`range: ${name} must be finite`);
+  }
+  if (step === 0) throw new RangeError('range: step must not be 0');
+  const count = Math.max(0, Math.ceil((end - start) / step));
+  // Multiplying by the index, rather than adding the step each time, avoids drift with fractional steps.
+  return Array.from({ length: count }, (_, i) => start + i * step);
+};
+
+// Flattens arrays nested to any depth into one array, in order. Arrays that appear more than once are fine; an array that contains itself is rejected.
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep: xs must be an array');
+  const out = [];
+  const visit = (arr, ancestors) => {
+    if (ancestors.has(arr)) throw new TypeError('flattenDeep: xs contains itself');
+    ancestors.add(arr);
+    for (const x of arr) {
+      if (Array.isArray(x)) visit(x, ancestors);
+      else out.push(x);
+    }
+    ancestors.delete(arr);
+  };
+  visit(xs, new Set());
+  return out;
+};
+
+// Returns a new array sorted by the key keyFn gives each item. The sort is stable, so equal keys keep their original order. Keys must all be strings, or all be numbers other than NaN.
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('sortBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('sortBy: keyFn must be a function');
+  const keyed = xs.map((x) => ({ x, key: keyFn(x) }));
+  const kind = keyed.length > 0 ? typeof keyed[0].key : null;
+  for (const { key } of keyed) {
+    if (typeof key !== kind || !(typeof key === 'string' || (typeof key === 'number' && !Number.isNaN(key)))) {
+      throw new TypeError('sortBy: keys must all be strings, or all be numbers other than NaN');
+    }
+  }
+  return keyed.sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0)).map(({ x }) => x);
+};
+
+// Returns one item chosen at random, or undefined for an empty array. rng must return a number in [0, 1), such as Math.random.
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new TypeError('sample: xs must be an array');
+  if (typeof rng !== 'function') throw new TypeError('sample: rng must be a function');
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new RangeError('sample: rng must return a number in [0, 1)');
+  return xs[Math.floor(r * xs.length)];
+};
+
+// Returns every run of n consecutive items, in order. Returns [] when n is longer than xs. The input is not changed.
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed: xs must be an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('windowed: n must be a positive integer');
+  const count = Math.max(0, xs.length - n + 1);
+  return Array.from({ length: count }, (_, i) => xs.slice(i, i + n));
+};
+
+// The items of a that are not in b, in their original order. Membership is checked with SameValueZero, as Set does, so objects match only themselves. Duplicates in a are kept. Neither input is changed.
+exports.difference = (a, b) => {
+  if (!Array.isArray(a)) throw new TypeError('difference: a must be an array');
+  if (!Array.isArray(b)) throw new TypeError('difference: b must be an array');
+  const inB = new Set(b);
+  return a.filter((x) => !inB.has(x));
+};
+
+// The items that appear in every one of the arrays given, in the order of the first array. Duplicates in the first array are kept. Membership uses SameValueZero, as Set does. Neither input is changed; with one array the result is a copy of it.
+exports.intersection = (...arrays) => {
+  if (arrays.length === 0) throw new RangeError('intersection: give at least one array');
+  arrays.forEach((arr, i) => {
+    if (!Array.isArray(arr)) throw new TypeError(`intersection: argument ${i + 1} must be an array`);
+  });
+  const [first, ...rest] = arrays;
+  const sets = rest.map((arr) => new Set(arr));
+  return first.filter((x) => sets.every((set) => set.has(x)));
+};
+
+// Rotates xs left by k places, so the first k items move to the end; a negative k rotates right. k may be larger than the length, since it wraps around. Returns a new array and does not change xs.
+exports.rotate = (xs, k) => {
+  if (!Array.isArray(xs)) throw new TypeError('rotate: xs must be an array');
+  if (!Number.isInteger(k)) throw new RangeError('rotate: k must be an integer');
+  if (xs.length === 0) return [];
+  const shift = ((k % xs.length) + xs.length) % xs.length;
+  return [...xs.slice(shift), ...xs.slice(0, shift)];
+};
+
+// Counts the items for each key that keyFn returns, as an object keyed by the key's text. Keys are converted with String, as groupBy does. An empty array gives {}.
+exports.countBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('countBy: xs must be an array');
