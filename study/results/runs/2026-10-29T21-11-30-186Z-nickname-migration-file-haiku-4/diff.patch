+  let y = Math.abs(b);
+  while (y !== 0) [x, y] = [y, x % y];
+  return x;
+};
+
+const ROMAN_PARTS = [
+  [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'],
+  [100, 'C'], [90, 'XC'], [50, 'L'], [40, 'XL'],
+  [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
+];
+
+// Converts an integer from 1 to 3999 to a Roman numeral, such as 1994 to "MCMXCIV". Other values throw a RangeError.
+exports.toRoman = (n) => {
+  if (typeof n !== 'number') throw new TypeError('toRoman: n must be a number');
+  if (!Number.isInteger(n) || n < 1 || n > 3999) throw new RangeError('toRoman: n must be an integer from 1 to 3999');
+  let rest = n;
+  let out = '';
+  for (const [value, symbol] of ROMAN_PARTS) {
+    while (rest >= value) {
+      out += symbol;
+      rest -= value;
+    }
+  }
+  return out;
+};
+
+const ROMAN_VALUES = { I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000 };
+
+// Converts a Roman numeral, such as "MCMXCIV", to its integer value. This is the inverse of toRoman, so only the standard form is accepted; anything else throws a RangeError.
+exports.fromRoman = (s) => {
+  if (typeof s !== 'string') throw new TypeError('fromRoman: s must be a string');
+  let total = 0;
+  for (let i = 0; i < s.length; i++) {
+    const value = ROMAN_VALUES[s[i]];
+    if (value === undefined) throw new RangeError(`fromRoman: invalid numeral ${s}`);
+    const next = ROMAN_VALUES[s[i + 1]] ?? 0;
+    total += value < next ? -value : value;
+  }
+  // Converting back and comparing rejects anything that is not the standard form, such as "IIII" or "VX".
+  if (s.length === 0 || total < 1 || total > 3999 || exports.toRoman(total) !== s) {
+    throw new RangeError(`fromRoman: invalid numeral ${s}`);
+  }
+  return total;
+};
+
+// Linear interpolation: a at t = 0, b at t = 1, and proportionally between. t outside 0 to 1 extrapolates past the ends. Written as (1 - t) * a + t * b, so t = 0 and t = 1 return a and b exactly.
+exports.lerp = (a, b, t) => {
+  for (const [name, value] of [['a', a], ['b', b], ['t', t]]) {
+    if (typeof value !== 'number') throw new TypeError(`lerp: ${name} must be a number`);
+    if (!Number.isFinite(value)) throw new RangeError(`lerp: ${name} must be finite`);
+  }
+  return (1 - t) * a + t * b;
+};
+
+// The population standard deviation of xs: the square root of the mean squared distance from the mean. It divides by the count, not count - 1. Returns NaN for an empty array. Every item must be a number.
+exports.stdDev = (xs) => {
+  const mu = exports.mean(xs);
+  if (Number.isNaN(mu)) return NaN;
+  return Math.sqrt(exports.mean(xs.map((x) => (x - mu) ** 2)));
+};
+
+// The nth Fibonacci number (F0 = 0, F1 = 1) as a BigInt, so the result stays exact. n must be an integer from 0 to 1000.
+exports.fibonacci = (n) => {
+  if (typeof n !== 'number') throw new TypeError('fibonacci: n must be a number');
+  if (!Number.isInteger(n) || n < 0 || n > 1000) throw new RangeError('fibonacci: n must be an integer from 0 to 1000');
+  let a = 0n;
+  let b = 1n;
+  for (let i = 0; i < n; i++) [a, b] = [b, a + b];
+  return a;
+};
+
+// The English ordinal for a whole number: 1st, 2nd, 3rd, 4th, and 11th, 12th, 13th (the teens always take "th"). n must be an integer from 0 up.
+exports.toOrdinal = (n) => {
+  if (typeof n !== 'number') throw new TypeError('toOrdinal: n must be a number');
+  if (!Number.isSafeInteger(n) || n < 0) throw new RangeError('toOrdinal: n must be a whole number from 0 up');
+  const lastTwo = n % 100;
+  if (lastTwo >= 11 && lastTwo <= 13) return `${n}th`;
+  const suffix = { 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] ?? 'th';
+  return `${n}${suffix}`;
+};
+
+// Parses a duration such as "1d2h3m4s" or "1h30m" into whole seconds. Units are d, h, m and s, each at most once and in that order; every part is a whole number. Anything else throws a RangeError.
+exports.parseDuration = (text) => {
+  if (typeof text !== 'string') throw new TypeError('parseDuration: text must be a string');
