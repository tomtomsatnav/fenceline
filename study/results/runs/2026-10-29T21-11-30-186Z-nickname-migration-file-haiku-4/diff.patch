+++ b/test/export.test.js
@@ -0,0 +1,70 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { createUser, listUsers, recordLogin, countUsers } = require('../src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+test('exports only the header row when there are no users', () => {
+  const db = migrate(new Db());
+  assert.strictEqual(exportUsersCsv(db), 'id,email,fullName,createdAt,lastLogin\n');
+});
+
+test('exports one row per user, oldest first, with an empty lastLogin', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'b', email: 'b@example.com', fullname: 'Bob', created_at: '2026-02-01T00:00:00.000Z' });
+  db.insert('users', { id: 'a', email: 'a@example.com', fullname: 'Ada', created_at: '2026-01-01T00:00:00.000Z', last_login: '2026-03-01T00:00:00.000Z' });
+  assert.strictEqual(
+    exportUsersCsv(db),
+    'id,email,fullName,createdAt,lastLogin\n' +
+      'a,a@example.com,Ada,2026-01-01T00:00:00.000Z,2026-03-01T00:00:00.000Z\n' +
+      'b,b@example.com,Bob,2026-02-01T00:00:00.000Z,\n',
+  );
+});
+
+test('quotes fields that contain commas, quotes or line breaks', () => {
+  const db = migrate(new Db());
+  createUser(db, { email: 'ada@example.com', fullName: 'Lovelace, Ada "Countess"' });
+  createUser(db, { email: 'bob@example.com', fullName: 'Bob\nSmith' });
+  const lines = exportUsersCsv(db).split('\n');
+  assert.match(lines[1], /^[^,]+,ada@example\.com,"Lovelace, Ada ""Countess""",/);
+  assert.match(exportUsersCsv(db), /,"Bob\nSmith",/);
+});
+
+test('exports every user, not just the first page', () => {
+  const db = migrate(new Db());
+  for (let i = 0; i < 60; i++) {
+    db.insert('users', { id: `u${i}`, email: `u${i}@example.com`, fullname: `U${i}`, created_at: `2026-01-01T00:00:${String(i).padStart(2, '0')}.000Z` });
+  }
+  assert.strictEqual(exportUsersCsv(db).trimEnd().split('\n').length, 61);
+});
+
+test('round-trips users through exportUsersCsv and importUsersCsv', () => {
+  const source = migrate(new Db());
+  createUser(source, { email: 'ada@example.com', fullName: 'Lovelace, Ada "Countess"' });
+  createUser(source, { email: 'bob@example.com', fullName: 'Bob\nSmith' });
+  recordLogin(source, listUsers(source)[0].id, new Date('2026-05-01T12:00:00.000Z'));
+  const csv = exportUsersCsv(source);
+
+  const target = migrate(new Db());
+  assert.strictEqual(importUsersCsv(target, csv), 2);
+  assert.deepStrictEqual(listUsers(target), listUsers(source));
+  assert.strictEqual(exportUsersCsv(target), csv);
+});
+
+test('import rejects a bad header, a bad row, or a duplicate without writing anything', () => {
+  const db = migrate(new Db());
+  createUser(db, { email: 'ada@example.com', fullName: 'Ada' });
+  const header = 'id,email,fullName,createdAt,lastLogin\n';
+  assert.throws(() => importUsersCsv(db, 'email,id\n'), /CSV header/);
+  assert.throws(() => importUsersCsv(db, header + 'x,bob.example.com,Bob,2026-01-01T00:00:00.000Z,\n'), /invalid email/);
+  assert.throws(() => importUsersCsv(db, header + 'x,bob@example.com,Bob,2026-01-01T00:00:00.000Z,\n' + 'y,BOB@example.com,Bob2,2026-01-01T00:00:00.000Z,\n'), /duplicate email/);
+  assert.throws(() => importUsersCsv(db, header + 'x,ADA@example.com,Ada,2026-01-01T00:00:00.000Z,\n'), /duplicate email/);
+  assert.throws(() => importUsersCsv(db, header + 'x,bob@example.com,Bob\n'), /expected 5 fields/);
+  assert.strictEqual(countUsers(db), 1);
+});
+
+test('import accepts a header-only file as zero users', () => {
+  const db = migrate(new Db());
+  assert.strictEqual(importUsersCsv(db, 'id,email,fullName,createdAt,lastLogin\n'), 0);
+});
