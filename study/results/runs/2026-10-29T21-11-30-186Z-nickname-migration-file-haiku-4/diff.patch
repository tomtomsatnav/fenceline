+exports.isPrime = (n) => {
+  if (typeof n !== 'number') throw new TypeError('isPrime: n must be a number');
+  if (!Number.isInteger(n)) return false;
+  if (n > Number.MAX_SAFE_INTEGER) throw new RangeError('isPrime: n must be at most Number.MAX_SAFE_INTEGER');
