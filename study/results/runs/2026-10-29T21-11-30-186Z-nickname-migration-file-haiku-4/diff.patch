+// Returns a new object holding only the listed keys of obj. Keys that obj does not have as its own property are left out; inherited properties are ignored. obj is not changed.
+exports.pick = (obj, keys) => {
+  if (typeof obj !== 'object' || obj === null) throw new TypeError('pick: obj must be an object');
+  if (!Array.isArray(keys)) throw new TypeError('pick: keys must be an array');
+  const out = {};
+  for (const key of keys) {
+    if (Object.hasOwn(obj, key)) out[key] = obj[key];
+  }
+  return out;
+};
+
+// Returns a new object with every own enumerable property of obj except the listed keys. Listed keys that obj does not have are ignored. obj is not changed.
+exports.omit = (obj, keys) => {
+  if (typeof obj !== 'object' || obj === null) throw new TypeError('omit: obj must be an object');
+  if (!Array.isArray(keys)) throw new TypeError('omit: keys must be an array');
+  const drop = new Set(keys);
+  return Object.fromEntries(Object.entries(obj).filter(([key]) => !drop.has(key)));
+};
+
+const isPlainObject = (v) => {
+  if (v === null || typeof v !== 'object' || Array.isArray(v)) return false;
+  const proto = Object.getPrototypeOf(v);
+  return proto === Object.prototype || proto === null;
+};
+
+// The kind of a value that deepEqual can compare. Anything else (functions, symbols, bigints, Dates, Maps, class instances) is rejected.
+const kindOf = (v) => {
+  if (v === null) return 'null';
+  if (Array.isArray(v)) return 'array';
+  if (isPlainObject(v)) return 'object';
+  if (['undefined', 'boolean', 'number', 'string'].includes(typeof v)) return typeof v;
+  throw new TypeError(`deepEqual: unsupported value ${String(v)}`);
