+const { listUsers } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quotes a CSV field when it contains a comma, a quote or a line break, doubling any quotes inside it.
+const csvField = (value) => {
+  const s = value == null ? '' : String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * Writes every user as CSV, oldest first, with the header id,email,fullName,createdAt,lastLogin.
+ * @param {Db} db
+ * @returns {string} The CSV text, ending with a newline.
+ */
+exports.exportUsersCsv = (db) => {
+  // Infinity skips the default page size so every user is exported.
+  const users = listUsers(db, { limit: Infinity });
+  const lines = [COLUMNS, ...users.map((u) => COLUMNS.map((c) => u[c]))].map((cells) => cells.map(csvField).join(','));
+  return lines.join('\n') + '\n';
+};
+
+// Splits CSV text into rows of fields, honouring quoted fields with commas, quotes and line breaks.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c === '"' && text[i + 1] === '"') { field += '"'; i++; }
+      else if (c === '"') quoted = false;
+      else field += c;
+    } else if (c === '"') {
+      quoted = true;
+    } else if (c === ',') {
+      row.push(field); field = '';
+    } else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      row.push(field); rows.push(row); row = []; field = '';
+    } else {
+      field += c;
+    }
+  }
+  if (field !== '' || row.length > 0) { row.push(field); rows.push(row); }
+  return rows;
+};
+
+/**
+ * Reads users written by exportUsersCsv, keeping their ids and timestamps.
+ * Nothing is written unless every row is valid.
+ * @param {Db} db
+ * @param {string} csv CSV text with the header id,email,fullName,createdAt,lastLogin.
+ * @returns {number} How many users were imported.
+ * @throws {Error} If the header or a row is invalid, or an id or email is duplicated.
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (!db) throw new Error('importUsersCsv: db is required');
+  const [header, ...rows] = parseCsv(csv);
+  if (header?.join(',') !== COLUMNS.join(',')) throw new Error(`CSV header must be ${COLUMNS.join(',')}`);
+
+  const existing = db.all('users');
+  const seenIds = new Set(existing.map((u) => u.id));
+  const seenEmails = new Set(existing.map((u) => u.email.toLowerCase()));
+  const users = rows.map((cells, i) => {
+    const line = i + 2;
+    if (cells.length !== COLUMNS.length) throw new Error(`Line ${line}: expected ${COLUMNS.length} fields, got ${cells.length}`);
+    const [id, email, fullName, createdAt, lastLogin] = cells;
+    if (!id) throw new Error(`Line ${line}: id is required`);
+    if (!email.includes('@')) throw new Error(`Line ${line}: invalid email ${email}`);
+    if (!fullName.trim()) throw new Error(`Line ${line}: fullName is required`);
+    if (seenIds.has(id)) throw new Error(`Line ${line}: duplicate id ${id}`);
+    if (seenEmails.has(email.toLowerCase())) throw new Error(`Line ${line}: duplicate email ${email}`);
+    seenIds.add(id);
+    seenEmails.add(email.toLowerCase());
+    return { id, email, fullname: fullName, created_at: createdAt, last_login: lastLogin || undefined };
+  });
+
+  for (const u of users) {
+    const row = Object.fromEntries(Object.entries(u).filter(([, v]) => v !== undefined));
+    db.insert('users', row);
+  }
+  return users.length;
+};
