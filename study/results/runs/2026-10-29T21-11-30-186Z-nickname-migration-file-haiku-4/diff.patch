+// The local part (before "@"): dot-separated runs of letters, digits and common symbols, with no leading, trailing or doubled dots.
+const LOCAL_PART = /^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*$/;
+// The domain: at least two dot-separated labels of letters, digits and hyphens, where no label starts or ends with a hyphen.
+const DOMAIN = /^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$/;
+
+// True for a reasonable email address: exactly one "@", a local part and a domain with at least one dot, no spaces, and the usual length limits. This is a sanity check, not proof that the address exists. Non-strings are not emails.
+exports.isEmail = (s) => {
+  if (typeof s !== 'string' || s.length > 254) return false;
+  const parts = s.split('@');
+  if (parts.length !== 2) return false;
+  const [local, domain] = parts;
+  return local.length <= 64 && LOCAL_PART.test(local) && DOMAIN.test(domain);
+};
+
+// 8-4-4-4-12 hexadecimal digits, with the version digit 1 to 5 and the RFC 4122 variant digit 8, 9, a or b. Upper and lower case are both accepted.
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+// True for an RFC 4122 UUID of any version (1 to 5). The nil UUID (all zeros) is not a versioned UUID, so it is rejected. Non-strings are not UUIDs.
+exports.isUuid = (s) => typeof s === 'string' && UUID.test(s);
+
+// True when a password is at least 12 characters and contains a lower-case letter, an upper-case letter, a digit and a symbol. A symbol is any character that is not a letter, a digit or whitespace. Length counts characters, not UTF-16 units. Non-strings are not passwords.
+exports.isStrongPassword = (s) => {
+  if (typeof s !== 'string' || Array.from(s).length < 12) return false;
+  return /\p{Ll}/u.test(s) && /\p{Lu}/u.test(s) && /\p{Nd}/u.test(s) && /[^\p{L}\p{N}\s]/u.test(s);
+};
+
+// True when s is an absolute http or https URL with a host, as the URL class parses it. Text with whitespace is rejected, since the URL class would quietly strip it. Non-strings and other schemes are not URLs.
+exports.isUrl = (s) => {
+  if (typeof s !== 'string' || /\s/.test(s)) return false;
+  let url;
+  try {
+    url = new URL(s);
+  } catch {
+    return false;
+  }
+  return (url.protocol === 'http:' || url.protocol === 'https:') && url.hostname !== '';
+};
+
+// A UK postcode: an outward code (area, district), an optional single space, then an inward code (sector and unit). The letters allowed in each position follow the Royal Mail rules; GIR 0AA is also accepted.
+const UK_POSTCODE = /^(GIR ?0AA|[A-PR-UWYZ]([0-9]{1,2}|[A-HK-Y][0-9]([0-9ABEHMNPRV-Y])?|[0-9][A-HJKPS-UW]) ?[0-9][ABD-HJLNP-UW-Z]{2})$/;
+
+// True for a UK postcode such as "SW1A 1AA". Case does not matter and the space is optional. Other spacing, such as leading or doubled spaces, is rejected. Non-strings are not postcodes.
+exports.isPostcodeUK = (s) => typeof s === 'string' && UK_POSTCODE.test(s.toUpperCase());
+
+// A short list of common ISO 4217 currency codes. It is a curated list, not the full standard.
+const COMMON_CURRENCIES = new Set([
+  'USD', 'EUR', 'GBP', 'JPY', 'CNY', 'CHF', 'CAD', 'AUD', 'NZD', 'INR',
+  'SEK', 'NOK', 'DKK', 'BRL', 'MXN', 'KRW', 'SGD', 'HKD', 'ZAR',
+]);
+
+// True when s is one of the common currency codes above. Codes must be upper case, with no spaces. Non-strings and codes outside the list are not accepted.
+exports.isIsoCurrency = (s) => typeof s === 'string' && COMMON_CURRENCIES.has(s);
+
+// True for a hex colour written as #rgb or #rrggbb, with hexadecimal digits in either case. Alpha forms such as #rrggbbaa, and text without the leading #, are not accepted. Non-strings are not colours.
+exports.isHexColor = (s) => typeof s === 'string' && /^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i.test(s);
+
+// True for a dotted-quad IPv4 address: four parts, each 0 to 255, written without leading zeros (so "01" is rejected). Non-strings are not addresses.
+exports.isIPv4 = (s) => {
+  if (typeof s !== 'string') return false;
+  const parts = s.split('.');
+  return parts.length === 4 && parts.every((part) => /^(0|[1-9]\d{0,2})$/.test(part) && Number(part) <= 255);
+};
+
+// The semantic versioning 2.0.0 grammar: MAJOR.MINOR.PATCH with no leading zeros in numbers, then an optional -prerelease and an optional +build. Build metadata may contain leading zeros; prerelease numbers may not.
+const SEMVER = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\+([0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*))?$/;
+
+// True for a semantic version such as "1.2.3", "1.2.3-beta.1" or "1.2.3+build.5". A leading "v" is not part of the grammar, so "v1.2.3" is rejected. Non-strings are not versions.
+exports.isSemver = (s) => typeof s === 'string' && SEMVER.test(s);
+
+// The total IBAN length for the countries in this list. It is a partial list of the countries that use IBANs.
+const IBAN_LENGTHS = {
+  AT: 20, BE: 16, CH: 21, DE: 22, DK: 18, ES: 24, FI: 18, FR: 27, GB: 22,
+  IE: 22, IT: 27, NL: 18, NO: 15, PL: 28, PT: 25, SE: 24,
+};
+
+// True for an IBAN in compact form (no spaces): a country code from the list above, the right total length for that country, and a valid mod-97 check. Lower case and spaces are rejected. Non-strings are not IBANs.
+exports.isIban = (s) => {
+  if (typeof s !== 'string' || !/^[A-Z]{2}[0-9]{2}[A-Z0-9]+$/.test(s)) return false;
+  const country = s.slice(0, 2);
+  if (IBAN_LENGTHS[country] !== s.length) return false;
+  // Move the first four characters to the end, then read each letter as its two-digit value (A = 10 ... Z = 35).
+  const rearranged = s.slice(4) + s.slice(0, 4);
+  const digits = [...rearranged].map((c) => (/[A-Z]/.test(c) ? String(c.charCodeAt(0) - 55) : c)).join('');
+  return BigInt(digits) % 97n === 1n;
+};
+
+// True when s is 12 to 19 digits and passes the Luhn check, the checksum used by card numbers: double every second digit from the right, subtract 9 from any doubled value above 9, and the total must be a multiple of 10. Spaces and dashes are rejected. This checks the number's form only, not that a card exists.
+exports.isCreditCardLuhn = (s) => {
+  if (typeof s !== 'string' || !/^[0-9]{12,19}$/.test(s)) return false;
+  let sum = 0;
+  for (let i = 0; i < s.length; i++) {
+    let digit = Number(s[s.length - 1 - i]);
+    if (i % 2 === 1) {
+      digit *= 2;
+      if (digit > 9) digit -= 9;
+    }
+    sum += digit;
+  }
+  return sum % 10 === 0;
+};
diff --git a/test/export.test.js b/test/export.test.js
