+exports.isLeapYear = (year) => {
+  if (typeof year !== 'number') throw new TypeError('isLeapYear: year must be a number');
+  if (!Number.isInteger(year)) throw new RangeError('isLeapYear: year must be an integer');
+  return (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
+};
+
+// The number of days in a month of the Gregorian calendar. month runs from 1 (January) to 12 (December), and February gets 29 days in leap years.
+exports.daysInMonth = (year, month) => {
+  if (typeof month !== 'number') throw new TypeError('daysInMonth: month must be a number');
+  if (!Number.isInteger(month) || month < 1 || month > 12) throw new RangeError('daysInMonth: month must be an integer from 1 to 12');
