+exports.gcd = (a, b) => {
+  for (const [name, value] of [['a', a], ['b', b]]) {
+    if (typeof value !== 'number') throw new TypeError(`gcd: ${name} must be a number`);
+    if (!Number.isInteger(value)) throw new RangeError(`gcd: ${name} must be an integer`);
+    if (Math.abs(value) > Number.MAX_SAFE_INTEGER) throw new RangeError(`gcd: ${name} must be a safe integer`);
