+// Converts text such as "hello world", "hello-world" or "hello_world" to camelCase ("helloWorld").
+// Words are split on whitespace, hyphens and underscores; each word is lowercased, and every word after the first is capitalized.
+exports.camelCase = (text) => {
+  if (typeof text !== 'string') throw new TypeError('camelCase: text must be a string');
+  const words = text.split(/[\s_-]+/).filter(Boolean).map((w) => w.toLowerCase());
+  return words.map((w, i) => (i === 0 ? w : w[0].toUpperCase() + w.slice(1))).join('');
+};
+
+// Converts text such as "helloWorld" or "Hello World" to kebab-case ("hello-world").
+// Words are split on case changes ("helloWorld", "XMLHttp"), whitespace, hyphens and underscores, then joined with hyphens in lowercase.
+exports.kebabCase = (text) => {
+  if (typeof text !== 'string') throw new TypeError('kebabCase: text must be a string');
+  return text
+    .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
+    .replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2')
+    .split(/[\s_-]+/)
+    .filter(Boolean)
+    .map((w) => w.toLowerCase())
+    .join('-');
+};
+
