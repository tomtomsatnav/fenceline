+test('searches names and emails case-insensitively', () => {
+  const db = migrate(new Db());
+  const ada = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  const grace = createUser(db, { email: 'hopper@navy.example', fullName: 'Grace Hopper' });
+  assert.deepStrictEqual(searchUsers(db, 'LOVE'), [ada]);
