+test('rejects an invalid fullName on create', () => {
+  const db = migrate(new Db());
+  assert.throws(() => createUser(db, { email: 'ada@example.com', fullName: '' }), /non-empty/);
+  assert.throws(() => createUser(db, { email: 'ada@example.com', fullName: '   ' }), /non-empty/);
+  assert.throws(() => createUser(db, { email: 'ada@example.com', fullName: 42 }), /non-empty/);
+  assert.throws(() => createUser(db, { email: 'ada@example.com', fullName: 'x'.repeat(101) }), /at most 100/);
+  assert.strictEqual(countUsers(db), 0);
+});
+
+test('accepts a fullName of exactly 100 characters', () => {
