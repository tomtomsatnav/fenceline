+// Local-time dates are used throughout so the tests do not depend on the machine's time zone.
+const ymd = (d) => [d.getFullYear(), d.getMonth() + 1, d.getDate()];
+
+test('addDays moves forward by the given number of days', () => {
+  assert.deepStrictEqual(ymd(addDays(new Date(2024, 0, 10), 5)), [2024, 1, 15]);
+});
+
+test('addDays moves backward for a negative number of days', () => {
+  assert.deepStrictEqual(ymd(addDays(new Date(2024, 0, 10), -5)), [2024, 1, 5]);
+});
+
+test('addDays with 0 returns an equal but separate Date', () => {
+  const d = new Date(2024, 4, 17, 9, 30);
+  const out = addDays(d, 0);
+  assert.strictEqual(out.getTime(), d.getTime());
+  assert.notStrictEqual(out, d);
+});
+
+test('addDays rolls over the end of a month', () => {
+  assert.deepStrictEqual(ymd(addDays(new Date(2024, 0, 31), 1)), [2024, 2, 1]);
+  assert.deepStrictEqual(ymd(addDays(new Date(2023, 1, 28), 1)), [2023, 3, 1]);
+});
+
+test('addDays handles leap years', () => {
+  assert.deepStrictEqual(ymd(addDays(new Date(2024, 1, 28), 1)), [2024, 2, 29]);
+  assert.deepStrictEqual(ymd(addDays(new Date(2024, 1, 28), 2)), [2024, 3, 1]);
+  assert.deepStrictEqual(ymd(addDays(new Date(2023, 1, 28), 1)), [2023, 3, 1]);
+});
+
+test('addDays rolls back over the start of a year', () => {
+  assert.deepStrictEqual(ymd(addDays(new Date(2024, 0, 1), -1)), [2023, 12, 31]);
+});
+
+test('addDays keeps the wall-clock time across a daylight saving change', () => {
