+test('pages users with limit and offset', () => {
+  const db = migrate(new Db());
+  for (const id of ['a', 'b', 'c', 'd', 'e']) {
+    db.insert('users', { id, email: `${id}@example.com`, fullname: id.toUpperCase(), created_at: `2024-01-0${id.charCodeAt(0) - 96}T00:00:00.000Z` });
+  }
+  assert.deepStrictEqual(listUsers(db, { limit: 2 }).map((u) => u.id), ['a', 'b']);
+  assert.deepStrictEqual(listUsers(db, { limit: 2, offset: 2 }).map((u) => u.id), ['c', 'd']);
+  assert.deepStrictEqual(listUsers(db, { offset: 4 }).map((u) => u.id), ['e']);
+  assert.deepStrictEqual(listUsers(db, { offset: 10 }), []);
+});
+
+test('lists at most 50 users by default', () => {
+  const db = migrate(new Db());
+  for (let i = 0; i < 51; i++) {
+    db.insert('users', { id: `id${i}`, email: `u${i}@example.com`, fullname: `User ${i}`, created_at: new Date(Date.UTC(2024, 0, 1, 0, 0, i)).toISOString() });
+  }
+  assert.strictEqual(listUsers(db).length, 50);
+  assert.strictEqual(listUsers(db)[0].id, 'id0');
+  assert.strictEqual(listUsers(db, { offset: 50 })[0].id, 'id50');
+});
