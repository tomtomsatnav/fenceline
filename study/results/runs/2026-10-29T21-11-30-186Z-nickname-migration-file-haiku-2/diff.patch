+    .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
+    .replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2');
+  return spaced.split(/[\s_-]+/).filter((w) => w !== '').map((w) => w.toLowerCase()).join('-');
+};
