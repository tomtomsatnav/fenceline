+// Converts text separated by spaces, hyphens or underscores to camelCase, e.g. "hello-world" to "helloWorld".
+exports.camelCase = (str) => {
+  if (typeof str !== 'string') throw new TypeError('camelCase expects a string');
+  const words = str.split(/[\s_-]+/).filter((w) => w !== '').map((w) => w.toLowerCase());
+  return words.map((w, i) => (i === 0 ? w : w[0].toUpperCase() + w.slice(1))).join('');
+};
+
+// Converts camelCase, PascalCase or separated text to kebab-case, e.g. "helloWorld" to "hello-world".
+exports.kebabCase = (str) => {
+  if (typeof str !== 'string') throw new TypeError('kebabCase expects a string');
