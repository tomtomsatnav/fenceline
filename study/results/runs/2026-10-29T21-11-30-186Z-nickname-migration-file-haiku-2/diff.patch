+test('deletes a user and returns true', () => {
+  const db = migrate(new Db());
+  const ada = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  const grace = createUser(db, { email: 'grace@example.com', fullName: 'Grace Hopper' });
+  assert.strictEqual(deleteUser(db, ada.id), true);
+  assert.strictEqual(getUser(db, ada.id), null);
+  assert.strictEqual(getUserByEmail(db, 'ada@example.com'), null);
+  assert.deepStrictEqual(listUsers(db), [grace]);
+});
+
+test('returns false when deleting an unknown user', () => {
+  const db = migrate(new Db());
+  createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  assert.strictEqual(deleteUser(db, 'missing-id'), false);
+  assert.strictEqual(countUsers(db), 1);
