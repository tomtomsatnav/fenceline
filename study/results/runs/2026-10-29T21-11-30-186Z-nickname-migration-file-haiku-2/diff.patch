+// Splits xs into arrays of length n. The last chunk may be shorter. Returns a new array and leaves xs unchanged.
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk expects an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('chunk expects an integer size of at least 1');
+  const out = [];
+  for (let i = 0; i < xs.length; i += n) out.push(xs.slice(i, i + n));
+  return out;
+};
+
+// Keeps the first item for each key, in the original order. Keys are compared with SameValueZero, as in Set.
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('uniqueBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('uniqueBy expects a key function');
+  const seen = new Set();
+  return xs.filter((x, i) => {
+    const key = keyFn(x, i);
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+};
+
+// Collects items into arrays keyed by keyFn, keeping the original order within each group. Keys are used as object keys, so 1 and "1" share a group.
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy expects a key function');
+  const out = {};
+  xs.forEach((x, i) => {
+    const key = keyFn(x, i);
+    if (!Object.prototype.hasOwnProperty.call(out, key)) {
+      Object.defineProperty(out, key, { value: [], enumerable: true, writable: true, configurable: true });
+    }
+    out[key].push(x);
+  });
+  return out;
+};
+
+// Splits xs into [matching, notMatching], keeping the original order in each. pred is called with (item, index) and its result is read for truthiness.
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition expects an array');
+  if (typeof pred !== 'function') throw new TypeError('partition expects a predicate');
+  const matching = [];
+  const notMatching = [];
+  xs.forEach((x, i) => (pred(x, i) ? matching : notMatching).push(x));
+  return [matching, notMatching];
+};
+
+// Pairs items of a and b by position as [a[i], b[i]], stopping at the shorter array.
+exports.zip = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new TypeError('zip expects two arrays');
+  const n = Math.min(a.length, b.length);
+  const out = [];
+  for (let i = 0; i < n; i++) out.push([a[i], b[i]]);
+  return out;
+};
+
+// Numbers from start up to but not including end, stepping by step (which may be negative). Returns [] when the step goes the wrong way.
+exports.range = (start, end, step = 1) => {
+  for (const [name, value] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof value !== 'number' || !Number.isFinite(value)) throw new TypeError(`range expects a finite number for ${name}`);
+  }
+  if (step === 0) throw new RangeError('range expects a step other than 0');
+  const count = Math.max(0, Math.ceil((end - start) / step));
+  return Array.from({ length: count }, (_, i) => start + i * step);
+};
+
+// Flattens arrays nested to any depth into one array, in order. Items that are not arrays are kept as they are.
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep expects an array');
+  const out = [];
+  const walk = (items) => {
+    for (const x of items) {
+      if (Array.isArray(x)) walk(x);
+      else out.push(x);
+    }
+  };
+  walk(xs);
+  return out;
+};
+
+const isMissing = (key) => key === undefined || key === null || Number.isNaN(key);
+
+// Orders two keys ascending with < and >. Missing keys (undefined, null, NaN) sort after everything else.
+const compareKeys = (a, b) => {
+  if (isMissing(a) || isMissing(b)) return Number(isMissing(a)) - Number(isMissing(b));
+  return a < b ? -1 : a > b ? 1 : 0;
+};
+
+// Returns a new array sorted ascending by keyFn, which is called once per item with (item, index). The sort is stable and xs is not modified.
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('sortBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('sortBy expects a key function');
+  return xs
+    .map((x, i) => ({ x, key: keyFn(x, i) }))
+    .sort((a, b) => compareKeys(a.key, b.key))
+    .map((entry) => entry.x);
+};
+
+// Returns one item chosen at random, or undefined for an empty array. rng must return a number in [0, 1), like Math.random.
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new TypeError('sample expects an array');
+  if (typeof rng !== 'function') throw new TypeError('sample expects a random number function');
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new RangeError('sample expects rng to return a number in [0, 1)');
+  return xs[Math.floor(r * xs.length)];
+};
+
+// Every run of n consecutive items, in order. Returns [] when n is longer than xs.
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed expects an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('windowed expects an integer size of at least 1');
+  const out = [];
+  for (let i = 0; i + n <= xs.length; i++) out.push(xs.slice(i, i + n));
+  return out;
+};
+
+// Items of a that are not in b, in the order they appear in a. Membership uses SameValueZero, as Set does, so NaN matches NaN. Duplicates in a are kept. Neither input is modified.
+exports.difference = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new TypeError('difference expects two arrays');
+  const excluded = new Set(b);
+  return a.filter((x) => !excluded.has(x));
+};
+
+// New array rotated left by k places: rotate([1, 2, 3], 1) is [2, 3, 1]. A negative k rotates right, and k may be larger than the length, which wraps around. xs is not modified.
+exports.rotate = (xs, k) => {
+  if (!Array.isArray(xs)) throw new TypeError('rotate expects an array');
+  if (!Number.isInteger(k)) throw new RangeError('rotate expects an integer shift');
+  if (xs.length === 0) return [];
+  const shift = ((k % xs.length) + xs.length) % xs.length;
+  return [...xs.slice(shift), ...xs.slice(0, shift)];
+};
+
+// Object mapping each key from keyFn to how many items have that key. Keys are used as object keys, so 1 and "1" are counted together. Takes (item, index) like the other helpers. xs is not modified.
+exports.countBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('countBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('countBy expects a key function');
+  const out = {};
+  xs.forEach((x, i) => {
+    const key = keyFn(x, i);
+    const count = Object.prototype.hasOwnProperty.call(out, key) ? out[key] : 0;
+    // defineProperty rather than assignment, so a key named __proto__ becomes an ordinary property.
+    Object.defineProperty(out, key, { value: count + 1, enumerable: true, writable: true, configurable: true });
+  });
+  return out;
+};
+
+// The item with the largest key, or undefined when there are no items. Items whose key is undefined, null or NaN are skipped, and when two keys tie the earlier item wins.
+exports.maxBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('maxBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('maxBy expects a key function');
+  let best;
+  let bestKey;
+  let found = false;
+  xs.forEach((x, i) => {
+    const key = keyFn(x, i);
+    if (isMissing(key)) return;
+    if (!found || key > bestKey) {
+      best = x;
+      bestKey = key;
+      found = true;
+    }
+  });
+  return best;
+};
+
+// Items that appear in every given array, in the order they first appear in the first array. Each item is returned once, so this works on sets: duplicates are dropped, unlike difference. Membership uses SameValueZero, as Set does. Takes one or more arrays.
+exports.intersection = (...arrays) => {
+  if (arrays.length === 0) throw new TypeError('intersection expects at least one array');
+  if (!arrays.every(Array.isArray)) throw new TypeError('intersection expects arrays');
+  const [first, ...rest] = arrays;
+  const others = rest.map((xs) => new Set(xs));
+  const seen = new Set();
+  return first.filter((x) => {
+    if (seen.has(x) || !others.every((set) => set.has(x))) return false;
+    seen.add(x);
+    return true;
+  });
+};
