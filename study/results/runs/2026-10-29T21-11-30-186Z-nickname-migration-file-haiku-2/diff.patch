+  const labels = domain.split('.');
+  if (labels.length < 2) return false;
+  const labelsOk = labels.slice(0, -1).every((label) => /^[A-Za-z0-9-]{1,63}$/.test(label) && !label.startsWith('-') && !label.endsWith('-'));
+  const topLevelOk = /^[A-Za-z]{2,}$/.test(labels[labels.length - 1]);
+  return labelsOk && topLevelOk;
+};
