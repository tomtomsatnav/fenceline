+
+// True for a three-letter code from the list above. The code must be upper-case, so "usd" is rejected.
+exports.isIsoCurrency = (text) => {
+  if (typeof text !== 'string') throw new TypeError('isIsoCurrency expects a string');
+  return COMMON_CURRENCIES.has(text);
+};
+
+// A hash followed by three or six hexadecimal digits. The four- and eight-digit forms with alpha are not accepted. Case is ignored.
+const HEX_COLOR_PATTERN = /^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i;
+
+exports.isHexColor = (text) => {
+  if (typeof text !== 'string') throw new TypeError('isHexColor expects a string');
+  return HEX_COLOR_PATTERN.test(text);
+};
+
+// Four decimal parts, each 0 to 255. A part is either 0 or starts with a non-zero digit, so "01" is rejected. Only the dotted-quad form is accepted: no ports, prefixes or IPv6.
+const IPV4_PART_PATTERN = /^(0|[1-9][0-9]{0,2})$/;
+
+exports.isIPv4 = (text) => {
+  if (typeof text !== 'string') throw new TypeError('isIPv4 expects a string');
+  const parts = text.split('.');
+  return parts.length === 4 && parts.every((part) => IPV4_PART_PATTERN.test(part) && Number(part) <= 255);
+};
+
+// The official grammar from semver.org. Major, minor and patch are numbers with no leading zeros. A pre-release has dot-separated identifiers, and numeric ones may not have leading zeros. Build metadata follows "+" and may have leading zeros. A leading "v" is not accepted.
+const SEMVER_PATTERN = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\+([0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*))?$/;
+
+exports.isSemver = (text) => {
+  if (typeof text !== 'string') throw new TypeError('isSemver expects a string');
+  return SEMVER_PATTERN.test(text);
+};
diff --git a/test/export.test.js b/test/export.test.js
new file mode 100644
index 0000000..e3adcfa
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,77 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { createUser, recordLogin, listUsers, countUsers } = require('../src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+test('exports only the header row when there are no users', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), 'id,email,fullName,createdAt,lastLogin\n');
+});
+
+test('exports one row per user, oldest first, with empty last login', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'b', email: 'b@example.com', fullname: 'Bo', created_at: '2024-02-01T00:00:00.000Z' });
+  db.insert('users', { id: 'a', email: 'a@example.com', fullname: 'Ada', created_at: '2024-01-01T00:00:00.000Z' });
+  assert.strictEqual(
+    exportUsersCsv(db),
+    'id,email,fullName,createdAt,lastLogin\n' +
+      'a,a@example.com,Ada,2024-01-01T00:00:00.000Z,\n' +
+      'b,b@example.com,Bo,2024-02-01T00:00:00.000Z,\n',
+  );
+});
+
+test('quotes fields that contain commas, quotes or line breaks', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'a', email: 'ada@example.com', fullname: 'Lovelace, Ada "Countess"', created_at: '2024-01-01T00:00:00.000Z' });
+  db.insert('users', { id: 'b', email: 'b@example.com', fullname: 'Line\nBreak', created_at: '2024-02-01T00:00:00.000Z' });
+  const lines = exportUsersCsv(db);
+  assert.ok(lines.includes('a,ada@example.com,"Lovelace, Ada ""Countess""",2024-01-01T00:00:00.000Z,\n'));
+  assert.ok(lines.includes('b,b@example.com,"Line\nBreak",2024-02-01T00:00:00.000Z,\n'));
+});
+
+test('includes the last login when one is recorded', () => {
+  const db = migrate(new Db());
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  recordLogin(db, u.id, new Date('2024-05-01T12:00:00.000Z'));
+  assert.ok(exportUsersCsv(db).endsWith(`,2024-05-01T12:00:00.000Z\n`));
+});
+
+test('exports every user, not just the first page', () => {
+  const db = migrate(new Db());
+  for (let i = 0; i < 51; i++) {
+    db.insert('users', { id: `id${i}`, email: `u${i}@example.com`, fullname: `User ${i}`, created_at: new Date(Date.UTC(2024, 0, 1, 0, 0, i)).toISOString() });
+  }
+  assert.strictEqual(exportUsersCsv(db).trim().split('\n').length, 52);
+});
+
+test('requires a db', () => {
+  assert.throws(() => exportUsersCsv(undefined), /db is required/);
+});
+
+test('round-trips users through CSV', () => {
+  const source = migrate(new Db());
+  createUser(source, { email: 'ada@example.com', fullName: 'Lovelace, Ada "Countess"' });
+  const grace = createUser(source, { email: 'grace@example.com', fullName: 'Grace Hopper' });
+  recordLogin(source, grace.id, new Date('2024-05-01T12:00:00.000Z'));
+
+  const target = migrate(new Db());
+  assert.strictEqual(importUsersCsv(target, exportUsersCsv(source)), 2);
+  assert.deepStrictEqual(listUsers(target), listUsers(source));
+});
+
+test('rejects a CSV with the wrong header and imports nothing', () => {
+  const db = migrate(new Db());
+  assert.throws(() => importUsersCsv(db, 'email,name\na@example.com,Ada\n'), /unexpected CSV header/);
+  assert.strictEqual(countUsers(db), 0);
+});
+
+test('rejects a duplicate email and imports nothing', () => {
+  const db = migrate(new Db());
+  createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  const csv = 'id,email,fullName,createdAt,lastLogin\n' +
+    'x,grace@example.com,Grace,2024-01-01T00:00:00.000Z,\n' +
+    'y,ADA@example.com,Ada2,2024-01-01T00:00:00.000Z,\n';
+  assert.throws(() => importUsersCsv(db, csv), /duplicate email: ADA@example.com/);
+  assert.strictEqual(countUsers(db), 1);
+});
