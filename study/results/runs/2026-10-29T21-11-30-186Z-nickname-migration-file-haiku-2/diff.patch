new file mode 100644
index 0000000..51b844b
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,84 @@
+const { listUsers } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quotes a CSV field when it contains a comma, a quote or a line break; null becomes an empty field.
+const csvField = (value) => {
+  if (value === null || value === undefined) return '';
+  const s = String(value);
+  return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * Writes every user as CSV, with a header row, oldest first.
+ * @param {import('../db.js').Db} db
+ * @returns {string} CSV text ending in a newline.
+ * @throws {Error} If db is missing.
+ */
+exports.exportUsersCsv = (db) => {
+  const users = listUsers(db, { limit: Infinity });
+  const lines = [COLUMNS, ...users.map((u) => COLUMNS.map((c) => u[c]))].map((cells) => cells.map(csvField).join(','));
+  return lines.join('\n') + '\n';
+};
+
+// Splits CSV text into rows of fields, handling quoted fields, doubled quotes and line breaks inside quotes.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let inQuotes = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (inQuotes) {
+      if (c !== '"') field += c;
+      else if (text[i + 1] === '"') { field += '"'; i++; }
+      else inQuotes = false;
+    } else if (c === '"') {
+      inQuotes = true;
+    } else if (c === ',') {
+      row.push(field);
+      field = '';
+    } else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+    } else {
+      field += c;
+    }
+  }
+  if (field !== '' || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+  return rows;
+};
+
+/**
+ * Inserts users from CSV written by exportUsersCsv, keeping their ids and timestamps.
+ * Nothing is inserted unless every row is valid.
+ * @param {import('../db.js').Db} db
+ * @param {string} csv
+ * @returns {number} How many users were imported.
+ * @throws {Error} If db is missing, the header is wrong, a row is malformed, or an id or email is duplicated.
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (!db) throw new Error('db is required');
+  const [header = [], ...records] = parseCsv(csv);
+  if (header.join(',') !== COLUMNS.join(',')) throw new Error('unexpected CSV header');
+
+  const seenIds = new Set(db.all('users').map((u) => u.id));
+  const seenEmails = new Set(db.all('users').map((u) => u.email.toLowerCase()));
+  const rows = records.map((record, i) => {
+    if (record.length !== COLUMNS.length) throw new Error(`row ${i + 1} has ${record.length} fields, expected ${COLUMNS.length}`);
+    const [id, email, fullName, createdAt, lastLogin] = record;
+    if (seenIds.has(id)) throw new Error(`duplicate id: ${id}`);
+    if (seenEmails.has(email.toLowerCase())) throw new Error(`duplicate email: ${email}`);
+    seenIds.add(id);
+    seenEmails.add(email.toLowerCase());
+    return { id, email, fullname: fullName, created_at: createdAt, last_login: lastLogin === '' ? null : lastLogin };
+  });
+  for (const row of rows) db.insert('users', row);
+  return rows.length;
+};
