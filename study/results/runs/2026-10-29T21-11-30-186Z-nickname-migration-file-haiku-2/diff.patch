+
+/**
+ * Finds a user by email, ignoring case.
+ * @param {import('../db.js').Db} db
+ * @param {string} email
+ * @returns {User | null} The user, or null if none has that email.
+ * @throws {Error} If db is missing.
+ */
+exports.getUserByEmail = (db, email) => {
+  requireDb(db);
+  const r = db.find('users', (u) => u.email.toLowerCase() === email.toLowerCase());
+  if (!r) return null;
+  return fromRow(r);
+};
+
+/**
+ * Counts all users.
+ * @param {import('../db.js').Db} db
+ * @returns {number}
+ * @throws {Error} If db is missing.
+ */
+exports.countUsers = (db) => {
+  requireDb(db);
+  return db.all('users').length;
+};
+
+/**
+ * Sets a user's last login time.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {Date | string | number} [when] Defaults to now.
+ * @returns {User} The updated user.
+ * @throws {Error} If db is missing or no user has that id.
+ */
+exports.recordLogin = (db, id, when = new Date()) => {
+  requireDb(db);
+  if (!db.update('users', (u) => u.id === id, { last_login: new Date(when).toISOString() })) throw new Error(`no user with id ${id}`);
+  return exports.getUser(db, id);
+};
+
+/**
+ * Deletes a user by id.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @returns {boolean} true if a user was deleted, false if none had that id.
+ * @throws {Error} If db is missing.
+ */
+exports.deleteUser = (db, id) => {
+  requireDb(db);
+  return db.delete('users', (u) => u.id === id) > 0;
+};
+
+/**
+ * Changes the given fields of a user. Fields left undefined are not changed.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {{ email?: string, fullName?: string }} changes
+ * @returns {User} The updated user.
+ * @throws {Error} If db is missing, no user has that id, or a new email or fullName is invalid or taken.
+ */
+exports.updateUser = (db, id, { email, fullName } = {}) => {
+  requireDb(db);
+  if (!exports.getUser(db, id)) throw new Error(`no user with id ${id}`);
+  if (email !== undefined) {
+    if (!email.includes('@')) throw new Error('invalid email: missing "@"');
+    const other = exports.getUserByEmail(db, email);
+    if (other && other.id !== id) throw new Error(`email already in use: ${email}`);
+  }
+  if (fullName !== undefined) validateFullName(fullName);
+  db.update('users', (u) => u.id === id, toRow({ email, fullName }));
+  return exports.getUser(db, id);
+};
+
+const sortedUsers = (db) => db.all('users').map(fromRow).sort((a, b) => a.createdAt.localeCompare(b.createdAt));
+
+/**
+ * Lists users, oldest first, one page at a time.
+ * @param {import('../db.js').Db} db
+ * @param {{ limit?: number, offset?: number }} [page] Defaults to the first 50 users.
+ * @returns {User[]}
+ * @throws {Error} If db is missing.
+ */
+exports.listUsers = (db, { limit = 50, offset = 0 } = {}) => {
+  requireDb(db);
+  return sortedUsers(db).slice(offset, offset + limit);
+};
+
+/**
+ * Finds users whose full name or email contains the query, ignoring case. Oldest first.
+ * @param {import('../db.js').Db} db
+ * @param {string} query
+ * @returns {User[]}
+ * @throws {Error} If db is missing.
+ */
+exports.searchUsers = (db, query) => {
+  requireDb(db);
+  const q = query.toLowerCase();
+  return sortedUsers(db).filter((u) => u.fullName.toLowerCase().includes(q) || u.email.toLowerCase().includes(q));
 };
