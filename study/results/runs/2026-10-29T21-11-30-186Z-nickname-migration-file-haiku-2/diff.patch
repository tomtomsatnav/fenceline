+const test = require('node:test');
+const assert = require('node:assert');
+const { clamp, roundTo, mean, median, percentile, formatBytes, isPrime, gcd, toRoman, fromRoman, lerp, stdDev, fibonacci, toOrdinal, parseDuration } = require('../src/lib/numbers.js');
+
+test('clamp returns x when it is inside the range', () => {
+  assert.strictEqual(clamp(5, 0, 10), 5);
+  assert.strictEqual(clamp(0, 0, 10), 0);
+  assert.strictEqual(clamp(10, 0, 10), 10);
+});
+
+test('clamp raises x to lo when it is below the range', () => {
+  assert.strictEqual(clamp(-3, 0, 10), 0);
+});
+
+test('clamp lowers x to hi when it is above the range', () => {
+  assert.strictEqual(clamp(42, 0, 10), 10);
+});
+
+test('clamp with lo equal to hi always returns that value', () => {
+  assert.strictEqual(clamp(1, 5, 5), 5);
+  assert.strictEqual(clamp(9, 5, 5), 5);
+});
+
+test('clamp works with negative bounds and fractions', () => {
+  assert.strictEqual(clamp(-7, -5, -1), -5);
+  assert.strictEqual(clamp(0.25, 0, 0.5), 0.25);
+});
+
+test('clamp works with infinite bounds and values', () => {
+  assert.strictEqual(clamp(Infinity, 0, 10), 10);
+  assert.strictEqual(clamp(-Infinity, 0, 10), 0);
+  assert.strictEqual(clamp(5, -Infinity, Infinity), 5);
+});
+
+test('clamp throws a RangeError when lo is greater than hi', () => {
+  assert.throws(() => clamp(5, 10, 0), RangeError);
+});
+
+test('clamp throws a TypeError for non-numbers or NaN', () => {
+  assert.throws(() => clamp('5', 0, 10), TypeError);
+  assert.throws(() => clamp(5, null, 10), TypeError);
+  assert.throws(() => clamp(5, 0), TypeError);
+  assert.throws(() => clamp(NaN, 0, 10), TypeError);
+  assert.throws(() => clamp(5, 0, NaN), TypeError);
+});
+
+test('roundTo rounds to whole numbers with halves going away from zero', () => {
+  assert.strictEqual(roundTo(2.4, 0), 2);
+  assert.strictEqual(roundTo(2.5, 0), 3);
+  assert.strictEqual(roundTo(-2.5, 0), -3);
+  assert.strictEqual(roundTo(-2.4, 0), -2);
+});
+
+test('roundTo rounds to decimal places', () => {
+  assert.strictEqual(roundTo(1.23456, 2), 1.23);
+  assert.strictEqual(roundTo(1.23456, 3), 1.235);
+  assert.strictEqual(roundTo(-1.23456, 2), -1.23);
+});
+
+test('roundTo rounds decimal halves the way people write them', () => {
+  assert.strictEqual(roundTo(1.005, 2), 1.01);
+  assert.strictEqual(roundTo(1.255, 2), 1.26);
+  assert.strictEqual(roundTo(-1.005, 2), -1.01);
+});
