+  assert.strictEqual(roundTo(1250, -2), 1300);
+  assert.strictEqual(roundTo(-1250, -2), -1300);
+});
+
+test('roundTo returns a value that is already rounded unchanged', () => {
+  assert.strictEqual(roundTo(3, 2), 3);
+  assert.strictEqual(roundTo(1.5, 4), 1.5);
+});
+
+test('roundTo handles tiny and huge numbers written in exponent form', () => {
+  assert.strictEqual(roundTo(1.5e-7, 7), 2e-7);
+  assert.strictEqual(roundTo(1e-7, 3), 0);
+  assert.strictEqual(roundTo(1e21, 2), 1e21);
