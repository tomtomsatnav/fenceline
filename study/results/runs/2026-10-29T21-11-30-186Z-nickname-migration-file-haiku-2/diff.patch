+test('isEmail accepts ordinary addresses', () => {
+  assert.strictEqual(isEmail('ada@example.com'), true);
+  assert.strictEqual(isEmail('a.b+c@sub.example.co.uk'), true);
+  assert.strictEqual(isEmail('x@y.io'), true);
+  assert.strictEqual(isEmail('first_last-2@my-domain.org'), true);
+});
+
+test('isEmail ignores letter case', () => {
+  assert.strictEqual(isEmail('ADA@EXAMPLE.COM'), true);
+});
+
+test('isEmail requires exactly one @', () => {
+  assert.strictEqual(isEmail('adaexample.com'), false);
+  assert.strictEqual(isEmail('ada@@example.com'), false);
+  assert.strictEqual(isEmail('ada@x@example.com'), false);
+});
+
+test('isEmail requires a local part and a domain', () => {
+  assert.strictEqual(isEmail('@example.com'), false);
+  assert.strictEqual(isEmail('ada@'), false);
+  assert.strictEqual(isEmail('@'), false);
+});
+
+test('isEmail requires a dot in the domain', () => {
+  assert.strictEqual(isEmail('ada@example'), false);
+});
+
+test('isEmail rejects empty domain labels and a domain that starts or ends with a dot', () => {
+  assert.strictEqual(isEmail('ada@.com'), false);
+  assert.strictEqual(isEmail('ada@example.'), false);
+  assert.strictEqual(isEmail('ada@ex..ample.com'), false);
+});
+
+test('isEmail rejects spaces anywhere', () => {
+  assert.strictEqual(isEmail('ada lovelace@example.com'), false);
+  assert.strictEqual(isEmail('ada@exa mple.com'), false);
+  assert.strictEqual(isEmail(' ada@example.com'), false);
+  assert.strictEqual(isEmail('ada@example.com '), false);
+  assert.strictEqual(isEmail('ada@example.com\n'), false);
+});
+
+test('isEmail rejects hyphens at the start or end of a domain label', () => {
+  assert.strictEqual(isEmail('ada@-example.com'), false);
+  assert.strictEqual(isEmail('ada@example-.com'), false);
+});
+
+test('isEmail requires a top-level domain of letters, at least two characters', () => {
+  assert.strictEqual(isEmail('ada@example.c'), false);
+  assert.strictEqual(isEmail('ada@example.c0m'), false);
+  assert.strictEqual(isEmail('ada@example.123'), false);
+});
+
+test('isEmail rejects a local part that starts or ends with a dot, or has two dots in a row', () => {
+  assert.strictEqual(isEmail('.ada@example.com'), false);
+  assert.strictEqual(isEmail('ada.@example.com'), false);
+  assert.strictEqual(isEmail('ada..x@example.com'), false);
+});
+
+test('isEmail limits the local part to 64 characters', () => {
+  assert.strictEqual(isEmail(`${'a'.repeat(64)}@example.com`), true);
+  assert.strictEqual(isEmail(`${'a'.repeat(65)}@example.com`), false);
+});
+
+test('isEmail limits the whole address to 254 characters', () => {
+  const longDomain = ['b'.repeat(63), 'c'.repeat(63), 'd'.repeat(63), 'io'].join('.');
+  // The local part of 58 characters gives 253 in total, and 60 gives 255.
+  assert.strictEqual(isEmail(`${'a'.repeat(58)}@${longDomain}`), true);
+  assert.strictEqual(isEmail(`${'a'.repeat(60)}@${longDomain}`), false);
+});
+
+test('isEmail rejects empty and blank strings', () => {
+  assert.strictEqual(isEmail(''), false);
+  assert.strictEqual(isEmail('   '), false);
+});
+
+test('isEmail rejects Unicode domains', () => {
+  assert.strictEqual(isEmail('ada@exämple.com'), false);
+});
+
+test('isEmail throws a TypeError for a non-string', () => {
