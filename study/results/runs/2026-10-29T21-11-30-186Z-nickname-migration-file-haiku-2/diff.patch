+  const values = { I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000 };
+  const read = (s) => [...s].reduce((sum, ch, i, all) => (values[ch] < values[all[i + 1]] ? sum - values[ch] : sum + values[ch]), 0);
