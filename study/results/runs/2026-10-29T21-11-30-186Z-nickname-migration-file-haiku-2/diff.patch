+exports.padCenter = (s, width, ch = ' ') => {
+  if (typeof s !== 'string') throw new TypeError('padCenter expects a string');
+  if (!Number.isInteger(width) || width < 0) throw new RangeError('padCenter expects a non-negative integer width');
+  if (typeof ch !== 'string' || Array.from(ch).length !== 1) throw new RangeError('padCenter expects a single character as the fill');
