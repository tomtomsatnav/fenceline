+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+    throw new RangeError(`parseIsoDate: ${JSON.stringify(text)} is not a valid calendar date`);
+  }
+  return date;
+};
+
+/**
+ * The age in whole years of someone born on birthDate, on the given date: the number of birthdays they have had
+ * by then. Only the UTC calendar day matters, not the time of day, and a birthday counts from the first moment
+ * (UTC midnight) of its day: someone born 1990-06-15 is 30 from 2020-06-15T00:00:00Z onwards and still 29 at
+ * 2020-06-14T23:59:59.999Z. On the birth day itself the age is 0. The result is the same in every time zone.
+ * Someone born on February 29 has their birthday on March 1 in years that are not leap years (so they are still
+ * 0 on 2001-02-28 and become 1 on 2001-03-01), which is how "has the month and day been reached yet" works out;
+ * some countries use February 28 instead. Neither date is modified.
+ * @param {Date} birthDate a valid Date
+ * @param {Date} date a valid Date, not before birthDate (on the UTC day)
+ * @returns {number} an integer, 0 or more
+ * @throws {TypeError} if birthDate or date is not a Date
+ * @throws {RangeError} if either is an invalid Date, or date is on an earlier UTC day than birthDate
+ */
+exports.ageOn = (birthDate, date) => {
+  for (const [name, value] of [['birthDate', birthDate], ['date', date]]) {
+    if (!(value instanceof Date)) throw new TypeError(`ageOn: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`ageOn: ${name} is an invalid Date`);
+  }
+  if (exports.daysBetween(birthDate, date) < 0) throw new RangeError('ageOn: date is before birthDate');
+  const birthday = (d) => [d.getUTCMonth(), d.getUTCDate()];
+  const [birthMonth, birthDay] = birthday(birthDate);
+  const [month, day] = birthday(date);
+  const reached = month > birthMonth || (month === birthMonth && day >= birthDay);
+  return date.getUTCFullYear() - birthDate.getUTCFullYear() - (reached ? 0 : 1);
+};
+
+const SECOND = 1000;
+const MINUTE = 60 * SECOND;
+const HOUR = 60 * MINUTE;
+const DAY = 24 * HOUR;
+// [unit, length in ms] from largest to smallest; months and years are approximate (30 and 365 days).
+const RELATIVE_UNITS = [['year', 365 * DAY], ['month', 30 * DAY], ['week', 7 * DAY], ['day', DAY], ['hour', HOUR], ['minute', MINUTE], ['second', SECOND]];
+
+/**
+ * Describe how far date is from now in words: "3 minutes ago", "in 2 days", "1 hour ago", "just now".
+ * Only the largest unit is shown and the amount is rounded down, so 119 seconds is "1 minute ago" and 59.999
+ * seconds is "59 seconds ago". Units are seconds, minutes, hours, days, weeks (from 7 days), months (from 30 days,
+ * at most 11) and years (from 365 days); months and years are fixed lengths of 30 and 365 days, not calendar months,
+ * so this is a rough description, not date arithmetic. Anything less than a second apart, in either direction, is
+ * "just now". Amounts are written as numerals ("1 day ago", never "yesterday" or "a day ago") and are singular only
+ * for exactly 1. The result depends only on the time between the two dates, so it is the same in every time zone.
+ * Neither date is modified.
+ * @param {Date} date the moment to describe, a valid Date
+ * @param {Date} [now] the moment to compare it with, a valid Date; defaults to the current time
+ * @returns {string} "just now", "N unit(s) ago" for a date before now, or "in N unit(s)" for a date after it
+ * @throws {TypeError} if date or now is not a Date
+ * @throws {RangeError} if date or now is an invalid Date
+ */
+exports.relativeTime = (date, now = new Date()) => {
+  for (const [name, value] of [['date', date], ['now', now]]) {
+    if (!(value instanceof Date)) throw new TypeError(`relativeTime: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`relativeTime: ${name} is an invalid Date`);
+  }
+  const diff = date.getTime() - now.getTime();
+  const distance = Math.abs(diff);
+  const found = RELATIVE_UNITS.find(([, length]) => distance >= length);
+  if (found === undefined) return 'just now';
+  const [unit, length] = found;
+  let amount = Math.floor(distance / length);
+  if (unit === 'month') amount = Math.min(amount, 11); // 335-364 days: still months, not "12 months"
+  const phrase = `${amount} ${unit}${amount === 1 ? '' : 's'}`;
+  return diff < 0 ? `${phrase} ago` : `in ${phrase}`;
+};
