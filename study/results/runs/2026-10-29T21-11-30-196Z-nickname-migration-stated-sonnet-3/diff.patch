@@ -0,0 +1,10 @@
+/**
+ * The name to show for a user: their fullName, or the part of their email before "@" if fullName is empty.
+ * @param {{fullName?: string|null, email: string}} user
+ * @returns {string}
+ */
+exports.displayName = (user) => {
+  const name = user.fullName;
+  if (typeof name === 'string' && name.trim() !== '') return name;
+  return user.email.split('@')[0];
+};
