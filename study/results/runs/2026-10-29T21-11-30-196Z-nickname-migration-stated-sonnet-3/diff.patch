@@ -0,0 +1,246 @@
+/**
+ * Split an array into consecutive chunks of length n; the last chunk may be shorter.
+ * The input is not modified and the chunks are new arrays holding the same elements (shallow copies).
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n the chunk length: a positive integer
+ * @returns {T[][]} [] for an empty array
+ * @throws {TypeError} if xs is not an array
+ * @throws {RangeError} if n is not a positive integer
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk: expected an array');
+  if (!(Number.isInteger(n) && n > 0)) throw new RangeError('chunk: n must be a positive integer');
+  const chunks = [];
+  for (let i = 0; i < xs.length; i += n) chunks.push(xs.slice(i, i + n));
+  return chunks;
+};
+
+/**
+ * Keep the first item for each key, in the original order: uniqueBy(users, (u) => u.email).
+ * Keys are compared like Set members (SameValueZero): 1 and '1' differ, NaN equals NaN, and objects are
+ * compared by identity. keyFn is called once per item, in order, with (item, index). The input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => unknown} keyFn
+ * @returns {T[]} a new array
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('uniqueBy: expected an array');
+  if (typeof keyFn !== 'function') throw new TypeError('uniqueBy: keyFn must be a function');
+  const seen = new Set();
+  const out = [];
+  for (let i = 0; i < xs.length; i++) {
+    const key = keyFn(xs[i], i);
+    if (!seen.has(key)) {
+      seen.add(key);
+      out.push(xs[i]);
+    }
+  }
+  return out;
+};
+
+/**
+ * Group items into an object of arrays keyed by keyFn: groupBy([1, 2, 3], (n) => n % 2 ? 'odd' : 'even')
+ * gives { odd: [1, 3], even: [2] }. Items keep their original order within each group.
+ * Keys become property keys, so they are converted to strings (1 and '1' share a group, null is "null",
+ * objects are "[object Object]"); symbols are kept. As with any object, integer-like keys are listed first
+ * in ascending order. Keys like "__proto__" and "constructor" are ordinary own keys of the (plain) result.
+ * keyFn is called once per item, in order, with (item, index). The input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => PropertyKey} keyFn
+ * @returns {Record<PropertyKey, T[]>} {} for an empty array
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy: expected an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy: keyFn must be a function');
+  const groups = {};
+  for (let i = 0; i < xs.length; i++) {
+    const rawKey = keyFn(xs[i], i);
+    const key = typeof rawKey === 'symbol' ? rawKey : String(rawKey);
+    if (Object.hasOwn(groups, key)) groups[key].push(xs[i]);
+    else Object.defineProperty(groups, key, { value: [xs[i]], writable: true, enumerable: true, configurable: true });
+  }
+  return groups;
+};
+
+/**
+ * Split an array in two: the items for which pred is truthy, and the rest. Both keep the original order.
+ * pred is called once per item, in order, with (item, index). The input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => unknown} pred
+ * @returns {[T[], T[]]} [matching, notMatching]; two empty arrays for an empty input
+ * @throws {TypeError} if xs is not an array or pred is not a function
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition: expected an array');
+  if (typeof pred !== 'function') throw new TypeError('partition: pred must be a function');
+  const matching = [];
+  const notMatching = [];
+  for (let i = 0; i < xs.length; i++) (pred(xs[i], i) ? matching : notMatching).push(xs[i]);
+  return [matching, notMatching];
+};
+
+/**
+ * Pair up items from two arrays by position, stopping at the shorter one: zip([1, 2, 3], ['a', 'b']) gives
+ * [[1, 'a'], [2, 'b']]. The pairs are new arrays holding the original items; the inputs are not modified.
+ * @template A, B
+ * @param {A[]} a
+ * @param {B[]} b
+ * @returns {[A, B][]} [] if either array is empty
+ * @throws {TypeError} if a or b is not an array
+ */
+exports.zip = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new TypeError('zip: expected two arrays');
+  const pairs = [];
+  for (let i = 0; i < Math.min(a.length, b.length); i++) pairs.push([a[i], b[i]]);
+  return pairs;
+};
+
+/**
+ * The numbers from start up to but not including end, stepping by step: range(0, 5) is [0, 1, 2, 3, 4] and
+ * range(5, 0, -2) is [5, 3, 1]. The result is empty when step points away from end (range(5, 0), range(0, 5, -1))
+ * or start equals end. Each value is computed as start + i * step, so fractional steps do not accumulate error
+ * (though values like 0.30000000000000004 can still appear, as with any floating-point arithmetic).
+ * @param {number} start
+ * @param {number} end exclusive
+ * @param {number} [step] a non-zero finite number, 1 by default
+ * @returns {number[]}
+ * @throws {TypeError} if an argument is not a number
+ * @throws {RangeError} if start or end is not finite, step is zero or not finite, or the range is too long for an array
+ */
+exports.range = (start, end, step = 1) => {
+  for (const [name, value] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof value !== 'number') throw new TypeError(`range: ${name} must be a number`);
+    if (!Number.isFinite(value)) throw new RangeError(`range: ${name} must be finite`);
+  }
+  if (step === 0) throw new RangeError('range: step must not be zero');
+  const count = Math.max(0, Math.ceil((end - start) / step));
+  if (count > 2 ** 32 - 1) throw new RangeError('range: too many values');
+  return Array.from({ length: count }, (_, i) => start + i * step);
+};
+
+/**
+ * Flatten arbitrarily nested arrays into one flat array, in depth-first order: [1, [2, [3, [4]]]] becomes [1, 2, 3, 4].
+ * Only real arrays are flattened; strings, typed arrays, sets and array-like objects are kept as items.
+ * Holes in sparse arrays are skipped, as with Array.prototype.flat. Nesting depth is not limited by the call stack.
+ * The same array may appear several times, but an array that contains itself (directly or indirectly) is an error.
+ * The input is not modified.
+ * @param {unknown[]} xs
+ * @returns {unknown[]} a new array with no array items
+ * @throws {TypeError} if xs is not an array, or the nesting is circular
+ */
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep: expected an array');
+  const out = [];
+  const path = new Set([xs]); // arrays currently being walked, to detect cycles
+  const stack = [{ arr: xs, i: 0 }];
+  while (stack.length) {
+    const frame = stack[stack.length - 1];
+    if (frame.i >= frame.arr.length) {
+      path.delete(frame.arr);
+      stack.pop();
+      continue;
+    }
+    const idx = frame.i++;
+    if (!(idx in frame.arr)) continue;
+    const item = frame.arr[idx];
+    if (!Array.isArray(item)) {
+      out.push(item);
+    } else if (path.has(item)) {
+      throw new TypeError('flattenDeep: circular array');
+    } else {
+      path.add(item);
+      stack.push({ arr: item, i: 0 });
+    }
+  }
+  return out;
+};
+
+// Reduce a sort key to something comparable with < and >, or null for "missing" (sorted last).
+const sortKind = (key) => {
+  if (key === undefined || key === null || Number.isNaN(key)) return null;
+  if (key instanceof Date) return Number.isNaN(key.getTime()) ? null : { kind: 'number', value: key.getTime() };
+  const type = typeof key;
+  if (type === 'number' || type === 'bigint') return { kind: 'number', value: key };
+  if (type === 'string' || type === 'boolean') return { kind: type, value: key };
+  throw new TypeError(`sortBy: cannot sort by a key of type ${type}`);
+};
+
+/**
+ * Return a new array sorted by the key keyFn gives each item, ascending. The sort is stable (items with equal
+ * keys keep their original order) and xs is not modified. Reverse the result for descending order.
+ * keyFn is called once per item, in order, with (item, index).
+ * Keys may be numbers (bigints and Dates too, compared by value), strings (compared by UTF-16 code units, not
+ * by locale) or booleans (false before true), but one array must not mix these kinds. Items whose key is
+ * undefined, null or NaN (or an invalid Date) are placed last, in their original order.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => unknown} keyFn
+ * @returns {T[]} a new array
+ * @throws {TypeError} if xs is not an array, keyFn is not a function, a key is a symbol, function or non-Date
+ *   object, or keys of different kinds are mixed
+ */
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('sortBy: expected an array');
+  if (typeof keyFn !== 'function') throw new TypeError('sortBy: keyFn must be a function');
+  const entries = [];
+  const missing = [];
+  let kind = null;
+  for (let i = 0; i < xs.length; i++) {
+    const k = sortKind(keyFn(xs[i], i));
+    if (k === null) {
+      missing.push(xs[i]);
+      continue;
+    }
+    if (kind !== null && k.kind !== kind) throw new TypeError(`sortBy: cannot compare ${kind} and ${k.kind} keys`);
+    kind = k.kind;
+    entries.push({ item: xs[i], value: k.value, index: i });
+  }
+  entries.sort((a, b) => (a.value < b.value ? -1 : a.value > b.value ? 1 : a.index - b.index));
+  return [...entries.map((e) => e.item), ...missing];
+};
+
+/**
+ * Pick one random item from an array, each index equally likely. Pass your own rng (a function returning a
+ * number in [0, 1), like Math.random) for reproducible results. rng is called once, and not at all for an
+ * empty array. The input is not modified; the item itself is returned, not a copy.
+ * @template T
+ * @param {T[]} xs
+ * @param {() => number} [rng] defaults to Math.random
+ * @returns {T|undefined} undefined for an empty array
+ * @throws {TypeError} if xs is not an array or rng is not a function
+ * @throws {RangeError} if rng returns anything other than a number in [0, 1)
+ */
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new TypeError('sample: expected an array');
+  if (typeof rng !== 'function') throw new TypeError('sample: rng must be a function');
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new RangeError('sample: rng must return a number in [0, 1)');
+  return xs[Math.floor(r * xs.length)];
+};
+
+/**
+ * Every run of n consecutive items, as a sliding window moving one item at a time:
+ * windowed([1, 2, 3, 4], 2) gives [[1, 2], [2, 3], [3, 4]]. There are xs.length - n + 1 windows, so the result
+ * is empty when n is larger than the array. The windows are new arrays holding the original items (they do not
+ * share structure with each other or xs); the input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n the window length: a positive integer
+ * @returns {T[][]}
+ * @throws {TypeError} if xs is not an array
+ * @throws {RangeError} if n is not a positive integer
+ */
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed: expected an array');
+  if (!(Number.isInteger(n) && n > 0)) throw new RangeError('windowed: n must be a positive integer');
+  const windows = [];
+  for (let i = 0; i + n <= xs.length; i++) windows.push(xs.slice(i, i + n));
+  return windows;
+};
