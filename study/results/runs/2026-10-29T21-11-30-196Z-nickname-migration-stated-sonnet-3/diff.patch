@@ -0,0 +1,283 @@
+/**
+ * Limit x to the range lo..hi (inclusive): x if it is already inside, otherwise the nearest bound.
+ * The bounds may be infinite (clamp(x, 0, Infinity) only enforces a minimum) and may be equal; x may be infinite.
+ * @param {number} x
+ * @param {number} lo the lower bound
+ * @param {number} hi the upper bound, at least lo
+ * @returns {number}
+ * @throws {TypeError} if x, lo or hi is not a number
+ * @throws {RangeError} if x, lo or hi is NaN, or lo is greater than hi
+ */
+exports.clamp = (x, lo, hi) => {
+  for (const [name, value] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof value !== 'number') throw new TypeError(`clamp: ${name} must be a number`);
+    if (Number.isNaN(value)) throw new RangeError(`clamp: ${name} must not be NaN`);
+  }
+  if (lo > hi) throw new RangeError('clamp: lo must not be greater than hi');
+  return x < lo ? lo : x > hi ? hi : x;
+};
+
+// Multiply n by 10 ** k by editing its exponent, which avoids the binary rounding error of n * 10 ** k
+// (1.005 * 100 is 100.49999999999999, but "1.005e2" is exactly 100.5).
+const shift = (n, k) => {
+  const [mantissa, exponent = '0'] = String(n).split('e');
+  return Number(`${mantissa}e${Number(exponent) + k}`);
+};
+
+/**
+ * Round x to the given number of decimal places, with halves rounded away from zero:
+ * roundTo(2.5, 0) is 3, roundTo(-2.5, 0) is -3, roundTo(1.005, 2) is 1.01. Rounding looks at the decimal
+ * digits the number prints with, not its exact binary value, so numbers that print as halves round as people
+ * expect (plain Math.round(1.005 * 100) / 100 gives 1). A negative places rounds to the left of the decimal
+ * point: roundTo(1250, -2) is 1300. The result never has a negative zero. Infinity is returned as is.
+ * @param {number} x
+ * @param {number} [places] an integer from -100 to 100, 0 by default
+ * @returns {number}
+ * @throws {TypeError} if x or places is not a number
+ * @throws {RangeError} if x is NaN, or places is not an integer between -100 and 100
+ */
+exports.roundTo = (x, places = 0) => {
+  if (typeof x !== 'number') throw new TypeError('roundTo: x must be a number');
+  if (typeof places !== 'number') throw new TypeError('roundTo: places must be a number');
+  if (Number.isNaN(x)) throw new RangeError('roundTo: x must not be NaN');
+  if (!Number.isInteger(places) || Math.abs(places) > 100) throw new RangeError('roundTo: places must be an integer from -100 to 100');
+  const abs = Math.abs(x);
+  if (!Number.isFinite(x) || (places >= 0 && abs >= 2 ** 53)) return x; // already a whole number
+  const rounded = shift(Math.round(shift(abs, places)), -places);
+  return rounded === 0 ? 0 : Math.sign(x) * rounded;
+};
+
+// Sum with Neumaier's compensation, so rounding errors do not pile up (0.1 + 0.2 + 0.3 is exactly 0.6 here).
+const compensatedSum = (values) => {
+  let sum = 0;
+  let correction = 0;
+  for (const x of values) {
+    const t = sum + x;
+    correction += Math.abs(sum) >= Math.abs(x) ? (sum - t) + x : (x - t) + sum;
+    sum = t;
+  }
+  return sum + correction;
+};
+
+/**
+ * The arithmetic mean of an array of numbers. The sum is compensated against rounding error, and does not
+ * overflow when the mean itself is representable: mean([MAX_VALUE, MAX_VALUE]) is MAX_VALUE, not Infinity.
+ * An empty array has no mean, so the result is NaN. A NaN item makes the result NaN, and infinities follow
+ * ordinary arithmetic (mean([Infinity, 1]) is Infinity, mean([Infinity, -Infinity]) is NaN).
+ * @param {number[]} xs
+ * @returns {number} NaN for an empty array
+ * @throws {TypeError} if xs is not an array, or any item (including a hole in a sparse array) is not a number
+ */
+exports.mean = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('mean: expected an array');
+  for (let i = 0; i < xs.length; i++) {
+    if (typeof xs[i] !== 'number') throw new TypeError(`mean: item ${i} is not a number`);
+  }
+  const n = xs.length;
+  if (n === 0) return NaN;
+  if (xs.some((x) => !Number.isFinite(x))) return xs.reduce((a, b) => a + b, 0) / n;
+  const total = compensatedSum(xs);
+  if (Number.isFinite(total)) return total / n;
+  // The sum overflowed although every item is finite: average the scaled items instead (halved again so the
+  // partial sums stay in range), then keep the result between the smallest and largest item, where a mean must be.
+  const scaled = compensatedSum(xs.map((x) => x / n / 2)) * 2;
+  const lo = xs.reduce((a, b) => Math.min(a, b));
+  const hi = xs.reduce((a, b) => Math.max(a, b));
+  return Math.min(Math.max(scaled, lo), hi);
+};
+
+// Validate an array of numbers and return a sorted Float64Array copy, or null when there is nothing to
+// compute from (empty, or containing NaN, which has no place in an ordering).
+const sortedCopy = (name, xs) => {
+  if (!Array.isArray(xs)) throw new TypeError(`${name}: expected an array`);
+  for (let i = 0; i < xs.length; i++) {
+    if (typeof xs[i] !== 'number') throw new TypeError(`${name}: item ${i} is not a number`);
+  }
+  if (xs.length === 0 || xs.some(Number.isNaN)) return null;
+  return Float64Array.from(xs).sort(); // a typed array sorts numerically
+};
+
+// The point num / den of the way from a to b, exact at the ends and without overflowing. Multiplying before
+// dividing keeps results like 10 * 33 / 100 = 3.3 correctly rounded (10 * 0.33 gives 3.3000000000000003).
+const lerp = (a, b, num, den) => {
+  if (num === 0 || a === b) return a;
+  const opposite = (a < 0) !== (b < 0);
+  // Opposite signs: a weighted sum cannot overflow. Same sign: the difference cannot.
+  const scaled = opposite ? a * (den - num) + b * num : (b - a) * num;
+  if (Number.isFinite(scaled)) return opposite ? scaled / den : a + scaled / den;
+  const frac = num / den; // the products overflowed (items near MAX_VALUE): weight by the fraction instead
+  return opposite ? a * (1 - frac) + b * frac : a + (b - a) * frac;
+};
+
+/**
+ * The median of an array of numbers: the middle item once sorted, or for an even count the mean of the two
+ * middle items. The array is not modified (a sorted copy is used). An empty array has no median, so the result
+ * is NaN, and so is any array containing NaN. The mean of the middle pair cannot overflow:
+ * median([MAX_VALUE, MAX_VALUE]) is MAX_VALUE. Infinities sort as expected (median([1, 2, Infinity]) is 2).
+ * @param {number[]} xs
+ * @returns {number} NaN for an empty array or one containing NaN
+ * @throws {TypeError} if xs is not an array, or any item (including a hole in a sparse array) is not a number
+ */
+exports.median = (xs) => {
+  const sorted = sortedCopy('median', xs);
+  if (sorted === null) return NaN;
+  const mid = sorted.length >> 1;
+  if (sorted.length % 2 === 1) return sorted[mid];
+  return lerp(sorted[mid - 1], sorted[mid], 50, 100); // the same arithmetic as percentile(xs, 50), so they agree exactly
+};
+
+/**
+ * The p-th percentile of an array of numbers by linear interpolation between the closest ranks (the method
+ * of NumPy's default and Excel's PERCENTILE.INC): the sorted items sit at percentiles 0, 100 / (n - 1), ...,
+ * 100, and values in between are interpolated. So percentile(xs, 0) is the minimum, percentile(xs, 100) the
+ * maximum, and percentile(xs, 50) the median. For [1, 2, 3, 4], the 25th percentile is 1.75.
+ * The array is not modified. An empty array, or one containing NaN, gives NaN. Interpolation cannot overflow.
+ * @param {number[]} xs
+ * @param {number} p a percentage from 0 to 100 inclusive
+ * @returns {number} NaN for an empty array or one containing NaN
+ * @throws {TypeError} if xs is not an array, any item (including a hole) is not a number, or p is not a number
+ * @throws {RangeError} if p is NaN or outside 0..100
+ */
