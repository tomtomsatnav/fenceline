+  return start;
+};
+
+/**
+ * Format a Date as YYYY-MM-DD in UTC: new Date(Date.UTC(2024, 0, 5, 23, 59)) is "2024-01-05", wherever the code
+ * runs and whatever the local time zone. Month and day are zero-padded, and so is the year, to four digits
+ * (year 5 is "0005"). Years outside 0000-9999 use the expanded ISO 8601 form with a sign and six digits, the
+ * same as Date.prototype.toISOString: "+275760-09-13" and "-000001-12-31". Every result is read back correctly by
+ * new Date(...), which treats a date-only ISO string as midnight UTC, and results within 0000-9999 sort
+ * alphabetically in date order. The date is not modified.
+ * @param {Date} date a valid Date
+ * @returns {string}
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is an invalid Date
+ */
+exports.formatIsoDate = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('formatIsoDate: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('formatIsoDate: date is an invalid Date');
+  return date.toISOString().split('T')[0];
+};
+
+const ISO_DATE_PATTERN = /^(?:(\d{4})|([+-]\d{6}))-(\d{2})-(\d{2})$/;
+
+/**
+ * Parse a YYYY-MM-DD string into a Date at midnight UTC, the inverse of formatIsoDate: parseIsoDate("2024-01-05")
+ * is 2024-01-05T00:00:00.000Z, whatever the local time zone. The date must exist in the (proleptic Gregorian)
+ * calendar: "2026-02-30", "2023-02-29" and "2024-04-31" are rejected rather than rolled over into the next month,
+ * while "2024-02-29" and "2000-02-29" are fine. The format is strict: exactly four digit year, two digit month and
+ * two digit day separated by hyphens, with no spaces, time part or other layouts. Years outside 0000-9999 use the
+ * expanded form with a sign and six digits that formatIsoDate writes ("+010000-01-01", "-000001-12-31"; "-000000"
+ * is not allowed). Years 0000-0099 mean those years, not 1900-1999.
+ * @param {string} text
+ * @returns {Date} a new Date at 00:00:00.000 UTC
+ * @throws {TypeError} if text is not a string
+ * @throws {SyntaxError} if text is not in YYYY-MM-DD form
+ * @throws {RangeError} if text is well formed but not a real date (month 13, February 30, ...) or lies outside the
+ *   range of dates JavaScript can represent
+ */
+exports.parseIsoDate = (text) => {
+  if (typeof text !== 'string') throw new TypeError('parseIsoDate: text must be a string');
+  const match = ISO_DATE_PATTERN.exec(text);
+  if (match === null || match[2] === '-000000') throw new SyntaxError(`parseIsoDate: expected YYYY-MM-DD, got ${JSON.stringify(text)}`);
+  const year = Number(match[1] ?? match[2]);
+  const month = Number(match[3]);
+  const day = Number(match[4]);
+  const date = new Date(0);
+  date.setUTCFullYear(year, month - 1, day); // unlike Date.UTC, this keeps years 0-99 as they are
