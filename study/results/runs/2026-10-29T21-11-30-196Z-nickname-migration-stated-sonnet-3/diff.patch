+/**
+ * A new Date n calendar days after date (before it, if n is negative), in the local time zone. The time of day
+ * is kept, so across a daylight-saving change the elapsed time is 23 or 25 hours rather than 24: noon on March 9
+ * plus one day is noon on March 10 wherever the clocks changed in between. Month and year ends roll over
+ * (January 31 + 1 is February 1), and leap days are counted. If the local time does not exist on the result
+ * day (it falls in a spring-forward gap), the result is the same moment as the clock jumps forward.
+ * The date passed in is not modified.
+ * @param {Date} date a valid Date
+ * @param {number} n a whole number of days; 0 returns a copy
+ * @returns {Date}
+ * @throws {TypeError} if date is not a Date, or n is not a number
+ * @throws {RangeError} if date is an invalid Date, n is not an integer, or the result is outside the range of dates
+ *   JavaScript can represent (about 273,000 years either side of 1970)
+ */
+exports.addDays = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError('addDays: date must be a Date');
+  if (typeof n !== 'number') throw new TypeError('addDays: n must be a number');
+  if (Number.isNaN(date.getTime())) throw new RangeError('addDays: date is an invalid Date');
+  if (!Number.isInteger(n)) throw new RangeError('addDays: n must be an integer');
+  const result = new Date(date.getTime());
+  result.setDate(result.getDate() + n);
+  if (Number.isNaN(result.getTime())) throw new RangeError('addDays: result is outside the range of valid dates');
+  return result;
+};
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+/**
+ * The number of whole calendar days from a to b, counted in UTC and ignoring the time of day: each date is
+ * reduced to its UTC day, so 23:59 on the 1st to 00:01 on the 2nd is 1 day, while 00:00 to 23:59 on the same
+ * day is 0. The result is signed: positive when b is later than a, negative when it is earlier, so
+ * daysBetween(a, b) is -daysBetween(b, a). Because UTC has no daylight-saving changes, every day is exactly
+ * 24 hours and the answer is the same in every time zone. Neither date is modified.
+ * @param {Date} a the start, a valid Date
+ * @param {Date} b the end, a valid Date
+ * @returns {number} an integer (never -0)
+ * @throws {TypeError} if a or b is not a Date
+ * @throws {RangeError} if a or b is an invalid Date
+ */
+exports.daysBetween = (a, b) => {
+  for (const [name, value] of [['a', a], ['b', b]]) {
+    if (!(value instanceof Date)) throw new TypeError(`daysBetween: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`daysBetween: ${name} is an invalid Date`);
+  }
+  // Math.floor puts times before 1970 (negative timestamps) on the right day too.
+  return Math.floor(b.getTime() / MS_PER_DAY) - Math.floor(a.getTime() / MS_PER_DAY);
+};
+
+/**
+ * Whether date falls on a Saturday or Sunday, judged in UTC: the instant 2024-06-07T23:59:59.999Z (a Friday in
+ * UTC) is not a weekend even where it is already Saturday locally, and 2024-06-08T00:00:00.000Z (Saturday) is
+ * one even where it is still Friday locally. The answer is the same in every time zone. This is only the
+ * Saturday/Sunday test: it knows nothing about public holidays or about cultures whose weekend is on other
+ * days. The date is not modified.
+ * @param {Date} date a valid Date
+ * @returns {boolean}
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is an invalid Date
+ */
+exports.isWeekend = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('isWeekend: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('isWeekend: date is an invalid Date');
+  const day = date.getUTCDay(); // 0 is Sunday, 6 is Saturday
+  return day === 0 || day === 6;
