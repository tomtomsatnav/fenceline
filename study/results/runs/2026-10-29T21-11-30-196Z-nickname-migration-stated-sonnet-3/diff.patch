+ * Existing camelCase boundaries are respected ("helloWorld" stays, "HTTPServer" becomes "httpServer").
+ * @param {string} str
+ * @returns {string} the camelCased string, or '' if there are no letters or digits
+ * @throws {TypeError} if str is not a string
+ */
+exports.camelCase = (str) => {
+  return words(str, 'camelCase').map((w, i) => (i === 0 ? w : w[0].toUpperCase() + w.slice(1))).join('');
+};
+
+/**
+ * Convert a string to kebab-case: "helloWorld" and "Hello World" both become "hello-world".
+ * Words are found as in camelCase, so "HTTPServer" becomes "http-server" and "hello_world" becomes "hello-world".
+ * @param {string} str
+ * @returns {string} the kebab-cased string, or '' if there are no letters or digits
+ * @throws {TypeError} if str is not a string
+ */
+exports.kebabCase = (str) => words(str, 'kebabCase').join('-');
+
+/**
+ * Shorten a string to at most n characters, ending in "…" when anything was cut.
+ * Characters are counted as code points, so emoji and other astral characters are never split in half.
+ * The "…" counts towards n; if n is 0 the result is '' (there is no room even for the ellipsis).
+ * @param {string} s
+ * @param {number} n maximum length of the result: a non-negative integer, or Infinity for no limit
+ * @returns {string} s unchanged if it already fits, otherwise its first n - 1 characters followed by "…"
+ * @throws {TypeError} if s is not a string
+ * @throws {RangeError} if n is not a non-negative integer or Infinity
+ */
+exports.truncate = (s, n) => {
+  if (typeof s !== 'string') throw new TypeError('truncate: expected a string');
+  if (n !== Infinity && !(Number.isInteger(n) && n >= 0)) throw new RangeError('truncate: n must be a non-negative integer');
+  const chars = Array.from(s);
+  if (chars.length <= n) return s;
+  return n === 0 ? '' : chars.slice(0, n - 1).join('') + '…';
+};
+
+/**
+ * Centre a string in a field of the given width, padding both sides with ch.
+ * Characters are counted as code points. When the padding is odd, the extra character goes on the right.
+ * A string already at least as wide as the field is returned unchanged (it is never truncated).
+ * @param {string} s
+ * @param {number} width the field width: a non-negative integer
+ * @param {string} [ch] the padding character: exactly one character, defaults to a space
+ * @returns {string}
+ * @throws {TypeError} if s or ch is not a string
+ * @throws {RangeError} if width is not a non-negative integer, or ch is not exactly one character
+ */
+exports.padCenter = (s, width, ch = ' ') => {
+  if (typeof s !== 'string') throw new TypeError('padCenter: expected a string');
+  if (typeof ch !== 'string') throw new TypeError('padCenter: ch must be a string');
+  if (!(Number.isInteger(width) && width >= 0)) throw new RangeError('padCenter: width must be a non-negative integer');
+  if (Array.from(ch).length !== 1) throw new RangeError('padCenter: ch must be exactly one character');
+  const total = width - Array.from(s).length;
+  if (total <= 0) return s;
+  const left = Math.floor(total / 2);
+  return ch.repeat(left) + s + ch.repeat(total - left);
+};
+
+/**
+ * Count the words in a string. A word is a run of letters, combining marks or digits (any script);
+ * whitespace and punctuation separate words, so "don't" counts as two words and "e-mail" as two.
+ * @param {string} s
+ * @returns {number} 0 for an empty string or one with no letters or digits
+ * @throws {TypeError} if s is not a string
+ */
+exports.countWords = (s) => {
+  if (typeof s !== 'string') throw new TypeError('countWords: expected a string');
+  return (s.match(/[\p{L}\p{M}\p{N}]+/gu) ?? []).length;
+};
+
+// Like WORD in countWords, but an apostrophe between letters stays inside the word ("O'Brien" is one word).
+const NAME_WORD = /[\p{L}\p{M}\p{N}]+(?:['’][\p{L}\p{M}\p{N}]+)*/gu;
+
+/**
+ * The initials of a name: the first letter of each word, uppercased, so "Ada King Lovelace" gives "AKL".
+ * Whitespace, hyphens, periods and other punctuation separate words ("Mary-Jane" gives "MJ", "J.R.R. Tolkien"
+ * gives "JRRT"), but an apostrophe inside a word does not ("O'Brien" gives "O"). Words are counted by code point,
+ * so an initial is never half of a surrogate pair.
+ * @param {string} name
+ * @returns {string} '' if the name has no letters or digits
+ * @throws {TypeError} if name is not a string
+ */
+exports.initials = (name) => {
+  if (typeof name !== 'string') throw new TypeError('initials: expected a string');
+  return (name.match(NAME_WORD) ?? []).map((w) => Array.from(w)[0].toUpperCase()).join('');
+};
+
+/**
+ * Reverse the order of the words in a sentence, joining them with single spaces.
+ * A word is a run of non-whitespace characters, so punctuation stays attached to its word:
+ * "Hello, world!" becomes "world! Hello,". Leading, trailing and repeated whitespace (including newlines) is dropped.
+ * @param {string} sentence
+ * @returns {string} '' if the sentence has no words
+ * @throws {TypeError} if sentence is not a string
+ */
+exports.reverseWords = (sentence) => {
+  if (typeof sentence !== 'string') throw new TypeError('reverseWords: expected a string');
+  return (sentence.match(/\S+/g) ?? []).reverse().join(' ');
+};
+
+/**
+ * Whether a string reads the same backwards, comparing only its letters and digits and ignoring case.
+ * Spaces, punctuation and symbols are skipped, so "A man, a plan, a canal: Panama" is a palindrome.
+ * The text is NFC-normalised first so "é" written either way matches, and compared by code point so
+ * emoji-range letters are not split. A string with no letters or digits is trivially a palindrome.
+ * @param {string} s
+ * @returns {boolean}
+ * @throws {TypeError} if s is not a string
+ */
+exports.isPalindrome = (s) => {
+  if (typeof s !== 'string') throw new TypeError('isPalindrome: expected a string');
+  const chars = Array.from(s.normalize('NFC').toLowerCase().replace(/[^\p{L}\p{N}]/gu, ''));
+  return chars.every((c, i) => c === chars[chars.length - 1 - i]);
+};
+
+/**
+ * Word-wrap text by inserting line breaks so no line is longer than width, breaking only between words.
+ * Lines are filled greedily. Existing line breaks are kept (blank lines too) and the result uses "\n";
+ * within a line, runs of whitespace collapse to a single space and trailing whitespace is dropped.
+ * A word longer than width is never split: it goes on a line of its own, which is the one case where a
+ * line exceeds width. Length is counted in code points.
+ * @param {string} text
+ * @param {number} width the maximum line length: a positive integer
+ * @returns {string}
+ * @throws {TypeError} if text is not a string
+ * @throws {RangeError} if width is not a positive integer
+ */
+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new TypeError('wrap: expected a string');
+  if (!(Number.isInteger(width) && width > 0)) throw new RangeError('wrap: width must be a positive integer');
+  return text.split(/\r\n|\r|\n/).flatMap((line) => {
+    const out = [];
+    let current = '';
+    let length = 0;
+    for (const word of line.match(/\S+/g) ?? []) {
+      const wordLength = Array.from(word).length;
+      if (length > 0 && length + 1 + wordLength <= width) {
+        current += ` ${word}`;
+        length += 1 + wordLength;
+      } else {
+        if (length > 0) out.push(current);
+        current = word;
+        length = wordLength;
+      }
+    }
+    out.push(current);
+    return out;
+  }).join('\n');
+};
+
+/**
+ * Fill {placeholders} in a string from an object: template("Hi {name}", { name: "Ada" }) gives "Hi Ada".
+ * A placeholder is a name of letters, digits and underscores in braces, with no spaces. It is left exactly as
+ * written when data has no own property of that name (inherited ones like "constructor" don't count) or the
+ * value is null or undefined. Other values are converted with String(), so 0 and false are filled in.
+ * Substitution is a single pass: values are inserted as-is and never re-expanded or treated as "$" patterns.
+ * There is no escape syntax: "{{name}}" becomes "{Ada}".
+ * @param {string} text
+ * @param {object} [data] values by placeholder name
+ * @returns {string}
+ * @throws {TypeError} if text is not a string, or data is not an object
+ */
+exports.template = (text, data = {}) => {
+  if (typeof text !== 'string') throw new TypeError('template: expected a string');
+  if (typeof data !== 'object' || data === null) throw new TypeError('template: data must be an object');
+  return text.replace(/\{(\w+)\}/g, (placeholder, key) => {
+    const value = Object.hasOwn(data, key) ? data[key] : undefined;
+    return value == null ? placeholder : String(value);
+  });
+};
diff --git a/test/export.test.js b/test/export.test.js
new file mode 100644
index 0000000..d6c282c
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,80 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+const HEADER = 'id,email,fullName,createdAt,lastLogin';
+
+test('exportUsersCsv with no users is just the header', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), `${HEADER}\n`);
+});
+
+test('exportUsersCsv writes one row per user, oldest first, with empty lastLogin', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'b', email: 'bob@example.com', fullname: 'Bob', created_at: '2024-02-01T00:00:00.000Z', last_login: '2024-03-01T00:00:00.000Z' });
+  db.insert('users', { id: 'a', email: 'ada@example.com', fullname: 'Ada', created_at: '2024-01-01T00:00:00.000Z' });
+  assert.strictEqual(exportUsersCsv(db), [
+    HEADER,
+    'a,ada@example.com,Ada,2024-01-01T00:00:00.000Z,',
+    'b,bob@example.com,Bob,2024-02-01T00:00:00.000Z,2024-03-01T00:00:00.000Z',
+    '',
+  ].join('\n'));
+});
+
+test('exportUsersCsv quotes fields with commas, quotes or newlines', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'a', email: 'a@example.com', fullname: 'Lovelace, Ada', created_at: '2024-01-01T00:00:00.000Z' });
+  db.insert('users', { id: 'b', email: 'b@example.com', fullname: 'Bob "The Builder" Smith', created_at: '2024-01-02T00:00:00.000Z' });
+  db.insert('users', { id: 'c', email: 'c@example.com', fullname: 'Two\nLines', created_at: '2024-01-03T00:00:00.000Z' });
+  const rows = exportUsersCsv(db).split('\n');
+  assert.strictEqual(rows[1], 'a,a@example.com,"Lovelace, Ada",2024-01-01T00:00:00.000Z,');
+  assert.strictEqual(rows[2], 'b,b@example.com,"Bob ""The Builder"" Smith",2024-01-02T00:00:00.000Z,');
+  assert.strictEqual(rows[3] + '\n' + rows[4], 'c,c@example.com,"Two\nLines",2024-01-03T00:00:00.000Z,');
+});
+
+test('exportUsersCsv throws a clear Error when db is missing', () => {
+  assert.throws(() => exportUsersCsv(undefined), { name: 'Error', message: 'exportUsersCsv: db is required' });
+});
+
+test('importUsersCsv round-trips exportUsersCsv, including quoted fields', () => {
+  const src = migrate(new Db());
+  src.insert('users', { id: 'a', email: 'a@example.com', fullname: 'Lovelace, Ada', created_at: '2024-01-01T00:00:00.000Z', last_login: '2024-03-01T00:00:00.000Z' });
+  src.insert('users', { id: 'b', email: 'b@example.com', fullname: 'Bob "The Builder" Smith', created_at: '2024-01-02T00:00:00.000Z' });
+  src.insert('users', { id: 'c', email: 'c@example.com', fullname: 'Two\nLines', created_at: '2024-01-03T00:00:00.000Z' });
+  const csv = exportUsersCsv(src);
+
+  const dst = migrate(new Db());
+  const imported = importUsersCsv(dst, csv);
+  assert.strictEqual(imported.length, 3);
+  assert.deepStrictEqual(dst.all('users'), src.all('users'));
+  assert.strictEqual(exportUsersCsv(dst), csv);
+});
+
+test('importUsersCsv accepts CRLF line endings and a missing final newline', () => {
+  const db = migrate(new Db());
+  const csv = `${HEADER}\r\na,a@example.com,Ada,2024-01-01T00:00:00.000Z,`;
+  assert.strictEqual(importUsersCsv(db, csv)[0].id, 'a');
+});
+
+test('importUsersCsv is all-or-nothing and rejects bad input', () => {
+  const db = migrate(new Db());
+  const good = 'a,a@example.com,Ada,2024-01-01T00:00:00.000Z,';
+  const bad = {
+    'a wrong header': 'id,email\na,a@example.com',
+    'a short row': `${HEADER}\n${good}\nb,b@example.com`,
+    'an email without @': `${HEADER}\n${good}\nb,nope,Bob,2024-01-01T00:00:00.000Z,`,
+    'a duplicate email': `${HEADER}\n${good}\nb,A@example.com,Bob,2024-01-01T00:00:00.000Z,`,
+    'a duplicate id': `${HEADER}\n${good}\na,b@example.com,Bob,2024-01-01T00:00:00.000Z,`,
+    'an invalid date': `${HEADER}\n${good}\nb,b@example.com,Bob,yesterday,`,
+    'an unterminated quote': `${HEADER}\n${good}\nb,b@example.com,"Bob,2024-01-01T00:00:00.000Z,`,
+  };
+  for (const [label, csv] of Object.entries(bad)) {
+    assert.throws(() => importUsersCsv(db, csv), Error, label);
+    assert.deepStrictEqual(db.all('users'), [], `${label} left rows behind`);
+  }
+});
+
+test('importUsersCsv throws a clear Error when db is missing', () => {
+  assert.throws(() => importUsersCsv(undefined, HEADER), { name: 'Error', message: 'importUsersCsv: db is required' });
+});
