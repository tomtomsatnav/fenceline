+
+/**
+ * The start of the week containing date, as a new Date at Monday 00:00:00.000 UTC. Weeks run Monday to
+ * Sunday (as in ISO 8601), so any time on a Sunday belongs to the week that began the Monday before, and a
+ * Monday at exactly midnight UTC is its own week start. The week is judged in UTC, so the result is the same in
+ * every time zone. The date is not modified.
+ * @param {Date} date a valid Date
+ * @returns {Date} a new Date, never later than date and less than 7 days before it
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is an invalid Date, or the week starts before the earliest date JavaScript can
+ *   represent (the first few days after -271821-04-20, which fall in a week that began before it)
+ */
+exports.startOfWeek = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('startOfWeek: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('startOfWeek: date is an invalid Date');
+  const day = Math.floor(date.getTime() / MS_PER_DAY); // whole days since 1970-01-01, a Thursday
+  const sinceMonday = (((day + 3) % 7) + 7) % 7; // 0 on Monday ... 6 on Sunday, also for days before 1970
+  const start = new Date((day - sinceMonday) * MS_PER_DAY);
