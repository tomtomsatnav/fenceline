diff --git a/README.md b/README.md
new file mode 100644
index 0000000..c59dfa2
--- /dev/null
+++ b/README.md
@@ -0,0 +1,32 @@
+## Users API
+
+Functions in `src/api/`. Every function in `users.js` and `export.js` takes `db` first and throws `Error('<name>: db is required')` if it is missing.
+
+A **user** is `{ id, email, fullName, createdAt, lastLogin, nickname }`. `createdAt` and `lastLogin` are ISO 8601 strings; `lastLogin` is `null` until a login is recorded. `nickname` is `null` unless one was set.
+
+### `src/api/users.js`
+
+| Function | Description |
+| --- | --- |
+| `createUser(db, { email, fullName, nickname })` | Creates a user and returns it; `nickname` is optional. Throws if `email` has no `@` or is already taken (case-insensitive), or if `fullName` is not a non-empty string of at most 100 characters. |
+| `getUser(db, id)` | Returns the user with that id, or `null`. |
+| `getUserByEmail(db, email)` | Returns the user with that email (case-insensitive), or `null`. |
+| `updateUser(db, id, { email, fullName })` | Changes only the fields given and returns the updated user, or `null` if there is no such user. Fields are validated like `createUser`; a user may keep their own email. On a validation error the user is left unchanged. |
+| `deleteUser(db, id)` | Removes the user. Returns `true`, or `false` if there was no such user. |
+| `recordLogin(db, id, when = new Date())` | Sets `lastLogin` (`when` may be a `Date`, timestamp or date string) and returns the updated user, or `null` if there is no such user. |
+| `listUsers(db, { limit, offset })` | Returns users oldest first by `createdAt`. `limit` defaults to no cap and `offset` to `0`. Throws if either is negative or `offset` is not an integer. |
+| `searchUsers(db, query)` | Returns users whose `fullName` or email contains `query` (case-insensitive), oldest first. An empty query matches everyone. |
+| `countUsers(db)` | Returns the number of users. |
+
+### `src/api/export.js`
+
+| Function | Description |
+| --- | --- |
+| `exportUsersCsv(db)` | Returns CSV text: the header `id,email,fullName,createdAt,lastLogin`, then one row per user, oldest first. Fields containing commas, quotes or line breaks are quoted. Lines end with `\n`. |
+| `importUsersCsv(db, csv)` | Inverse of `exportUsersCsv`. Creates the users (keeping each row's `id`, `createdAt` and `lastLogin`) and returns them. Rows are validated like `createUser`. All-or-nothing: if any row is invalid, nothing is imported and an `Error` is thrown. |
+
+### `src/api/format.js`
+
+| Function | Description |
+| --- | --- |
+| `displayName(user)` | Returns `fullName`, or the part of the email before `@` when `fullName` is empty. This function does not take `db`. |
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..e8d8cbf
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,84 @@
+const { createUser, getUser, listUsers } = require('./users.js');
+
+const FIELDS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quote fields containing commas, quotes or line breaks; double any embedded quotes.
+const csvField = (value) => {
+  const s = value == null ? '' : String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replaceAll('"', '""')}"` : s;
+};
+
+/**
+ * Export all users as CSV: a header row (id,email,fullName,createdAt,lastLogin), then one row per user, oldest first.
+ * Fields containing commas, quotes or line breaks are quoted; lastLogin is empty for users who never logged in.
+ * @param {import('../db.js').Db} db
+ * @returns {string} CSV text with "\n" line endings
+ */
+exports.exportUsersCsv = (db) => {
+  if (!db) throw new Error('exportUsersCsv: db is required');
+  const lines = [FIELDS, ...listUsers(db).map((u) => FIELDS.map((f) => u[f]))];
+  return lines.map((cols) => cols.map(csvField).join(',')).join('\n') + '\n';
+};
+
+// Inverse of csvField: parses RFC 4180-style CSV (quoted fields, doubled quotes, line breaks inside quotes).
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c !== '"') field += c;
+      else if (text[i + 1] === '"') { field += '"'; i++; }
+      else quoted = false;
+    } else if (c === '"') quoted = true;
+    else if (c === ',') { row.push(field); field = ''; }
+    else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+    } else field += c;
+  }
+  if (quoted) throw new Error('importUsersCsv: unterminated quoted field');
+  if (field !== '' || row.length) { row.push(field); rows.push(row); }
+  return rows;
+};
+
+const isDate = (s) => !Number.isNaN(Date.parse(s));
+
+/**
+ * Import users from CSV in the format written by exportUsersCsv, keeping each row's id, createdAt and lastLogin.
+ * Rows are validated like createUser. All-or-nothing: if any row is invalid, the users table is left as it was.
+ * @param {import('../db.js').Db} db
+ * @param {string} csv
+ * @returns {import('./users.js').User[]} the imported users
+ * @throws {Error} on a wrong header, malformed row, duplicate id or email, invalid date, or unterminated quote
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (!db) throw new Error('importUsersCsv: db is required');
+  const [header, ...rows] = parseCsv(String(csv));
+  if (!header || header.join(',') !== FIELDS.join(',')) throw new Error(`importUsersCsv: header must be ${FIELDS.join(',')}`);
+  const table = db.tables.users;
+  const saved = [...table.rows];
+  try {
+    return rows.map((cols, i) => {
+      const line = i + 2;
+      if (cols.length !== FIELDS.length) throw new Error(`importUsersCsv: line ${line} has ${cols.length} fields, expected ${FIELDS.length}`);
+      const [id, email, fullName, createdAt, lastLogin] = cols;
+      if (!id || getUser(db, id)) throw new Error(`importUsersCsv: line ${line} has a missing or duplicate id`);
+      if (!isDate(createdAt) || (lastLogin !== '' && !isDate(lastLogin))) throw new Error(`importUsersCsv: line ${line} has an invalid date`);
+      // createUser validates email and fullName and rejects duplicate emails; then restore the exported values.
+      const created = createUser(db, { email, fullName });
+      const changes = { id, created_at: createdAt };
+      if (lastLogin !== '') changes.last_login = lastLogin;
+      db.update('users', (u) => u.id === created.id, changes);
+      return getUser(db, id);
+    });
+  } catch (err) {
+    table.rows = saved;
+    throw err;
+  }
+};
diff --git a/src/api/format.js b/src/api/format.js
