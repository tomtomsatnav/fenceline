+  assert.strictEqual(isPalindrome('12321'), true);
+  assert.strictEqual(isPalindrome('12 3-21'), true);
+  assert.strictEqual(isPalindrome('1231'), false);
+  assert.strictEqual(isPalindrome('a1b'), false);
+});
+
+test('isPalindrome handles non-ASCII letters and normalisation', () => {
+  assert.strictEqual(isPalindrome('été'), true);
+  assert.strictEqual(isPalindrome('été'), true); // decomposed é
+  assert.strictEqual(isPalindrome('été'), isPalindrome('été'));
+  assert.strictEqual(isPalindrome('А роза упала на лапу Азора'), true);
+  assert.strictEqual(isPalindrome('𝒜b𝒜'), true);
+  assert.strictEqual(isPalindrome('𝒜b'), false);
+});
+
+test('isPalindrome throws a TypeError for non-strings', () => {
+  for (const v of [undefined, null, 42, {}, ['a']]) assert.throws(() => isPalindrome(v), TypeError);
+});
+
+test('wrap breaks lines between words so none exceeds width', () => {
+  assert.strictEqual(wrap('the quick brown fox jumps over the lazy dog', 10), 'the quick\nbrown fox\njumps over\nthe lazy\ndog');
+  const out = wrap('the quick brown fox jumps over the lazy dog', 15);
+  assert.strictEqual(out, 'the quick brown\nfox jumps over\nthe lazy dog');
+  for (const line of out.split('\n')) assert.ok(line.length <= 15);
+});
+
+test('wrap fills lines exactly up to width', () => {
+  assert.strictEqual(wrap('aa bb cc', 5), 'aa bb\ncc');
+  assert.strictEqual(wrap('aa bb cc', 8), 'aa bb cc');
+  assert.strictEqual(wrap('aa bb cc', 4), 'aa\nbb\ncc');
+});
+
+test('wrap leaves text that already fits alone', () => {
+  assert.strictEqual(wrap('hello world', 80), 'hello world');
+  assert.strictEqual(wrap('hello', 5), 'hello');
+});
+
+test('wrap never splits a word longer than width', () => {
+  assert.strictEqual(wrap('a extraordinarily b', 5), 'a\nextraordinarily\nb');
+  assert.strictEqual(wrap('supercalifragilistic', 5), 'supercalifragilistic');
+  assert.strictEqual(wrap('hello world', 1), 'hello\nworld');
+});
+
+test('wrap handles empty and whitespace-only text', () => {
+  assert.strictEqual(wrap('', 10), '');
+  assert.strictEqual(wrap('     ', 10), '');
+  assert.strictEqual(wrap('\n\n', 10), '\n\n');
+});
+
+test('wrap keeps existing line breaks and blank lines', () => {
+  assert.strictEqual(wrap('one two\nthree four', 20), 'one two\nthree four');
+  assert.strictEqual(wrap('aa bb cc\n\ndd ee ff', 5), 'aa bb\ncc\n\ndd ee\nff');
+  assert.strictEqual(wrap('aa bb\r\ncc dd\ree', 20), 'aa bb\ncc dd\nee');
+});
+
+test('wrap collapses runs of whitespace within a line and drops trailing whitespace', () => {
+  assert.strictEqual(wrap('  aa   bb \t cc  ', 20), 'aa bb cc');
+  assert.strictEqual(wrap('aa   bb   cc', 5), 'aa bb\ncc');
+});
+
+test('wrap counts code points and handles non-ASCII text', () => {
+  assert.strictEqual(wrap('😀😀 😀😀 😀', 5), '😀😀 😀😀\n😀');
+  assert.strictEqual(wrap('élan vital straße', 10), 'élan vital\nstraße');
+});
+
+test('wrap rejects invalid arguments', () => {
+  for (const v of [undefined, null, 42, ['a']]) assert.throws(() => wrap(v, 10), TypeError);
+  for (const w of [0, -1, 1.5, NaN, Infinity, '10', undefined]) assert.throws(() => wrap('hello', w), RangeError);
+});
+
+test('template fills placeholders from data', () => {
+  assert.strictEqual(template('Hi {name}', { name: 'Ada' }), 'Hi Ada');
+  assert.strictEqual(template('{a}{b}{a}', { a: 1, b: 'x' }), '1x1');
+  assert.strictEqual(template('{greeting}, {name}!', { greeting: 'Hello', name: 'Ada' }), 'Hello, Ada!');
+  assert.strictEqual(template('no placeholders', { name: 'Ada' }), 'no placeholders');
+  assert.strictEqual(template('', { name: 'Ada' }), '');
+});
+
+test('template leaves unknown placeholders as they are', () => {
+  assert.strictEqual(template('Hi {name}, you are {age}', { name: 'Ada' }), 'Hi Ada, you are {age}');
+  assert.strictEqual(template('Hi {name}'), 'Hi {name}');
+  assert.strictEqual(template('Hi {name}', {}), 'Hi {name}');
+});
+
+test('template leaves null and undefined values unfilled but fills falsy ones', () => {
+  assert.strictEqual(template('{a} {b}', { a: null, b: undefined }), '{a} {b}');
+  assert.strictEqual(template('{n}|{f}|{s}', { n: 0, f: false, s: '' }), '0|false|');
+});
+
+test('template only reads own properties', () => {
+  assert.strictEqual(template('{toString} {constructor} {__proto__}', {}), '{toString} {constructor} {__proto__}');
+  assert.strictEqual(template('{x}', Object.create({ x: 'inherited' })), '{x}');
+  assert.strictEqual(template('{x}', Object.assign(Object.create(null), { x: 'ok' })), 'ok');
+});
+
+test('template ignores things that are not placeholders', () => {
+  const data = { name: 'Ada' };
+  assert.strictEqual(template('{ name }', data), '{ name }');
+  assert.strictEqual(template('{}', data), '{}');
+  assert.strictEqual(template('{name', data), '{name');
+  assert.strictEqual(template('name}', data), 'name}');
+  assert.strictEqual(template('{na me}', data), '{na me}');
+  assert.strictEqual(template('{user.name}', { user: { name: 'x' } }), '{user.name}');
+});
+
+test('template substitutes in a single pass', () => {
+  assert.strictEqual(template('{a}', { a: '{b}', b: 'no' }), '{b}');
+  assert.strictEqual(template('{a}', { a: '$& $1 $$' }), '$& $1 $$');
+  assert.strictEqual(template('{{name}}', { name: 'Ada' }), '{Ada}');
+});
+
+test('template handles repeated placeholders, non-ASCII text and non-string values', () => {
+  assert.strictEqual(template('{x} {x}', { x: 'é' }), 'é é');
+  assert.strictEqual(template('{ünï}', { ünï: 'x' }), '{ünï}');
+  assert.strictEqual(template('{d}', { d: [1, 2] }), '1,2');
+  assert.strictEqual(template('{n}', { n: 1.5 }), '1.5');
+});
+
+test('template rejects invalid arguments', () => {
+  for (const v of [undefined, null, 42, {}, ['a']]) assert.throws(() => template(v, {}), TypeError);
+  for (const d of [null, 'str', 42, true]) assert.throws(() => template('{a}', d), TypeError);
+});
