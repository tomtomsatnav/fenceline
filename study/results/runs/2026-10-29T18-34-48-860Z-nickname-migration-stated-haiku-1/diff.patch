+/**
+ * Validates and stores a user with the given id and timestamps. `createUser` generates these;
+ * `importUsersCsv` keeps the ones from the file.
+ * @param {Db} db
+ * @param {{ id: string, email: string, fullName: string, createdAt: string, lastLogin?: string }} user
+ * @returns {{ id: string, email: string, fullName: string, createdAt: string, lastLogin: string | null }} The stored user.
