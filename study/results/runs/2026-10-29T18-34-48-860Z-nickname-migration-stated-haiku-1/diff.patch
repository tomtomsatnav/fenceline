+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { createUser, updateUser, recordLogin, listUsers } = require('../src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+test('exports only the header when there are no users', () => {
+  const db = migrate(new Db());
+  assert.strictEqual(exportUsersCsv(db), 'id,email,fullName,createdAt,lastLogin\n');
+});
+
+test('exports one row per user under the header', () => {
+  const db = migrate(new Db());
+  const ada = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  db.tables.users.rows[0].created_at = '2024-01-01T00:00:00.000Z';
+  const lines = exportUsersCsv(db).split('\n');
+  assert.strictEqual(lines[0], 'id,email,fullName,createdAt,lastLogin');
+  assert.strictEqual(lines[1], `${ada.id},ada@example.com,Ada Lovelace,2024-01-01T00:00:00.000Z,`);
+  assert.strictEqual(lines[2], '');
+});
+
+test('quotes fields containing commas, quotes or line breaks', () => {
+  const db = migrate(new Db());
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada' });
+  updateUser(db, u.id, { fullName: 'Lovelace, "Ada"' });
+  const row = exportUsersCsv(db).split('\n')[1];
+  assert.ok(row.includes(',"Lovelace, ""Ada""",'));
+});
+
+test('exportUsersCsv requires a db', () => {
+  assert.throws(() => exportUsersCsv(undefined), { message: 'db is required' });
+});
+
+test('importUsersCsv round-trips an export, keeping ids, timestamps and logins', () => {
+  const db = migrate(new Db());
+  const ada = createUser(db, { email: 'ada@example.com', fullName: 'Lovelace, "Ada"' });
+  const alan = createUser(db, { email: 'alan@example.com', fullName: 'Alan\nTuring' });
+  recordLogin(db, ada.id, new Date('2024-05-01T12:00:00.000Z'));
+  const csv = exportUsersCsv(db);
+
+  const copy = migrate(new Db());
+  assert.strictEqual(importUsersCsv(copy, csv), 2);
+  assert.deepStrictEqual(listUsers(copy), listUsers(db));
+  assert.strictEqual(exportUsersCsv(copy), csv);
+  assert.strictEqual(listUsers(copy).find((u) => u.id === alan.id).lastLogin, null);
+});
+
+test('importUsersCsv rejects a file with the wrong header', () => {
+  const db = migrate(new Db());
+  assert.throws(() => importUsersCsv(db, 'name,email\nAda,ada@example.com\n'), /Unexpected CSV header/);
+});
+
+test('importUsersCsv applies the same rules as createUser', () => {
+  const db = migrate(new Db());
+  const header = 'id,email,fullName,createdAt,lastLogin\n';
+  assert.throws(() => importUsersCsv(db, `${header}1,no-at-sign,Ada,2024-01-01T00:00:00.000Z,\n`), /Invalid email/);
+  assert.throws(() => importUsersCsv(db, `${header}1,ada@example.com,,2024-01-01T00:00:00.000Z,\n`), /Invalid full name/);
+});
+
+test('importUsersCsv requires a db', () => {
+  assert.throws(() => importUsersCsv(undefined, 'id,email,fullName,createdAt,lastLogin\n'), { message: 'db is required' });
+});
