+const test = require('node:test');
+const assert = require('node:assert');
+const { pick, omit, deepEqual, deepClone, getPath, setPath, mergeDeep, invert } = require('../src/lib/objects.js');
+
+test('pick keeps only the listed keys', () => {
+  assert.deepStrictEqual(pick({ a: 1, b: 2, c: 3 }, ['a', 'c']), { a: 1, c: 3 });
+});
+
+test('pick leaves out keys the object does not have, instead of setting them to undefined', () => {
+  const out = pick({ a: 1 }, ['a', 'missing']);
+  assert.deepStrictEqual(out, { a: 1 });
+  assert.strictEqual(Object.prototype.hasOwnProperty.call(out, 'missing'), false);
+});
+
+test('pick keeps a key whose own value is undefined or null', () => {
+  const out = pick({ a: undefined, b: null }, ['a', 'b']);
+  assert.strictEqual(Object.prototype.hasOwnProperty.call(out, 'a'), true);
+  assert.strictEqual(out.b, null);
+});
+
+test('pick copies only own properties, not inherited ones', () => {
+  const proto = { inherited: 1 };
+  const obj = Object.create(proto);
+  obj.own = 2;
+  assert.deepStrictEqual(pick(obj, ['inherited', 'own']), { own: 2 });
+});
+
+test('pick returns the keys in the order they were listed', () => {
+  const out = pick({ a: 1, b: 2, c: 3 }, ['c', 'a']);
+  assert.deepStrictEqual(Object.keys(out), ['c', 'a']);
+});
+
+test('pick returns an empty object for an empty key list or no matches', () => {
+  assert.deepStrictEqual(pick({ a: 1 }, []), {});
+  assert.deepStrictEqual(pick({ a: 1 }, ['x']), {});
+});
+
+test('pick copies values by reference and returns a new object', () => {
+  const inner = { deep: true };
+  const obj = { inner, other: 1 };
+  const out = pick(obj, ['inner']);
+  assert.strictEqual(out.inner, inner);
+  assert.notStrictEqual(out, obj);
+});
+
+test('pick does not modify the input', () => {
+  const obj = { a: 1, b: 2 };
+  pick(obj, ['a']);
+  assert.deepStrictEqual(obj, { a: 1, b: 2 });
+});
+
