+});
+
+test('clamp raises x to lo when it is below the range', () => {
+  assert.strictEqual(clamp(-3, 0, 10), 0);
+});
+
+test('clamp lowers x to hi when it is above the range', () => {
+  assert.strictEqual(clamp(42, 0, 10), 10);
+});
+
+test('clamp returns the bounds themselves unchanged', () => {
+  assert.strictEqual(clamp(0, 0, 10), 0);
+  assert.strictEqual(clamp(10, 0, 10), 10);
+});
+
+test('clamp with lo equal to hi always returns that value', () => {
+  assert.strictEqual(clamp(-1, 3, 3), 3);
+  assert.strictEqual(clamp(3, 3, 3), 3);
+  assert.strictEqual(clamp(9, 3, 3), 3);
+});
+
+test('clamp accepts infinite bounds and values', () => {
+  assert.strictEqual(clamp(-Infinity, 0, 10), 0);
+  assert.strictEqual(clamp(Infinity, 0, 10), 10);
+  assert.strictEqual(clamp(5, -Infinity, Infinity), 5);
+  assert.strictEqual(clamp(5, 0, Infinity), 5);
+});
+
