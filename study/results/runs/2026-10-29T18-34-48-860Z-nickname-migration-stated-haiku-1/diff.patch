+ * Counts the whole days from `from` to `to` on the UTC calendar, ignoring the time of day. Two instants two minutes
+ * apart that straddle UTC midnight count as 1 day apart.
+ * @param {Date} from A valid Date.
+ * @param {Date} to A valid Date.
+ * @returns {number} An integer: positive when `to` is later, negative when earlier, 0 on the same UTC day.
+ * @throws {Error} If either argument is not a valid Date.
+ */
+exports.daysBetween = (from, to) => {
+  assertValidDate(from);
+  assertValidDate(to);
+  return (utcDayStart(to) - utcDayStart(from)) / MS_PER_DAY;
+};
+
+/**
+ * Tells whether `date` falls on a Saturday or Sunday in UTC. The time of day is ignored, and the local time zone
+ * of the machine makes no difference.
