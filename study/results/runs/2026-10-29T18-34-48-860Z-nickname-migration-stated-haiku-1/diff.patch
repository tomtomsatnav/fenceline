+ * count is even. The input is not modified.
+ * @param {number[]} xs
+ * @returns {number} The median, or `NaN` for an empty array or one containing a `NaN`.
+ * @throws {Error} If `xs` is not an array, or an item is not a number.
+ */
+exports.median = (xs) => {
+  if (!Array.isArray(xs)) throw new Error(`Expected an array: ${xs}`);
+  for (const x of xs) {
+    if (typeof x !== 'number') throw new Error(`Expected a number item: ${x}`);
+  }
+  if (xs.length === 0 || xs.some(Number.isNaN)) return NaN;
