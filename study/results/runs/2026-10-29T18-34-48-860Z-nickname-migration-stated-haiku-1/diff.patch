diff --git a/README.md b/README.md
new file mode 100644
index 0000000..f37d8b2
--- /dev/null
+++ b/README.md
@@ -0,0 +1,89 @@
+# app
+
+## Users API
+
+The user functions live in `src/api/users.js`, CSV import and export in `src/api/export.js`, and display helpers in `src/api/format.js`. Every function that takes `db` throws `Error('db is required')` when it is missing.
+
+A user object has this shape:
+
+```js
+{ id: string, email: string, fullName: string, createdAt: string, lastLogin: string | null }
+```
+
+`createdAt` and `lastLogin` are ISO 8601 timestamps.
+
+### `createUser(db, { email, fullName })`
+
+Creates a user with a new random id, timestamped now.
+
+- Returns the new user.
+- Throws if the email has no "@" or is already in use (compared case-insensitively), or if `fullName` is blank or longer than 100 characters.
+
+### `insertUser(db, { id, email, fullName, createdAt, lastLogin })`
+
+Stores a user with the given id and timestamps, applying the same validation as `createUser`. `createUser` and `importUsersCsv` use it.
+
+- Returns the stored user.
+
+### `getUser(db, id)`
+
+Looks up a user by id.
+
+- Returns the user, or `null` if none has that id.
+
+### `getUserByEmail(db, email)`
+
+Looks up a user by email, ignoring case.
+
+- Returns the user, or `null` if none has that email.
+
+### `listUsers(db, { limit, offset })`
+
+Lists users, oldest first, one page at a time. `limit` defaults to 50 and `offset` to 0.
+
+- Returns an array of users.
+
+### `countUsers(db)`
+
+- Returns the number of users.
+
+### `searchUsers(db, query)`
+
+Finds users whose full name or email contains `query`, ignoring case.
+
+- Returns matching users in storage order.
+
+### `updateUser(db, id, { email, fullName })`
+
+Changes the given fields. Fields left out or `undefined` are unchanged.
+
+- Returns the updated user.
+- Throws if the user does not exist, or if a new email or full name is invalid or already taken.
+
+### `deleteUser(db, id)`
+
+- Returns `true` if a user was removed, `false` if none had that id.
+
+### `recordLogin(db, id, when)`
+
+Sets the user's last login time. `when` is a `Date` and defaults to now.
+
+- Returns the updated user.
+- Throws if the user does not exist.
+
+### `exportUsersCsv(db)`
+
+Exports every user as CSV, with the header `id,email,fullName,createdAt,lastLogin`. Fields containing commas, quotes or line breaks are quoted.
+
+- Returns the CSV text, ending in a newline.
+
+### `importUsersCsv(db, csv)`
+
+Adds users from CSV in the format `exportUsersCsv` writes, keeping their ids and timestamps. Each row goes through the same validation as `insertUser`.
+
+- Returns the number of users added.
+- Throws if the header is not the export header, or a row fails validation. Rows are inserted one at a time, so rows before the failing one stay in place.
+
+### `displayName(user)`
+
+- Returns `user.fullName` when it is non-blank, otherwise the part of the email before "@".
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..bcf6f4c
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,74 @@
+const { listUsers, insertUser } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quote a CSV field when it contains a comma, a quote or a line break; double any quotes inside it.
+const csvField = (value) => {
+  if (value == null) return '';
+  const s = String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * Exports every user as CSV, with a header row and columns `id,email,fullName,createdAt,lastLogin`.
+ * @param {Db} db
+ * @returns {string} CSV text ending in a newline.
+ * @throws {Error} If `db` is missing.
+ */
+exports.exportUsersCsv = (db) => {
+  const rows = listUsers(db, { limit: Infinity }).map((u) => COLUMNS.map((c) => csvField(u[c])).join(','));
+  return [COLUMNS.join(','), ...rows].join('\n') + '\n';
+};
+
+// Splits CSV text into rows of fields, honouring quoted fields with commas, quotes and line breaks.
+const parseCsv = (text) => {
+  const records = [];
+  let record = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c !== '"') field += c;
+      else if (text[i + 1] === '"') { field += '"'; i++; }
+      else quoted = false;
+    } else if (c === '"') {
+      quoted = true;
+    } else if (c === ',') {
+      record.push(field);
+      field = '';
+    } else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      record.push(field);
+      records.push(record);
+      record = [];
+      field = '';
+    } else {
+      field += c;
+    }
+  }
+  if (field !== '' || record.length > 0) {
+    record.push(field);
+    records.push(record);
+  }
+  return records;
+};
+
+/**
+ * Adds users from CSV in the format `exportUsersCsv` writes, keeping their ids and timestamps.
+ * Rows are inserted one at a time, so a failing row leaves the rows before it in place.
+ * @param {Db} db
+ * @param {string} csv
+ * @returns {number} The number of users added.
+ * @throws {Error} If `db` is missing, the header is not the export header, or a row fails validation.
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (db == null) throw new Error('db is required');
+  const [header, ...records] = parseCsv(csv);
+  if (header.join(',') !== COLUMNS.join(',')) throw new Error(`Unexpected CSV header: ${header.join(',')}`);
+  for (const record of records) {
+    const [id, email, fullName, createdAt, lastLogin] = record;
+    insertUser(db, { id, email, fullName, createdAt, lastLogin: lastLogin === '' ? undefined : lastLogin });
+  }
+  return records.length;
+};
diff --git a/src/api/format.js b/src/api/format.js
new file mode 100644
