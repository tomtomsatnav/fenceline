index 0000000..83f847a
--- /dev/null
+++ b/src/lib/arrays.js
@@ -0,0 +1,173 @@
+/**
+ * Splits `xs` into consecutive arrays of length `n`. The last chunk may be shorter.
+ * @param {unknown[]} xs
+ * @param {number} n A positive integer.
+ * @returns {unknown[][]} New arrays holding the items in order; `[]` for an empty input.
+ * @throws {Error} If `xs` is not an array, or `n` is not a positive integer.
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new Error(`Expected an array: ${xs}`);
+  if (!Number.isInteger(n) || n < 1) throw new Error(`Expected a positive integer size: ${n}`);
+  const chunks = [];
+  for (let i = 0; i < xs.length; i += n) chunks.push(xs.slice(i, i + n));
+  return chunks;
+};
+
+/**
+ * Keeps the first item for each key, in the original order. Keys are compared the way `Set` compares them,
+ * so `NaN` matches `NaN` and `0` matches `-0`.
+ * @param {unknown[]} xs
+ * @param {(x: unknown) => unknown} keyFn Returns the key for an item.
+ * @returns {unknown[]} A new array with at most one item per key; `[]` for an empty input.
+ * @throws {Error} If `xs` is not an array, or `keyFn` is not a function.
+ */
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new Error(`Expected an array: ${xs}`);
+  if (typeof keyFn !== 'function') throw new Error(`Expected a key function: ${keyFn}`);
+  const seen = new Set();
+  return xs.filter((x) => {
+    const key = keyFn(x);
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+};
+
+/**
+ * Groups `xs` into arrays keyed by `keyFn`. Keys are converted to strings the way object keys are, so `1` and `'1'`
+ * land in the same group, and `null` becomes the key "null". Items keep their original order within each group.
+ * @param {unknown[]} xs
+ * @param {(x: unknown) => unknown} keyFn Returns the group key for an item.
+ * @returns {Record<string, unknown[]>} A new object mapping each key to the items with that key; `{}` for an empty input.
+ * @throws {Error} If `xs` is not an array, or `keyFn` is not a function.
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new Error(`Expected an array: ${xs}`);
+  if (typeof keyFn !== 'function') throw new Error(`Expected a key function: ${keyFn}`);
+  const groups = new Map();
+  for (const x of xs) {
+    const key = String(keyFn(x));
+    if (!groups.has(key)) groups.set(key, []);
+    groups.get(key).push(x);
+  }
+  return Object.fromEntries(groups);
+};
+
+/**
+ * Splits `xs` into the items that satisfy `pred` and the items that do not, keeping their order.
+ * @param {unknown[]} xs
+ * @param {(x: unknown) => boolean} pred Called once per item; a truthy result puts the item in the first array.
+ * @returns {[unknown[], unknown[]]} `[matching, notMatching]`, both new arrays; `[[], []]` for an empty input.
+ * @throws {Error} If `xs` is not an array, or `pred` is not a function.
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new Error(`Expected an array: ${xs}`);
+  if (typeof pred !== 'function') throw new Error(`Expected a predicate function: ${pred}`);
+  const matching = [];
+  const notMatching = [];
+  for (const x of xs) (pred(x) ? matching : notMatching).push(x);
+  return [matching, notMatching];
+};
+
+/**
+ * Pairs up the items of `a` and `b` by position. The result stops at the shorter array, so extra items in the
+ * longer one are dropped.
+ * @param {unknown[]} a
+ * @param {unknown[]} b
+ * @returns {Array<[unknown, unknown]>} New pairs `[a[i], b[i]]`; `[]` if either input is empty.
+ * @throws {Error} If `a` or `b` is not an array.
+ */
+exports.zip = (a, b) => {
+  if (!Array.isArray(a)) throw new Error(`Expected an array: ${a}`);
+  if (!Array.isArray(b)) throw new Error(`Expected an array: ${b}`);
+  const length = Math.min(a.length, b.length);
+  return Array.from({ length }, (_, i) => [a[i], b[i]]);
+};
+
+/**
+ * Numbers from `start` up to, but not including, `end`, moving by `step`. A negative step counts down, so
+ * `range(5, 0, -1)` gives 5 to 1. Each value is computed as `start + i * step`, so fractional steps do not drift.
+ * @param {number} start
+ * @param {number} end Exclusive.
+ * @param {number} [step] Defaults to 1. Must not be 0.
+ * @returns {number[]} The values in order; `[]` when `end` is already reached in the step's direction.
+ * @throws {Error} If an argument is not a finite number, or `step` is 0.
+ */
+exports.range = (start, end, step = 1) => {
+  for (const [name, v] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof v !== 'number' || !Number.isFinite(v)) throw new Error(`Expected a finite number for ${name}: ${v}`);
+  }
+  if (step === 0) throw new Error('Expected a non-zero step');
+  const count = Math.max(0, Math.ceil((end - start) / step));
+  return Array.from({ length: count }, (_, i) => start + i * step);
+};
+
+/**
+ * Flattens arrays nested to any depth into a single array. Only arrays are unwrapped; other items, including
+ * strings and objects, are kept as they are. Holes in a sparse array come out as `undefined`.
+ * @param {unknown[]} xs
+ * @returns {unknown[]} A new flat array; `[]` for an empty input.
+ * @throws {Error} If `xs` is not an array, or it contains itself, directly or through nested arrays.
+ */
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new Error(`Expected an array: ${xs}`);
+  const out = [];
+  const walk = (arr, ancestors) => {
+    if (ancestors.has(arr)) throw new Error('Cannot flatten a cyclic array');
+    ancestors.add(arr);
+    for (const x of arr) {
+      if (Array.isArray(x)) walk(x, ancestors);
+      else out.push(x);
+    }
+    ancestors.delete(arr);
+  };
+  walk(xs, new Set());
+  return out;
+};
+
+/**
+ * Returns a new array sorted by `keyFn`, smallest key first. The sort is stable, so items with equal keys keep their
+ * original order. Keys are compared with `<` and `>`, so they should be all numbers, all strings (compared by UTF-16
+ * code unit), or all Dates. `keyFn` is called once per item.
+ * @param {unknown[]} xs Not modified.
+ * @param {(x: unknown) => number | string | Date} keyFn Returns the sort key for an item.
+ * @returns {unknown[]} A new sorted array; `[]` for an empty input.
+ * @throws {Error} If `xs` is not an array, or `keyFn` is not a function.
+ */
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new Error(`Expected an array: ${xs}`);
+  if (typeof keyFn !== 'function') throw new Error(`Expected a key function: ${keyFn}`);
+  return Array.from(xs, (x) => ({ x, key: keyFn(x) }))
+    .sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0))
+    .map(({ x }) => x);
+};
+
+/**
+ * Picks one item of `xs` at random. Each item is equally likely, given an unbiased `rng`.
+ * @param {unknown[]} xs Not modified.
+ * @param {() => number} [rng] Returns a number in [0, 1). Defaults to `Math.random`.
+ * @returns {unknown} A random item, or `undefined` for an empty array.
+ * @throws {Error} If `xs` is not an array, `rng` is not a function, or `rng` returns a value outside [0, 1).
+ */
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new Error(`Expected an array: ${xs}`);
+  if (typeof rng !== 'function') throw new Error(`Expected a random function: ${rng}`);
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new Error(`Expected rng to return a number in [0, 1): ${r}`);
+  return xs[Math.floor(r * xs.length)];
+};
+
+/**
+ * Returns every run of `n` consecutive items, in order. Consecutive windows overlap by `n - 1` items.
+ * @param {unknown[]} xs
+ * @param {number} n A positive integer.
+ * @returns {unknown[][]} New arrays, one per window; `[]` when `n` is longer than `xs` or `xs` is empty.
+ * @throws {Error} If `xs` is not an array, or `n` is not a positive integer.
+ */
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new Error(`Expected an array: ${xs}`);
+  if (!Number.isInteger(n) || n < 1) throw new Error(`Expected a positive integer window size: ${n}`);
