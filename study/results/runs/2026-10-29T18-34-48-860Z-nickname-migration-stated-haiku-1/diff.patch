+  for (let i = 0; i < s.length; i++) {
+    const value = ROMAN_DIGIT_VALUES[s[i]];
+    const next = ROMAN_DIGIT_VALUES[s[i + 1]] || 0;
+    // A smaller digit before a larger one is subtractive, as in IV or CM.
+    total += value < next ? -value : value;
+  }
+  return total;
+};
