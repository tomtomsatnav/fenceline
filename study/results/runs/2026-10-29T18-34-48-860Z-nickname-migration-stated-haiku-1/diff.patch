+};
+
+/**
+ * Changes the given fields of a user. Fields left out, or `undefined`, are unchanged.
+ * @param {Db} db
+ * @param {string} id
+ * @param {{ email?: string, fullName?: string }} changes
+ * @returns {object} The updated user.
+ * @throws {Error} If `db` is missing, the user does not exist, or a new email or full name is invalid or already taken.
+ */
+exports.updateUser = (db, id, { email, fullName }) => {
+  assertDb(db);
+  if (!exports.getUser(db, id)) throw new Error(`No user with id: ${id}`);
+  const changes = {};
+  if (email !== undefined) {
+    if (typeof email !== 'string' || !email.includes('@')) throw new Error(`Invalid email: ${email}`);
+    const other = exports.getUserByEmail(db, email);
+    if (other && other.id !== id) throw new Error(`Email already in use: ${email}`);
+    changes.email = email;
+  }
+  if (fullName !== undefined) {
+    validateFullName(fullName);
+    changes.fullName = fullName;
+  }
