+  if (typeof n !== 'number' || Number.isNaN(n)) throw new Error(`Expected a number: ${n}`);
+  if (!Number.isInteger(n)) return false;
+  if (!Number.isSafeInteger(n)) throw new Error(`Expected an integer no larger than 2^53 - 1: ${n}`);
