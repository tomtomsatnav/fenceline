+const assertValidDate = (d) => {
+  if (!(d instanceof Date) || Number.isNaN(d.getTime())) throw new Error(`Expected a valid Date: ${d}`);
+};
+
+/**
+ * Returns a new Date `n` calendar days after `date`, or before it when `n` is negative. Arithmetic uses the local
+ * calendar, so the local time of day is kept across daylight saving changes. Month and year boundaries and leap
+ * days are handled. The input is not modified.
+ * @param {Date} date A valid Date.
+ * @param {number} n A safe integer number of days.
+ * @returns {Date} The shifted date.
+ * @throws {Error} If `date` is not a valid Date, `n` is not a safe integer, or the result is out of the Date range.
+ */
+exports.addDays = (date, n) => {
+  assertValidDate(date);
+  if (!Number.isSafeInteger(n)) throw new Error(`Expected a safe integer number of days: ${n}`);
+  const out = new Date(date.getTime());
+  out.setDate(out.getDate() + n);
+  if (Number.isNaN(out.getTime())) throw new Error(`Result is outside the range of Date: ${n} days`);
+  return out;
+};
