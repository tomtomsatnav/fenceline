+// Characters allowed in the local part of an address, as in RFC 5322 atoms. Dots separate atoms and may not repeat.
+const LOCAL_PART = /^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*$/;
+// A domain label: letters, digits and inner hyphens, 1 to 63 characters.
+const DOMAIN_LABEL = /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$/;
+const TOP_LEVEL_DOMAIN = /^[A-Za-z]{2,}$/;
+
+/**
+ * A practical email check, not a full RFC 5322 parser. It requires exactly one "@", a local part of 1 to 64 characters
+ * with no spaces, no leading, trailing or doubled dots, and a domain of at least two labels whose last label is 2 or
+ * more letters. The whole address is at most 254 characters. Non-ASCII letters are rejected, and so is a top-level
+ * domain that is not letters only, such as ".xn--p1ai".
+ * @param {string} s
+ * @returns {boolean} `true` if `s` looks like an email address.
+ * @throws {Error} If `s` is not a string.
+ */
+exports.isEmail = (s) => {
+  if (typeof s !== 'string') throw new Error(`Expected a string: ${String(s)}`);
+  if (s.length > 254) return false;
+  const parts = s.split('@');
+  if (parts.length !== 2) return false;
+  const [local, domain] = parts;
+  if (local.length > 64 || !LOCAL_PART.test(local)) return false;
+  const labels = domain.split('.');
+  if (labels.length < 2 || !labels.every((label) => DOMAIN_LABEL.test(label))) return false;
+  return TOP_LEVEL_DOMAIN.test(labels[labels.length - 1]);
+};
+
+// Eight-four-four-four-twelve hex digits. The version digit is 1 to 5 (RFC 4122), and the variant digit is 8, 9, a or b.
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+/**
+ * Tells whether `s` is a UUID as RFC 4122 defines it: the 8-4-4-4-12 hex form, with a version digit from 1 to 5 and
+ * the RFC 4122 variant. Upper and lower case hex are both accepted. The nil UUID (all zeros) and the max UUID (all
+ * ones) have no version, so they are rejected, and so are braces, a "urn:uuid:" prefix and a missing hyphen.
+ * @param {string} s
+ * @returns {boolean}
+ * @throws {Error} If `s` is not a string.
+ */
+exports.isUuid = (s) => {
+  if (typeof s !== 'string') throw new Error(`Expected a string: ${String(s)}`);
+  return UUID.test(s);
+};
+
+/**
+ * Tells whether `s` is a strong password: at least 12 characters, with a lower-case letter, an upper-case letter, a
+ * digit and a symbol. Characters are counted by code point, so an emoji counts as one. A symbol is any character that
+ * is not a letter, a digit or whitespace, so a space does not count as a symbol, but it does count toward the length.
+ * Letters are checked by Unicode case, so "é" is lower case and "É" is upper case. Scripts without case, such as
+ * Chinese, cannot supply the letter requirements.
+ * @param {string} s
+ * @returns {boolean}
+ * @throws {Error} If `s` is not a string.
+ */
+exports.isStrongPassword = (s) => {
+  if (typeof s !== 'string') throw new Error(`Expected a string: ${String(s)}`);
+  return [...s].length >= 12
+    && /\p{Ll}/u.test(s)
+    && /\p{Lu}/u.test(s)
+    && /\p{Nd}/u.test(s)
+    && /[^\p{L}\p{N}\s]/u.test(s);
+};
+
+/**
+ * Tells whether `s` is an absolute http or https URL, parsed with the WHATWG `URL` class. The scheme may be in any
+ * case, since `URL` lower-cases it. Any whitespace is rejected, because `URL` would silently trim the ends and strip
+ * tabs and line breaks, or percent-encode spaces, so a value is only accepted exactly as written.
+ * @param {string} s
+ * @returns {boolean} `true` for an http or https URL with a host. `false` for other schemes, relative references,
+ * whitespace and malformed text.
+ * @throws {Error} If `s` is not a string.
+ */
+exports.isUrl = (s) => {
+  if (typeof s !== 'string') throw new Error(`Expected a string: ${String(s)}`);
+  if (/\s/.test(s)) return false;
+  let url;
+  try {
+    url = new URL(s);
+  } catch {
+    return false;
+  }
+  return (url.protocol === 'http:' || url.protocol === 'https:') && url.hostname !== '';
+};
+
+// Outward code (area and district), then a single optional space, then the inward code: a digit and two letters.
+// GIR 0AA is the old Girobank code, which does not follow the usual pattern.
+const UK_POSTCODE = /^(?:GIR ?0AA|[A-Z]{1,2}[0-9][A-Z0-9]? ?[0-9][A-Z]{2})$/i;
+
+/**
+ * Tells whether `s` has the shape of a UK postcode, such as "SW1A 1AA", "M1 1AA" or "EC1A 1BB". Case does not matter,
+ * and the space is optional. This is a format check: it does not know which codes are allocated, and it allows letters
+ * that real codes avoid in some positions.
+ * @param {string} s
+ * @returns {boolean}
+ * @throws {Error} If `s` is not a string.
+ */
+exports.isPostcodeUK = (s) => {
+  if (typeof s !== 'string') throw new Error(`Expected a string: ${String(s)}`);
+  return UK_POSTCODE.test(s);
+};
+
+// Three-letter codes from ISO 4217 for widely used currencies. This is a short list, not the full standard.
+const COMMON_CURRENCIES = new Set([
+  'USD', 'EUR', 'GBP', 'JPY', 'CHF', 'CAD', 'AUD', 'NZD', 'CNY', 'HKD', 'SGD', 'INR', 'KRW', 'BRL', 'MXN', 'ZAR',
+  'SEK', 'NOK', 'DKK', 'PLN',
+]);
+
+/**
+ * Tells whether `s` is one of the common ISO 4217 currency codes in the list above, such as "USD" or "EUR". The check
+ * is exact: the code must be three upper-case letters, so "usd", " USD" and "USD " are rejected. Codes outside the
+ * list are rejected even when they are valid ISO codes, so this is not a full ISO 4217 check.
+ * @param {string} s
+ * @returns {boolean}
+ * @throws {Error} If `s` is not a string.
+ */
+exports.isIsoCurrency = (s) => {
+  if (typeof s !== 'string') throw new Error(`Expected a string: ${String(s)}`);
+  return COMMON_CURRENCIES.has(s);
+};
