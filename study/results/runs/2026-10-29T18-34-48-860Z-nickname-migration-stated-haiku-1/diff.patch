+const assertObjectAndKeys = (obj, keys) => {
+  if (obj === null || typeof obj !== 'object') throw new Error(`Expected an object: ${obj}`);
+  if (!Array.isArray(keys)) throw new Error(`Expected an array of keys: ${keys}`);
+  for (const key of keys) {
+    if (typeof key !== 'string' && typeof key !== 'symbol') throw new Error(`Expected a string or symbol key: ${String(key)}`);
+  }
+};
+
+/**
+ * Returns a new object holding only the listed keys of `obj`. Only the object's own properties are copied, and a key
+ * that `obj` does not have is left out rather than set to `undefined`.
+ * @param {object} obj
+ * @param {Array<string | symbol>} keys The keys to keep. The result lists them in this order.
+ * @returns {object} A new object; `{}` when no listed key is present.
+ * @throws {Error} If `obj` is not an object, `keys` is not an array, or a key is neither a string nor a symbol.
+ */
+exports.pick = (obj, keys) => {
+  assertObjectAndKeys(obj, keys);
+  // fromEntries defines each property rather than assigning it, so a key named "__proto__" is copied as data.
+  return Object.fromEntries(
+    keys.filter((key) => Object.prototype.hasOwnProperty.call(obj, key)).map((key) => [key, obj[key]]),
+  );
+};
+
+/**
+ * Returns a new object with every own enumerable property of `obj` except the listed keys. Keys that `obj` does not
+ * have are ignored. Property order is kept.
+ * @param {object} obj
+ * @param {Array<string | symbol>} keys The keys to leave out.
+ * @returns {object} A new object; a copy of `obj` when none of the listed keys is present.
+ * @throws {Error} If `obj` is not an object, `keys` is not an array, or a key is neither a string nor a symbol.
+ */
+exports.omit = (obj, keys) => {
+  assertObjectAndKeys(obj, keys);
+  const dropped = new Set(keys);
+  return Object.fromEntries(
+    Reflect.ownKeys(obj)
+      .filter((key) => !dropped.has(key) && Object.prototype.propertyIsEnumerable.call(obj, key))
+      .map((key) => [key, obj[key]]),
+  );
+};
+
+const isPlainObject = (v) => {
+  if (v === null || typeof v !== 'object') return false;
+  const proto = Object.getPrototypeOf(v);
+  return proto === Object.prototype || proto === null;
+};
