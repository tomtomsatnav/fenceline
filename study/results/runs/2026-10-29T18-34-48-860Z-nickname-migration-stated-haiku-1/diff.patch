+ * digits, so `roundTo(1.005, 2)` is 1.01 even though 1.005 is stored as slightly less than 1.005.
+ * A negative `places` rounds to tens, hundreds and so on.
+ * @param {number} x A finite number.
+ * @param {number} places An integer.
+ * @returns {number} `x` rounded to `places` decimal places.
+ * @throws {Error} If `x` is not finite, or `places` is not an integer.
+ */
+exports.roundTo = (x, places) => {
+  if (typeof x !== 'number' || !Number.isFinite(x)) throw new Error(`Expected a finite number: ${x}`);
+  if (!Number.isInteger(places)) throw new Error(`Expected an integer number of places: ${places}`);
+  const shifted = Math.round(shiftDecimal(Math.abs(x), places));
+  const rounded = shiftDecimal(shifted, -places);
+  return x < 0 && rounded !== 0 ? -rounded : rounded;
+};
