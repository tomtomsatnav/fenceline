+
+/**
+ * Looks up a user by email, ignoring case.
+ * @param {Db} db
+ * @param {string} email
+ * @returns {object | null} The user, or `null` if none has that email.
+ * @throws {Error} If `db` is missing.
+ */
+exports.getUserByEmail = (db, email) => {
+  assertDb(db);
+  const r = db.find('users', (u) => u.email.toLowerCase() === email.toLowerCase());
+  if (!r) return null;
+  return fromRow(r);
+};
+
+/**
+ * Lists users, oldest first, one page at a time.
+ * @param {Db} db
+ * @param {{ limit?: number, offset?: number }} [page] Defaults to `limit` 50 and `offset` 0.
+ * @returns {object[]} The users on the requested page.
+ * @throws {Error} If `db` is missing.
+ */
+exports.listUsers = (db, { limit = 50, offset = 0 } = {}) => {
+  assertDb(db);
+  return db.all('users').map(fromRow).sort((a, b) => a.createdAt.localeCompare(b.createdAt)).slice(offset, offset + limit);
+};
+
+/**
+ * Counts all users.
+ * @param {Db} db
+ * @returns {number} The number of users.
+ * @throws {Error} If `db` is missing.
+ */
+exports.countUsers = (db) => {
+  assertDb(db);
+  return db.all('users').length;
+};
+
+/**
+ * Finds users whose full name or email contains `query`, ignoring case.
+ * @param {Db} db
+ * @param {string} query
+ * @returns {object[]} Matching users in storage order.
+ * @throws {Error} If `db` is missing.
+ */
+exports.searchUsers = (db, query) => {
+  assertDb(db);
+  const q = query.toLowerCase();
+  return db.all('users')
+    .filter((u) => u.email.toLowerCase().includes(q) || u.fullname.toLowerCase().includes(q))
