+/**
+ * Writes `n` as a Roman numeral, such as 1994 as "MCMXCIV".
+ * @param {number} n An integer from 1 to 3999. Roman numerals have no zero, and the standard form stops at 3999.
+ * @returns {string} The Roman numeral, using the subtractive forms such as IV and CM.
+ * @throws {Error} If `n` is not an integer from 1 to 3999.
+ */
+exports.toRoman = (n) => {
+  if (!Number.isInteger(n) || n < 1 || n > 3999) throw new Error(`Expected an integer from 1 to 3999: ${n}`);
