+// Multiplies `x` by 10^k by moving the decimal point in its written form, so no binary rounding is introduced.
+const shiftDecimal = (x, k) => {
+  const [digits, exponent = '0'] = String(x).split('e');
+  return Number(`${digits}e${Number(exponent) + k}`);
+};
+
