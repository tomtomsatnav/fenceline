+/**
+ * Limits `x` to the range from `lo` to `hi`, inclusive.
+ * @param {number} x
+ * @param {number} lo
+ * @param {number} hi Must be at least `lo`. Either bound may be infinite.
+ * @returns {number} `lo` if `x` is below it, `hi` if `x` is above it, otherwise `x`.
+ * @throws {Error} If an argument is not a number or is `NaN`, or if `lo` is greater than `hi`.
+ */
+exports.clamp = (x, lo, hi) => {
+  for (const [name, v] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof v !== 'number' || Number.isNaN(v)) throw new Error(`Expected a number for ${name}: ${v}`);
+  }
+  if (lo > hi) throw new Error(`Expected lo to be at most hi: ${lo} > ${hi}`);
+  return Math.min(Math.max(x, lo), hi);
+};
+
