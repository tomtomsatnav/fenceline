@@ -0,0 +1,157 @@
+/**
+ * Converts text separated by spaces, hyphens or underscores to camelCase.
+ * Runs of separators and leading or trailing separators are ignored, and letter case is normalised.
+ * @param {string} str
+ * @returns {string} For example "hello_world" becomes "helloWorld", and "" stays "".
+ * @throws {Error} If `str` is not a string.
+ */
+exports.camelCase = (str) => {
+  if (typeof str !== 'string') throw new Error(`Expected a string: ${str}`);
+  const words = str.split(/[\s_-]+/).filter(Boolean).map((w) => w.toLowerCase());
+  return words.map((w, i) => (i === 0 ? w : w[0].toUpperCase() + w.slice(1))).join('');
+};
+
+/**
+ * Converts camelCase, PascalCase, or text separated by spaces, hyphens or underscores to kebab-case.
+ * Acronyms stay together, so "XMLHttpRequest" becomes "xml-http-request".
+ * @param {string} str
+ * @returns {string} For example "helloWorld" and "Hello World" both become "hello-world", and "" stays "".
+ * @throws {Error} If `str` is not a string.
+ */
+exports.kebabCase = (str) => {
+  if (typeof str !== 'string') throw new Error(`Expected a string: ${str}`);
+  const spaced = str.replace(/([a-z\d])([A-Z])/g, '$1 $2').replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2');
+  return spaced.split(/[\s_-]+/).filter(Boolean).map((w) => w.toLowerCase()).join('-');
+};
+
+/**
+ * Shortens `s` to at most `n` characters. When it cuts anything, the last character is "…".
+ * Characters are counted by code point, so an emoji is never split.
+ * @param {string} s
+ * @param {number} n A non-negative integer.
+ * @returns {string} `s` unchanged if it already fits, otherwise its first `n - 1` characters followed by "…".
+ * @throws {Error} If `s` is not a string, or `n` is not a non-negative integer.
+ */
+exports.truncate = (s, n) => {
+  if (typeof s !== 'string') throw new Error(`Expected a string: ${s}`);
+  if (!Number.isInteger(n) || n < 0) throw new Error(`Expected a non-negative integer length: ${n}`);
+  const chars = Array.from(s);
+  if (chars.length <= n) return s;
+  if (n === 0) return '';
+  return chars.slice(0, n - 1).join('') + '…';
+};
+
+/**
+ * Centres `s` in a field of `width` characters, padding both sides with `ch`.
+ * When the padding is odd, the extra character goes on the right. Characters are counted by code point.
+ * @param {string} s
+ * @param {number} width A non-negative integer.
+ * @param {string} [ch] A single character to pad with. Defaults to a space.
+ * @returns {string} `s` padded to `width`, or unchanged if it is already at least that wide.
+ * @throws {Error} If `s` is not a string, `width` is not a non-negative integer, or `ch` is not one character.
+ */
+exports.padCenter = (s, width, ch = ' ') => {
+  if (typeof s !== 'string') throw new Error(`Expected a string: ${s}`);
+  if (!Number.isInteger(width) || width < 0) throw new Error(`Expected a non-negative integer width: ${width}`);
+  if (typeof ch !== 'string' || Array.from(ch).length !== 1) throw new Error(`Expected a single character: ${ch}`);
+  const padding = width - Array.from(s).length;
+  if (padding <= 0) return s;
+  const left = Math.floor(padding / 2);
+  return ch.repeat(left) + s + ch.repeat(padding - left);
+};
+
+/**
+ * Counts the words in `s`. A word is a run of letters or digits, so whitespace and punctuation separate words.
+ * Apostrophes and hyphens therefore split words too: "don't" counts as 2.
+ * @param {string} s
+ * @returns {number} The number of words, 0 for an empty or punctuation-only string.
+ * @throws {Error} If `s` is not a string.
+ */
+exports.countWords = (s) => {
+  if (typeof s !== 'string') throw new Error(`Expected a string: ${s}`);
+  const words = s.match(/[\p{L}\p{N}]+/gu);
+  return words ? words.length : 0;
+};
+
+/**
+ * Returns the first letter of each word in `s`, uppercased. Words are split the same way as `countWords`,
+ * so "jean-luc picard" gives "JLP".
+ * @param {string} s
+ * @returns {string} For example "Ada King Lovelace" becomes "AKL", and "" stays "".
+ * @throws {Error} If `s` is not a string.
+ */
+exports.initials = (s) => {
+  if (typeof s !== 'string') throw new Error(`Expected a string: ${s}`);
+  const words = s.match(/[\p{L}\p{N}]+/gu) || [];
+  return words.map((w) => Array.from(w)[0].toUpperCase()).join('');
+};
+
+/**
+ * Reverses the order of the words in `s`. Words are separated by whitespace, and punctuation stays attached to its word.
+ * The result has single spaces between words, so runs of spaces, tabs and line breaks are collapsed and the ends trimmed.
+ * @param {string} s
+ * @returns {string} For example "the quick fox" becomes "fox quick the", and "" stays "".
+ * @throws {Error} If `s` is not a string.
+ */
+exports.reverseWords = (s) => {
+  if (typeof s !== 'string') throw new Error(`Expected a string: ${s}`);
+  return s.split(/\s+/).filter(Boolean).reverse().join(' ');
+};
+
+/**
+ * Tells whether `s` reads the same backwards. Case, whitespace and punctuation are ignored, so
+ * "A man, a plan, a canal: Panama" is a palindrome. A letter or digit is compared together with any combining
+ * marks that follow it, so decomposed and precomposed accents compare as the same character.
+ * @param {string} s
+ * @returns {boolean} `true` for an empty or punctuation-only string, since there is nothing to disagree.
+ * @throws {Error} If `s` is not a string.
+ */
+exports.isPalindrome = (s) => {
+  if (typeof s !== 'string') throw new Error(`Expected a string: ${s}`);
+  const units = s.toLowerCase().match(/[\p{L}\p{N}]\p{M}*/gu) || [];
+  return units.every((u, i) => u === units[units.length - 1 - i]);
+};
+
+/**
+ * Breaks `text` into lines of at most `width` characters, breaking only between words (greedy, first fit).
+ * Whitespace in `text` is collapsed to single spaces. A word longer than `width` cannot be broken, so it gets
+ * a line to itself and that line is longer than `width`.
+ * @param {string} text
+ * @param {number} width A positive integer, counted in code points.
+ * @returns {string} The wrapped lines joined with "\n", or "" for empty or blank text.
+ * @throws {Error} If `text` is not a string, or `width` is not a positive integer.
+ */
+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new Error(`Expected a string: ${text}`);
+  if (!Number.isInteger(width) || width < 1) throw new Error(`Expected a positive integer width: ${width}`);
+  const length = (s) => Array.from(s).length;
+  const lines = [];
+  let line = '';
+  for (const word of text.split(/\s+/).filter(Boolean)) {
+    if (line === '') {
+      line = word;
+    } else if (length(line) + 1 + length(word) <= width) {
+      line += ' ' + word;
+    } else {
+      lines.push(line);
+      line = word;
+    }
+  }
+  if (line !== '') lines.push(line);
+  return lines.join('\n');
+};
+
+/**
+ * Fills `{name}` placeholders in `text` from `vars`. A placeholder is `{` followed by word characters and `}`.
+ * Placeholders with no matching own property of `vars` are left exactly as written.
+ * @param {string} text
+ * @param {Record<string, unknown>} [vars] Defaults to no variables.
+ * @returns {string} The text with known placeholders replaced by `String(value)`.
+ * @throws {Error} If `text` is not a string, or `vars` is not an object.
+ */
+exports.template = (text, vars = {}) => {
+  if (typeof text !== 'string') throw new Error(`Expected a string: ${text}`);
+  if (typeof vars !== 'object' || vars === null) throw new Error(`Expected an object of variables: ${vars}`);
+  return text.replace(/\{(\w+)\}/g, (placeholder, name) =>
+    Object.prototype.hasOwnProperty.call(vars, name) ? String(vars[name]) : placeholder);
+};
