+ * be compared. Those values cannot be compared structurally, so the result would be misleading.
+ */
+exports.deepEqual = (a, b) => deepEqualWithin(a, b, []);
+
+// `seen` maps each original object to its copy, so shared references and cycles are copied once and stay linked.
+const cloneWithin = (value, seen) => {
+  if (typeof value === 'function') throw new Error('Cannot clone function values');
+  if (typeof value !== 'object' || value === null) return value;
+  if (seen.has(value)) return seen.get(value);
+  if (Array.isArray(value)) {
+    const out = new Array(value.length);
+    seen.set(value, out);
+    // Object.keys skips holes, so a sparse array stays sparse.
+    for (const key of Object.keys(value)) out[key] = cloneWithin(value[key], seen);
+    return out;
+  }
+  if (!isPlainObject(value)) throw new Error('Cannot clone non-plain objects such as Date, Map or class instances');
+  const out = Object.create(Object.getPrototypeOf(value));
+  seen.set(value, out);
+  for (const key of Object.keys(value)) {
+    // defineProperty rather than assignment, so a key named "__proto__" is copied as data.
+    Object.defineProperty(out, key, {
+      value: cloneWithin(value[key], seen),
+      enumerable: true,
+      writable: true,
+      configurable: true,
+    });
+  }
+  return out;
+};
+
+/**
+ * Deep copy of plain objects and arrays. The copy shares no objects or arrays with the original, but it keeps the
+ * shape: shared references stay shared, cycles stay cycles, holes in sparse arrays stay holes, and a null prototype
+ * stays null. Only own enumerable string keys are copied, matching `deepEqual`.
+ * @param {unknown} value
+ * @returns {unknown} The copy. Primitives (numbers, strings, booleans, null, undefined, symbols, bigints) are returned as they are.
+ * @throws {Error} If a function, or a non-plain object such as a Date, Map or class instance, is found anywhere inside `value`.
+ */
+exports.deepClone = (value) => cloneWithin(value, new Map());
+
+/**
+ * Reads a value at a dotted path, such as "a.b.0.c". Each segment is an own property name, so array indexes are
+ * written as numbers, and a key that itself contains a dot cannot be reached.
+ * @param {unknown} obj
+ * @param {string} path Segments separated by dots. An empty segment reads the key "".
+ * @param {unknown} [fallback] Returned when the path does not resolve, or resolves to `undefined`. Defaults to `undefined`.
+ * @returns {unknown} The value found, or `fallback`. Falsy values such as 0, '' and null are returned as they are.
+ * @throws {Error} If `path` is not a string.
+ */
+exports.getPath = (obj, path, fallback) => {
+  if (typeof path !== 'string') throw new Error(`Expected a string path: ${String(path)}`);
+  let current = obj;
+  for (const key of path.split('.')) {
+    // Only own properties count, so "constructor" or "toString" give the fallback, not a built-in.
+    if (current === null || typeof current !== 'object' || !Object.prototype.hasOwnProperty.call(current, key)) {
+      return fallback;
+    }
+    current = current[key];
+  }
+  return current === undefined ? fallback : current;
+};
+
+const isContainer = (v) => v !== null && typeof v === 'object' && (Array.isArray(v) || isPlainObject(v));
+
+const defineOwn = (obj, key, value) => {
+  // defineProperty rather than assignment, so a key named "__proto__" is set as data.
+  Object.defineProperty(obj, key, { value, enumerable: true, writable: true, configurable: true });
+  return obj;
+};
+
+// One level of copy: arrays are sliced, and objects keep their prototype and enumerable own keys, symbols included.
+const copyContainer = (node) => {
+  if (Array.isArray(node)) return node.slice();
+  const copy = Object.create(Object.getPrototypeOf(node));
+  for (const key of Reflect.ownKeys(node)) {
+    if (Object.prototype.propertyIsEnumerable.call(node, key)) defineOwn(copy, key, node[key]);
+  }
+  return copy;
+};
+
+const setWithin = (node, keys, value) => {
+  const [key, ...rest] = keys;
+  const copy = node === undefined ? {} : copyContainer(node);
+  if (rest.length === 0) return defineOwn(copy, key, value);
+  const child = node !== undefined && Object.prototype.hasOwnProperty.call(node, key) ? node[key] : undefined;
+  if (child !== undefined && !isContainer(child)) {
+    throw new Error(`Cannot set through "${key}": it is not a plain object or array`);
+  }
+  return defineOwn(copy, key, setWithin(child, rest, value));
+};
+
+/**
+ * Returns a new object with `value` stored at a dotted path, such as "a.b.c". Missing levels are created as plain
+ * objects, so "a.0" on a missing `a` gives `{ a: { 0: value } }`, not an array. The input is not modified: each object
+ * or array on the path is copied, and everything else is shared with the input.
+ * @param {object} obj A plain object or array.
+ * @param {string} path Segments separated by dots. An array index is written as a number, such as "list.1".
+ * @param {unknown} value Any value, including `undefined` and `null`.
+ * @returns {object} A new object with the value set.
+ * @throws {Error} If `obj` is not a plain object or array, `path` is not a string, or a level on the path already holds
+ * a value that is not a plain object or array (such as a string, a number, `null`, or a Date). Such a value is not
+ * overwritten.
+ */
+exports.setPath = (obj, path, value) => {
+  if (typeof path !== 'string') throw new Error(`Expected a string path: ${String(path)}`);
+  if (!isContainer(obj)) throw new Error('Expected a plain object or array to set into');
+  return setWithin(obj, path.split('.'), value);
+};
+
+// Writes each key of `source` into `target`. Plain objects present on both sides are merged; anything else from
+// `source` replaces the target's value. `ancestors` holds the sources being walked, so a cycle in `source` is copied
+// rather than merged forever.
+const mergeInto = (target, source, ancestors) => {
+  ancestors.push(source);
+  for (const key of Object.keys(source)) {
+    const sourceValue = source[key];
+    const targetValue = Object.prototype.hasOwnProperty.call(target, key) ? target[key] : undefined;
+    const merge = isPlainObject(sourceValue) && isPlainObject(targetValue) && !ancestors.includes(sourceValue);
+    // A merged object is copied first, so the copy is written to and the input objects are never modified.
+    defineOwn(target, key, merge ? mergeInto(copyContainer(targetValue), sourceValue, ancestors) : exports.deepClone(sourceValue));
+  }
+  ancestors.pop();
+  return target;
+};
+
+/**
+ * Merges plain object `b` into plain object `a`, recursively. Where both sides hold a plain object for a key, the two
+ * are merged. Everything else from `b` replaces `a`'s value, so arrays are replaced rather than joined, and `null` or
+ * `undefined` in `b` overwrites an object in `a`. Keys only in `a` are kept, and keys only in `b` are added.
+ * The result shares nothing with `a` or `b`, so it can be changed freely.
+ * @param {object} a A plain object.
+ * @param {object} b A plain object whose values win on conflicts.
+ * @returns {object} A new merged object.
+ * @throws {Error} If `a` or `b` is not a plain object, or a value that `deepClone` cannot copy (such as a Date, Map or
+ * function) is taken from either side.
+ */
+exports.mergeDeep = (a, b) => {
+  if (!isPlainObject(a) || !isPlainObject(b)) throw new Error('Expected two plain objects to merge');
+  return mergeInto(exports.deepClone(a), b, []);
+};
+
+/**
+ * Swaps keys and values: `{ a: 'x' }` becomes `{ x: 'a' }`. Each value becomes a key by string conversion, so `1` and
+ * `'1'` collide, and `null` becomes "null". When two keys share a value, the later key wins, and the result keeps the
+ * position of the first. Only own enumerable string keys are read.
+ * @param {object} obj An object whose values are primitives. Arrays are accepted, and their indexes become the values.
+ * @returns {object} A new object.
+ * @throws {Error} If `obj` is not an object, or a value is an object, function or symbol, which cannot be a key.
+ */
+exports.invert = (obj) => {
+  if (obj === null || typeof obj !== 'object') throw new Error(`Expected an object: ${String(obj)}`);
+  return Object.fromEntries(
+    Object.keys(obj).map((key) => {
+      const value = obj[key];
+      if ((typeof value === 'object' && value !== null) || typeof value === 'function' || typeof value === 'symbol') {
+        throw new Error(`Cannot invert key "${key}": its value is not a primitive`);
+      }
+      return [String(value), key];
+    }),
+  );
+};
