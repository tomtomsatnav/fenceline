+// A reasonable check that s looks like an email address: one "@", no spaces, a local part of ASCII letters, digits and
+// ._%+- (no leading, trailing or doubled dots), and a domain of dot-separated labels whose last label is at least two letters.
+// It does not check that the address exists or accepts mail.
+exports.isEmail = (s) => {
+  if (typeof s !== 'string') throw new Error('isEmail expects a string');
+  if (s.length > 254) return false;
+  const parts = s.split('@');
+  if (parts.length !== 2) return false;
+  const [local, domain] = parts;
+  if (local.length === 0 || local.length > 64) return false;
+  if (!/^[A-Za-z0-9._%+-]+$/.test(local) || local.startsWith('.') || local.endsWith('.') || local.includes('..')) return false;
+  const labels = domain.split('.');
+  if (labels.length < 2) return false;
+  if (!labels.every((label) => /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$/.test(label))) return false;
+  return /^[A-Za-z]{2,}$/.test(labels[labels.length - 1]);
+};
+
+// True for a UUID in the canonical 8-4-4-4-12 hex form, with version 1 to 5 and the RFC 4122 variant (8, 9, a or b).
+// Case-insensitive. The nil UUID (all zeros) and the max UUID (all f's) are not versioned, so they are rejected.
+exports.isUuid = (s) => {
+  if (typeof s !== 'string') throw new Error('isUuid expects a string');
+  return /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(s);
+};
+
+// True when s has at least 12 characters and contains a lower-case letter, an upper-case letter, a digit and a symbol.
+// A symbol is any character that is not a letter, a digit or whitespace. Length counts code points.
+exports.isStrongPassword = (s) => {
+  if (typeof s !== 'string') throw new Error('isStrongPassword expects a string');
+  if ([...s].length < 12) return false;
+  return /\p{Ll}/u.test(s) && /\p{Lu}/u.test(s) && /\p{Nd}/u.test(s) && /[^\p{L}\p{N}\s]/u.test(s);
+};
+
+// True when s is an absolute http or https URL with a host. Uses the URL class, so the address must parse fully.
+// Leading or trailing whitespace is rejected rather than trimmed.
+exports.isUrl = (s) => {
+  if (typeof s !== 'string') throw new Error('isUrl expects a string');
+  if (s !== s.trim()) return false;
+  let url;
+  try {
+    url = new URL(s);
+  } catch {
+    return false;
+  }
+  return (url.protocol === 'http:' || url.protocol === 'https:') && url.hostname !== '';
+};
+
+// True for a UK postcode such as "SW1A 1AA", in either case, with the space optional. Follows the GOV.UK postcode format:
+// the outward code's letters and the inward code's letters exclude the letters that are never used there.
+// Does not check that the postcode exists, and does not accept leading, trailing or doubled spaces.
+exports.isPostcodeUK = (s) => {
+  if (typeof s !== 'string') throw new Error('isPostcodeUK expects a string');
+  return /^(GIR ?0AA|[A-PR-UWYZ]([0-9]{1,2}|([A-HK-Y][0-9]([0-9ABEHMNPRV-Y])?)|[0-9][A-HJKPS-UW]) ?[0-9][ABD-HJLNP-UW-Z]{2})$/i.test(s);
+};
+
+// Codes of common currencies, from ISO 4217. Not exhaustive.
+const COMMON_CURRENCIES = new Set([
+  'USD', 'EUR', 'GBP', 'JPY', 'CHF', 'CAD', 'AUD', 'NZD', 'CNY', 'INR',
+  'SEK', 'NOK', 'DKK', 'SGD', 'HKD', 'MXN', 'BRL', 'ZAR',
+]);
+
+// True when s is one of a short list of common ISO 4217 currency codes. Case-sensitive: the code must be upper-case.
+exports.isIsoCurrency = (s) => {
+  if (typeof s !== 'string') throw new Error('isIsoCurrency expects a string');
+  return COMMON_CURRENCIES.has(s);
+};
+
+// True for a hex colour written as #rgb or #rrggbb, case-insensitive. Other lengths, a missing #, and #rgba or #rrggbbaa are rejected.
+exports.isHexColor = (s) => {
+  if (typeof s !== 'string') throw new Error('isHexColor expects a string');
+  return /^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i.test(s);
+};
+
+// True for a dotted-quad IPv4 address: four parts, each 0 to 255, with no leading zeros (so "01" is rejected). No CIDR suffix or spaces.
+exports.isIPv4 = (s) => {
+  if (typeof s !== 'string') throw new Error('isIPv4 expects a string');
+  const part = '(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)';
+  return new RegExp(`^${part}(\\.${part}){3}$`).test(s);
+};
+
+// True for a semantic version as defined at semver.org: MAJOR.MINOR.PATCH with no leading zeros, an optional pre-release
+// ("-beta.1") and an optional build ("+build.5"). Numeric pre-release identifiers may not have leading zeros.
+exports.isSemver = (s) => {
+  if (typeof s !== 'string') throw new Error('isSemver expects a string');
+  return /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\+([0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*))?$/.test(s);
+};
+
+// Total length of an IBAN for each of a few common countries. Countries not listed here are rejected rather than guessed at.
+const IBAN_LENGTHS = { AT: 20, BE: 16, CH: 21, DE: 22, ES: 24, FR: 27, GB: 22, IE: 22, IT: 27, NL: 18 };
+
+// True when s is an IBAN in its electronic form (no spaces, upper-case), from a listed country, with the right length
+// and a valid mod-97 check (ISO 13616). Does not check that the account exists.
+exports.isIban = (s) => {
+  if (typeof s !== 'string') throw new Error('isIban expects a string');
+  if (!/^[A-Z]{2}[0-9]{2}[A-Z0-9]+$/.test(s)) return false;
+  const country = s.slice(0, 2);
+  if (IBAN_LENGTHS[country] !== s.length) return false;
+  // Move the first four characters to the end, map letters to 10 to 35, then take the number mod 97 one digit at a time.
+  const rearranged = s.slice(4) + s.slice(0, 4);
+  let remainder = 0;
+  for (const ch of rearranged) {
+    const digits = ch >= 'A' && ch <= 'Z' ? String(ch.charCodeAt(0) - 55) : ch;
+    for (const d of digits) remainder = (remainder * 10 + Number(d)) % 97;
+  }
+  return remainder === 1;
+};
+
+// True when s is a string of at least two digits that passes the Luhn check: double every second digit from the right,
+// subtract 9 from any result above 9, and the total must be a multiple of 10. Spaces and dashes are rejected, so strip them first.
+// The check does not identify a card network or confirm that a card exists.
+exports.isCreditCardLuhn = (s) => {
+  if (typeof s !== 'string') throw new Error('isCreditCardLuhn expects a string');
+  if (!/^[0-9]{2,}$/.test(s)) return false;
+  let sum = 0;
+  for (let i = s.length - 1, position = 0; i >= 0; i--, position++) {
+    let digit = Number(s[i]);
+    if (position % 2 === 1) {
+      digit *= 2;
+      if (digit > 9) digit -= 9;
+    }
+    sum += digit;
+  }
+  return sum % 10 === 0;
+};
