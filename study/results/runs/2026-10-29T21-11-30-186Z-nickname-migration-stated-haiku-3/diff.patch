@@ -0,0 +1,37 @@
+# App
+
+## Users API
+
+The functions in `src/api/` take a database as their first argument. Create one with:
+
+```js
+const { Db } = require('./src/db.js');
+const { migrate } = require('./src/migrate.js');
+const db = migrate(new Db());
+```
+
+Every function throws `Error('db is required')` when `db` is missing.
+
+### `src/api/users.js`
+
+A `User` is `{ id, email, fullName, createdAt, lastLogin }`. `createdAt` is an ISO 8601 timestamp, and `lastLogin` is an ISO 8601 timestamp or `null`.
+
+- **`createUser(db, { email, fullName })`** creates a user with a new id and the current time as `createdAt`. Returns the `User`. Throws if the email has no `@` or is already used (ignoring case), or if `fullName` is not a non-empty string of at most 100 characters.
+- **`restoreUser(db, user)`** inserts a full user, keeping its `id`, `createdAt` and `lastLogin`. Used by `importUsersCsv`. Applies the same checks as `createUser`, and also throws if the `id` is already taken.
+- **`getUser(db, id)`** returns the `User` with that id, or `null`.
+- **`getUserByEmail(db, email)`** returns the `User` with that email, ignoring case, or `null`.
+- **`countUsers(db)`** returns the number of users.
+- **`updateUser(db, id, { email, fullName })`** changes only the fields given and returns the updated `User`. Throws if the user does not exist, or if the new email or name is invalid or taken.
+- **`searchUsers(db, query)`** returns users whose `fullName` or `email` contains `query`, ignoring case. Oldest first.
+- **`deleteUser(db, id)`** removes the user. Returns `true` if one was removed, `false` if no user has that id.
+- **`recordLogin(db, id, when = new Date())`** sets `lastLogin` and returns the updated `User`. Throws if the user does not exist.
+- **`listUsers(db, { limit = 50, offset = 0 } = {})`** returns one page of users, oldest first. Throws if `limit` or `offset` is not a non-negative integer.
+
+### `src/api/format.js`
+
+- **`displayName(user)`** returns `user.fullName` when it has text, otherwise the part of `user.email` before `@`.
+
+### `src/api/export.js`
+
+- **`exportUsersCsv(db)`** returns every user as CSV text. The header is `id,email,fullName,createdAt,lastLogin`. Fields with commas, quotes or line breaks are quoted. Rows end in CRLF.
+- **`importUsersCsv(db, csv)`** reads CSV written by `exportUsersCsv` and inserts each user with its original id and timestamps. Rows are inserted one at a time, so a row that fails validation leaves the earlier rows in place. Throws if the header is wrong or a row has the wrong number of fields.
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..433268e
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,79 @@
+const { countUsers, listUsers, restoreUser } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quotes a CSV field when it contains a comma, a quote or a line break.
+const csvField = (value) => {
+  const s = value == null ? '' : String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * Writes every user as CSV, with a header row of id, email, fullName, createdAt, lastLogin.
+ * Fields containing commas, quotes or line breaks are quoted. Rows end in CRLF.
+ * @param {object} db The database.
+ * @returns {string} The CSV text.
+ * @throws {Error} If db is missing.
+ */
+exports.exportUsersCsv = (db) => {
+  const users = listUsers(db, { limit: countUsers(db) });
+  const lines = [COLUMNS, ...users.map((u) => COLUMNS.map((c) => u[c]))];
+  return lines.map((line) => line.map(csvField).join(',')).join('\r\n') + '\r\n';
+};
+
+// Splits CSV text into rows of fields, honouring quoted fields with commas, quotes and line breaks.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c === '"' && text[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else if (c === '"') {
+        quoted = false;
+      } else {
+        field += c;
+      }
+    } else if (c === '"') {
+      quoted = true;
+    } else if (c === ',') {
+      row.push(field);
+      field = '';
+    } else if (c === '\n') {
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+    } else if (c !== '\r') {
+      field += c;
+    }
+  }
+  if (field !== '' || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+  return rows;
+};
+
+/**
+ * Reads users from CSV written by exportUsersCsv and inserts them with their original ids and timestamps.
+ * Rows are inserted one at a time, so a row that fails validation leaves the earlier rows in place.
+ * @param {object} db The database.
+ * @param {string} csv CSV text with the header id, email, fullName, createdAt, lastLogin.
+ * @returns {void}
+ * @throws {Error} If db is missing, the header is wrong, a row has the wrong number of fields, or a row fails validation.
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (!db) throw new Error('db is required');
+  const [header, ...records] = parseCsv(csv);
+  if (!header || header.join(',') !== COLUMNS.join(',')) throw new Error(`expected header: ${COLUMNS.join(',')}`);
+  for (const record of records) {
+    if (record.length !== COLUMNS.length) throw new Error(`expected ${COLUMNS.length} fields, got ${record.length}`);
+    const [id, email, fullName, createdAt, lastLogin] = record;
+    restoreUser(db, { id, email, fullName, createdAt, lastLogin: lastLogin === '' ? undefined : lastLogin });
+  }
+};
