+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { createUser, recordLogin, listUsers } = require('../src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+test('exports only a header row when there are no users', () => {
+  const db = migrate(new Db());
+  assert.strictEqual(exportUsersCsv(db), 'id,email,fullName,createdAt,lastLogin\r\n');
+});
+
+test('exports one row per user and leaves an unset lastLogin empty', () => {
+  const db = migrate(new Db());
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  assert.strictEqual(
+    exportUsersCsv(db),
+    `id,email,fullName,createdAt,lastLogin\r\n${u.id},ada@example.com,Ada Lovelace,${u.createdAt},\r\n`,
+  );
+  recordLogin(db, u.id, new Date('2024-05-01T12:00:00.000Z'));
+  assert.ok(exportUsersCsv(db).endsWith(`,${u.createdAt},2024-05-01T12:00:00.000Z\r\n`));
+});
+
+test('quotes fields that contain commas, quotes or line breaks', () => {
+  const db = migrate(new Db());
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Lovelace, "Ada"' });
+  assert.ok(exportUsersCsv(db).includes(`,ada@example.com,"Lovelace, ""Ada""",${u.createdAt},\r\n`));
+});
+
+test('exports every user, not just the first page', () => {
+  const db = migrate(new Db());
+  for (let i = 0; i < 55; i++) createUser(db, { email: `u${i}@example.com`, fullName: `User ${i}` });
+  assert.strictEqual(exportUsersCsv(db).split('\r\n').length - 1, 56);
+});
+
+test('exportUsersCsv throws when db is missing', () => {
+  assert.throws(() => exportUsersCsv(undefined), /^Error: db is required$/);
+});
+
+test('importUsersCsv restores exported users exactly', () => {
+  const source = migrate(new Db());
+  const ada = createUser(source, { email: 'ada@example.com', fullName: 'Lovelace, "Ada"\nCountess' });
+  createUser(source, { email: 'grace@example.com', fullName: 'Grace Hopper' });
