+
+const checkDb = (db) => {
+  if (!db) throw new Error('db is required');
+};
+
+const checkFullName = (fullName) => {
+  if (typeof fullName !== 'string' || fullName.trim() === '' || fullName.length > 100) {
+    throw new Error('fullName must be a non-empty string of at most 100 characters');
