+// otherwise b's value wins, including undefined, and arrays are replaced rather than merged. The inputs are not changed.
+exports.mergeDeep = (a, b) => {
+  if (!isPlainObject(a) || !isPlainObject(b)) throw new Error('mergeDeep expects plain objects');
+  const active = [];
+  const merge = (x, y) => {
+    if (active.some(([p, q]) => p === x && q === y)) throw new Error('mergeDeep does not support circular references');
+    active.push([x, y]);
+    const result = {};
+    for (const key of new Set([...Object.keys(x), ...Object.keys(y)])) {
+      const xv = Object.hasOwn(x, key) ? x[key] : undefined;
+      const yv = Object.hasOwn(y, key) ? y[key] : undefined;
+      const value = Object.hasOwn(y, key) ? (isPlainObject(xv) && isPlainObject(yv) ? merge(xv, yv) : yv) : xv;
+      setOwn(result, key, value);
+    }
+    active.pop();
+    return result;
+  };
+  return merge(a, b);
+};
+
+// A new object with each value of obj as a key and its key as the value. Values become keys as strings, so they must be
+// primitives. When two keys share a value, the later key wins. Throws for object or function values, whose string form is not meaningful.
+exports.invert = (obj) => {
+  if (typeof obj !== 'object' || obj === null) throw new Error('invert expects an object');
+  const result = {};
+  for (const key of Object.keys(obj)) {
+    const value = obj[key];
+    if (typeof value === 'function' || (typeof value === 'object' && value !== null)) {
+      throw new Error('invert expects primitive values');
+    }
+    setOwn(result, String(value), key);
+  }
+  return result;
+};
+
+// Flattens nested plain objects into one level, joining keys with dots: { a: { b: 1 } } -> { "a.b": 1 }.
+// Arrays, Dates and other non-plain values are kept whole, as are empty nested objects, so they are not lost.
+// A key that contains a dot can collide with a nested path. Throws for a circular structure.
+exports.flattenKeys = (obj) => {
+  if (!isPlainObject(obj)) throw new Error('flattenKeys expects a plain object');
+  const result = {};
+  const active = new Set();
+  const walk = (node, prefix) => {
+    if (active.has(node)) throw new Error('flattenKeys does not support circular references');
+    active.add(node);
+    for (const key of Object.keys(node)) {
+      const path = prefix === undefined ? key : `${prefix}.${key}`;
+      const value = node[key];
+      if (isPlainObject(value) && Object.keys(value).length > 0) {
+        walk(value, path);
+      } else {
+        setOwn(result, path, value);
+      }
+    }
+    active.delete(node);
+  };
+  walk(obj, undefined);
+  return result;
+};
+
+// The inverse of flattenKeys: { "a.b": 1 } -> { a: { b: 1 } }. Values are kept by reference.
+// Throws when two keys conflict, such as "a" alongside "a.b", since one of them would be lost.
+exports.unflattenKeys = (flat) => {
+  if (!isPlainObject(flat)) throw new Error('unflattenKeys expects a plain object');
+  const result = {};
+  const created = new Set();
+  const conflict = (path) => new Error(`unflattenKeys conflict at "${path}"`);
+  for (const path of Object.keys(flat)) {
+    const keys = path.split('.');
+    let node = result;
+    for (const key of keys.slice(0, -1)) {
+      if (!Object.hasOwn(node, key)) {
+        const child = {};
+        setOwn(node, key, child);
+        created.add(child);
+      }
+      node = node[key];
+      // Only objects this function made may be extended; a value the input supplied is a conflict.
+      if (!created.has(node)) throw conflict(path);
+    }
+    const last = keys[keys.length - 1];
+    if (Object.hasOwn(node, last)) throw conflict(path);
+    setOwn(node, last, flat[path]);
+  }
+  return result;
+};
+
+// A new object with fn applied to each own enumerable value of obj. fn receives (value, key). Keys are kept; obj is not changed.
+exports.mapValues = (obj, fn) => {
+  if (typeof obj !== 'object' || obj === null) throw new Error('mapValues expects an object');
+  if (typeof fn !== 'function') throw new Error('mapValues expects a function');
+  const result = {};
+  for (const key of Object.keys(obj)) setOwn(result, key, fn(obj[key], key));
+  return result;
+};
+
+// A new object with only the own enumerable entries whose key passes pred(key). Values are kept by reference; obj is not changed.
+exports.filterKeys = (obj, pred) => {
+  if (typeof obj !== 'object' || obj === null) throw new Error('filterKeys expects an object');
+  if (typeof pred !== 'function') throw new Error('filterKeys expects a predicate');
+  const result = {};
+  for (const key of Object.keys(obj)) {
+    if (pred(key)) setOwn(result, key, obj[key]);
+  }
+  return result;
+};
+
+// Shallow comparison of two objects: { added, removed, changed } as arrays of keys. added are keys only in b, removed are keys only in a,
+// and changed are keys in both whose values are not the same (Object.is), so nested objects count as changed when they are different references.
+// Keys come out in the order they appear in the object they came from.
+exports.diffObjects = (a, b) => {
+  if (typeof a !== 'object' || a === null || typeof b !== 'object' || b === null) {
+    throw new Error('diffObjects expects two objects');
+  }
+  const added = Object.keys(b).filter((key) => !Object.hasOwn(a, key));
+  const removed = Object.keys(a).filter((key) => !Object.hasOwn(b, key));
+  const changed = Object.keys(a).filter((key) => Object.hasOwn(b, key) && !Object.is(a[key], b[key]));
+  return { added, removed, changed };
+};
