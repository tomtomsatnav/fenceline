diff --git a/src/lib/arrays.js b/src/lib/arrays.js
new file mode 100644
index 0000000..19edc8e
--- /dev/null
+++ b/src/lib/arrays.js
@@ -0,0 +1,178 @@
+// Splits xs into arrays of length n. The last chunk may be shorter.
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new Error('chunk expects an array');
+  if (!Number.isInteger(n) || n < 1) throw new Error('chunk expects a positive integer size');
+  const chunks = [];
+  for (let i = 0; i < xs.length; i += n) chunks.push(xs.slice(i, i + n));
+  return chunks;
+};
+
+// Keeps the first item for each key returned by keyFn, in their original order. Keys are compared with SameValueZero, as Set does.
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new Error('uniqueBy expects an array');
+  if (typeof keyFn !== 'function') throw new Error('uniqueBy expects a key function');
+  const seen = new Set();
+  return xs.filter((x) => {
+    const key = keyFn(x);
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+};
+
+// Groups xs into an object of arrays, keyed by the string value of keyFn(x). Items keep their order within each group.
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new Error('groupBy expects an array');
+  if (typeof keyFn !== 'function') throw new Error('groupBy expects a key function');
+  const groups = {};
+  for (const x of xs) {
+    const key = String(keyFn(x));
+    // defineProperty, not assignment, so a key such as "__proto__" becomes an ordinary entry.
+    if (!Object.hasOwn(groups, key)) {
+      Object.defineProperty(groups, key, { value: [], enumerable: true, writable: true, configurable: true });
+    }
+    groups[key].push(x);
+  }
+  return groups;
+};
+
+// Splits xs into [matching, notMatching], keeping each group in its original order.
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new Error('partition expects an array');
+  if (typeof pred !== 'function') throw new Error('partition expects a predicate');
+  const matching = [];
+  const notMatching = [];
+  for (const x of xs) (pred(x) ? matching : notMatching).push(x);
+  return [matching, notMatching];
+};
+
+// Pairs items of a and b by position, stopping at the shorter array.
+exports.zip = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new Error('zip expects two arrays');
+  const length = Math.min(a.length, b.length);
+  const pairs = [];
+  for (let i = 0; i < length; i++) pairs.push([a[i], b[i]]);
+  return pairs;
+};
+
+// Numbers from start up to but not including end, stepping by step. A negative step counts down.
+// Returns [] when end is not reached from start in the direction of step.
+exports.range = (start, end, step = 1) => {
+  for (const v of [start, end, step]) {
+    if (typeof v !== 'number' || !Number.isFinite(v)) throw new Error('range expects finite numbers');
+  }
+  if (step === 0) throw new Error('range expects a non-zero step');
+  const count = Math.max(0, Math.ceil((end - start) / step));
+  return Array.from({ length: count }, (_, i) => start + i * step);
+};
+
+// Flattens arrays nested to any depth into one array. Items that are not arrays are kept as they are.
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new Error('flattenDeep expects an array');
+  const out = [];
+  const open = new Set();
+  const walk = (arr) => {
+    if (open.has(arr)) throw new Error('flattenDeep found a circular reference');
+    open.add(arr);
+    for (const x of arr) {
+      if (Array.isArray(x)) walk(x);
+      else out.push(x);
+    }
+    open.delete(arr);
+  };
+  walk(xs);
+  return out;
+};
+
+// Returns a new array sorted by keyFn(x) in ascending order. Equal keys keep their original order. xs is not changed.
+// Keys are compared with < and >, so they should be numbers or strings of the same kind.
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new Error('sortBy expects an array');
+  if (typeof keyFn !== 'function') throw new Error('sortBy expects a key function');
+  return xs
+    .map((x) => ({ x, key: keyFn(x) }))
+    .sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0))
+    .map(({ x }) => x);
+};
+
+// Returns one item of xs chosen at random, or undefined when xs is empty. rng must return a number in [0, 1).
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new Error('sample expects an array');
+  if (typeof rng !== 'function') throw new Error('sample expects a random number function');
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new Error('rng must return a number in [0, 1)');
+  return xs[Math.floor(r * xs.length)];
+};
+
+// Returns every run of n consecutive items, each as a new array. Returns [] when n is longer than xs.
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new Error('windowed expects an array');
+  if (!Number.isInteger(n) || n < 1) throw new Error('windowed expects a positive integer size');
+  const windows = [];
+  for (let i = 0; i + n <= xs.length; i++) windows.push(xs.slice(i, i + n));
+  return windows;
+};
+
+// The items of a that are not in b, in their original order. Duplicates in a are kept. Membership uses SameValueZero, as Set does.
+exports.difference = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new Error('difference expects two arrays');
+  const exclude = new Set(b);
+  return a.filter((x) => !exclude.has(x));
+};
+
+// The items that appear in every one of the given arrays, without duplicates and in the order they first appear in the first array.
+// Membership uses SameValueZero, as Set does.
+exports.intersection = (...arrays) => {
+  if (arrays.length === 0) throw new Error('intersection expects at least one array');
+  if (!arrays.every((a) => Array.isArray(a))) throw new Error('intersection expects arrays');
+  const [first, ...rest] = arrays;
+  const others = rest.map((a) => new Set(a));
+  return [...new Set(first)].filter((x) => others.every((set) => set.has(x)));
+};
+
+// A new array with the items moved k places to the left, wrapping around. A negative k rotates right. Returns [] for an empty array.
+exports.rotate = (xs, k) => {
+  if (!Array.isArray(xs)) throw new Error('rotate expects an array');
+  if (!Number.isInteger(k)) throw new Error('rotate expects an integer shift');
+  const n = xs.length;
+  if (n === 0) return [];
+  const shift = ((k % n) + n) % n;
+  return [...xs.slice(shift), ...xs.slice(0, shift)];
+};
+
+// Counts the items of xs by the string value of keyFn(x), returning an object of counts. Keys are strings, as with groupBy.
+exports.countBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new Error('countBy expects an array');
+  if (typeof keyFn !== 'function') throw new Error('countBy expects a key function');
+  const counts = {};
+  for (const x of xs) {
+    const key = String(keyFn(x));
+    // defineProperty, not assignment, so a key such as "__proto__" becomes an ordinary entry.
+    if (!Object.hasOwn(counts, key)) {
+      Object.defineProperty(counts, key, { value: 0, enumerable: true, writable: true, configurable: true });
+    }
+    counts[key]++;
+  }
+  return counts;
+};
+
+// The item whose keyFn(x) is largest, or undefined for an empty array. On a tie the first item wins.
+// Items whose key is NaN are skipped, since NaN is never larger than anything.
+exports.maxBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new Error('maxBy expects an array');
+  if (typeof keyFn !== 'function') throw new Error('maxBy expects a key function');
+  let best;
+  let bestKey;
+  let found = false;
+  for (const x of xs) {
+    const key = keyFn(x);
+    if (Number.isNaN(key)) continue;
+    if (!found || key > bestKey) {
+      best = x;
+      bestKey = key;
+      found = true;
+    }
+  }
+  return best;
+};
