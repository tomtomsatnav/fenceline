+// Converts words separated by spaces, hyphens or underscores to camelCase, e.g. "hello-world" -> "helloWorld".
+exports.camelCase = (input) => {
+  if (typeof input !== 'string') throw new Error('camelCase expects a string');
+  const words = input.split(/[\s_-]+/).filter((w) => w !== '');
+  return words
+    .map((w, i) => {
+      const lower = w.toLowerCase();
+      return i === 0 ? lower : lower[0].toUpperCase() + lower.slice(1);
+    })
+    .join('');
+};
+
+// Converts camelCase, PascalCase and words separated by spaces, hyphens or underscores to kebab-case, e.g. "helloWorld" -> "hello-world".
+exports.kebabCase = (input) => {
+  if (typeof input !== 'string') throw new Error('kebabCase expects a string');
+  return input
+    .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
+    .replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2')
+    .split(/[\s_-]+/)
+    .filter((w) => w !== '')
+    .map((w) => w.toLowerCase())
+    .join('-');
+};
+
+// Shortens s to at most n characters, ending in "…" when it cut anything. Counts code points, so an emoji is one character.
+exports.truncate = (s, n) => {
+  if (typeof s !== 'string') throw new Error('truncate expects a string');
+  if (!Number.isInteger(n) || n < 0) throw new Error('truncate expects a non-negative integer length');
+  const chars = [...s];
+  if (chars.length <= n) return s;
+  if (n === 0) return '';
+  return chars.slice(0, n - 1).join('') + '…';
+};
+
+// Centres s in a field of the given width, padding with ch. Extra space goes on the right when the padding is odd. Counts code points.
+exports.padCenter = (s, width, ch = ' ') => {
+  if (typeof s !== 'string') throw new Error('padCenter expects a string');
+  if (!Number.isInteger(width) || width < 0) throw new Error('padCenter expects a non-negative integer width');
+  if ([...ch].length !== 1) throw new Error('padCenter expects a single character as the pad');
+  const total = width - [...s].length;
+  if (total <= 0) return s;
+  const left = Math.floor(total / 2);
+  return ch.repeat(left) + s + ch.repeat(total - left);
+};
+
+// Counts runs of characters that are neither whitespace nor punctuation, so "well-known" counts as two words.
+exports.countWords = (s) => {
+  if (typeof s !== 'string') throw new Error('countWords expects a string');
+  return (s.match(/[^\s\p{P}]+/gu) ?? []).length;
+};
+
+// Returns the uppercase first letter of each whitespace-separated word, e.g. "Ada King Lovelace" -> "AKL". Words with no letter are skipped.
+exports.initials = (s) => {
+  if (typeof s !== 'string') throw new Error('initials expects a string');
+  return s
+    .split(/\s+/)
+    .map((w) => w.match(/\p{L}/u))
+    .filter((m) => m !== null)
+    .map((m) => m[0].toUpperCase())
+    .join('');
+};
+
+// Reverses the order of the words, joining them with single spaces. Runs of whitespace and leading or trailing whitespace are dropped.
+exports.reverseWords = (s) => {
+  if (typeof s !== 'string') throw new Error('reverseWords expects a string');
+  return s.split(/\s+/).filter((w) => w !== '').reverse().join(' ');
+};
+
+// True when the letters and digits of s read the same backwards, ignoring case, spaces and punctuation.
+exports.isPalindrome = (s) => {
+  if (typeof s !== 'string') throw new Error('isPalindrome expects a string');
+  const letters = [...s.toLowerCase().replace(/[^\p{L}\p{N}]/gu, '')];
+  return letters.join('') === letters.reverse().join('');
+};
+
+// Greedy word wrap: joins words with single spaces, starting a new line before a word that would overflow width.
+// A word longer than width is never broken, so it sits alone on its own line and may exceed width.
+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new Error('wrap expects a string');
+  if (!Number.isInteger(width) || width < 1) throw new Error('wrap expects a positive integer width');
+  const lines = [];
+  let line = '';
+  for (const word of text.split(/\s+/).filter((w) => w !== '')) {
+    if (line === '') {
+      line = word;
+    } else if ([...line].length + 1 + [...word].length <= width) {
+      line += ' ' + word;
+    } else {
+      lines.push(line);
+      line = word;
+    }
+  }
+  if (line !== '') lines.push(line);
+  return lines.join('\n');
+};
+
+// Replaces each {name} with vars.name. Placeholders with no matching value are left as they are.
+exports.template = (text, vars = {}) => {
+  if (typeof text !== 'string') throw new Error('template expects a string');
+  if (typeof vars !== 'object' || vars === null) throw new Error('template expects an object of values');
+  return text.replace(/\{(\w+)\}/g, (match, name) => (Object.hasOwn(vars, name) && vars[name] !== undefined ? String(vars[name]) : match));
+};
+
+// A URL-friendly slug: lower-case ASCII letters and digits, with each run of anything else turned into one dash and dashes trimmed from the ends.
+// Non-ASCII letters are not transliterated, so they become dashes ("café" -> "caf").
+exports.slugifyAscii = (s) => {
+  if (typeof s !== 'string') throw new Error('slugifyAscii expects a string');
+  return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
+};
+
+// Escapes & < > " and ' so the text can be placed in HTML element content or a quoted attribute.
+// One pass with a lookup table, so an ampersand is escaped once and never double-escaped.
+const HTML_ENTITIES = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
+exports.escapeHtml = (s) => {
+  if (typeof s !== 'string') throw new Error('escapeHtml expects a string');
+  return s.replace(/[&<>"']/g, (ch) => HTML_ENTITIES[ch]);
+};
+
+// Removes HTML tags and comments, keeping the text between them. Quoted attribute values may contain ">".
+// This is a simple text filter, not an HTML sanitiser: it does not make untrusted HTML safe, and entities such as &amp; are left as they are.
+exports.stripTags = (s) => {
+  if (typeof s !== 'string') throw new Error('stripTags expects a string');
+  return s
+    .replace(/<!--[\s\S]*?-->/g, '')
+    .replace(/<\/?[A-Za-z][^>"']*(?:(?:"[^"]*"|'[^']*')[^>"']*)*>/g, '');
+};
+
+// Edit distance between a and b: the fewest single-character insertions, deletions and substitutions that turn one into the other.
+// Case-sensitive. Compares code points, so an emoji counts as one character.
+exports.levenshtein = (a, b) => {
+  if (typeof a !== 'string' || typeof b !== 'string') throw new Error('levenshtein expects two strings');
+  const x = [...a];
+  const y = [...b];
+  let previous = Array.from({ length: y.length + 1 }, (_, j) => j);
+  for (let i = 1; i <= x.length; i++) {
+    const current = [i];
+    for (let j = 1; j <= y.length; j++) {
+      const cost = x[i - 1] === y[j - 1] ? 0 : 1;
+      current[j] = Math.min(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + cost);
+    }
+    previous = current;
+  }
+  return previous[y.length];
+};
+
+// The longest prefix shared by every string in strs. Returns '' for an empty array. Compares code points, so an emoji is one character.
+exports.commonPrefix = (strs) => {
+  if (!Array.isArray(strs)) throw new Error('commonPrefix expects an array of strings');
+  if (!strs.every((s) => typeof s === 'string')) throw new Error('commonPrefix expects an array of strings');
+  if (strs.length === 0) return '';
+  const first = [...strs[0]];
+  let length = first.length;
+  for (const s of strs.slice(1)) {
+    const chars = [...s];
+    let i = 0;
+    while (i < length && i < chars.length && chars[i] === first[i]) i++;
+    length = i;
+  }
+  return first.slice(0, length).join('');
+};
