 };
 
+/**
+ * Inserts a user with its existing id, createdAt and lastLogin, as used by imports.
+ * Applies the same email and fullName checks as createUser.
+ * @param {object} db The database.
+ * @param {User} user The full user to insert.
+ * @returns {User} The inserted user.
+ * @throws {Error} If db is missing, a required field is missing, the id or email is taken, or a field is invalid.
+ */
+exports.restoreUser = (db, user) => {
+  checkDb(db);
+  if (!user.id || !user.createdAt) throw new Error('id and createdAt are required');
+  if (exports.getUser(db, user.id)) throw new Error(`duplicate id: ${user.id}`);
+  if (!user.email.includes('@')) throw new Error(`invalid email: ${user.email}`);
+  if (exports.getUserByEmail(db, user.email)) throw new Error(`duplicate email: ${user.email}`);
+  checkFullName(user.fullName);
+  db.insert('users', toRow(user));
+  return exports.getUser(db, user.id);
+};
+
+/**
+ * Finds a user by id.
+ * @param {object} db The database.
+ * @param {string} id
+ * @returns {?User} The user, or null if none has that id.
+ * @throws {Error} If db is missing.
+ */
 exports.getUser = (db, id) => {
+  checkDb(db);
   const r = db.find('users', (u) => u.id === id);
   if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return fromRow(r);
+};
+
+/**
+ * Finds a user by email, ignoring case.
+ * @param {object} db The database.
+ * @param {string} email
+ * @returns {?User} The user, or null if none has that email.
+ * @throws {Error} If db is missing.
+ */
+exports.getUserByEmail = (db, email) => {
+  checkDb(db);
+  const r = db.find('users', (u) => u.email.toLowerCase() === email.toLowerCase());
+  if (!r) return null;
+  return exports.getUser(db, r.id);
+};
+
+/**
+ * Counts all users.
+ * @param {object} db The database.
+ * @returns {number}
+ * @throws {Error} If db is missing.
+ */
+exports.countUsers = (db) => {
+  checkDb(db);
+  return db.all('users').length;
+};
+
+/**
+ * Changes the email and/or fullName of a user. Fields left undefined are not changed.
+ * @param {object} db The database.
+ * @param {string} id
+ * @param {{email?: string, fullName?: string}} fields
+ * @returns {User} The updated user.
+ * @throws {Error} If db is missing, the user does not exist, or a new email or fullName is invalid or taken.
+ */
+exports.updateUser = (db, id, { email, fullName }) => {
+  checkDb(db);
+  if (!exports.getUser(db, id)) throw new Error(`no user: ${id}`);
+  if (email !== undefined) {
+    if (!email.includes('@')) throw new Error(`invalid email: ${email}`);
+    const other = exports.getUserByEmail(db, email);
+    if (other && other.id !== id) throw new Error(`duplicate email: ${email}`);
+  }
+  if (fullName !== undefined) checkFullName(fullName);
+  db.update('users', (u) => u.id === id, toRow({ email, fullName }));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Finds users whose fullName or email contains the query, ignoring case.
+ * @param {object} db The database.
+ * @param {string} query
+ * @returns {User[]} Matching users, oldest first.
+ * @throws {Error} If db is missing.
+ */
+exports.searchUsers = (db, query) => {
+  checkDb(db);
+  const q = query.toLowerCase();
+  return sortedUsers(db).filter((u) => u.fullName.toLowerCase().includes(q) || u.email.toLowerCase().includes(q));
+};
+
+/**
+ * Removes a user.
+ * @param {object} db The database.
+ * @param {string} id
+ * @returns {boolean} true if a user was removed, false if no user has that id.
+ * @throws {Error} If db is missing.
+ */
+exports.deleteUser = (db, id) => {
+  checkDb(db);
+  return db.delete('users', (u) => u.id === id) > 0;
+};
+
+/**
+ * Sets a user's lastLogin.
+ * @param {object} db The database.
+ * @param {string} id
+ * @param {Date|string} [when=now] A Date or a value Date can parse.
+ * @returns {User} The updated user.
+ * @throws {Error} If db is missing or the user does not exist.
+ */
+exports.recordLogin = (db, id, when = new Date()) => {
+  checkDb(db);
+  if (!exports.getUser(db, id)) throw new Error(`no user: ${id}`);
+  db.update('users', (u) => u.id === id, toRow({ lastLogin: new Date(when).toISOString() }));
+  return exports.getUser(db, id);
+};
+
+const sortedUsers = (db) => {
+  return db.all('users')
+    .sort((a, b) => (a.created_at < b.created_at ? -1 : a.created_at > b.created_at ? 1 : 0))
+    .map(fromRow);
+};
+
+/**
+ * Returns one page of users, oldest first.
+ * @param {object} db The database.
+ * @param {{limit?: number, offset?: number}} [page] Defaults to limit 50, offset 0.
+ * @returns {User[]}
+ * @throws {Error} If db is missing, or limit or offset is not a non-negative integer.
+ */
+exports.listUsers = (db, { limit = 50, offset = 0 } = {}) => {
+  checkDb(db);
+  if (!Number.isInteger(limit) || limit < 0 || !Number.isInteger(offset) || offset < 0) {
+    throw new Error('limit and offset must be non-negative integers');
+  }
+  return sortedUsers(db).slice(offset, offset + limit);
 };
