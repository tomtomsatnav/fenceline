+const test = require('node:test');
+const assert = require('node:assert');
+const { chunk, uniqueBy, groupBy, partition, zip, range, flattenDeep, sortBy, sample, windowed, difference, intersection, rotate, countBy, maxBy } = require('../src/lib/arrays.js');
