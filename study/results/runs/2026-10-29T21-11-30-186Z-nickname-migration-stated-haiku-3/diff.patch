+
+// Maps user fields to column names, keeping only the fields that are set.
+const toRow = (fields) => {
+  const columns = { id: 'id', email: 'email', fullName: 'fullname', nickname: 'nickname', createdAt: 'created_at', lastLogin: 'last_login' };
+  const row = {};
+  for (const [field, column] of Object.entries(columns)) {
+    if (fields[field] !== undefined) row[column] = fields[field];
+  }
+  return row;
+};
+
+const fromRow = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, nickname: r.nickname ?? null, createdAt: r.created_at, lastLogin: r.last_login ?? null });
+
+/**
+ * Creates a user with a new id and the current time as createdAt.
+ * @param {object} db The database.
+ * @param {{email: string, fullName: string}} fields Email must contain "@" and be unique, ignoring case.
+ * @returns {User} The created user.
+ * @throws {Error} If db is missing, the email is invalid or taken, or fullName is invalid.
+ */
+exports.createUser = (db, { email, fullName, nickname }) => {
+  checkDb(db);
+  if (!email.includes('@')) throw new Error(`invalid email: ${email}`);
+  if (exports.getUserByEmail(db, email)) throw new Error(`duplicate email: ${email}`);
