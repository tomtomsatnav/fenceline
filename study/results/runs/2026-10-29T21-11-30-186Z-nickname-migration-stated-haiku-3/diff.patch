+/**
+ * Returns the name to show for a user.
+ * @param {{fullName: ?string, email: string}} user
+ * @returns {string} fullName when it has text, otherwise the part of the email before "@".
+ */
+exports.displayName = (user) => {
+  if (user.fullName && user.fullName.trim() !== '') return user.fullName;
+  return user.email.split('@')[0];
+};
