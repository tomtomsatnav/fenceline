+// Keeps the first item for each key, in their original order. Keys are compared as Map keys do (SameValueZero).
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  if (typeof keyFn !== 'function') throw new TypeError(`Expected a key function, got ${typeof keyFn}`);
+  const seen = new Set();
+  return xs.filter((x) => {
+    const key = keyFn(x);
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+};
+
+// Groups xs into arrays keyed by keyFn(x). Keys are converted to strings, so 1 and '1' share a group.
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  if (typeof keyFn !== 'function') throw new TypeError(`Expected a key function, got ${typeof keyFn}`);
+  const out = {};
+  for (const x of xs) {
+    const key = String(keyFn(x));
+    // defineProperty, not assignment, so a key such as "__proto__" becomes an ordinary group.
+    if (!Object.prototype.hasOwnProperty.call(out, key)) {
+      Object.defineProperty(out, key, { value: [], enumerable: true, writable: true, configurable: true });
+    }
+    out[key].push(x);
+  }
+  return out;
+};
+
+// Splits xs into [items that pred accepts, items it rejects], each in their original order.
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  if (typeof pred !== 'function') throw new TypeError(`Expected a predicate, got ${typeof pred}`);
+  const matching = [];
+  const notMatching = [];
+  for (const x of xs) (pred(x) ? matching : notMatching).push(x);
+  return [matching, notMatching];
+};
+
+// Pairs items from a and b by position, stopping at the shorter array: zip([1, 2, 3], ['a', 'b']) gives [[1, 'a'], [2, 'b']].
+exports.zip = (a, b) => {
+  if (!Array.isArray(a)) throw new TypeError(`Expected an array, got ${typeof a}`);
+  if (!Array.isArray(b)) throw new TypeError(`Expected an array, got ${typeof b}`);
+  const n = Math.min(a.length, b.length);
+  const out = [];
+  for (let i = 0; i < n; i++) out.push([a[i], b[i]]);
+  return out;
+};
+
+// Numbers from start up to but not including end, moving by step (which may be negative or fractional).
+// Returns [] when the range runs the wrong way or is empty.
+exports.range = (start, end, step = 1) => {
+  for (const v of [start, end, step]) {
+    if (typeof v !== 'number') throw new TypeError(`Expected a number, got ${typeof v}`);
+  }
+  if (!Number.isFinite(start) || !Number.isFinite(end) || !Number.isFinite(step)) {
+    throw new RangeError('Expected finite numbers');
+  }
+  if (step === 0) throw new RangeError('Expected a step other than 0');
+  const count = Math.max(0, Math.ceil((end - start) / step));
+  return Array.from({ length: count }, (_, k) => start + k * step);
+};
+
+// Flattens arrays nested to any depth into one array. Non-array items are kept as they are.
+// Throws a TypeError if an array contains itself, since that has no finite flattening.
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  const out = [];
+  const ancestors = new Set();
+  const visit = (arr) => {
+    if (ancestors.has(arr)) throw new TypeError('Cannot flatten an array that contains itself');
+    ancestors.add(arr);
+    for (const x of arr) {
+      if (Array.isArray(x)) visit(x);
+      else out.push(x);
+    }
+    ancestors.delete(arr);
+  };
+  visit(xs);
+  return out;
+};
+
+// Returns a new array of xs sorted by keyFn(x), keeping equal keys in their original order. xs is not changed.
+// Keys are compared with < and >, so they should be numbers, strings or dates. NaN and undefined have no order and throw.
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  if (typeof keyFn !== 'function') throw new TypeError(`Expected a key function, got ${typeof keyFn}`);
+  const keyed = xs.map((x) => {
+    const key = keyFn(x);
+    if (key === undefined || Number.isNaN(key)) throw new TypeError(`Cannot sort by key ${key}`);
+    return { x, key };
+  });
+  keyed.sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0));
+  return keyed.map((k) => k.x);
+};
+
+// Picks one item at random, or undefined for an empty array. rng must return a number in [0, 1), as Math.random does.
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  if (typeof rng !== 'function') throw new TypeError(`Expected a random number function, got ${typeof rng}`);
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new RangeError(`Expected rng to return a number in [0, 1), got ${r}`);
+  return xs[Math.floor(r * xs.length)];
+};
+
+// Every run of n consecutive items, in order: windowed([1, 2, 3], 2) gives [[1, 2], [2, 3]].
+// Returns [] when n is larger than the array.
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  if (!Number.isInteger(n) || n < 1) throw new RangeError(`Expected a positive integer window size, got ${n}`);
+  const out = [];
+  for (let i = 0; i + n <= xs.length; i++) out.push(xs.slice(i, i + n));
+  return out;
+};
+
+// The items of a that are not in b, in their original order. Membership uses SameValueZero (as Set does), so NaN matches NaN.
+// Duplicates in a are all kept if they are absent from b; duplicates in b do not matter. Neither array is changed.
+exports.difference = (a, b) => {
+  if (!Array.isArray(a)) throw new TypeError(`Expected an array, got ${typeof a}`);
+  if (!Array.isArray(b)) throw new TypeError(`Expected an array, got ${typeof b}`);
+  const exclude = new Set(b);
+  return a.filter((x) => !exclude.has(x));
+};
+
+// The distinct items that appear in every array given, in the order they first appear in the first array. Takes any number of
+// arrays: with none, the result is []; with one, it is that array's distinct items. Membership uses SameValueZero (as Set does).
+exports.intersection = (...arrays) => {
+  for (const arr of arrays) {
+    if (!Array.isArray(arr)) throw new TypeError(`Expected arrays, got ${typeof arr}`);
+  }
+  if (arrays.length === 0) return [];
+  const [first, ...rest] = arrays;
+  const others = rest.map((arr) => new Set(arr));
+  const seen = new Set();
+  const out = [];
+  for (const x of first) {
+    if (!seen.has(x) && others.every((s) => s.has(x))) {
+      seen.add(x);
+      out.push(x);
+    }
+  }
+  return out;
+};
+
+// A new array with the items moved k places to the left, so the first k items go to the end. A negative k rotates right.
+// k may be larger than the length, and wraps around. xs is not changed.
+exports.rotate = (xs, k) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  if (!Number.isInteger(k)) throw new RangeError(`Expected an integer rotation, got ${k}`);
+  const n = xs.length;
+  if (n === 0) return [];
+  const shift = ((k % n) + n) % n;
+  return [...xs.slice(shift), ...xs.slice(0, shift)];
+};
+
+// How many items share each key, as an object of counts keyed by keyFn(x). Keys are converted to strings, as in groupBy.
+exports.countBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  if (typeof keyFn !== 'function') throw new TypeError(`Expected a key function, got ${typeof keyFn}`);
+  const out = {};
+  for (const x of xs) {
+    const key = String(keyFn(x));
+    const count = Object.prototype.hasOwnProperty.call(out, key) ? out[key] : 0;
+    // defineProperty, not assignment, so a key such as "__proto__" becomes an ordinary count.
+    Object.defineProperty(out, key, { value: count + 1, enumerable: true, writable: true, configurable: true });
+  }
+  return out;
+};
+
+// The item whose key is largest, or undefined for an empty array. On a tie the first such item wins. Keys are compared with > and <,
+// so they should be numbers, strings or dates. NaN and undefined keys have no order and throw, as in sortBy. xs is not changed.
+exports.maxBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  if (typeof keyFn !== 'function') throw new TypeError(`Expected a key function, got ${typeof keyFn}`);
+  let best;
+  let bestKey;
+  let found = false;
+  for (const x of xs) {
+    const key = keyFn(x);
+    if (key === undefined || Number.isNaN(key)) throw new TypeError(`Cannot compare key ${key}`);
+    if (!found || key > bestKey) {
+      best = x;
+      bestKey = key;
+      found = true;
+    }
+  }
+  return best;
+};
+
+// Splits xs into arrays of length n. The last chunk may be shorter. The input is not changed.
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  if (!Number.isInteger(n) || n < 1) throw new RangeError(`Expected a positive integer chunk size, got ${n}`);
+  const out = [];
+  for (let i = 0; i < xs.length; i += n) out.push(xs.slice(i, i + n));
+  return out;
+};
