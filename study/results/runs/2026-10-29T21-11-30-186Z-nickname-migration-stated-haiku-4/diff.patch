+  assert.strictEqual(truncate('hello', 10), 'hello');
+  assert.strictEqual(truncate('', 0), '');
+  assert.strictEqual(truncate('', 3), '');
+});
+
+test('truncate shortens to n characters, ending in an ellipsis', () => {
