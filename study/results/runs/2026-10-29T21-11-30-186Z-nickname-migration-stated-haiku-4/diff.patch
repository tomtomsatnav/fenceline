+});
+
+test('commonPrefix does not change its input', () => {
+  const xs = ['flower', 'flow'];
+  commonPrefix(xs);
+  assert.deepStrictEqual(xs, ['flower', 'flow']);
+});
+
+test('commonPrefix throws a TypeError for a non-array or a non-string element', () => {
+  assert.throws(() => commonPrefix('abc'), TypeError);
+  assert.throws(() => commonPrefix(['ok', 3]), TypeError);
+});
+
+test('padCenter throws for bad input', () => {
+  assert.throws(() => padCenter(null, 5), TypeError);
+  assert.throws(() => padCenter('hi', -1), RangeError);
+  assert.throws(() => padCenter('hi', 5.5), RangeError);
