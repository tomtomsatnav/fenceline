+// True when s has at least 12 characters (counted as code points), and at least one each of a lower-case letter, an upper-case
+// letter, a digit and a symbol. Letters and digits include non-ASCII ones; a symbol is punctuation or a symbol character,
+// so a space does not count as one. This is a minimum check: it sets no maximum length and does not look for common passwords.
+exports.isStrongPassword = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  if (Array.from(s).length < 12) return false;
+  return /\p{Ll}/u.test(s) && /\p{Lu}/u.test(s) && /\p{Nd}/u.test(s) && /[\p{P}\p{S}]/u.test(s);
+};
