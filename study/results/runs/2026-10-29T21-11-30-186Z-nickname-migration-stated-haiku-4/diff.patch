+  assert.strictEqual(ageOn(birth, new Date('2024-06-15T12:00:00Z')), 24);
+});
+
+test('ageOn ignores the time of day, using UTC dates', () => {
+  const birth = new Date('2000-06-15T23:00:00Z');
+  assert.strictEqual(ageOn(birth, new Date('2001-06-15T00:30:00Z')), 1);
+  assert.strictEqual(ageOn(birth, new Date('2001-06-14T23:30:00Z')), 0);
+});
+
+test('ageOn treats a 29 February birthday as reached on 1 March in non-leap years', () => {
+  const birth = new Date('2000-02-29T00:00:00Z');
+  assert.strictEqual(ageOn(birth, new Date('2023-02-28T00:00:00Z')), 22);
+  assert.strictEqual(ageOn(birth, new Date('2023-03-01T00:00:00Z')), 23);
+  assert.strictEqual(ageOn(birth, new Date('2024-02-28T00:00:00Z')), 23);
+  assert.strictEqual(ageOn(birth, new Date('2024-02-29T00:00:00Z')), 24);
+});
+
+test('ageOn is 0 for a newborn on the same day, and handles year boundaries', () => {
+  assert.strictEqual(ageOn(new Date('2024-12-31T00:00:00Z'), new Date('2024-12-31T00:00:00Z')), 0);
+  assert.strictEqual(ageOn(new Date('1999-12-31T00:00:00Z'), new Date('2000-01-01T00:00:00Z')), 0);
+});
+
+test('ageOn throws for a birth date after the date, an invalid Date, or a non-Date', () => {
+  assert.throws(() => ageOn(new Date('2024-06-16T00:00:00Z'), new Date('2024-06-15T00:00:00Z')), RangeError);
+  assert.throws(() => ageOn(new Date('not a date'), new Date()), RangeError);
+  assert.throws(() => ageOn('2000-06-15', new Date()), TypeError);
+});
+
+const NOW = new Date('2024-03-10T12:00:00Z');
+const ago = (ms) => new Date(NOW.getTime() - ms);
+const ahead = (ms) => new Date(NOW.getTime() + ms);
+
+test('relativeTime says "ago" for past dates and "in" for future dates', () => {
+  assert.strictEqual(relativeTime(ago(3 * 60000), NOW), '3 minutes ago');
+  assert.strictEqual(relativeTime(ahead(2 * 86400000), NOW), 'in 2 days');
+});
+
+test('relativeTime uses singular units for one', () => {
+  assert.strictEqual(relativeTime(ago(60000), NOW), '1 minute ago');
+  assert.strictEqual(relativeTime(ahead(3600000), NOW), 'in 1 hour');
+});
+
+test('relativeTime picks the largest unit and counts whole units', () => {
+  assert.strictEqual(relativeTime(ago(59000), NOW), '59 seconds ago');
+  assert.strictEqual(relativeTime(ago(60000 * 59 + 59000), NOW), '59 minutes ago');
+  assert.strictEqual(relativeTime(ago(3600000 * 23 + 3500000), NOW), '23 hours ago');
+  assert.strictEqual(relativeTime(ago(86400000 * 29), NOW), '29 days ago');
+});
+
+test('relativeTime moves to months after 30 days and years after 365 days', () => {
+  assert.strictEqual(relativeTime(ago(86400000 * 30), NOW), '1 month ago');
+  assert.strictEqual(relativeTime(ahead(86400000 * 90), NOW), 'in 3 months');
+  assert.strictEqual(relativeTime(ago(86400000 * 365), NOW), '1 year ago');
+  assert.strictEqual(relativeTime(ahead(86400000 * 800), NOW), 'in 2 years');
+});
+
+test('relativeTime says "just now" when less than a second apart, in either direction', () => {
+  assert.strictEqual(relativeTime(NOW, NOW), 'just now');
+  assert.strictEqual(relativeTime(ago(999), NOW), 'just now');
+  assert.strictEqual(relativeTime(ahead(500), NOW), 'just now');
+});
+
+test('relativeTime defaults now to the current time', () => {
+  assert.strictEqual(relativeTime(new Date(Date.now() - 5 * 60000)), '5 minutes ago');
+});
+
+test('relativeTime throws for a non-Date or an invalid Date', () => {
+  assert.throws(() => relativeTime('2024-03-10', NOW), TypeError);
+  assert.throws(() => relativeTime(new Date('not a date'), NOW), RangeError);
+  assert.throws(() => relativeTime(NOW, new Date('not a date')), RangeError);
+});
+
+test('isLeapYear is true for ordinary years divisible by 4', () => {
+  assert.strictEqual(isLeapYear(2024), true);
+  assert.strictEqual(isLeapYear(2020), true);
+  assert.strictEqual(isLeapYear(1996), true);
+});
+
+test('isLeapYear is false for ordinary years not divisible by 4', () => {
+  assert.strictEqual(isLeapYear(2023), false);
+  assert.strictEqual(isLeapYear(2025), false);
+  assert.strictEqual(isLeapYear(1999), false);
+});
+
+test('isLeapYear is false for century years not divisible by 400, and true for those that are', () => {
+  assert.strictEqual(isLeapYear(1900), false);
+  assert.strictEqual(isLeapYear(2100), false);
+  assert.strictEqual(isLeapYear(2000), true);
+  assert.strictEqual(isLeapYear(2400), true);
+});
+
+test('isLeapYear handles year 0 and negative years with the same rule', () => {
+  assert.strictEqual(isLeapYear(0), true);
+  assert.strictEqual(isLeapYear(-4), true);
+  assert.strictEqual(isLeapYear(-100), false);
+  assert.strictEqual(isLeapYear(-400), true);
+  assert.strictEqual(isLeapYear(-1), false);
+});
+
+test('isLeapYear throws a RangeError for a fractional or non-finite year and a TypeError for a non-number', () => {
+  assert.throws(() => isLeapYear(2024.5), RangeError);
+  assert.throws(() => isLeapYear(NaN), RangeError);
+  assert.throws(() => isLeapYear(Infinity), RangeError);
+  assert.throws(() => isLeapYear('2024'), TypeError);
+  assert.throws(() => isLeapYear(null), TypeError);
+});
+
+test('daysInMonth gives the length of each month in a common year', () => {
