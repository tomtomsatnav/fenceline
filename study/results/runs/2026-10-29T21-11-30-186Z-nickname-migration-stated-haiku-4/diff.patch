+  assert.throws(() => levenshtein('a', 3), TypeError);
+});
+
+test('commonPrefix finds the longest prefix shared by every string', () => {
+  assert.strictEqual(commonPrefix(['flower', 'flow', 'flight']), 'fl');
+  assert.strictEqual(commonPrefix(['interview', 'interrupt', 'intern']), 'inter');
+  assert.strictEqual(commonPrefix(['prefix-a', 'prefix-b']), 'prefix-');
+});
+
+test('commonPrefix is empty when the strings share no first character', () => {
+  assert.strictEqual(commonPrefix(['dog', 'racecar', 'car']), '');
+});
+
+test('commonPrefix of a single string is that string, and of an empty array is empty', () => {
+  assert.strictEqual(commonPrefix(['alone']), 'alone');
+  assert.strictEqual(commonPrefix([]), '');
+});
+
+test('commonPrefix is the whole string when all strings are equal, and empty when one is empty', () => {
+  assert.strictEqual(commonPrefix(['same', 'same', 'same']), 'same');
+  assert.strictEqual(commonPrefix(['', 'abc']), '');
+  assert.strictEqual(commonPrefix(['abc', '']), '');
+});
+
+test('commonPrefix stops at the shorter string when one is a prefix of the others', () => {
+  assert.strictEqual(commonPrefix(['ab', 'abc', 'abcd']), 'ab');
+});
+
+test('commonPrefix is case-sensitive and does not split an emoji', () => {
+  assert.strictEqual(commonPrefix(['Apple', 'apple']), '');
+  assert.strictEqual(commonPrefix(['a😀x', 'a😀y']), 'a😀');
