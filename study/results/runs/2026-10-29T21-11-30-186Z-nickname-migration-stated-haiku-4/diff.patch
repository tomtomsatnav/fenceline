+/**
+ * Name to show for a user: the full name, or the part of the email before "@" when the name is empty.
+ * @param {{ email: string, fullName: string | null | undefined }} user
+ * @returns {string}
+ */
+exports.displayName = (user) => {
+  if (user.fullName && user.fullName.trim() !== '') return user.fullName;
+  return user.email.split('@')[0];
+};
