+  if (!m) return false;
+  const outward = m[1].toUpperCase();
+  const inward = m[2].toUpperCase();
+  if (outward === 'GIR' && inward === '0AA') return true;
+  return UK_OUTWARD.test(outward) && UK_INWARD.test(inward);
+};
+
+// A small set of common ISO 4217 currency codes. It is not the full list.
+const COMMON_CURRENCIES = new Set([
+  'USD', 'EUR', 'GBP', 'JPY', 'CHF', 'CAD', 'AUD', 'NZD', 'CNY', 'INR', 'SEK',
+  'NOK', 'DKK', 'PLN', 'CZK', 'HUF', 'BRL', 'MXN', 'SGD', 'HKD', 'KRW', 'ZAR',
+]);
+
+// True for a three-letter upper-case code from the COMMON_CURRENCIES list, such as "EUR". Codes outside the list are rejected,
+// even if they are valid ISO 4217 codes, and so are lower case letters, spaces and other lengths.
+exports.isIsoCurrency = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  return COMMON_CURRENCIES.has(s);
+};
+
+// True for a hex colour in the short #rgb or long #rrggbb form, in either letter case. The alpha forms (#rgba, #rrggbbaa),
+// names such as "red", and anything with a missing "#", spaces or other lengths are rejected.
+exports.isHexColor = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  return /^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i.test(s);
+};
+
+// True for a dotted-quad IPv4 address such as "192.168.0.1": exactly four parts, each 0 to 255 written without leading zeros.
+// Ports, CIDR suffixes, IPv6 addresses and surrounding whitespace are rejected.
+exports.isIPv4 = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  const parts = s.split('.');
+  return parts.length === 4 && parts.every((p) => /^(0|[1-9]\d{0,2})$/.test(p) && Number(p) <= 255);
+};
+
+// A semantic version as defined by semver.org: MAJOR.MINOR.PATCH with no leading zeros, an optional pre-release after "-" and
+// optional build metadata after "+". Numeric pre-release identifiers may not have leading zeros; build metadata may.
+const SEMVER =
+  /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\+([0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*))?$/;
+
+// True for a semantic version such as "1.2.3", "1.2.3-beta.1" or "1.2.3+build.5". A leading "v", a missing part, or a leading
+// zero in a core number (such as "01.2.3") is rejected.
+exports.isSemver = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  return SEMVER.test(s);
+};
+
+// The exact IBAN length for some common countries. A country not listed here is rejected, since its length cannot be checked.
+const IBAN_LENGTHS = new Map([
+  ['AT', 20], ['BE', 16], ['CH', 21], ['DE', 22], ['DK', 18], ['ES', 24], ['FR', 27], ['GB', 22], ['IE', 22],
+  ['IT', 27], ['NL', 18], ['NO', 15], ['PL', 28], ['PT', 25], ['SE', 24],
+]);
+
+// True for an IBAN in its compact form, such as "GB82WEST12345698765432": a country code from the list above with the exact length
+// for that country, two check digits, and an alphanumeric rest, passing the mod-97 check (the remainder must be 1). Letters are
+// accepted in either case. Spaces are not stripped, so a printed IBAN with groups must be compacted first.
+exports.isIban = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  const iban = s.toUpperCase();
+  if (!/^[A-Z]{2}\d{2}[A-Z0-9]+$/.test(iban)) return false;
+  if (iban.length !== IBAN_LENGTHS.get(iban.slice(0, 2))) return false;
+  // Move the country code and check digits to the end, then read the rest as digits, with A = 10 through Z = 35, and take the
+  // value mod 97 one digit at a time so that no large number is ever built.
+  const rearranged = iban.slice(4) + iban.slice(0, 4);
+  let remainder = 0;
+  for (const ch of rearranged) {
+    const digits = /[A-Z]/.test(ch) ? String(ch.charCodeAt(0) - 55) : ch;
+    for (const d of digits) remainder = (remainder * 10 + Number(d)) % 97;
+  }
+  return remainder === 1;
+};
+
+// True when a string of digits passes the Luhn check used for card numbers: from the right, double every second digit (subtracting
+// 9 from any result above 9), and the total must be a multiple of 10. The string must be at least two digits and contain only
+// digits, so spaces and dashes are rejected. The length is not limited to card lengths, and the check does not identify a card network.
+exports.isCreditCardLuhn = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  if (!/^\d{2,}$/.test(s)) return false;
+  let sum = 0;
+  for (let i = s.length - 1, double = false; i >= 0; i--, double = !double) {
+    let d = Number(s[i]);
+    if (double) {
+      d *= 2;
+      if (d > 9) d -= 9;
+    }
+    sum += d;
+  }
+  return sum % 10 === 0;
+};
+
+// 8-4-4-4-12 hex digits; the version nibble is 1 to 5 and the variant nibble is 8, 9, a or b (the RFC 4122 variant).
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+// True for an RFC 4122 UUID in its usual 8-4-4-4-12 form, of versions 1 to 5, in either letter case.
+// The nil UUID (all zeros) and the max UUID (all ones) are not versioned UUIDs, so they are rejected.
+// Braces, a "urn:uuid:" prefix and missing hyphens are rejected too.
+exports.isUuid = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  return UUID.test(s);
+};
+
+// Local part: dot-separated runs of ordinary address characters, so no leading, trailing or doubled dots.
+const LOCAL_PART = /^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*$/;
+// One domain label: letters and digits, with hyphens allowed inside but not at either end.
+const DOMAIN_LABEL = /^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$/;
+
+// A reasonable check, not a full RFC 5322 parser: exactly one "@", ASCII only, no spaces, a local part of at most 64
+// characters, and a domain with at least two labels whose last label is letters only (such as "com").
+// Addresses that are valid but unusual (quoted local parts, internationalised domains) are rejected.
+exports.isEmail = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  if (s.length > 254) return false;
+  const parts = s.split('@');
+  if (parts.length !== 2) return false;
+  const [local, domain] = parts;
+  if (local.length === 0 || local.length > 64 || !LOCAL_PART.test(local)) return false;
+  const labels = domain.split('.');
+  if (labels.length < 2 || !labels.every((label) => DOMAIN_LABEL.test(label))) return false;
+  return /^[A-Za-z]{2,}$/.test(labels[labels.length - 1]);
+};
diff --git a/test/export.test.js b/test/export.test.js
new file mode 100644
index 0000000..5dc1c74
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,61 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { createUser, recordLogin, getUser, countUsers } = require('../src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+test('exports a header row and one row per user', () => {
+  const db = migrate(new Db());
+  const ada = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  db.tables.users.rows[0].created_at = '2024-01-01T00:00:00.000Z';
+  recordLogin(db, ada.id, '2024-02-01T00:00:00.000Z');
+  assert.strictEqual(
+    exportUsersCsv(db),
+    `id,email,fullName,createdAt,lastLogin\n${ada.id},ada@example.com,Ada Lovelace,2024-01-01T00:00:00.000Z,2024-02-01T00:00:00.000Z\n`,
+  );
+});
+
+test('quotes fields with commas, quotes or line breaks', () => {
+  const db = migrate(new Db());
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Lovelace, "Ada"\nKing' });
+  db.tables.users.rows[0].created_at = '2024-01-01T00:00:00.000Z';
+  assert.strictEqual(
+    exportUsersCsv(db),
+    `id,email,fullName,createdAt,lastLogin\n${u.id},ada@example.com,"Lovelace, ""Ada""\nKing",2024-01-01T00:00:00.000Z,\n`,
+  );
+});
+
+test('exports only the header when there are no users', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), 'id,email,fullName,createdAt,lastLogin\n');
+});
+
+test('importing an export into a new database round-trips', () => {
+  const db = migrate(new Db());
+  const ada = createUser(db, { email: 'ada@example.com', fullName: 'Lovelace, "Ada"\nKing' });
+  const alan = createUser(db, { email: 'alan@example.com', fullName: 'Alan Turing' });
+  db.tables.users.rows[0].created_at = '2024-01-01T00:00:00.000Z';
+  db.tables.users.rows[1].created_at = '2024-01-02T00:00:00.000Z';
+  recordLogin(db, ada.id, '2024-02-01T00:00:00.000Z');
+  const csv = exportUsersCsv(db);
+
+  const copy = migrate(new Db());
+  assert.strictEqual(importUsersCsv(copy, csv), 2);
+  assert.strictEqual(exportUsersCsv(copy), csv);
+  assert.strictEqual(getUser(copy, ada.id).fullName, 'Lovelace, "Ada"\nKing');
+  assert.strictEqual(getUser(copy, alan.id).lastLogin, null);
+});
+
+test('a failed import removes the users it added', () => {
+  const db = migrate(new Db());
+  createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  const csv = exportUsersCsv(db);
+  assert.throws(() => importUsersCsv(db, csv), Error);
+  assert.strictEqual(countUsers(db), 1);
+});
+
+test('exports every user, not just the first page', () => {
+  const db = migrate(new Db());
+  for (let i = 0; i < 51; i++) createUser(db, { email: `user${i}@example.com`, fullName: `User ${i}` });
+  assert.strictEqual(exportUsersCsv(db).trim().split('\n').length, 52);
+});
