+const isPlainObject = (v) => {
+  if (v === null || typeof v !== 'object' || Array.isArray(v)) return false;
+  const proto = Object.getPrototypeOf(v);
+  return proto === Object.prototype || proto === null;
+};
+
+// Only the value types deepEqual understands: null, undefined, numbers, strings, booleans, arrays and plain objects.
+const assertSupported = (v) => {
+  const t = typeof v;
+  if (v === null || t === 'undefined' || t === 'number' || t === 'string' || t === 'boolean') return;
+  if (Array.isArray(v) || isPlainObject(v)) return;
+  throw new TypeError(`deepEqual does not support ${t === 'object' ? 'this kind of object' : t}`);
+};
+
+// Pairs of objects already being compared. Meeting a pair again means a cycle, so it is treated as equal rather than looping forever.
+const equalValues = (a, b, inProgress) => {
+  assertSupported(a);
+  assertSupported(b);
+  if (a === b || (Number.isNaN(a) && Number.isNaN(b))) return true;
+  if (a === null || b === null || typeof a !== 'object' || typeof b !== 'object') return false;
+  if (Array.isArray(a) !== Array.isArray(b)) return false;
+  if (!inProgress.has(a)) inProgress.set(a, new Set());
+  if (inProgress.get(a).has(b)) return true;
+  inProgress.get(a).add(b);
+  if (Array.isArray(a)) {
+    return a.length === b.length && a.every((x, i) => equalValues(x, b[i], inProgress));
+  }
+  const keys = Object.keys(a);
+  if (keys.length !== Object.keys(b).length) return false;
+  return keys.every((k) => Object.prototype.hasOwnProperty.call(b, k) && equalValues(a[k], b[k], inProgress));
+};
+
+// True when a and b have the same structure and values: arrays by position, plain objects by their own enumerable keys.
+// NaN equals NaN, and 0 equals -0. Functions, Dates, Maps, class instances and other kinds of value throw a TypeError.
+exports.deepEqual = (a, b) => equalValues(a, b, new Map());
+
+const cloneValue = (v, copies) => {
+  assertSupported(v);
+  if (v === null || typeof v !== 'object') return v;
+  if (copies.has(v)) return copies.get(v);
+  if (Array.isArray(v)) {
+    const out = new Array(v.length);
+    copies.set(v, out);
+    for (let i = 0; i < v.length; i++) out[i] = cloneValue(v[i], copies);
+    return out;
+  }
+  const out = Object.create(Object.getPrototypeOf(v));
