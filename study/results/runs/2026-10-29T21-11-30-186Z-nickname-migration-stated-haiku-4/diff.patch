+// Moves the decimal point of x by p places, working on the decimal digits so that 1.005 is not nudged below the half.
+const shiftPoint = (x, p) => {
+  const [mantissa, exponent = '0'] = String(x).split('e');
+  return Number(`${mantissa}e${Number(exponent) + p}`);
+};
+
+// Rounds x to the given number of decimal places, with halves going away from zero: roundTo(2.5, 0) is 3, roundTo(-2.5, 0) is -3.
+// A negative places rounds to tens, hundreds and so on. Infinite and NaN values are returned unchanged.
+exports.roundTo = (x, places) => {
+  if (typeof x !== 'number') throw new TypeError(`Expected a number, got ${typeof x}`);
+  if (!Number.isInteger(places)) throw new RangeError(`Expected an integer number of places, got ${places}`);
+  if (!Number.isFinite(x)) return x;
+  const sign = x < 0 ? -1 : 1;
+  const rounded = shiftPoint(Math.round(shiftPoint(Math.abs(x), places)), -places);
+  return rounded === 0 ? 0 : sign * rounded;
+};
+
+// Arithmetic mean of an array of numbers, or NaN for an empty array. Any NaN item makes the result NaN.
+exports.mean = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  for (const x of xs) {
+    if (typeof x !== 'number') throw new TypeError(`Expected numbers, got ${typeof x}`);
+  }
+  if (xs.length === 0) return NaN;
+  return xs.reduce((sum, x) => sum + x, 0) / xs.length;
+};
+
+// Middle value of an array of numbers, or NaN for an empty array. For an even count, the mean of the two middle values.
+// Sorts a copy, so xs is not changed. Any NaN item makes the result NaN.
+exports.median = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  for (const x of xs) {
+    if (typeof x !== 'number') throw new TypeError(`Expected numbers, got ${typeof x}`);
+  }
+  if (xs.length === 0 || xs.some(Number.isNaN)) return NaN;
+  const sorted = xs.slice().sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+  const mid = sorted.length / 2;
+  return Number.isInteger(mid) ? (sorted[mid - 1] + sorted[mid]) / 2 : sorted[Math.floor(mid)];
+};
+
+// The value p percent of the way through the sorted numbers, interpolating linearly between neighbours
+// (so percentile(xs, 50) matches median). p must be between 0 and 100. Empty input gives NaN; xs is not changed.
+exports.percentile = (xs, p) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  if (typeof p !== 'number') throw new TypeError(`Expected a number percentile, got ${typeof p}`);
+  if (!(p >= 0 && p <= 100)) throw new RangeError(`Expected a percentile between 0 and 100, got ${p}`);
+  for (const x of xs) {
+    if (typeof x !== 'number') throw new TypeError(`Expected numbers, got ${typeof x}`);
+  }
+  if (xs.length === 0 || xs.some(Number.isNaN)) return NaN;
+  const sorted = xs.slice().sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+  const rank = (p / 100) * (sorted.length - 1);
+  const lo = Math.floor(rank);
+  const hi = Math.ceil(rank);
+  if (lo === hi) return sorted[lo];
+  return sorted[lo] + (sorted[hi] - sorted[lo]) * (rank - lo);
+};
+
+// Human-readable size using powers of 1024: formatBytes(1536) is "1.5 KB". Whole bytes have no decimals; larger units keep one.
+// Rounding never leaves a value of 1024 in a unit: 1023.96 KB is shown as "1 MB".
+exports.formatBytes = (n) => {
+  if (typeof n !== 'number') throw new TypeError(`Expected a number, got ${typeof n}`);
+  if (!Number.isFinite(n) || n < 0) throw new RangeError(`Expected a finite, non-negative byte count, got ${n}`);
+  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
+  let i = 0;
+  let v = n;
+  while (v >= 1024 && i < units.length - 1) {
+    v /= 1024;
+    i++;
+  }
+  let r = i === 0 ? exports.roundTo(v, 0) : exports.roundTo(v, 1);
+  if (r >= 1024 && i < units.length - 1) {
+    i++;
+    r = exports.roundTo(v / 1024, 1);
+  }
+  return `${r} ${units[i]}`;
+};
+
+// True for prime integers. Anything that is not an integer greater than 1 (fractions, negatives, 0, 1, NaN, Infinity) is false.
+exports.isPrime = (n) => {
+  if (typeof n !== 'number') throw new TypeError(`Expected a number, got ${typeof n}`);
+  if (!Number.isInteger(n) || n < 2) return false;
+  if (n % 2 === 0) return n === 2;
+  for (let d = 3; d * d <= n; d += 2) {
+    if (n % d === 0) return false;
+  }
+  return true;
+};
+
+// Greatest common divisor of two integers, always non-negative. gcd(0, 0) is 0, and gcd(0, n) is |n|.
+exports.gcd = (a, b) => {
+  for (const v of [a, b]) {
+    if (typeof v !== 'number') throw new TypeError(`Expected a number, got ${typeof v}`);
+    if (!Number.isInteger(v)) throw new RangeError(`Expected an integer, got ${v}`);
+  }
+  let x = Math.abs(a);
+  let y = Math.abs(b);
+  while (y !== 0) [x, y] = [y, x % y];
+  return x;
+};
+
+// Roman numeral for an integer from 1 to 3999. Anything else (including 0, fractions and NaN) throws a RangeError.
+exports.toRoman = (n) => {
+  if (typeof n !== 'number') throw new TypeError(`Expected a number, got ${typeof n}`);
+  if (!Number.isInteger(n) || n < 1 || n > 3999) throw new RangeError(`Expected an integer from 1 to 3999, got ${n}`);
+  const table = [
+    [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'],
+    [100, 'C'], [90, 'XC'], [50, 'L'], [40, 'XL'],
+    [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
+  ];
+  let rest = n;
+  let out = '';
+  for (const [value, symbol] of table) {
+    while (rest >= value) {
+      out += symbol;
+      rest -= value;
+    }
+  }
+  return out;
+};
+
+// Integer value of a Roman numeral, the inverse of toRoman. Only the standard form is accepted: "IIII" and "IC" throw,
+// because toRoman never writes them. Throws an Error for anything that is not a canonical numeral from I to MMMCMXCIX.
+exports.fromRoman = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  const values = { I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000 };
+  let total = 0;
+  for (let i = 0; i < s.length; i++) {
+    const v = values[s[i]];
+    if (v === undefined) throw new Error(`Invalid Roman numeral: ${s}`);
+    const next = values[s[i + 1]];
+    total += next > v ? -v : v;
+  }
+  if (total < 1 || total > 3999 || exports.toRoman(total) !== s) throw new Error(`Invalid Roman numeral: ${s}`);
+  return total;
+};
+
+// The point t of the way from a to b: lerp(a, b, 0) is a, lerp(a, b, 1) is b, and 0.5 is the midpoint. t is not clamped, so
+// values outside 0 to 1 extrapolate. Written as (1 - t) * a + t * b so that both ends come out exact. a, b and t must be finite numbers.
+exports.lerp = (a, b, t) => {
+  for (const v of [a, b, t]) {
+    if (typeof v !== 'number') throw new TypeError(`Expected a number, got ${typeof v}`);
+    if (!Number.isFinite(v)) throw new RangeError(`Expected finite numbers, got ${v}`);
+  }
+  return (1 - t) * a + t * b;
+};
+
+// Population standard deviation: the square root of the mean squared distance from the mean. Divides by the count, not count - 1,
+// so it describes exactly these numbers. Empty input gives NaN, and xs is not changed. Input is checked as in mean.
+exports.stdDev = (xs) => {
+  const m = exports.mean(xs);
+  if (Number.isNaN(m)) return NaN;
+  return Math.sqrt(xs.reduce((sum, x) => sum + (x - m) ** 2, 0) / xs.length);
+};
+
+// The nth Fibonacci number as a BigInt, so large values stay exact: fibonacci(0) is 0n, fibonacci(1) is 1n, fibonacci(10) is 55n.
+// n must be an integer from 0 to 1000. Anything else throws: a non-number a TypeError, and a bad or out-of-range integer a RangeError.
+exports.fibonacci = (n) => {
+  if (typeof n !== 'number') throw new TypeError(`Expected a number, got ${typeof n}`);
+  if (!Number.isInteger(n) || n < 0 || n > 1000) throw new RangeError(`Expected an integer from 0 to 1000, got ${n}`);
+  let a = 0n;
+  let b = 1n;
+  for (let i = 0; i < n; i++) [a, b] = [b, a + b];
+  return a;
+};
+
+// English ordinal for a whole number: 1 is "1st", 2 "2nd", 3 "3rd", 4 "4th", 11 "11th", 12 "12th", 13 "13th", 21 "21st", 111 "111th".
+// The teens (11, 12, 13 and those ending in them, such as 111) always take "th". n must be an integer of 0 or more.
+exports.toOrdinal = (n) => {
+  if (typeof n !== 'number') throw new TypeError(`Expected a number, got ${typeof n}`);
+  if (!Number.isInteger(n) || n < 0) throw new RangeError(`Expected a whole number of 0 or more, got ${n}`);
+  const lastTwo = n % 100;
+  if (lastTwo >= 11 && lastTwo <= 13) return `${n}th`;
+  const suffix = { 1: 'st', 2: 'nd', 3: 'rd' }[n % 10] ?? 'th';
+  return `${n}${suffix}`;
+};
+
+// Seconds in a duration string such as "1h30m" (5400) or "2d4h". Units are d, h, m and s, each at most once and largest first,
+// with whole numbers only. Anything else, including "" and spaces, throws a RangeError. A non-string throws a TypeError.
+exports.parseDuration = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  const m = /^(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/.exec(s);
+  if (!m || s === '') throw new RangeError(`Expected a duration such as "1h30m", got "${s}"`);
+  const [days, hours, minutes, seconds] = m.slice(1).map((v) => Number(v ?? 0));
+  const total = days * 86400 + hours * 3600 + minutes * 60 + seconds;
+  if (!Number.isSafeInteger(total)) throw new RangeError(`Duration is too large: "${s}"`);
+  return total;
+};
+
+// Limits x to the range [lo, hi]. Infinite bounds are allowed; NaN and a lo greater than hi are not.
+exports.clamp = (x, lo, hi) => {
+  for (const v of [x, lo, hi]) {
+    if (typeof v !== 'number') throw new TypeError(`Expected a number, got ${typeof v}`);
+    if (Number.isNaN(v)) throw new RangeError('Expected a number that is not NaN');
+  }
+  if (lo > hi) throw new RangeError(`Expected lo <= hi, got lo=${lo} and hi=${hi}`);
+  return Math.min(Math.max(x, lo), hi);
+};
