+
+test('reverseWords reverses the order of words', () => {
+  assert.strictEqual(reverseWords('hello world'), 'world hello');
+  assert.strictEqual(reverseWords('one two three'), 'three two one');
+});
+
+test('reverseWords returns a single word unchanged', () => {
+  assert.strictEqual(reverseWords('hello'), 'hello');
+});
+
+test('reverseWords collapses extra whitespace to single spaces', () => {
+  assert.strictEqual(reverseWords('  hello \t  world\n'), 'world hello');
+});
+
+test('reverseWords keeps punctuation with its word', () => {
+  assert.strictEqual(reverseWords('Hello, big world!'), 'world! big Hello,');
+});
+
+test('reverseWords returns an empty string for empty or blank input', () => {
+  assert.strictEqual(reverseWords(''), '');
+  assert.strictEqual(reverseWords('   \n '), '');
+});
+
+test('reverseWords throws a TypeError for non-strings', () => {
+  assert.throws(() => reverseWords(null), TypeError);
+});
+
+test('isPalindrome is true for words and phrases that read the same both ways', () => {
+  assert.strictEqual(isPalindrome('racecar'), true);
+  assert.strictEqual(isPalindrome('A man, a plan, a canal: Panama'), true);
+  assert.strictEqual(isPalindrome('Was it a car or a cat I saw?'), true);
+  assert.strictEqual(isPalindrome('12321'), true);
+});
+
+test('isPalindrome is false when the reversed text differs', () => {
+  assert.strictEqual(isPalindrome('hello'), false);
+  assert.strictEqual(isPalindrome('ab'), false);
+  assert.strictEqual(isPalindrome('race a car'), false);
+});
+
+test('isPalindrome treats empty and punctuation-only strings as palindromes', () => {
+  assert.strictEqual(isPalindrome(''), true);
+  assert.strictEqual(isPalindrome('   '), true);
+  assert.strictEqual(isPalindrome('...!?'), true);
+  assert.strictEqual(isPalindrome('x'), true);
