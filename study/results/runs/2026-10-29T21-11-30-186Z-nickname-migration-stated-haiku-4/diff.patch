+
+test('levenshtein counts single-character insertions, deletions and substitutions', () => {
+  assert.strictEqual(levenshtein('kitten', 'sitting'), 3);
+  assert.strictEqual(levenshtein('flaw', 'lawn'), 2);
+  assert.strictEqual(levenshtein('abc', 'abd'), 1); // substitution
+  assert.strictEqual(levenshtein('abc', 'abcd'), 1); // insertion
+  assert.strictEqual(levenshtein('abcd', 'abc'), 1); // deletion
+});
+
+test('levenshtein is 0 for identical strings and the length of the other for an empty string', () => {
+  assert.strictEqual(levenshtein('same', 'same'), 0);
+  assert.strictEqual(levenshtein('', ''), 0);
+  assert.strictEqual(levenshtein('', 'four'), 4);
+  assert.strictEqual(levenshtein('four', ''), 4);
+});
+
+test('levenshtein is symmetric', () => {
