+  assert.strictEqual(template('', {}), '');
+});
+
+test('template throws for bad input', () => {
+  assert.throws(() => template(null, {}), TypeError);
+  assert.throws(() => template('Hi {name}', null), TypeError);
+  assert.throws(() => template('Hi {name}', 'Ada'), TypeError);
+});
+
+test('slugifyAscii lower-cases and joins words with single dashes', () => {
+  assert.strictEqual(slugifyAscii('Hello World'), 'hello-world');
+  assert.strictEqual(slugifyAscii('Ada King Lovelace'), 'ada-king-lovelace');
+  assert.strictEqual(slugifyAscii('version 2 notes'), 'version-2-notes');
+});
+
+test('slugifyAscii turns runs of punctuation and spaces into one dash', () => {
+  assert.strictEqual(slugifyAscii('Hello,   World!!'), 'hello-world');
+  assert.strictEqual(slugifyAscii('a -- b __ c'), 'a-b-c');
+  assert.strictEqual(slugifyAscii('one/two\\three.four'), 'one-two-three-four');
+});
+
+test('slugifyAscii trims dashes from the ends', () => {
+  assert.strictEqual(slugifyAscii('  --Hello--  '), 'hello');
+  assert.strictEqual(slugifyAscii('!!!start'), 'start');
+  assert.strictEqual(slugifyAscii('end???'), 'end');
+});
+
+test('slugifyAscii removes accents, so the result is ASCII', () => {
+  assert.strictEqual(slugifyAscii('Café Crème'), 'cafe-creme');
+  assert.strictEqual(slugifyAscii('Ångström'), 'angstrom');
+  assert.strictEqual(slugifyAscii('Straße'), 'stra-e'); // ß has no ASCII form, so it is a separator
