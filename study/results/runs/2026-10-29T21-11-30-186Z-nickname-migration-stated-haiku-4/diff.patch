+// exist in the target month, it is clamped to that month's last day: 31 January plus one month is 28 or 29 February.
+// The input is not changed.
+exports.addMonths = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError(`Expected a Date, got ${typeof date}`);
+  if (Number.isNaN(date.getTime())) throw new RangeError('Expected a valid Date');
+  if (!Number.isInteger(n)) throw new RangeError(`Expected an integer number of months, got ${n}`);
