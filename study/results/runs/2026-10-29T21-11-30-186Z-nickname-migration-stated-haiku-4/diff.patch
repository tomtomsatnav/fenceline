+  if (other && other.id !== ownId) {
+    throw new Error(`Email already in use: ${email}`);
+  }
+};
+
+const checkFullName = (fullName) => {
+  if (typeof fullName !== 'string' || fullName.trim() === '' || fullName.length > 100) {
+    throw new Error(`Invalid full name: ${fullName}`);
+  }
+};
+
+// Maps user fields to database columns, leaving out any field that was not given.
+const toRow = ({ email, fullName }) => {
+  const row = {};
+  if (email !== undefined) row.email = email;
+  if (fullName !== undefined) row.fullname = fullName;
+  return row;
+};
+
+// Maps a database row to the user object returned by the API.
+const fromRow = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, nickname: r.nickname ?? null, createdAt: r.created_at, lastLogin: r.last_login ?? null });
+
+/**
+ * Creates a user with a new id and the current time as `createdAt`.
+ * @param {import('../db.js').Db} db
+ * @param {{ email: string, fullName: string }} fields
+ * @returns {{ id: string, email: string, fullName: string, createdAt: string, lastLogin: string | null }} the new user
+ * @throws {Error} if the email is invalid or already in use, or the full name is invalid
+ */
+exports.createUser = (db, { email, fullName, nickname }) => {
+  requireDb(db);
+  checkEmail(db, email);
+  checkFullName(fullName);
+  // The nickname is optional, so it is written only when given; an unset nickname reads back as null.
+  const optional = nickname === undefined ? {} : { nickname };
+  const row = { id: crypto.randomUUID(), ...toRow({ email, fullName }), ...optional, created_at: new Date().toISOString() };
   db.insert('users', row);
   return exports.getUser(db, row.id);
 };
 
+/**
+ * Changes the given fields of a user. Fields left undefined are not changed.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {{ email?: string, fullName?: string }} fields
+ * @returns {object | null} the updated user, or null if no user has this id
+ * @throws {Error} if a given email is invalid or used by another user, or a given full name is invalid
+ */
+exports.updateUser = (db, id, { email, fullName }) => {
+  requireDb(db);
+  if (email !== undefined) checkEmail(db, email, id);
+  if (fullName !== undefined) checkFullName(fullName);
+  db.update('users', (u) => u.id === id, toRow({ email, fullName }));
+  return exports.getUser(db, id);
+};
+
+const allUsersOldestFirst = (db) => db.all('users')
+  .map(fromRow)
+  .sort((a, b) => (a.createdAt < b.createdAt ? -1 : a.createdAt > b.createdAt ? 1 : 0));
+
+/**
+ * Lists users, oldest first.
+ * @param {import('../db.js').Db} db
+ * @param {{ limit?: number, offset?: number }} [page] defaults to the first 50 users
+ * @returns {object[]} the users on this page
+ */
+exports.listUsers = (db, { limit = 50, offset = 0 } = {}) => {
+  requireDb(db);
+  return allUsersOldestFirst(db).slice(offset, offset + limit);
+};
+
+/**
+ * Finds users whose email or full name contains the query, ignoring case. Oldest first.
+ * @param {import('../db.js').Db} db
+ * @param {string} query
+ * @returns {object[]} every matching user, not paginated
+ */
+exports.searchUsers = (db, query) => {
+  requireDb(db);
+  const q = query.toLowerCase();
