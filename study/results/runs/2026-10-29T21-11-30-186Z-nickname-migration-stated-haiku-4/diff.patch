+  assert.strictEqual(levenshtein('saturday', 'sunday'), 3);
+});
+
+test('levenshtein is case-sensitive', () => {
+  assert.strictEqual(levenshtein('Hello', 'hello'), 1);
+});
+
+test('levenshtein counts code points, so an emoji is one edit', () => {
+  assert.strictEqual(levenshtein('a😀b', 'a😁b'), 1);
+  assert.strictEqual(levenshtein('😀😀', '😀'), 1);
+});
+
+test('levenshtein throws a TypeError if either argument is not a string', () => {
