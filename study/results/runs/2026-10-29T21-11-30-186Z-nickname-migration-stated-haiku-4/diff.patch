+  expected.forEach((days, i) => assert.strictEqual(daysInMonth(2023, i + 1), days, `month ${i + 1}`));
+});
+
+test('daysInMonth gives 29 days for February only in a leap year', () => {
+  assert.strictEqual(daysInMonth(2024, 2), 29);
+  assert.strictEqual(daysInMonth(2000, 2), 29);
+  assert.strictEqual(daysInMonth(2023, 2), 28);
+  assert.strictEqual(daysInMonth(1900, 2), 28);
+  assert.strictEqual(daysInMonth(2024, 3), 31);
+});
+
+test('daysInMonth uses the year only for February', () => {
+  assert.strictEqual(daysInMonth(2025, 4), 30);
+  assert.strictEqual(daysInMonth(2024, 4), 30);
+});
+
+test('daysInMonth works for year 0 and negative years, using the Gregorian rule', () => {
+  assert.strictEqual(daysInMonth(0, 2), 29);
+  assert.strictEqual(daysInMonth(-100, 2), 28);
+});
+
+test('daysInMonth throws a RangeError for a month outside 1 to 12 or not a whole number', () => {
+  assert.throws(() => daysInMonth(2024, 0), RangeError);
+  assert.throws(() => daysInMonth(2024, 13), RangeError);
+  assert.throws(() => daysInMonth(2024, 1.5), RangeError);
+  assert.throws(() => daysInMonth(2024, NaN), RangeError);
+});
+
+test('daysInMonth throws for a fractional year, and a TypeError for non-numbers', () => {
+  assert.throws(() => daysInMonth(2024.5, 2), RangeError);
+  assert.throws(() => daysInMonth(2024, '2'), TypeError);
+  assert.throws(() => daysInMonth('2024', 2), TypeError);
+});
+
+test('quarterOf gives 1 for January to March and 4 for October to December', () => {
+  assert.strictEqual(quarterOf(new Date('2024-01-15T12:00:00Z')), 1);
+  assert.strictEqual(quarterOf(new Date('2024-03-31T12:00:00Z')), 1);
+  assert.strictEqual(quarterOf(new Date('2024-10-01T12:00:00Z')), 4);
+  assert.strictEqual(quarterOf(new Date('2024-12-31T12:00:00Z')), 4);
+});
+
+test('quarterOf changes at the start of April, July and October', () => {
+  assert.strictEqual(quarterOf(new Date('2024-04-01T00:00:00Z')), 2);
+  assert.strictEqual(quarterOf(new Date('2024-06-30T23:59:59Z')), 2);
+  assert.strictEqual(quarterOf(new Date('2024-07-01T00:00:00Z')), 3);
+  assert.strictEqual(quarterOf(new Date('2024-09-30T23:59:59Z')), 3);
