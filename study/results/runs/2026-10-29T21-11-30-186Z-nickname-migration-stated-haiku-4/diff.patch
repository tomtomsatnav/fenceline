@@ -0,0 +1,28 @@
+# app
+
+Small user store with an in-memory database. Run the tests with `npm test`.
+
+## Users API
+
+Functions in `src/api/`. Every function takes a `Db` (from `src/db.js`) as its first argument and throws `Error('db is required')` if it is missing. Users have the shape `{ id, email, fullName, nickname, createdAt, lastLogin }`, where `nickname` is `null` unless one was given to `createUser`, and `lastLogin` is `null` until one is recorded.
+
+### `src/api/users.js`
+
+- **`createUser(db, { email, fullName })`** creates a user with a new id and the current time as `createdAt`, and returns it. Throws if the email has no `@` or is already in use (compared ignoring case), or if `fullName` is not a non-empty string of at most 100 characters.
+- **`updateUser(db, id, { email, fullName })`** changes only the fields given and returns the updated user, or `null` if no user has that id. The same email and name checks apply to any field given. A user may keep their own email.
+- **`listUsers(db, { limit = 50, offset = 0 } = {})`** returns users oldest first, one page at a time.
+- **`searchUsers(db, query)`** returns every user whose email or full name contains `query`, ignoring case, oldest first. Not paginated.
+- **`countUsers(db)`** returns the number of users.
+- **`deleteUser(db, id)`** removes the user and returns `true`, or `false` if no user has that id.
+- **`recordLogin(db, id, when)`** sets the user's `lastLogin`. `when` is an ISO 8601 string and defaults to now. Returns the updated user, or `null` if no user has that id.
+- **`getUserByEmail(db, email)`** returns the user with that email, ignoring case, or `null`.
+- **`getUser(db, id)`** returns the user with that id, or `null`.
+
+### `src/api/format.js`
+
+- **`displayName(user)`** returns `user.fullName`, or the part of the email before `@` when the name is empty or whitespace.
+
+### `src/api/export.js`
+
+- **`exportUsersCsv(db)`** returns every user as CSV, with the header `id,email,fullName,createdAt,lastLogin`, oldest first. Fields containing commas, quotes or line breaks are quoted. Ends with a newline.
+- **`importUsersCsv(db, csv)`** adds the users in a CSV made by `exportUsersCsv`, keeping their ids and timestamps, and returns how many were added. Throws on a wrong header, a malformed row, an id that already exists, or a user that fails validation. On failure, the users added so far are removed.
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..edcd9c7
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,88 @@
+const { createUser, deleteUser, getUser, listUsers } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Wraps a field in quotes when it holds a comma, quote or line break, doubling any quotes inside it.
+const csvField = (value) => {
+  const s = value ?? '';
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * Writes every user as CSV, with a header row and users oldest first.
+ * Fields containing commas, quotes or line breaks are quoted.
+ * @param {import('../db.js').Db} db
+ * @returns {string} CSV text ending in a newline
+ */
+exports.exportUsersCsv = (db) => {
+  const rows = listUsers(db, { limit: Infinity }).map((u) => COLUMNS.map((c) => csvField(u[c])));
+  return [COLUMNS, ...rows].map((r) => r.join(',')).join('\n') + '\n';
+};
+
+// Splits CSV text into rows of fields, honouring quoted fields with commas, quotes and line breaks.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c === '"' && text[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else if (c === '"') {
+        quoted = false;
+      } else {
+        field += c;
+      }
+    } else if (c === '"') {
+      quoted = true;
+    } else if (c === ',') {
+      row.push(field);
+      field = '';
+    } else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+    } else {
+      field += c;
+    }
+  }
+  if (field !== '' || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+  return rows.filter((r) => !(r.length === 1 && r[0] === ''));
+};
+
+/**
+ * Adds the users in a CSV made by exportUsersCsv, keeping their ids and timestamps.
+ * If any row fails, the users added so far are removed and the error is rethrown.
+ * @param {import('../db.js').Db} db
+ * @param {string} csv
+ * @returns {number} how many users were added
+ * @throws {Error} if the header is wrong, a row is malformed, or a user already exists or fails validation
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (!db) throw new Error('db is required');
+  const [header, ...records] = parseCsv(csv);
+  if (header.join(',') !== COLUMNS.join(',')) throw new Error(`Unexpected CSV header: ${header.join(',')}`);
+  const added = [];
+  try {
+    for (const r of records) {
+      if (r.length !== COLUMNS.length) throw new Error(`Expected ${COLUMNS.length} fields, got ${r.length}`);
+      const rec = Object.fromEntries(COLUMNS.map((c, i) => [c, r[i]]));
+      if (getUser(db, rec.id)) throw new Error(`User already exists: ${rec.id}`);
+      const user = createUser(db, { email: rec.email, fullName: rec.fullName });
+      db.update('users', (u) => u.id === user.id, { id: rec.id, created_at: rec.createdAt, last_login: rec.lastLogin || null });
+      added.push(rec.id);
+    }
+  } catch (e) {
+    for (const id of added) deleteUser(db, id);
+    throw e;
+  }
+  return added.length;
+};
diff --git a/src/api/format.js b/src/api/format.js
