+// True when the UTC date falls on a Saturday or Sunday.
+exports.isWeekend = (date) => {
+  if (!(date instanceof Date)) throw new TypeError(`Expected a Date, got ${typeof date}`);
+  if (Number.isNaN(date.getTime())) throw new RangeError('Expected a valid Date');
+  const day = date.getUTCDay();
+  return day === 0 || day === 6;
+};
+
+// The UTC calendar date as YYYY-MM-DD, such as "2024-03-09". Years must be 0 to 9999 so the format stays four digits.
+exports.formatIsoDate = (date) => {
+  if (!(date instanceof Date)) throw new TypeError(`Expected a Date, got ${typeof date}`);
+  if (Number.isNaN(date.getTime())) throw new RangeError('Expected a valid Date');
+  const year = date.getUTCFullYear();
+  if (year < 0 || year > 9999) throw new RangeError(`Expected a year from 0 to 9999, got ${year}`);
+  const pad = (n) => String(n).padStart(2, '0');
+  return `${String(year).padStart(4, '0')}-${pad(date.getUTCMonth() + 1)}-${pad(date.getUTCDate())}`;
+};
+
+// The UTC midnight Date for a YYYY-MM-DD string, the inverse of formatIsoDate. Impossible dates such as 2026-02-30 throw a RangeError.
+exports.parseIsoDate = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
+  if (!m) throw new RangeError(`Expected a YYYY-MM-DD date, got ${s}`);
+  const year = Number(m[1]);
+  const month = Number(m[2]);
+  const day = Number(m[3]);
+  // setUTCFullYear, not Date.UTC, because Date.UTC reads years 0 to 99 as 1900 to 1999.
+  const date = new Date(0);
+  date.setUTCFullYear(year, month - 1, day);
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+    throw new RangeError(`Not a real calendar date: ${s}`);
+  }
+  return date;
+};
+
+// Whole years completed between birthDate and date, counted by UTC calendar date.
+// A 29 February birthday is reached on 1 March in years without a 29 February. A birthDate after date throws a RangeError.
+exports.ageOn = (birthDate, date) => {
+  for (const d of [birthDate, date]) {
+    if (!(d instanceof Date)) throw new TypeError(`Expected a Date, got ${typeof d}`);
+    if (Number.isNaN(d.getTime())) throw new RangeError('Expected a valid Date');
+  }
+  if (exports.daysBetween(birthDate, date) < 0) throw new RangeError('birthDate is after date');
+  const year = date.getUTCFullYear();
+  const isLeap = (y) => (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
+  const birthMonth = birthDate.getUTCMonth();
+  const birthDay = birthDate.getUTCDate();
+  const leapBirthday = birthMonth === 1 && birthDay === 29;
+  const anniversaryMonth = leapBirthday && !isLeap(year) ? 2 : birthMonth;
+  const anniversaryDay = leapBirthday && !isLeap(year) ? 1 : birthDay;
+  const beforeAnniversary =
+    date.getUTCMonth() < anniversaryMonth ||
+    (date.getUTCMonth() === anniversaryMonth && date.getUTCDate() < anniversaryDay);
+  return year - birthDate.getUTCFullYear() - (beforeAnniversary ? 1 : 0);
+};
+
+// A phrase for how far date is from now, such as "3 minutes ago" or "in 2 days". Counts whole units, using 30-day months and 365-day years.
+// Less than a second apart gives "just now". now defaults to the current time.
+exports.relativeTime = (date, now = new Date()) => {
+  for (const d of [date, now]) {
+    if (!(d instanceof Date)) throw new TypeError(`Expected a Date, got ${typeof d}`);
+    if (Number.isNaN(d.getTime())) throw new RangeError('Expected a valid Date');
+  }
