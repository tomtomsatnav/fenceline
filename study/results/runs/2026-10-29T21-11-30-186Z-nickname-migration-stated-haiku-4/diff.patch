+
+test('truncate throws for non-strings or a bad length', () => {
+  assert.throws(() => truncate(null, 3), TypeError);
+  assert.throws(() => truncate('hello', -1), RangeError);
+  assert.throws(() => truncate('hello', 2.5), RangeError);
