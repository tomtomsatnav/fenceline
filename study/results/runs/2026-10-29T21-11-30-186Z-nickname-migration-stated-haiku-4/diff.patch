+// letter, a digit and a final letter. Letters are restricted as Royal Mail uses them (for example no Q, V or X first).
+const UK_OUTWARD = /^(?:[A-PR-UWYZ]\d{1,2}|[A-PR-UWYZ][A-HK-Y]\d{1,2}|[A-PR-UWYZ]\d[ABEHMNPRVWXY]|[A-PR-UWYZ][A-HK-Y]\d[ABEHMNPRVWXY])$/;
