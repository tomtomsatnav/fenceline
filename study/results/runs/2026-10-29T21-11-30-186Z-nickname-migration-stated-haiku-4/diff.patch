+const test = require('node:test');
+const assert = require('node:assert');
+const { addDays, daysBetween, isWeekend, startOfWeek, formatIsoDate, parseIsoDate, ageOn, relativeTime, isLeapYear, daysInMonth, quarterOf, addMonths, formatDuration } = require('../src/lib/dates.js');
+
+// Local-time dates are built from parts so these tests pass in any time zone.
+const day = (y, m, d) => new Date(y, m - 1, d, 12, 30);
+
+test('addDays moves forward by the given number of days', () => {
+  assert.deepStrictEqual(addDays(day(2024, 3, 10), 5), day(2024, 3, 15));
+  assert.deepStrictEqual(addDays(day(2024, 3, 10), 1), day(2024, 3, 11));
+});
+
+test('addDays moves backward for a negative count', () => {
+  assert.deepStrictEqual(addDays(day(2024, 3, 10), -10), day(2024, 2, 29));
+});
+
+test('addDays with zero returns an equal but separate Date', () => {
+  const d = day(2024, 3, 10);
+  const out = addDays(d, 0);
+  assert.deepStrictEqual(out, d);
+  assert.notStrictEqual(out, d);
+});
+
+test('addDays rolls over months and years', () => {
+  assert.deepStrictEqual(addDays(day(2024, 1, 31), 1), day(2024, 2, 1));
+  assert.deepStrictEqual(addDays(day(2024, 12, 31), 1), day(2025, 1, 1));
+  assert.deepStrictEqual(addDays(day(2025, 1, 1), -1), day(2024, 12, 31));
+});
+
+test('addDays handles leap days in leap and non-leap years', () => {
+  assert.deepStrictEqual(addDays(day(2024, 2, 28), 1), day(2024, 2, 29));
+  assert.deepStrictEqual(addDays(day(2023, 2, 28), 1), day(2023, 3, 1));
+  assert.deepStrictEqual(addDays(day(2024, 2, 29), 365), day(2025, 2, 28));
+});
+
+test('addDays keeps the local time of day', () => {
