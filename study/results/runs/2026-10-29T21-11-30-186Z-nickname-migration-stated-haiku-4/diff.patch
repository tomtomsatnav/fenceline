+  const MINUTE = 60 * SECOND;
+  const HOUR = 60 * MINUTE;
+  const DAY = 24 * HOUR;
+  const MONTH = 30 * DAY;
+  const YEAR = 365 * DAY;
+  const units = [
+    [YEAR, 'year'],
+    [MONTH, 'month'],
+    [DAY, 'day'],
+    [HOUR, 'hour'],
+    [MINUTE, 'minute'],
+    [SECOND, 'second'],
+  ];
+  const diff = date.getTime() - now.getTime();
+  const elapsed = Math.abs(diff);
+  if (elapsed < SECOND) return 'just now';
+  const [size, name] = units.find(([s]) => elapsed >= s);
+  const count = Math.floor(elapsed / size);
+  const phrase = `${count} ${count === 1 ? name : `${name}s`}`;
+  return diff < 0 ? `${phrase} ago` : `in ${phrase}`;
