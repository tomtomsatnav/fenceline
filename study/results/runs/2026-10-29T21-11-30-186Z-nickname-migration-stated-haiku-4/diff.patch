+
+test('quarterOf uses the UTC month at the boundaries', () => {
+  assert.strictEqual(quarterOf(new Date('2024-03-31T23:30:00Z')), 1);
+  assert.strictEqual(quarterOf(new Date('2024-04-01T00:30:00Z')), 2);
+});
+
+test('quarterOf throws a TypeError for a non-Date and a RangeError for an invalid Date', () => {
+  assert.throws(() => quarterOf('2024-05-01'), TypeError);
+  assert.throws(() => quarterOf(new Date('not a date')), RangeError);
+});
+
+test('addMonths moves forward and backward by whole months', () => {
+  assert.strictEqual(formatIsoDate(addMonths(new Date('2024-03-15T00:00:00Z'), 2)), '2024-05-15');
+  assert.strictEqual(formatIsoDate(addMonths(new Date('2024-03-15T00:00:00Z'), -2)), '2024-01-15');
+});
+
+test('addMonths rolls over years in both directions', () => {
+  assert.strictEqual(formatIsoDate(addMonths(new Date('2024-11-10T00:00:00Z'), 3)), '2025-02-10');
+  assert.strictEqual(formatIsoDate(addMonths(new Date('2024-02-10T00:00:00Z'), -3)), '2023-11-10');
+});
+
+test('addMonths clamps the day to the end of a shorter month', () => {
+  assert.strictEqual(formatIsoDate(addMonths(new Date('2023-01-31T00:00:00Z'), 1)), '2023-02-28');
+  assert.strictEqual(formatIsoDate(addMonths(new Date('2024-01-31T00:00:00Z'), 1)), '2024-02-29');
+  assert.strictEqual(formatIsoDate(addMonths(new Date('2024-03-31T00:00:00Z'), 1)), '2024-04-30');
+  assert.strictEqual(formatIsoDate(addMonths(new Date('2024-05-31T00:00:00Z'), -3)), '2024-02-29');
+});
+
+test('addMonths of 0 gives an equal but separate Date, and 12 months keeps the month', () => {
+  const d = new Date('2024-03-10T08:00:00Z');
+  const same = addMonths(d, 0);
+  assert.strictEqual(same.getTime(), d.getTime());
+  assert.notStrictEqual(same, d);
+  assert.strictEqual(formatIsoDate(addMonths(d, 12)), '2025-03-10');
+});
+
+test('addMonths from 29 February clamps to 28 February in a common year', () => {
+  assert.strictEqual(formatIsoDate(addMonths(new Date('2024-02-29T00:00:00Z'), 12)), '2025-02-28');
+  assert.strictEqual(formatIsoDate(addMonths(new Date('2024-02-29T00:00:00Z'), 48)), '2028-02-29');
+});
+
+test('addMonths keeps the UTC time of day and does not change the input', () => {
+  const d = new Date('2024-01-31T23:45:10Z');
+  const out = addMonths(d, 1);
+  assert.strictEqual(out.toISOString(), '2024-02-29T23:45:10.000Z');
+  assert.strictEqual(d.toISOString(), '2024-01-31T23:45:10.000Z');
+});
+
+test('addMonths throws for a non-Date, an invalid Date, or a non-integer count', () => {
+  assert.throws(() => addMonths('2024-01-31', 1), TypeError);
+  assert.throws(() => addMonths(new Date('not a date'), 1), RangeError);
+  assert.throws(() => addMonths(new Date('2024-01-31T00:00:00Z'), 1.5), RangeError);
+  assert.throws(() => addMonths(new Date('2024-01-31T00:00:00Z'), NaN), RangeError);
+});
+
+test('formatDuration writes hours, minutes and seconds, largest first', () => {
+  assert.strictEqual(formatDuration(3725), '1h 2m 5s');
+  assert.strictEqual(formatDuration(59), '59s');
+  assert.strictEqual(formatDuration(61), '1m 1s');
+});
+
+test('formatDuration leaves out units that are zero', () => {
+  assert.strictEqual(formatDuration(3600), '1h');
+  assert.strictEqual(formatDuration(3660), '1h 1m');
+  assert.strictEqual(formatDuration(120), '2m');
+  assert.strictEqual(formatDuration(3605), '1h 5s');
+});
+
+test('formatDuration of 0 is "0s"', () => {
+  assert.strictEqual(formatDuration(0), '0s');
+});
+
+test('formatDuration uses days for durations of a day or more', () => {
+  assert.strictEqual(formatDuration(86400), '1d');
+  assert.strictEqual(formatDuration(90061), '1d 1h 1m 1s');
+  assert.strictEqual(formatDuration(2 * 86400 + 5), '2d 5s');
+});
+
+test('formatDuration output reads back to the same number of seconds with parseDuration', () => {
+  const { parseDuration } = require('../src/lib/numbers.js');
+  for (const s of [0, 1, 59, 60, 3725, 86399, 86400, 90061, 1000000]) {
+    assert.strictEqual(parseDuration(formatDuration(s).replace(/ /g, '')), s, `seconds=${s}`);
+  }
+});
+
+test('formatDuration throws a RangeError for negative or fractional seconds, and a TypeError for non-numbers', () => {
+  assert.throws(() => formatDuration(-1), RangeError);
+  assert.throws(() => formatDuration(1.5), RangeError);
+  assert.throws(() => formatDuration(NaN), RangeError);
+  assert.throws(() => formatDuration('3600'), TypeError);
+  assert.throws(() => formatDuration(null), TypeError);
+});
+
+test('addDays throws for a non-Date, an invalid Date, or a non-integer count', () => {
+  assert.throws(() => addDays('2024-03-10', 1), TypeError);
+  assert.throws(() => addDays(null, 1), TypeError);
+  assert.throws(() => addDays(new Date('not a date'), 1), RangeError);
+  assert.throws(() => addDays(day(2024, 3, 10), 1.5), RangeError);
+  assert.throws(() => addDays(day(2024, 3, 10), NaN), RangeError);
+});
