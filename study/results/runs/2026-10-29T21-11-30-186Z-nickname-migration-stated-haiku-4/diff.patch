+
+// True for a Gregorian leap year: divisible by 4, except century years, which must be divisible by 400. So 2000 and 2024 are
+// leap years, and 1900 and 2100 are not. Year 0 is a leap year, and negative years follow the same rule (proleptic Gregorian).
+// The year must be a whole number.
+exports.isLeapYear = (year) => {
+  if (typeof year !== 'number') throw new TypeError(`Expected a number, got ${typeof year}`);
+  if (!Number.isInteger(year)) throw new RangeError(`Expected a whole-number year, got ${year}`);
+  return (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
+};
+
