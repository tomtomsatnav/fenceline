+  const out = new Date(date.getTime());
+  out.setUTCFullYear(year, month, day);
+  return out;
+};
+
+// A short duration from a whole number of seconds, such as "1h 2m 5s" for 3725. Uses the units d, h, m and s, largest first, and
+// leaves out any unit that is zero, so 3600 is "1h". Zero itself is "0s". The output reads back with parseDuration in numbers.js.
+exports.formatDuration = (seconds) => {
+  if (typeof seconds !== 'number') throw new TypeError(`Expected a number, got ${typeof seconds}`);
+  if (!Number.isInteger(seconds) || seconds < 0) throw new RangeError(`Expected a whole number of seconds, 0 or more, got ${seconds}`);
+  const units = [
+    [86400, 'd'],
+    [3600, 'h'],
+    [60, 'm'],
+    [1, 's'],
+  ];
+  const parts = [];
+  let rest = seconds;
+  for (const [size, label] of units) {
+    const count = Math.floor(rest / size);
+    if (count > 0) parts.push(`${count}${label}`);
+    rest -= count * size;
+  }
+  return parts.length > 0 ? parts.join(' ') : '0s';
+};
+
+// The calendar quarter, 1 to 4, of a date's UTC month: January to March is 1, April to June is 2, and so on.
+exports.quarterOf = (date) => {
+  if (!(date instanceof Date)) throw new TypeError(`Expected a Date, got ${typeof date}`);
+  if (Number.isNaN(date.getTime())) throw new RangeError('Expected a valid Date');
+  return Math.floor(date.getUTCMonth() / 3) + 1;
+};
+
+// The number of days in a month, with month from 1 (January) to 12 (December). February has 29 days in a Gregorian leap year.
+// The year is checked by isLeapYear, so it must be a whole number; a month outside 1 to 12, or not a whole number, throws a RangeError.
+exports.daysInMonth = (year, month) => {
+  if (typeof month !== 'number') throw new TypeError(`Expected a number month, got ${typeof month}`);
+  if (!Number.isInteger(month) || month < 1 || month > 12) throw new RangeError(`Expected a month from 1 to 12, got ${month}`);
+  const lengths = [31, exports.isLeapYear(year) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+  return lengths[month - 1];
+};
+
+// The Monday 00:00 UTC that starts the week containing date. A Sunday belongs to the week that began the Monday before it.
+exports.startOfWeek = (date) => {
+  if (!(date instanceof Date)) throw new TypeError(`Expected a Date, got ${typeof date}`);
+  if (Number.isNaN(date.getTime())) throw new RangeError('Expected a valid Date');
+  const sinceMonday = (date.getUTCDay() + 6) % 7;
+  return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate() - sinceMonday));
+};
+
+// Whole calendar days from a to b, counted in UTC and ignoring the time of day: positive when b is later than a.
+// Two times on the same UTC date give 0.
+exports.daysBetween = (a, b) => {
+  for (const d of [a, b]) {
+    if (!(d instanceof Date)) throw new TypeError(`Expected a Date, got ${typeof d}`);
+    if (Number.isNaN(d.getTime())) throw new RangeError('Expected a valid Date');
+  }
+  const utcDay = (d) => Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
+  return Math.round((utcDay(b) - utcDay(a)) / 86400000);
+};
+
+// A new Date n calendar days after date (before it when n is negative), at the same local time of day.
+// The input date is not changed. Month, year and leap-day rollovers are handled by the Date object itself.
+exports.addDays = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError(`Expected a Date, got ${typeof date}`);
+  if (Number.isNaN(date.getTime())) throw new RangeError('Expected a valid Date');
+  if (!Number.isInteger(n)) throw new RangeError(`Expected an integer number of days, got ${n}`);
+  const out = new Date(date.getTime());
+  out.setDate(out.getDate() + n);
+  return out;
+};
