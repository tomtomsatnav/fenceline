+test('wrap counts code points, and treats existing line breaks as spaces', () => {
+  assert.strictEqual(wrap('😀 😀 😀', 3), '😀 😀\n😀');
+  assert.strictEqual(wrap('one\ntwo   three', 20), 'one two three');
