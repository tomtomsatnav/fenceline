+  assert.strictEqual(escapeHtml('>'), '&gt;');
+  assert.strictEqual(escapeHtml('"'), '&quot;');
+  assert.strictEqual(escapeHtml("'"), '&#39;');
+});
+
+test('escapeHtml makes a script tag harmless', () => {
+  assert.strictEqual(escapeHtml('<script>alert("hi")</script>'), '&lt;script&gt;alert(&quot;hi&quot;)&lt;/script&gt;');
+});
+
+test('escapeHtml escapes an ampersand once, without touching other characters', () => {
+  assert.strictEqual(escapeHtml('Tom & Jerry'), 'Tom &amp; Jerry');
+  assert.strictEqual(escapeHtml('a & b < c'), 'a &amp; b &lt; c');
+});
+
+test('escapeHtml escapes text that already contains an entity, so nothing is decoded', () => {
+  assert.strictEqual(escapeHtml('&amp;'), '&amp;amp;');
+  assert.strictEqual(escapeHtml('&lt;b&gt;'), '&amp;lt;b&amp;gt;');
+});
+
+test('escapeHtml leaves text without special characters unchanged, and handles the empty string', () => {
+  assert.strictEqual(escapeHtml('plain text 123'), 'plain text 123');
+  assert.strictEqual(escapeHtml('Café ☕'), 'Café ☕');
+  assert.strictEqual(escapeHtml(''), '');
+});
+
+test('escapeHtml throws a TypeError for a non-string', () => {
+  assert.throws(() => escapeHtml(null), TypeError);
+  assert.throws(() => escapeHtml(5), TypeError);
+});
+
+test('stripTags removes tags and keeps the text inside them', () => {
+  assert.strictEqual(stripTags('<p>Hello <b>world</b></p>'), 'Hello world');
+  assert.strictEqual(stripTags('<div><span>a</span><span>b</span></div>'), 'ab');
