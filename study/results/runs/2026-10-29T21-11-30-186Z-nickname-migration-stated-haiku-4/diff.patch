+const test = require('node:test');
+const assert = require('node:assert');
+const { camelCase, kebabCase, truncate, padCenter, countWords, initials, reverseWords, isPalindrome, wrap, template, slugifyAscii, escapeHtml, stripTags, levenshtein, commonPrefix } = require('../src/lib/strings.js');
+
+test('joins words separated by spaces, hyphens or underscores', () => {
+  assert.strictEqual(camelCase('hello world'), 'helloWorld');
+  assert.strictEqual(camelCase('hello-world'), 'helloWorld');
+  assert.strictEqual(camelCase('hello_world'), 'helloWorld');
+});
+
+test('handles mixed separators and repeated or surrounding separators', () => {
+  assert.strictEqual(camelCase('hello - world_again'), 'helloWorldAgain');
+  assert.strictEqual(camelCase('  hello   world  '), 'helloWorld');
+  assert.strictEqual(camelCase('__hello--world__'), 'helloWorld');
+});
+
+test('lowercases the rest of each word', () => {
+  assert.strictEqual(camelCase('HELLO WORLD'), 'helloWorld');
+  assert.strictEqual(camelCase('Hello World'), 'helloWorld');
+});
+
+test('returns a single word in lowercase, and an empty string for blank input', () => {
+  assert.strictEqual(camelCase('Hello'), 'hello');
+  assert.strictEqual(camelCase(''), '');
+  assert.strictEqual(camelCase(' _- '), '');
+});
+
+test('keeps digits inside words', () => {
+  assert.strictEqual(camelCase('version 2 notes'), 'version2Notes');
+});
+
+test('throws a TypeError for non-strings', () => {
+  assert.throws(() => camelCase(null), TypeError);
+  assert.throws(() => camelCase(42), TypeError);
+});
+
+test('kebabCase splits camelCase and spaced words into hyphenated lowercase', () => {
+  assert.strictEqual(kebabCase('helloWorld'), 'hello-world');
+  assert.strictEqual(kebabCase('Hello World'), 'hello-world');
+  assert.strictEqual(kebabCase('HelloWorld'), 'hello-world');
+  assert.strictEqual(kebabCase('hello-world'), 'hello-world');
+  assert.strictEqual(kebabCase('hello_world'), 'hello-world');
+});
+
+test('kebabCase keeps acronyms together', () => {
+  assert.strictEqual(kebabCase('XMLHttpRequest'), 'xml-http-request');
+  assert.strictEqual(kebabCase('parseHTML'), 'parse-html');
+  assert.strictEqual(kebabCase('HELLO WORLD'), 'hello-world');
+});
+
+test('kebabCase handles digits, repeated and surrounding separators, and blank input', () => {
+  assert.strictEqual(kebabCase('version2Notes'), 'version2-notes');
+  assert.strictEqual(kebabCase('hello 2 world'), 'hello-2-world');
+  assert.strictEqual(kebabCase('  __hello--world__  '), 'hello-world');
+  assert.strictEqual(kebabCase('hello'), 'hello');
+  assert.strictEqual(kebabCase(''), '');
+  assert.strictEqual(kebabCase(' _- '), '');
+});
