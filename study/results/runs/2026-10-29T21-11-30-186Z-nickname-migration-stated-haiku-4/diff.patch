+// so an emoji is one edit. Uses two rows of the table, so memory grows with the shorter string only.
+exports.levenshtein = (a, b) => {
+  if (typeof a !== 'string') throw new TypeError(`Expected a string, got ${typeof a}`);
+  if (typeof b !== 'string') throw new TypeError(`Expected a string, got ${typeof b}`);
+  let x = Array.from(a);
+  let y = Array.from(b);
+  if (x.length < y.length) [x, y] = [y, x];
+  if (y.length === 0) return x.length;
+  let prev = Array.from({ length: y.length + 1 }, (_, j) => j);
+  for (let i = 1; i <= x.length; i++) {
+    const row = [i];
+    for (let j = 1; j <= y.length; j++) {
+      const cost = x[i - 1] === y[j - 1] ? 0 : 1;
+      row[j] = Math.min(prev[j] + 1, row[j - 1] + 1, prev[j - 1] + cost);
+    }
+    prev = row;
+  }
+  return prev[y.length];
+};
