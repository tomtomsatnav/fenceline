+// Removes HTML comments, doctype declarations and tags, keeping the text between them. Tags are only recognised when a letter
+// follows "<" or "</", so "a < 5" is left alone. Quoted attribute values may contain ">". Entities such as &amp; are not decoded.
+// This is for showing plain text, not for making untrusted HTML safe: use escapeHtml or a real HTML sanitiser for that.
+exports.stripTags = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  return s
+    .replace(/<!--[\s\S]*?-->/g, '')
+    .replace(/<![^>]*>/g, '')
+    .replace(/<\/?[A-Za-z][^>"']*(?:(?:"[^"]*"|'[^']*')[^>"']*)*>/g, '');
+};
