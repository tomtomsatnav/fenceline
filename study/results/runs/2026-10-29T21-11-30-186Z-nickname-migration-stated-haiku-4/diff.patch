+const test = require('node:test');
+const assert = require('node:assert');
+const { clamp, roundTo, mean, median, percentile, formatBytes, isPrime, gcd, toRoman, fromRoman, lerp, stdDev, fibonacci, toOrdinal, parseDuration } = require('../src/lib/numbers.js');
+
+test('clamp returns x when it is inside the range', () => {
+  assert.strictEqual(clamp(5, 0, 10), 5);
+  assert.strictEqual(clamp(-2, -5, 0), -2);
+});
+
+test('clamp limits x to the bounds, and includes the bounds themselves', () => {
+  assert.strictEqual(clamp(-3, 0, 10), 0);
+  assert.strictEqual(clamp(15, 0, 10), 10);
+  assert.strictEqual(clamp(0, 0, 10), 0);
+  assert.strictEqual(clamp(10, 0, 10), 10);
+});
+
+test('clamp works with fractional values and with lo equal to hi', () => {
+  assert.strictEqual(clamp(0.25, 0, 1), 0.25);
+  assert.strictEqual(clamp(7, 3, 3), 3);
+});
+
+test('clamp accepts infinite bounds', () => {
+  assert.strictEqual(clamp(5, -Infinity, 3), 3);
+  assert.strictEqual(clamp(-5, -3, Infinity), -3);
+  assert.strictEqual(clamp(1e9, 0, Infinity), 1e9);
+});
+
+test('roundTo rounds to the given decimal places', () => {
+  assert.strictEqual(roundTo(3.14159, 2), 3.14);
+  assert.strictEqual(roundTo(3.14159, 0), 3);
+  assert.strictEqual(roundTo(2.5, 3), 2.5);
+  assert.strictEqual(roundTo(7, 2), 7);
+});
+
+test('roundTo rounds halves away from zero', () => {
+  assert.strictEqual(roundTo(0.5, 0), 1);
+  assert.strictEqual(roundTo(2.5, 0), 3);
+  assert.strictEqual(roundTo(-2.5, 0), -3);
+  assert.strictEqual(roundTo(1.25, 1), 1.3);
+  assert.strictEqual(roundTo(-1.25, 1), -1.3);
+});
+
+test('roundTo handles halves that binary floats store slightly low', () => {
+  assert.strictEqual(roundTo(1.005, 2), 1.01);
+  assert.strictEqual(roundTo(2.675, 2), 2.68);
+  assert.strictEqual(roundTo(1.45, 1), 1.5);
+});
+
+test('roundTo with negative places rounds to tens, hundreds and so on', () => {
+  assert.strictEqual(roundTo(1234, -2), 1200);
+  assert.strictEqual(roundTo(1250, -2), 1300);
+  assert.strictEqual(roundTo(-1250, -2), -1300);
+});
+
+test('roundTo handles very small and very large numbers and zero', () => {
+  assert.strictEqual(roundTo(1e-7, 2), 0);
+  assert.strictEqual(roundTo(0, 3), 0);
+  assert.strictEqual(roundTo(-0.001, 2), 0);
+  assert.strictEqual(roundTo(1e21, 2), 1e21);
+});
+
+test('roundTo returns infinite and NaN values unchanged', () => {
+  assert.strictEqual(roundTo(Infinity, 2), Infinity);
+  assert.strictEqual(roundTo(-Infinity, 2), -Infinity);
+  assert.ok(Number.isNaN(roundTo(NaN, 2)));
+});
+
+test('roundTo throws for a non-number or a non-integer number of places', () => {
+  assert.throws(() => roundTo('1.5', 0), TypeError);
+  assert.throws(() => roundTo(1.5, 1.5), RangeError);
+  assert.throws(() => roundTo(1.5, '1'), RangeError);
+});
+
+test('mean returns the arithmetic mean', () => {
+  assert.strictEqual(mean([1, 2, 3]), 2);
+  assert.strictEqual(mean([4]), 4);
+  assert.strictEqual(mean([1, 2]), 1.5);
+  assert.strictEqual(mean([-3, 3]), 0);
+});
+
+test('mean returns NaN for an empty array', () => {
+  assert.ok(Number.isNaN(mean([])));
+});
+
+test('mean propagates NaN and infinities as arithmetic does', () => {
+  assert.ok(Number.isNaN(mean([1, NaN])));
+  assert.strictEqual(mean([1, Infinity]), Infinity);
+  assert.ok(Number.isNaN(mean([Infinity, -Infinity])));
+});
+
+test('mean does not change its input and throws for bad input', () => {
+  const xs = [1, 2, 3];
+  mean(xs);
+  assert.deepStrictEqual(xs, [1, 2, 3]);
+  assert.throws(() => mean('123'), TypeError);
+  assert.throws(() => mean([1, '2']), TypeError);
+  assert.throws(() => mean(null), TypeError);
+});
+
+test('median is the middle value of an odd-length array', () => {
+  assert.strictEqual(median([3, 1, 2]), 2);
+  assert.strictEqual(median([7]), 7);
+});
+
+test('median is the mean of the two middle values for an even-length array', () => {
+  assert.strictEqual(median([4, 1, 3, 2]), 2.5);
+  assert.strictEqual(median([1, 3]), 2);
+});
+
+test('median does not depend on input order and handles negatives and repeats', () => {
+  assert.strictEqual(median([-5, 10, -5, 0, 3]), 0);
+  assert.strictEqual(median([2, 2, 2]), 2);
+  assert.strictEqual(median([100, 1, 50, 2, 3]), 3);
+});
+
+test('median does not change its input', () => {
+  const xs = [3, 1, 2];
+  median(xs);
+  assert.deepStrictEqual(xs, [3, 1, 2]);
+});
+
+test('median returns NaN for an empty array or one containing NaN', () => {
+  assert.ok(Number.isNaN(median([])));
+  assert.ok(Number.isNaN(median([1, NaN, 3])));
+});
+
+test('median sorts numerically, not as text, and handles infinities', () => {
+  assert.strictEqual(median([10, 9, 100]), 10);
+  assert.strictEqual(median([-Infinity, 0, Infinity]), 0);
+});
+
+test('median throws a TypeError for a non-array or non-number items', () => {
+  assert.throws(() => median('123'), TypeError);
+  assert.throws(() => median([1, '2']), TypeError);
+});
+
+test('percentile gives the ends of the range at 0 and 100', () => {
+  assert.strictEqual(percentile([3, 1, 2], 0), 1);
+  assert.strictEqual(percentile([3, 1, 2], 100), 3);
+});
+
+test('percentile interpolates linearly between neighbouring values', () => {
+  assert.strictEqual(percentile([1, 2, 3, 4], 50), 2.5);
+  assert.strictEqual(percentile([10, 20, 30, 40, 50], 25), 20);
+  assert.strictEqual(percentile([10, 20, 30, 40, 50], 10), 14);
+});
+
+test('percentile 50 matches median', () => {
+  for (const xs of [[3, 1, 2], [4, 1, 3, 2], [7], [-5, 10, -5, 0, 3]]) {
+    assert.strictEqual(percentile(xs, 50), median(xs));
+  }
+});
+
+test('percentile of a single value is that value, for any p', () => {
+  assert.strictEqual(percentile([7], 0), 7);
+  assert.strictEqual(percentile([7], 33), 7);
+  assert.strictEqual(percentile([7], 100), 7);
+});
+
+test('percentile returns NaN for an empty array or one containing NaN', () => {
+  assert.ok(Number.isNaN(percentile([], 50)));
+  assert.ok(Number.isNaN(percentile([1, NaN], 50)));
+});
+
+test('percentile handles infinities without producing NaN at exact ranks', () => {
+  assert.strictEqual(percentile([-Infinity, 0, Infinity], 50), 0);
+  assert.strictEqual(percentile([1, Infinity], 100), Infinity);
+});
+
+test('percentile does not change its input and sorts numerically', () => {
+  const xs = [10, 9, 100];
+  assert.strictEqual(percentile(xs, 50), 10);
+  assert.deepStrictEqual(xs, [10, 9, 100]);
+});
+
+test('percentile throws for an out-of-range or non-numeric percentile, a non-array, or non-number items', () => {
+  assert.throws(() => percentile([1, 2], -1), RangeError);
+  assert.throws(() => percentile([1, 2], 101), RangeError);
+  assert.throws(() => percentile([1, 2], NaN), RangeError);
+  assert.throws(() => percentile([1, 2], '50'), TypeError);
+  assert.throws(() => percentile('12', 50), TypeError);
+  assert.throws(() => percentile([1, '2'], 50), TypeError);
+});
+
+test('formatBytes shows whole bytes without decimals', () => {
+  assert.strictEqual(formatBytes(0), '0 B');
+  assert.strictEqual(formatBytes(1), '1 B');
+  assert.strictEqual(formatBytes(512), '512 B');
+  assert.strictEqual(formatBytes(1023), '1023 B');
+});
+
+test('formatBytes uses powers of 1024 and one decimal place', () => {
+  assert.strictEqual(formatBytes(1024), '1 KB');
+  assert.strictEqual(formatBytes(1536), '1.5 KB');
+  assert.strictEqual(formatBytes(1048576), '1 MB');
+  assert.strictEqual(formatBytes(1610612736), '1.5 GB');
+  assert.strictEqual(formatBytes(1099511627776), '1 TB');
+});
+
+test('formatBytes moves up a unit rather than showing 1024 of one', () => {
+  assert.strictEqual(formatBytes(1023.96 * 1024), '1 MB');
+  assert.strictEqual(formatBytes(1023.6), '1 KB');
+});
+
+test('formatBytes stays in TB for very large counts', () => {
+  assert.strictEqual(formatBytes(1024 ** 5), '1024 TB');
+});
+
+test('formatBytes throws for a negative, non-finite or non-numeric count', () => {
+  assert.throws(() => formatBytes(-1), RangeError);
+  assert.throws(() => formatBytes(NaN), RangeError);
+  assert.throws(() => formatBytes(Infinity), RangeError);
+  assert.throws(() => formatBytes('1024'), TypeError);
+});
+
+test('isPrime is true for small primes', () => {
+  for (const p of [2, 3, 5, 7, 11, 13, 97]) assert.strictEqual(isPrime(p), true, `${p}`);
+});
+
+test('isPrime is false for composites, including squares and products of primes', () => {
+  for (const c of [4, 6, 9, 15, 25, 49, 91, 1001]) assert.strictEqual(isPrime(c), false, `${c}`);
+});
+
+test('isPrime is false for 0, 1 and negative numbers', () => {
+  assert.strictEqual(isPrime(0), false);
+  assert.strictEqual(isPrime(1), false);
