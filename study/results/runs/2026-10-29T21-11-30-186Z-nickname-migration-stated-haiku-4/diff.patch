+// The longest run of characters that every string in the array starts with. Compares code points, so an emoji is never split.
+// An empty array, or one holding an empty string, gives ''. Comparison is case-sensitive. The input is not changed.
+exports.commonPrefix = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError(`Expected an array, got ${typeof xs}`);
+  for (const s of xs) {
+    if (typeof s !== 'string') throw new TypeError(`Expected strings, got ${typeof s}`);
+  }
