+// True when s parses as an absolute URL with an http or https scheme and a host. The URL class does the parsing.
+// Surrounding whitespace is rejected, because the URL class would silently trim it.
+exports.isUrl = (s) => {
+  if (typeof s !== 'string') throw new TypeError(`Expected a string, got ${typeof s}`);
+  if (s !== s.trim()) return false;
+  let url;
+  try {
+    url = new URL(s);
+  } catch {
+    return false;
+  }
+  return (url.protocol === 'http:' || url.protocol === 'https:') && url.hostname !== '';
