+  assert.strictEqual(isIban('G182WEST12345698765432'), false); // digit where the country letter goes
+  assert.strictEqual(isIban('GBXXWEST12345698765432'), false); // letters where the check digits go
+  assert.strictEqual(isIban('GB82WEST1234569876543!'), false);
+  assert.strictEqual(isIban('GB82-WEST-12345698765432'), false);
+});
+
+test('isIban rejects spaces rather than stripping them', () => {
+  assert.strictEqual(isIban('GB82 WEST 1234 5698 7654 32'), false);
+  assert.strictEqual(isIban(' GB82WEST12345698765432'), false);
+});
+
+test('isIban returns false for the empty string', () => {
+  assert.strictEqual(isIban(''), false);
+});
+
+test('isIban throws a TypeError for a non-string', () => {
+  assert.throws(() => isIban(null), TypeError);
+  assert.throws(() => isIban(82), TypeError);
+});
+
+test('isCreditCardLuhn accepts numbers that pass the Luhn check', () => {
+  assert.strictEqual(isCreditCardLuhn('4111111111111111'), true);
+  assert.strictEqual(isCreditCardLuhn('5500005555555559'), true);
+  assert.strictEqual(isCreditCardLuhn('378282246310005'), true); // 15 digits
+  assert.strictEqual(isCreditCardLuhn('79927398713'), true);
+});
+
+test('isCreditCardLuhn rejects numbers with a wrong check digit', () => {
+  assert.strictEqual(isCreditCardLuhn('4111111111111112'), false);
+  assert.strictEqual(isCreditCardLuhn('79927398710'), false);
+  assert.strictEqual(isCreditCardLuhn('5500005555555558'), false);
+});
+
+test('isCreditCardLuhn handles doubled digits that give more than 9', () => {
+  assert.strictEqual(isCreditCardLuhn('18'), true); // 1 doubled is 2, 2 + 8 = 10
+  assert.strictEqual(isCreditCardLuhn('81'), false); // 8 doubled is 16, 1 + 6 + 1 = 8 is not a multiple of 10
+});
+
+test('isCreditCardLuhn accepts leading zeros as digits', () => {
+  assert.strictEqual(isCreditCardLuhn('0018'), true);
+});
+
+test('isCreditCardLuhn requires at least two digits, all of them digits', () => {
+  assert.strictEqual(isCreditCardLuhn(''), false);
+  assert.strictEqual(isCreditCardLuhn('0'), false);
+  assert.strictEqual(isCreditCardLuhn('4111 1111 1111 1111'), false);
+  assert.strictEqual(isCreditCardLuhn('4111-1111-1111-1111'), false);
+  assert.strictEqual(isCreditCardLuhn('4111111111111111x'), false);
+  assert.strictEqual(isCreditCardLuhn(' 4111111111111111'), false);
+});
+
+test('isCreditCardLuhn throws a TypeError for a non-string', () => {
+  assert.throws(() => isCreditCardLuhn(4111111111111111), TypeError);
+  assert.throws(() => isCreditCardLuhn(null), TypeError);
+});
+
+test('isEmail throws a TypeError for a non-string', () => {
+  assert.throws(() => isEmail(null), TypeError);
+  assert.throws(() => isEmail(undefined), TypeError);
+  assert.throws(() => isEmail(['ada@example.com']), TypeError);
+});
