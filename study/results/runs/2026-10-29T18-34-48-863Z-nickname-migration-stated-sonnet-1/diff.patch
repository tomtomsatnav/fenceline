+  while (iterators.length > 0) {
+    const { done, value } = iterators[iterators.length - 1].next();
+    if (done) {
+      iterators.pop();
+      openSet.delete(open.pop());
+    } else if (Array.isArray(value)) {
+      if (openSet.has(value)) throw new TypeError('flattenDeep: xs contains a circular reference');
+      open.push(value);
+      openSet.add(value);
+      iterators.push(value[Symbol.iterator]());
