+});
+
+test('template leaves unknown placeholders as they are', () => {
+  assert.strictEqual(template('Hi {name}, you are {age}', { name: 'Ada' }), 'Hi Ada, you are {age}');
+  assert.strictEqual(template('Hi {name}'), 'Hi {name}');
+  assert.strictEqual(template('Hi {name}', {}), 'Hi {name}');
+});
+
+test('template leaves a placeholder whose value is undefined, but fills null, 0, false and ""', () => {
+  assert.strictEqual(template('{a}', { a: undefined }), '{a}');
+  assert.strictEqual(template('[{a}][{b}][{c}][{d}]', { a: null, b: 0, c: false, d: '' }), '[null][0][false][]');
+});
+
+test('template never fills from inherited properties', () => {
