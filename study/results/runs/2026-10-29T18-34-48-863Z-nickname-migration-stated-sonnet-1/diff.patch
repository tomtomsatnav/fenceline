+  if (kinds.has('numeric') && kinds.has('string')) throw new TypeError('sortBy: keys must not mix strings with numbers, bigints, booleans or Dates');
+  entries.sort((a, b) => {
+    if (a.kind === 'missing' || b.kind === 'missing') return (a.kind === 'missing') - (b.kind === 'missing');
+    if (a.key < b.key) return -1;
+    return a.key > b.key ? 1 : 0;
+  });
