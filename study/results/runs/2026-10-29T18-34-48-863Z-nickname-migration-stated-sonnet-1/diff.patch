+
+// groupBy returns an object without a prototype, so compare it as plain data.
+const plain = (groups) => ({ ...groups });
+
+test('groupBy groups items by key', () => {
+  const groups = groupBy([1, 2, 3, 4, 5], (x) => (x % 2 ? 'odd' : 'even'));
+  assert.deepStrictEqual(plain(groups), { odd: [1, 3, 5], even: [2, 4] });
