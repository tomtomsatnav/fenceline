+/**
+ * Limits x to the range from lo to hi, both included: clamp(15, 0, 10) gives 10, clamp(-3, 0, 10)
+ * gives 0, and clamp(5, 0, 10) gives 5. The bounds may be infinite, so clamp(x, 0, Infinity) only sets a
+ * floor, and lo may equal hi. A NaN x stays NaN, since there is no sensible place for it in the range.
+ * @param {number} x
+ * @param {number} lo
+ * @param {number} hi Must not be less than lo.
+ * @returns {number}
+ * @throws {TypeError} If x, lo or hi is not a number.
+ * @throws {RangeError} If lo or hi is NaN, or lo is greater than hi.
+ */
+exports.clamp = (x, lo, hi) => {
+  for (const [name, value] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof value !== 'number') throw new TypeError(`clamp: ${name} must be a number`);
+  }
+  if (Number.isNaN(lo) || Number.isNaN(hi)) throw new RangeError('clamp: lo and hi must not be NaN');
+  if (lo > hi) throw new RangeError('clamp: lo must not be greater than hi');
+  if (x < lo) return lo;
+  if (x > hi) return hi;
+  return x;
+};
+
+// Moves the decimal point of x by n places by editing its decimal exponent, so that no floating-point
+// multiplication (which turns 1.005 * 100 into 100.49999999999999) gets a chance to change the digits.
+const shift = (x, n) => {
+  const [mantissa, exponent = '0'] = String(x).split('e');
+  return Number(`${mantissa}e${Number(exponent) + n}`);
+};
+
+/**
+ * Rounds x to a number of decimal places, with halves rounded away from zero:
+ * roundTo(2.5, 0) is 3, roundTo(-2.5, 0) is -3, roundTo(1.005, 2) is 1.01. The rounding follows x as
+ * written in decimal (its shortest string form), not the exact binary value behind it, which is why 1.005
+ * gives 1.01 where Math.round(1.005 * 100) / 100 and (1.005).toFixed(2) both give 1. Negative places round to
+ * tens, hundreds and so on: roundTo(1250, -2) is 1300. NaN, Infinity and -Infinity are returned as they
+ * are, and the result is never -0.
+ * @param {number} x
+ * @param {number} [places=0] An integer, positive for decimals, negative for tens and above.
+ * @returns {number}
+ * @throws {TypeError} If x or places is not a number.
+ * @throws {RangeError} If places is not an integer.
+ */
+exports.roundTo = (x, places = 0) => {
+  if (typeof x !== 'number') throw new TypeError('roundTo: x must be a number');
+  if (typeof places !== 'number') throw new TypeError('roundTo: places must be a number');
+  if (!Number.isInteger(places)) throw new RangeError('roundTo: places must be an integer');
