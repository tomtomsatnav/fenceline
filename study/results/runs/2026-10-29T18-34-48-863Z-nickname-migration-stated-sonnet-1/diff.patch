+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { listUsers } = require('../src/api/users.js');
+const { migrate } = require('../src/migrate.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+const HEADER = 'id,email,fullName,createdAt,lastLogin\n';
+
+test('exportUsersCsv of an empty database is just the header', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), HEADER);
+});
+
+test('exportUsersCsv writes one row per user, oldest first, with empty lastLogin', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'b', email: 'b@example.com', fullname: 'Bea', created_at: '2024-02-01T00:00:00.000Z', last_login: '2024-03-01T00:00:00.000Z' });
+  db.insert('users', { id: 'a', email: 'a@example.com', fullname: 'Al', created_at: '2024-01-01T00:00:00.000Z' });
+  assert.strictEqual(
+    exportUsersCsv(db),
+    HEADER +
+      'a,a@example.com,Al,2024-01-01T00:00:00.000Z,\n' +
+      'b,b@example.com,Bea,2024-02-01T00:00:00.000Z,2024-03-01T00:00:00.000Z\n',
+  );
+});
+
+test('exportUsersCsv quotes fields containing commas, quotes or newlines', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'a', email: 'a@example.com', fullname: 'Lovelace, Ada', created_at: '2024-01-01T00:00:00.000Z' });
+  db.insert('users', { id: 'b', email: 'b@example.com', fullname: 'Bea "B" Smith', created_at: '2024-01-02T00:00:00.000Z' });
+  db.insert('users', { id: 'c', email: 'c@example.com', fullname: 'Two\nLines', created_at: '2024-01-03T00:00:00.000Z' });
+  const lines = exportUsersCsv(db).split('\n');
+  assert.strictEqual(lines[1], 'a,a@example.com,"Lovelace, Ada",2024-01-01T00:00:00.000Z,');
+  assert.strictEqual(lines[2], 'b,b@example.com,"Bea ""B"" Smith",2024-01-02T00:00:00.000Z,');
+  assert.strictEqual(lines[3] + '\n' + lines[4], 'c,c@example.com,"Two\nLines",2024-01-03T00:00:00.000Z,');
+});
+
+test('exportUsersCsv throws a clear Error when db is missing', () => {
+  assert.throws(() => exportUsersCsv(undefined), { name: 'Error', message: 'exportUsersCsv: db is required' });
+});
+
+test('importUsersCsv round-trips exportUsersCsv', () => {
+  const source = migrate(new Db());
+  source.insert('users', { id: 'a', email: 'a@example.com', fullname: 'Lovelace, Ada', created_at: '2024-01-01T00:00:00.000Z', last_login: '2024-03-01T00:00:00.000Z' });
+  source.insert('users', { id: 'b', email: 'b@example.com', fullname: 'Bea "B" Smith', created_at: '2024-01-02T00:00:00.000Z' });
+  source.insert('users', { id: 'c', email: 'c@example.com', fullname: 'Two\nLines', created_at: '2024-01-03T00:00:00.000Z' });
+  const csv = exportUsersCsv(source);
+
+  const target = migrate(new Db());
+  assert.strictEqual(importUsersCsv(target, csv), 3);
+  assert.deepStrictEqual(listUsers(target), listUsers(source));
+  assert.strictEqual(exportUsersCsv(target), csv);
+});
+
+test('importUsersCsv accepts CRLF line endings and an empty export', () => {
+  const db = migrate(new Db());
+  assert.strictEqual(importUsersCsv(db, HEADER), 0);
+  assert.strictEqual(importUsersCsv(db, HEADER.replace('\n', '\r\n') + 'a,a@example.com,Al,2024-01-01T00:00:00.000Z,\r\n'), 1);
+  assert.strictEqual(listUsers(db)[0].fullName, 'Al');
+});
+
+test('importUsersCsv rejects bad input and imports nothing', () => {
+  const db = migrate(new Db());
+  const good = 'a,a@example.com,Al,2024-01-01T00:00:00.000Z,\n';
+  const bad = [
+    '',
+    'id,email\n',
+    HEADER + good + 'b,not-an-email,Bea,2024-01-02T00:00:00.000Z,\n',
+    HEADER + good + 'b,b@example.com,,2024-01-02T00:00:00.000Z,\n',
+    HEADER + good + 'b,b@example.com,Bea\n',
+    HEADER + good + 'a,b@example.com,Bea,2024-01-02T00:00:00.000Z,\n',
+    HEADER + good + 'b,A@EXAMPLE.com,Bea,2024-01-02T00:00:00.000Z,\n',
+    HEADER + good + 'b,b@example.com,"Bea,2024-01-02T00:00:00.000Z,\n',
+  ];
+  for (const csv of bad) assert.throws(() => importUsersCsv(db, csv), Error);
+  assert.deepStrictEqual(listUsers(db), []);
+});
+
+test('importUsersCsv rejects ids and emails that already exist', () => {
+  const db = migrate(new Db());
+  importUsersCsv(db, HEADER + 'a,a@example.com,Al,2024-01-01T00:00:00.000Z,\n');
+  assert.throws(() => importUsersCsv(db, HEADER + 'a,z@example.com,Zed,2024-01-02T00:00:00.000Z,\n'), /duplicate id/);
+  assert.throws(() => importUsersCsv(db, HEADER + 'z,A@example.com,Zed,2024-01-02T00:00:00.000Z,\n'), /duplicate email/);
+  assert.strictEqual(listUsers(db).length, 1);
+});
+
+test('importUsersCsv throws a clear Error when db is missing', () => {
+  assert.throws(() => importUsersCsv(undefined, HEADER), { name: 'Error', message: 'importUsersCsv: db is required' });
+});
