+});
+
+test('groupBy turns keys into property names, so 1 and "1" share a group', () => {
+  assert.deepStrictEqual(plain(groupBy([1, '1', 2], (x) => x)), { 1: [1, '1'], 2: [2] });
+  assert.deepStrictEqual(plain(groupBy([true, false, true], (x) => x)), { true: [true, true], false: [false] });
