+  return chars.every((c, i) => c === chars[chars.length - 1 - i]);
+};
+
+const wrapLine = (line, width) => {
+  const lines = [];
+  let current = '';
+  let currentLength = 0;
+  for (const word of line.split(/[^\S\r\n]+/).filter((w) => w !== '')) {
+    const wordLength = Array.from(word).length;
+    if (currentLength === 0) {
+      current = word;
+      currentLength = wordLength;
+    } else if (currentLength + 1 + wordLength <= width) {
+      current += ` ${word}`;
+      currentLength += 1 + wordLength;
+    } else {
+      lines.push(current);
+      current = word;
+      currentLength = wordLength;
+    }
+  }
+  lines.push(current);
+  return lines;
+};
+
+/**
+ * Inserts line breaks so no line is longer than width, breaking only between words and filling each
+ * line as far as it will go. Existing line breaks (\n, \r\n or \r) are kept as hard breaks, so blank
+ * lines and a trailing newline survive, and the result always uses "\n". Within a line, runs of spaces
+ * and tabs become a single space and the ends are trimmed. Length is counted in code points. A word
+ * longer than width cannot be broken, so it is put on a line of its own and that line is too long.
+ * @param {string} text
+ * @param {number} width A positive integer, or Infinity to only break at existing line breaks.
+ * @returns {string}
+ * @throws {TypeError} If text is not a string.
+ * @throws {RangeError} If width is not a positive integer or Infinity.
+ */
+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new TypeError('wrap: text must be a string');
+  if (width !== Infinity && !(Number.isInteger(width) && width >= 1)) throw new RangeError('wrap: width must be a positive integer');
+  return text.split(/\r\n|\r|\n/).flatMap((line) => wrapLine(line, width)).join('\n');
+};
+
+/**
+ * Fills {placeholders} in a string from an object, e.g. template("Hi {name}", { name: "Ada" }) gives "Hi Ada".
+ * A placeholder is a name in braces with no whitespace or braces inside it. One whose name is not an own
+ * property of values, or whose value is undefined, is left as it is, braces included, so "{constructor}"
+ * is never filled from Object.prototype. Other values are converted with String() (null gives "null").
+ * Filling is a single pass: text inserted for a placeholder is not itself searched for placeholders.
+ * @param {string} str
+ * @param {Record<string, unknown>} [values={}]
+ * @returns {string}
+ * @throws {TypeError} If str is not a string, or values is not an object.
+ */
+exports.template = (str, values = {}) => {
+  if (typeof str !== 'string') throw new TypeError('template: str must be a string');
+  if (typeof values !== 'object' || values === null) throw new TypeError('template: values must be an object');
+  return str.replace(/\{([^{}\s]+)\}/g, (placeholder, name) => {
+    const value = Object.hasOwn(values, name) ? values[name] : undefined;
+    return value === undefined ? placeholder : String(value);
+  });
+};
