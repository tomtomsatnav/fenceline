+// Neumaier's compensated sum: keeps the low-order bits that plain addition drops, so that
+// 0.1 + 0.2 + 0.3 comes out as 0.6 rather than 0.6000000000000001.
+const compensatedSum = (values) => {
+  let sum = 0;
+  let lost = 0;
+  for (const x of values) {
+    const t = sum + x;
+    lost += Math.abs(sum) >= Math.abs(x) ? (sum - t) + x : (x - t) + sum;
+    sum = t;
+  }
+  return sum + lost;
