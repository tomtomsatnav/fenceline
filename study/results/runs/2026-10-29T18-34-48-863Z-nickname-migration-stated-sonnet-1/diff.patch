+  // Reads a numeral the usual way: a smaller symbol before a larger one is subtracted.
+  const parse = (roman) => [...roman].reduce((total, c, i) => (values[c] < (values[roman[i + 1]] ?? 0) ? total - values[c] : total + values[c]), 0);
+  const valid = /^M{0,3}(CM|CD|D?C{0,3})(XC|XL|L?X{0,3})(IX|IV|V?I{0,3})$/;
+  const seen = new Set();
+  for (let n = 1; n <= 3999; n++) {
+    const roman = toRoman(n);
+    if (!valid.test(roman)) assert.fail(`toRoman(${n}) = ${roman} is not a well-formed numeral`);
+    if (parse(roman) !== n) assert.fail(`toRoman(${n}) = ${roman} reads as ${parse(roman)}`);
+    seen.add(roman);
