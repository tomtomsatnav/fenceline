+  else if (days < 30) amount = plural(Math.floor(days / 7), 'week');
+  else if (days < 365) amount = plural(Math.min(11, Math.floor(days / 30)), 'month');
+  else amount = plural(Math.floor(days / 365), 'year');
+  return difference < 0 ? `${amount} ago` : `in ${amount}`;
+};
