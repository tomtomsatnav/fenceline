+ * and one with fewer than n items gives [] (no partial windows, unlike chunk). The input is not
+ * changed, and each window is a new array holding the same items (holes in a sparse array become undefined).
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n The window length: a positive integer.
+ * @returns {T[][]} xs.length - n + 1 windows, or [] if there are none.
+ * @throws {TypeError} If xs is not an array.
+ * @throws {RangeError} If n is not a positive integer.
+ */
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed: xs must be an array');
+  if (!(Number.isInteger(n) && n >= 1)) throw new RangeError('windowed: n must be a positive integer');
+  const windows = [];
+  for (let i = 0; i + n <= xs.length; i++) windows.push(Array.from(xs.slice(i, i + n)));
+  return windows;
+};
