+
+test('groupBy calls keyFn once per item with only the item', () => {
+  const calls = [];
+  groupBy(['a', 'b', 'a'], (...args) => { calls.push(args); return args[0]; });
+  assert.deepStrictEqual(calls, [['a'], ['b'], ['a']]);
