+/**
+ * Converts words separated by spaces, hyphens or underscores to camelCase,
+ * e.g. "hello world", "hello-world" and "hello_world" all become "helloWorld".
+ * Runs of separators and leading or trailing ones are ignored, and every word is
+ * lowercased apart from the first letter of each word after the first.
+ * @param {string} str
+ * @returns {string} The camelCased string; "" if there are no words.
+ * @throws {TypeError} If str is not a string.
+ */
+exports.camelCase = (str) => {
+  if (typeof str !== 'string') throw new TypeError('camelCase: str must be a string');
+  return str
+    .split(/[\s_-]+/)
+    .filter((word) => word !== '')
+    .map((word, i) => {
+      const lower = word.toLowerCase();
+      return i === 0 ? lower : lower[0].toUpperCase() + lower.slice(1);
+    })
+    .join('');
+};
+
+/**
+ * Converts a string to kebab-case, e.g. "helloWorld" and "Hello World" both become "hello-world".
+ * Words are split at spaces, hyphens, underscores, lowercase-to-uppercase changes and the end of an
+ * acronym ("XMLHttpRequest" becomes "xml-http-request"). Runs of separators and leading or trailing
+ * ones are ignored, and digits stay attached to the word before them.
+ * @param {string} str
+ * @returns {string} The kebab-cased string; "" if there are no words.
+ * @throws {TypeError} If str is not a string.
+ */
+exports.kebabCase = (str) => {
+  if (typeof str !== 'string') throw new TypeError('kebabCase: str must be a string');
+  return str
+    .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
+    .replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2')
+    .split(/[\s_-]+/)
+    .filter((word) => word !== '')
+    .map((word) => word.toLowerCase())
+    .join('-');
+};
+
+/**
+ * Shortens a string to at most n characters, ending in "…" when anything was cut.
+ * The "…" counts towards n, and characters are counted as code points, so an emoji is never split.
+ * A string that already fits is returned unchanged. With n = 0 nothing fits, not even "…", so the result is "".
+ * @param {string} s
+ * @param {number} n Maximum length: a non-negative integer, or Infinity for no limit.
+ * @returns {string}
+ * @throws {TypeError} If s is not a string.
+ * @throws {RangeError} If n is not a non-negative integer or Infinity.
+ */
+exports.truncate = (s, n) => {
+  if (typeof s !== 'string') throw new TypeError('truncate: s must be a string');
+  if (n !== Infinity && !(Number.isInteger(n) && n >= 0)) throw new RangeError('truncate: n must be a non-negative integer');
+  const chars = Array.from(s);
+  if (chars.length <= n) return s;
+  return n === 0 ? '' : chars.slice(0, n - 1).join('') + '…';
+};
+
+/**
+ * Centres a string in a field of the given width by padding both sides with ch.
+ * When the padding is odd the extra character goes on the right. A string at least as wide as
+ * the field is returned unchanged, never truncated. Characters are counted as code points.
+ * @param {string} s
+ * @param {number} width A non-negative integer.
+ * @param {string} [ch=" "] The padding character: a string of exactly one character.
+ * @returns {string}
+ * @throws {TypeError} If s or ch is not a string.
+ * @throws {RangeError} If width is not a non-negative integer, or ch is not exactly one character.
+ */
+exports.padCenter = (s, width, ch = ' ') => {
+  if (typeof s !== 'string') throw new TypeError('padCenter: s must be a string');
+  if (!(Number.isInteger(width) && width >= 0)) throw new RangeError('padCenter: width must be a non-negative integer');
