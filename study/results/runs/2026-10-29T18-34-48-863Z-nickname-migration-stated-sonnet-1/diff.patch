+const seedFive = () => {
+  const db = migrate(new Db());
+  ['e', 'c', 'a', 'd', 'b'].forEach((id) => {
+    db.insert('users', { id, email: `${id}@example.com`, fullname: id, created_at: `2024-01-0${id.charCodeAt(0) - 96}T00:00:00.000Z` });
+  });
+  return db;
+};
+const ids = (users) => users.map((u) => u.id);
+
+test('listUsers returns everyone by default', () => {
+  assert.deepStrictEqual(ids(listUsers(seedFive())), ['a', 'b', 'c', 'd', 'e']);
+});
+
+test('listUsers paginates with limit and offset over the sorted order', () => {
+  const db = seedFive();
+  assert.deepStrictEqual(ids(listUsers(db, { limit: 2 })), ['a', 'b']);
+  assert.deepStrictEqual(ids(listUsers(db, { limit: 2, offset: 2 })), ['c', 'd']);
+  assert.deepStrictEqual(ids(listUsers(db, { limit: 2, offset: 4 })), ['e']);
+  assert.deepStrictEqual(ids(listUsers(db, { offset: 3 })), ['d', 'e']);
+});
+
+test('listUsers pagination edge cases', () => {
+  const db = seedFive();
+  assert.deepStrictEqual(listUsers(db, { limit: 0 }), []);
+  assert.deepStrictEqual(listUsers(db, { offset: 10 }), []);
+  assert.throws(() => listUsers(db, { limit: -1 }), Error);
+  assert.throws(() => listUsers(db, { limit: 1.5 }), Error);
+  assert.throws(() => listUsers(db, { offset: -1 }), Error);
+});
