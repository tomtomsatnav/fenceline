+const { types } = require('node:util');
+
+/**
+ * Returns a new Date that many calendar days away from date, in local time: addDays(new Date(2024, 0, 31), 1)
+ * is 1 February 2024, and n may be negative to go back. The time of day is kept, so across a daylight-saving
+ * change the gap is 23 or 25 hours, not 24 (if the kept time does not exist on the new day, because the clocks
+ * skipped it, the result lands an hour later). Month and year ends and leap days are handled. date is not changed.
+ * @param {Date} date
+ * @param {number} n A whole number of days, positive, negative or 0.
+ * @returns {Date} A new Date, even when n is 0.
+ * @throws {TypeError} If date is not a Date, or n is not a number.
+ * @throws {RangeError} If date is an Invalid Date, n is not an integer (NaN and the infinities included), or
+ * the result is outside the range a Date can hold (about 270,000 years either side of 1970).
+ */
+exports.addDays = (date, n) => {
+  if (!types.isDate(date)) throw new TypeError('addDays: date must be a Date');
+  if (typeof n !== 'number') throw new TypeError('addDays: n must be a number');
+  if (Number.isNaN(date.getTime())) throw new RangeError('addDays: date must be a valid Date');
+  if (!Number.isInteger(n)) throw new RangeError('addDays: n must be an integer');
+  const result = new Date(date.getTime());
+  result.setDate(result.getDate() + n);
+  if (Number.isNaN(result.getTime())) throw new RangeError('addDays: the result is outside the range of dates');
+  return result;
+};
+
+const MS_PER_DAY = 86400000;
+
+// The UTC day a Date falls on, counted from 1970-01-01 (day 0); negative before that. Pure integer
+// arithmetic, so there is no rounding to go wrong at midnight.
+const utcDayNumber = (date) => {
+  const ms = date.getTime();
+  const sinceMidnight = ((ms % MS_PER_DAY) + MS_PER_DAY) % MS_PER_DAY;
+  return (ms - sinceMidnight) / MS_PER_DAY;
+};
+
+/**
+ * The number of days from one date to another, counting UTC calendar days and ignoring the time of day:
+ * daysBetween(new Date("2024-03-01T23:59Z"), new Date("2024-03-02T00:01Z")) is 1, though only two minutes
+ * apart, and the same two days at 00:01 and 23:59 are 0 apart. The result is negative when `to` is on an
+ * earlier day than `from`, and swapping the arguments flips its sign. The local time zone and daylight saving
+ * play no part. Always a whole number, never -0.
