+/**
+ * Picks the name to show for a user.
+ * @param {{email: string, fullName?: string|null}} user
+ * @returns {string} The fullName, or the part of the email before the first "@" when fullName is missing, empty or blank.
+ */
+exports.displayName = (user) => {
+  if (typeof user.fullName === 'string' && user.fullName.trim() !== '') return user.fullName;
+  return user.email.split('@')[0];
+};
