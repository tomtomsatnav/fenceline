+ * daylight saving: 24 hours later is "1 day" even if the clocks changed in between. English only.
+ * @param {Date} date The moment to describe.
+ * @param {Date} [now=new Date()] The moment to measure from.
+ * @returns {string}
+ * @throws {TypeError} If date or now is not a Date.
+ * @throws {RangeError} If date or now is an Invalid Date.
+ */
+exports.relativeTime = (date, now = new Date()) => {
+  for (const [name, value] of [['date', date], ['now', now]]) {
+    if (!types.isDate(value)) throw new TypeError(`relativeTime: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`relativeTime: ${name} must be a valid Date`);
+  }
