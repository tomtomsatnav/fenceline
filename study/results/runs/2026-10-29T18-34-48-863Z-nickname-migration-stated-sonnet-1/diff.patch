diff --git a/README.md b/README.md
new file mode 100644
index 0000000..98b3fe7
--- /dev/null
+++ b/README.md
@@ -0,0 +1,52 @@
+## Users API
+
+The functions in `src/api/` work on an in-memory `Db` (`src/db.js`) with the `users` table set up by `migrate`.
+
+```js
+const { Db } = require('./src/db.js');
+const { migrate } = require('./src/migrate.js');
+const { createUser, listUsers } = require('./src/api/users.js');
+
+const db = migrate(new Db());
+createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+listUsers(db); // [{ id, email, fullName, createdAt, lastLogin: null }]
+```
+
+Every function in `users.js` and `export.js` takes `db` first and throws an `Error` such as `getUser: db is required` if it is missing. All errors below are plain `Error`s.
+
+### User objects
+
+| Field       | Type             | Notes                                            |
+| ----------- | ---------------- | ------------------------------------------------ |
+| `id`        | string           | Generated UUID.                                  |
+| `email`     | string           | Contains `@`; unique, ignoring case.             |
+| `fullName`  | string           | 1–100 characters.                                |
+| `createdAt` | string           | ISO 8601 timestamp.                              |
+| `lastLogin` | string \| `null` | ISO 8601 timestamp; `null` if never logged in.   |
+
+### `src/api/users.js`
+
+| Function | Description |
+| -------- | ----------- |
+| `createUser(db, { email, fullName })` | Creates a user and returns it. Throws if the email has no `@`, is already used (ignoring case), or `fullName` is not a string of 1–100 characters. |
+| `getUser(db, id)` | Returns the user with that id, or `null`. |
+| `getUserByEmail(db, email)` | Returns the user with that email, ignoring case, or `null`. |
+| `updateUser(db, id, { email, fullName })` | Changes only the fields given and returns the updated user. The same rules as `createUser` apply; a user may re-submit their own email. Throws if the user does not exist. If it throws, nothing is changed. |
+| `deleteUser(db, id)` | Removes the user. Returns `true`, or `false` if there was no such user. |
+| `recordLogin(db, id, when)` | Sets `lastLogin` (`when` is an ISO timestamp, default now) and returns the updated user. Throws if the user does not exist. |
+| `searchUsers(db, query)` | Users whose `fullName` or `email` contains `query`, ignoring case, oldest first. An empty query matches everyone. |
+| `countUsers(db)` | The number of users. |
+| `listUsers(db, { limit, offset })` | Users sorted by `createdAt`, oldest first. `limit` defaults to no limit and `offset` to `0`; both must be non-negative integers or it throws. |
+
+### `src/api/export.js`
+
+| Function | Description |
+| -------- | ----------- |
+| `exportUsersCsv(db)` | CSV text with the header `id,email,fullName,createdAt,lastLogin`, then one row per user, oldest first. Fields containing commas, quotes or newlines are quoted. Every line ends in `\n`. |
+| `importUsersCsv(db, csv)` | The inverse of `exportUsersCsv`: inserts the users, keeping their ids and timestamps, and returns how many were imported. Accepts `\n` or `\r\n` line endings. Throws, importing nothing, if the header or a row is malformed, or an id or email is repeated in the file or already in `db`. |
+
+### `src/api/format.js`
+
+| Function | Description |
+| -------- | ----------- |
+| `displayName(user)` | `user.fullName`, or the part of `user.email` before the first `@` when `fullName` is missing, empty or blank. Does not take `db`. |
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..8e740f7
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,81 @@
+const { listUsers, getUserByEmail, getUser } = require('./users.js');
+
+const FIELDS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+const csvField = (value) => {
+  const s = value === null || value === undefined ? '' : String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replaceAll('"', '""')}"` : s;
+};
+
+/**
+ * Exports every user as CSV: a header row, then one row per user, oldest first.
+ * Fields containing commas, quotes or newlines are quoted. Every line, including the last, ends in "\n".
+ * @param {import('../db.js').Db} db
+ * @returns {string}
+ * @throws {Error} If db is missing.
+ */
+exports.exportUsersCsv = (db) => {
+  if (db === undefined || db === null) throw new Error('exportUsersCsv: db is required');
+  const lines = [FIELDS, ...listUsers(db).map((u) => FIELDS.map((f) => u[f]))];
+  return lines.map((cols) => cols.map(csvField).join(',') + '\n').join('');
+};
+
+// Splits CSV text into rows of fields, honouring the quoting exportUsersCsv produces.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c !== '"') field += c;
+      else if (text[i + 1] === '"') { field += '"'; i++; } else quoted = false;
+    } else if (c === '"' && field === '') {
+      quoted = true;
+    } else if (c === ',') {
+      row.push(field); field = '';
+    } else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      row.push(field); rows.push(row); row = []; field = '';
+    } else {
+      field += c;
+    }
+  }
+  if (quoted) throw new Error('importUsersCsv: unterminated quoted field');
+  if (field !== '' || row.length) { row.push(field); rows.push(row); }
+  return rows;
+};
+
+/**
+ * Inserts the users in a CSV produced by exportUsersCsv, keeping their ids and timestamps.
+ * Every row is validated first, so a bad CSV imports nothing.
+ * @param {import('../db.js').Db} db
+ * @param {string} csv
+ * @returns {number} How many users were imported.
+ * @throws {Error} If db is missing, the header or a row is malformed, or an id or email is duplicated in the file or already in db.
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (db === undefined || db === null) throw new Error('importUsersCsv: db is required');
+  if (typeof csv !== 'string') throw new Error('importUsersCsv: csv must be a string');
+  const [header, ...rows] = parseCsv(csv);
+  if (!header || header.join(',') !== FIELDS.join(',')) throw new Error(`importUsersCsv: header must be ${FIELDS.join(',')}`);
+  const seenIds = new Set();
+  const seenEmails = new Set();
+  const records = rows.map((cols, i) => {
+    const line = i + 2;
+    if (cols.length !== FIELDS.length) throw new Error(`importUsersCsv: line ${line}: expected ${FIELDS.length} fields`);
+    const [id, email, fullName, createdAt, lastLogin] = cols;
+    if (!id || !createdAt) throw new Error(`importUsersCsv: line ${line}: id and createdAt are required`);
+    if (!email.includes('@')) throw new Error(`importUsersCsv: line ${line}: invalid email`);
+    if (fullName.length === 0 || fullName.length > 100) throw new Error(`importUsersCsv: line ${line}: invalid fullName`);
+    const key = email.toLowerCase();
+    if (seenIds.has(id) || getUser(db, id)) throw new Error(`importUsersCsv: line ${line}: duplicate id ${id}`);
+    if (seenEmails.has(key) || getUserByEmail(db, email)) throw new Error(`importUsersCsv: line ${line}: duplicate email ${email}`);
+    seenIds.add(id);
+    seenEmails.add(key);
+    return { id, email, fullname: fullName, created_at: createdAt, ...(lastLogin !== '' && { last_login: lastLogin }) };
+  });
+  for (const record of records) db.insert('users', record);
+  return records.length;
+};
diff --git a/src/api/format.js b/src/api/format.js
