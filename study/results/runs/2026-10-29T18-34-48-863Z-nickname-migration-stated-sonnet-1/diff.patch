+  for (const [name, value] of [['from', from], ['to', to]]) {
+    if (!types.isDate(value)) throw new TypeError(`daysBetween: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`daysBetween: ${name} must be a valid Date`);
+  }
