+});
+
+test('chunk throws a RangeError when n is not a positive integer', () => {
+  for (const bad of [0, -1, 1.5, NaN, Infinity, '2', null, undefined]) assert.throws(() => chunk([1, 2, 3], bad), RangeError);
+});
+
+test('uniqueBy keeps the first item for each key', () => {
+  const users = [
+    { id: 1, email: 'a@example.com' },
+    { id: 2, email: 'b@example.com' },
+    { id: 3, email: 'a@example.com' },
+    { id: 4, email: 'b@example.com' },
+    { id: 5, email: 'c@example.com' },
+  ];
+  assert.deepStrictEqual(uniqueBy(users, (u) => u.email).map((u) => u.id), [1, 2, 5]);
+});
+
+test('uniqueBy keeps the original order', () => {
+  assert.deepStrictEqual(uniqueBy([3, 1, 3, 2, 1], (x) => x), [3, 1, 2]);
+  assert.deepStrictEqual(uniqueBy(['bb', 'a', 'cc', 'd'], (s) => s.length), ['bb', 'a']);
+});
+
+test('uniqueBy returns the original items, not the keys', () => {
+  const a = { k: 1 };
+  const b = { k: 1 };
+  const result = uniqueBy([a, b], (o) => o.k);
+  assert.strictEqual(result.length, 1);
+  assert.strictEqual(result[0], a);
+});
+
+test('uniqueBy returns [] for an empty array and a copy when all keys differ', () => {
+  assert.deepStrictEqual(uniqueBy([], (x) => x), []);
+  const xs = [1, 2, 3];
+  const result = uniqueBy(xs, (x) => x);
+  assert.deepStrictEqual(result, xs);
+  assert.notStrictEqual(result, xs);
+});
+
+test('uniqueBy does not change its input', () => {
+  const xs = [1, 1, 2];
+  uniqueBy(xs, (x) => x);
+  assert.deepStrictEqual(xs, [1, 1, 2]);
+});
+
+test('uniqueBy compares keys by value for primitives and by identity for objects', () => {
+  assert.deepStrictEqual(uniqueBy([1, '1', 1, '1'], (x) => x), [1, '1']);
+  const key = {};
+  assert.deepStrictEqual(uniqueBy([1, 2, 3], (x) => (x === 3 ? {} : key)).length, 2);
+  assert.deepStrictEqual(uniqueBy([[1], [1]], (x) => x).length, 2);
