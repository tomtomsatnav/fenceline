+  while (y !== 0) [x, y] = [y, x % y];
+  return x;
+};
+
+const ROMAN_NUMERALS = [
+  [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'], [100, 'C'], [90, 'XC'],
+  [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
+];
+
+/**
+ * Converts an integer from 1 to 3999 to a Roman numeral in the usual subtractive form:
+ * toRoman(4) is "IV", toRoman(1994) is "MCMXCIV" and toRoman(3999) is "MMMCMXCIX". Roman numerals have no
+ * zero or negative numbers, and writing 4000 and up needs symbols outside the standard set, so those throw.
+ * @param {number} n
+ * @returns {string} Upper-case letters from I, V, X, L, C, D and M.
+ * @throws {TypeError} If n is not a number.
+ * @throws {RangeError} If n is not an integer from 1 to 3999 (NaN, infinities and fractions included).
+ */
+exports.toRoman = (n) => {
+  if (typeof n !== 'number') throw new TypeError('toRoman: n must be a number');
+  if (!Number.isInteger(n) || n < 1 || n > 3999) throw new RangeError('toRoman: n must be an integer from 1 to 3999');
