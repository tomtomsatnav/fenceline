index 0000000..27c0d87
--- /dev/null
+++ b/src/lib/arrays.js
@@ -0,0 +1,246 @@
+/**
+ * Splits an array into consecutive arrays of length n; the last one is shorter when n does not
+ * divide the length evenly. The input is not changed, and the chunks are new arrays holding the
+ * same elements (shallow copies).
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n The chunk length: a positive integer. A value larger than xs.length gives a single chunk.
+ * @returns {T[][]} The chunks; [] for an empty array.
+ * @throws {TypeError} If xs is not an array.
+ * @throws {RangeError} If n is not a positive integer.
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk: xs must be an array');
+  if (!(Number.isInteger(n) && n >= 1)) throw new RangeError('chunk: n must be a positive integer');
+  const chunks = [];
+  for (let i = 0; i < xs.length; i += n) chunks.push(xs.slice(i, i + n));
+  return chunks;
+};
+
+/**
+ * Keeps the first item for each key, in the original order: uniqueBy(users, (u) => u.email).
+ * Keys are compared like Set members (SameValueZero): primitives by value, objects by identity,
+ * and NaN equals NaN. keyFn is called once per item, with the item only, and items whose key is
+ * undefined or null are still compared like any other key. The input is not changed.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => unknown} keyFn
+ * @returns {T[]} A new array without the later items that repeat a key; [] for an empty array.
+ * @throws {TypeError} If xs is not an array or keyFn is not a function.
+ */
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('uniqueBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('uniqueBy: keyFn must be a function');
+  const seen = new Set();
+  const result = [];
+  for (const item of xs) {
+    const key = keyFn(item);
+    if (!seen.has(key)) {
+      seen.add(key);
+      result.push(item);
+    }
+  }
+  return result;
+};
+
+/**
+ * Groups items by the key keyFn gives them: groupBy([1, 2, 3], (x) => x % 2 ? "odd" : "even") gives
+ * { odd: [1, 3], even: [2] }. Within a group items keep their original order. Keys become property
+ * names as usual (numbers and booleans turn into strings, so 1 and "1" share a group, and
+ * integer-like keys are listed first). The result has no prototype, like Object.groupBy, so keys such
+ * as "__proto__" and "constructor" are ordinary groups. keyFn is called once per item, with the item only.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => string | number | boolean | symbol | null | undefined} keyFn
+ * @returns {Record<string, T[]>} A new object of new arrays; an empty object for an empty array.
+ * @throws {TypeError} If xs is not an array or keyFn is not a function.
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy: keyFn must be a function');
+  const groups = Object.create(null);
+  for (const item of xs) {
+    const key = keyFn(item);
+    (groups[key] ??= []).push(item);
+  }
+  return groups;
+};
+
+/**
+ * Splits an array in two by a predicate: partition([1, 2, 3, 4], (x) => x % 2 === 0) gives [[2, 4], [1, 3]].
+ * An item matches when pred returns a truthy value. Both arrays keep the original order, together they
+ * hold every item exactly once, and the input is not changed. pred is called once per item, with the
+ * item only.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => unknown} pred
+ * @returns {[T[], T[]]} [matching, notMatching], both new arrays; [[], []] for an empty array.
+ * @throws {TypeError} If xs is not an array or pred is not a function.
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition: xs must be an array');
+  if (typeof pred !== 'function') throw new TypeError('partition: pred must be a function');
+  const matching = [];
+  const notMatching = [];
+  for (const item of xs) (pred(item) ? matching : notMatching).push(item);
+  return [matching, notMatching];
+};
+
+/**
+ * Pairs up the items of two arrays by position: zip([1, 2, 3], ['a', 'b']) gives [[1, 'a'], [2, 'b']].
+ * It stops at the shorter array, so extra items in the longer one are dropped. The inputs are not
+ * changed, and each pair is a new two-item array.
+ * @template A, B
+ * @param {A[]} a
+ * @param {B[]} b
+ * @returns {[A, B][]} The pairs; [] if either array is empty.
+ * @throws {TypeError} If a or b is not an array.
+ */
+exports.zip = (a, b) => {
+  if (!Array.isArray(a)) throw new TypeError('zip: a must be an array');
+  if (!Array.isArray(b)) throw new TypeError('zip: b must be an array');
+  const length = Math.min(a.length, b.length);
+  const pairs = [];
+  for (let i = 0; i < length; i++) pairs.push([a[i], b[i]]);
+  return pairs;
+};
+
+/**
+ * Makes an array of numbers from start up to but not including end, moving by step:
+ * range(0, 5) gives [0, 1, 2, 3, 4], range(10, 0, -3) gives [10, 7, 4, 1]. A step that points away from
+ * end, or start equal to end, gives []. Each value is start + i * step, so fractional steps do not
+ * pile up rounding error, though a value can still be a little off (range(0, 1, 0.3) has 0.8999999999999999).
+ * @param {number} start
+ * @param {number} end Exclusive.
+ * @param {number} [step=1] Non-zero; negative to count down.
+ * @returns {number[]}
+ * @throws {TypeError} If start, end or step is not a number.
+ * @throws {RangeError} If start, end or step is not finite, step is 0, or the result would be longer than an array can be.
+ */
+exports.range = (start, end, step = 1) => {
+  for (const [name, value] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof value !== 'number') throw new TypeError(`range: ${name} must be a number`);
+    if (!Number.isFinite(value)) throw new RangeError(`range: ${name} must be finite`);
+  }
+  if (step === 0) throw new RangeError('range: step must not be 0');
+  const count = Math.ceil((end - start) / step);
+  if (count > 2 ** 32 - 1) throw new RangeError('range: too many values');
+  const values = [];
+  for (let i = 0; i < count; i++) values.push(start + i * step);
+  return values;
+};
+
+/**
+ * Flattens arbitrarily nested arrays into one array, keeping the left-to-right order of the items:
+ * flattenDeep([1, [2, [3, [4]], 5]]) gives [1, 2, 3, 4, 5]. Only real arrays are opened; strings, Sets,
+ * array-like objects and everything else stay as single items. Empty nested arrays disappear, and holes
+ * in sparse arrays come through as undefined. It does not recurse, so nesting of any depth is fine, and
+ * the same array may appear in several places, but an array that contains itself (directly or through
+ * other arrays) throws. The input is not changed.
+ * @param {unknown[]} xs
+ * @returns {unknown[]} A new, flat array; [] for an empty array.
+ * @throws {TypeError} If xs is not an array, or arrays contain themselves.
+ */
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep: xs must be an array');
