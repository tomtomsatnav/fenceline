+
+test('groupBy works with falsy items', () => {
+  const groups = groupBy([0, null, undefined, '', false, 0], (x) => typeof x);
+  assert.deepStrictEqual(plain(groups), { number: [0, 0], object: [null], undefined: [undefined], string: [''], boolean: [false] });
