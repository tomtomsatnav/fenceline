+  const shifted = shift(Math.abs(x), places);
+  if (!Number.isFinite(shifted)) return x; // so many places that x has no digits left to round
+  const rounded = shift(Math.round(shifted), -places) * Math.sign(x);
+  return rounded === 0 ? 0 : rounded;
+};
