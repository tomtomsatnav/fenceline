+// Dates are built from local-time parts, so these tests give the same result in any time zone.
+const ymd = (d) => [d.getFullYear(), d.getMonth() + 1, d.getDate()];
+
+test('addDays adds days', () => {
+  assert.deepStrictEqual(ymd(addDays(new Date(2024, 5, 10), 1)), [2024, 6, 11]);
+  assert.deepStrictEqual(ymd(addDays(new Date(2024, 5, 10), 7)), [2024, 6, 17]);
