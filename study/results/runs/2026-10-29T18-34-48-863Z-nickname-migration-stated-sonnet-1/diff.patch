+
+test('partition handles everything or nothing matching', () => {
+  assert.deepStrictEqual(partition([1, 2, 3], () => true), [[1, 2, 3], []]);
+  assert.deepStrictEqual(partition([1, 2, 3], () => false), [[], [1, 2, 3]]);
