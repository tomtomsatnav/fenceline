+ * @returns {string} The reversed sentence; "" if there are no words.
+ * @throws {TypeError} If s is not a string.
+ */
+exports.reverseWords = (s) => {
+  if (typeof s !== 'string') throw new TypeError('reverseWords: s must be a string');
+  return s.split(/\s+/).filter((word) => word !== '').reverse().join(' ');
+};
+
+/**
+ * Tells whether a string reads the same backwards, looking only at its letters and digits and
+ * ignoring case, spaces and punctuation: "A man, a plan, a canal: Panama" is a palindrome.
+ * Accents count ("été" is a palindrome, "ete" and "été" are not the same letters), and characters
+ * are compared as code points. A string with no letters or digits, including "", reads the same
+ * backwards and is a palindrome.
+ * @param {string} s
+ * @returns {boolean}
+ * @throws {TypeError} If s is not a string.
+ */
