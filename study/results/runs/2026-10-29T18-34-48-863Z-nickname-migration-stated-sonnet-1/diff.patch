   const r = db.find('users', (u) => u.id === id);
-  if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return r ? fromRow(r) : null;
+};
+
+/**
+ * Finds a user by email, ignoring case.
+ * @param {import('../db.js').Db} db
+ * @param {string} email
+ * @returns {User|null} The user, or null if there is none.
+ * @throws {Error} If db is missing.
+ */
+exports.getUserByEmail = (db, email) => {
+  const wanted = String(email).toLowerCase();
+  const r = db.find('users', (u) => String(u.email).toLowerCase() === wanted);
+  return r ? fromRow(r) : null;
+};
+
+/**
+ * Changes only the fields given and leaves the rest as they are.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {{email?: string, fullName?: string}} [fields] Validated like createUser; an email may be re-submitted by its own user.
+ * @returns {User} The updated user.
+ * @throws {Error} If db is missing, the user does not exist, or a field is invalid. Nothing is written in that case.
+ */
+exports.updateUser = (db, id, { email, fullName } = {}) => {
+  if (!exports.getUser(db, id)) throw new Error(`No such user: ${id}`);
+  if (email !== undefined) {
+    if (typeof email !== 'string' || !email.includes('@')) throw new Error('Invalid email: missing "@"');
+    const other = exports.getUserByEmail(db, email);
+    if (other && other.id !== id) throw new Error(`Duplicate email: ${email}`);
+  }
+  if (fullName !== undefined) assertFullName(fullName);
+  db.update('users', (u) => u.id === id, toRow({ email, fullName }));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Removes a user.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @returns {boolean} true if a user was removed, false if there was no such user.
+ * @throws {Error} If db is missing.
+ */
+exports.deleteUser = (db, id) => db.delete('users', (u) => u.id === id) > 0;
+
+/**
+ * Sets a user's lastLogin.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {string} [when] ISO 8601 timestamp; defaults to now.
+ * @returns {User} The updated user.
+ * @throws {Error} If db is missing or the user does not exist.
+ */
+exports.recordLogin = (db, id, when = new Date().toISOString()) => {
+  if (!db.update('users', (u) => u.id === id, toRow({ lastLogin: when }))) throw new Error(`No such user: ${id}`);
+  return exports.getUser(db, id);
+};
+
+/**
+ * Finds users whose fullName or email contains the query, ignoring case.
+ * @param {import('../db.js').Db} db
+ * @param {string} query An empty query matches every user.
+ * @returns {User[]} Matches, oldest first.
+ * @throws {Error} If db is missing.
+ */
+exports.searchUsers = (db, query) => {
+  const q = String(query).toLowerCase();
+  return exports.listUsers(db).filter((u) => u.fullName.toLowerCase().includes(q) || u.email.toLowerCase().includes(q));
 };
+
+/**
+ * Counts the users.
+ * @param {import('../db.js').Db} db
+ * @returns {number}
+ * @throws {Error} If db is missing.
+ */
+exports.countUsers = (db) => db.all('users').length;
+
+/**
+ * Lists users sorted by createdAt, oldest first.
+ * @param {import('../db.js').Db} db
+ * @param {{limit?: number, offset?: number}} [page] limit defaults to no limit and offset to 0; both must be non-negative integers.
+ * @returns {User[]}
+ * @throws {Error} If db is missing or limit or offset is invalid.
+ */
+exports.listUsers = (db, { limit = Infinity, offset = 0 } = {}) => {
+  if (limit !== Infinity && !(Number.isInteger(limit) && limit >= 0)) throw new Error('Invalid limit');
+  if (!(Number.isInteger(offset) && offset >= 0)) throw new Error('Invalid offset');
+  const sorted = db.all('users').map(fromRow).sort((a, b) => a.createdAt.localeCompare(b.createdAt));
+  return sorted.slice(offset, limit === Infinity ? undefined : offset + limit);
+};
+
+// Every public function takes db first; fail clearly if it is missing.
+for (const name of Object.keys(exports)) {
+  const fn = exports[name];
+  exports[name] = (db, ...args) => {
+    if (db === undefined || db === null) throw new Error(`${name}: db is required`);
+    return fn(db, ...args);
+  };
+}
