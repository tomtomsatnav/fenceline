+  for (const key of keys) {
+    if (Object.prototype.propertyIsEnumerable.call(obj, key) && !Object.hasOwn(picked, key)) setOwn(picked, key, obj[key]);
+  }
+  return picked;
+};
+
+/**
+ * Returns a new object without the listed keys: omit({ a: 1, b: 2, c: 3 }, ['b']) -> { a: 1, c: 3 }.
+ * Everything else is copied: own enumerable properties, including symbol keys, in their original order.
+ * Keys that obj does not have (or only inherits) are simply ignored, and listing a key more than once is fine.
+ * Values are the same as in obj (shallow, not cloned; a getter is called once and its value stored). A key
+ * named "__proto__" is an ordinary property, and the result is always a plain object, whatever obj was.
+ * obj is not modified.
+ * @param {Object} obj Any non-null object (an array works, with index keys).
+ * @param {Array<string|number|symbol>} keys The keys to leave out.
