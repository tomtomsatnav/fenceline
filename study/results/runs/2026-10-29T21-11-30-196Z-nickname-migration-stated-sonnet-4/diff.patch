+ */
+exports.mean = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('mean: xs must be an array');
+  for (let i = 0; i < xs.length; i++) {
+    if (typeof xs[i] !== 'number') throw new TypeError(`mean: item ${i} must be a number`);
+  }
+  if (xs.length === 0) return NaN;
+  const values = Array.from(xs);
+  if (!values.every(Number.isFinite)) return values.reduce((a, b) => a + b, 0) / values.length;
+  const total = sum(values);
+  return Number.isFinite(total) ? total / values.length : sum(values, 1 / values.length);
+};
+
+/**
+ * Median of an array of numbers: the middle value once sorted, or the mean of the two middle values when the
+ * length is even. median([3, 1, 2]) -> 2, median([4, 1, 3, 2]) -> 2.5. An empty array gives NaN, and so does
+ * any array containing NaN. Infinities sort as expected, so median([-Infinity, 1, Infinity]) is 1. The input is
+ * not modified (and need not be sorted).
+ * @param {number[]} xs
+ * @returns {number}
+ * @throws {TypeError} If xs is not an array, or any item (including a hole in a sparse array) is not a number.
+ */
+exports.median = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('median: xs must be an array');
+  for (let i = 0; i < xs.length; i++) {
+    if (typeof xs[i] !== 'number') throw new TypeError(`median: item ${i} must be a number`);
+  }
+  if (xs.length === 0 || xs.some(Number.isNaN)) return NaN;
+  const sorted = Array.from(xs).sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
