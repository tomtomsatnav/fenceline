+const sum = (values, scale = 1) => {
+  let total = 0;
+  let compensation = 0;
+  for (const v of values) {
+    const x = v * scale;
+    const t = total + x;
+    compensation += Math.abs(total) >= Math.abs(x) ? (total - t) + x : (x - t) + total;
+    total = t;
+  }
+  return total + compensation;
