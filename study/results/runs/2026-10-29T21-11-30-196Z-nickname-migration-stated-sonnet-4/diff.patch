new file mode 100644
index 0000000..7af3206
--- /dev/null
+++ b/README.md
@@ -0,0 +1,47 @@
+## Users API
+
+The functions in `src/api/` take the database as their first argument and return plain objects. Every function in `users.js` and `export.js` throws an `Error` (`<name>: db is required`) if `db` is missing.
+
+A **user** looks like this:
+
+```js
+{ id, email, fullName, createdAt, lastLogin, nickname } // lastLogin is null until a login is recorded; nickname is null unless set
+```
+
+### `src/api/users.js`
+
+```js
+const users = require('./src/api/users.js');
+```
+
+| Function | Description |
+| --- | --- |
+| `createUser(db, { email, fullName, nickname })` | Creates a user and returns it. `nickname` is optional. `email` must contain `@` and not already be used (compared case-insensitively). `fullName` must be a string of 1–100 characters. Throws an `Error` otherwise. |
+| `getUser(db, id)` | Returns the user with that id, or `null`. |
+| `getUserByEmail(db, email)` | Returns the user with that email (case-insensitive), or `null`. |
+| `updateUser(db, id, { email, fullName })` | Changes only the fields given and returns the updated user, or `null` if there is no such user. The same validation as `createUser` applies; a user may keep their own email. |
+| `deleteUser(db, id)` | Removes the user. Returns `true`, or `false` if there was no such user. |
+| `recordLogin(db, id, when)` | Sets `lastLogin` (`when` is an ISO timestamp and defaults to now). Returns the updated user, or `null` if there is no such user. |
+| `countUsers(db)` | Returns the number of users. |
+| `listUsers(db, { limit, offset })` | Returns users sorted by `createdAt`, oldest first. `offset` defaults to `0` and `limit` to all remaining users. Negative or non-numeric values throw an `Error`. |
+| `searchUsers(db, query)` | Returns users whose `fullName` or `email` contains `query` (case-insensitive), oldest first. |
+
+```js
+const ada = users.createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+users.updateUser(db, ada.id, { fullName: 'Ada King' });
+users.listUsers(db, { limit: 10, offset: 20 }); // third page of 10
+users.searchUsers(db, 'LOVE');
+```
+
+### `src/api/export.js`
+
+| Function | Description |
+| --- | --- |
+| `exportUsersCsv(db)` | Returns all users as CSV: a header row `id,email,fullName,createdAt,lastLogin`, then one row per user, oldest first. Fields containing commas, quotes or newlines are quoted (quotes doubled). A missing `lastLogin` is blank. Lines end with `\n`. |
+| `importUsersCsv(db, csv)` | The inverse of `exportUsersCsv`: inserts the users from `csv`, keeping their ids and timestamps, and returns how many were imported. Accepts `\n` or `\r\n` line endings. Every row is validated first, so a bad file imports nothing: it throws an `Error` naming the line for a wrong header, a row with the wrong number of fields, an invalid email or `fullName`, or an id or email (ignoring case) that repeats in the file or already exists in `db`. |
+
+### `src/api/format.js`
+
+| Function | Description |
+| --- | --- |
+| `displayName(user)` | Returns `user.fullName`, or the part of `user.email` before the first `@` when `fullName` is empty. Does not take `db`. |
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..8b744fc
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,85 @@
+const { listUsers, getUser, getUserByEmail } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+const csvField = (value) => {
+  const s = value == null ? '' : String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replaceAll('"', '""')}"` : s;
+};
+
+/**
+ * Exports all users as CSV: a header row (id,email,fullName,createdAt,lastLogin) then one row per user, oldest first.
+ * Fields containing commas, quotes or newlines are quoted; a missing lastLogin is blank. Lines end with "\n".
+ * @param {import('../db.js').Db} db
+ * @returns {string}
+ * @throws {Error} If db is missing.
+ */
+exports.exportUsersCsv = (db) => {
+  if (!db) throw new Error('exportUsersCsv: db is required');
+  const lines = [COLUMNS, ...listUsers(db).map((u) => COLUMNS.map((c) => u[c]))];
+  return lines.map((fields) => fields.map(csvField).join(',')).join('\n') + '\n';
+};
+
+// RFC 4180-style parser: quoted fields may contain commas, doubled quotes and newlines.
+const parseCsv = (text) => {
+  const records = [];
+  let fields = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const ch = text[i];
+    if (quoted) {
+      if (ch !== '"') field += ch;
+      else if (text[i + 1] === '"') { field += '"'; i++; }
+      else quoted = false;
+    } else if (ch === '"') quoted = true;
+    else if (ch === ',') { fields.push(field); field = ''; }
+    else if (ch === '\n' || ch === '\r') {
+      if (ch === '\r' && text[i + 1] === '\n') i++;
+      fields.push(field);
+      records.push(fields);
+      fields = [];
+      field = '';
+    } else field += ch;
+  }
+  if (quoted) throw new Error('importUsersCsv: unterminated quoted field');
+  if (field !== '' || fields.length) { fields.push(field); records.push(fields); }
+  return records;
+};
+
+/**
+ * Imports users from CSV in the format written by exportUsersCsv, keeping ids and timestamps as given.
+ * All rows are validated before anything is inserted, so a failure imports nothing.
+ * @param {import('../db.js').Db} db
+ * @param {string} csv
+ * @returns {number} How many users were imported.
+ * @throws {Error} If db is missing, csv is not a string, the header is wrong, a row is malformed or invalid,
+ *   or an id or email (ignoring case) repeats within the file or already exists in db.
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (!db) throw new Error('importUsersCsv: db is required');
+  if (typeof csv !== 'string') throw new Error('importUsersCsv: csv must be a string');
+  const [header, ...records] = parseCsv(csv);
+  if (!header || header.join(',') !== COLUMNS.join(',')) {
+    throw new Error(`importUsersCsv: header must be ${COLUMNS.join(',')}`);
+  }
+  const seenIds = new Set();
+  const seenEmails = new Set();
+  const rows = records.map((fields, i) => {
+    const line = i + 2;
+    if (fields.length !== COLUMNS.length) throw new Error(`importUsersCsv: line ${line}: expected ${COLUMNS.length} fields`);
+    const [id, email, fullName, createdAt, lastLogin] = fields;
+    if (!id) throw new Error(`importUsersCsv: line ${line}: id is required`);
+    if (!email.includes('@')) throw new Error(`importUsersCsv: line ${line}: invalid email`);
+    if (fullName.length === 0 || fullName.length > 100) throw new Error(`importUsersCsv: line ${line}: invalid fullName`);
+    if (!createdAt) throw new Error(`importUsersCsv: line ${line}: createdAt is required`);
+    const key = email.toLowerCase();
+    if (seenIds.has(id) || getUser(db, id)) throw new Error(`importUsersCsv: line ${line}: duplicate id ${id}`);
+    if (seenEmails.has(key) || getUserByEmail(db, email)) throw new Error(`importUsersCsv: line ${line}: duplicate email ${email}`);
+    seenIds.add(id);
+    seenEmails.add(key);
+    return { id, email, fullname: fullName, created_at: createdAt, ...(lastLogin && { last_login: lastLogin }) };
+  });
+  for (const row of rows) db.insert('users', row);
+  return rows.length;
+};
