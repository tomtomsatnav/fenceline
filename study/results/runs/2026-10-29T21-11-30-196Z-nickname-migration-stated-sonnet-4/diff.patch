+ * p = 100 the largest and p = 50 the median; in between, the result is placed proportionally between its two
+ * neighbours, so percentile([1, 2, 3, 4], 25) -> 1.75. An empty array gives NaN, and so does any array
+ * containing NaN. Infinities sort as expected: a result between -Infinity and a finite number is -Infinity,
+ * and between -Infinity and Infinity is NaN. The input is not modified (and need not be sorted).
+ * @param {number[]} xs
+ * @param {number} p Percentile from 0 to 100, both included; fractions such as 99.9 are fine.
+ * @returns {number}
+ * @throws {TypeError} If xs is not an array, any item (including a hole in a sparse array) is not a number, or
+ *   p is not a number.
+ * @throws {RangeError} If p is NaN or outside 0 to 100.
+ */
+exports.percentile = (xs, p) => {
+  if (!Array.isArray(xs)) throw new TypeError('percentile: xs must be an array');
+  if (typeof p !== 'number') throw new TypeError('percentile: p must be a number');
+  if (!(p >= 0 && p <= 100)) throw new RangeError('percentile: p must be between 0 and 100');
+  for (let i = 0; i < xs.length; i++) {
+    if (typeof xs[i] !== 'number') throw new TypeError(`percentile: item ${i} must be a number`);
+  }
+  if (xs.length === 0 || xs.some(Number.isNaN)) return NaN;
+  const sorted = Array.from(xs).sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+  const rank = (p * (sorted.length - 1)) / 100;
+  const below = Math.floor(rank);
+  const fraction = rank - below;
+  const low = sorted[below];
+  if (fraction === 0) return low;
+  const high = sorted[below + 1];
+  const gap = high - low;
+  return Number.isFinite(gap) ? low + gap * fraction : low * (1 - fraction) + high * fraction;
+};
+
+const BYTE_UNITS = ['B', 'KB', 'MB', 'GB', 'TB'];
+
+/**
+ * Formats a byte count for people, using 1024 per step and the units B, KB, MB, GB and TB:
+ * formatBytes(1536) -> "1.5 KB". The number has at most one decimal place (halves round away from zero) and
+ * no trailing ".0": formatBytes(1024) -> "1 KB", formatBytes(1229) -> "1.2 KB". A value that rounds up to 1024
