+
+test('template ignores inherited properties', () => {
+  assert.strictEqual(template('{constructor} {toString} {__proto__}', {}), '{constructor} {toString} {__proto__}');
+  const child = Object.create({ name: 'Ada' });
+  assert.strictEqual(template('Hi {name}', child), 'Hi {name}');
+});
+
+test('template converts non-string values and treats null/undefined as missing', () => {
+  assert.strictEqual(template('{n} {b} {z}', { n: 42, b: false, z: 0 }), '42 false 0');
+  assert.strictEqual(template('[{e}]', { e: '' }), '[]');
+  assert.strictEqual(template('{a} {b}', { a: null, b: undefined }), '{a} {b}');
+  assert.strictEqual(template('{o}', { o: { toString: () => 'obj' } }), 'obj');
+});
+
+test('template substitutes in a single pass and treats values literally', () => {
+  assert.strictEqual(template('{a}', { a: '{b}', b: 'no' }), '{b}');
+  assert.strictEqual(template('{a}', { a: '$& $1 $$' }), '$& $1 $$');
+});
+
+test('template leaves malformed or non-placeholder braces alone', () => {
+  const values = { name: 'Ada' };
+  assert.strictEqual(template('{}', values), '{}');
+  assert.strictEqual(template('{ name }', values), '{ name }');
+  assert.strictEqual(template('{name', values), '{name');
+  assert.strictEqual(template('name}', values), 'name}');
+  assert.strictEqual(template('function() { return 1; }', values), 'function() { return 1; }');
+});
+
+test('template supports any non-space name, repeated placeholders and empty strings', () => {
+  assert.strictEqual(template('{first-name} {user.id} {0}', { 'first-name': 'Ada', 'user.id': 7, 0: 'zero' }), 'Ada 7 zero');
+  assert.strictEqual(template('', { a: 1 }), '');
+  assert.strictEqual(template('no placeholders', { a: 1 }), 'no placeholders');
+  assert.strictEqual(template('multi\nline {a}\n', { a: 'x' }), 'multi\nline x\n');
+});
+
+test('template throws a TypeError for invalid arguments', () => {
+  for (const bad of [undefined, null, 42, {}]) assert.throws(() => template(bad, {}), TypeError);
+  for (const bad of [null, 'str', 42, true]) assert.throws(() => template('{a}', bad), TypeError);
+});
