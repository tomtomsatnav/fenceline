+const checkObjectAndKeys = (fn, obj, keys) => {
+  if (typeof obj !== 'object' || obj === null) throw new TypeError(`${fn}: obj must be an object`);
+  if (!Array.isArray(keys)) throw new TypeError(`${fn}: keys must be an array`);
+  for (let i = 0; i < keys.length; i++) {
+    const type = typeof keys[i];
+    if (type !== 'string' && type !== 'number' && type !== 'symbol') {
+      throw new TypeError(`${fn}: key ${i} must be a string, number or symbol`);
+    }
+  }
+};
