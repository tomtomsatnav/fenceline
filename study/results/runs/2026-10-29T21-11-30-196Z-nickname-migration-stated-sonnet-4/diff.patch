+ * does not have are left out instead of appearing as undefined; a key that is there with the value undefined
+ * is kept. The result lists keys in the order given in keys, once each, and holds the same values as obj
+ * (shallow, not cloned; a getter is called once and its value stored). Symbols work as keys, and a key named
+ * "__proto__" is an ordinary property of the result. The result is always a plain object, whatever obj was,
+ * and obj is not modified.
+ * @param {Object} obj Any non-null object (an array works, with index keys).
+ * @param {Array<string|number|symbol>} keys The keys to keep.
+ * @returns {Object} A new plain object.
+ * @throws {TypeError} If obj is not an object, keys is not an array, or a key is not a string, number or symbol.
+ */
+exports.pick = (obj, keys) => {
+  checkObjectAndKeys('pick', obj, keys);
