+/** @typedef {{id: string, email: string, fullName: string, createdAt: string, lastLogin: string|null, nickname: string|null}} User */
+
+// Database row <-> user object. toRow skips undefined fields, so it also builds partial updates.
+const fromRow = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null, nickname: r.nickname ?? null });
+
+const toRow = ({ id, email, fullName, createdAt, lastLogin, nickname }) => {
+  const row = { id, email, fullname: fullName, created_at: createdAt, last_login: lastLogin, nickname };
+  for (const k of Object.keys(row)) if (row[k] === undefined) delete row[k];
+  return row;
+};
+
+const checkEmail = (db, email, selfId) => {
+  if (typeof email !== 'string' || !email.includes('@')) throw new Error('Invalid email: missing "@"');
+  const existing = exports.getUserByEmail(db, email);
+  if (existing && existing.id !== selfId) throw new Error(`Duplicate email: ${email}`);
+};
+
+const checkFullName = (fullName) => {
+  if (typeof fullName !== 'string' || fullName.length === 0 || fullName.length > 100) {
+    throw new Error('Invalid fullName: must be a non-empty string of at most 100 characters');
+  }
 };
 
+/**
+ * Creates a user with a generated id and the current time as createdAt.
+ * @param {import('../db.js').Db} db
+ * @param {{email: string, fullName: string, nickname?: string}} fields email must contain "@" and be unique (case-insensitive); fullName must be 1-100 characters; nickname is optional and reads back as null when not given.
+ * @returns {User} The created user.
+ * @throws {Error} If db is missing, or the email or fullName is invalid, or the email is already taken.
+ */
+exports.createUser = (db, { email, fullName, nickname }) => {
+  checkEmail(db, email);
+  checkFullName(fullName);
+  const id = crypto.randomUUID();
+  db.insert('users', toRow({ id, email, fullName, nickname, createdAt: new Date().toISOString() }));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Looks a user up by id.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @returns {User|null} The user, or null if there is none with that id.
+ * @throws {Error} If db is missing.
+ */
 exports.getUser = (db, id) => {
   const r = db.find('users', (u) => u.id === id);
-  if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return r ? fromRow(r) : null;
 };
+
+/**
+ * Looks a user up by email, ignoring case.
+ * @param {import('../db.js').Db} db
+ * @param {string} email
+ * @returns {User|null} The first matching user, or null if there is none.
+ * @throws {Error} If db is missing.
+ */
+exports.getUserByEmail = (db, email) => {
+  const wanted = String(email).toLowerCase();
+  const r = db.find('users', (u) => String(u.email).toLowerCase() === wanted);
+  return r ? fromRow(r) : null;
+};
+
+/**
+ * Changes only the fields that are given (undefined fields are left alone).
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {{email?: string, fullName?: string}} [fields] Validated like createUser; an email may be the user's own.
+ * @returns {User|null} The updated user, or null if there is none with that id.
+ * @throws {Error} If db is missing, or a given email or fullName is invalid, or the email belongs to another user.
+ */
+exports.updateUser = (db, id, { email, fullName } = {}) => {
+  if (!exports.getUser(db, id)) return null;
+  if (email !== undefined) checkEmail(db, email, id);
+  if (fullName !== undefined) checkFullName(fullName);
+  db.update('users', (u) => u.id === id, toRow({ email, fullName }));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Finds users whose fullName or email contains the query, ignoring case.
+ * @param {import('../db.js').Db} db
+ * @param {string} query Substring to look for; an empty string matches everyone.
+ * @returns {User[]} Matching users, oldest first.
+ * @throws {Error} If db is missing.
+ */
+exports.searchUsers = (db, query) => {
+  const q = String(query).toLowerCase();
+  return exports.listUsers(db).filter((u) => `${u.fullName}`.toLowerCase().includes(q) || `${u.email}`.toLowerCase().includes(q));
+};
+
+/**
+ * Removes a user.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @returns {boolean} True if a user was removed, false if there was none with that id.
+ * @throws {Error} If db is missing.
+ */
+exports.deleteUser = (db, id) => db.delete('users', (u) => u.id === id) > 0;
+
+/**
+ * Sets a user's last login time.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {string} [when] ISO timestamp; defaults to now.
+ * @returns {User|null} The updated user, or null if there is none with that id.
+ * @throws {Error} If db is missing.
+ */
+exports.recordLogin = (db, id, when = new Date().toISOString()) => {
+  if (!db.update('users', (u) => u.id === id, toRow({ lastLogin: when }))) return null;
+  return exports.getUser(db, id);
+};
+
+/**
+ * Counts all users.
+ * @param {import('../db.js').Db} db
+ * @returns {number}
+ * @throws {Error} If db is missing.
+ */
+exports.countUsers = (db) => db.all('users').length;
+
+/**
+ * Lists users sorted by createdAt, oldest first, optionally paginated.
+ * @param {import('../db.js').Db} db
+ * @param {{limit?: number, offset?: number}} [page] limit defaults to all remaining users and offset to 0, so callers that pass nothing get the full list.
+ * @returns {User[]}
+ * @throws {Error} If db is missing, or limit or offset is negative or not a number.
+ */
+exports.listUsers = (db, { limit = Infinity, offset = 0 } = {}) => {
+  if (!(limit >= 0) || !(offset >= 0)) throw new Error('limit and offset must be non-negative numbers');
+  return db.all('users').map(fromRow).sort((a, b) => a.createdAt.localeCompare(b.createdAt)).slice(offset, offset + limit);
+};
+
+// Every exported function takes db first; fail clearly instead of with a TypeError deep inside.
+for (const [name, fn] of Object.entries(exports)) {
+  exports[name] = (db, ...args) => {
+    if (!db) throw new Error(`${name}: db is required`);
+    return fn(db, ...args);
+  };
+}
