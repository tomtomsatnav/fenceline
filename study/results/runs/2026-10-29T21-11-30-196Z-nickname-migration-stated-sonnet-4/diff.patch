+
+/**
+ * Converts a Roman numeral to a number: fromRoman("MCMXCIV") -> 1994. This is the exact inverse of toRoman, so
+ * it accepts only the standard form toRoman produces (upper case, I V X L C D M, with subtractive pairs IV IX
+ * XL XC CD CM and at most three repeats), for 1 to 3999. Everything else is rejected rather than guessed at:
+ * "IIII", "VX", "IC", "MMMM", lower case, an empty string, and any spaces around the numeral.
+ * @param {string} s
+ * @returns {number} An integer from 1 to 3999.
+ * @throws {TypeError} If s is not a string.
+ * @throws {SyntaxError} If s is not a standard Roman numeral from I to MMMCMXCIX.
+ */
+exports.fromRoman = (s) => {
+  if (typeof s !== 'string') throw new TypeError('fromRoman: s must be a string');
+  if (s === '' || !CANONICAL_ROMAN.test(s)) throw new SyntaxError(`fromRoman: invalid Roman numeral ${JSON.stringify(s)}`);
+  let total = 0;
+  for (let i = 0; i < s.length; i++) {
+    const value = ROMAN_VALUES[s[i]];
+    total += value < (ROMAN_VALUES[s[i + 1]] ?? 0) ? -value : value;
+  }
+  return total;
+};
