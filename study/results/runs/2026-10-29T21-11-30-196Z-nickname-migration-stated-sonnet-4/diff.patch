+// Independent reader for the round-trip checks: sums the letters, subtracting any that precede a bigger one.
+function readRoman(s) {
+  const value = { I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000 };
+  let total = 0;
+  for (let i = 0; i < s.length; i++) {
+    const v = value[s[i]];
+    total += v < (value[s[i + 1]] ?? 0) ? -v : v;
+  }
+  return total;
+}
