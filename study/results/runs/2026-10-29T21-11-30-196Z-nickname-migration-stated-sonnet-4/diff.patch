@@ -0,0 +1,202 @@
+const { isDate } = require('node:util').types;
+
+const MS_PER_DAY = 86400000;
+const MAX_TIME = 8.64e15; // the latest (and, negated, earliest) time a Date can hold
+
+/**
+ * Returns a new Date exactly n days (n * 24 hours) after date; a negative n goes back in time.
+ * Days are counted in UTC, so the answer does not depend on the time zone of the machine or on daylight saving
+ * changes: addDays(new Date('2024-01-31T12:00:00Z'), 1) is 2024-02-01T12:00:00Z. The time of day (down to the
+ * millisecond) is kept, months, years and leap days are handled, and the input is not modified.
+ * @param {Date} date A valid Date.
+ * @param {number} n A whole number of days; may be negative or 0.
+ * @returns {Date} A new Date.
+ * @throws {TypeError} If date is not a Date, or n is not a number.
+ * @throws {RangeError} If date is an Invalid Date, n is not an integer (this includes NaN and the infinities),
+ *   or the result falls outside the range a Date can represent (about 273,000 years either side of 1970).
+ */
+exports.addDays = (date, n) => {
+  if (!isDate(date)) throw new TypeError('addDays: date must be a Date');
+  if (typeof n !== 'number') throw new TypeError('addDays: n must be a number');
+  const time = date.getTime();
+  if (Number.isNaN(time)) throw new RangeError('addDays: date is invalid');
+  if (!Number.isInteger(n)) throw new RangeError('addDays: n must be an integer');
+  const result = time + n * MS_PER_DAY;
+  if (!(Math.abs(result) <= MAX_TIME)) throw new RangeError('addDays: result is out of range');
+  return new Date(result);
+};
+
+/**
+ * Whole calendar days from one date to another, ignoring the time of day, in UTC:
+ * daysBetween(new Date('2024-03-10T23:59:59Z'), new Date('2024-03-11T00:00:01Z')) -> 1, even though only two
+ * seconds apart. Positive when `to` is on a later UTC day than `from`, negative when earlier, and 0 for the
+ * same UTC day. It is the inverse of addDays: daysBetween(d, addDays(d, n)) is n. The time zone of the machine
+ * and daylight saving changes have no effect. The inputs are not modified.
+ * @param {Date} from
+ * @param {Date} to
+ * @returns {number} A whole number of days (never -0).
+ * @throws {TypeError} If from or to is not a Date.
+ * @throws {RangeError} If from or to is an Invalid Date.
+ */
+exports.daysBetween = (from, to) => {
+  for (const [name, d] of [['from', from], ['to', to]]) {
+    if (!isDate(d)) throw new TypeError(`daysBetween: ${name} must be a Date`);
+    if (Number.isNaN(d.getTime())) throw new RangeError(`daysBetween: ${name} is invalid`);
+  }
+  return Math.floor(to.getTime() / MS_PER_DAY) - Math.floor(from.getTime() / MS_PER_DAY);
+};
+
+/**
+ * Tells whether a date falls on a Saturday or Sunday, judged in UTC: the time zone of the machine has no
+ * effect, so 2024-03-08T23:30:00Z (Friday in UTC, already Saturday in Berlin) is not a weekend day.
+ * The date is not modified.
+ * @param {Date} date A valid Date.
+ * @returns {boolean}
+ * @throws {TypeError} If date is not a Date.
+ * @throws {RangeError} If date is an Invalid Date.
+ */
+exports.isWeekend = (date) => {
+  if (!isDate(date)) throw new TypeError('isWeekend: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('isWeekend: date is invalid');
+  const weekday = date.getUTCDay();
+  return weekday === 0 || weekday === 6;
+};
+
+/**
+ * The start of the week containing a date: the Monday at 00:00:00.000 UTC on or before it. Weeks run from Monday
+ * to Sunday, so a Sunday belongs to the week that began six days earlier, and a Monday (at any time of day) maps
+ * to midnight that same day. Judged in UTC, so the time zone of the machine has no effect. The date is not
+ * modified.
+ * @param {Date} date A valid Date.
+ * @returns {Date} A new Date.
+ * @throws {TypeError} If date is not a Date.
+ * @throws {RangeError} If date is an Invalid Date, or the start of its week is earlier than the earliest Date
+ *   (this only happens within a few days of -271821-04-20, the earliest date there is).
+ */
+exports.startOfWeek = (date) => {
+  if (!isDate(date)) throw new TypeError('startOfWeek: date must be a Date');
+  const time = date.getTime();
+  if (Number.isNaN(time)) throw new RangeError('startOfWeek: date is invalid');
+  const daysSinceMonday = (date.getUTCDay() + 6) % 7;
+  const start = Math.floor(time / MS_PER_DAY) * MS_PER_DAY - daysSinceMonday * MS_PER_DAY;
