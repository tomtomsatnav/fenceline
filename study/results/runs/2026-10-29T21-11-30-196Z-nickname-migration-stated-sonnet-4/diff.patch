+/**
+ * Limits x to the range from lo to hi (both included): clamp(15, 0, 10) -> 10, clamp(-3, 0, 10) -> 0.
+ * A value already in range is returned as is. Infinity is allowed as a bound (clamp(5, -Infinity, 3) -> 3)
+ * and as a value (clamp(Infinity, 0, 10) -> 10). A NaN x is returned as NaN.
+ * @param {number} x
+ * @param {number} lo Lower bound.
+ * @param {number} hi Upper bound; must not be less than lo.
+ * @returns {number}
+ * @throws {TypeError} If x, lo or hi is not a number.
+ * @throws {RangeError} If lo or hi is NaN, or lo is greater than hi.
+ */
+exports.clamp = (x, lo, hi) => {
+  for (const [name, v] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof v !== 'number') throw new TypeError(`clamp: ${name} must be a number`);
+  }
+  if (Number.isNaN(lo) || Number.isNaN(hi)) throw new RangeError('clamp: lo and hi must not be NaN');
+  if (lo > hi) throw new RangeError('clamp: lo must not be greater than hi');
+  if (x < lo) return lo;
+  if (x > hi) return hi;
+  return x;
+};
+
+// Multiplies x by 10^n by editing the exponent of its shortest decimal string, so no binary rounding creeps in.
+const shift = (x, n) => {
+  const [mantissa, exponent = '0'] = String(x).split('e');
+  return Number(`${mantissa}e${Number(exponent) + n}`);
+};
+
+/**
+ * Rounds x to a number of decimal places, with halves rounded away from zero: roundTo(2.5, 0) -> 3,
+ * roundTo(-2.5, 0) -> -3, roundTo(1.005, 2) -> 1.01. The rounding follows the decimal digits you would see
+ * when printing x, not its underlying binary value (the double nearest 1.005 is a hair below it, which is why
+ * Math.round(1.005 * 100) / 100 gives 1). Negative places round to tens, hundreds and so on:
+ * roundTo(1250, -2) -> 1300. NaN and the infinities are returned unchanged, and a result of -0 is returned as 0.
+ * @param {number} x
+ * @param {number} places Number of decimal places to keep; an integer, which may be negative or zero.
+ * @returns {number}
+ * @throws {TypeError} If x or places is not a number.
+ * @throws {RangeError} If places is not an integer.
+ */
+exports.roundTo = (x, places) => {
+  if (typeof x !== 'number') throw new TypeError('roundTo: x must be a number');
+  if (typeof places !== 'number') throw new TypeError('roundTo: places must be a number');
+  if (!Number.isInteger(places)) throw new RangeError('roundTo: places must be an integer');
+  if (!Number.isFinite(x)) return x;
+  const scaled = shift(Math.abs(x), places);
+  if (!Number.isFinite(scaled)) return x; // so large that it has no digits to round away
+  const rounded = shift(Math.round(scaled), -places);
+  const result = x < 0 ? -rounded : rounded;
+  return result === 0 ? 0 : result;
+};
