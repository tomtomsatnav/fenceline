+++ b/test/export.test.js
@@ -0,0 +1,85 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { listUsers, countUsers } = require('../src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+const add = (db, id, email, fullname, created_at, last_login) =>
+  db.insert('users', { id, email, fullname, created_at, ...(last_login && { last_login }) });
+
+test('exportUsersCsv with no users is just the header', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), 'id,email,fullName,createdAt,lastLogin\n');
+});
+
+test('exportUsersCsv writes one row per user, oldest first, with empty lastLogin as blank', () => {
+  const db = migrate(new Db());
+  add(db, 'b', 'b@example.com', 'Bob', '2024-02-01T00:00:00.000Z', '2024-03-01T00:00:00.000Z');
+  add(db, 'a', 'a@example.com', 'Ann', '2024-01-01T00:00:00.000Z');
+  assert.strictEqual(
+    exportUsersCsv(db),
+    [
+      'id,email,fullName,createdAt,lastLogin',
+      'a,a@example.com,Ann,2024-01-01T00:00:00.000Z,',
+      'b,b@example.com,Bob,2024-02-01T00:00:00.000Z,2024-03-01T00:00:00.000Z',
+      '',
+    ].join('\n'),
+  );
+});
+
+test('exportUsersCsv quotes fields containing commas, quotes or newlines', () => {
+  const db = migrate(new Db());
+  add(db, 'a', 'a@example.com', 'Lovelace, Ada', '2024-01-01T00:00:00.000Z');
+  add(db, 'b', 'b@example.com', 'Bob "The Builder" B', '2024-01-02T00:00:00.000Z');
+  add(db, 'c', 'c@example.com', 'Line\nBreak', '2024-01-03T00:00:00.000Z');
+  const lines = exportUsersCsv(db).split('\n');
+  assert.strictEqual(lines[1], 'a,a@example.com,"Lovelace, Ada",2024-01-01T00:00:00.000Z,');
+  assert.strictEqual(lines[2], 'b,b@example.com,"Bob ""The Builder"" B",2024-01-02T00:00:00.000Z,');
+  assert.strictEqual(lines[3] + '\n' + lines[4], 'c,c@example.com,"Line\nBreak",2024-01-03T00:00:00.000Z,');
+});
+
+test('exportUsersCsv throws a clear Error when db is missing', () => {
+  assert.throws(() => exportUsersCsv(undefined), /exportUsersCsv: db is required/);
+});
+
+test('importUsersCsv round-trips exportUsersCsv, including tricky fields', () => {
+  const src = migrate(new Db());
+  add(src, 'a', 'a@example.com', 'Lovelace, Ada', '2024-01-01T00:00:00.000Z', '2024-04-01T00:00:00.000Z');
+  add(src, 'b', 'b@example.com', 'Bob "The Builder" B', '2024-01-02T00:00:00.000Z');
+  add(src, 'c', 'c@example.com', 'Line\nBreak', '2024-01-03T00:00:00.000Z');
+  const csv = exportUsersCsv(src);
+
+  const dest = migrate(new Db());
+  assert.strictEqual(importUsersCsv(dest, csv), 3);
+  assert.deepStrictEqual(listUsers(dest), listUsers(src));
+  assert.strictEqual(exportUsersCsv(dest), csv);
+});
+
+test('importUsersCsv accepts CRLF line endings and no trailing newline', () => {
+  const db = migrate(new Db());
+  const csv = 'id,email,fullName,createdAt,lastLogin\r\na,a@example.com,Ann,2024-01-01T00:00:00.000Z,';
+  assert.strictEqual(importUsersCsv(db, csv), 1);
+  assert.strictEqual(listUsers(db)[0].lastLogin, null);
+});
+
+test('importUsersCsv rejects bad input without importing anything', () => {
+  const db = migrate(new Db());
+  add(db, 'x', 'taken@example.com', 'Existing', '2024-01-01T00:00:00.000Z');
+  const header = 'id,email,fullName,createdAt,lastLogin';
+  const ok = 'a,a@example.com,Ann,2024-01-01T00:00:00.000Z,';
+  for (const csv of [
+    '',
+    'id,email\na,a@example.com',
+    `${header}\n${ok}\nb,not-an-email,Bob,2024-01-01T00:00:00.000Z,`,
+    `${header}\n${ok}\na,other@example.com,Dup Id,2024-01-01T00:00:00.000Z,`,
+    `${header}\n${ok}\nb,A@EXAMPLE.com,Dup Email,2024-01-01T00:00:00.000Z,`,
+    `${header}\n${ok}\nc,TAKEN@example.com,Dup Existing,2024-01-01T00:00:00.000Z,`,
+    `${header}\n${ok}\nd,d@example.com,,2024-01-01T00:00:00.000Z,`,
+    `${header}\n${ok}\ne,e@example.com,Short`,
+    `${header}\n${ok}\nf,f@example.com,"Unterminated,2024-01-01T00:00:00.000Z,`,
+  ]) {
+    assert.throws(() => importUsersCsv(db, csv), Error, csv);
+    assert.strictEqual(countUsers(db), 1);
+  }
+  assert.throws(() => importUsersCsv(undefined, ok), /importUsersCsv: db is required/);
+});
