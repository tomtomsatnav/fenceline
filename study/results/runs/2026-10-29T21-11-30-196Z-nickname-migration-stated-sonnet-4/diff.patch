+  return new Date(start);
+};
+
+/**
+ * Formats a Date as YYYY-MM-DD, using its UTC year, month and day: formatIsoDate(new Date('2024-03-09T23:59:59Z'))
+ * is "2024-03-09" whatever the time zone of the machine. Years 0 to 9999 have four digits ("0099-01-01"); other
+ * years use the ISO 8601 expanded form of Date.prototype.toISOString, a sign and six digits ("-000001-12-31",
+ * "+275760-09-13"). The result can be read back with new Date(...), which gives midnight UTC of that day.
+ * The date is not modified.
+ * @param {Date} date A valid Date.
+ * @returns {string}
+ * @throws {TypeError} If date is not a Date.
+ * @throws {RangeError} If date is an Invalid Date.
+ */
+exports.formatIsoDate = (date) => {
+  if (!isDate(date)) throw new TypeError('formatIsoDate: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('formatIsoDate: date is invalid');
+  return date.toISOString().split('T')[0];
+};
+
+const ISO_DATE = /^(\d{4}|[+-]\d{6})-(\d{2})-(\d{2})$/;
+
+/**
+ * Parses a calendar date written as YYYY-MM-DD into a Date at 00:00:00.000 UTC of that day:
+ * parseIsoDate("2024-03-09") is 2024-03-09T00:00:00.000Z, whatever the time zone of the machine. This is the
+ * inverse of formatIsoDate, so it also reads the expanded years that function writes, a sign and six digits
+ * ("-000001-12-31", "+010000-01-01"), except "-000000", which ISO 8601 forbids. Nothing else is accepted:
+ * no times ("2024-03-09T00:00Z"), no missing zeros ("2024-3-9"), no spaces or other separators, and no guessing.
+ * Dates are checked against the real calendar, leap years included, so "2024-02-29" is fine but "2026-02-30",
+ * "2023-02-29", "1900-02-29", month 00 or 13, and day 00 are errors.
+ * @param {string} s
+ * @returns {Date} A new Date.
+ * @throws {TypeError} If s is not a string.
+ * @throws {SyntaxError} If s is not in the form YYYY-MM-DD (or the expanded-year form).
+ * @throws {RangeError} If s is well formed but is not a real date, or is beyond the range a Date can hold
+ *   (-271821-04-20 to +275760-09-13).
+ */
+exports.parseIsoDate = (s) => {
+  if (typeof s !== 'string') throw new TypeError('parseIsoDate: s must be a string');
+  const match = ISO_DATE.exec(s);
+  if (!match || match[1] === '-000000') throw new SyntaxError(`parseIsoDate: ${JSON.stringify(s)} is not in the form YYYY-MM-DD`);
+  const [year, month, dayOfMonth] = [Number(match[1]), Number(match[2]), Number(match[3])];
+  const date = new Date(0);
+  date.setUTCFullYear(year, month - 1, dayOfMonth);
+  // setUTCFullYear carries overflow into the next month or year (30 February becomes 2 March), so compare back.
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== dayOfMonth) {
+    throw new RangeError(`parseIsoDate: ${s} is not a real date`);
+  }
+  return date;
+};
+
+/**
+ * A person's age in whole years on a given date: the number of birthdays that have passed, counting the
+ * birthday itself: ageOn(new Date('2000-05-15'), new Date('2024-05-15')) is 24, and one day earlier it is 23.
+ * Calendar days in UTC are compared and the time of day is ignored, so the answer does not depend on the time
+ * zone of the machine. A birthday on 29 February is reached on 1 March in years that have no 29 February
+ * (born 2000-02-29, age 23 on 2023-02-28 and 24 on 2024-02-29, but already 23 on 2023-03-01). Both dates are
+ * left unmodified.
+ * @param {Date} birthDate A valid Date.
+ * @param {Date} date The day to measure the age on; a valid Date that falls on the same UTC day as birthDate or
+ *   later.
+ * @returns {number} A whole number of years, 0 or more.
+ * @throws {TypeError} If birthDate or date is not a Date.
+ * @throws {RangeError} If either is an Invalid Date, or date falls on an earlier UTC day than birthDate.
+ */
+exports.ageOn = (birthDate, date) => {
+  for (const [name, d] of [['birthDate', birthDate], ['date', date]]) {
+    if (!isDate(d)) throw new TypeError(`ageOn: ${name} must be a Date`);
+    if (Number.isNaN(d.getTime())) throw new RangeError(`ageOn: ${name} is invalid`);
+  }
+  if (Math.floor(date.getTime() / MS_PER_DAY) < Math.floor(birthDate.getTime() / MS_PER_DAY)) {
+    throw new RangeError('ageOn: date is before birthDate');
+  }
+  const reachedBirthday =
+    date.getUTCMonth() > birthDate.getUTCMonth() ||
+    (date.getUTCMonth() === birthDate.getUTCMonth() && date.getUTCDate() >= birthDate.getUTCDate());
+  return date.getUTCFullYear() - birthDate.getUTCFullYear() - (reachedBirthday ? 0 : 1);
+};
+
+// Largest first, so the first unit that fits the distance is the one to use.
+const RELATIVE_UNITS = [
+  ['year', 365 * MS_PER_DAY],
+  ['month', 30 * MS_PER_DAY],
+  ['week', 7 * MS_PER_DAY],
+  ['day', MS_PER_DAY],
+  ['hour', 60 * 60 * 1000],
+  ['minute', 60 * 1000],
+  ['second', 1000],
+];
+
+/**
+ * Describes how far a date is from "now" in English: "3 minutes ago", "in 2 days", "1 hour ago", "just now".
+ * The elapsed time is rounded down to a whole number of the largest unit that fits, from seconds to years:
+ * under 1 second is "just now"; then seconds (up to 59), minutes (up to 59), hours (up to 23), days (up to 6),
+ * weeks (7 to 29 days, so up to 4), months (30 to 364 days, up to 11) and years (365 days or more). A date
+ * before now is "N units ago" and a later one is "in N units"; one unit is singular ("1 day ago"). Units have
+ * fixed lengths (a week is 7 days, a month 30 days, a year 365 days), so this is an approximation for people,
+ * not calendar arithmetic. Only the distance in milliseconds matters, so the time zone of the machine and
+ * daylight saving changes have no effect. Neither date is modified.
+ * @param {Date} date The moment to describe; a valid Date.
+ * @param {Date} [now=new Date()] The moment to measure from; a valid Date. Pass it explicitly when you need
+ *   a repeatable answer, since the default is the current time.
+ * @returns {string}
+ * @throws {TypeError} If date or now is not a Date.
+ * @throws {RangeError} If date or now is an Invalid Date.
+ */
+exports.relativeTime = (date, now = new Date()) => {
+  for (const [name, d] of [['date', date], ['now', now]]) {
+    if (!isDate(d)) throw new TypeError(`relativeTime: ${name} must be a Date`);
+    if (Number.isNaN(d.getTime())) throw new RangeError(`relativeTime: ${name} is invalid`);
+  }
+  const elapsed = now.getTime() - date.getTime(); // positive when date is in the past
+  const distance = Math.abs(elapsed);
+  if (distance < 1000) return 'just now';
+  const [name, length] = RELATIVE_UNITS.find(([, ms]) => distance >= ms);
+  let count = Math.floor(distance / length);
+  if (name === 'month') count = Math.min(count, 11); // 360 to 364 days is still "11 months"; a year starts at 365
+  const phrase = `${count} ${name}${count === 1 ? '' : 's'}`;
+  return elapsed > 0 ? `${phrase} ago` : `in ${phrase}`;
+};
