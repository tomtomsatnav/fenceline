+};
+
+const ROMAN_NUMERALS = [
+  [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'], [100, 'C'], [90, 'XC'],
+  [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
+];
+
+/**
+ * Converts a whole number from 1 to 3999 to a Roman numeral in standard (subtractive) form:
+ * toRoman(4) -> "IV", toRoman(1994) -> "MCMXCIV". Roman numerals have no zero or negatives, and the standard
+ * letters stop at MMMCMXCIX (3999), so anything else is an error.
