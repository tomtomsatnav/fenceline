+// Splits on non-alphanumeric characters and on lower-to-upper case changes, lowercasing each word.
+const words = (fn, str) => {
+  if (typeof str !== 'string') throw new TypeError(`${fn}: str must be a string`);
+  return str
+    .replace(/(\p{Ll}|\p{N})(\p{Lu})/gu, '$1 $2')
+    .split(/[^\p{L}\p{N}]+/u)
+    .filter(Boolean)
+    .map((w) => w.toLowerCase());
+};
+
+/**
+ * Converts a string to camelCase. Words are separated by spaces, hyphens, underscores or any other
+ * non-alphanumeric characters, and by lower-to-upper case changes ("helloWorld" stays "helloWorld").
+ * @param {string} str
+ * @returns {string} The camelCased string, or '' if it has no letters or digits.
+ * @throws {TypeError} If str is not a string.
+ */
+exports.camelCase = (str) =>
+  words('camelCase', str).map((w, i) => (i === 0 ? w : w[0].toUpperCase() + w.slice(1))).join('');
+
+/**
+ * Converts a string to kebab-case, splitting words the same way as camelCase.
+ * @param {string} str
+ * @returns {string} The kebab-cased string, or '' if it has no letters or digits.
+ * @throws {TypeError} If str is not a string.
+ */
+exports.kebabCase = (str) => words('kebabCase', str).join('-');
+
+/**
+ * Shortens a string to at most n characters, ending in "…" when anything was cut.
+ * Characters are counted as Unicode code points, so emoji and other astral characters are never split.
+ * @param {string} s
+ * @param {number} n Maximum length of the result, including the "…". A non-negative integer; Infinity means no limit.
+ * @returns {string} s unchanged if it already fits; otherwise its first n - 1 characters plus "…" ('' when n is 0).
+ * @throws {TypeError} If s is not a string.
+ * @throws {RangeError} If n is not a non-negative integer or Infinity.
+ */
+exports.truncate = (s, n) => {
+  if (typeof s !== 'string') throw new TypeError('truncate: s must be a string');
+  if (typeof n !== 'number' || !(n === Infinity || (Number.isInteger(n) && n >= 0))) {
+    throw new RangeError('truncate: n must be a non-negative integer');
+  }
+  const chars = Array.from(s);
+  if (chars.length <= n) return s;
+  return n === 0 ? '' : chars.slice(0, n - 1).join('') + '…';
+};
+
+/**
+ * Centres a string in a field of the given width by padding both sides with ch.
+ * When the padding is odd, the extra character goes on the right. Characters are counted as Unicode code points.
+ * @param {string} s
+ * @param {number} width Width of the field, a non-negative integer.
+ * @param {string} [ch=' '] Padding character; must be exactly one character.
+ * @returns {string} s padded to width, or s unchanged if it is already width or longer (it is never cut).
+ * @throws {TypeError} If s is not a string.
+ * @throws {RangeError} If width is not a non-negative integer, or ch is not exactly one character.
+ */
+exports.padCenter = (s, width, ch = ' ') => {
+  if (typeof s !== 'string') throw new TypeError('padCenter: s must be a string');
+  if (!Number.isInteger(width) || width < 0) throw new RangeError('padCenter: width must be a non-negative integer');
+  if (typeof ch !== 'string' || Array.from(ch).length !== 1) throw new RangeError('padCenter: ch must be a single character');
+  const total = width - Array.from(s).length;
+  if (total <= 0) return s;
+  const left = Math.floor(total / 2);
+  return ch.repeat(left) + s + ch.repeat(total - left);
+};
+
+/**
+ * Counts the words in a string. Runs of whitespace and punctuation separate words, so "don't" counts as two
+ * ("don", "t") and "well-known" as two. Letters, digits and symbols such as "$" or "+" are part of words.
+ * @param {string} s
+ * @returns {number} The number of words; 0 for an empty string or one with only whitespace and punctuation.
+ * @throws {TypeError} If s is not a string.
+ */
+exports.countWords = (s) => {
+  if (typeof s !== 'string') throw new TypeError('countWords: s must be a string');
+  return s.split(/[\s\p{P}]+/u).filter(Boolean).length;
+};
+
+/**
+ * Returns the uppercased first letter (or digit) of each whitespace-separated word, e.g. "Ada King Lovelace" -> "AKL".
+ * Leading punctuation is skipped ('"bob" smith' -> "BS"), and words with no letters or digits ("&", "-") are ignored.
+ * A hyphenated word counts once ("Jean-Luc Picard" -> "JP").
+ * @param {string} s
+ * @returns {string} The initials; '' for an empty string or one with no words.
+ * @throws {TypeError} If s is not a string.
+ */
+exports.initials = (s) => {
+  if (typeof s !== 'string') throw new TypeError('initials: s must be a string');
+  return s
+    .split(/\s+/u)
+    .map((word) => word.match(/[\p{L}\p{N}]/u)?.[0].toUpperCase() ?? '')
+    .join('');
+};
+
+/**
+ * Reverses the order of the words in a sentence and joins them with single spaces.
+ * Words are runs of non-whitespace, so punctuation stays attached to its word ("Hello, world!" -> "world! Hello,").
+ * Leading, trailing and repeated whitespace (including tabs and newlines) is dropped.
+ * @param {string} s
+ * @returns {string} The reversed sentence; '' for an empty or whitespace-only string.
+ * @throws {TypeError} If s is not a string.
+ */
+exports.reverseWords = (s) => {
+  if (typeof s !== 'string') throw new TypeError('reverseWords: s must be a string');
+  return s.split(/\s+/u).filter(Boolean).reverse().join(' ');
+};
+
+/**
+ * Tells whether a string reads the same backwards, ignoring case, whitespace and punctuation.
+ * Only letters and digits are compared, as code points; accented letters are distinct from their plain
+ * forms ("é" is not "e").
+ * @param {string} s
+ * @returns {boolean} True if the letters and digits read the same in both directions. A string with none
+ *   (such as '' or '!?') is trivially a palindrome and returns true.
+ * @throws {TypeError} If s is not a string.
+ */
+exports.isPalindrome = (s) => {
+  if (typeof s !== 'string') throw new TypeError('isPalindrome: s must be a string');
+  const chars = Array.from(s.toLowerCase().replace(/[^\p{L}\p{N}]+/gu, ''));
+  return chars.every((c, i) => c === chars[chars.length - 1 - i]);
+};
+
+/**
+ * Word-wraps text so no line is longer than width, breaking only between words (greedy: each line gets as
+ * many words as fit). Words are separated by whitespace and joined with single spaces, so indentation and
+ * repeated spaces are dropped. Existing line breaks are kept (as "\n", also for "\r\n"), including blank lines,
+ * and each original line is wrapped separately. A word longer than width is never split: it goes on a line of
+ * its own and that line exceeds width. Characters are counted as Unicode code points.
+ * @param {string} text
+ * @param {number} width Maximum line length, a positive integer; Infinity means only normalise spacing.
+ * @returns {string} The wrapped text, with no leading or trailing spaces on any line.
+ * @throws {TypeError} If text is not a string.
+ * @throws {RangeError} If width is not a positive integer or Infinity.
+ */
+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new TypeError('wrap: text must be a string');
+  if (width !== Infinity && !(Number.isInteger(width) && width > 0)) {
+    throw new RangeError('wrap: width must be a positive integer');
+  }
+  return text
+    .split(/\r?\n/u)
+    .map((paragraph) => {
+      const lines = [];
+      let line = '';
+      let lineLen = 0;
+      for (const word of paragraph.split(/\s+/u).filter(Boolean)) {
+        const len = Array.from(word).length;
+        if (lineLen === 0) {
+          line = word;
+          lineLen = len;
+        } else if (lineLen + 1 + len <= width) {
+          line += ` ${word}`;
+          lineLen += 1 + len;
+        } else {
+          lines.push(line);
+          line = word;
+          lineLen = len;
+        }
+      }
+      lines.push(line);
+      return lines.join('\n');
+    })
+    .join('\n');
+};
+
+/**
+ * Fills {placeholders} in a string from an object: template("Hi {name}", { name: "Ada" }) -> "Hi Ada".
+ * A placeholder is a name (no whitespace or braces) in single braces. Names with no own value in `values`
+ * are left exactly as written, including inherited ones such as {constructor}; a value of null or undefined
+ * counts as no value. Other values are converted with String(). Substitution is a single pass, so inserted
+ * text is never searched for further placeholders and "$" in a value has no special meaning.
+ * @param {string} str
+ * @param {Object} [values={}] Values by placeholder name.
+ * @returns {string}
+ * @throws {TypeError} If str is not a string, or values is not an object.
+ */
+exports.template = (str, values = {}) => {
+  if (typeof str !== 'string') throw new TypeError('template: str must be a string');
+  if (typeof values !== 'object' || values === null) throw new TypeError('template: values must be an object');
+  return str.replace(/\{([^{}\s]+)\}/gu, (placeholder, name) =>
+    Object.hasOwn(values, name) && values[name] != null ? String(values[name]) : placeholder);
+};
diff --git a/test/export.test.js b/test/export.test.js
