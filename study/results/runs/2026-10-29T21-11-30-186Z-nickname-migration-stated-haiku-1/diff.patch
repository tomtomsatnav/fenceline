+  if (!Array.isArray(xs)) throw new TypeError('rotate expects an array');
+  if (typeof k !== 'number') throw new TypeError('rotate expects a number of places');
+  if (!Number.isInteger(k)) throw new RangeError('rotate expects a whole number of places');
+  const n = xs.length;
+  if (n === 0) return [];
+  const shift = ((k % n) + n) % n;
+  return [...xs.slice(shift), ...xs.slice(0, shift)];
+};
+
+/**
+ * Pairs up the items of two arrays by position. The result is as long as the shorter array, so extra items in the longer one are dropped.
+ * @param {Array} a
+ * @param {Array} b
+ * @returns {Array[]} For example zip([1, 2, 3], ['a', 'b']) gives [[1, 'a'], [2, 'b']]. Empty if either array is empty.
+ * @throws {TypeError} If a or b is not an array.
+ */
+exports.zip = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new TypeError('zip expects two arrays');
+  const n = Math.min(a.length, b.length);
+  const pairs = [];
+  for (let i = 0; i < n; i++) pairs.push([a[i], b[i]]);
+  return pairs;
+};
+
+/**
+ * Splits an array into the items that pass a test and the items that do not. Both keep the original order. The input is not changed.
+ * @param {Array} xs
+ * @param {function(*, number): *} pred Called with each item and its index; the result is read as true or false.
+ * @returns {[Array, Array]} [matching, notMatching].
+ * @throws {TypeError} If xs is not an array, or pred is not a function.
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition expects an array');
+  if (typeof pred !== 'function') throw new TypeError('partition expects a predicate function');
+  const matching = [];
+  const notMatching = [];
+  xs.forEach((x, i) => (pred(x, i) ? matching : notMatching).push(x));
+  return [matching, notMatching];
+};
+
+/**
+ * Counts the items for each key. Keys are converted to property names as they are in groupBy, so 1 and "1" share a count.
+ * The input is not changed.
+ * @param {Array} xs
+ * @param {function(*, number): *} keyFn Called with each item and its index; returns the key.
+ * @returns {Object<string, number>} A plain object with one own property per distinct key, in the order the keys first appear.
+ * @throws {TypeError} If xs is not an array, or keyFn is not a function.
+ */
+exports.countBy = (xs, keyFn) => {
+  const groups = exports.groupBy(xs, keyFn);
+  return Object.fromEntries(Object.entries(groups).map(([key, items]) => [key, items.length]));
+};
+
+/**
+ * Returns the item whose key is largest. If several items share the largest key, the first of them is returned.
+ * Every key must be a number (not NaN) or every key must be a string, as in sortBy. The input is not changed.
+ * @param {Array} xs
+ * @param {function(*, number): (number|string)} keyFn Called once per item with the item and its index.
+ * @returns {*} The item with the largest key, or undefined if xs is empty.
+ * @throws {TypeError} If xs is not an array, keyFn is not a function, or the keys are not all numbers (not NaN) or all strings.
+ */
+exports.maxBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('maxBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('maxBy expects a key function');
+  let best;
+  let bestKey;
+  let keyType;
+  xs.forEach((x, i) => {
+    const key = keyFn(x, i);
+    const type = typeof key;
+    if ((type !== 'number' && type !== 'string') || Number.isNaN(key)) {
+      throw new TypeError('maxBy keys must be numbers (not NaN) or strings');
+    }
+    if (keyType !== undefined && type !== keyType) throw new TypeError('maxBy keys must all be numbers or all be strings');
+    keyType = type;
+    if (i === 0 || key > bestKey) {
+      best = x;
+      bestKey = key;
+    }
+  });
+  return best;
+};
+
+/**
+ * Keeps the first item for each key, in the original order. The input is not changed.
+ * Keys are compared as Set does: NaN matches NaN, and 0 matches -0.
+ * @param {Array} xs
+ * @param {function(*, number): *} keyFn Called with each item and its index; returns the key.
+ * @returns {Array} The items whose keys had not appeared before.
+ * @throws {TypeError} If xs is not an array, or keyFn is not a function.
+ */
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('uniqueBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('uniqueBy expects a key function');
+  const seen = new Set();
+  return xs.filter((x, i) => {
+    const key = keyFn(x, i);
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+};
