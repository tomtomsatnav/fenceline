+  if (typeof s !== 'string') throw new TypeError('isStrongPassword expects a string');
+  if ([...s].length < MIN_PASSWORD_LENGTH) return false;
+  return /\p{Ll}/u.test(s) && /\p{Lu}/u.test(s) && /\p{Nd}/u.test(s) && /[^\p{L}\p{N}\s]/u.test(s);
+};
+
+/**
+ * Checks whether a string is an absolute http or https URL with a host, using the URL class to parse it.
+ * The scheme may be in any case. Spaces are rejected, and so is a URL whose text does not begin "http://" or "https://" followed by a host.
+ * @param {string} s
+ * @returns {boolean}
+ * @throws {TypeError} If s is not a string.
+ */
+exports.isUrl = (s) => {
+  if (typeof s !== 'string') throw new TypeError('isUrl expects a string');
+  if (/\s/.test(s) || !/^https?:\/\/[^/?#]/i.test(s)) return false;
+  let url;
+  try {
+    url = new URL(s);
+  } catch {
+    return false;
+  }
+  return (url.protocol === 'http:' || url.protocol === 'https:') && url.hostname !== '';
+};
+
+// A UK postcode: an outward code (area and district) and an inward code (sector and unit), with the space optional.
+// The letters the Royal Mail never uses in each position are left out, as are the letters C, I, K, M, O, Q, R, S, and V in the unit.
+// GIR 0AA, the old Girobank code, is accepted as well.
+const UK_POSTCODE = /^(GIR ?0AA|[A-PR-UWYZ]([0-9]{1,2}|[A-HK-Y][0-9]([0-9ABEHMNPRV-Y])?|[0-9][A-HJKPS-UW]) ?[0-9][ABD-HJLNP-UW-Z]{2})$/i;
+
+/**
+ * Checks whether a string is a UK postcode such as "SW1A 1AA". Case does not matter, and the space is optional.
+ * Leading, trailing, or doubled spaces are rejected. The code is checked for shape only, not against the list of real postcodes.
+ * @param {string} s
+ * @returns {boolean}
+ * @throws {TypeError} If s is not a string.
+ */
+exports.isPostcodeUK = (s) => {
+  if (typeof s !== 'string') throw new TypeError('isPostcodeUK expects a string');
+  return UK_POSTCODE.test(s);
+};
+
+// A short list of common ISO 4217 currency codes. It is not every currency in the standard.
+const COMMON_CURRENCIES = new Set([
+  'USD', 'EUR', 'GBP', 'JPY', 'CHF', 'CAD', 'AUD', 'NZD', 'CNY', 'HKD', 'SGD', 'KRW',
+  'INR', 'BRL', 'MXN', 'ZAR', 'SEK', 'NOK', 'DKK', 'PLN', 'CZK', 'HUF', 'ILS', 'TRY',
+]);
+
+/**
+ * Checks whether a string is one of a short list of common ISO 4217 currency codes, such as "USD" or "EUR".
+ * The code must be three upper-case letters, so "usd" is rejected. Currencies outside the list are rejected too.
+ * @param {string} s
+ * @returns {boolean}
+ * @throws {TypeError} If s is not a string.
+ */
+exports.isIsoCurrency = (s) => {
+  if (typeof s !== 'string') throw new TypeError('isIsoCurrency expects a string');
+  return COMMON_CURRENCIES.has(s);
+};
+
+/**
+ * A reasonable check that a string looks like an email address: one "@", a local part, and a domain with at least one dot.
+ * It is not a full RFC 5322 check. Quoted local parts and non-ASCII letters are rejected, and no mail is sent to test the address.
+ * @param {string} s
+ * @returns {boolean} true if the string looks like an email address.
+ * @throws {TypeError} If s is not a string.
+ */
+exports.isEmail = (s) => {
+  if (typeof s !== 'string') throw new TypeError('isEmail expects a string');
+  if (s.length > 254) return false;
+  const parts = s.split('@');
+  if (parts.length !== 2) return false;
+  const [local, domain] = parts;
+  if (local.length > 64 || !LOCAL_PART.test(local)) return false;
+  const labels = domain.split('.');
+  if (labels.length < 2) return false;
+  if (!labels.every((label) => label.length <= 63 && DOMAIN_LABEL.test(label))) return false;
+  return TOP_LEVEL_DOMAIN.test(labels[labels.length - 1]);
+};
diff --git a/test/export.test.js b/test/export.test.js
new file mode 100644
index 0000000..f1bb928
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,74 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { createUser, recordLogin } = require('../src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+const { listUsers } = require('../src/api/users.js');
+
+test('exports only the header for an empty database', () => {
+  const db = migrate(new Db());
+  assert.strictEqual(exportUsersCsv(db), 'id,email,fullName,createdAt,lastLogin\n');
+});
+
+test('exports one row per user, oldest first, with empty lastLogin when unset', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'b', email: 'bob@example.com', fullname: 'Bob', created_at: '2024-02-01T00:00:00.000Z' });
+  db.insert('users', { id: 'a', email: 'ada@example.com', fullname: 'Ada', created_at: '2024-01-01T00:00:00.000Z' });
+  recordLogin(db, 'a', new Date('2024-03-01T00:00:00.000Z'));
+  assert.strictEqual(exportUsersCsv(db), [
+    'id,email,fullName,createdAt,lastLogin',
+    'a,ada@example.com,Ada,2024-01-01T00:00:00.000Z,2024-03-01T00:00:00.000Z',
+    'b,bob@example.com,Bob,2024-02-01T00:00:00.000Z,',
+    '',
+  ].join('\n'));
+});
+
+test('quotes fields containing commas, quotes, or line breaks', () => {
+  const db = migrate(new Db());
+  createUser(db, { email: 'ada@example.com', fullName: 'Lovelace, Ada "Countess"' });
+  createUser(db, { email: 'bob@example.com', fullName: 'Bob\nSmith' });
+  const lines = exportUsersCsv(db).split('\n');
+  assert.ok(lines[1].includes(',"Lovelace, Ada ""Countess""",'));
+  assert.ok(exportUsersCsv(db).includes('"Bob\nSmith"'));
+});
+
+test('round-trips users through export and import', () => {
+  const source = migrate(new Db());
+  createUser(source, { email: 'ada@example.com', fullName: 'Lovelace, Ada "Countess"' });
+  createUser(source, { email: 'bob@example.com', fullName: 'Bob\nSmith' });
+  createUser(source, { email: 'cy@example.com', fullName: 'Cy' });
+  recordLogin(source, listUsers(source)[1].id, new Date('2024-03-01T00:00:00.000Z'));
+
+  const target = migrate(new Db());
+  assert.strictEqual(importUsersCsv(target, exportUsersCsv(source)), 3);
+  assert.deepStrictEqual(listUsers(target), listUsers(source));
+  assert.strictEqual(exportUsersCsv(target), exportUsersCsv(source));
+});
+
+test('import rejects a bad row and leaves no users behind', () => {
+  const db = migrate(new Db());
+  createUser(db, { email: 'ada@example.com', fullName: 'Ada' });
+  const csv = [
+    'id,email,fullName,createdAt,lastLogin',
+    'x1,new@example.com,New,2024-01-01T00:00:00.000Z,',
+    'x2,ada@example.com,Dup,2024-01-01T00:00:00.000Z,',
+    '',
+  ].join('\n');
+  assert.throws(() => importUsersCsv(db, csv), Error);
+  assert.deepStrictEqual(listUsers(db).map((u) => u.email), ['ada@example.com']);
+});
+
+test('import rejects a CSV with the wrong header', () => {
+  const db = migrate(new Db());
+  assert.throws(() => importUsersCsv(db, 'email,name\na@example.com,A\n'), /unexpected CSV header/);
+  assert.throws(() => importUsersCsv(db, ''), /unexpected CSV header/);
+});
+
+test('exports every user, not just the first page', () => {
+  const db = migrate(new Db());
+  for (let i = 0; i < 51; i++) {
+    db.insert('users', { id: `u${i}`, email: `u${i}@example.com`, fullname: `User ${i}`, created_at: `2024-01-01T00:00:${String(i).padStart(2, '0')}.000Z` });
+  }
+  assert.strictEqual(exportUsersCsv(db).trim().split('\n').length, 52);
+});
