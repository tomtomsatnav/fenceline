+++ b/src/lib/numbers.js
@@ -0,0 +1,324 @@
+/**
+ * Arithmetic mean of an array of numbers. Each item is divided by the count before it is added, so large values do not overflow.
+ * @param {number[]} xs
+ * @returns {number} The mean, or NaN if xs is empty.
+ * @throws {TypeError} If xs is not an array, or contains a non-number.
+ */
+exports.mean = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('mean expects an array');
+  for (const x of xs) {
+    if (typeof x !== 'number') throw new TypeError('mean expects an array of numbers');
+  }
+  if (xs.length === 0) return NaN;
+  return xs.reduce((sum, x) => sum + x / xs.length, 0);
+};
+
+// A sorted copy of xs, after checking that it is an array of numbers that are not NaN.
+const sortedNumbers = (name, xs) => {
+  if (!Array.isArray(xs)) throw new TypeError(`${name} expects an array`);
+  for (const x of xs) {
+    if (typeof x !== 'number' || Number.isNaN(x)) throw new TypeError(`${name} expects an array of numbers that are not NaN`);
+  }
+  return [...xs].sort((a, b) => a - b);
+};
+
+/**
+ * Population standard deviation: the square root of the mean squared distance from the mean. Divides by the count, not count - 1.
+ * Scaled by the largest distance from the mean, so values near the largest number do not overflow. The input is not changed.
+ * @param {number[]} xs
+ * @returns {number} The standard deviation, or NaN if xs is empty. 0 when every value is the same.
+ * @throws {TypeError} If xs is not an array, or contains a non-number or NaN.
+ * @throws {RangeError} If xs contains Infinity or -Infinity, since the deviation is not defined then.
+ */
+exports.stdDev = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('stdDev expects an array');
+  for (const x of xs) {
+    if (typeof x !== 'number' || Number.isNaN(x)) throw new TypeError('stdDev expects an array of numbers that are not NaN');
+    if (!Number.isFinite(x)) throw new RangeError('stdDev expects finite numbers');
+  }
+  if (xs.length === 0) return NaN;
+  const m = exports.mean(xs);
+  const devs = xs.map((x) => x - m);
+  const scale = devs.reduce((largest, d) => Math.max(largest, Math.abs(d)), 0);
+  if (scale === 0) return 0;
+  const meanSquare = devs.reduce((sum, d) => sum + (d / scale) ** 2, 0) / xs.length;
+  return scale * Math.sqrt(meanSquare);
+};
+
+/**
+ * Middle value of an array of numbers. For an even count, the average of the two middle values. The input is not changed.
+ * @param {number[]} xs
+ * @returns {number} The median, or NaN if xs is empty.
+ * @throws {TypeError} If xs is not an array, or contains a non-number or NaN.
+ */
+exports.median = (xs) => {
+  const sorted = sortedNumbers('median', xs);
+  if (sorted.length === 0) return NaN;
+  const mid = Math.floor(sorted.length / 2);
+  if (sorted.length % 2 === 1) return sorted[mid];
+  return sorted[mid - 1] + (sorted[mid] - sorted[mid - 1]) / 2;
+};
+
+/**
+ * Value at percentile p of an array, by linear interpolation between the two nearest sorted values.
+ * This is the same as numpy's default. percentile(xs, 50) equals median(xs). The input is not changed.
+ * @param {number[]} xs
+ * @param {number} p A number from 0 to 100 inclusive.
