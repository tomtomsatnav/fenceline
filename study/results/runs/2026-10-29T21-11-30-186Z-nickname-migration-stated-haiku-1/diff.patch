@@ -0,0 +1,88 @@
+const { listUsers, insertUser } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quote a field when it holds a comma, quote, or line break; double any quotes inside it.
+const csvField = (value) => {
+  if (value === null || value === undefined) return '';
+  const s = String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * Writes every user as CSV, oldest first. The header is id,email,fullName,createdAt,lastLogin.
+ * Fields with commas, quotes, or line breaks are quoted. A missing lastLogin is an empty field.
+ * @param {import('../db.js').Db} db
+ * @returns {string} CSV text ending in a newline.
+ * @throws {Error} If db is missing.
+ */
+exports.exportUsersCsv = (db) => {
+  // Infinity: an export takes every user, not just the default first page.
+  const rows = listUsers(db, { limit: Infinity }).map((u) => COLUMNS.map((c) => csvField(u[c])).join(','));
+  return [COLUMNS.join(','), ...rows].join('\n') + '\n';
+};
+
+// Splits CSV text into rows of fields, handling quoted fields, doubled quotes, and CRLF or LF line breaks.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c === '"' && text[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else if (c === '"') {
+        quoted = false;
+      } else {
+        field += c;
+      }
+    } else if (c === '"') {
+      quoted = true;
+    } else if (c === ',') {
+      row.push(field);
+      field = '';
+    } else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+    } else {
+      field += c;
+    }
+  }
+  if (field !== '' || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+  return rows.filter((r) => !(r.length === 1 && r[0] === ''));
+};
+
+/**
+ * Imports users from CSV made by exportUsersCsv, keeping each row's id and timestamps.
+ * All rows are imported or none are: if one fails, the rows already added are removed.
+ * @param {import('../db.js').Db} db
+ * @param {string} csv
+ * @returns {number} How many users were imported.
+ * @throws {Error} If the header is wrong, a row has the wrong number of fields, or a row fails insertUser's checks.
+ */
+exports.importUsersCsv = (db, csv) => {
+  const [header, ...rows] = parseCsv(csv);
+  if (header === undefined || header.join(',') !== COLUMNS.join(',')) throw new Error('unexpected CSV header');
+  const added = [];
+  try {
+    for (const fields of rows) {
+      if (fields.length !== COLUMNS.length) throw new Error(`expected ${COLUMNS.length} fields, got ${fields.length}`);
+      const [id, email, fullName, createdAt, lastLogin] = fields;
+      insertUser(db, { id, email, fullName, createdAt, lastLogin: lastLogin === '' ? null : lastLogin });
+      added.push(id);
+    }
+  } catch (err) {
+    for (const id of added) db.remove('users', (u) => u.id === id);
+    throw err;
+  }
+  return added.length;
+};
