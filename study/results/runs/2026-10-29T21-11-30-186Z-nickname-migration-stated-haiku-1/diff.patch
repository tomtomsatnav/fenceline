index 0000000..ef0eabd
--- /dev/null
+++ b/src/lib/arrays.js
@@ -0,0 +1,284 @@
+/**
+ * Splits an array into consecutive arrays of length n. The last one may be shorter. The input is not changed.
+ * @param {Array} xs
+ * @param {number} n A positive integer.
+ * @returns {Array[]} For example chunk([1, 2, 3, 4, 5], 2) gives [[1, 2], [3, 4], [5]]. Empty if xs is empty.
+ * @throws {TypeError} If xs is not an array.
+ * @throws {RangeError} If n is not a positive integer.
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk expects an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('chunk expects a positive integer size');
+  const chunks = [];
+  for (let i = 0; i < xs.length; i += n) chunks.push(xs.slice(i, i + n));
+  return chunks;
+};
+
+/**
+ * Groups items by key. Each key maps to an array of its items, in the original order. The input is not changed.
+ * Keys are converted to property names as objects are, so 1 and "1" share a group.
+ * @param {Array} xs
+ * @param {function(*, number): *} keyFn Called with each item and its index; returns the key.
+ * @returns {Object<string, Array>} A plain object with one own property per distinct key.
+ * @throws {TypeError} If xs is not an array, or keyFn is not a function.
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy expects a key function');
+  const groups = {};
+  xs.forEach((x, i) => {
+    const key = keyFn(x, i);
+    // defineProperty, not assignment, so a key such as "__proto__" becomes an ordinary property.
+    if (!Object.prototype.hasOwnProperty.call(groups, key)) {
+      Object.defineProperty(groups, key, { value: [], enumerable: true, writable: true, configurable: true });
+    }
+    groups[key].push(x);
+  });
+  return groups;
+};
+
+/**
+ * Returns every run of n consecutive items, each starting one item after the last. The input is not changed.
+ * @param {Array} xs
+ * @param {number} n A positive integer.
+ * @returns {Array[]} For example windowed([1, 2, 3, 4], 2) gives [[1, 2], [2, 3], [3, 4]]. Empty if xs has fewer than n items.
+ * @throws {TypeError} If xs is not an array.
+ * @throws {RangeError} If n is not a positive integer.
+ */
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed expects an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('windowed expects a positive integer size');
+  const windows = [];
+  for (let i = 0; i + n <= xs.length; i++) windows.push(xs.slice(i, i + n));
+  return windows;
+};
+
+/**
+ * Picks one item at random, each item equally likely. The input is not changed.
+ * @param {Array} xs
+ * @param {function(): number} [rng=Math.random] Returns a number in [0, 1). Pass a seeded one to get repeatable results.
+ * @returns {*} One item of xs, or undefined if xs is empty.
+ * @throws {TypeError} If xs is not an array, or rng is not a function.
+ * @throws {RangeError} If rng returns a number outside [0, 1).
+ */
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new TypeError('sample expects an array');
+  if (typeof rng !== 'function') throw new TypeError('sample expects a random number function');
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new RangeError('sample expects rng to return a number in [0, 1)');
+  return xs[Math.floor(r * xs.length)];
+};
+
+/**
+ * Returns a new array sorted by key. The sort is stable, so items with equal keys keep their original order. The input is not changed.
+ * Keys are computed once per item. Every key must be a number (not NaN) or every key must be a string; strings compare by UTF-16 code unit.
+ * @param {Array} xs
+ * @param {function(*, number): (number|string)} keyFn Called with each item and its index.
+ * @returns {Array} The sorted items.
+ * @throws {TypeError} If xs is not an array, keyFn is not a function, or the keys are not all numbers (not NaN) or all strings.
+ */
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('sortBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('sortBy expects a key function');
+  const keyed = xs.map((x, i) => ({ x, key: keyFn(x, i) }));
+  const numeric = keyed.every(({ key }) => typeof key === 'number' && !Number.isNaN(key));
+  const textual = keyed.every(({ key }) => typeof key === 'string');
+  if (!numeric && !textual) throw new TypeError('sortBy keys must all be numbers (not NaN) or all be strings');
+  return keyed.sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0)).map(({ x }) => x);
+};
+
+/**
+ * Flattens arrays nested to any depth into one array of the non-array items, in order. The input is not changed.
+ * An array that appears twice, but not inside itself, is flattened both times.
+ * @param {Array} xs
+ * @returns {Array} For example flattenDeep([1, [2, [3, [4]]]]) gives [1, 2, 3, 4]. Empty if xs has no items.
+ * @throws {TypeError} If xs is not an array, or contains itself.
+ */
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep expects an array');
+  const out = [];
+  const walk = (arr, ancestors) => {
+    if (ancestors.has(arr)) throw new TypeError('flattenDeep cannot flatten an array that contains itself');
+    ancestors.add(arr);
+    for (const x of arr) {
+      if (Array.isArray(x)) walk(x, ancestors);
+      else out.push(x);
+    }
+    ancestors.delete(arr);
+  };
+  walk(xs, new Set());
+  return out;
+};
+
+/**
+ * Makes the numbers from start up to but not including end, stepping by step. A negative step counts down.
+ * Each value is computed as start + k * step, so floating-point steps do not drift.
+ * @param {number} start
+ * @param {number} end Excluded.
+ * @param {number} [step=1] A non-zero, finite number.
+ * @returns {number[]} For example range(0, 5) gives [0, 1, 2, 3, 4] and range(3, 0, -1) gives [3, 2, 1]. Empty if the step goes the wrong way.
+ * @throws {TypeError} If start, end, or step is not a finite number.
+ * @throws {RangeError} If step is 0, which would never end.
+ */
+exports.range = (start, end, step = 1) => {
+  for (const v of [start, end, step]) {
+    if (typeof v !== 'number' || !Number.isFinite(v)) throw new TypeError('range expects finite numbers');
+  }
+  if (step === 0) throw new RangeError('range step must not be 0');
+  const values = [];
+  for (let k = 0; ; k++) {
+    const v = start + k * step;
+    if (step > 0 ? v >= end : v <= end) break;
+    values.push(v);
+  }
+  return values;
+};
+
+/**
+ * The items of a that are not in b, in the order they appear in a. Membership is checked as Set does, so NaN matches NaN.
+ * Duplicates in a are kept, and the input is not changed.
+ * @param {Array} a
+ * @param {Array} b
+ * @returns {Array} For example difference([1, 2, 3, 2], [2]) gives [1, 3].
+ * @throws {TypeError} If a or b is not an array.
+ */
+exports.difference = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new TypeError('difference expects two arrays');
+  const inB = new Set(b);
+  return a.filter((x) => !inB.has(x));
+};
+
+/**
+ * The items that appear in every one of the arrays given, in the order they first appear in the first array.
+ * Each item is kept once, even if it repeats. Membership is checked as Set does, and the inputs are not changed.
+ * @param {...Array} arrays At least one array.
+ * @returns {Array} For example intersection([1, 2, 2, 3], [2, 3, 4]) gives [2, 3].
+ * @throws {RangeError} If no arrays are given.
+ * @throws {TypeError} If any argument is not an array.
