+// Splits on runs of anything that is not a letter or digit, and before an upper-case letter that follows a lower-case letter or digit.
+const words = (s) => s.split(/[^\p{L}\p{N}]+|(?<=[\p{Ll}\p{N}])(?=\p{Lu})/u).filter((w) => w !== '');
