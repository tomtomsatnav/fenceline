+ * @throws {TypeError} If s is not a string.
+ */
+exports.camelCase = (s) => {
+  if (typeof s !== 'string') throw new TypeError('camelCase expects a string');
+  return words(s)
+    .map((w, i) => {
+      const [first, ...rest] = [...w.toLowerCase()];
+      return i === 0 ? [first, ...rest].join('') : first.toUpperCase() + rest.join('');
+    })
+    .join('');
+};
+
+/**
+ * Converts a phrase to kebab-case, lower-case words joined by hyphens. Splits the same way as camelCase.
+ * @param {string} s
