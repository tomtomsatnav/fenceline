+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+/**
+ * Counts the whole days from one date to another, in UTC. Only the UTC calendar date of each is used, so the time of day is ignored.
+ * @param {Date} from
+ * @param {Date} to
+ * @returns {number} Positive if to is later, negative if it is earlier, and 0 for the same UTC day. For example, from 2024-01-01T23:59 UTC to 2024-01-02T00:01 UTC gives 1.
+ * @throws {TypeError} If from or to is not a Date.
+ * @throws {RangeError} If from or to is an invalid Date.
+ */
+exports.daysBetween = (from, to) => {
+  for (const d of [from, to]) {
+    if (!(d instanceof Date)) throw new TypeError('daysBetween expects Dates');
+    if (Number.isNaN(d.getTime())) throw new RangeError('daysBetween expects valid Dates');
+  }
+  const dayStart = (d) => Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
+  return (dayStart(to) - dayStart(from)) / MS_PER_DAY;
+};
+
+/**
+ * Checks whether a date falls on a Saturday or Sunday, using UTC.
+ * @param {Date} date
+ * @returns {boolean} true on Saturday or Sunday in UTC.
+ * @throws {TypeError} If date is not a Date.
+ * @throws {RangeError} If date is an invalid Date.
+ */
+exports.isWeekend = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('isWeekend expects a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('isWeekend expects a valid Date');
+  const day = date.getUTCDay();
+  return day === 0 || day === 6;
+};
+
+/**
+ * Finds the Monday at 00:00 UTC of the week containing a date. Weeks run Monday to Sunday.
+ * @param {Date} date
+ * @returns {Date} A new Date. The input is not changed.
+ * @throws {TypeError} If date is not a Date.
+ * @throws {RangeError} If date is an invalid Date.
+ */
+exports.startOfWeek = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('startOfWeek expects a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('startOfWeek expects a valid Date');
+  // getUTCDay counts from Sunday = 0, so (day + 6) % 7 is the number of days since the Monday of this week.
+  const daysSinceMonday = (date.getUTCDay() + 6) % 7;
+  return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate() - daysSinceMonday));
+};
+
+/**
+ * Formats the UTC calendar date of a Date as YYYY-MM-DD. The time of day is left out.
+ * @param {Date} date
+ * @returns {string} For example "2024-06-05". Years are written with four digits, so 0 gives "0000".
+ * @throws {TypeError} If date is not a Date.
+ * @throws {RangeError} If date is invalid, or its UTC year is outside 0 to 9999, which YYYY-MM-DD cannot show.
+ */
+exports.formatIsoDate = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('formatIsoDate expects a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('formatIsoDate expects a valid Date');
+  const year = date.getUTCFullYear();
+  if (year < 0 || year > 9999) throw new RangeError('formatIsoDate can only format years 0 to 9999');
+  return date.toISOString().slice(0, 10);
+};
+
+/**
+ * Reads a YYYY-MM-DD string as midnight UTC on that date. The inverse of formatIsoDate.
+ * Only that exact form is accepted, and the date must exist in the calendar, so "2026-02-30" is rejected.
+ * @param {string} s
+ * @returns {Date} A new Date at 00:00 UTC.
+ * @throws {TypeError} If s is not a string.
+ * @throws {RangeError} If s is not in the form YYYY-MM-DD, or names a date that does not exist.
+ */
+exports.parseIsoDate = (s) => {
+  if (typeof s !== 'string') throw new TypeError('parseIsoDate expects a string');
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(s);
+  if (!match) throw new RangeError(`parseIsoDate expects YYYY-MM-DD, got "${s}"`);
+  const [year, month, day] = match.slice(1).map(Number);
+  // setUTCFullYear, not Date.UTC, so years 0 to 99 are not moved to 1900 to 1999.
+  const date = new Date(0);
+  date.setUTCFullYear(year, month - 1, day);
+  // The calendar wraps out-of-range days and months (February 30 becomes March 1), so check the fields came back unchanged.
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+    throw new RangeError(`parseIsoDate found no such date: "${s}"`);
+  }
+  return date;
+};
+
+const DURATION_UNITS = [[86400, 'd'], [3600, 'h'], [60, 'm'], [1, 's']];
+
+/**
+ * Writes a number of whole seconds as days, hours, minutes, and seconds, such as "1h 2m 5s". Units that are zero are left out,
+ * so 3600 gives "1h". The output reads back with parseDuration, as long as it is in the units parseDuration accepts.
+ * @param {number} seconds A whole number from 0 to Number.MAX_SAFE_INTEGER.
+ * @returns {string} For example formatDuration(3725) gives "1h 2m 5s", and formatDuration(0) gives "0s".
+ * @throws {TypeError} If seconds is not a number.
+ * @throws {RangeError} If seconds is negative, not a whole number, or larger than Number.MAX_SAFE_INTEGER.
+ */
+exports.formatDuration = (seconds) => {
+  if (typeof seconds !== 'number') throw new TypeError('formatDuration expects a number of seconds');
+  if (!Number.isSafeInteger(seconds) || seconds < 0) throw new RangeError('formatDuration expects a non-negative whole number of seconds');
+  if (seconds === 0) return '0s';
+  let rest = seconds;
+  const parts = [];
+  for (const [size, unit] of DURATION_UNITS) {
+    const count = Math.floor(rest / size);
+    if (count > 0) parts.push(`${count}${unit}`);
+    rest -= count * size;
+  }
+  return parts.join(' ');
+};
+
+/**
+ * Adds whole calendar months in UTC. If the day does not exist in the target month, it is moved back to that month's last day,
+ * so January 31 plus one month is February 28, or February 29 in a leap year. The time of day is kept. The input is not changed.
+ * @param {Date} date
+ * @param {number} n A whole number of months. Negative values go back.
+ * @returns {Date} A new Date.
+ * @throws {TypeError} If date is not a Date, or n is not a number.
+ * @throws {RangeError} If date is an invalid Date, or n is not a whole number.
+ */
+exports.addMonths = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError('addMonths expects a Date');
+  if (typeof n !== 'number') throw new TypeError('addMonths expects a number of months');
+  if (Number.isNaN(date.getTime())) throw new RangeError('addMonths expects a valid Date');
+  if (!Number.isInteger(n)) throw new RangeError('addMonths expects a whole number of months');
+  const monthIndex = date.getUTCFullYear() * 12 + date.getUTCMonth() + n;
+  if (!Number.isSafeInteger(monthIndex)) throw new RangeError('addMonths result is too large to represent exactly');
+  const year = Math.floor(monthIndex / 12);
+  const month = monthIndex - year * 12;
+  const day = Math.min(date.getUTCDate(), exports.daysInMonth(year, month + 1));
+  const result = new Date(date.getTime());
+  // setUTCFullYear keeps the time of day, and does not move years 0 to 99 to 1900 to 1999.
+  result.setUTCFullYear(year, month, day);
+  return result;
+};
+
+/**
+ * The calendar quarter of a date, in UTC: 1 for January to March, 2 for April to June, 3 for July to September, 4 for October to December.
+ * @param {Date} date
+ * @returns {number} 1, 2, 3, or 4.
+ * @throws {TypeError} If date is not a Date.
+ * @throws {RangeError} If date is an invalid Date.
+ */
+exports.quarterOf = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('quarterOf expects a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('quarterOf expects a valid Date');
+  return Math.floor(date.getUTCMonth() / 3) + 1;
+};
+
+const DAYS_IN_MONTH = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+/**
+ * The number of days in a month of the Gregorian calendar. February has 29 days in leap years.
+ * @param {number} year A whole number, as isLeapYear reads it.
+ * @param {number} month A whole number from 1 (January) to 12 (December).
+ * @returns {number} For example daysInMonth(2024, 2) gives 29, and daysInMonth(2023, 2) gives 28.
+ * @throws {TypeError} If year or month is not a number.
+ * @throws {RangeError} If year is not a whole number, or month is not a whole number from 1 to 12.
+ */
+exports.daysInMonth = (year, month) => {
+  const leap = exports.isLeapYear(year);
+  if (typeof month !== 'number') throw new TypeError('daysInMonth expects a number month');
+  if (!Number.isInteger(month) || month < 1 || month > 12) throw new RangeError('daysInMonth expects a month from 1 to 12');
+  if (month === 2 && leap) return 29;
+  return DAYS_IN_MONTH[month - 1];
+};
+
+/**
+ * Checks whether a year is a leap year in the Gregorian calendar: divisible by 4, except centuries, unless divisible by 400.
+ * The rule is extended back before year 1 and forward, so year 0 is a leap year and so is -400.
+ * @param {number} year A whole number.
+ * @returns {boolean}
+ * @throws {TypeError} If year is not a number.
+ * @throws {RangeError} If year is not a whole number.
+ */
+exports.isLeapYear = (year) => {
+  if (typeof year !== 'number') throw new TypeError('isLeapYear expects a number');
+  if (!Number.isInteger(year)) throw new RangeError('isLeapYear expects a whole number');
+  return (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
+};
+
+/**
+ * Whole years between a birth date and another date, in UTC. A birthday is reached on its calendar day.
+ * A 29 February birthday counts as reached on 1 March in years without a 29 February.
+ * @param {Date} birthDate
+ * @param {Date} date
+ * @returns {number} The age on date, from 0 up. 0 on the day of birth.
+ * @throws {TypeError} If birthDate or date is not a Date.
+ * @throws {RangeError} If either is an invalid Date, or date is before birthDate.
+ */
+exports.ageOn = (birthDate, date) => {
+  for (const d of [birthDate, date]) {
+    if (!(d instanceof Date)) throw new TypeError('ageOn expects Dates');
+    if (Number.isNaN(d.getTime())) throw new RangeError('ageOn expects valid Dates');
+  }
+  const birthYear = birthDate.getUTCFullYear();
+  const birthKey = birthDate.getUTCMonth() * 100 + birthDate.getUTCDate();
+  const year = date.getUTCFullYear();
+  const key = date.getUTCMonth() * 100 + date.getUTCDate();
+  const birthdayKey = birthKey === 229 && !exports.isLeapYear(year) ? 301 : birthKey;
+  if (exports.daysBetween(birthDate, date) < 0) throw new RangeError('ageOn expects date to be on or after birthDate');
+  return year - birthYear - (key < birthdayKey ? 1 : 0);
+};
+
+/**
+ * Describes how far date is from now, in words, such as "3 minutes ago" or "in 2 days".
+ * Uses seconds, minutes, hours, and days, and always rounds down. Gaps under a second give "just now".
+ * Days are fixed 24-hour periods, so across a daylight-saving change a day can count as 23 or 25 hours.
+ * @param {Date} date
+ * @param {Date} now The moment to compare with.
+ * @returns {string}
+ * @throws {TypeError} If date or now is not a Date.
+ * @throws {RangeError} If date or now is an invalid Date.
+ */
+exports.relativeTime = (date, now) => {
+  for (const d of [date, now]) {
+    if (!(d instanceof Date)) throw new TypeError('relativeTime expects Dates');
+    if (Number.isNaN(d.getTime())) throw new RangeError('relativeTime expects valid Dates');
+  }
+  const diff = date.getTime() - now.getTime();
+  const gap = Math.abs(diff);
+  if (gap < 1000) return 'just now';
+  const units = [
+    [86400000, 'day'],
+    [3600000, 'hour'],
+    [60000, 'minute'],
+    [1000, 'second'],
+  ];
+  const [size, unit] = units.find(([ms]) => gap >= ms);
+  const count = Math.floor(gap / size);
+  const label = `${count} ${unit}${count === 1 ? '' : 's'}`;
+  return diff < 0 ? `${label} ago` : `in ${label}`;
+};
+
+/**
+ * Returns a new Date n calendar days after date, in local time. The time of day is kept, even across a daylight-saving change.
+ * Month and year ends roll over as they do on a calendar. The input is not changed.
+ * @param {Date} date
+ * @param {number} n A whole number of days. Negative values go back in time.
+ * @returns {Date}
+ * @throws {TypeError} If date is not a Date, or n is not a number.
+ * @throws {RangeError} If date is an invalid Date, or n is not a whole number.
+ */
+exports.addDays = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError('addDays expects a Date');
+  if (typeof n !== 'number') throw new TypeError('addDays expects a number of days');
+  if (Number.isNaN(date.getTime())) throw new RangeError('addDays expects a valid Date');
+  if (!Number.isInteger(n)) throw new RangeError('addDays expects a whole number of days');
+  const result = new Date(date.getTime());
+  result.setDate(result.getDate() + n);
+  return result;
+};
