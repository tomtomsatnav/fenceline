@@ -0,0 +1,88 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+const { listUsers, countUsers } = require('../src/api/users.js');
+
+const HEADER = 'id,email,fullName,createdAt,lastLogin';
+
+test('exportUsersCsv with no users is just the header', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), `${HEADER}\n`);
+});
+
+test('exportUsersCsv writes one row per user, oldest first, with empty lastLogin', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: 'b', email: 'b@example.com', fullname: 'Bob', created_at: '2024-02-01T00:00:00.000Z', last_login: '2024-03-01T00:00:00.000Z' });
+  db.insert('users', { id: 'a', email: 'a@example.com', fullname: 'Ada', created_at: '2024-01-01T00:00:00.000Z' });
+  assert.strictEqual(
+    exportUsersCsv(db),
+    `${HEADER}\n` +
+      'a,a@example.com,Ada,2024-01-01T00:00:00.000Z,\n' +
+      'b,b@example.com,Bob,2024-02-01T00:00:00.000Z,2024-03-01T00:00:00.000Z\n',
+  );
+});
+
+test('exportUsersCsv quotes fields containing commas, quotes or newlines', () => {
+  const db = migrate(new Db());
+  db.insert('users', { id: '1', email: 'a@example.com', fullname: 'Lovelace, Ada', created_at: '2024-01-01T00:00:00.000Z' });
+  db.insert('users', { id: '2', email: 'b@example.com', fullname: 'Bob "The Builder" B', created_at: '2024-01-02T00:00:00.000Z' });
+  db.insert('users', { id: '3', email: 'c@example.com', fullname: 'Line\nBreak', created_at: '2024-01-03T00:00:00.000Z' });
+  assert.strictEqual(
+    exportUsersCsv(db),
+    `${HEADER}\n` +
+      '1,a@example.com,"Lovelace, Ada",2024-01-01T00:00:00.000Z,\n' +
+      '2,b@example.com,"Bob ""The Builder"" B",2024-01-02T00:00:00.000Z,\n' +
+      '3,c@example.com,"Line\nBreak",2024-01-03T00:00:00.000Z,\n',
+  );
+});
+
+test('exportUsersCsv throws a clear Error when db is missing', () => {
+  assert.throws(() => exportUsersCsv(undefined), { name: 'Error', message: 'exportUsersCsv: db is required' });
+});
+
+test('importUsersCsv round-trips exportUsersCsv', () => {
+  const src = migrate(new Db());
+  src.insert('users', { id: '1', email: 'a@example.com', fullname: 'Lovelace, Ada', created_at: '2024-01-01T00:00:00.000Z', last_login: '2024-05-01T00:00:00.000Z' });
+  src.insert('users', { id: '2', email: 'b@example.com', fullname: 'Bob "The Builder" B', created_at: '2024-01-02T00:00:00.000Z' });
+  src.insert('users', { id: '3', email: 'c@example.com', fullname: 'Line\nBreak', created_at: '2024-01-03T00:00:00.000Z' });
+  const csv = exportUsersCsv(src);
+
+  const dest = migrate(new Db());
+  assert.strictEqual(importUsersCsv(dest, csv), 3);
+  assert.deepStrictEqual(listUsers(dest), listUsers(src));
+  assert.strictEqual(exportUsersCsv(dest), csv);
+});
+
+test('importUsersCsv accepts CRLF line endings and an empty export', () => {
+  const dest = migrate(new Db());
+  assert.strictEqual(importUsersCsv(dest, `${HEADER}\n`), 0);
+  const csv = `${HEADER}\r\n1,a@example.com,Ada,2024-01-01T00:00:00.000Z,\r\n`;
+  assert.strictEqual(importUsersCsv(dest, csv), 1);
+  assert.strictEqual(listUsers(dest)[0].fullName, 'Ada');
+});
+
+test('importUsersCsv rejects bad input and imports nothing', () => {
+  const db = migrate(new Db());
+  const row = (id, email) => `${id},${email},Name,2024-01-01T00:00:00.000Z,\n`;
+  assert.throws(() => importUsersCsv(db, 'id,email\n1,a@example.com\n'), /header/);
+  assert.throws(() => importUsersCsv(db, `${HEADER}\n1,a@example.com\n`), /expected 5 fields/);
+  assert.throws(() => importUsersCsv(db, `${HEADER}\n1,"a@example.com,Name,2024-01-01T00:00:00.000Z,\n`), /unterminated/);
+  // second row is invalid: the first must be rolled back
+  assert.throws(() => importUsersCsv(db, `${HEADER}\n${row('1', 'a@example.com')}${row('2', 'nope')}`), /@/);
+  // duplicate email within the file
+  assert.throws(() => importUsersCsv(db, `${HEADER}\n${row('1', 'a@example.com')}${row('2', 'A@example.com')}`), /Duplicate email/);
+  assert.strictEqual(countUsers(db), 0);
+});
+
+test('importUsersCsv does not remove existing users when an import fails', () => {
+  const db = migrate(new Db());
+  importUsersCsv(db, `${HEADER}\n1,a@example.com,Ada,2024-01-01T00:00:00.000Z,\n`);
+  assert.throws(() => importUsersCsv(db, `${HEADER}\n2,b@example.com,Bob,2024-01-02T00:00:00.000Z,\n1,c@example.com,Dup,2024-01-03T00:00:00.000Z,\n`), /Duplicate id/);
+  assert.deepStrictEqual(listUsers(db).map((u) => u.id), ['1']);
+});
+
+test('importUsersCsv throws a clear Error when db or csv is missing', () => {
+  assert.throws(() => importUsersCsv(undefined, ''), { name: 'Error', message: 'importUsersCsv: db is required' });
+  assert.throws(() => importUsersCsv(migrate(new Db()), undefined), { name: 'Error', message: 'importUsersCsv: csv must be a string' });
+});
