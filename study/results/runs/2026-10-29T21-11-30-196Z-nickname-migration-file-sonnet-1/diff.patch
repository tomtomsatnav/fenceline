+  const reference = (born, on) => {
+    const day = (d) => Math.floor(d.getTime() / 86400000) * 86400000;
+    let k = 0;
+    while (Date.UTC(born.getUTCFullYear() + k + 1, born.getUTCMonth(), born.getUTCDate()) <= day(on)) k++;
+    return k;
+  };
+  for (let a = 0; a < 40; a++) {
+    const born = new Date(Date.UTC(1950, 0, 1) + a * 86400000 * 311 + a * 3600000);
+    for (let b = 0; b < 60; b++) {
+      const on = new Date(born.getTime() + b * 86400000 * 211 + b * 77777);
+      assert.strictEqual(ageOn(born, on), reference(born, on), `${born.toISOString()} to ${on.toISOString()}`);
+    }
+  }
+  for (const born of ['2000-02-29', '1996-02-29', '2004-02-28', '2003-03-01']) {
+    for (let day = utc(born), i = 0; i < 366 * 9; day = new Date(day.getTime() + 86400000), i++) {
