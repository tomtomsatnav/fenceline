+test('toRoman gives a valid numeral that reads back to n, for every n from 1 to 3999', () => {
+  const valid = /^M{0,3}(CM|CD|D?C{0,3})(XC|XL|L?X{0,3})(IX|IV|V?I{0,3})$/;
+  const values = { I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000 };
+  const fromRoman = (s) => {
+    let total = 0;
+    for (let i = 0; i < s.length; i++) {
+      const current = values[s[i]];
+      total += current < (values[s[i + 1]] ?? 0) ? -current : current;
+    }
+    return total;
+  };
+  const seen = new Set();
+  for (let n = 1; n <= 3999; n++) {
+    const roman = toRoman(n);
+    assert.match(roman, valid, `toRoman(${n}) = ${roman}`);
+    assert.strictEqual(fromRoman(roman), n, `toRoman(${n}) = ${roman}`);
+    seen.add(roman);
+  }
+  assert.strictEqual(seen.size, 3999); // every number has its own numeral
+});
