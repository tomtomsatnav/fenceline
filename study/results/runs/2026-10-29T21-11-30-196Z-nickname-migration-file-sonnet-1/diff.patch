+const checkObjectAndKeys = (name, obj, keys) => {
+  if (obj === null || typeof obj !== 'object') throw new TypeError(`${name}: obj must be an object`);
+  if (!Array.isArray(keys)) throw new TypeError(`${name}: keys must be an array`);
+  for (let i = 0; i < keys.length; i++) {
+    if (!['string', 'symbol', 'number'].includes(typeof keys[i])) throw new TypeError(`${name}: keys[${i}] must be a string, symbol or number`);
+  }
+};
