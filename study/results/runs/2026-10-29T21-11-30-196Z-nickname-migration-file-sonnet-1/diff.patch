+// A word is an acronym ("XML"), a capitalised or lowercase run ("Hello", "world"), or digits.
+const WORD = /\p{Lu}+(?!\p{Ll})|\p{Lu}?\p{Ll}+|\p{N}+/gu;
+
+// Lowercased words of str; apostrophes are dropped so "don't" stays one word.
+const words = (name, str) => {
+  if (typeof str !== 'string') throw new TypeError(`${name}: str must be a string`);
+  return (str.replace(/['’]/g, '').match(WORD) ?? []).map((w) => w.toLowerCase());
+};
+
+/**
+ * Converts text to camelCase: "hello world", "hello-world" and "hello_world" all become "helloWorld".
+ * Any run of characters that are not letters or digits separates words, existing camelCase and
+ * PascalCase are split into words too, and apostrophes are dropped ("don't stop" is "dontStop").
+ * @param {string} str
+ * @returns {string} "" if str has no letters or digits
+ * @throws {TypeError} if str is not a string
+ */
+exports.camelCase = (str) =>
+  words('camelCase', str)
+    .map((w, i) => (i === 0 ? w : w.charAt(0).toUpperCase() + w.slice(1)))
+    .join('');
+
+/**
+ * Converts text to kebab-case: "helloWorld" and "Hello World" both become "hello-world".
+ * Words are found as in camelCase (any run of non-letters/digits separates words, camelCase and
+ * PascalCase are split, apostrophes are dropped) and joined with single hyphens.
+ * @param {string} str
+ * @returns {string} "" if str has no letters or digits
+ * @throws {TypeError} if str is not a string
+ */
+exports.kebabCase = (str) => words('kebabCase', str).join('-');
+
+/**
+ * Shortens s to at most n characters, ending in "…" when anything was cut (the "…" counts towards n).
+ * Characters are Unicode code points, so surrogate pairs such as emoji are never split.
+ * @param {string} s
+ * @param {number} n non-negative integer, or Infinity for no limit
+ * @returns {string} s unchanged if it already fits; "" if n is 0
+ * @throws {TypeError} if s is not a string
+ * @throws {RangeError} if n is not a non-negative integer or Infinity
+ */
+exports.truncate = (s, n) => {
+  if (typeof s !== 'string') throw new TypeError('truncate: s must be a string');
+  if (n !== Infinity && (!Number.isInteger(n) || n < 0)) throw new RangeError('truncate: n must be a non-negative integer');
+  const chars = Array.from(s);
+  if (chars.length <= n) return s;
+  if (n === 0) return '';
+  return chars.slice(0, n - 1).join('') + '…';
+};
+
+/**
+ * Centres s in a field of the given width by padding both sides with ch.
+ * When the padding is odd the extra character goes on the right. A multi-character ch is repeated
+ * from its start on each side and cut to fit. Characters are Unicode code points.
+ * @param {string} s
+ * @param {number} width non-negative integer
+ * @param {string} [ch=" "] non-empty padding string
+ * @returns {string} s unchanged if it is already width characters or longer (it is never truncated)
+ * @throws {TypeError} if s or ch is not a string
+ * @throws {RangeError} if width is not a non-negative integer, or ch is empty
+ */
+exports.padCenter = (s, width, ch = ' ') => {
+  if (typeof s !== 'string') throw new TypeError('padCenter: s must be a string');
+  if (typeof ch !== 'string') throw new TypeError('padCenter: ch must be a string');
+  if (!Number.isInteger(width) || width < 0) throw new RangeError('padCenter: width must be a non-negative integer');
+  if (ch === '') throw new RangeError('padCenter: ch must not be empty');
+  const total = width - Array.from(s).length;
+  if (total <= 0) return s;
+  const fill = Array.from(ch);
+  const pad = (n) => Array.from({ length: n }, (_, i) => fill[i % fill.length]).join('');
+  const left = Math.floor(total / 2);
+  return pad(left) + s + pad(total - left);
+};
+
+// A word is a run of letters, digits and combining marks; an apostrophe between two of them stays inside.
+const COUNTED_WORD = /[\p{L}\p{N}\p{M}]+(?:['’][\p{L}\p{N}\p{M}]+)*/gu;
+
+/**
+ * Counts the words in a string. Runs of whitespace and punctuation (including hyphens and
+ * underscores) separate words, so "well-known" is two words; an apostrophe inside a word does
+ * not, so "don't" is one. Numbers count as words.
+ * @param {string} s
+ * @returns {number} 0 if s has no letters or digits
+ * @throws {TypeError} if s is not a string
+ */
+exports.countWords = (s) => {
+  if (typeof s !== 'string') throw new TypeError('countWords: s must be a string');
+  return (s.match(COUNTED_WORD) ?? []).length;
+};
+
+/**
+ * The first letter of each word in a name, uppercased: initials("Ada King Lovelace") is "AKL".
+ * Words are found as in countWords, so "Jean-Luc Picard" is "JLP" and "O'Brien" counts once.
+ * Words that do not start with a letter (numbers) are skipped, and a letter keeps its combining accents.
+ * @param {string} s
+ * @returns {string} "" if s has no words starting with a letter
+ * @throws {TypeError} if s is not a string
+ */
+exports.initials = (s) => {
+  if (typeof s !== 'string') throw new TypeError('initials: s must be a string');
+  return (s.match(COUNTED_WORD) ?? [])
+    .map((w) => w.match(/^\p{L}\p{M}*/u)?.[0] ?? '')
+    .join('')
+    .toUpperCase();
+};
+
+/**
+ * Reverses the order of the words in a sentence: reverseWords("one two three") is "three two one".
+ * A word is a run of non-whitespace characters, so punctuation stays attached to its word
+ * ("Hello, world!" becomes "world! Hello,"). Any run of whitespace, including tabs and newlines,
+ * becomes a single space, and leading and trailing whitespace is dropped.
+ * @param {string} s
+ * @returns {string} "" if s is empty or only whitespace
+ * @throws {TypeError} if s is not a string
+ */
+exports.reverseWords = (s) => {
+  if (typeof s !== 'string') throw new TypeError('reverseWords: s must be a string');
+  return (s.match(/\S+/g) ?? []).reverse().join(' ');
+};
+
+/**
+ * True when s reads the same backwards, ignoring case and everything that is not a letter or digit
+ * (spaces, punctuation, symbols, emoji): "A man, a plan, a canal: Panama" is a palindrome.
+ * Letters are compared with their accents, composed or not ("é" is not "e"), and a letter with its
+ * combining marks is reversed as one unit.
+ * @param {string} s
+ * @returns {boolean} true for "" and for text with no letters or digits, which read the same either way
+ * @throws {TypeError} if s is not a string
+ */
+exports.isPalindrome = (s) => {
+  if (typeof s !== 'string') throw new TypeError('isPalindrome: s must be a string');
+  const kept = (s.normalize('NFC').toLowerCase().match(/[\p{L}\p{N}][\p{M}]*/gu) ?? []);
+  return kept.every((unit, i) => unit === kept[kept.length - 1 - i]);
+};
+
+/**
+ * Word-wraps text so no line is longer than width, breaking only between words (greedy: each line
+ * takes as many words as fit). A word longer than width is not split; it gets a line of its own
+ * and that line is longer than width. Existing line breaks are kept, so blank lines separate
+ * paragraphs, and each line is wrapped on its own. Runs of spaces and tabs become one space and
+ * lines have no leading or trailing whitespace. Length counts Unicode code points. The result
+ * uses "\n" for every line break.
+ * @param {string} text
+ * @param {number} width positive integer
+ * @returns {string}
+ * @throws {TypeError} if text is not a string
+ * @throws {RangeError} if width is not a positive integer
+ */
+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new TypeError('wrap: text must be a string');
+  if (!Number.isInteger(width) || width < 1) throw new RangeError('wrap: width must be a positive integer');
+  return text
+    .split(/\r\n|\r|\n/)
+    .flatMap((line) => {
+      const out = [];
+      let current = '';
+      let currentLen = 0;
+      for (const word of line.match(/\S+/g) ?? []) {
+        const len = Array.from(word).length;
+        if (currentLen === 0) {
+          current = word;
+          currentLen = len;
+        } else if (currentLen + 1 + len <= width) {
+          current += ` ${word}`;
+          currentLen += 1 + len;
+        } else {
+          out.push(current);
+          current = word;
+          currentLen = len;
+        }
+      }
+      out.push(current);
+      return out;
+    })
+    .join('\n');
+};
+
+// "{{" and "}}" are escapes; otherwise a placeholder is a name in braces with no braces or whitespace inside.
+const PLACEHOLDER = /\{\{|\}\}|\{([^{}\s]+)\}/g;
+
+/**
+ * Fills {placeholders} in str from values: template("Hi {name}", { name: "Ada" }) is "Hi Ada".
+ * - A placeholder with no matching own property (or one whose value is undefined) is left as it is.
+ * - Values are converted with String(), so null becomes "null" and numbers are formatted.
+ * - Substitution is a single pass: braces inside a value are not expanded again.
+ * - "{{" and "}}" produce a literal "{" and "}", so "{{name}}" is the text "{name}".
+ * - Names are looked up as plain keys ("a.b" is the key "a.b", not a nested path), and only own
+ *   properties count, so "{constructor}" and "{toString}" are left alone.
+ * - "{}" and "{ name }" are not placeholders and are left as they are.
+ * @param {string} str
+ * @param {object} [values]
+ * @returns {string}
+ * @throws {TypeError} if str is not a string or values is not an object
+ */
+exports.template = (str, values = {}) => {
+  if (typeof str !== 'string') throw new TypeError('template: str must be a string');
+  if (values === null || typeof values !== 'object') throw new TypeError('template: values must be an object');
+  return str.replace(PLACEHOLDER, (match, name) => {
+    if (match === '{{') return '{';
+    if (match === '}}') return '}';
+    return Object.hasOwn(values, name) && values[name] !== undefined ? String(values[name]) : match;
+  });
+};
