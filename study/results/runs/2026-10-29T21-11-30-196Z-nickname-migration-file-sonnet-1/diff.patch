diff --git a/src/lib/arrays.js b/src/lib/arrays.js
new file mode 100644
index 0000000..bada65a
--- /dev/null
+++ b/src/lib/arrays.js
@@ -0,0 +1,274 @@
+/**
+ * Splits an array into consecutive arrays of length n; the last one is shorter when xs.length is not
+ * a multiple of n. chunk([1, 2, 3, 4, 5], 2) is [[1, 2], [3, 4], [5]]. Elements are not copied
+ * (the chunks are new arrays holding the same elements) and xs is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n positive integer
+ * @returns {T[][]} [] if xs is empty
+ * @throws {TypeError} if xs is not an array
+ * @throws {RangeError} if n is not a positive integer
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk: xs must be an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('chunk: n must be a positive integer');
+  const chunks = [];
+  for (let i = 0; i < xs.length; i += n) chunks.push(xs.slice(i, i + n));
+  return chunks;
+};
+
+/**
+ * Keeps the first item for each key, in their original order:
+ * uniqueBy([{ id: 1, v: 'a' }, { id: 1, v: 'b' }, { id: 2, v: 'c' }], (x) => x.id) keeps 'a' and 'c'.
+ * Keys are compared like Map keys (SameValueZero): NaN equals NaN, 0 equals -0, objects compare by
+ * identity, and undefined and null are ordinary keys, different from each other. keyFn is called
+ * once per item, in order, with (item, index). xs is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => unknown} keyFn
+ * @returns {T[]} a new array; [] if xs is empty
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('uniqueBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('uniqueBy: keyFn must be a function');
+  const seen = new Set();
+  const result = [];
+  for (let i = 0; i < xs.length; i++) {
+    const key = keyFn(xs[i], i);
+    if (seen.has(key)) continue;
+    seen.add(key);
+    result.push(xs[i]);
+  }
+  return result;
+};
+
+/**
+ * Groups items into arrays by key: groupBy([1, 2, 3, 4], (n) => (n % 2 ? 'odd' : 'even')) is
+ * { odd: [1, 3], even: [2, 4] }. Items keep their original order inside each group.
+ * Keys become property names, so they are converted as usual: 1 and "1" are the same group, and
+ * integer-like keys are listed before the others, in ascending order. Symbols work as keys.
+ * Names such as "constructor" and "__proto__" are ordinary keys and cannot break the result.
+ * keyFn is called once per item, in order, with (item, index). xs is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => PropertyKey} keyFn
+ * @returns {Record<PropertyKey, T[]>} a new plain object; {} if xs is empty
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy: keyFn must be a function');
+  const groups = {};
+  for (let i = 0; i < xs.length; i++) {
+    const key = keyFn(xs[i], i);
+    if (Object.hasOwn(groups, key)) {
+      groups[key].push(xs[i]);
+    } else {
+      // defineProperty, not assignment, so a "__proto__" key makes a property instead of setting the prototype
+      Object.defineProperty(groups, key, { value: [xs[i]], writable: true, enumerable: true, configurable: true });
+    }
+  }
+  return groups;
+};
+
+/**
+ * Splits an array in two by a predicate: partition([1, 2, 3, 4], (n) => n % 2 === 0) is
+ * [[2, 4], [1, 3]]. Items keep their original order in both halves, and every item lands in exactly
+ * one of them. pred is called once per item, in order, with (item, index), and its result is judged
+ * by truthiness. xs is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => unknown} pred
+ * @returns {[T[], T[]]} [matching, notMatching], two new arrays; [[], []] if xs is empty
+ * @throws {TypeError} if xs is not an array or pred is not a function
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition: xs must be an array');
+  if (typeof pred !== 'function') throw new TypeError('partition: pred must be a function');
+  const matching = [];
+  const notMatching = [];
+  for (let i = 0; i < xs.length; i++) (pred(xs[i], i) ? matching : notMatching).push(xs[i]);
+  return [matching, notMatching];
+};
+
+/**
+ * Pairs up items by position, stopping at the shorter array: zip([1, 2, 3], ['a', 'b']) is
+ * [[1, 'a'], [2, 'b']]. The extra items of the longer array are dropped. Items are not copied
+ * (each pair is a new two-element array holding the same items) and neither input is modified.
+ * @template A, B
+ * @param {A[]} a
+ * @param {B[]} b
+ * @returns {[A, B][]} [] if either array is empty
+ * @throws {TypeError} if a or b is not an array
+ */
+exports.zip = (a, b) => {
+  if (!Array.isArray(a)) throw new TypeError('zip: a must be an array');
+  if (!Array.isArray(b)) throw new TypeError('zip: b must be an array');
+  const length = Math.min(a.length, b.length);
+  const pairs = [];
+  for (let i = 0; i < length; i++) pairs.push([a[i], b[i]]);
+  return pairs;
+};
+
+/**
+ * The numbers from start up to but not including end, stepping by step:
+ * range(0, 5) is [0, 1, 2, 3, 4], range(10, 0, -3) is [10, 7, 4, 1], range(0, 1, 0.25) is [0, 0.25, 0.5, 0.75].
+ * - A step that points away from end (positive with start > end, or negative with start < end)
+ *   gives [], as does start equal to end.
+ * - Each item is start + i * step, so rounding errors do not build up, and a quotient within a
+ *   tiny tolerance (1e-9, relative) of a whole number counts as whole, so range(0, 0.9, 0.3)
+ *   stops before 0.9 like range(0, 9, 3) stops before 9.
+ * @param {number} start
+ * @param {number} end exclusive
+ * @param {number} [step=1] non-zero
+ * @returns {number[]}
+ * @throws {TypeError} if start, end or step is not a number
+ * @throws {RangeError} if start, end or step is NaN or infinite, step is 0, or the range would
+ *   have more than 2**32 - 1 items
+ */
+exports.range = (start, end, step = 1) => {
+  for (const [name, value] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof value !== 'number') throw new TypeError(`range: ${name} must be a number`);
+    if (!Number.isFinite(value)) throw new RangeError(`range: ${name} must be finite`);
+  }
+  if (step === 0) throw new RangeError('range: step must not be 0');
+  const quotient = (end - start) / step;
+  if (quotient <= 0) return [];
+  const count = Math.ceil(quotient - 1e-9 * Math.max(1, quotient));
+  if (count > 2 ** 32 - 1) throw new RangeError('range: too many items');
+  const items = [];
+  for (let i = 0; i < count; i++) items.push(start + i * step);
+  return items;
+};
+
+/**
+ * Flattens arbitrarily nested arrays into one array, in depth-first order:
+ * flattenDeep([1, [2, [3, [4]], 5]]) is [1, 2, 3, 4, 5].
+ * - Only real arrays are flattened. Strings, objects, Sets and array-likes are kept as items.
+ * - Empty nested arrays vanish, and holes in sparse arrays are skipped. null and undefined are kept.
+ * - Nesting depth is not limited by the call stack: a million levels deep works.
+ * - The same array may appear several times; an array that contains itself (directly or through
+ *   other arrays) can never be flattened and is rejected.
+ * xs and the arrays inside it are not modified.
+ * @param {unknown[]} xs
+ * @returns {unknown[]} a new array with no array items; [] if xs is empty
+ * @throws {TypeError} if xs is not an array, or contains itself
+ */
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep: xs must be an array');
+  const result = [];
+  const active = new Set([xs]); // the arrays currently being walked, to spot cycles
+  const stack = [{ arr: xs, i: 0 }];
+  while (stack.length > 0) {
+    const top = stack[stack.length - 1];
+    if (top.i >= top.arr.length) {
+      active.delete(top.arr);
+      stack.pop();
+      continue;
+    }
+    const index = top.i++;
+    if (!(index in top.arr)) continue;
+    const item = top.arr[index];
+    if (!Array.isArray(item)) {
+      result.push(item);
+    } else if (active.has(item)) {
+      throw new TypeError('flattenDeep: xs must not contain itself');
+    } else {
+      active.add(item);
+      stack.push({ arr: item, i: 0 });
+    }
+  }
+  return result;
+};
+
+// Sort order of kinds of key; keys of different kinds are never compared with each other.
+const keyRank = (key) => {
+  if (typeof key === 'number') return Number.isNaN(key) ? 6 : 0;
+  if (typeof key === 'bigint') return 0;
+  if (typeof key === 'string') return 1;
+  if (typeof key === 'boolean') return 2;
+  if (key instanceof Date) return Number.isNaN(key.getTime()) ? 6 : 3;
+  if (key === null) return 4;
+  return key === undefined ? 6 : 5;
+};
+
+const compareKeys = (a, b) => {
+  const rank = keyRank(a);
+  const other = keyRank(b);
+  if (rank !== other) return rank - other;
+  if (rank === 3) return a.getTime() - b.getTime();
+  if (rank === 0 || rank === 1 || rank === 2) return a < b ? -1 : a > b ? 1 : 0;
+  return 0;
+};
+
+/**
+ * Returns a new array sorted by key, smallest first. The sort is stable: items with equal keys keep
+ * their original order. xs is not modified.
+ * keyFn is called once per item, in order, with (item, index), before any sorting.
+ * Keys are ordered by kind, then within a kind:
+ *   1. numbers and bigints, numerically (-Infinity first, Infinity last; 0 equals -0)
+ *   2. strings, by UTF-16 code unit like the default sort, not by locale (so "B" < "a")
+ *   3. booleans, false before true
+ *   4. valid Dates, by time
+ *   5. null
+ *   6. other objects and symbols, which all count as equal
+ *   7. undefined, NaN and invalid Dates, last
+ * Reverse the result for descending order. To sort by several keys, sort by the least important
+ * key first and the most important last: stability keeps the earlier order among equal keys.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => unknown} keyFn
+ * @returns {T[]} a new array; [] if xs is empty
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('sortBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('sortBy: keyFn must be a function');
+  const entries = [];
+  for (let i = 0; i < xs.length; i++) entries.push({ item: xs[i], key: keyFn(xs[i], i), index: i });
+  entries.sort((a, b) => compareKeys(a.key, b.key) || a.index - b.index);
+  return entries.map((entry) => entry.item);
+};
+
+/**
+ * Picks one random item from an array, each position equally likely: the item at
+ * Math.floor(rng() * xs.length). Returns undefined for an empty array, without calling rng.
+ * Pass your own rng (a function returning a number from 0 up to but not including 1) for
+ * seeded or predictable choices, such as in tests. xs is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {() => number} [rng=Math.random]
+ * @returns {T | undefined}
+ * @throws {TypeError} if xs is not an array or rng is not a function
+ * @throws {RangeError} if rng returns anything but a number from 0 up to but not including 1
+ */
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new TypeError('sample: xs must be an array');
+  if (typeof rng !== 'function') throw new TypeError('sample: rng must be a function');
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new RangeError('sample: rng must return a number from 0 up to but not including 1');
+  return xs[Math.floor(r * xs.length)];
+};
+
+/**
+ * Every run of n consecutive items, each starting one position after the last:
+ * windowed([1, 2, 3, 4], 2) is [[1, 2], [2, 3], [3, 4]]. An array of length L has L - n + 1
+ * windows, so [] comes back when n is larger than the array or the array is empty; a window is
+ * never padded or shortened. Windows are new arrays holding the same items (they do not share
+ * storage with each other or with xs), and xs is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n positive integer
+ * @returns {T[][]}
+ * @throws {TypeError} if xs is not an array
+ * @throws {RangeError} if n is not a positive integer
+ */
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed: xs must be an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('windowed: n must be a positive integer');
+  const windows = [];
+  for (let i = 0; i + n <= xs.length; i++) windows.push(xs.slice(i, i + n));
+  return windows;
+};
