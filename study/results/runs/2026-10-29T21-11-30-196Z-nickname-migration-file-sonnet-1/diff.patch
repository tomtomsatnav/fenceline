+  const start = new Date(Math.floor(date.getTime() / MS_PER_DAY) * MS_PER_DAY - sinceMonday * MS_PER_DAY);
+  if (Number.isNaN(start.getTime())) throw new RangeError('startOfWeek: the start of the week is out of range');
+  return start;
+};
+
+/**
+ * Formats a Date as YYYY-MM-DD, using its UTC year, month and day: formatIsoDate(new Date(Date.UTC(2024, 4, 9)))
+ * is "2024-05-09". The time of day is dropped.
+ * - Month and day always have two digits, and the year at least four ("0099-12-31", "0000-01-01").
+ * - Years beyond 0000 to 9999 use the signed six-digit form that Date.prototype.toISOString uses and
+ *   ISO 8601 allows for expanded years: "+010000-01-01" and "-000001-12-31" (the year before 0000).
+ *   The earliest and latest Dates are "-271821-04-20" and "+275760-09-13".
+ * - The date is the UTC one, so it can differ from the local date at the same moment, and the result
+ *   is the same in every time zone.
+ * - The text sorts in date order when the years have four digits, and new Date(text) reads it back as
+ *   midnight UTC of that day.
+ * - date is not modified.
+ * @param {Date} date a valid Date
+ * @returns {string}
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is an Invalid Date
+ */
+exports.formatIsoDate = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('formatIsoDate: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('formatIsoDate: date must be a valid Date');
+  const iso = date.toISOString(); // "2024-05-09T12:34:56.789Z", or "+275760-09-13T00:00:00.000Z" for expanded years
+  return iso.slice(0, iso.indexOf('T'));
+};
+
+// Four-digit years, or ISO 8601 expanded years (a sign and six digits), then a two-digit month and day.
+const ISO_DATE = /^(\d{4}|[+-]\d{6})-(\d{2})-(\d{2})$/;
+
+/**
+ * Parses a date written as YYYY-MM-DD into a Date at 00:00:00.000 UTC on that day, the inverse of
+ * formatIsoDate: parseIsoDate("2024-05-09") is the same moment as new Date(Date.UTC(2024, 4, 9)).
+ * - The date must exist in the calendar: "2026-02-30", "2023-02-29" (not a leap year), "1900-02-29",
+ *   "2024-04-31" and "2024-13-01" are rejected, not rolled over into the next month as new Date would.
+ *   2024-02-29 and 2000-02-29 are fine.
+ * - Nothing but the date is accepted: no spaces or line breaks around it, no time ("2024-05-09T00:00Z"),
+ *   no one-digit month or day ("2024-5-9"), no other separators or digits that are not 0 to 9.
+ * - Years are four digits (0000 to 9999) or, like formatIsoDate writes them, a sign and six digits
+ *   ("+010000-01-01", "-000001-12-31"). "-000000" is not allowed. Dates beyond the range of Date
+ *   ("+275760-09-14") are rejected.
+ * - The result is UTC midnight whatever the time zone of the computer.
+ * @param {string} s
+ * @returns {Date}
+ * @throws {TypeError} if s is not a string
+ * @throws {RangeError} if s is not a valid date in this form
+ */
+exports.parseIsoDate = (s) => {
+  if (typeof s !== 'string') throw new TypeError('parseIsoDate: s must be a string');
+  const match = ISO_DATE.exec(s);
+  if (match && match[1] !== '-000000') {
+    const [year, month, day] = [Number(match[1]), Number(match[2]), Number(match[3])];
+    const date = new Date(0); // 00:00:00.000 UTC
+    date.setUTCFullYear(year, month - 1, day); // unlike Date.UTC, a year below 100 stays as written
+    // A day or month that does not exist rolls over into the next one, so reading the fields back detects it.
+    if (date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day) return date;
+  }
+  const shown = s.length > 40 ? `${s.slice(0, 40)}…` : s;
+  throw new RangeError(`parseIsoDate: invalid date ${JSON.stringify(shown)}`);
+};
+
+/**
+ * A person's age in whole years on a given day: the number of birthdays that have been reached by
+ * date, counting in UTC and ignoring the time of day. ageOn(new Date('2000-05-09'), new Date('2024-05-08'))
+ * is 23, and the next day it is 24: the age goes up at 00:00 UTC on the birthday.
+ * - Only the UTC date of each Date matters, so the result is the same in every time zone, and a birth
+ *   at 23:00 and a check at 01:00 on the same day is age 0, not an error.
+ * - Someone born on 29 February has their birthday on 1 March in years that are not leap years (so on
+ *   28 February of such a year they are still the younger age, and on 1 March they have turned).
+ * - The age is 0 on the day of birth and for the following year less one day, and it is never negative:
+ *   a date before the birth date is a mistake and is rejected.
+ * - Neither argument is modified.
+ * @param {Date} birthDate a valid Date
+ * @param {Date} date a valid Date, not on an earlier UTC day than birthDate
+ * @returns {number} a whole number of years, 0 or more
+ * @throws {TypeError} if birthDate or date is not a Date
+ * @throws {RangeError} if birthDate or date is an Invalid Date, or date is on an earlier UTC day than birthDate
+ */
+exports.ageOn = (birthDate, date) => {
+  for (const [name, value] of [['birthDate', birthDate], ['date', date]]) {
+    if (!(value instanceof Date)) throw new TypeError(`ageOn: ${name} must be a Date`);
+  }
+  for (const [name, value] of [['birthDate', birthDate], ['date', date]]) {
+    if (Number.isNaN(value.getTime())) throw new RangeError(`ageOn: ${name} must be a valid Date`);
+  }
+  if (exports.daysBetween(birthDate, date) < 0) throw new RangeError('ageOn: date must not be before birthDate');
+  let years = date.getUTCFullYear() - birthDate.getUTCFullYear();
+  // Not yet had this year's birthday? Comparing (month, day) pairs puts 29 February after 28 February and
+  // before 1 March, which is how a leap-day birthday falls on 1 March in other years.
+  const beforeBirthday = date.getUTCMonth() < birthDate.getUTCMonth()
+    || (date.getUTCMonth() === birthDate.getUTCMonth() && date.getUTCDate() < birthDate.getUTCDate());
+  if (beforeBirthday) years--;
+  return years;
+};
+
+const RELATIVE_UNITS = [ // [name, length in ms], largest first; a month and a year are the average Gregorian ones
+  ['year', 31556952000], // 365.2425 days
+  ['month', 2629746000], // 30.436875 days, so a year is exactly 12 of them
+  ['week', 604800000],
+  ['day', 86400000],
+  ['hour', 3600000],
+  ['minute', 60000],
+  ['second', 1000],
+];
+
+/**
+ * Describes how long ago or how far ahead date is, compared with now, in English:
+ * "3 minutes ago", "in 2 days", "1 hour ago", "in 1 week", "just now".
+ * - The largest unit that fits is used, counting whole units and rounding down: 3 minutes 59 seconds ago
+ *   is "3 minutes ago", and 1 day 23 hours is "1 day". Units are second, minute, hour, day, week
+ *   (7 days), month (30.436875 days, the average) and year (365.2425 days, the average), singular for 1 and plural
+ *   otherwise: "1 day ago", "in 2 days".
+ * - Less than a second away, in either direction, is "just now". Exactly 1 second is "1 second ago" or
+ *   "in 1 second". So the phrase is never "0 seconds ago" or "in 0 days".
+ * - Past dates read "N units ago" and future dates "in N units". The same date and now give "just now".
+ * - Only elapsed time counts, not calendar days or the clock: across a daylight saving change a
+ *   "day" of 23 hours is described as "23 hours ago", and the result does not depend on the time zone.
+ * - now defaults to the current time. Pass it in to get a repeatable result.
+ * - Neither argument is modified.
+ * @param {Date} date a valid Date
+ * @param {Date} [now=new Date()] a valid Date
+ * @returns {string}
+ * @throws {TypeError} if date or now is not a Date
+ * @throws {RangeError} if date or now is an Invalid Date
+ */
+exports.relativeTime = (date, now = new Date()) => {
+  for (const [name, value] of [['date', date], ['now', now]]) {
+    if (!(value instanceof Date)) throw new TypeError(`relativeTime: ${name} must be a Date`);
+  }
+  for (const [name, value] of [['date', date], ['now', now]]) {
+    if (Number.isNaN(value.getTime())) throw new RangeError(`relativeTime: ${name} must be a valid Date`);
+  }
+  const difference = date.getTime() - now.getTime(); // negative for a past date
+  const distance = Math.abs(difference);
+  const unit = RELATIVE_UNITS.find(([, length]) => distance >= length);
+  if (!unit) return 'just now';
+  const [name, length] = unit;
+  const count = Math.floor(distance / length);
+  const phrase = `${count} ${name}${count === 1 ? '' : 's'}`;
+  return difference < 0 ? `${phrase} ago` : `in ${phrase}`;
+};
