+/**
+ * Limits x to the range from lo to hi, both included: clamp(15, 0, 10) is 10, clamp(-3, 0, 10) is 0,
+ * and clamp(4, 0, 10) is 4.
+ * - lo and hi may be -Infinity and Infinity for a range open at one end (or both), and lo may equal
+ *   hi. x may be infinite: clamp(Infinity, 0, 10) is 10.
+ * - A NaN x is returned as NaN, so it passes through a chain of calculations like Math.min and
+ *   Math.max do, rather than turning into a bound.
+ * - A range given the wrong way round (lo greater than hi) is a mistake and is rejected, not swapped.
+ * @param {number} x
+ * @param {number} lo
+ * @param {number} hi
+ * @returns {number}
+ * @throws {TypeError} if x, lo or hi is not a number
+ * @throws {RangeError} if lo or hi is NaN, or lo is greater than hi
+ */
+exports.clamp = (x, lo, hi) => {
+  for (const [name, value] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof value !== 'number') throw new TypeError(`clamp: ${name} must be a number`);
+  }
+  if (Number.isNaN(lo) || Number.isNaN(hi)) throw new RangeError('clamp: lo and hi must not be NaN');
+  if (lo > hi) throw new RangeError('clamp: lo must not be greater than hi');
+  if (x < lo) return lo;
+  if (x > hi) return hi;
+  return x;
+};
+
+// n * 10 ** k, done by moving the exponent in the number's decimal text so no binary rounding creeps in.
+const shift = (n, k) => {
+  const [mantissa, exponent = '0'] = String(n).split('e');
+  return Number(`${mantissa}e${Number(exponent) + k}`);
+};
+
+/**
+ * Rounds x to a number of decimal places, with halves rounded away from zero:
+ * roundTo(2.5, 0) is 3, roundTo(-2.5, 0) is -3, roundTo(1.005, 2) is 1.01.
+ * - The rounding follows the number as it is written (its shortest decimal form), not its binary
+ *   value, so 1.005 rounds up to 1.01 even though the double nearest 1.005 is just below it, and
+ *   0.1 + 0.2 rounds to 0.3.
+ * - places defaults to 0 (a whole number). A negative places rounds to tens, hundreds and so on:
+ *   roundTo(1234, -2) is 1200.
+ * - NaN and the infinities are returned as they are. So is any x that has no digits left to round
+ *   at that many places (for example a huge places), because rounding cannot change it.
+ * - The result is never -0: roundTo(-0.4, 0) is 0.
+ * @param {number} x
+ * @param {number} [places=0] integer
+ * @returns {number}
+ * @throws {TypeError} if x or places is not a number
+ * @throws {RangeError} if places is not an integer
+ */
