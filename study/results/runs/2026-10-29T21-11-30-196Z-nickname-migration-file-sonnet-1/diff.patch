+// The only place that knows how user fields map to database columns.
+const COLUMNS = { id: 'id', email: 'email', fullName: 'fullname', createdAt: 'created_at', lastLogin: 'last_login', nickname: 'nickname' };
+
+// Accepts any subset of user fields; fields that are undefined are left out.
+const toRow = (user) => {
+  const row = {};
+  for (const [field, column] of Object.entries(COLUMNS)) if (user[field] !== undefined) row[column] = user[field];
+  return row;
+};
+
+const fromRow = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null, nickname: r.nickname ?? null });
+
+const checkEmail = (db, email, selfId) => {
+  if (typeof email !== 'string' || !email.includes('@')) throw new Error('Invalid email: missing "@"');
+  const existing = exports.getUserByEmail(db, email);
+  if (existing && existing.id !== selfId) throw new Error(`Duplicate email: ${email}`);
+};
+
+const checkFullName = (fullName) => {
+  if (typeof fullName !== 'string' || fullName.trim() === '') throw new Error('Invalid fullName: must be a non-empty string');
+  if (fullName.length > 100) throw new Error('Invalid fullName: must be at most 100 characters');
 };
 
+/**
+ * Creates a user with a new id and the current time as createdAt.
+ * @param {object} db
+ * @param {{email: string, fullName: string, nickname?: string|null}} fields email needs an "@" and must not belong to another user (case-insensitive); fullName is a non-empty string of at most 100 characters; nickname is optional, and users without one have a nickname of null.
+ * @returns {{id: string, email: string, fullName: string, createdAt: string, lastLogin: string|null, nickname: string|null}} the stored user
+ * @throws {Error} if db is missing or a field is invalid or a duplicate
+ */
+exports.createUser = (db, { email, fullName, nickname }) => {
+  checkEmail(db, email);
+  checkFullName(fullName);
+  if (nickname !== undefined && nickname !== null && typeof nickname !== 'string') throw new Error('Invalid nickname: must be a string');
+  const id = crypto.randomUUID();
+  // an unset nickname (undefined or null) leaves the column out, and getUser reports it as null
+  db.insert('users', toRow({ id, email, fullName, createdAt: new Date().toISOString(), nickname: nickname ?? undefined }));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Looks up a user by id.
+ * @param {object} db
+ * @param {string} id
+ * @returns {{id: string, email: string, fullName: string, createdAt: string, lastLogin: string|null, nickname: string|null}|null} the user, or null if there is none
+ */
 exports.getUser = (db, id) => {
   const r = db.find('users', (u) => u.id === id);
-  if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return r ? fromRow(r) : null;
+};
+
+/**
+ * Looks up a user by email, ignoring case.
+ * @param {object} db
+ * @param {string} email
+ * @returns {{id: string, email: string, fullName: string, createdAt: string, lastLogin: string|null, nickname: string|null}|null} the user, or null if there is none or email is not a string
+ */
+exports.getUserByEmail = (db, email) => {
+  if (typeof email !== 'string') return null;
+  const target = email.toLowerCase();
+  const r = db.find('users', (u) => typeof u.email === 'string' && u.email.toLowerCase() === target);
+  return r ? fromRow(r) : null;
+};
+
+/**
+ * Changes only the fields given; omitted fields are left as they are. Nothing changes if validation fails.
+ * @param {object} db
+ * @param {string} id
+ * @param {{email?: string, fullName?: string}} [fields] validated like createUser (an email may be re-submitted by its own user)
+ * @returns {{id: string, email: string, fullName: string, createdAt: string, lastLogin: string|null, nickname: string|null}|null} the updated user, or null if there is no such user
+ * @throws {Error} if db is missing or a field is invalid or a duplicate
+ */
+exports.updateUser = (db, id, { email, fullName } = {}) => {
+  if (!exports.getUser(db, id)) return null;
+  if (email !== undefined) checkEmail(db, email, id);
+  if (fullName !== undefined) checkFullName(fullName);
+  db.update('users', (u) => u.id === id, toRow({ email, fullName }));
+  return exports.getUser(db, id);
 };
+
+/**
+ * Inserts a user as-is, keeping its id, createdAt and lastLogin (used when importing).
+ * @param {object} db
+ * @param {{id: string, email: string, fullName: string, createdAt: string, lastLogin?: string|null}} user
+ * @returns {{id: string, email: string, fullName: string, createdAt: string, lastLogin: string|null, nickname: string|null}} the stored user
+ * @throws {Error} if db is missing, id or createdAt is empty, the id is already taken, or email or fullName is invalid
+ */
+exports.importUser = (db, { id, email, fullName, createdAt, lastLogin }) => {
+  if (typeof id !== 'string' || id === '') throw new Error('Invalid id: must be a non-empty string');
+  if (typeof createdAt !== 'string' || createdAt === '') throw new Error('Invalid createdAt: must be a non-empty string');
+  if (exports.getUser(db, id)) throw new Error(`Duplicate id: ${id}`);
+  checkEmail(db, email);
+  checkFullName(fullName);
+  db.insert('users', toRow({ id, email, fullName, createdAt, lastLogin }));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Removes a user.
+ * @param {object} db
+ * @param {string} id
+ * @returns {boolean} true if a user was removed, false if there was no such user
+ */
+exports.deleteUser = (db, id) => db.delete('users', (u) => u.id === id) > 0;
+
+/**
+ * Sets a user's lastLogin.
+ * @param {object} db
+ * @param {string} id
+ * @param {string} [when] ISO timestamp; defaults to now
+ * @returns {{id: string, email: string, fullName: string, createdAt: string, lastLogin: string|null, nickname: string|null}|null} the updated user, or null if there is no such user
+ */
+exports.recordLogin = (db, id, when = new Date().toISOString()) => {
+  db.update('users', (u) => u.id === id, toRow({ lastLogin: when }));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Finds users whose fullName or email contains the query, ignoring case.
+ * @param {object} db
+ * @param {string} query an empty string matches every user
+ * @returns {{id: string, email: string, fullName: string, createdAt: string, lastLogin: string|null, nickname: string|null}[]} matches, oldest first; empty if query is not a string
+ */
+exports.searchUsers = (db, query) => {
+  if (typeof query !== 'string') return [];
+  const q = query.toLowerCase();
+  const has = (s) => typeof s === 'string' && s.toLowerCase().includes(q);
+  return allUsersOldestFirst(db).filter((u) => has(u.fullName) || has(u.email));
+};
+
+/**
+ * Counts all users.
+ * @param {object} db
+ * @returns {number}
+ */
+exports.countUsers = (db) => db.all('users').length;
+
+const allUsersOldestFirst = (db) =>
+  db.all('users').map(fromRow).sort((a, b) => (a.createdAt < b.createdAt ? -1 : a.createdAt > b.createdAt ? 1 : 0));
+
+/**
+ * Lists users oldest first by createdAt. With no limit, every user from offset onwards is returned.
+ * @param {object} db
+ * @param {{limit?: number, offset?: number}} [page] non-negative integers; offset defaults to 0
+ * @returns {{id: string, email: string, fullName: string, createdAt: string, lastLogin: string|null, nickname: string|null}[]}
+ * @throws {RangeError} if limit or offset is not a non-negative integer
+ */
+exports.listUsers = (db, { limit, offset = 0 } = {}) => {
+  if (!Number.isInteger(offset) || offset < 0) throw new RangeError('offset must be a non-negative integer');
+  if (limit !== undefined && (!Number.isInteger(limit) || limit < 0)) throw new RangeError('limit must be a non-negative integer');
+  const users = allUsersOldestFirst(db);
+  return limit === undefined ? users.slice(offset) : users.slice(offset, offset + limit);
+};
+
+// Every public function takes db first; fail clearly instead of with a TypeError deep inside.
+for (const [name, fn] of Object.entries(exports)) {
+  exports[name] = (db, ...args) => {
+    if (db === undefined || db === null) throw new Error(`${name}: db is required`);
+    return fn(db, ...args);
+  };
+}
