+/**
+ * Returns a new Date n calendar days after date (before it when n is negative), in local time:
+ * the time of day stays the same, so addDays(new Date(2024, 0, 31, 9, 30), 1) is 1 February 2024 at
+ * 9:30. Months and years roll over as expected, and leap days are counted.
+ * - Days are calendar days, not blocks of 24 hours: across a daylight saving change the elapsed time
+ *   is 23 or 25 hours but the clock reads the same. When that time of day does not exist on the new
+ *   day (it falls in the hour skipped by "spring forward"), the usual Date rule applies and the time
+ *   moves forward by the length of the gap.
+ * - n = 0 gives an equal Date that is a new object. date is never modified.
+ * - n must be a whole number: 1.5 days is not rounded or converted into hours.
+ * - The result must be a valid Date, which runs out 8.64e15 ms (about 273,790 years) from 1970.
+ * @param {Date} date a valid Date
+ * @param {number} n whole number of days, positive, negative or zero
+ * @returns {Date}
+ * @throws {TypeError} if date is not a Date or n is not a number
+ * @throws {RangeError} if date is an Invalid Date, n is not a whole number, or the result is out of range
+ */
+exports.addDays = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError('addDays: date must be a Date');
+  if (typeof n !== 'number') throw new TypeError('addDays: n must be a number');
+  if (Number.isNaN(date.getTime())) throw new RangeError('addDays: date must be a valid Date');
+  if (!Number.isInteger(n)) throw new RangeError('addDays: n must be a whole number');
+  const result = new Date(date.getTime());
+  result.setDate(result.getDate() + n);
+  if (Number.isNaN(result.getTime())) throw new RangeError('addDays: the resulting date is out of range');
+  return result;
+};
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+/**
+ * The number of whole calendar days from a to b, counted in UTC and ignoring the time of day:
+ * 1 January to 3 January is 2 whatever the hours are. The result is signed, positive when b is on a
+ * later UTC day than a, negative when earlier and 0 when both are on the same UTC day (use
+ * Math.abs for a distance).
+ * - Only the UTC date counts, not how long apart the two moments are: 23:59:59.999 on one day and
+ *   00:00:00.000 on the next are 1 day apart, and 00:00 and 23:59 on the same day are 0 days apart.
+ * - UTC has no daylight saving, so every day counts as 24 hours and the result does not depend on the
+ *   time zone of the computer. A Date's local date can differ from its UTC date.
+ * - The result is exact for the whole range of Date, including dates before 1970 and years below 100.
+ * - Neither date is modified.
+ * @param {Date} a a valid Date
+ * @param {Date} b a valid Date
+ * @returns {number} a whole number of days
+ * @throws {TypeError} if a or b is not a Date
+ * @throws {RangeError} if a or b is an Invalid Date
+ */
+exports.daysBetween = (a, b) => {
+  for (const [name, value] of [['a', a], ['b', b]]) {
+    if (!(value instanceof Date)) throw new TypeError(`daysBetween: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`daysBetween: ${name} must be a valid Date`);
+  }
+  // Floor, not truncate, so moments before 1970 land on the right UTC day.
+  return Math.floor(b.getTime() / MS_PER_DAY) - Math.floor(a.getTime() / MS_PER_DAY);
+};
+
+/**
+ * True when date falls on a Saturday or a Sunday in UTC: the day is read from the UTC date, so the
+ * answer is the same in every time zone. The local day of the same moment can differ (Friday evening
+ * in New York is already Saturday in UTC, and Saturday morning in Auckland is still Friday in UTC),
+ * so convert first if you need the weekend of a particular place.
+ * - The weekend starts at 00:00:00.000 UTC on Saturday and ends after 23:59:59.999 UTC on Sunday.
+ * - Public holidays are not considered, and neither are weekends that fall on other days elsewhere.
+ * - date is not modified.
+ * @param {Date} date a valid Date
+ * @returns {boolean}
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is an Invalid Date
+ */
+exports.isWeekend = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('isWeekend: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('isWeekend: date must be a valid Date');
+  const day = date.getUTCDay(); // 0 is Sunday, 6 is Saturday
+  return day === 0 || day === 6;
+};
+
+/**
+ * The start of the week containing date, taking weeks to run from Monday to Sunday: a new Date at
+ * 00:00:00.000 UTC on that week's Monday. startOfWeek of any moment from Monday 00:00 UTC to Sunday
+ * 23:59:59.999 UTC is that Monday 00:00 UTC, and of a Monday 00:00 UTC is the same instant.
+ * - The week is worked out from the UTC date, so the result is the same in every time zone. The local
+ *   date of the same moment can be a different day, and a different week.
+ * - The result is never after date, and less than 7 days before it. It is exact for dates before 1970
+ *   and for the whole range of Date, except where the Monday would fall before the earliest Date:
+ *   that is a RangeError.
+ * - date is not modified.
+ * @param {Date} date a valid Date
+ * @returns {Date}
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is an Invalid Date, or the Monday of its week is before the earliest Date
+ */
+exports.startOfWeek = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('startOfWeek: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('startOfWeek: date must be a valid Date');
