+// defineProperty, not assignment, so a "__proto__" key makes a property instead of setting the prototype
+const setOwn = (target, key, value) => Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+
+/**
+ * Returns a new object with only the listed keys of obj: pick({ a: 1, b: 2, c: 3 }, ['a', 'c']) is { a: 1, c: 3 }.
+ * - Only own enumerable properties are picked. A key that obj does not have, or only inherits
+ *   (such as "toString"), or has as a hidden property, is left out; it is not added as undefined.
+ *   A property that is there with the value undefined is picked.
+ * - The keys appear in the result in the order of the keys array, and a key listed twice appears once.
+ * - Keys may be strings, symbols or numbers (a number is the same key as its text, so 1 is "1").
+ * - The values are copied as they are, not cloned: picked objects are the same objects as in obj. A getter
+ *   is read once and its value becomes an ordinary property of the result.
+ * - The result is a plain object, even when obj is a class instance or an array, and a key such as
+ *   "__proto__" (possible in obj made by JSON.parse) is picked as an ordinary property.
+ * - obj is not modified.
+ * @param {object} obj
+ * @param {Array<string | symbol | number>} keys
+ * @returns {object}
+ * @throws {TypeError} if obj is not an object, keys is not an array, or a key is not a string, symbol or number
+ */
+exports.pick = (obj, keys) => {
+  checkObjectAndKeys('pick', obj, keys);
+  const result = {};
+  for (const key of keys) {
+    if (!Object.prototype.propertyIsEnumerable.call(obj, key) || Object.prototype.hasOwnProperty.call(result, key)) continue;
+    setOwn(result, key, obj[key]);
+  }
+  return result;
+};
