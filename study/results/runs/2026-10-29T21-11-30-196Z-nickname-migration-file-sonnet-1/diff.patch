+    assert.match(text, /^[1-9]\d* (second|minute|hour|day|week|month|year)s? ago$/, text);
+    const [, count, unit] = /^(\d+) (\w+?)s? ago$/.exec(text);
+    const unitRank = rank.indexOf(unit);
