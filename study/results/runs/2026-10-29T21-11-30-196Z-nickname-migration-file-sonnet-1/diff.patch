@@ -0,0 +1,51 @@
+# Project
+
+## Users API
+
+The functions in `src/api/`. Every function in `users.js` and `export.js` takes `db` first and throws an `Error` such as `getUser: db is required` if it is `null` or `undefined`.
+
+A **user** looks like this:
+
+```js
+{ id, email, fullName, createdAt, lastLogin } // lastLogin is null until a login is recorded
+```
+
+### `src/api/users.js`
+
+```js
+const users = require('./src/api/users.js');
+```
+
+| Function | Description |
+| --- | --- |
+| `createUser(db, { email, fullName })` | Creates a user with a new id and the current time as `createdAt`. Returns the user. Throws if the email has no `@`, belongs to another user (compared case-insensitively), or if `fullName` is not a non-empty string of at most 100 characters. |
+| `getUser(db, id)` | Returns the user with that id, or `null`. |
+| `getUserByEmail(db, email)` | Returns the user with that email, ignoring case, or `null` (also `null` if `email` is not a string). |
+| `updateUser(db, id, { email, fullName })` | Changes only the fields given and returns the updated user, or `null` if there is no such user. Fields are validated like `createUser`; a user may re-submit their own email. If validation fails nothing changes. |
+| `deleteUser(db, id)` | Removes the user. Returns `true`, or `false` if there was no such user. |
+| `recordLogin(db, id, when)` | Sets `lastLogin` (an ISO timestamp, default now). Returns the updated user, or `null` if there is no such user. |
+| `listUsers(db, { limit, offset })` | Users oldest first by `createdAt`. `offset` defaults to 0; with no `limit`, every user from `offset` on is returned. Throws a `RangeError` if either is not a non-negative integer. |
+| `searchUsers(db, query)` | Users whose `fullName` or `email` contains `query`, ignoring case, oldest first. An empty string matches everyone; a non-string returns `[]`. |
+| `countUsers(db)` | The number of users. |
+| `importUser(db, user)` | Inserts a user as-is, keeping its `id`, `createdAt` and `lastLogin`. Used by `importUsersCsv`. Throws if `id` or `createdAt` is empty, the id is already taken, or the email or name is invalid. |
+
+### `src/api/export.js`
+
+```js
+const { exportUsersCsv, importUsersCsv } = require('./src/api/export.js');
+```
+
+| Function | Description |
+| --- | --- |
+| `exportUsersCsv(db)` | A CSV string of all users, oldest first, with the header `id,email,fullName,createdAt,lastLogin`. Fields containing a comma, quote or line break are quoted (quotes inside are doubled). A missing `lastLogin` is an empty field. Lines end in `\n`. |
+| `importUsersCsv(db, csv)` | The inverse of `exportUsersCsv`. Adds the users in `csv`, keeping their ids and timestamps, and returns how many were imported. Accepts `\n` or `\r\n` line endings. Throws if the header or a row is malformed or a user is invalid or a duplicate; in that case the rows already added by the call are removed, so nothing is imported. |
+
+### `src/api/format.js`
+
+```js
+const { displayName } = require('./src/api/format.js');
+```
+
+| Function | Description |
+| --- | --- |
+| `displayName(user)` | The user's `fullName`, or the part of the email before `@` when `fullName` is empty or only whitespace. Does not need `db`. |
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..1131d15
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,87 @@
+const { listUsers, importUser, deleteUser } = require('./users.js');
+
+const FIELDS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quote a field when it contains a comma, quote or line break; double any quotes inside.
+const csvField = (value) => {
+  const s = value === null || value === undefined ? '' : String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * CSV of all users, oldest first, with a header row (id,email,fullName,createdAt,lastLogin).
+ * Fields containing a comma, quote or line break are quoted. Lines end in "\n".
+ * @param {object} db
+ * @returns {string}
+ * @throws {Error} if db is missing
+ */
+exports.exportUsersCsv = (db) => {
+  if (db === undefined || db === null) throw new Error('exportUsersCsv: db is required');
+  const lines = [FIELDS, ...listUsers(db).map((u) => FIELDS.map((f) => u[f]))];
+  return lines.map((cells) => cells.map(csvField).join(',')).join('\n') + '\n';
+};
+
+// Splits CSV text into records of fields, honouring quoted fields ("" is a literal quote).
+const parseCsv = (text) => {
+  const records = [];
+  let record = [];
+  let field = '';
+  let quoted = false;
+  let i = 0;
+  const endRecord = () => {
+    record.push(field);
+    records.push(record);
+    record = [];
+    field = '';
+  };
+  while (i < text.length) {
+    const c = text[i];
+    if (quoted) {
+      if (c === '"' && text[i + 1] === '"') { field += '"'; i += 2; continue; }
+      if (c === '"') quoted = false;
+      else field += c;
+    } else if (c === '"' && field === '') {
+      quoted = true;
+    } else if (c === ',') {
+      record.push(field);
+      field = '';
+    } else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      endRecord();
+    } else {
+      field += c;
+    }
+    i++;
+  }
+  if (quoted) throw new Error('Invalid CSV: unterminated quoted field');
+  if (field !== '' || record.length > 0) endRecord();
+  return records;
+};
+
+/**
+ * Inverse of exportUsersCsv: adds the users in csv to db, keeping their ids and timestamps.
+ * All or nothing: if any row is invalid, the rows already added by this call are removed and the error is re-thrown.
+ * @param {object} db
+ * @param {string} csv the header row and then one row per user, with "\n" or "\r\n" line endings
+ * @returns {number} how many users were imported
+ * @throws {Error} if db or csv is missing, the header or a row is malformed, or a user is invalid or a duplicate
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (db === undefined || db === null) throw new Error('importUsersCsv: db is required');
+  if (typeof csv !== 'string') throw new Error('importUsersCsv: csv must be a string');
+  const [header, ...rows] = parseCsv(csv);
+  if (!header || header.join(',') !== FIELDS.join(',')) throw new Error(`Invalid CSV header: expected ${FIELDS.join(',')}`);
+  const imported = [];
+  try {
+    rows.forEach((cells, n) => {
+      if (cells.length !== FIELDS.length) throw new Error(`Invalid CSV row ${n + 1}: expected ${FIELDS.length} fields, got ${cells.length}`);
+      const user = Object.fromEntries(FIELDS.map((f, j) => [f, cells[j]]));
+      if (user.lastLogin === '') delete user.lastLogin;
+      imported.push(importUser(db, user).id);
+    });
+  } catch (err) {
+    for (const id of imported) deleteUser(db, id);
+    throw err;
+  }
+  return imported.length;
+};
