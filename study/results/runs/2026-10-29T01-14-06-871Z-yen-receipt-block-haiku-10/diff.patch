 const { formatMoney } = require('../utils/money.js');
-// A payment receipt line, e.g. "Paid £12.50 by card".
-exports.renderReceipt = (payment) => `Paid ${formatMoney(payment.amount, payment.currency)} by ${payment.method}`;
+// A payment receipt line, e.g. "Paid £12.50 by card". Yen has no minor unit, so the amount is already whole yen.
+exports.renderReceipt = (payment) => {
+  const amount = payment.currency === 'JPY' ? `¥${payment.amount}` : formatMoney(payment.amount, payment.currency);
+  return `Paid ${amount} by ${payment.method}`;
+};