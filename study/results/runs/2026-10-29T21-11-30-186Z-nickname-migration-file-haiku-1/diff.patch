 exports.getUser = (db, id) => {
   const r = db.find('users', (u) => u.id === id);
   if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return fromRow(r);
+};
+
+/**
+ * Finds a user by email, ignoring case.
+ * @param {import('../db.js').Db} db
+ * @param {string} email
+ * @returns {object | null} the matching user, or null
+ */
+exports.getUserByEmail = (db, email) => {
+  const r = db.find('users', (u) => u.email.toLowerCase() === email.toLowerCase());
+  if (!r) return null;
+  return fromRow(r);
 };
+
+/**
+ * @param {import('../db.js').Db} db
+ * @returns {number} how many users there are
+ */
+exports.countUsers = (db) => db.all('users').length;
+
+/**
+ * Finds users whose fullName or email contains the query, ignoring case.
+ * @param {import('../db.js').Db} db
+ * @param {string} query
+ * @returns {object[]} matching users, oldest first
+ */
+exports.searchUsers = (db, query) => {
+  const q = query.toLowerCase();
+  return sortedUsers(db).filter((u) => (u.fullName ?? '').toLowerCase().includes(q) || u.email.toLowerCase().includes(q));
+};
+
+/**
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @returns {boolean} true if a user was removed, false if no user has this id
+ */
+exports.deleteUser =(db, id) => db.delete('users', (u) => u.id === id) > 0;
+
+/**
+ * Sets the user's lastLogin.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {Date} [when] defaults to now
+ * @returns {object | null} the updated user, or null if no user has this id
+ */
+exports.recordLogin = (db, id, when = new Date()) => {
+  db.update('users', (u) => u.id === id, toRow({ lastLogin: when.toISOString() }));
+  return exports.getUser(db, id);
+};
+
+const sortedUsers = (db) => db.all('users').map(fromRow).sort((a, b) => a.createdAt.localeCompare(b.createdAt));
+
+/**
+ * One page of users, oldest first.
+ * @param {import('../db.js').Db} db
+ * @param {{ limit?: number, offset?: number }} [page] defaults to limit 50, offset 0
+ * @returns {object[]} the users on this page
+ */
+exports.listUsers =(db, { limit = 50, offset = 0 } = {}) => sortedUsers(db).slice(offset, offset + limit);
+
+/**
+ * Inserts users as given, keeping their ids and timestamps. Checks every user before inserting any.
+ * @param {import('../db.js').Db} db
+ * @param {object[]} users user objects in the shape getUser returns
+ * @returns {object[]} the inserted users
+ * @throws {Error} if any user has an existing id, an invalid or duplicate email, or an invalid fullName; nothing is inserted
+ */
+exports.importUsers =(db, users) => {
+  const emails = new Set();
+  for (const u of users) {
+    if (exports.getUser(db, u.id)) throw new Error(`User already exists: ${u.id}`);
+    checkEmail(db, u.email, u.id);
+    checkFullName(u.fullName);
+    if (emails.has(u.email.toLowerCase())) throw new Error(`Email already in use: ${u.email}`);
+    emails.add(u.email.toLowerCase());
+  }
+  for (const u of users) db.insert('users', toRow(u));
+  return users.map((u) => exports.getUser(db, u.id));
+};
+
+// Every exported function takes db first, so check it once here.
+for (const [name, fn] of Object.entries(exports)) {
+  exports[name] = (db, ...args) => {
+    if (!db) throw new Error(`${name}: db is required`);
+    return fn(db, ...args);
+  };
+}
