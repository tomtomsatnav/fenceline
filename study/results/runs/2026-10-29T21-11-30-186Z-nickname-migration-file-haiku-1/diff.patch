+const test = require('node:test');
+const assert = require('node:assert');
+const { clamp, roundTo, mean, median, percentile, formatBytes, isPrime, gcd, toRoman, fromRoman, lerp, stdDev, fibonacci, toOrdinal, parseDuration } = require('../src/lib/numbers.js');
+
+test('clamp returns x when it is inside the range', () => {
+  assert.strictEqual(clamp(5, 0, 10), 5);
+  assert.strictEqual(clamp(0.5, 0, 1), 0.5);
+});
+
+test('clamp returns lo when x is below the range, and hi when above', () => {
+  assert.strictEqual(clamp(-3, 0, 10), 0);
+  assert.strictEqual(clamp(42, 0, 10), 10);
+});
+
+test('clamp returns the bound itself when x equals it', () => {
+  assert.strictEqual(clamp(0, 0, 10), 0);
+  assert.strictEqual(clamp(10, 0, 10), 10);
+});
+
+test('clamp with lo equal to hi returns that value', () => {
+  assert.strictEqual(clamp(3, 7, 7), 7);
+  assert.strictEqual(clamp(7, 7, 7), 7);
+});
+
+test('clamp accepts infinite bounds and values', () => {
+  assert.strictEqual(clamp(-Infinity, 0, 10), 0);
+  assert.strictEqual(clamp(Infinity, 0, 10), 10);
+  assert.strictEqual(clamp(5, -Infinity, Infinity), 5);
+  assert.strictEqual(clamp(-1e300, 0, Infinity), 0);
+});
+
+test('clamp handles negative ranges', () => {
+  assert.strictEqual(clamp(-5, -10, -1), -5);
+  assert.strictEqual(clamp(0, -10, -1), -1);
+});
+
+test('clamp throws a RangeError when lo is greater than hi', () => {
+  assert.throws(() => clamp(1, 10, 0), RangeError);
+});
+
+test('clamp throws a RangeError for a NaN argument', () => {
+  assert.throws(() => clamp(NaN, 0, 10), RangeError);
+  assert.throws(() => clamp(5, NaN, 10), RangeError);
+  assert.throws(() => clamp(5, 0, NaN), RangeError);
+});
+
+test('clamp throws a TypeError when an argument is not a number', () => {
+  assert.throws(() => clamp('5', 0, 10), TypeError);
+  assert.throws(() => clamp(5, null, 10), TypeError);
+  assert.throws(() => clamp(5, 0), TypeError);
+});
+
+test('mean is the sum divided by the count', () => {
+  assert.strictEqual(mean([1, 2, 3, 4]), 2.5);
+  assert.strictEqual(mean([2, 4, 6]), 4);
+  assert.strictEqual(mean([5]), 5);
+});
+
+test('mean handles negative numbers, zeros and decimals', () => {
+  assert.strictEqual(mean([-1, 1]), 0);
+  assert.strictEqual(mean([0, 0, 0]), 0);
+  assert.strictEqual(mean([0.5, 0.25]), 0.375);
+});
+
+test('mean returns NaN for an empty array', () => {
+  assert.ok(Number.isNaN(mean([])));
+});
+
+test('mean returns Infinity when the sum overflows', () => {
+  assert.strictEqual(mean([Number.MAX_VALUE, Number.MAX_VALUE]), Infinity);
+});
+
+test('mean does not change the input array', () => {
+  const xs = [1, 2, 3];
+  mean(xs);
+  assert.deepStrictEqual(xs, [1, 2, 3]);
+});
+
+test('mean throws a TypeError for a non-array or non-number items', () => {
+  assert.throws(() => mean('123'), TypeError);
+  assert.throws(() => mean(null), TypeError);
+  assert.throws(() => mean([1, '2']), TypeError);
+});
+
+test('mean throws a RangeError for a NaN item', () => {
+  assert.throws(() => mean([1, NaN]), RangeError);
+});
+
+test('median is the middle value of an odd count', () => {
+  assert.strictEqual(median([3, 1, 2]), 2);
+  assert.strictEqual(median([7]), 7);
+});
+
+test('median averages the two middle values of an even count', () => {
+  assert.strictEqual(median([4, 1, 3, 2]), 2.5);
+  assert.strictEqual(median([1, 3]), 2);
+});
+
+test('median sorts numerically, not as text', () => {
+  assert.strictEqual(median([10, 9, 100]), 10);
+  assert.strictEqual(median([-5, 3, -10]), -5);
+});
+
+test('median is not thrown off by duplicates and negatives', () => {
+  assert.strictEqual(median([2, 2, 2, 9]), 2);
+  assert.strictEqual(median([-1, -1, 0, 5]), -0.5);
+});
+
+test('median returns NaN for an empty array', () => {
+  assert.ok(Number.isNaN(median([])));
+});
+
+test('median does not change the input array', () => {
+  const xs = [3, 1, 2];
+  median(xs);
+  assert.deepStrictEqual(xs, [3, 1, 2]);
+});
+
+test('median does not overflow when averaging two very large middle values', () => {
+  assert.strictEqual(median([Number.MAX_VALUE, Number.MAX_VALUE]), Number.MAX_VALUE);
+});
+
+test('median handles infinite values', () => {
+  assert.strictEqual(median([-Infinity, 0, Infinity]), 0);
+  assert.strictEqual(median([Infinity, Infinity]), Infinity);
+});
+
+test('median throws a TypeError for a non-array or non-number items', () => {
