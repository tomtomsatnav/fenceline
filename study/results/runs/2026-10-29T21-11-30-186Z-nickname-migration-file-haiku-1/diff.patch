+};
+
+/**
+ * The item whose key is largest, where keyFn gives each item's key. Keys must all be strings, or all be numbers that
+ * are not NaN, as in sortBy. If several items share the largest key, the first of them is returned. The input is not
+ * changed.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => string | number} keyFn
+ * @returns {T | undefined} the item with the largest key, or undefined for an empty array
+ * @throws {TypeError} if xs is not an array, keyFn is not a function, or the keys are not all strings or all numbers
+ * @throws {RangeError} if a key is NaN
+ */
+exports.maxBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError(`maxBy expects an array, got ${typeof xs}`);
+  if (typeof keyFn !== 'function') throw new TypeError(`maxBy expects a key function, got ${typeof keyFn}`);
