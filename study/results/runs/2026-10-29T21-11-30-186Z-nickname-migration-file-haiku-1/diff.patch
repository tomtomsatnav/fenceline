+++ b/src/lib/numbers.js
@@ -0,0 +1,334 @@
+/**
+ * Limits x to the range from lo to hi, both included. Infinite bounds are allowed.
+ * @param {number} x
+ * @param {number} lo
+ * @param {number} hi
+ * @returns {number} lo if x is below it, hi if x is above it, otherwise x
+ * @throws {TypeError} if x, lo or hi is not a number
+ * @throws {RangeError} if x, lo or hi is NaN, or lo is greater than hi
+ */
+exports.clamp = (x, lo, hi) => {
+  for (const [name, value] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof value !== 'number') throw new TypeError(`clamp expects a number for ${name}, got ${typeof value}`);
+    if (Number.isNaN(value)) throw new RangeError(`clamp expects ${name} to be a number, not NaN`);
+  }
+  if (lo > hi) throw new RangeError(`clamp expects lo to be at most hi, got lo=${lo} and hi=${hi}`);
+  return Math.min(hi, Math.max(lo, x));
+};
+
+// Throws unless xs is an array of numbers, none of them NaN.
+const checkNumbers = (name, xs) => {
+  if (!Array.isArray(xs)) throw new TypeError(`${name} expects an array, got ${typeof xs}`);
+  for (const x of xs) {
+    if (typeof x !== 'number') throw new TypeError(`${name} expects numbers, got ${typeof x}`);
+    if (Number.isNaN(x)) throw new RangeError(`${name} expects numbers, not NaN`);
+  }
+};
+
+/**
+ * The arithmetic mean of the numbers in xs.
+ * @param {number[]} xs
+ * @returns {number} the sum divided by the count, or NaN for an empty array
+ * @throws {TypeError} if xs is not an array, or an item is not a number
+ * @throws {RangeError} if an item is NaN
+ */
+exports.mean = (xs) => {
+  checkNumbers('mean', xs);
+  if (xs.length === 0) return NaN;
+  return xs.reduce((sum, x) => sum + x, 0) / xs.length;
+};
+
+/**
+ * The median of the numbers in xs: the middle one, or the average of the two middle ones when the count is even.
+ * The input is not changed.
+ * @param {number[]} xs
+ * @returns {number} the median, or NaN for an empty array
+ * @throws {TypeError} if xs is not an array, or an item is not a number
+ * @throws {RangeError} if an item is NaN
+ */
+exports.median = (xs) => {
+  checkNumbers('median', xs);
+  if (xs.length === 0) return NaN;
+  const sorted = xs.slice().sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+  const mid = Math.floor(sorted.length / 2);
+  if (sorted.length % 2 === 1) return sorted[mid];
+  // Halving each value before adding keeps two large middle values from overflowing.
+  return sorted[mid - 1] / 2 + sorted[mid] / 2;
+};
+
+/**
+ * The value at percentile p of the numbers in xs, found by linear interpolation between the two nearest sorted
+ * values (the same method as numpy's default). percentile(xs, 0) is the smallest value and percentile(xs, 100) the
+ * largest. The input is not changed.
+ * @param {number[]} xs
+ * @param {number} p between 0 and 100 inclusive
+ * @returns {number} the interpolated value, or NaN for an empty array or when the result would lie between -Infinity and Infinity
+ * @throws {TypeError} if xs is not an array, an item is not a number, or p is not a number
+ * @throws {RangeError} if an item is NaN, or p is NaN or outside 0 to 100
+ */
+exports.percentile = (xs, p) => {
+  checkNumbers('percentile', xs);
+  if (typeof p !== 'number') throw new TypeError(`percentile expects a number for p, got ${typeof p}`);
+  if (!(p >= 0 && p <= 100)) throw new RangeError(`percentile expects p between 0 and 100, got ${p}`);
+  if (xs.length === 0) return NaN;
