+test('splits an array into chunks of length n', () => {
+  assert.deepStrictEqual(chunk([1, 2, 3, 4], 2), [[1, 2], [3, 4]]);
+  assert.deepStrictEqual(chunk(['a', 'b', 'c'], 1), [['a'], ['b'], ['c']]);
+});
