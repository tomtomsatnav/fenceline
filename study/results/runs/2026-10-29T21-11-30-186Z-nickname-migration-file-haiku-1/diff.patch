+  if (typeof text !== 'string') throw new TypeError(`parseIsoDate expects a string, got ${typeof text}`);
+  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(text);
+  if (!match) throw new RangeError(`parseIsoDate expects YYYY-MM-DD, got "${text}"`);
