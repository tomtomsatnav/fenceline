+/**
+ * Converts text to camelCase. Words are the runs of letters and digits, so spaces, hyphens, underscores
+ * and other punctuation all act as separators. Case inside each word is not kept: "HTTP" becomes "http".
+ * @param {string} text
+ * @returns {string} for example "helloWorld" from "hello world", "hello-world" or "hello_world"
+ * @throws {TypeError} if text is not a string
+ */
+exports.camelCase = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`camelCase expects a string, got ${typeof text}`);
+  const words = text.match(/[\p{L}\p{N}]+/gu) ?? [];
+  return words
+    .map((word, i) => {
+      const lower = word.toLowerCase();
+      return i === 0 ? lower : lower.replace(/^./su, (c) => c.toUpperCase());
+    })
+    .join('');
+};
+
+/**
+ * Converts text to kebab-case. Words are split at spaces, hyphens, underscores and other punctuation, and
+ * also where a capital letter starts a new word, so "helloWorld" and "HTTPServer" split too.
+ * @param {string} text
+ * @returns {string} for example "hello-world" from "helloWorld", "Hello World" or "hello_world"
+ * @throws {TypeError} if text is not a string
+ */
+exports.kebabCase = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`kebabCase expects a string, got ${typeof text}`);
+  const words = text.match(/\p{Lu}+(?=\p{Lu}\p{Ll})|\p{Lu}?\p{Ll}+|\p{Lu}+|\p{Lo}+|\p{N}+/gu) ?? [];
+  return words.map((word) => word.toLowerCase()).join('-');
+};
+
+/**
+ * A URL-friendly slug made only of lower-case ASCII letters, digits and single dashes. Accents are removed first, so
+ * "Crème Brûlée" gives "creme-brulee". Characters with no ASCII letter form, such as the German ß or CJK text, become
+ * dashes and are dropped at the ends. Leading and trailing dashes are trimmed.
+ * @param {string} text
+ * @returns {string} for example "hello-world" from "  Hello, World!  ", or "" when there is nothing to keep
+ * @throws {TypeError} if text is not a string
+ */
+exports.slugifyAscii = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`slugifyAscii expects a string, got ${typeof text}`);
+  return text
+    .toLowerCase()
+    .normalize('NFKD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+};
+
+const HTML_ESCAPES = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
+
+/**
+ * Escapes the five characters that have a special meaning in HTML: & < > " and '. The result is safe to put in
+ * element text or in a quoted attribute. Each character is escaped once, so "&amp;" becomes "&amp;amp;", which is
+ * right for text that is not already HTML. Other characters, including non-ASCII, are left alone.
+ * @param {string} text
+ * @returns {string}
+ * @throws {TypeError} if text is not a string
+ */
+exports.escapeHtml = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`escapeHtml expects a string, got ${typeof text}`);
+  // One pass over the text, so the & in an escape like &lt; is never escaped a second time.
+  return text.replace(/[&<>"']/g, (ch) => HTML_ESCAPES[ch]);
+};
+
+// Comments, then script and style blocks with their contents, then tags. A tag is "<" followed by a letter, or "</",
+// and a quoted attribute value may contain ">".
+const HTML_COMMENT = /<!--[\s\S]*?-->/g;
+const HTML_SCRIPT_OR_STYLE = /<(script|style)\b(?:"[^"]*"|'[^']*'|[^'">])*>[\s\S]*?<\/\1\s*>/gi;
+const HTML_TAG = /<\/?[A-Za-z](?:"[^"]*"|'[^']*'|[^'">])*>|<![^>]*>|<\?[^>]*>/g;
+
+/**
+ * Removes HTML tags and keeps the text between them. Comments, doctype declarations and the contents of script and
+ * style elements are removed too, since that text is not page text. Entities such as &amp; are left as they are, and
+ * a "<" that does not start a tag, as in "a < b", is kept. This is for cleaning up text, not for making untrusted
+ * HTML safe. For that, escape the output with escapeHtml instead.
+ * @param {string} text
+ * @returns {string} for example "Hello world" from "<p>Hello <b>world</b></p>"
+ * @throws {TypeError} if text is not a string
+ */
