+  assert.throws(() => median([1, '2']), TypeError);
+});
+
+test('median throws a RangeError for a NaN item', () => {
+  assert.throws(() => median([1, NaN]), RangeError);
+});
+
+test('percentile 0 and 100 are the smallest and largest values', () => {
+  assert.strictEqual(percentile([3, 1, 4, 1, 5], 0), 1);
+  assert.strictEqual(percentile([3, 1, 4, 1, 5], 100), 5);
+});
+
+test('percentile 50 matches the median', () => {
+  assert.strictEqual(percentile([3, 1, 2], 50), 2);
+  assert.strictEqual(percentile([4, 1, 3, 2], 50), 2.5);
+});
+
+test('percentile interpolates linearly between the two nearest values', () => {
+  assert.strictEqual(percentile([0, 10], 25), 2.5);
+  assert.strictEqual(percentile([0, 10], 75), 7.5);
+  assert.strictEqual(percentile([1, 2, 3, 4, 5], 25), 2);
+  assert.ok(Math.abs(percentile([1, 2, 3, 4, 5], 10) - 1.4) < 1e-12);
+});
+
+test('percentile of a single value is that value at every p', () => {
+  assert.strictEqual(percentile([7], 0), 7);
+  assert.strictEqual(percentile([7], 33), 7);
+  assert.strictEqual(percentile([7], 100), 7);
+});
+
+test('percentile sorts numerically and does not change the input', () => {
+  const xs = [10, 9, 100];
+  assert.strictEqual(percentile(xs, 50), 10);
+  assert.deepStrictEqual(xs, [10, 9, 100]);
