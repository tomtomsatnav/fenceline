+  assert.strictEqual(stripTags('<p>Hi</p><script>alert(1)</script>'), 'Hi');
+  assert.strictEqual(stripTags('<style>p { color: red }</style>x'), 'x');
+});
+
+test('stripTags removes a tag that is not closed', () => {
+  assert.strictEqual(stripTags('<b>bold'), 'bold');
+});
+
+test('stripTags keeps a "<" that does not start a tag', () => {
+  assert.strictEqual(stripTags('a < b'), 'a < b');
+  assert.strictEqual(stripTags('a<2 and 3>1'), 'a<2 and 3>1');
+});
+
+test('stripTags leaves entities as they are', () => {
+  assert.strictEqual(stripTags('&lt;b&gt; &amp;'), '&lt;b&gt; &amp;');
+});
+
+test('stripTags returns text with no tags unchanged, and an empty string for empty input', () => {
+  assert.strictEqual(stripTags('plain text'), 'plain text');
+  assert.strictEqual(stripTags('Crème 日本語'), 'Crème 日本語');
+  assert.strictEqual(stripTags(''), '');
+});
+
+test('stripTags throws a TypeError for a non-string', () => {
+  assert.throws(() => stripTags(null), TypeError);
+  assert.throws(() => stripTags(42), TypeError);
+});
+
+test('levenshtein gives the known distances for classic examples', () => {
+  assert.strictEqual(levenshtein('kitten', 'sitting'), 3);
+  assert.strictEqual(levenshtein('flaw', 'lawn'), 2);
+  assert.strictEqual(levenshtein('abc', 'xyz'), 3);
+});
+
+test('levenshtein is 0 for equal strings, including two empty strings', () => {
+  assert.strictEqual(levenshtein('same', 'same'), 0);
+  assert.strictEqual(levenshtein('', ''), 0);
+});
+
+test('levenshtein of an empty string is the length of the other', () => {
+  assert.strictEqual(levenshtein('', 'abc'), 3);
+  assert.strictEqual(levenshtein('abc', ''), 3);
+});
+
+test('levenshtein counts a single substitution, insertion or deletion as 1', () => {
+  assert.strictEqual(levenshtein('cat', 'cut'), 1);
+  assert.strictEqual(levenshtein('cat', 'cats'), 1);
+  assert.strictEqual(levenshtein('cats', 'cat'), 1);
+});
+
+test('levenshtein is symmetric', () => {
+  assert.strictEqual(levenshtein('saturday', 'sunday'), levenshtein('sunday', 'saturday'));
+  assert.strictEqual(levenshtein('saturday', 'sunday'), 3);
+});
+
+test('levenshtein is case-sensitive', () => {
+  assert.strictEqual(levenshtein('a', 'A'), 1);
+  assert.strictEqual(levenshtein('Hello', 'hello'), 1);
+});
+
+test('levenshtein counts a code point, such as an emoji, as one character', () => {
+  assert.strictEqual(levenshtein('😀', '😁'), 1);
+  assert.strictEqual(levenshtein('a😀', 'a'), 1);
+});
+
+test('levenshtein counts an accented letter as a different character from its plain form', () => {
+  assert.strictEqual(levenshtein('café', 'cafe'), 1);
+});
+
+test('levenshtein handles long strings', () => {
+  assert.strictEqual(levenshtein('a'.repeat(1000), 'b'.repeat(1000)), 1000);
+});
+
+test('levenshtein throws a TypeError for a non-string', () => {
+  assert.throws(() => levenshtein(null, 'a'), TypeError);
+  assert.throws(() => levenshtein('a', 42), TypeError);
+});
+
+test('commonPrefix finds the shared start of several strings', () => {
+  assert.strictEqual(commonPrefix(['flower', 'flow', 'flight']), 'fl');
+  assert.strictEqual(commonPrefix(['interview', 'internet', 'interval']), 'inter');
+});
+
+test('commonPrefix is empty when the strings share no start', () => {
+  assert.strictEqual(commonPrefix(['dog', 'racecar', 'car']), '');
+  assert.strictEqual(commonPrefix(['', 'abc']), '');
+});
+
+test('commonPrefix of an empty array is an empty string', () => {
+  assert.strictEqual(commonPrefix([]), '');
+});
+
+test('commonPrefix of one string is that string', () => {
+  assert.strictEqual(commonPrefix(['alone']), 'alone');
+  assert.strictEqual(commonPrefix(['']), '');
+});
+
+test('commonPrefix of equal strings is the whole string', () => {
+  assert.strictEqual(commonPrefix(['a', 'a']), 'a');
+  assert.strictEqual(commonPrefix(['same', 'same', 'same']), 'same');
+});
+
+test('commonPrefix can be a whole shorter string, whatever the order', () => {
+  assert.strictEqual(commonPrefix(['pre', 'prefix']), 'pre');
+  assert.strictEqual(commonPrefix(['prefix', 'pre']), 'pre');
+});
+
+test('commonPrefix is case-sensitive', () => {
+  assert.strictEqual(commonPrefix(['Hello', 'hello']), '');
+});
+
+test('commonPrefix compares code points, so an emoji is not split', () => {
+  assert.strictEqual(commonPrefix(['😀a', '😀b']), '😀');
+  assert.strictEqual(commonPrefix(['😀', '😁']), '');
+});
+
+test('commonPrefix does not change its input', () => {
+  const words = ['flower', 'flow'];
+  commonPrefix(words);
+  assert.deepStrictEqual(words, ['flower', 'flow']);
+});
+
+test('commonPrefix throws a TypeError for a non-array or a non-string item', () => {
+  assert.throws(() => commonPrefix('abc'), TypeError);
+  assert.throws(() => commonPrefix(null), TypeError);
+  assert.throws(() => commonPrefix(['a', 1]), TypeError);
+});
+
+test('padCenter throws on bad arguments', () => {
+  assert.throws(() => padCenter(null, 5), TypeError);
+  assert.throws(() => padCenter('hi', -1), RangeError);
+  assert.throws(() => padCenter('hi', 1.5), RangeError);
+  assert.throws(() => padCenter('hi', 5, ''), RangeError);
+  assert.throws(() => padCenter('hi', 5, '--'), RangeError);
+  assert.throws(() => padCenter('hi', 5, 1), TypeError);
+});
diff --git a/test/lib-validate.test.js b/test/lib-validate.test.js
