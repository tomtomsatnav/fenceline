index 0000000..8509452
--- /dev/null
+++ b/src/lib/validate.js
@@ -0,0 +1,112 @@
+// Local part: dot-separated runs of ASCII letters, digits and the usual symbols, with no empty runs.
+const LOCAL_PART = /^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*$/;
+// Domain: labels of letters, digits and inner hyphens, each followed by a dot, then a top-level domain of 2+ letters.
+const DOMAIN = /^([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\.)+[A-Za-z]{2,}$/;
+
+// 8-4-4-4-12 hex digits, version 1 to 5, and the RFC 4122 variant (the first digit of the fourth group is 8, 9, a or b).
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+// The nil UUID, all zeros, which RFC 4122 defines as a special value.
+const NIL_UUID = /^0{8}-0{4}-0{4}-0{4}-0{12}$/;
+
+/**
+ * True for a UUID in the RFC 4122 form: 32 hex digits in five groups separated by hyphens, with a version of 1 to 5
+ * and the RFC 4122 variant. The nil UUID (all zeros) is also accepted. Hex digits may be upper or lower case. Braces,
+ * a "urn:uuid:" prefix, and missing hyphens are rejected.
+ * @param {string} text
+ * @returns {boolean}
+ * @throws {TypeError} if text is not a string
+ */
+exports.isUuid = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`isUuid expects a string, got ${typeof text}`);
+  return UUID.test(text) || NIL_UUID.test(text);
+};
+
+/**
+ * True when text is at least 12 characters long and has a lower-case letter, an upper-case letter, a digit and a
+ * symbol. Letters and digits are Unicode, so "Ä" counts as upper case. A symbol is any character that is not a letter,
+ * a digit, a combining mark or whitespace, so a space does not count as a symbol. Length is counted in code points.
+ * @param {string} text
+ * @returns {boolean}
+ * @throws {TypeError} if text is not a string
+ */
+exports.isStrongPassword = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`isStrongPassword expects a string, got ${typeof text}`);
+  if (Array.from(text).length < 12) return false;
+  return /\p{Ll}/u.test(text) && /\p{Lu}/u.test(text) && /\p{Nd}/u.test(text) && /[^\p{L}\p{M}\p{N}\s]/u.test(text);
+};
+
+// Whitespace and control characters. The URL class silently removes some of them, so they are refused up front.
+const WHITESPACE_OR_CONTROL = /[\s\u0000-\u001f\u007f]/;
+
+/**
+ * True when text is an absolute http or https URL with a host, such as "https://example.com/path". Parsing is done by
+ * the URL class. Text with spaces, tabs, line breaks or other control characters is rejected, since the URL class
+ * would quietly remove them. Other schemes such as ftp: and mailto: are rejected.
+ * @param {string} text
+ * @returns {boolean}
+ * @throws {TypeError} if text is not a string
+ */
+exports.isUrl = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`isUrl expects a string, got ${typeof text}`);
+  if (WHITESPACE_OR_CONTROL.test(text)) return false;
+  let url;
+  try {
+    url = new URL(text);
+  } catch {
+    return false;
+  }
+  return (url.protocol === 'http:' || url.protocol === 'https:') && url.hostname !== '';
+};
+
+// The UK postcode format: an outward code (area, district and optional sector letter) and an inward code (a digit,
+// then two letters). The letters C, I, K, M, O and V never appear in the inward code, and I, Q, V and X never start
+// the area. GIR 0AA is the special Girobank code. One optional space may separate the codes.
+const UK_POSTCODE = /^(GIR ?0AA|[A-PR-UWYZ]([0-9]{1,2}|([A-HK-Y][0-9]([0-9ABEHMNPRV-Y])?)|[0-9][A-HJKPS-UW]) ?[0-9][ABD-HJLNP-UW-Z]{2})$/i;
+
+/**
+ * True for a UK postcode such as "SW1A 1AA". Case does not matter, and the space between the two halves is optional.
+ * Leading and trailing spaces, and more than one space, are rejected. The check is for the format only: it does not
+ * confirm that the postcode exists.
+ * @param {string} text
+ * @returns {boolean}
+ * @throws {TypeError} if text is not a string
+ */
+exports.isPostcodeUK = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`isPostcodeUK expects a string, got ${typeof text}`);
+  return UK_POSTCODE.test(text);
+};
+
+// A small set of common ISO 4217 currency codes. Add a code here to accept it.
+const COMMON_CURRENCIES = new Set([
+  'USD', 'EUR', 'GBP', 'JPY', 'CHF', 'CAD', 'AUD', 'NZD', 'CNY', 'HKD', 'SGD', 'INR', 'KRW', 'BRL', 'MXN', 'ZAR', 'SEK', 'NOK', 'DKK',
+]);
+
+/**
+ * True when text is exactly three upper-case letters and is one of a small list of common ISO 4217 currency codes,
+ * such as "USD" or "EUR". The list is short, so a valid currency that is not on it is rejected.
+ * @param {string} text
+ * @returns {boolean}
+ * @throws {TypeError} if text is not a string
+ */
+exports.isIsoCurrency = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`isIsoCurrency expects a string, got ${typeof text}`);
+  return COMMON_CURRENCIES.has(text);
+};
+
+/**
+ * A reasonable check that text is an email address: exactly one "@", a local part and a domain that match the usual
+ * characters, and a dot in the domain. It rejects spaces, and it is not a full RFC 5322 check. Only ASCII is accepted,
+ * so internationalised addresses are rejected. The address must be at most 254 characters, and the local part at most
+ * 64. A passing address is not proof that the mailbox exists.
+ * @param {string} text
+ * @returns {boolean}
+ * @throws {TypeError} if text is not a string
+ */
+exports.isEmail = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`isEmail expects a string, got ${typeof text}`);
+  if (text.length > 254) return false;
+  const parts = text.split('@');
+  if (parts.length !== 2) return false;
+  const [local, domain] = parts;
+  return local.length <= 64 && LOCAL_PART.test(local) && DOMAIN.test(domain);
+};
