+/**
+ * Splits an array into consecutive arrays of length n. The last one may be shorter. The input is not changed.
+ * @param {unknown[]} xs
+ * @param {number} n a positive integer
+ * @returns {unknown[][]} the chunks in order, or [] for an empty array
+ * @throws {TypeError} if xs is not an array
+ * @throws {RangeError} if n is not a positive integer
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError(`chunk expects an array, got ${typeof xs}`);
+  if (!Number.isInteger(n) || n < 1) throw new RangeError(`chunk expects a positive integer size, got ${n}`);
+  const chunks = [];
+  for (let i = 0; i < xs.length; i += n) chunks.push(xs.slice(i, i + n));
+  return chunks;
+};
+
+/**
+ * Keeps the first item for each key and drops later items with the same key. Keys are compared with SameValueZero,
+ * as Set does. The input is not changed.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => unknown} keyFn returns the key for an item
+ * @returns {T[]} the kept items, in their original order
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError(`uniqueBy expects an array, got ${typeof xs}`);
+  if (typeof keyFn !== 'function') throw new TypeError(`uniqueBy expects a key function, got ${typeof keyFn}`);
+  const seen = new Set();
+  return xs.filter((item) => {
+    const key = keyFn(item);
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+};
+
+/**
+ * Every run of n consecutive items, in order. Runs overlap: windowed([1, 2, 3], 2) gives [[1, 2], [2, 3]].
+ * The input is not changed.
+ * @param {unknown[]} xs
+ * @param {number} n a positive integer
+ * @returns {unknown[][]} the runs, or [] when xs is shorter than n
+ * @throws {TypeError} if xs is not an array
+ * @throws {RangeError} if n is not a positive integer
+ */
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError(`windowed expects an array, got ${typeof xs}`);
+  if (!Number.isInteger(n) || n < 1) throw new RangeError(`windowed expects a positive integer size, got ${n}`);
+  const runs = [];
+  for (let i = 0; i + n <= xs.length; i++) runs.push(xs.slice(i, i + n));
+  return runs;
+};
+
+/**
+ * Picks one item at random. Each item has an equal chance.
+ * @template T
+ * @param {T[]} xs
+ * @param {() => number} [rng] returns a number from 0 up to but not including 1; defaults to Math.random
+ * @returns {T | undefined} one of the items, or undefined for an empty array
+ * @throws {TypeError} if xs is not an array or rng is not a function
+ * @throws {RangeError} if rng returns something other than a number from 0 up to but not including 1
+ */
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new TypeError(`sample expects an array, got ${typeof xs}`);
+  if (typeof rng !== 'function') throw new TypeError(`sample expects a random function, got ${typeof rng}`);
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new RangeError(`sample expects rng to return a number in [0, 1), got ${r}`);
+  return xs[Math.floor(r * xs.length)];
+};
+
+/**
+ * Returns a new array sorted by the key keyFn gives each item. The sort is stable, so items with equal keys keep
+ * their order. Keys must all be strings, or all be numbers that are not NaN. Strings compare by UTF-16 code unit,
+ * so "B" sorts before "a". The input is not changed.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => string | number} keyFn
+ * @returns {T[]} the sorted items
+ * @throws {TypeError} if xs is not an array, keyFn is not a function, or the keys are not all strings or all numbers
+ * @throws {RangeError} if a key is NaN
+ */
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError(`sortBy expects an array, got ${typeof xs}`);
+  if (typeof keyFn !== 'function') throw new TypeError(`sortBy expects a key function, got ${typeof keyFn}`);
+  // Each key is computed once, so keyFn runs once per item.
+  const decorated = xs.map((item) => ({ item, key: keyFn(item) }));
+  const kind = decorated.length > 0 ? typeof decorated[0].key : null;
+  for (const { key } of decorated) {
+    if (typeof key !== 'string' && typeof key !== 'number') throw new TypeError(`sortBy keys must be strings or numbers, got ${typeof key}`);
+    if (typeof key !== kind) throw new TypeError('sortBy keys must all be strings, or all be numbers');
+    if (Number.isNaN(key)) throw new RangeError('sortBy cannot sort a NaN key');
+  }
+  return decorated.sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0)).map(({ item }) => item);
+};
+
+/**
+ * Flattens arrays nested to any depth into one array. Items that are not arrays are kept as they are, and empty
+ * arrays add nothing. The input is not changed.
+ * @param {unknown[]} xs
+ * @returns {unknown[]} the items in order, with no array items left
+ * @throws {TypeError} if xs is not an array, or if an array contains itself
+ */
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError(`flattenDeep expects an array, got ${typeof xs}`);
+  const out = [];
+  // The arrays on the current path, to catch an array that contains itself.
+  const path = new Set();
+  const walk = (arr) => {
+    if (path.has(arr)) throw new TypeError('flattenDeep cannot flatten an array that contains itself');
+    path.add(arr);
+    for (const item of arr) {
+      if (Array.isArray(item)) walk(item);
+      else out.push(item);
+    }
+    path.delete(arr);
+  };
+  walk(xs);
+  return out;
+};
+
+/**
+ * The items of a that are not in b, in their original order. Items are matched with SameValueZero, as Set does, so NaN
+ * matches NaN. Duplicates in a are kept unless b contains them. Neither input is changed.
+ * @template T
+ * @param {T[]} a
+ * @param {T[]} b
+ * @returns {T[]}
+ * @throws {TypeError} if a or b is not an array
+ */
+exports.difference = (a, b) => {
+  if (!Array.isArray(a)) throw new TypeError(`difference expects an array for a, got ${typeof a}`);
+  if (!Array.isArray(b)) throw new TypeError(`difference expects an array for b, got ${typeof b}`);
+  const exclude = new Set(b);
+  return a.filter((item) => !exclude.has(item));
+};
+
+/**
+ * The distinct items that appear in every array given, in the order they first appear in the first array. Items are
+ * matched with SameValueZero, as Set does. Duplicates are removed. None of the inputs is changed.
+ * @param {...unknown[]} arrays at least one array
+ * @returns {unknown[]}
+ * @throws {RangeError} if no arrays are given
+ * @throws {TypeError} if any argument is not an array
+ */
+exports.intersection = (...arrays) => {
+  if (arrays.length === 0) throw new RangeError('intersection expects at least one array');
+  for (const a of arrays) {
+    if (!Array.isArray(a)) throw new TypeError(`intersection expects arrays, got ${typeof a}`);
+  }
+  const [first, ...rest] = arrays;
+  const others = rest.map((a) => new Set(a));
+  const seen = new Set();
+  const result = [];
+  for (const item of first) {
+    if (seen.has(item)) continue;
+    seen.add(item);
+    if (others.every((set) => set.has(item))) result.push(item);
+  }
+  return result;
+};
+
+/**
+ * A new array rotated left by k places: the first k items move to the end. A negative k rotates right. A k larger than
+ * the length wraps around, so rotate(xs, xs.length) is a copy of xs. The input is not changed.
+ * @template T
+ * @param {T[]} xs
+ * @param {number} k a whole number of places
+ * @returns {T[]} the rotated items, or [] for an empty array
+ * @throws {TypeError} if xs is not an array, or k is not a number
+ * @throws {RangeError} if k is not a whole number
+ */
+exports.rotate = (xs, k) => {
+  if (!Array.isArray(xs)) throw new TypeError(`rotate expects an array, got ${typeof xs}`);
+  if (typeof k !== 'number') throw new TypeError(`rotate expects a number of places, got ${typeof k}`);
+  if (!Number.isInteger(k)) throw new RangeError(`rotate expects a whole number of places, got ${k}`);
+  const n = xs.length;
+  if (n === 0) return [];
+  // Reduce k to 0..n-1, so a negative k rotates right.
+  const shift = ((k % n) + n) % n;
+  return xs.slice(shift).concat(xs.slice(0, shift));
+};
+
+/**
+ * Numbers from start up to but not including end, moving by step. A negative step counts down, from a larger start
+ * to a smaller end.
+ * @param {number} start
+ * @param {number} end exclusive
+ * @param {number} [step] defaults to 1; must not be 0
+ * @returns {number[]} the numbers, or [] when none lie between start and end in the direction of step
+ * @throws {TypeError} if start, end or step is not a number
+ * @throws {RangeError} if start, end or step is not finite, or step is 0
+ */
+exports.range = (start, end, step = 1) => {
+  for (const [name, value] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof value !== 'number') throw new TypeError(`range expects a number for ${name}, got ${typeof value}`);
+    if (!Number.isFinite(value)) throw new RangeError(`range expects a finite number for ${name}, got ${value}`);
