+  assert.strictEqual(isPostcodeUK('AB1 1CA'), false); // C is not used in the inward code
+  assert.strictEqual(isPostcodeUK('SW1A 1AK'), false); // K is not used in the inward code
+  assert.strictEqual(isPostcodeUK('SW1A 1AI'), false); // I is not used in the inward code
+});
+
+test('isPostcodeUK rejects letters where a digit belongs, and the reverse', () => {
+  assert.strictEqual(isPostcodeUK('SWAA 1AA'), false);
+  assert.strictEqual(isPostcodeUK('SW1A A1A'), false);
+  assert.strictEqual(isPostcodeUK('1234 5AA'), false);
+});
+
+test('isPostcodeUK rejects text that is not a postcode', () => {
+  assert.strictEqual(isPostcodeUK('not a postcode'), false);
+  assert.strictEqual(isPostcodeUK('12345'), false);
+});
+
+test('isPostcodeUK throws a TypeError for a non-string', () => {
+  assert.throws(() => isPostcodeUK(null), TypeError);
+  assert.throws(() => isPostcodeUK(12345), TypeError);
+});
+
+test('isIsoCurrency accepts codes on the list', () => {
