+    if (kind === null) kind = typeof key;
+    if (typeof key !== kind) throw new TypeError('maxBy keys must all be strings, or all be numbers');
+    if (Number.isNaN(key)) throw new RangeError('maxBy cannot compare a NaN key');
+    // A strictly larger key replaces the best, so the first of any tie is kept.
+    if (bestKey === undefined || key > bestKey) {
+      best = item;
+      bestKey = key;
+    }
+  }
+  return best;
+};
+
+/**
+ * Groups items into arrays by the key keyFn returns for each item. Within a group, items keep their order.
+ * Keys are used as object keys, so 1 and "1" are the same group. Keys such as "__proto__" are safe.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => PropertyKey} keyFn returns the group key for an item
+ * @returns {Record<string, T[]>} an object with one array per key, or {} for an empty input
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError(`groupBy expects an array, got ${typeof xs}`);
+  if (typeof keyFn !== 'function') throw new TypeError(`groupBy expects a key function, got ${typeof keyFn}`);
+  const groups = {};
+  for (const item of xs) {
+    const key = keyFn(item);
+    // defineProperty, not assignment, so a key like "__proto__" becomes an ordinary property.
+    if (!Object.hasOwn(groups, key)) Object.defineProperty(groups, key, { value: [], enumerable: true, writable: true, configurable: true });
+    groups[key].push(item);
+  }
+  return groups;
+};
