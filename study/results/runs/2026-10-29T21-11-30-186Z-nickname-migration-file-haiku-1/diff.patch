+/**
+ * A new Date n calendar days after date (before it when n is negative). Days are counted in local time, so the time
+ * of day is kept. The input is not changed.
+ * @param {Date} date a valid date
+ * @param {number} n a whole number of days, may be negative
+ * @returns {Date} the new date
+ * @throws {TypeError} if date is not a Date, or n is not a number
+ * @throws {RangeError} if date is invalid, n is not a whole number, or the result is outside the range of Date
+ */
+exports.addDays = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError(`addDays expects a Date, got ${typeof date}`);
+  if (Number.isNaN(date.getTime())) throw new RangeError('addDays expects a valid date');
+  if (typeof n !== 'number') throw new TypeError(`addDays expects a number of days, got ${typeof n}`);
+  if (!Number.isInteger(n)) throw new RangeError(`addDays expects a whole number of days, got ${n}`);
+  const result = new Date(date.getTime());
+  // setDate moves across month and year ends, and into leap days, by itself.
+  result.setDate(result.getDate() + n);
+  if (Number.isNaN(result.getTime())) throw new RangeError('addDays result is outside the range of Date');
+  return result;
+};
+
+const MS_PER_DAY = 86400000;
+
+// Index of the UTC calendar day that date falls on, counted from 1970-01-01. Dates before 1970 give negative indexes.
+const utcDayIndex = (date) => Math.floor(date.getTime() / MS_PER_DAY);
+
+/**
+ * Whole UTC calendar days from a to b, ignoring the time of day. Two times on the same UTC date give 0, and
+ * 23:59 on one day to 00:01 the next gives 1, even though only two minutes apart.
+ * @param {Date} a
+ * @param {Date} b
+ * @returns {number} positive when b is later than a, negative when earlier, 0 on the same UTC date
+ * @throws {TypeError} if a or b is not a Date
+ * @throws {RangeError} if a or b is an invalid date
+ */
+exports.daysBetween = (a, b) => {
+  for (const [name, value] of [['a', a], ['b', b]]) {
+    if (!(value instanceof Date)) throw new TypeError(`daysBetween expects a Date for ${name}, got ${typeof value}`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`daysBetween expects a valid date for ${name}`);
+  }
+  return utcDayIndex(b) - utcDayIndex(a);
+};
+
+/**
+ * True when date falls on a Saturday or Sunday in UTC.
+ * @param {Date} date
+ * @returns {boolean}
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is invalid
+ */
+exports.isWeekend = (date) => {
+  if (!(date instanceof Date)) throw new TypeError(`isWeekend expects a Date, got ${typeof date}`);
+  if (Number.isNaN(date.getTime())) throw new RangeError('isWeekend expects a valid date');
+  const day = date.getUTCDay();
+  // 0 is Sunday and 6 is Saturday.
+  return day === 0 || day === 6;
+};
+
+/**
+ * Formats a date as YYYY-MM-DD using its UTC date, so the time of day and the local time zone do not matter.
+ * @param {Date} date
+ * @returns {string} for example "2024-03-09"
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is invalid, or its UTC year is outside 0 to 9999
+ */
+exports.formatIsoDate = (date) => {
+  if (!(date instanceof Date)) throw new TypeError(`formatIsoDate expects a Date, got ${typeof date}`);
+  if (Number.isNaN(date.getTime())) throw new RangeError('formatIsoDate expects a valid date');
+  const year = date.getUTCFullYear();
+  if (year < 0 || year > 9999) throw new RangeError(`formatIsoDate supports years 0 to 9999, got ${year}`);
+  const pad = (n, width) => String(n).padStart(width, '0');
+  return `${pad(year, 4)}-${pad(date.getUTCMonth() + 1, 2)}-${pad(date.getUTCDate(), 2)}`;
+};
+
+/**
+ * Parses a YYYY-MM-DD date as midnight UTC. The inverse of formatIsoDate. Only that exact form is accepted, and the
+ * date must exist: 2026-02-30 and 2023-02-29 are rejected.
+ * @param {string} text
+ * @returns {Date} midnight UTC on that day
