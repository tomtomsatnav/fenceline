+test('returns one chunk when n is at least the length', () => {
+  assert.deepStrictEqual(chunk([1, 2, 3], 3), [[1, 2, 3]]);
+  assert.deepStrictEqual(chunk([1, 2, 3], 10), [[1, 2, 3]]);
+});
+
+test('returns an empty array for an empty input', () => {
+  assert.deepStrictEqual(chunk([], 3), []);
+});
+
+test('does not change the input array', () => {
+  const xs = [1, 2, 3];
+  chunk(xs, 2);
+  assert.deepStrictEqual(xs, [1, 2, 3]);
+});
+
+test('throws a TypeError when the input is not an array', () => {
+  assert.throws(() => chunk('abc', 2), TypeError);
+  assert.throws(() => chunk(null, 2), TypeError);
+});
+
+test('throws a RangeError when n is not a positive integer', () => {
+  assert.throws(() => chunk([1], 0), RangeError);
+  assert.throws(() => chunk([1], -1), RangeError);
+  assert.throws(() => chunk([1], 1.5), RangeError);
+  assert.throws(() => chunk([1], NaN), RangeError);
+});
+
+test('uniqueBy keeps the first item for each key, in order', () => {
