+  if (typeof year !== 'number') throw new TypeError(`isLeapYear expects a number, got ${typeof year}`);
+  if (!Number.isInteger(year)) throw new RangeError(`isLeapYear expects a whole number, got ${year}`);
+  return leap(year);
+};
+
+/**
+ * A new Date n calendar months after date (before it when n is negative), in UTC. When the day of the month does not
+ * exist in the target month, it becomes the last day of that month: January 31 plus one month is February 28 or 29.
+ * The time of day is kept. The input is not changed.
+ * @param {Date} date a valid date
+ * @param {number} n a whole number of months, may be negative
+ * @returns {Date}
+ * @throws {TypeError} if date is not a Date, or n is not a number
+ * @throws {RangeError} if date is invalid, n is not a whole number, or the result is outside the range of Date
+ */
+exports.addMonths = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError(`addMonths expects a Date, got ${typeof date}`);
+  if (Number.isNaN(date.getTime())) throw new RangeError('addMonths expects a valid date');
+  if (typeof n !== 'number') throw new TypeError(`addMonths expects a number of months, got ${typeof n}`);
+  if (!Number.isInteger(n)) throw new RangeError(`addMonths expects a whole number of months, got ${n}`);
+  const day = date.getUTCDate();
+  const result = new Date(date.getTime());
+  // Move to the 1st first, so the month change cannot skip into the following month.
+  result.setUTCDate(1);
+  result.setUTCMonth(result.getUTCMonth() + n);
+  if (Number.isNaN(result.getTime())) throw new RangeError('addMonths result is outside the range of Date');
+  const lastDay = exports.daysInMonth(result.getUTCFullYear(), result.getUTCMonth() + 1);
+  result.setUTCDate(Math.min(day, lastDay));
+  return result;
+};
+
+/**
+ * The calendar quarter of a date in UTC: 1 for January to March, 2 for April to June, 3 for July to September and 4
+ * for October to December. The time of day is ignored.
+ * @param {Date} date
+ * @returns {1 | 2 | 3 | 4}
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is invalid
+ */
+exports.quarterOf = (date) => {
+  if (!(date instanceof Date)) throw new TypeError(`quarterOf expects a Date, got ${typeof date}`);
+  if (Number.isNaN(date.getTime())) throw new RangeError('quarterOf expects a valid date');
+  // getUTCMonth is 0 for January, so three months per quarter gives 0 to 3.
+  return Math.floor(date.getUTCMonth() / 3) + 1;
+};
+
+const DURATION_UNITS = [['d', 86400], ['h', 3600], ['m', 60], ['s', 1]];
+
+/**
+ * A count of seconds written with the largest units first, such as "1h 2m 5s" for 3725. Units with no amount are left
+ * out, so 3600 is "1h". Days are the largest unit, so 90061 is "1d 1h 1m 1s". Zero is "0s". The output is the form
+ * parseDuration reads back.
+ * @param {number} seconds a whole number of seconds, not negative
+ * @returns {string}
+ * @throws {TypeError} if seconds is not a number
+ * @throws {RangeError} if seconds is negative, not a whole number, or not a safe integer
+ */
+exports.formatDuration = (seconds) => {
+  if (typeof seconds !== 'number') throw new TypeError(`formatDuration expects a number, got ${typeof seconds}`);
+  if (!Number.isSafeInteger(seconds) || seconds < 0) throw new RangeError(`formatDuration expects a whole number of seconds, not negative, got ${seconds}`);
+  if (seconds === 0) return '0s';
+  let rest = seconds;
+  const parts = [];
+  for (const [unit, size] of DURATION_UNITS) {
+    const amount = Math.floor(rest / size);
+    if (amount > 0) parts.push(`${amount}${unit}`);
+    rest -= amount * size;
+  }
+  return parts.join(' ');
+};
+
+const MONTH_LENGTHS = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+/**
+ * The number of days in a month of the Gregorian calendar. February has 29 days in leap years.
+ * @param {number} year a whole number
+ * @param {number} month an integer from 1 (January) to 12 (December)
+ * @returns {number} 28, 29, 30 or 31
+ * @throws {TypeError} if year or month is not a number
+ * @throws {RangeError} if year is not a whole number, or month is not an integer from 1 to 12
+ */
+exports.daysInMonth = (year, month) => {
+  if (typeof year !== 'number') throw new TypeError(`daysInMonth expects a number for year, got ${typeof year}`);
+  if (typeof month !== 'number') throw new TypeError(`daysInMonth expects a number for month, got ${typeof month}`);
+  if (!Number.isInteger(year)) throw new RangeError(`daysInMonth expects a whole-number year, got ${year}`);
+  if (!Number.isInteger(month) || month < 1 || month > 12) throw new RangeError(`daysInMonth expects a month from 1 to 12, got ${month}`);
+  if (month === 2 && leap(year)) return 29;
+  return MONTH_LENGTHS[month - 1];
+};
+
+/**
+ * Whole years between birthDate and date, counted in UTC. A birthday is reached on its UTC month and day, and
+ * time of day is ignored. A 29 February birthday is reached on 1 March in years with no 29 February.
+ * @param {Date} birthDate
+ * @param {Date} date the date to measure the age on
+ * @returns {number} 0 on the birth date itself, and so on upwards
+ * @throws {TypeError} if birthDate or date is not a Date
+ * @throws {RangeError} if either date is invalid, or date is before birthDate
+ */
+exports.ageOn = (birthDate, date) => {
+  for (const [name, value] of [['birthDate', birthDate], ['date', date]]) {
+    if (!(value instanceof Date)) throw new TypeError(`ageOn expects a Date for ${name}, got ${typeof value}`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`ageOn expects a valid date for ${name}`);
+  }
+  if (exports.daysBetween(birthDate, date) < 0) throw new RangeError('ageOn expects date to be on or after birthDate');
+  const birthYear = birthDate.getUTCFullYear();
+  const birthMonth = birthDate.getUTCMonth();
+  const birthDay = birthDate.getUTCDate();
+  const year = date.getUTCFullYear();
