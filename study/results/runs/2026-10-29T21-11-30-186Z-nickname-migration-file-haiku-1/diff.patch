+  if (typeof a !== 'string') throw new TypeError(`levenshtein expects a string for a, got ${typeof a}`);
+  if (typeof b !== 'string') throw new TypeError(`levenshtein expects a string for b, got ${typeof b}`);
+  let s = Array.from(a);
+  let t = Array.from(b);
+  // Keep the shorter string as the row, so the work needs only one row of memory per step.
+  if (s.length < t.length) [s, t] = [t, s];
+  let prev = Array.from({ length: t.length + 1 }, (_, j) => j);
+  for (let i = 1; i <= s.length; i++) {
+    const row = [i];
+    for (let j = 1; j <= t.length; j++) {
+      const cost = s[i - 1] === t[j - 1] ? 0 : 1;
+      row[j] = Math.min(prev[j] + 1, row[j - 1] + 1, prev[j - 1] + cost);
+    }
+    prev = row;
+  }
+  return prev[t.length];
+};
+
+/**
+ * The longest prefix that every string in the array starts with. Comparison is by code point and case-sensitive, so an
+ * emoji is never split in two. The input is not changed.
+ * @param {string[]} strings
+ * @returns {string} "" for an empty array or when the strings share no start; the whole string for a one-item array
+ * @throws {TypeError} if strings is not an array, or an item is not a string
+ */
+exports.commonPrefix = (strings) => {
+  if (!Array.isArray(strings)) throw new TypeError(`commonPrefix expects an array, got ${typeof strings}`);
+  for (const s of strings) {
+    if (typeof s !== 'string') throw new TypeError(`commonPrefix expects strings, got ${typeof s}`);
+  }
+  if (strings.length === 0) return '';
+  let prefix = Array.from(strings[0]);
+  for (const s of strings.slice(1)) {
+    const chars = Array.from(s);
+    let i = 0;
+    while (i < prefix.length && i < chars.length && prefix[i] === chars[i]) i++;
+    prefix = prefix.slice(0, i);
+    if (prefix.length === 0) break;
+  }
+  return prefix.join('');
+};
+
+/**
+ * Shortens text to at most n characters. When anything is cut, the result ends in "…", which counts as one character.
+ * Characters are Unicode code points, so an emoji is one character.
+ * @param {string} text
+ * @param {number} n a non-negative integer
+ * @returns {string} text itself if it fits, otherwise its first n - 1 characters followed by "…"
+ * @throws {TypeError} if text is not a string
+ * @throws {RangeError} if n is not a non-negative integer
+ */
+exports.truncate = (text, n) => {
+  if (typeof text !== 'string') throw new TypeError(`truncate expects a string, got ${typeof text}`);
+  if (!Number.isInteger(n) || n < 0) throw new RangeError(`truncate expects a non-negative integer length, got ${n}`);
+  const chars = Array.from(text);
+  if (chars.length <= n) return text;
+  if (n === 0) return '';
+  return chars.slice(0, n - 1).join('') + '…';
+};
+
+/**
+ * Centres text in a field of the given width by padding both sides with ch. If the padding is odd, the extra
+ * character goes on the right. Lengths are counted in Unicode code points.
+ * @param {string} text
+ * @param {number} width a non-negative integer
+ * @param {string} [ch] a single character, default " "
+ * @returns {string} text itself if it is already at least width long, otherwise padded to exactly width
+ * @throws {TypeError} if text or ch is not a string
+ * @throws {RangeError} if width is not a non-negative integer or ch is not exactly one character
+ */
+exports.padCenter = (text, width, ch = ' ') => {
+  if (typeof text !== 'string') throw new TypeError(`padCenter expects a string, got ${typeof text}`);
+  if (typeof ch !== 'string') throw new TypeError(`padCenter expects a string pad character, got ${typeof ch}`);
+  if (!Number.isInteger(width) || width < 0) throw new RangeError(`padCenter expects a non-negative integer width, got ${width}`);
+  if (Array.from(ch).length !== 1) throw new RangeError(`padCenter expects a single character to pad with, got "${ch}"`);
+  const total = width - Array.from(text).length;
+  if (total <= 0) return text;
+  const left = Math.floor(total / 2);
+  return ch.repeat(left) + text + ch.repeat(total - left);
+};
+
+/**
+ * Counts the words in text. A word is a run of letters, digits or combining marks, so whitespace and punctuation
+ * separate words. An apostrophe splits a contraction: "don't" is two words.
+ * @param {string} text
+ * @returns {number} the number of words, 0 for empty text or text with no letters or digits
+ * @throws {TypeError} if text is not a string
+ */
+exports.countWords = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`countWords expects a string, got ${typeof text}`);
+  return (text.match(/[\p{L}\p{M}\p{N}]+/gu) ?? []).length;
+};
+
+/**
+ * The first letter of each word, uppercased. Words are split the same way as countWords.
+ * @param {string} text
+ * @returns {string} for example "AKL" from "Ada King Lovelace", or "" when there are no words
+ * @throws {TypeError} if text is not a string
+ */
+exports.initials = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`initials expects a string, got ${typeof text}`);
+  const words = text.match(/[\p{L}\p{M}\p{N}]+/gu) ?? [];
+  return words.map((word) => Array.from(word)[0].toUpperCase()).join('');
+};
+
+/**
+ * Reverses the order of the words in a sentence. Words are separated by whitespace, so punctuation stays
+ * attached to its word, and the result has single spaces between words with none at the ends.
+ * @param {string} text
+ * @returns {string} for example "world! hello," from "hello, world!", or "" when there are no words
+ * @throws {TypeError} if text is not a string
+ */
+exports.reverseWords = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`reverseWords expects a string, got ${typeof text}`);
+  return text.trim().split(/\s+/).reverse().join(' ');
+};
+
+/**
+ * True when text reads the same backwards. Case, spaces and punctuation are ignored, and only letters, digits and
+ * combining marks are compared.
+ * @param {string} text
+ * @returns {boolean} true for text with no letters or digits, since that reads the same both ways
+ * @throws {TypeError} if text is not a string
+ */
+exports.isPalindrome = (text) => {
+  if (typeof text !== 'string') throw new TypeError(`isPalindrome expects a string, got ${typeof text}`);
+  const chars = Array.from(text.toLowerCase().match(/[\p{L}\p{M}\p{N}]/gu) ?? []);
+  return chars.join('') === chars.slice().reverse().join('');
+};
+
+/**
+ * Breaks text into lines no longer than width, filling each line greedily and breaking only between words.
+ * Whitespace between words is collapsed to one space. A word longer than width is not split, so it gets a line
+ * of its own that is longer than width.
+ * @param {string} text
+ * @param {number} width a positive integer, counted in Unicode code points
+ * @returns {string} the lines joined with "\n", or "" when there are no words
+ * @throws {TypeError} if text is not a string
+ * @throws {RangeError} if width is not a positive integer
+ */
+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new TypeError(`wrap expects a string, got ${typeof text}`);
+  if (!Number.isInteger(width) || width < 1) throw new RangeError(`wrap expects a positive integer width, got ${width}`);
+  const lines = [];
+  let line = '';
+  for (const word of text.split(/\s+/).filter(Boolean)) {
+    if (line === '') line = word;
+    else if (Array.from(line).length + 1 + Array.from(word).length <= width) line += ` ${word}`;
+    else {
+      lines.push(line);
+      line = word;
+    }
+  }
+  if (line !== '') lines.push(line);
+  return lines.join('\n');
+};
+
+/**
+ * Fills {name} placeholders in text from data. A placeholder is replaced only when data has its name with a value
+ * that is not null or undefined; any other placeholder is left as it is. Names are matched exactly, with no trimming,
+ * and there is no way to write a literal brace.
+ * @param {string} text
+ * @param {Record<string, unknown>} [data] defaults to {}
+ * @returns {string} text with the known placeholders filled in
+ * @throws {TypeError} if text is not a string or data is not an object
+ */
+exports.template = (text, data = {}) => {
+  if (typeof text !== 'string') throw new TypeError(`template expects a string, got ${typeof text}`);
+  if (typeof data !== 'object' || data === null) throw new TypeError(`template expects an object of values, got ${data}`);
+  return text.replace(/\{([^{}]+)\}/g, (placeholder, name) => {
+    if (!Object.hasOwn(data, name) || data[name] == null) return placeholder;
+    return String(data[name]);
+  });
+};
