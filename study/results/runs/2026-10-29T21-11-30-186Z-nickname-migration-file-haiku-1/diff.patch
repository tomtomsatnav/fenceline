--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,72 @@
+const { listUsers, importUsers } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quotes a CSV field when it contains a comma, a quote or a line break.
+const escapeField = (value) => {
+  const s = value ?? '';
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * Every user, oldest first, as CSV with a header row.
+ * @param {import('../db.js').Db} db
+ * @returns {string} CSV text with the columns id, email, fullName, createdAt, lastLogin
+ */
+exports.exportUsersCsv =(db) => {
+  const users = listUsers(db, { limit: Infinity });
+  const lines = [COLUMNS, ...users.map((u) => COLUMNS.map((c) => u[c]))];
+  return lines.map((line) => line.map(escapeField).join(',')).join('\n') + '\n';
+};
+
+// Splits CSV text into rows of fields. Handles quoted fields, doubled quotes and line breaks inside quotes.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c === '"' && text[i + 1] === '"') { field += '"'; i++; }
+      else if (c === '"') quoted = false;
+      else field += c;
+    } else if (c === '"') {
+      quoted = true;
+    } else if (c === ',') {
+      row.push(field);
+      field = '';
+    } else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+    } else {
+      field += c;
+    }
+  }
+  if (field !== '' || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+  return rows;
+};
+
+/**
+ * Reads CSV written by exportUsersCsv and inserts its users, keeping their ids and timestamps.
+ * @param {import('../db.js').Db} db
+ * @param {string} csv
+ * @returns {object[]} the inserted users
+ * @throws {Error} if the header or a row is malformed, or importUsers rejects a user; nothing is inserted
+ */
+exports.importUsersCsv =(db, csv) => {
+  const [header, ...rows] = parseCsv(csv);
+  if (header?.join(',') !== COLUMNS.join(',')) throw new Error(`Invalid CSV header: ${header?.join(',')}`);
+  const users = rows.map((fields, i) => {
+    if (fields.length !== COLUMNS.length) throw new Error(`Row ${i + 1}: expected ${COLUMNS.length} fields, got ${fields.length}`);
+    const [id, email, fullName, createdAt, lastLogin] = fields;
+    return { id, email, fullName, createdAt, lastLogin: lastLogin || null };
+  });
+  return importUsers(db, users);
+};
