+  const result = Object.create(Object.getPrototypeOf(a));
+  for (const key of Object.keys(a)) setOwn(result, key, a[key]);
+  for (const key of Object.keys(b)) {
+    const bothPlain = Object.hasOwn(a, key) && isPlainObject(a[key]) && isPlainObject(b[key]);
+    setOwn(result, key, bothPlain ? mergeAt(a[key], b[key], active) : b[key]);
+  }
+  active.pop();
+  return result;
+};
+
+/**
+ * Merges b into a, recursively for plain objects. Where both sides hold a plain object under the same key the objects
+ * are merged; otherwise b's value wins. So arrays in b replace arrays and objects in a, and an undefined value in b
+ * replaces the value in a. Values taken from b, including arrays and non-plain objects such as Dates, are shared with
+ * b, not copied. Neither input is changed.
+ * @param {Record<string, unknown>} a
+ * @param {Record<string, unknown>} b
+ * @returns {Record<string, unknown>} a new object
+ * @throws {TypeError} if a or b is not a plain object, or if a or b contains itself along a merged path
+ */
+exports.mergeDeep = (a, b) => {
+  if (!isPlainObject(a)) throw new TypeError(`mergeDeep expects a plain object for a, got ${Array.isArray(a) ? 'array' : a === null ? 'null' : typeof a}`);
+  if (!isPlainObject(b)) throw new TypeError(`mergeDeep expects a plain object for b, got ${Array.isArray(b) ? 'array' : b === null ? 'null' : typeof b}`);
+  return mergeAt(a, b, []);
+};
