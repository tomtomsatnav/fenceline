+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { createUser, recordLogin, listUsers } = require('../src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+test('exports only a header row when there are no users', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), 'id,email,fullName,createdAt,lastLogin\n');
+});
+
+test('exports one row per user, oldest first, with a null lastLogin left empty', () => {
+  const db = migrate(new Db());
+  const ada = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  const grace = createUser(db, { email: 'grace@example.com', fullName: 'Grace Hopper' });
+  db.tables.users.rows[0].created_at = '2024-01-02T00:00:00.000Z';
+  db.tables.users.rows[1].created_at = '2024-01-01T00:00:00.000Z';
+  recordLogin(db, ada.id, new Date('2024-02-01T00:00:00.000Z'));
+  assert.strictEqual(exportUsersCsv(db), [
+    'id,email,fullName,createdAt,lastLogin',
+    `${grace.id},grace@example.com,Grace Hopper,2024-01-01T00:00:00.000Z,`,
+    `${ada.id},ada@example.com,Ada Lovelace,2024-01-02T00:00:00.000Z,2024-02-01T00:00:00.000Z`,
+    '',
+  ].join('\n'));
+});
+
+test('quotes fields that contain commas, quotes or line breaks', () => {
+  const db = migrate(new Db());
+  const u = createUser(db, { email: 'lee@example.com', fullName: 'Lee "Ace", Jr.\nSenior' });
+  assert.strictEqual(exportUsersCsv(db), `id,email,fullName,createdAt,lastLogin\n${u.id},lee@example.com,"Lee ""Ace"", Jr.\nSenior",${u.createdAt},\n`);
+});
+
+test('importing an export restores the same users', () => {
+  const db = migrate(new Db());
+  const ada = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  createUser(db, { email: 'lee@example.com', fullName: 'Lee "Ace", Jr.\nSenior' });
