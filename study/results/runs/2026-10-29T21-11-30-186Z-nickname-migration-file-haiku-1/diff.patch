+  let birthdayKey = (birthMonth + 1) * 100 + birthDay;
+  if (birthMonth === 1 && birthDay === 29 && !leap(year)) birthdayKey = 301;
+  const dateKey = (date.getUTCMonth() + 1) * 100 + date.getUTCDate();
+  return year - birthYear - (dateKey < birthdayKey ? 1 : 0);
+};
+
+const RELATIVE_UNITS = [['day', 86400000], ['hour', 3600000], ['minute', 60000], ['second', 1000]];
+
+/**
+ * A phrase for how far date is from now, in the largest whole unit: "3 minutes ago" or "in 2 days". Units are days,
+ * hours, minutes and seconds, so months and years are not used. Differences under a second give "now".
+ * @param {Date} date
+ * @param {Date} [now] defaults to the current time
+ * @returns {string}
+ * @throws {TypeError} if date or now is not a Date
+ * @throws {RangeError} if date or now is invalid
+ */
+exports.relativeTime = (date, now = new Date()) => {
+  for (const [name, value] of [['date', date], ['now', now]]) {
+    if (!(value instanceof Date)) throw new TypeError(`relativeTime expects a Date for ${name}, got ${typeof value}`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`relativeTime expects a valid date for ${name}`);
+  }
+  const diff = date.getTime() - now.getTime();
+  const ms = Math.abs(diff);
+  if (ms < 1000) return 'now';
+  for (const [unit, size] of RELATIVE_UNITS) {
+    if (ms >= size) {
+      const amount = Math.floor(ms / size);
+      const phrase = `${amount} ${unit}${amount === 1 ? '' : 's'}`;
+      return diff < 0 ? `${phrase} ago` : `in ${phrase}`;
+    }
+  }
+  return 'now';
+};
+
+/**
+ * The Monday at 00:00 UTC of the week that contains date. Weeks run Monday to Sunday.
+ * @param {Date} date
+ * @returns {Date} a new Date
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is invalid, or the Monday is outside the range of Date
+ */
+exports.startOfWeek = (date) => {
+  if (!(date instanceof Date)) throw new TypeError(`startOfWeek expects a Date, got ${typeof date}`);
+  if (Number.isNaN(date.getTime())) throw new RangeError('startOfWeek expects a valid date');
+  // Days since the Monday of this week: Monday 0, Tuesday 1, ..., Sunday 6.
+  const sinceMonday = (date.getUTCDay() + 6) % 7;
+  const result = new Date(date.getTime());
+  result.setUTCHours(0, 0, 0, 0);
+  result.setUTCDate(result.getUTCDate() - sinceMonday);
+  if (Number.isNaN(result.getTime())) throw new RangeError('startOfWeek result is outside the range of Date');
+  return result;
+};
