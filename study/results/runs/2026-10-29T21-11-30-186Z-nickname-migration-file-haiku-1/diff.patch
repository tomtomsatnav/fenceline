+  assert.strictEqual(isIsoCurrency('US'), false);
+  assert.strictEqual(isIsoCurrency('USDX'), false);
+  assert.strictEqual(isIsoCurrency(' USD'), false);
+  assert.strictEqual(isIsoCurrency('USD '), false);
+});
+
+test('isIsoCurrency rejects a currency symbol and digits', () => {
+  assert.strictEqual(isIsoCurrency('$'), false);
+  assert.strictEqual(isIsoCurrency('U5D'), false);
+});
+
+test('isIsoCurrency throws a TypeError for a non-string', () => {
+  assert.throws(() => isIsoCurrency(null), TypeError);
+  assert.throws(() => isIsoCurrency(840), TypeError); // the numeric ISO code for USD
+});
+
+test('isEmail accepts ordinary addresses', () => {
+  assert.strictEqual(isEmail('ada@example.com'), true);
+  assert.strictEqual(isEmail('first.last@sub.example.co.uk'), true);
+  assert.strictEqual(isEmail('a+tag@x.io'), true);
+  assert.strictEqual(isEmail("o'neil@x.org"), true);
+  assert.strictEqual(isEmail('user_name@my-domain.com'), true);
+});
+
+test('isEmail rejects text without exactly one "@"', () => {
+  assert.strictEqual(isEmail(''), false);
+  assert.strictEqual(isEmail('ada'), false);
+  assert.strictEqual(isEmail('ada@'), false);
+  assert.strictEqual(isEmail('@example.com'), false);
+  assert.strictEqual(isEmail('ada@@example.com'), false);
+  assert.strictEqual(isEmail('a@b@example.com'), false);
+});
+
+test('isEmail requires a dot in the domain', () => {
+  assert.strictEqual(isEmail('ada@localhost'), false);
+  assert.strictEqual(isEmail('ada@example'), false);
+});
+
+test('isEmail rejects a malformed domain', () => {
+  assert.strictEqual(isEmail('ada@example.'), false);
+  assert.strictEqual(isEmail('ada@.example.com'), false);
+  assert.strictEqual(isEmail('ada@example..com'), false);
+  assert.strictEqual(isEmail('ada@-example.com'), false);
+  assert.strictEqual(isEmail('ada@example-.com'), false);
+  assert.strictEqual(isEmail('ada@example.c'), false);
+  assert.strictEqual(isEmail('ada@example.123'), false);
+});
+
+test('isEmail rejects a malformed local part', () => {
+  assert.strictEqual(isEmail('.ada@example.com'), false);
+  assert.strictEqual(isEmail('ada.@example.com'), false);
+  assert.strictEqual(isEmail('ada..x@example.com'), false);
+});
+
+test('isEmail rejects spaces anywhere', () => {
+  assert.strictEqual(isEmail('ada @example.com'), false);
+  assert.strictEqual(isEmail('ada@exa mple.com'), false);
+  assert.strictEqual(isEmail(' ada@example.com'), false);
+  assert.strictEqual(isEmail('ada@example.com '), false);
+  assert.strictEqual(isEmail('ada@example.com\n'), false);
+});
+
+test('isEmail rejects non-ASCII addresses', () => {
+  assert.strictEqual(isEmail('ädа@example.com'), false);
+  assert.strictEqual(isEmail('ada@exämple.com'), false);
+});
+
+test('isEmail enforces the length limits', () => {
+  assert.strictEqual(isEmail('a'.repeat(64) + '@example.com'), true);
+  assert.strictEqual(isEmail('a'.repeat(65) + '@example.com'), false);
+  const longDomain = 'a'.repeat(63) + '.' + 'b'.repeat(63) + '.' + 'c'.repeat(63) + '.com';
+  assert.strictEqual(isEmail('a'.repeat(64) + '@' + longDomain), false);
+});
+
+test('isEmail throws a TypeError for a non-string', () => {
+  assert.throws(() => isEmail(null), TypeError);
+  assert.throws(() => isEmail(42), TypeError);
+  assert.throws(() => isEmail(undefined), TypeError);
+});
