+    assert.strictEqual(isIsoCurrency(code), true, code);
+  }
+});
+
+test('isIsoCurrency rejects lower-case codes', () => {
+  assert.strictEqual(isIsoCurrency('usd'), false);
+  assert.strictEqual(isIsoCurrency('Usd'), false);
+});
+
+test('isIsoCurrency rejects codes that are not on the list, even if they are real', () => {
+  assert.strictEqual(isIsoCurrency('XYZ'), false);
+  assert.strictEqual(isIsoCurrency('BTC'), false); // not an ISO 4217 code
+  assert.strictEqual(isIsoCurrency('TRY'), false); // real, but not on the short list
+});
+
+test('isIsoCurrency rejects spaces, and codes of the wrong length', () => {
