+ * @throws {TypeError} if a or b is not an array
+ */
+exports.zip = (a, b) => {
+  if (!Array.isArray(a)) throw new TypeError(`zip expects an array, got ${typeof a}`);
+  if (!Array.isArray(b)) throw new TypeError(`zip expects an array, got ${typeof b}`);
+  const length = Math.min(a.length, b.length);
+  return Array.from({ length }, (_, i) => [a[i], b[i]]);
+};
+
+/**
+ * Splits items into two arrays in one pass: those that pred accepts, and the rest. Both keep the original order.
+ * The input is not changed.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => boolean} pred
+ * @returns {[T[], T[]]} [matching, notMatching]
+ * @throws {TypeError} if xs is not an array or pred is not a function
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError(`partition expects an array, got ${typeof xs}`);
+  if (typeof pred !== 'function') throw new TypeError(`partition expects a predicate function, got ${typeof pred}`);
+  const matching = [];
+  const notMatching = [];
+  for (const item of xs) (pred(item) ? matching : notMatching).push(item);
+  return [matching, notMatching];
+};
+
+/**
+ * Counts the items in each group, where keyFn gives each item's group key. Keys are used as object keys, as in groupBy,
+ * so 1 and "1" are the same group. The input is not changed.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => PropertyKey} keyFn
+ * @returns {Record<string, number>} the count for each key, or {} for an empty array
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.countBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError(`countBy expects an array, got ${typeof xs}`);
+  if (typeof keyFn !== 'function') throw new TypeError(`countBy expects a key function, got ${typeof keyFn}`);
+  const counts = {};
+  for (const item of xs) {
+    const key = keyFn(item);
+    // defineProperty, not assignment, so a key like "__proto__" becomes an ordinary property.
+    if (!Object.hasOwn(counts, key)) Object.defineProperty(counts, key, { value: 0, enumerable: true, writable: true, configurable: true });
+    counts[key] += 1;
+  }
