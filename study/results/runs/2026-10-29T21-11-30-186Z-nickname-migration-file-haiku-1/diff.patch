+  if (typeof text !== 'string') throw new TypeError(`stripTags expects a string, got ${typeof text}`);
+  return text.replace(HTML_COMMENT, '').replace(HTML_SCRIPT_OR_STYLE, '').replace(HTML_TAG, '');
+};
+
+/**
+ * The Levenshtein edit distance: the fewest single-character insertions, deletions and substitutions that turn a into
+ * b. Characters are Unicode code points, so an emoji counts as one. The comparison is case-sensitive.
+ * @param {string} a
