+// user field -> database column
+const COLUMNS = { id: 'id', email: 'email', fullName: 'fullname', createdAt: 'created_at', lastLogin: 'last_login', nickname: 'nickname' };
+
+// Accepts a full or partial user; only the fields that are defined end up in the row.
+const toRow = (user) => {
+  const row = {};
+  for (const [field, column] of Object.entries(COLUMNS)) if (user[field] !== undefined) row[column] = user[field];
+  return row;
+};
+
+const fromRow = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null, nickname: r.nickname ?? null });
+
+const assertDb = (db) => {
+  if (db === undefined || db === null) throw new Error('Missing db: a database is required');
+};
+
+const assertName = (value, field) => {
+  if (typeof value !== 'string' || value.trim() === '' || value.length > 100) {
+    throw new Error(`Invalid ${field}: must be a non-empty string of at most 100 characters`);
+  }
 };
 
+const assertFullName = (fullName) => assertName(fullName, 'fullName');
+
+/**
+ * Inserts a user with a caller-supplied id and timestamps (createUser generates them; CSV import supplies them).
+ * @param {object} db
+ * @param {{id: string, email: string, fullName: string, createdAt: string, lastLogin?: string|null}} user
+ * @returns {User} the stored user
+ * @throws {Error} if db is missing, the email lacks "@" or is already taken (ignoring case),
+ *   fullName is invalid, id is empty or already taken, or createdAt is not a date string
+ */
+exports.restoreUser = (db, { id, email, fullName, createdAt, lastLogin, nickname } = {}) => {
+  assertDb(db);
+  if (typeof email !== 'string' || !email.includes('@')) throw new Error('Invalid email: missing "@"');
+  assertFullName(fullName);
+  if (nickname !== undefined && nickname !== null) assertName(nickname, 'nickname');
+  if (typeof id !== 'string' || id === '') throw new Error('Invalid id: must be a non-empty string');
+  if (typeof createdAt !== 'string' || Number.isNaN(Date.parse(createdAt))) throw new Error('Invalid createdAt: must be a date string');
+  if (exports.getUserByEmail(db, email)) throw new Error(`Duplicate email: ${email}`);
+  if (exports.getUser(db, id)) throw new Error(`Duplicate id: ${id}`);
+  db.insert('users', toRow({ id, email, fullName, createdAt, lastLogin: lastLogin ?? undefined, nickname: nickname ?? undefined }));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Creates a user with a generated id and the current time as createdAt.
+ * @param {object} db
+ * @param {{email: string, fullName: string}} fields fullName must be a non-empty string of at most 100 characters
+ * @returns {User} the stored user
+ * @throws {Error} if db is missing, the email lacks "@" or is already taken (ignoring case), or fullName is invalid
+ */
+exports.createUser = (db, { email, fullName, nickname } = {}) => {
+  assertDb(db);
+  return exports.restoreUser(db, { id: crypto.randomUUID(), email, fullName, createdAt: new Date().toISOString(), nickname });
+};
+
+/**
+ * Looks a user up by id.
+ * @param {object} db
+ * @param {string} id
+ * @returns {User|null} the user, or null if there is none
+ * @throws {Error} if db is missing
+ */
 exports.getUser = (db, id) => {
+  assertDb(db);
   const r = db.find('users', (u) => u.id === id);
-  if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return r ? fromRow(r) : null;
+};
+
+/**
+ * Looks a user up by email, ignoring case.
+ * @param {object} db
+ * @param {string} email
+ * @returns {User|null} the user, or null if there is none or email is not a string
+ * @throws {Error} if db is missing
+ */
+exports.getUserByEmail = (db, email) => {
+  assertDb(db);
+  if (typeof email !== 'string') return null;
+  const target = email.toLowerCase();
+  const r = db.find('users', (u) => typeof u.email === 'string' && u.email.toLowerCase() === target);
+  return r ? fromRow(r) : null;
+};
+
+/**
+ * Lists users sorted by createdAt, oldest first.
+ * @param {object} db
+ * @param {{limit?: number, offset?: number}} [page] limit defaults to no limit, offset to 0;
+ *   both must be non-negative integers
+ * @returns {User[]}
+ * @throws {Error} if db is missing or limit/offset is invalid
+ */
+exports.listUsers = (db, { limit, offset = 0 } = {}) => {
+  assertDb(db);
+  if (!Number.isInteger(offset) || offset < 0) throw new Error('Invalid offset: must be a non-negative integer');
+  if (limit !== undefined && (!Number.isInteger(limit) || limit < 0)) throw new Error('Invalid limit: must be a non-negative integer');
+  const sorted = db.all('users').map(fromRow).sort((a, b) => (a.createdAt < b.createdAt ? -1 : a.createdAt > b.createdAt ? 1 : 0));
+  return sorted.slice(offset, limit === undefined ? undefined : offset + limit);
+};
+
+/**
+ * Counts all users.
+ * @param {object} db
+ * @returns {number}
+ * @throws {Error} if db is missing
+ */
+exports.countUsers = (db) => {
+  assertDb(db);
+  return db.all('users').length;
+};
+
+/**
+ * Sets a user's lastLogin.
+ * @param {object} db
+ * @param {string} id
+ * @param {string} [when] ISO timestamp; defaults to now
+ * @returns {User|null} the updated user, or null if there is no such user
+ * @throws {Error} if db is missing
+ */
+exports.recordLogin = (db, id, when = new Date().toISOString()) => {
+  assertDb(db);
+  if (!db.update('users', (u) => u.id === id, toRow({ lastLogin: when }))) return null;
+  return exports.getUser(db, id);
+};
+
+/**
+ * Changes only the fields given; fields left undefined are kept. Validation matches createUser, except that
+ * a user may change the case of their own email. Nothing is written if validation fails.
+ * @param {object} db
+ * @param {string} id
+ * @param {{email?: string, fullName?: string}} [changes]
+ * @returns {User|null} the updated user, or null if there is no such user
+ * @throws {Error} if db is missing or a given field is invalid or duplicates another user's email
+ */
+exports.updateUser = (db, id, { email, fullName } = {}) => {
+  assertDb(db);
+  if (!exports.getUser(db, id)) return null;
+  if (email !== undefined) {
+    if (typeof email !== 'string' || !email.includes('@')) throw new Error('Invalid email: missing "@"');
+    const other = exports.getUserByEmail(db, email);
+    if (other && other.id !== id) throw new Error(`Duplicate email: ${email}`);
+  }
+  if (fullName !== undefined) assertFullName(fullName);
+  const changes = toRow({ email, fullName });
+  if (Object.keys(changes).length) db.update('users', (u) => u.id === id, changes);
+  return exports.getUser(db, id);
+};
+
+/**
+ * Removes a user.
+ * @param {object} db
+ * @param {string} id
+ * @returns {boolean} true if a user was removed, false if there was no such user
+ * @throws {Error} if db is missing
+ */
+exports.deleteUser = (db, id) => {
+  assertDb(db);
+  return db.remove('users', (u) => u.id === id) > 0;
+};
+
+/**
+ * Finds users whose fullName or email contains query, ignoring case. An empty query matches everyone.
+ * @param {object} db
+ * @param {string} query
+ * @returns {User[]} matches, oldest first; empty if query is not a string
+ * @throws {Error} if db is missing
+ */
+exports.searchUsers = (db, query) => {
+  assertDb(db);
+  if (typeof query !== 'string') return [];
+  const q = query.toLowerCase();
+  const has = (s) => typeof s === 'string' && s.toLowerCase().includes(q);
+  return exports.listUsers(db).filter((u) => has(u.fullName) || has(u.email));
 };
