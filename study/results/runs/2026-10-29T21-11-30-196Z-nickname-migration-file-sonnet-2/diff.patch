+/**
+ * Returns a new Date n calendar days after date (before it, if n is negative), in the local time zone: the
+ * time of day stays the same across daylight-saving changes, so noon plus one day is noon the next day even if
+ * that day is 23 or 25 hours long. Month, year and leap-day boundaries are handled (Jan 31 + 1 is Feb 1,
+ * Feb 28 2024 + 1 is Feb 29). If the local time of day does not exist on the target day (it falls in the hour
+ * a clock skips forward), the result is moved forward like the Date constructor does. n = 0 gives a copy.
+ * The date passed in is not modified.
+ * @param {Date} date
+ * @param {number} n a whole number of days, positive, negative or zero
+ * @returns {Date}
+ * @throws {TypeError} if date is not a Date or n is not a number
+ * @throws {RangeError} if date is an invalid Date, n is not a whole number (fractions, NaN, the infinities),
+ *   or the result is beyond the range Date can hold (about 273,000 years either side of 1970)
+ */
+exports.addDays = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError('addDays expects date to be a Date');
+  if (typeof n !== 'number') throw new TypeError('addDays expects n to be a number');
+  if (Number.isNaN(date.getTime())) throw new RangeError('addDays expects date to be a valid Date');
+  if (!Number.isInteger(n)) throw new RangeError('addDays expects n to be a whole number');
+  const result = new Date(date.getTime());
+  result.setDate(result.getDate() + n);
+  if (Number.isNaN(result.getTime())) throw new RangeError('addDays result is outside the range of dates');
+  return result;
+};
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+/**
+ * The number of whole days from a to b, counted on the UTC calendar and ignoring the time of day: it is how many
+ * midnights (UTC) lie between the two dates, so 23:59 on one day and 00:01 on the next are 1 day apart, while
+ * 00:01 and 23:59 on the same day are 0. The result is positive when b is after a, negative when b is before a,
+ * and 0 for the same UTC day. The local time zone plays no part, so the answer does not change with daylight
+ * saving or with where the code runs. Neither date is modified.
+ * @param {Date} a start
+ * @param {Date} b end
+ * @returns {number} a whole number of days (never -0)
+ * @throws {TypeError} if a or b is not a Date
+ * @throws {RangeError} if a or b is an invalid Date
+ */
+exports.daysBetween = (a, b) => {
+  for (const [name, value] of [['a', a], ['b', b]]) {
+    if (!(value instanceof Date)) throw new TypeError(`daysBetween expects ${name} to be a Date`);
+  }
+  for (const [name, value] of [['a', a], ['b', b]]) {
+    if (Number.isNaN(value.getTime())) throw new RangeError(`daysBetween expects ${name} to be a valid Date`);
+  }
+  // The UTC day number is the milliseconds since 1970 divided by a day, rounded down (so before 1970 it counts back correctly).
+  return Math.floor(b.getTime() / MS_PER_DAY) - Math.floor(a.getTime() / MS_PER_DAY);
+};
+
+/**
+ * Whether a date falls on a Saturday or Sunday, on the UTC calendar: the time zone the code runs in plays no
+ * part, so 23:30 on a Friday in UTC is not a weekend even where it is already Saturday locally, and the answer
+ * does not change with daylight saving. A day runs from 00:00:00.000 to 23:59:59.999 UTC. The date is not modified.
+ * @param {Date} date
+ * @returns {boolean}
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is an invalid Date
+ */
+exports.isWeekend = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('isWeekend expects date to be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('isWeekend expects date to be a valid Date');
