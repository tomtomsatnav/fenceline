+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+const { listUsers, countUsers } = require('../src/api/users.js');
+
+const insert = (db, id, email, fullname, created_at, last_login) =>
+  db.insert('users', { id, email, fullname, created_at, ...(last_login ? { last_login } : {}) });
+
+test('exportUsersCsv with no users is just the header', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), 'id,email,fullName,createdAt,lastLogin');
+});
+
+test('exportUsersCsv writes one row per user, oldest first, with empty lastLogin as blank', () => {
+  const db = migrate(new Db());
+  insert(db, 'b', 'b@example.com', 'Bea', '2024-02-01T00:00:00.000Z', '2024-05-01T00:00:00.000Z');
+  insert(db, 'a', 'a@example.com', 'Ann', '2024-01-01T00:00:00.000Z');
+  assert.strictEqual(
+    exportUsersCsv(db),
+    [
+      'id,email,fullName,createdAt,lastLogin',
+      'a,a@example.com,Ann,2024-01-01T00:00:00.000Z,',
+      'b,b@example.com,Bea,2024-02-01T00:00:00.000Z,2024-05-01T00:00:00.000Z',
+    ].join('\n'),
+  );
+});
+
+test('exportUsersCsv quotes fields containing commas, quotes or newlines', () => {
+  const db = migrate(new Db());
+  insert(db, 'a', 'a@example.com', 'Lovelace, Ada', '2024-01-01T00:00:00.000Z');
+  insert(db, 'b', 'b@example.com', 'Bea "B" Smith', '2024-01-02T00:00:00.000Z');
+  insert(db, 'c', 'c@example.com', 'Line\nBreak', '2024-01-03T00:00:00.000Z');
+  const lines = exportUsersCsv(db).split('\n');
+  assert.strictEqual(lines[1], 'a,a@example.com,"Lovelace, Ada",2024-01-01T00:00:00.000Z,');
+  assert.strictEqual(lines[2], 'b,b@example.com,"Bea ""B"" Smith",2024-01-02T00:00:00.000Z,');
+  assert.strictEqual(lines.slice(3).join('\n'), 'c,c@example.com,"Line\nBreak",2024-01-03T00:00:00.000Z,');
+});
+
+test('exportUsersCsv throws when db is missing', () => {
+  assert.throws(() => exportUsersCsv(undefined), /Missing db/);
+});
+
+test('importUsersCsv round-trips exportUsersCsv, preserving ids, timestamps and awkward names', () => {
+  const source = migrate(new Db());
+  insert(source, 'a', 'a@example.com', 'Lovelace, Ada', '2024-01-01T00:00:00.000Z', '2024-06-01T00:00:00.000Z');
+  insert(source, 'b', 'b@example.com', 'Bea "B" Smith', '2024-01-02T00:00:00.000Z');
+  insert(source, 'c', 'c@example.com', 'Line\nBreak', '2024-01-03T00:00:00.000Z');
+  insert(source, 'd', 'd@example.com', ' padded , "mix"\r\nend ', '2024-01-04T00:00:00.000Z');
+  const csv = exportUsersCsv(source);
+
+  const target = migrate(new Db());
+  const imported = importUsersCsv(target, csv);
+  assert.deepStrictEqual(imported, listUsers(source));
+  assert.deepStrictEqual(listUsers(target), listUsers(source));
+  assert.strictEqual(exportUsersCsv(target), csv);
+});
+
+test('importUsersCsv of an empty export imports nothing', () => {
+  const db = migrate(new Db());
+  assert.deepStrictEqual(importUsersCsv(db, exportUsersCsv(migrate(new Db()))), []);
+  assert.strictEqual(countUsers(db), 0);
+});
+
+test('importUsersCsv accepts CRLF line endings and a trailing newline', () => {
+  const db = migrate(new Db());
+  const csv = 'id,email,fullName,createdAt,lastLogin\r\na,a@example.com,Ann,2024-01-01T00:00:00.000Z,\r\n';
+  assert.strictEqual(importUsersCsv(db, csv).length, 1);
+  assert.strictEqual(listUsers(db)[0].lastLogin, null);
+});
+
+test('importUsersCsv rejects a wrong header', () => {
+  const db = migrate(new Db());
+  assert.throws(() => importUsersCsv(db, 'id,email\na,a@example.com'), /header/);
+  assert.throws(() => importUsersCsv(db, ''), /header/);
+});
+
+test('importUsersCsv is all-or-nothing and names the failing row', () => {
+  const db = migrate(new Db());
+  const header = 'id,email,fullName,createdAt,lastLogin';
+  const good = 'a,a@example.com,Ann,2024-01-01T00:00:00.000Z,';
+  assert.throws(() => importUsersCsv(db, [header, good, 'b,not-an-email,Bea,2024-01-02T00:00:00.000Z,'].join('\n')), /row 3.*email/);
+  assert.throws(() => importUsersCsv(db, [header, good, 'b,b@example.com,Bea'].join('\n')), /row 3.*fields/);
+  assert.throws(() => importUsersCsv(db, [header, good, 'b,A@example.com,Bea,2024-01-02T00:00:00.000Z,'].join('\n')), /row 3.*Duplicate email/);
+  assert.throws(() => importUsersCsv(db, [header, good, 'a,b@example.com,Bea,2024-01-02T00:00:00.000Z,'].join('\n')), /row 3.*Duplicate id/);
+  assert.throws(() => importUsersCsv(db, [header, good, 'b,b@example.com,"Bea,2024-01-02T00:00:00.000Z,'].join('\n')), /unterminated/);
+  assert.strictEqual(countUsers(db), 0);
+});
+
+test('importUsersCsv does not touch users that already exist when a row fails', () => {
+  const db = migrate(new Db());
+  insert(db, 'x', 'x@example.com', 'Xavier', '2023-01-01T00:00:00.000Z');
+  assert.throws(() => importUsersCsv(db, 'id,email,fullName,createdAt,lastLogin\ny,y@example.com,,2024-01-01T00:00:00.000Z,'), /fullName/);
+  assert.deepStrictEqual(listUsers(db).map((u) => u.id), ['x']);
+});
+
+test('importUsersCsv validates its arguments', () => {
+  assert.throws(() => importUsersCsv(undefined, 'x'), /Missing db/);
+  assert.throws(() => importUsersCsv(migrate(new Db()), 42), /csv/);
+});
