+/**
+ * The name to show for a user: their fullName, or the part of the email before "@" when fullName is
+ * empty, whitespace-only or missing.
+ * @param {{fullName?: string|null, email: string}} user
+ * @returns {string}
+ */
+exports.displayName = (user) => {
+  const { fullName, email } = user;
+  if (typeof fullName === 'string' && fullName.trim() !== '') return fullName;
+  return email.split('@')[0];
+};
