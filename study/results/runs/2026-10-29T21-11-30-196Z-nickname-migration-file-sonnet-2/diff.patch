+ * NaN, since there is nothing to average. The sum is compensated for rounding error, so
+ * mean([0.1, 0.2, 0.3]) is exactly 0.2 (a plain running total gives 0.20000000000000004), and it does not
+ * overflow when the true mean fits: mean([Number.MAX_VALUE, Number.MAX_VALUE]) is Number.MAX_VALUE. A NaN
+ * item gives NaN, and infinities follow the usual rules (Infinity with finite numbers gives Infinity;
+ * Infinity with -Infinity gives NaN). The input is not modified.
+ * @param {number[]} xs
+ * @returns {number}
+ * @throws {TypeError} if xs is not an array or any item is not a number (the message gives its position)
+ */
+exports.mean = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('mean expects an array');
+  let finite = true;
+  let min = Infinity;
+  let max = -Infinity;
+  for (let i = 0; i < xs.length; i++) {
