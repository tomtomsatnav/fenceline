+ */
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep expects an array');
+  const out = [];
+  const open = new Set([xs]); // the arrays on the path from xs to the one being read, to detect cycles
+  const stack = [{ array: xs, i: 0 }];
+  while (stack.length) {
+    const frame = stack[stack.length - 1];
+    if (frame.i >= frame.array.length) {
+      open.delete(frame.array);
+      stack.pop();
+      continue;
+    }
+    const index = frame.i++;
+    if (!(index in frame.array)) continue;
+    const item = frame.array[index];
+    if (!Array.isArray(item)) {
+      out.push(item);
+    } else if (open.has(item)) {
+      throw new TypeError('flattenDeep cannot flatten an array that contains itself');
+    } else {
+      open.add(item);
+      stack.push({ array: item, i: 0 });
+    }
+  }
+  return out;
+};
+
+// Where a key sorts: numbers, strings, booleans, then null, NaN and undefined. Returns [rank, comparable value].
+const sortKey = (key) => {
+  const value = key instanceof Date ? key.getTime() : key;
+  switch (typeof value) {
+    case 'number': return Number.isNaN(value) ? [4, 0] : [0, value];
+    case 'bigint': return [0, value];
+    case 'string': return [1, value];
+    case 'boolean': return [2, value];
+    case 'undefined': return [5, 0];
+    default:
+      if (value === null) return [3, 0];
+      throw new TypeError('sortBy keys must be numbers, bigints, strings, booleans, dates, null or undefined');
+  }
+};
+
+/**
+ * Returns a new array of the items sorted by key, ascending. The sort is stable: items with equal keys stay in
+ * their original order. To sort descending, negate a numeric key, or reverse the result of a sort that has no
+ * ties. Keys are ordered by type first: numbers, bigints and dates (compared by value, together), then
+ * strings, then booleans (false before true), then null, then NaN (and invalid dates), then undefined. Within a
+ * type, strings compare by UTF-16 code units, so "B" comes before "a"; lowercase the key for a
+ * case-insensitive sort. -0 and 0 are equal. Any other key (objects, symbols, functions) is an error.
+ * keyFn is called once per item, in order, with the item only; holes in sparse arrays are visited as undefined.
+ * The input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => unknown} keyFn
+ * @returns {T[]} a new array; [] for an empty array
+ * @throws {TypeError} if xs is not an array, keyFn is not a function, or keyFn returns a key of an
+ *   unsupported type (checked for every item, even in an array of one)
+ */
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('sortBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('sortBy expects keyFn to be a function');
+  const entries = [];
+  for (const item of xs) {
+    const [rank, value] = sortKey(keyFn(item));
+    entries.push({ item, index: entries.length, rank, value });
+  }
+  entries.sort((a, b) => {
+    if (a.rank !== b.rank) return a.rank - b.rank;
+    if (a.rank <= 2) {
+      if (a.value < b.value) return -1;
+      if (a.value > b.value) return 1;
+    }
+    return a.index - b.index; // equal keys keep their original order
+  });
+  return entries.map((entry) => entry.item);
+};
+
+/**
+ * Picks one item at random, each position equally likely. rng is called once, with no arguments, and must
+ * return a number from 0 up to but not including 1, like Math.random; pass a seeded generator for repeatable
+ * picks. An empty array gives undefined, and rng is not called. A hole in a sparse array can be picked and
+ * gives undefined. The input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {() => number} [rng] defaults to Math.random
+ * @returns {T|undefined}
+ * @throws {TypeError} if xs is not an array or rng is not a function
+ * @throws {RangeError} if rng returns anything but a number in [0, 1)
+ */
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new TypeError('sample expects an array');
+  if (typeof rng !== 'function') throw new TypeError('sample expects rng to be a function');
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new RangeError('sample expects rng to return a number from 0 up to but not including 1');
+  return xs[Math.floor(r * xs.length)];
+};
+
+/**
+ * Every run of n consecutive items, as a sliding window that moves one item at a time:
+ * windowed([1, 2, 3, 4], 2) is [[1, 2], [2, 3], [3, 4]]. Windows overlap, so each item appears in up to n of
+ * them. If n is larger than the array (including Infinity) there is no complete window and the result is [].
+ * The input is not modified and the windows are new arrays, though the items in them are the same objects.
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n window length; a positive integer, or Infinity
+ * @returns {T[][]} xs.length - n + 1 windows, or [] if there are none
+ * @throws {TypeError} if xs is not an array or n is not a number
+ * @throws {RangeError} if n is less than 1, NaN or not an integer
+ */
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed expects an array');
+  if (typeof n !== 'number') throw new TypeError('windowed expects n to be a number');
+  if (Number.isNaN(n) || n < 1 || (n !== Infinity && !Number.isInteger(n))) {
+    throw new RangeError('windowed expects n to be a positive integer');
+  }
+  const windows = [];
+  for (let i = 0; i + n <= xs.length; i++) windows.push(xs.slice(i, i + n));
+  return windows;
+};
