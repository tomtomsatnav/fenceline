+
+/**
+ * The start of the week that contains date, with weeks running Monday to Sunday: Monday at 00:00:00.000 UTC.
+ * Everything is on the UTC calendar, so the local time zone and daylight saving play no part. A Monday gives its
+ * own midnight, and a Sunday belongs to the week that began six days earlier. The result is a new Date; the date
+ * passed in is not modified.
+ * @param {Date} date
+ * @returns {Date}
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is an invalid Date, or its week starts before the earliest date a Date can hold
+ *   (the first six days of the range, from 20 April 271821 BC, a Tuesday, through its Sunday)
+ */
+exports.startOfWeek = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('startOfWeek expects date to be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('startOfWeek expects date to be a valid Date');
