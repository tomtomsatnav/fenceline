+  assert.strictEqual(wrap('aa bb cc\ndd ee', 5), 'aa bb\ncc\ndd ee');
+  assert.strictEqual(wrap('first paragraph\n\nsecond paragraph', 9), 'first\nparagraph\n\nsecond\nparagraph');
+  assert.strictEqual(wrap('trailing\n', 80), 'trailing\n');
+  assert.strictEqual(wrap('\nleading', 80), '\nleading');
+});
+
+test('wrap normalises \\r\\n to \\n', () => {
+  assert.strictEqual(wrap('aa bb\r\ncc dd', 80), 'aa bb\ncc dd');
+  assert.strictEqual(wrap('aa bb\r\n\r\ncc', 80), 'aa bb\n\ncc');
+});
+
+test('wrap returns "" for empty text and blank lines for whitespace-only lines', () => {
