diff --git a/README.md b/README.md
new file mode 100644
index 0000000..c83fc3d
--- /dev/null
+++ b/README.md
@@ -0,0 +1,46 @@
+## Users API
+
+Functions in `src/api/`. Every function that takes `db` throws an `Error` (`Missing db: …`) when `db` is `null` or `undefined`, before it looks at any other argument.
+
+A **user** looks like this:
+
+```js
+{ id, email, fullName, createdAt, lastLogin, nickname } // createdAt / lastLogin are ISO timestamps; lastLogin is null until a login is recorded; nickname is null when not set
+```
+
+### `src/api/users.js`
+
+```js
+const users = require('./src/api/users.js');
+```
+
+| Function | Returns | Notes |
+| --- | --- | --- |
+| `createUser(db, { email, fullName, nickname? })` | the new user | Generates the id and `createdAt`. Throws if the email has no `@`, if the email is already taken (compared case-insensitively), or if `fullName` (or `nickname`, when given) is not a non-empty string of at most 100 characters (whitespace-only counts as empty). Storing a nickname needs a `nickname` column in the `users` table. |
+| `restoreUser(db, { id, email, fullName, createdAt, lastLogin? })` | the stored user | Like `createUser`, but keeps the id and timestamps you supply. Also throws on an empty or duplicate `id`, or a `createdAt` that is not a date string. Used by CSV import. |
+| `getUser(db, id)` | user or `null` | |
+| `getUserByEmail(db, email)` | user or `null` | Case-insensitive. A non-string `email` gives `null`. |
+| `listUsers(db, { limit?, offset? })` | array of users | Oldest `createdAt` first. With no options, returns everyone. `offset` defaults to 0; `limit` has no default. Both must be non-negative integers, otherwise it throws. |
+| `countUsers(db)` | number | |
+| `searchUsers(db, query)` | array of users | Users whose `fullName` or `email` contains `query`, case-insensitively, oldest first. An empty `query` matches everyone; a non-string `query` gives `[]`. |
+| `recordLogin(db, id, when?)` | updated user or `null` | Sets `lastLogin`. `when` is an ISO timestamp and defaults to now. `null` if there is no such user. |
+| `updateUser(db, id, { email?, fullName? })` | updated user or `null` | Changes only the fields you pass. Same validation as `createUser`, except a user may change the case of their own email. Nothing is written if validation fails. `null` if there is no such user. |
+| `deleteUser(db, id)` | `true` or `false` | `false` if there was no such user. |
+
+### `src/api/format.js`
+
+| Function | Returns | Notes |
+| --- | --- | --- |
+| `displayName(user)` | string | `user.fullName`, or the part of `user.email` before the first `@` when `fullName` is empty, whitespace-only or missing. |
+
+### `src/api/export.js`
+
+| Function | Returns | Notes |
+| --- | --- | --- |
+| `exportUsersCsv(db)` | CSV string | Header row `id,email,fullName,createdAt,lastLogin`, then one row per user, oldest first. Fields containing commas, quotes or line breaks are quoted (quotes doubled). A `null` `lastLogin` is blank. Rows are joined with `\n`, with no trailing newline. |
+| `importUsersCsv(db, csv)` | array of imported users | Inverse of `exportUsersCsv`: restores each user with its original id and timestamps. Accepts `\n` or `\r\n` line endings and a trailing newline. Throws if the header is wrong or a row is invalid; the message names the CSV row (for example `Import failed at CSV row 3: …`). All-or-nothing: users already imported from that CSV are removed when a row fails. |
+
+Notes:
+
+- The duplicate-email check is made in application code, not by a database constraint.
+- `exportUsersCsv` does not guard against spreadsheet formula injection: a name starting with `=`, `+`, `-` or `@` is written as-is.
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..403e16b
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,77 @@
+const { listUsers, restoreUser, deleteUser } = require('./users.js');
+
+const FIELDS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+const csvField = (value) => {
+  const s = value === null || value === undefined ? '' : String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * Exports every user as CSV: a header row (id,email,fullName,createdAt,lastLogin) plus one row per user,
+ * oldest first. Fields containing commas, quotes or line breaks are quoted; a null lastLogin is blank.
+ * Rows are joined with "\n", with no trailing newline.
+ * @param {object} db
+ * @returns {string}
+ * @throws {Error} if db is missing
+ */
+exports.exportUsersCsv = (db) => {
+  const rows = listUsers(db).map((u) => FIELDS.map((f) => csvField(u[f])).join(','));
+  return [FIELDS.join(','), ...rows].join('\n');
+};
+
+// RFC 4180-style parser: quoted fields may contain commas, doubled quotes and line breaks; rows end in \n or \r\n.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c !== '"') field += c;
+      else if (text[i + 1] === '"') { field += '"'; i++; }
+      else quoted = false;
+    } else if (c === '"' && field === '') quoted = true;
+    else if (c === ',') { row.push(field); field = ''; }
+    else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      row.push(field);
+      field = '';
+      rows.push(row);
+      row = [];
+    } else field += c;
+  }
+  if (quoted) throw new Error('Invalid CSV: unterminated quoted field');
+  if (field !== '' || row.length) { row.push(field); rows.push(row); }
+  return rows.filter((r) => !(r.length === 1 && r[0] === ''));
+};
+
+/**
+ * Inverse of exportUsersCsv: restores each user with its original id and timestamps.
+ * All-or-nothing: if any row is invalid, the users already imported from this CSV are removed.
+ * @param {object} db
+ * @param {string} csv
+ * @returns {import('./users.js').User[]} the imported users
+ * @throws {Error} if db is missing, csv is not a string or has the wrong header, or a row is invalid
+ *   (the message names the CSV row)
+ */
+exports.importUsersCsv = (db, csv) => {
+  listUsers(db); // throws if db is missing
+  if (typeof csv !== 'string') throw new Error('Invalid csv: must be a string');
+  const [header, ...rows] = parseCsv(csv);
+  if (!header || header.join(',') !== FIELDS.join(',')) throw new Error(`Invalid CSV header: expected ${FIELDS.join(',')}`);
+  const imported = [];
+  try {
+    for (const cells of rows) {
+      if (cells.length !== FIELDS.length) throw new Error(`expected ${FIELDS.length} fields but found ${cells.length}`);
+      const [id, email, fullName, createdAt, lastLogin] = cells;
+      imported.push(restoreUser(db, { id, email, fullName, createdAt, lastLogin: lastLogin === '' ? null : lastLogin }));
+    }
+  } catch (err) {
+    for (const u of imported) deleteUser(db, u.id);
+    const row = imported.length + 2; // 1-based, counting the header
+    throw new Error(`Import failed at CSV row ${row}: ${err.message}`);
+  }
+  return imported;
+};
