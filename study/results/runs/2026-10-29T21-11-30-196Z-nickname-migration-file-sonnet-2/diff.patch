+/**
+ * Limits x to the range from lo to hi, both included: lo if x is below it, hi if x is above it, otherwise x
+ * itself. The bounds may be infinite (clamp(x, 0, Infinity) only sets a floor), and lo may equal hi. A NaN x
+ * is returned as NaN, since it is not in any range.
+ * @param {number} x
+ * @param {number} lo lower bound
+ * @param {number} hi upper bound, not below lo
+ * @returns {number}
+ * @throws {TypeError} if x, lo or hi is not a number
+ * @throws {RangeError} if lo or hi is NaN, or lo is greater than hi
+ */
+exports.clamp = (x, lo, hi) => {
+  for (const [name, value] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof value !== 'number') throw new TypeError(`clamp expects ${name} to be a number`);
+  }
+  if (Number.isNaN(lo) || Number.isNaN(hi)) throw new RangeError('clamp expects lo and hi not to be NaN');
+  if (lo > hi) throw new RangeError('clamp expects lo not to be greater than hi');
+  if (x < lo) return lo;
+  if (x > hi) return hi;
+  return x;
+};
+
+/**
+ * Rounds x to the given number of decimal places, with halves rounding away from zero: roundTo(2.5, 0) is 3,
+ * roundTo(-2.5, 0) is -3 and roundTo(1.005, 2) is 1.01. The rounding is done on the decimal digits JavaScript
+ * prints for x (its shortest round-trip form), not the binary value behind them, so what you see is what is
+ * rounded; the closest binary value to 1.005 is slightly below it, which Math.round(1.005 * 100) / 100 gets
+ * wrong. Negative places round to tens, hundreds and so on: roundTo(1250, -2) is 1300. A value with no more
+ * than `places` decimals comes back unchanged. NaN and the infinities come back unchanged, and the result is
+ * never -0. Rounding up past the largest finite number gives Infinity.
+ * @param {number} x
+ * @param {number} [places] a whole number, positive or negative; defaults to 0
+ * @returns {number}
+ * @throws {TypeError} if x or places is not a number
+ * @throws {RangeError} if places is not an integer (this includes NaN and the infinities)
+ */
+exports.roundTo = (x, places = 0) => {
+  if (typeof x !== 'number') throw new TypeError('roundTo expects x to be a number');
+  if (typeof places !== 'number') throw new TypeError('roundTo expects places to be a number');
+  if (!Number.isInteger(places)) throw new RangeError('roundTo expects places to be an integer');
+  if (!Number.isFinite(x) || x === 0) return x === 0 ? 0 : x;
+
+  // |x| is the integer `digits` divided by 10 ** scale, read straight from its printed form (1.25e-7 is 125 / 10 ** 9)
+  const [mantissa, exponent = '0'] = String(Math.abs(x)).split('e');
+  const [whole, fraction = ''] = mantissa.split('.');
+  const digits = (whole + fraction).replace(/^0+/, '');
+  const scale = fraction.length - Number(exponent);
+  if (scale <= places) return x; // nothing to round away
+  const drop = scale - places;
+  if (drop > digits.length) return 0; // |x| is below half of the unit being rounded to
+
+  const unit = 10n ** BigInt(drop);
+  let kept = BigInt(digits) / unit;
+  if ((BigInt(digits) % unit) * 2n >= unit) kept += 1n; // half or more rounds away from zero
+  if (kept === 0n) return 0;
+  return Math.sign(x) * Number(`${kept}e${-places}`);
+};
+
+// Neumaier's compensated sum of the items times scale: the rounding error of each addition is carried along
+// in `compensation`, so sum + compensation is the total to about twice the usual precision.
+const compensatedSum = (xs, scale = 1) => {
+  let sum = 0;
+  let compensation = 0;
+  for (const item of xs) {
+    const x = item * scale;
+    const t = sum + x;
+    compensation += Math.abs(sum) >= Math.abs(x) ? sum - t + x : x - t + sum;
+    sum = t;
+  }
+  return { sum, compensation };
+};
+
+/**
