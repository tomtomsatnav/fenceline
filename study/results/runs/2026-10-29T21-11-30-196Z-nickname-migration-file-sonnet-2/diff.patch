+ * not before, so someone born on 2000-06-15 is 23 on 2024-06-14 and 24 on 2024-06-15. Calendar days on the UTC
+ * calendar are compared and the time of day is ignored, so the local time zone plays no part. Someone born on
+ * 29 February has their birthday on 1 March in years that are not leap years (on 28 February they are still a
+ * year younger). The same day as the birth gives 0.
+ * @param {Date} birthDate
+ * @param {Date} date the day to work out the age on
+ * @returns {number} a whole number of years, 0 or more
+ * @throws {TypeError} if birthDate or date is not a Date
+ * @throws {RangeError} if either is an invalid Date, or date is on a day before birthDate
+ */
+exports.ageOn = (birthDate, date) => {
+  for (const [name, value] of [['birthDate', birthDate], ['date', date]]) {
+    if (!(value instanceof Date)) throw new TypeError(`ageOn expects ${name} to be a Date`);
+  }
+  for (const [name, value] of [['birthDate', birthDate], ['date', date]]) {
+    if (Number.isNaN(value.getTime())) throw new RangeError(`ageOn expects ${name} to be a valid Date`);
+  }
+  if (exports.daysBetween(birthDate, date) < 0) throw new RangeError('ageOn expects date not to be before birthDate');
+  // Whole years: the difference in years, less one if this year's birthday (same month and day) has not come yet.
+  const birthdayPassed = date.getUTCMonth() > birthDate.getUTCMonth()
+    || (date.getUTCMonth() === birthDate.getUTCMonth() && date.getUTCDate() >= birthDate.getUTCDate());
+  return date.getUTCFullYear() - birthDate.getUTCFullYear() - (birthdayPassed ? 0 : 1);
+};
+
+const SECOND = 1000;
+const MINUTE = 60 * SECOND;
+const HOUR = 60 * MINUTE;
+const DAY = 24 * HOUR;
+
+/**
+ * Describes how far date is from now in words: "3 minutes ago" for a date in the past, "in 2 days" for one in the
+ * future, and "just now" when they are less than a second apart. Only the largest unit is given, counting whole
+ * units (the rest is dropped, never rounded up), so 3 minutes 59 seconds is "3 minutes ago" and 1 hour 59
+ * minutes is "1 hour ago". The units, and where each begins:
+ *   seconds from 1 second, minutes from 60 seconds, hours from 60 minutes, days from 24 hours,
+ *   weeks from 7 days, months from 30 days (a month is 30 days; 11 months at most), years from 365 days.
+ * "1 minute" is singular, everything else plural ("0" never appears). Because months and years are fixed
+ * lengths, this is a rough description, not calendar arithmetic. Only the two moments matter, not any time zone.
+ * Neither date is modified.
+ * @param {Date} date the moment to describe
+ * @param {Date} [now] the moment to describe it from; defaults to the current time
+ * @returns {string} such as "just now", "1 second ago", "3 minutes ago", "in 2 days" or "in 1 year"
+ * @throws {TypeError} if date or now is not a Date
+ * @throws {RangeError} if date or now is an invalid Date
+ */
+exports.relativeTime = (date, now = new Date()) => {
+  for (const [name, value] of [['date', date], ['now', now]]) {
+    if (!(value instanceof Date)) throw new TypeError(`relativeTime expects ${name} to be a Date`);
+  }
+  for (const [name, value] of [['date', date], ['now', now]]) {
+    if (Number.isNaN(value.getTime())) throw new RangeError(`relativeTime expects ${name} to be a valid Date`);
+  }
+  const elapsed = now.getTime() - date.getTime(); // positive when date is in the past
+  const ms = Math.abs(elapsed);
+  if (ms < SECOND) return 'just now';
+
+  const days = Math.floor(ms / DAY);
+  let count;
+  let unit;
+  if (ms < MINUTE) [count, unit] = [Math.floor(ms / SECOND), 'second'];
+  else if (ms < HOUR) [count, unit] = [Math.floor(ms / MINUTE), 'minute'];
+  else if (ms < DAY) [count, unit] = [Math.floor(ms / HOUR), 'hour'];
+  else if (days < 7) [count, unit] = [days, 'day'];
+  else if (days < 30) [count, unit] = [Math.floor(days / 7), 'week'];
+  else if (days < 365) [count, unit] = [Math.min(11, Math.floor(days / 30)), 'month'];
+  else [count, unit] = [Math.floor(days / 365), 'year'];
+
+  const phrase = `${count} ${unit}${count === 1 ? '' : 's'}`;
+  return elapsed > 0 ? `${phrase} ago` : `in ${phrase}`;
+};
