+exports.formatIsoDate = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('formatIsoDate expects date to be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('formatIsoDate expects date to be a valid Date');
