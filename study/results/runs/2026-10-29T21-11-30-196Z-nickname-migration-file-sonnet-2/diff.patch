+const test = require('node:test');
+const assert = require('node:assert');
+const { displayName } = require('../src/api/format.js');
+
+test('displayName returns the fullName when present', () => {
+  assert.strictEqual(displayName({ fullName: 'Ada Lovelace', email: 'ada@example.com' }), 'Ada Lovelace');
+});
+
+test('displayName falls back to the part of the email before "@"', () => {
+  assert.strictEqual(displayName({ fullName: '', email: 'ada@example.com' }), 'ada');
+  assert.strictEqual(displayName({ fullName: '   ', email: 'grace@navy.mil' }), 'grace');
+  assert.strictEqual(displayName({ fullName: null, email: 'alan@example.com' }), 'alan');
+  assert.strictEqual(displayName({ email: 'linus@example.com' }), 'linus');
+});
+
+test('displayName uses only the text before the first "@"', () => {
+  assert.strictEqual(displayName({ fullName: '', email: 'odd@name@example.com' }), 'odd');
+});
