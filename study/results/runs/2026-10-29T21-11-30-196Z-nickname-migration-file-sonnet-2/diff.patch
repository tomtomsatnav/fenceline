+ * @property {string} id
+ * @property {string} email
+ * @property {string} fullName
+ * @property {string} createdAt ISO timestamp
+ * @property {string|null} lastLogin ISO timestamp, or null if the user has never logged in
+ * @property {string|null} nickname null if the user has none
+ */
+
