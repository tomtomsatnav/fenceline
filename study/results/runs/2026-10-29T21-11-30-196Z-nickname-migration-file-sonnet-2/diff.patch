index 0000000..99f41d9
--- /dev/null
+++ b/src/lib/arrays.js
@@ -0,0 +1,271 @@
+/**
+ * Splits an array into consecutive arrays of length n; the last one may be shorter. The input is not
+ * modified and the chunks are new arrays, though the items in them are the same objects.
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n chunk length; a positive integer, or Infinity for a single chunk
+ * @returns {T[][]} the chunks; [] for an empty array
+ * @throws {TypeError} if xs is not an array or n is not a number
+ * @throws {RangeError} if n is less than 1, NaN or not an integer
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk expects an array');
+  if (typeof n !== 'number') throw new TypeError('chunk expects n to be a number');
+  if (Number.isNaN(n) || n < 1 || (n !== Infinity && !Number.isInteger(n))) {
+    throw new RangeError('chunk expects n to be a positive integer');
+  }
+  const chunks = [];
+  for (let i = 0; i < xs.length; i += n) chunks.push(xs.slice(i, i + n));
+  return chunks;
+};
+
+/**
+ * Keeps the first item for each key, in the original order. Keys are compared like Set values (SameValueZero):
+ * primitives by value, with NaN equal to NaN and 0 equal to -0, and objects by identity. keyFn is called once
+ * per item, in order, with the item only. The input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => unknown} keyFn
+ * @returns {T[]} a new array; [] for an empty array
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('uniqueBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('uniqueBy expects keyFn to be a function');
+  const seen = new Set();
+  const out = [];
+  for (const item of xs) {
+    const key = keyFn(item);
+    if (seen.has(key)) continue;
+    seen.add(key);
+    out.push(item);
+  }
+  return out;
+};
+
+/**
+ * Groups items by the key keyFn gives them: { key: [items...] }, with the items of each group in their
+ * original order. Keys become property names the usual way (String, or the symbol itself), so 1 and "1" are
+ * the same group, undefined and null give the groups "undefined" and "null", and integer-like keys are listed
+ * first, in ascending order, whatever order they were found in. Any key is safe, including "__proto__" and
+ * "constructor". keyFn is called once per item, in order, with the item only. The input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => unknown} keyFn
+ * @returns {Record<string|symbol, T[]>} a new object; {} for an empty array
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy expects keyFn to be a function');
+  const groups = {};
+  for (const item of xs) {
+    const key = keyFn(item);
+    const name = typeof key === 'symbol' ? key : String(key);
+    // defineProperty, not assignment, so a key like "__proto__" makes a group instead of changing the prototype
+    if (!Object.hasOwn(groups, name)) Object.defineProperty(groups, name, { value: [], writable: true, enumerable: true, configurable: true });
+    groups[name].push(item);
+  }
+  return groups;
+};
+
+/**
+ * Splits an array in two by a predicate: the items pred is truthy for, and the rest. Both keep the original
+ * order. pred is called once per item, in order, with the item only. The input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => unknown} pred
+ * @returns {[T[], T[]]} [matching, notMatching], two new arrays; [[], []] for an empty array
+ * @throws {TypeError} if xs is not an array or pred is not a function
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition expects an array');
+  if (typeof pred !== 'function') throw new TypeError('partition expects pred to be a function');
+  const matching = [];
+  const notMatching = [];
+  for (const item of xs) (pred(item) ? matching : notMatching).push(item);
+  return [matching, notMatching];
+};
+
+/**
+ * Pairs up the items of two arrays by position, stopping at the end of the shorter one: the extra items of
+ * the longer array are dropped. Neither input is modified.
+ * @template A, B
+ * @param {A[]} a
+ * @param {B[]} b
+ * @returns {[A, B][]} a new array of new two-item arrays; [] if either input is empty
+ * @throws {TypeError} if a or b is not an array
+ */
+exports.zip = (a, b) => {
+  if (!Array.isArray(a)) throw new TypeError('zip expects a to be an array');
+  if (!Array.isArray(b)) throw new TypeError('zip expects b to be an array');
+  const length = Math.min(a.length, b.length);
+  const pairs = [];
+  for (let i = 0; i < length; i++) pairs.push([a[i], b[i]]);
+  return pairs;
+};
+
+const MAX_RANGE_LENGTH = 2 ** 32 - 1; // the longest array JavaScript allows
+
+/**
+ * The numbers from start up to but not including end, stepping by step: range(0, 5) is [0, 1, 2, 3, 4] and
+ * range(5, 0, -2) is [5, 3, 1]. The step must point from start toward end: a step in the wrong direction,
+ * or start equal to end, gives []. Fractional values work; each item is computed as start + i * step, so errors
+ * do not build up, but values like 0.1 * 3 still carry ordinary floating-point rounding.
+ * @param {number} start first item
+ * @param {number} end where to stop; never included
+ * @param {number} [step] distance between items; any finite non-zero number, defaults to 1
+ * @returns {number[]} a new array; [] if there is nothing between start and end
+ * @throws {TypeError} if start, end or step is not a number
+ * @throws {RangeError} if any is NaN or infinite, step is 0 or too small to change start, or the result
+ *   would be longer than 2**32 - 1 items
+ */
+exports.range = (start, end, step = 1) => {
+  for (const [name, value] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof value !== 'number') throw new TypeError(`range expects ${name} to be a number`);
+    if (!Number.isFinite(value)) throw new RangeError(`range expects ${name} to be finite`);
+  }
+  if (step === 0) throw new RangeError('range expects step to be non-zero');
+  let length = Math.max(0, Math.ceil((end - start) / step));
+  if (length === 0) return [];
+  if (length > MAX_RANGE_LENGTH) throw new RangeError('range would be longer than 2**32 - 1 items');
+  if (start + step === start) throw new RangeError('range expects step to be large enough to change start');
+  const inRange = (x) => (step > 0 ? x < end : x > end);
+  while (length > 0 && !inRange(start + (length - 1) * step)) length--; // drop an item that rounding pushed past end
+  const items = [];
+  for (let i = 0; i < length; i++) {
+    const x = start + i * step;
+    items.push(x === 0 ? 0 : x); // never -0
+  }
+  return items;
+};
+
+/**
+ * Flattens arrays nested to any depth into one array, keeping the order of the items. Only real arrays are
+ * flattened: strings, array-likes, Sets and objects stay as single items. Empty arrays disappear, and holes in
+ * sparse arrays are skipped, as Array.prototype.flat does. Nesting can be as deep as memory allows (it does not
+ * recurse). The same array may appear several times, and is flattened each time. The input is not modified.
+ * @param {unknown[]} xs
+ * @returns {unknown[]} a new array containing no arrays
