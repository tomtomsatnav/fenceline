+const test = require('node:test');
+const assert = require('node:assert');
+const { pick, omit, deepEqual, deepClone, getPath, setPath, mergeDeep, invert, flattenKeys, unflattenKeys, mapValues, filterKeys, diffObjects } = require('../src/lib/objects.js');
+
+test('pick returns only the listed keys', () => {
+  assert.deepStrictEqual(pick({ a: 1, b: 2, c: 3 }, ['a', 'c']), { a: 1, c: 3 });
+});
+
+test('pick leaves out keys the object does not have, rather than setting them to undefined', () => {
+  const result = pick({ a: 1 }, ['a', 'missing']);
+  assert.deepStrictEqual(result, { a: 1 });
+  assert.strictEqual(Object.prototype.hasOwnProperty.call(result, 'missing'), false);
+});
+
+test('pick keeps falsy values such as 0, false, null and undefined', () => {
+  const result = pick({ a: 0, b: false, c: null, d: undefined }, ['a', 'b', 'c', 'd']);
+  assert.deepStrictEqual(result, { a: 0, b: false, c: null, d: undefined });
+  assert.strictEqual(Object.prototype.hasOwnProperty.call(result, 'd'), true);
+});
+
+test('pick returns an empty object for an empty key list', () => {
+  assert.deepStrictEqual(pick({ a: 1 }, []), {});
+});
+
+test('pick ignores inherited properties', () => {
+  const child = Object.create({ inherited: 1 });
+  child.own = 2;
+  assert.deepStrictEqual(pick(child, ['inherited', 'own']), { own: 2 });
+});
+
+test('pick returns a new object and does not change the input', () => {
+  const obj = { a: 1, b: { nested: true } };
+  const result = pick(obj, ['a', 'b']);
+  assert.notStrictEqual(result, obj);
+  assert.deepStrictEqual(obj, { a: 1, b: { nested: true } });
+  assert.strictEqual(result.b, obj.b);
+});
+
+test('pick copies a key named __proto__ as an ordinary property', () => {
+  const obj = JSON.parse('{"__proto__": {"polluted": true}}');
+  const result = pick(obj, ['__proto__']);
+  assert.strictEqual(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepStrictEqual(Object.keys(result), ['__proto__']);
+});
+
+test('pick repeats a key only once in the result', () => {
+  assert.deepStrictEqual(pick({ a: 1 }, ['a', 'a']), { a: 1 });
+});
+
+test('omit removes the listed keys and keeps the rest', () => {
+  assert.deepStrictEqual(omit({ a: 1, b: 2, c: 3 }, ['b']), { a: 1, c: 3 });
+});
+
+test('omit with an empty key list returns a copy of every key', () => {
+  assert.deepStrictEqual(omit({ a: 1, b: 2 }, []), { a: 1, b: 2 });
+});
+
+test('omit ignores keys the object does not have', () => {
+  assert.deepStrictEqual(omit({ a: 1 }, ['missing']), { a: 1 });
+});
+
+test('omit keeps falsy values such as 0, false, null and undefined', () => {
+  const result = omit({ a: 0, b: false, c: null, d: undefined, e: 'x' }, ['e']);
+  assert.deepStrictEqual(result, { a: 0, b: false, c: null, d: undefined });
+  assert.strictEqual(Object.prototype.hasOwnProperty.call(result, 'd'), true);
+});
+
+test('omit removes every key when all of them are listed', () => {
+  assert.deepStrictEqual(omit({ a: 1, b: 2 }, ['a', 'b']), {});
+});
+
+test('omit matches keys as strings, so a number key removes its string form', () => {
+  assert.deepStrictEqual(omit({ 1: 'one', 2: 'two' }, [1]), { 2: 'two' });
+});
+
+test('omit returns a new object and does not change the input', () => {
+  const obj = { a: 1, b: { nested: true } };
+  const result = omit(obj, ['a']);
+  assert.notStrictEqual(result, obj);
+  assert.deepStrictEqual(obj, { a: 1, b: { nested: true } });
+  assert.strictEqual(result.b, obj.b);
+});
+
+test('omit does not copy inherited properties', () => {
+  const child = Object.create({ inherited: 1 });
+  child.own = 2;
+  assert.deepStrictEqual(omit(child, []), { own: 2 });
+});
+
+test('omit copies a key named __proto__ as an ordinary property', () => {
+  const obj = JSON.parse('{"__proto__": {"polluted": true}, "a": 1}');
+  const result = omit(obj, ['a']);
+  assert.strictEqual(Object.getPrototypeOf(result), Object.prototype);
+  assert.deepStrictEqual(Object.keys(result), ['__proto__']);
