+/**
+ * True when the UTC calendar day of date is a Saturday or Sunday. The time of day does not matter.
+ * @param {Date} date
+ * @returns {boolean}
+ * @throws {TypeError} when date is not a Date
+ * @throws {RangeError} when date is invalid
+ */
+exports.isWeekend = (date) => {
+  assertValidDate(date, 'isWeekend');
+  const day = date.getUTCDay();
+  return day === 0 || day === 6;
+};
+
+/**
+ * The Monday 00:00 UTC that starts the week containing date. A Sunday belongs to the week that began
+ * six days earlier. The input Date is not changed.
+ * @param {Date} date
+ * @returns {Date}
+ * @throws {TypeError} when date is not a Date
+ * @throws {RangeError} when date is invalid
+ */
