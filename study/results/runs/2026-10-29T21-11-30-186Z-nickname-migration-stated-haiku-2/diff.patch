+ * Shortens text to at most n characters. When it cuts anything, the last character is "…".
+ * Length counts code points, so an emoji is one character.
+ * @param {string} s
+ * @param {number} n a non-negative integer
+ * @returns {string}
+ */
+exports.truncate = (s, n) => {
+  if (typeof s !== 'string') throw new TypeError('truncate expects a string');
+  if (!Number.isInteger(n) || n < 0) throw new RangeError('truncate expects a non-negative integer length');
+  const chars = [...s];
+  if (chars.length <= n) return s;
+  if (n === 0) return '';
+  return chars.slice(0, n - 1).join('') + '…';
+};
