+test('addDays moves forward by n days', () => {
+  assert.deepStrictEqual(addDays(new Date(2024, 0, 10), 5), new Date(2024, 0, 15));
+});
+
+test('addDays moves backward for a negative n', () => {
+  assert.deepStrictEqual(addDays(new Date(2024, 0, 10), -5), new Date(2024, 0, 5));
+});
+
