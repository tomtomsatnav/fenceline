+test('isEmail enforces the length limits', () => {
+  const local64 = 'a'.repeat(64);
+  const local65 = 'a'.repeat(65);
+  assert.strictEqual(isEmail(`${local64}@example.com`), true);
+  assert.strictEqual(isEmail(`${local65}@example.com`), false);
+
+  const label63 = 'b'.repeat(63);
+  const label64 = 'b'.repeat(64);
+  assert.strictEqual(isEmail(`ada@${label63}.com`), true);
+  assert.strictEqual(isEmail(`ada@${label64}.com`), false);
+
+  // The whole address may be at most 254 characters. Here the domain's last label sets the length.
+  const withTotal = (length) => {
+    const local = 'a'.repeat(64);
+    const domainStart = `${'b'.repeat(63)}.${'c'.repeat(63)}.`;
+    const lastLabel = 'd'.repeat(length - local.length - 1 - domainStart.length);
+    return `${local}@${domainStart}${lastLabel}`;
+  };
+  assert.strictEqual(withTotal(254).length, 254);
+  assert.strictEqual(isEmail(withTotal(254)), true);
+  assert.strictEqual(withTotal(255).length, 255);
+  assert.strictEqual(isEmail(withTotal(255)), false);
+});
