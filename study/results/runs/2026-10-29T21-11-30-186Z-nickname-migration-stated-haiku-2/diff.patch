+/**
+ * Centres text in a field of the given width by padding both sides with ch. When the padding
+ * is odd, the extra character goes on the right. Text already at least as wide is returned unchanged.
+ * Width counts code points, so an emoji is one character.
+ * @param {string} s
+ * @param {number} width a non-negative integer
+ * @param {string} [ch=" "] a single character
+ * @returns {string}
+ */
+exports.padCenter = (s, width, ch = ' ') => {
+  if (typeof s !== 'string') throw new TypeError('padCenter expects a string');
+  if (!Number.isInteger(width) || width < 0) throw new RangeError('padCenter expects a non-negative integer width');
+  if (typeof ch !== 'string' || [...ch].length !== 1) throw new TypeError('padCenter expects a single character as the pad');
