+const test = require('node:test');
+const assert = require('node:assert');
+const { clamp, roundTo, mean, median, percentile, formatBytes, isPrime, gcd, toRoman, fromRoman, lerp, stdDev, fibonacci, toOrdinal, parseDuration } = require('../src/lib/numbers.js');
+
+test('clamp returns x when it is already in range', () => {
+  assert.strictEqual(clamp(5, 0, 10), 5);
+});
+
+test('clamp returns the lower bound when x is below it', () => {
+  assert.strictEqual(clamp(-3, 0, 10), 0);
+});
+
+test('clamp returns the upper bound when x is above it', () => {
+  assert.strictEqual(clamp(42, 0, 10), 10);
+});
+
+test('clamp keeps x that sits exactly on a bound', () => {
+  assert.strictEqual(clamp(0, 0, 10), 0);
+  assert.strictEqual(clamp(10, 0, 10), 10);
+});
+
+test('clamp works with negative bounds and infinite bounds', () => {
+  assert.strictEqual(clamp(-7, -5, -1), -5);
+  assert.strictEqual(clamp(5, -Infinity, 0), 0);
+  assert.strictEqual(clamp(5, 0, Infinity), 5);
+});
+
+test('clamp returns the bound when lo equals hi', () => {
+  assert.strictEqual(clamp(7, 3, 3), 3);
+});
+
+test('clamp returns NaN for a NaN x', () => {
+  assert.ok(Number.isNaN(clamp(NaN, 0, 10)));
+});
+
+test('roundTo rounds to whole numbers by default', () => {
+  assert.strictEqual(roundTo(3.7), 4);
+  assert.strictEqual(roundTo(3.2), 3);
+});
+
+test('roundTo rounds halves away from zero', () => {
+  assert.strictEqual(roundTo(2.5), 3);
+  assert.strictEqual(roundTo(-2.5), -3);
+  assert.strictEqual(roundTo(0.5), 1);
+  assert.strictEqual(roundTo(-0.5), -1);
+});
+
+test('roundTo rounds to decimal places, judging halves on the decimal digits', () => {
+  assert.strictEqual(roundTo(1.005, 2), 1.01);
+  assert.strictEqual(roundTo(-1.005, 2), -1.01);
+  assert.strictEqual(roundTo(1.2345, 3), 1.235);
+  assert.strictEqual(roundTo(0.1 + 0.2, 2), 0.3);
+});
+
+test('roundTo handles very small numbers', () => {
+  assert.strictEqual(roundTo(1e-7, 2), 0);
+  assert.strictEqual(roundTo(5e-7, 6), 0.000001);
+});
+
+test('roundTo with negative places rounds to tens, hundreds and so on', () => {
+  assert.strictEqual(roundTo(1234, -2), 1200);
+  assert.strictEqual(roundTo(1250, -2), 1300);
+  assert.strictEqual(roundTo(-1250, -2), -1300);
+});
+
+test('roundTo returns 0, not -0, when the result is zero', () => {
+  assert.ok(Object.is(roundTo(-0.4), 0));
+});
+
+test('roundTo returns infinite and NaN values unchanged', () => {
+  assert.strictEqual(roundTo(Infinity, 2), Infinity);
+  assert.ok(Number.isNaN(roundTo(NaN, 2)));
+});
+
+test('roundTo throws for a non-number x or non-integer places', () => {
+  assert.throws(() => roundTo('1.5', 1), TypeError);
+  assert.throws(() => roundTo(1.5, 1.5), RangeError);
+});
+
+test('mean returns the arithmetic mean', () => {
+  assert.strictEqual(mean([1, 2, 3, 4]), 2.5);
+  assert.strictEqual(mean([5]), 5);
+  assert.strictEqual(mean([-1, 1]), 0);
+});
+
+test('mean returns NaN for an empty array', () => {
+  assert.ok(Number.isNaN(mean([])));
