+  for (const word of text.split(/\s+/).filter(Boolean)) {
+    if (line === '') line = word;
+    else if (length(line) + 1 + length(word) <= width) line += ' ' + word;
+    else {
+      lines.push(line);
+      line = word;
+    }
+  }
+  if (line !== '') lines.push(line);
+  return lines.join('\n');
+};
+
+/**
+ * Fills {name} placeholders with values from vars. A placeholder with no matching key is left as it is.
+ * Placeholder names are word characters only, so "{ name }" is not a placeholder.
+ * @param {string} s
+ * @param {Object<string, *>} vars
+ * @returns {string}
+ */
+exports.template = (s, vars = {}) => {
+  if (typeof s !== 'string') throw new TypeError('template expects a string');
+  return s.replace(/\{(\w+)\}/g, (placeholder, key) =>
+    Object.prototype.hasOwnProperty.call(vars, key) ? String(vars[key]) : placeholder);
+};
+
+/**
+ * Makes a URL-friendly slug from ASCII text. Lower-cases the text, turns each run of characters other
+ * than a-z and 0-9 into one dash, and trims dashes from both ends. Accented letters are not
+ * transliterated: "café" becomes "caf". Text with nothing to keep gives "".
+ * @param {string} s
+ * @returns {string}
+ * @throws {TypeError} when s is not a string
+ */
+exports.slugifyAscii = (s) => {
+  if (typeof s !== 'string') throw new TypeError('slugifyAscii expects a string');
+  return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
+};
+
+const HTML_ESCAPES = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
+
+/**
+ * Escapes & < > " and ' so text can sit inside HTML element content or a quoted attribute. Each
+ * character is replaced once, so existing entities such as "&amp;" are escaped again, not left alone.
+ * @param {string} s
+ * @returns {string}
+ * @throws {TypeError} when s is not a string
+ */
+exports.escapeHtml = (s) => {
+  if (typeof s !== 'string') throw new TypeError('escapeHtml expects a string');
+  return s.replace(/[&<>"']/g, (ch) => HTML_ESCAPES[ch]);
+};
+
+// A tag starts with "<" then a letter or "/", and its quoted attribute values may hold ">". Comments are
+// matched whole. A "<" not followed by a letter, "/" or "!--" is left alone.
+const HTML_TAG = /<\/?[A-Za-z][^>"']*(?:(?:"[^"]*"|'[^']*')[^>"']*)*>|<!--[\s\S]*?-->/g;
+
+/**
+ * Removes HTML tags and comments, keeping the text between them. Entities such as &amp; are not decoded,
+ * so pass the result through escapeHtml before putting it back into a page. Text such as "1 < 2 and 3 > 2"
+ * is kept, since "<" must be followed by a letter or "/" to start a tag. Content inside script and style
+ * elements is kept too, because it is text. This is not an HTML sanitizer.
+ * @param {string} s
+ * @returns {string}
+ * @throws {TypeError} when s is not a string
+ */
+exports.stripTags = (s) => {
+  if (typeof s !== 'string') throw new TypeError('stripTags expects a string');
+  return s.replace(HTML_TAG, '');
+};
+
+/**
+ * The edit distance between two strings: the fewest insertions, deletions and substitutions of one
+ * character that turn a into b. Comparison is case-sensitive, and characters are code points, so an
+ * emoji counts as one. Keeps only two rows of the table, so memory grows with the length of b, not with
+ * the full table.
+ * @param {string} a
+ * @param {string} b
+ * @returns {number} an integer, 0 for equal strings
+ * @throws {TypeError} when a or b is not a string
+ */
+exports.levenshtein = (a, b) => {
+  if (typeof a !== 'string' || typeof b !== 'string') throw new TypeError('levenshtein expects two strings');
+  const x = [...a];
+  const y = [...b];
+  let prev = Array.from({ length: y.length + 1 }, (_, j) => j);
+  for (let i = 1; i <= x.length; i++) {
+    const cur = [i];
+    for (let j = 1; j <= y.length; j++) {
+      const substitution = prev[j - 1] + (x[i - 1] === y[j - 1] ? 0 : 1);
+      cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, substitution);
+    }
+    prev = cur;
+  }
+  return prev[y.length];
+};
+
+/**
+ * The longest prefix that every string in the array starts with. Compared by code point, so an emoji is
+ * never split. Case-sensitive. An empty array gives "", and so does any array holding an empty string.
+ * @param {string[]} strings
+ * @returns {string}
+ * @throws {TypeError} when strings is not an array, or holds a non-string
+ */
+exports.commonPrefix = (strings) => {
+  if (!Array.isArray(strings) || strings.some((s) => typeof s !== 'string')) {
+    throw new TypeError('commonPrefix expects an array of strings');
+  }
+  if (strings.length === 0) return '';
+  const [first, ...rest] = strings.map((s) => [...s]);
+  let n = 0;
+  while (n < first.length && rest.every((cps) => n < cps.length && cps[n] === first[n])) n++;
+  return first.slice(0, n).join('');
+};
+
+exports.kebabCase = (str) => {
+  if (typeof str !== 'string') throw new TypeError('kebabCase expects a string');
+  return str
+    .replace(/(\p{Ll}|\p{Nd})(\p{Lu})/gu, '$1 $2')
+    .replace(/(\p{Lu})(\p{Lu}\p{Ll})/gu, '$1 $2')
+    .split(/[^\p{L}\p{Nd}]+/u)
+    .filter(Boolean)
+    .map((word) => word.toLowerCase())
+    .join('-');
+};
diff --git a/src/lib/validate.js b/src/lib/validate.js
new file mode 100644
index 0000000..632e1a1
--- /dev/null
+++ b/src/lib/validate.js
@@ -0,0 +1,175 @@
+// Characters allowed in the local part, with dots only between runs of them.
+const LOCAL_PART = /^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*$/;
+// One domain label: letters, digits and inner hyphens.
+const DOMAIN_LABEL = /^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$/;
+
+// 8-4-4-4-12 hex digits, version 1 to 5, and the RFC 4122 variant (the first digit of the fourth group
+// is 8, 9, a or b). The nil UUID, all zeros, is also defined by RFC 4122.
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+const NIL_UUID = /^0{8}-0{4}-0{4}-0{4}-0{12}$/;
+
+/**
+ * True for a UUID in the RFC 4122 form, of version 1 to 5, or the nil UUID. Letters may be either case.
+ * Braces, a "urn:uuid:" prefix and missing hyphens are rejected. Versions 6 to 8 come from the later
+ * RFC 9562 and are not accepted.
+ * @param {*} s
+ * @returns {boolean}
+ */
+exports.isUuid = (s) => typeof s === 'string' && (UUID.test(s) || NIL_UUID.test(s));
+
+/**
+ * True when the password is at least 12 characters and has a lower-case letter, an upper-case letter, a
+ * digit and a symbol. A symbol is any character that is not a letter, a digit or whitespace, so a space
+ * does not count. Length counts code points, so an emoji is one character. Non-strings are rejected.
+ * @param {*} s
+ * @returns {boolean}
+ */
+exports.isStrongPassword = (s) => {
+  if (typeof s !== 'string' || [...s].length < 12) return false;
+  return /\p{Ll}/u.test(s) && /\p{Lu}/u.test(s) && /\p{Nd}/u.test(s) && /[^\p{L}\p{N}\s]/u.test(s);
+};
+
+/**
+ * True when s is an absolute http or https URL with a host, as parsed by the URL class. Text with
+ * leading or trailing whitespace is rejected, and so are other schemes such as ftp: and javascript:.
+ * @param {*} s
+ * @returns {boolean}
+ */
+exports.isUrl = (s) => {
+  if (typeof s !== 'string' || s !== s.trim()) return false;
+  let url;
+  try {
+    url = new URL(s);
+  } catch {
+    return false;
+  }
+  return (url.protocol === 'http:' || url.protocol === 'https:') && url.hostname !== '';
+};
+
+// Outward code (area, district), then an optional space, then the inward code (sector and unit).
+// Letters that Royal Mail does not use in some positions (Q, V and X at the start, C, I, K, M, O and V
+// in the last two letters) are excluded. GIR 0AA is the special Girobank code.
+const UK_POSTCODE = /^(GIR ?0AA|[A-PR-UWYZ]([0-9]{1,2}|([A-HK-Y][0-9]([0-9ABEMNPRVWXY])?)|[0-9][A-HJKPSTUW]) ?[0-9][ABD-HJLNP-UW-Z]{2})$/;
+
+/**
+ * True for a UK postcode such as "SW1A 1AA". Case does not matter. The space is optional. Leading or
+ * trailing whitespace is rejected, as in isUrl.
+ * @param {*} s
+ * @returns {boolean}
+ */
+exports.isPostcodeUK = (s) => typeof s === 'string' && UK_POSTCODE.test(s.toUpperCase());
+
+// A short list of common ISO 4217 currency codes. Other real codes are not in it, so they return false.
+const COMMON_CURRENCIES = new Set([
+  'USD', 'EUR', 'GBP', 'JPY', 'CHF', 'CAD', 'AUD', 'NZD', 'CNY', 'HKD', 'SGD', 'INR', 'KRW',
+  'SEK', 'NOK', 'DKK', 'PLN', 'CZK', 'HUF', 'BRL', 'MXN', 'ZAR',
+]);
+
+/**
+ * True for an upper-case three-letter code from a short list of common ISO 4217 currencies, such as
+ * "USD". Lower-case codes, and codes outside the list, are false. Non-strings are false.
+ * @param {*} s
+ * @returns {boolean}
+ */
+exports.isIsoCurrency = (s) => typeof s === 'string' && COMMON_CURRENCIES.has(s);
+
+const HEX_COLOR = /^#(?:[0-9a-f]{3}|[0-9a-f]{6})$/i;
+
+/**
+ * True for a hex colour written as #rgb or #rrggbb, in either letter case. The forms with an alpha
+ * channel (#rgba, #rrggbbaa) are not accepted. Leading or trailing whitespace is rejected.
+ * @param {*} s
+ * @returns {boolean}
+ */
+exports.isHexColor = (s) => typeof s === 'string' && HEX_COLOR.test(s);
+
+// One decimal octet: "0", or 1 to 3 digits starting from 1 (so no leading zeros). The value is checked
+// against 255 separately.
+const OCTET = /^(0|[1-9][0-9]{0,2})$/;
+
+/**
+ * True for a dotted-quad IPv4 address such as "192.168.0.1": four parts, each 0 to 255, written without
+ * leading zeros. Signs, spaces and any other text are rejected.
+ * @param {*} s
+ * @returns {boolean}
+ */
+exports.isIPv4 = (s) => {
+  if (typeof s !== 'string') return false;
+  const parts = s.split('.');
+  return parts.length === 4 && parts.every((part) => OCTET.test(part) && Number(part) <= 255);
+};
+
+// The official semver.org pattern: MAJOR.MINOR.PATCH with no leading zeros, an optional pre-release and an
+// optional build. Numeric pre-release parts have no leading zeros; build parts may have them.
+const SEMVER = /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\+([0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*))?$/;
+
+/**
+ * True for a semantic version as defined at semver.org, such as "1.2.3", "1.2.3-beta.1" or "1.2.3+build.5".
+ * A leading "v" is not part of semver, so "v1.2.3" is rejected.
+ * @param {*} s
+ * @returns {boolean}
+ */
+exports.isSemver = (s) => typeof s === 'string' && SEMVER.test(s);
+
+// Total IBAN length for a few common countries. Other countries are not checked, so they return false.
+const IBAN_LENGTHS = { AT: 20, BE: 16, CH: 21, DE: 22, ES: 24, FR: 27, GB: 22, IE: 22, IT: 27, NL: 18 };
+
+/**
+ * True for an IBAN in its compact form, such as "GB82WEST12345698765432": a known country code, the right
+ * total length for that country, and a valid mod-97 check (the remainder is 1 after moving the first four
+ * characters to the end and turning letters into 10 to 35). Spaces, lower-case letters and countries not
+ * in the short list are rejected.
+ * @param {*} s
+ * @returns {boolean}
+ */
+exports.isIban = (s) => {
+  if (typeof s !== 'string' || !/^[A-Z]{2}[0-9]{2}[A-Z0-9]+$/.test(s)) return false;
+  const length = IBAN_LENGTHS[s.slice(0, 2)];
+  if (length === undefined || s.length !== length) return false;
+  const rearranged = s.slice(4) + s.slice(0, 4);
+  let remainder = 0;
+  for (const ch of rearranged) {
+    const digits = /[A-Z]/.test(ch) ? String(ch.charCodeAt(0) - 55) : ch;
+    for (const digit of digits) remainder = (remainder * 10 + Number(digit)) % 97;
+  }
+  return remainder === 1;
+};
+
+/**
+ * True when a string of digits passes the Luhn check, which card numbers use to catch typing mistakes. From
+ * the right, every second digit is doubled (and reduced by 9 when above 9), and the sum must be a multiple of
+ * 10. Only digits are accepted, so spaces and dashes must be removed first. A single digit is rejected, since
+ * the check says nothing useful about it. Passing the check does not mean a card exists.
+ * @param {*} s
+ * @returns {boolean}
+ */
+exports.isCreditCardLuhn = (s) => {
+  if (typeof s !== 'string' || !/^[0-9]{2,}$/.test(s)) return false;
+  let sum = 0;
+  for (let i = 0; i < s.length; i++) {
+    let digit = Number(s[s.length - 1 - i]);
+    if (i % 2 === 1) {
+      digit *= 2;
+      if (digit > 9) digit -= 9;
+    }
+    sum += digit;
+  }
+  return sum % 10 === 0;
+};
+
+/**
+ * A reasonable email check, not a full RFC 5322 parser. Requires exactly one "@", a local part and a
+ * domain with at least one dot, and no spaces. Length limits follow the RFC: 64 characters for the local
+ * part, 63 per domain label and 254 overall. Non-strings are not emails.
+ * @param {*} s
+ * @returns {boolean}
+ */
+exports.isEmail = (s) => {
+  if (typeof s !== 'string' || s.length > 254) return false;
+  const parts = s.split('@');
+  if (parts.length !== 2) return false;
+  const [local, domain] = parts;
+  if (local.length > 64 || !LOCAL_PART.test(local)) return false;
+  const labels = domain.split('.');
+  return labels.length >= 2 && labels.every((label) => label.length <= 63 && DOMAIN_LABEL.test(label));
+};
diff --git a/test/export.test.js b/test/export.test.js
new file mode 100644
index 0000000..bc81738
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,44 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { createUser, listUsers } = require('../src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+test('exports a header row and one row per user', () => {
+  const db = migrate(new Db());
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  assert.strictEqual(exportUsersCsv(db), `id,email,fullName,createdAt,lastLogin\n${u.id},ada@example.com,Ada Lovelace,${u.createdAt},`);
+});
+
+test('quotes fields containing commas and quotes', () => {
+  const db = migrate(new Db());
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Lovelace, "Ada"' });
+  const lines = exportUsersCsv(db).split('\n');
+  assert.strictEqual(lines[1], `${u.id},ada@example.com,"Lovelace, ""Ada""",${u.createdAt},`);
+});
+
+test('importing an export recreates the same emails and names', () => {
+  const db = migrate(new Db());
+  createUser(db, { email: 'ada@example.com', fullName: 'Lovelace, "Ada"' });
+  createUser(db, { email: 'grace@example.com', fullName: 'Grace Hopper' });
+  const csv = exportUsersCsv(db);
+
+  const copy = migrate(new Db());
+  const imported = importUsersCsv(copy, csv);
+  assert.strictEqual(imported.length, 2);
+  const pairs = (d) => listUsers(d).map((u) => [u.email, u.fullName]);
+  assert.deepStrictEqual(pairs(copy), pairs(db));
+  assert.strictEqual(exportUsersCsv(copy).split('\n').length, 3);
+});
+
+test('rejects a CSV with the wrong header', () => {
+  const db = migrate(new Db());
+  assert.throws(() => importUsersCsv(db, 'email,name\nada@example.com,Ada'), /unexpected CSV header/);
+});
+
+test('exports every user, not just the first page', () => {
+  const db = migrate(new Db());
+  for (let i = 0; i < 55; i++) createUser(db, { email: `user${i}@example.com`, fullName: `User ${i}` });
+  assert.strictEqual(exportUsersCsv(db).split('\n').length, 56);
+});
