@@ -0,0 +1,77 @@
+const { listUsers, createUser } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quotes a field when it contains a comma, quote or line break; a missing value becomes an empty field.
+const escapeField = (value) => {
+  const s = value == null ? '' : String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * Exports every user as CSV: a header row, then one row per user, oldest first.
+ * @param {object} db
+ * @returns {string}
+ */
+exports.exportUsersCsv = (db) => {
+  // Infinity as the limit so the export includes every user, not just the first page.
+  const users = listUsers(db, { limit: Infinity });
+  const lines = users.map((u) => COLUMNS.map((c) => escapeField(u[c])).join(','));
+  return [COLUMNS.join(','), ...lines].join('\n');
+};
+
+// Splits CSV text into rows of fields, honoring quoted fields with commas, doubled quotes and line breaks.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c === '"' && text[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else if (c === '"') {
+        quoted = false;
+      } else {
+        field += c;
+      }
+    } else if (c === '"') {
+      quoted = true;
+    } else if (c === ',') {
+      row.push(field);
+      field = '';
+    } else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+    } else {
+      field += c;
+    }
+  }
+  if (field !== '' || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+  return rows.filter((r) => !(r.length === 1 && r[0] === ''));
+};
+
+/**
+ * Creates a user for each data row of a CSV produced by exportUsersCsv. Each row goes through
+ * createUser, so the usual checks apply. ids, createdAt and lastLogin are assigned by the database,
+ * not read from the file. Rows are created one at a time, so a failure leaves earlier rows in place.
+ * @param {object} db
+ * @param {string} csv
+ * @returns {object[]} the created users
+ */
+exports.importUsersCsv = (db, csv) => {
+  const [header, ...rows] = parseCsv(csv);
+  if (header.join(',') !== COLUMNS.join(',')) throw new Error(`unexpected CSV header: ${header.join(',')}`);
+  return rows.map((fields) => {
+    const u = Object.fromEntries(COLUMNS.map((c, i) => [c, fields[i]]));
+    return createUser(db, { email: u.email, fullName: u.fullName });
+  });
+};
