+/**
+ * Splits an array into consecutive arrays of length n. The last one may be shorter.
+ * The input array is not changed.
+ * @param {Array} xs
+ * @param {number} n a positive integer
+ * @returns {Array[]} an empty array when xs is empty
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk expects an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('chunk expects a positive integer size');
+  const out = [];
+  for (let i = 0; i < xs.length; i += n) out.push(xs.slice(i, i + n));
+  return out;
+};
+
+/**
+ * Keeps the first item for each key, in the original order. Keys are compared with SameValueZero,
+ * as Set does, so NaN matches NaN and objects match only themselves.
+ * The input array is not changed.
+ * @param {Array} xs
+ * @param {(x: *) => *} keyFn
+ * @returns {Array}
+ */
+/**
+ * Groups items by the key keyFn returns. Keys become object keys, so 1 and "1" share a group.
+ * Groups keep the original order, and the input array is not changed.
+ * @param {Array} xs
+ * @param {(x: *) => *} keyFn
+ * @returns {Object<string, Array>} an empty object for empty input
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy expects a key function');
+  const groups = {};
+  for (const x of xs) {
+    const key = String(keyFn(x));
+    // defineProperty, not assignment, so a key such as "__proto__" becomes an ordinary group.
+    if (!Object.prototype.hasOwnProperty.call(groups, key)) {
+      Object.defineProperty(groups, key, { value: [], enumerable: true, writable: true, configurable: true });
+    }
+    groups[key].push(x);
+  }
+  return groups;
+};
+
+/**
+ * Splits items into those that match pred and those that don't, each in the original order.
+ * pred is called with (item, index). The input array is not changed.
+ * @param {Array} xs
+ * @param {(x: *, i: number) => boolean} pred
+ * @returns {[Array, Array]} [matching, notMatching]; both empty for empty input
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition expects an array');
+  if (typeof pred !== 'function') throw new TypeError('partition expects a predicate function');
+  const matching = [];
+  const notMatching = [];
+  xs.forEach((x, i) => (pred(x, i) ? matching : notMatching).push(x));
+  return [matching, notMatching];
+};
+
+/**
+ * Pairs items up by position, stopping at the shorter array, so extra items in the longer one are dropped.
+ * The input arrays are not changed.
+ * @param {Array} a
+ * @param {Array} b
+ * @returns {Array[]} pairs of [a[i], b[i]]; empty when either array is empty
+ */
+exports.zip = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new TypeError('zip expects two arrays');
+  const n = Math.min(a.length, b.length);
+  const pairs = [];
+  for (let i = 0; i < n; i++) pairs.push([a[i], b[i]]);
+  return pairs;
+};
+
+/**
+ * Numbers from start up to but not including end, stepping by step. A negative step counts down.
+ * Returns [] when the range is empty, such as range(0, 5, -1). Each value is start + i * step,
+ * so float steps do not drift.
+ * @param {number} start
+ * @param {number} end
+ * @param {number} [step=1] a finite, non-zero number
+ * @returns {number[]}
+ */
+exports.range = (start, end, step = 1) => {
+  for (const v of [start, end, step]) {
+    if (typeof v !== 'number' || !Number.isFinite(v)) throw new TypeError('range expects finite numbers');
+  }
+  if (step === 0) throw new RangeError('range step must not be 0');
+  const count = Math.max(0, Math.ceil((end - start) / step));
+  return Array.from({ length: count }, (_, i) => start + i * step);
+};
+
+/**
+ * Flattens arrays nested to any depth into one array. Only arrays are flattened; other values,
+ * including objects, are kept as they are. The input is not changed.
+ * @param {Array} xs
+ * @returns {Array}
+ * @throws {TypeError} when xs is not an array, or contains itself
+ */
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep expects an array');
+  const out = [];
+  const walk = (arr, ancestors) => {
+    if (ancestors.has(arr)) throw new TypeError('flattenDeep cannot flatten an array that contains itself');
+    ancestors.add(arr);
+    for (const x of arr) {
+      if (Array.isArray(x)) walk(x, ancestors);
+      else out.push(x);
+    }
+    ancestors.delete(arr);
+  };
+  walk(xs, new Set());
+  return out;
+};
+
+/**
+ * Returns a new array sorted by keyFn, smallest key first. The sort is stable, so items with equal keys
+ * keep their original order. keyFn runs once per item. Keys must be strings or numbers (not NaN).
+ * For descending order, return a negated number. The input array is not changed.
+ * @param {Array} xs
+ * @param {(x: *) => (string|number)} keyFn
+ * @returns {Array}
+ */
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('sortBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('sortBy expects a key function');
+  const keyed = xs.map((x) => {
+    const key = keyFn(x);
+    if ((typeof key !== 'string' && typeof key !== 'number') || Number.isNaN(key)) {
+      throw new TypeError(`sortBy keys must be strings or numbers, got ${String(key)}`);
+    }
+    return { x, key };
+  });
+  keyed.sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0));
+  return keyed.map(({ x }) => x);
+};
+
+/**
+ * Picks one item at random. Pass a seeded rng for repeatable results.
+ * @param {Array} xs
+ * @param {() => number} [rng=Math.random] returns a number in [0, 1)
+ * @returns {*} a random item, or undefined for an empty array
+ * @throws {RangeError} when rng returns a value outside [0, 1)
+ */
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new TypeError('sample expects an array');
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (!(r >= 0 && r < 1)) throw new RangeError(`rng must return a number in [0, 1), got ${r}`);
+  return xs[Math.floor(r * xs.length)];
+};
+
+/**
+ * Every run of n consecutive items, each window starting one item after the last.
+ * The input array is not changed.
+ * @param {Array} xs
+ * @param {number} n a positive integer
+ * @returns {Array[]} [] when n is larger than xs
+ */
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed expects an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('windowed expects a positive integer size');
+  const out = [];
+  for (let i = 0; i + n <= xs.length; i++) out.push(xs.slice(i, i + n));
+  return out;
+};
+
+/**
+ * The items of a that are not in b, in a's order. Items are matched with SameValueZero, as Set does, so
+ * NaN matches NaN. Duplicates in a are kept. Neither input is changed.
+ * @param {Array} a
+ * @param {Array} b
+ * @returns {Array}
+ * @throws {TypeError} when a or b is not an array
+ */
+exports.difference = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new TypeError('difference expects two arrays');
+  const inB = new Set(b);
+  return a.filter((x) => !inB.has(x));
+};
+
+/**
+ * The items that appear in every one of the given arrays, in the order of the first. Items are matched
+ * with SameValueZero, as Set does. Duplicates in the first array are kept, as in difference. With one
+ * array, the result is a copy of it. No inputs are changed.
+ * @param {...Array} arrays at least one array
+ * @returns {Array}
+ * @throws {TypeError} when there are no arrays, or any argument is not an array
+ */
+exports.intersection = (...arrays) => {
+  if (arrays.length === 0) throw new TypeError('intersection expects at least one array');
+  if (arrays.some((arr) => !Array.isArray(arr))) throw new TypeError('intersection expects arrays');
+  const [first, ...rest] = arrays;
+  const others = rest.map((arr) => new Set(arr));
+  return first.filter((x) => others.every((set) => set.has(x)));
+};
+
+/**
+ * Rotates the array left by k places: rotate([1, 2, 3, 4], 1) gives [2, 3, 4, 1]. A negative k rotates
+ * right, and k larger than the length wraps around. The input array is not changed.
+ * @param {Array} xs
+ * @param {number} k an integer
+ * @returns {Array} a new array; [] for an empty input
+ * @throws {TypeError} when xs is not an array
+ * @throws {RangeError} when k is not an integer
+ */
+exports.rotate = (xs, k) => {
+  if (!Array.isArray(xs)) throw new TypeError('rotate expects an array');
+  if (!Number.isInteger(k)) throw new RangeError('rotate expects an integer step');
+  const n = xs.length;
+  if (n === 0) return [];
+  const shift = ((k % n) + n) % n;
+  return [...xs.slice(shift), ...xs.slice(0, shift)];
+};
+
+/**
+ * Counts items by the key keyFn returns, such as { fruit: 2, veg: 1 }. Keys become object keys, so 1 and
+ * "1" share a count. The input array is not changed.
+ * @param {Array} xs
+ * @param {(x: *) => *} keyFn
+ * @returns {Object<string, number>} an empty object for empty input
+ * @throws {TypeError} when xs is not an array, or keyFn is not a function
+ */
+exports.countBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('countBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('countBy expects a key function');
+  const counts = {};
+  for (const x of xs) {
+    const key = String(keyFn(x));
+    const current = Object.prototype.hasOwnProperty.call(counts, key) ? counts[key] : 0;
+    // defineProperty, not assignment, so a key such as "__proto__" becomes an ordinary count.
+    Object.defineProperty(counts, key, { value: current + 1, enumerable: true, writable: true, configurable: true });
+  }
+  return counts;
+};
+
+/**
+ * The item whose key is largest, or undefined for an empty array. When several items share the largest
+ * key, the first of them is returned. Keys must all be numbers, or all be strings, and not NaN, as in
+ * sortBy. The input array is not changed.
+ * @param {Array} xs
+ * @param {(x: *) => (number|string)} keyFn
+ * @returns {*}
+ * @throws {TypeError} when xs is not an array, keyFn is not a function, or a key is NaN, not a number
+ *   or string, or of a different type from the others
+ */
+exports.maxBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('maxBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('maxBy expects a key function');
+  let best;
+  let bestKey;
+  let keyType;
+  for (const x of xs) {
