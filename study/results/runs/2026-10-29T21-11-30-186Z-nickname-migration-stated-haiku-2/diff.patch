+// Moves the decimal point by places using the number's own digits, so 1.005 shifts to 100.5 exactly.
+const shift = (v, places) => {
+  const [mantissa, exponent = '0'] = String(v).split('e');
+  return Number(`${mantissa}e${Number(exponent) + places}`);
+};
+
+/**
+ * Rounds half away from zero to the given number of decimal places. Negative places round to tens,
+ * hundreds and so on. Halves are judged on the decimal digits, so roundTo(1.005, 2) is 1.01.
+ * Infinite and NaN x are returned unchanged.
+ * @param {number} x
+ * @param {number} [places=0] an integer
+ * @returns {number}
+ * @throws {TypeError} when x is not a number
+ * @throws {RangeError} when places is not an integer
+ */
+exports.roundTo = (x, places = 0) => {
+  if (typeof x !== 'number') throw new TypeError('roundTo expects a number');
+  if (!Number.isInteger(places)) throw new RangeError('roundTo expects an integer number of places');
+  if (!Number.isFinite(x)) return x;
+  const rounded = shift(Math.round(shift(Math.abs(x), places)), -places);
+  const signed = x < 0 ? -rounded : rounded;
+  return signed === 0 ? 0 : signed;
+};
+
+/**
+ * The arithmetic mean of an array of numbers.
+ * @param {number[]} xs
+ * @returns {number} NaN for an empty array
+ * @throws {TypeError} when xs is not an array, or holds a non-number
+ */
+exports.mean = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('mean expects an array');
+  if (xs.some((x) => typeof x !== 'number')) throw new TypeError('mean expects an array of numbers');
+  if (xs.length === 0) return NaN;
+  return xs.reduce((sum, x) => sum + x, 0) / xs.length;
+};
+
+/**
+ * The median of an array of numbers: the middle value, or the mean of the two middle values when the
+ * length is even. The input array is not changed.
+ * @param {number[]} xs
+ * @returns {number} NaN for an empty array or one that holds NaN
+ * @throws {TypeError} when xs is not an array, or holds a non-number
+ */
+exports.median = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('median expects an array');
+  if (xs.some((x) => typeof x !== 'number')) throw new TypeError('median expects an array of numbers');
+  if (xs.length === 0 || xs.some(Number.isNaN)) return NaN;
+  const sorted = [...xs].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
