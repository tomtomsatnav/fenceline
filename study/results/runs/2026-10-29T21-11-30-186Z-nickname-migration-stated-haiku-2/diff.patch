+ * Years are zero-padded to four digits, so year 42 gives "0042-…".
+ * @param {Date} date
+ * @returns {string}
+ * @throws {TypeError} when date is not a Date
+ * @throws {RangeError} when date is invalid, or its UTC year is outside 0 to 9999
+ */
+exports.formatIsoDate = (date) => {
+  assertValidDate(date, 'formatIsoDate');
+  const year = date.getUTCFullYear();
+  if (year < 0 || year > 9999) throw new RangeError('formatIsoDate supports years 0 to 9999');
+  const pad = (n, width) => String(n).padStart(width, '0');
