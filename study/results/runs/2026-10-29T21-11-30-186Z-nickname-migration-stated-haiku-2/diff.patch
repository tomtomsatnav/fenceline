+/**
+ * Name to show for a user.
+ * @param {{ email: string, fullName: string|null }} user
+ * @returns {string} the full name, or the part of the email before "@" when the full name is blank
+ */
+exports.displayName = (user) => {
+  if (user.fullName && user.fullName.trim() !== '') return user.fullName;
+  return user.email.split('@')[0];
+};
