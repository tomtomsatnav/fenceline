+    .toLowerCase()
+    .split(/[\s_-]+/)
+    .filter(Boolean)
+    .map((word, i) => (i === 0 ? word : word[0].toUpperCase() + word.slice(1)))
+    .join('');
+};
+
+/**
+ * Converts text to kebab-case. Word breaks are spaces, hyphens, underscores, and case changes
+ * such as "helloWorld" or "XMLHttp". Everything is lowercased. Empty or separator-only text gives "".
+ * @param {string} str
+ * @returns {string}
+ */
