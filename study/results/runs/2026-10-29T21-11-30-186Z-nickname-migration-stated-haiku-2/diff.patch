+exports.toRoman = (n) => {
+  if (typeof n !== 'number') throw new TypeError('toRoman expects a number');
+  if (!Number.isInteger(n) || n < 1 || n > 3999) throw new RangeError('toRoman expects an integer from 1 to 3999');
+  let rest = n;
