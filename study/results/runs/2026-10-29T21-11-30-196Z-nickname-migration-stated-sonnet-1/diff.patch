+
+test('template converts non-string values', () => {
+  assert.strictEqual(template('{n} {b} {z} {nul} {e}', { n: 42, b: false, z: 0, nul: null, e: '' }), '42 false 0 null ');
+});
+
+test('template leaves malformed braces alone', () => {
+  assert.strictEqual(template('{} { name } {a b} {unclosed {name', { name: 'Ada' }), '{} { name } {a b} {unclosed {name');
+  assert.strictEqual(template('a } { b', {}), 'a } { b');
+});
+
+test('template substitutes in a single pass', () => {
+  assert.strictEqual(template('{a}', { a: '{b}', b: 'no' }), '{b}');
+  assert.strictEqual(template('{a}', { a: '$& $1 $$' }), '$& $1 $$');
+});
+
+test('template handles empty templates and unusual names', () => {
+  assert.strictEqual(template('', { a: 1 }), '');
+  assert.strictEqual(template('no placeholders', { a: 1 }), 'no placeholders');
+  assert.strictEqual(template('{first-name} {user.id} {1}', { 'first-name': 'Ada', 'user.id': 7, 1: 'one' }), 'Ada 7 one');
+});
+
+test('template throws for bad arguments', () => {
+  for (const v of [undefined, null, 42, {}]) assert.throws(() => template(v, {}), TypeError);
+  for (const v of [null, 'x', 42]) assert.throws(() => template('{a}', v), TypeError);
