+const { types } = require('node:util');
+
+/**
+ * Returns a new Date n calendar days after date (before it, if n is negative). Days are local calendar days,
+ * so the time of day is kept even when a daylight saving change makes a day 23 or 25 hours long:
+ * 12:00 on the day before a spring-forward is 12:00 on the day after, 23 hours later. Month and year ends
+ * roll over normally (Jan 31 + 1 is Feb 1, Feb 28 + 1 is Feb 29 in leap years). The given Date is not modified.
+ * @param {Date} date a valid Date
+ * @param {number} n a whole number of days; may be negative or 0
+ * @returns {Date} a new Date
+ * @throws {TypeError} if date is not a Date or n is not a number
+ * @throws {RangeError} if date is an Invalid Date, n is not an integer, or the result is beyond the range
+ *   JavaScript dates can represent (about ±275,760 years)
+ */
+exports.addDays = (date, n) => {
+  if (!types.isDate(date)) throw new TypeError('addDays: date must be a Date');
+  if (typeof n !== 'number') throw new TypeError('addDays: n must be a number');
+  if (Number.isNaN(date.getTime())) throw new RangeError('addDays: date must be a valid Date');
+  if (!Number.isInteger(n)) throw new RangeError('addDays: n must be an integer');
+  const result = new Date(date.getTime());
+  result.setDate(result.getDate() + n);
+  if (Number.isNaN(result.getTime())) throw new RangeError('addDays: the result is out of range');
+  return result;
+};
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+/**
+ * Number of whole days from a to b, counting UTC calendar days and ignoring the time of day: it is the
+ * difference between the two UTC dates, so 23:59 on one day to 00:01 on the next is 1 day, while 00:00 to
+ * 23:59 on the same day is 0. The result is positive when b is later than a, negative when it is earlier, and
+ * 0 for the same UTC date. The local time zone plays no part. Neither Date is modified.
+ * @param {Date} a start
+ * @param {Date} b end
+ * @returns {number} an integer
+ * @throws {TypeError} if a or b is not a Date
+ * @throws {RangeError} if a or b is an Invalid Date
+ */
+exports.daysBetween = (a, b) => {
+  for (const [name, d] of [['a', a], ['b', b]]) {
+    if (!types.isDate(d)) throw new TypeError(`daysBetween: ${name} must be a Date`);
+    if (Number.isNaN(d.getTime())) throw new RangeError(`daysBetween: ${name} must be a valid Date`);
+  }
+  // Days since 1970-01-01 UTC. Math.floor keeps dates before 1970 on the right day, and unlike Date.UTC
+  // it does not remap years 0-99 to 1900-1999.
+  return Math.floor(b.getTime() / MS_PER_DAY) - Math.floor(a.getTime() / MS_PER_DAY);
+};
+
+/**
+ * Tells whether a date falls on a Saturday or Sunday in UTC, whatever the local time zone is:
+ * 2024-01-06T23:59:59.999Z is a weekend day and 2024-01-08T00:00:00.000Z (a Monday) is not. A date written
+ * with another offset counts as its UTC moment, so "2024-01-05T23:30:00-05:00" (04:30 UTC on Saturday) is a
+ * weekend day. The Date is not modified.
+ * @param {Date} date
+ * @returns {boolean}
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is an Invalid Date
+ */
+exports.isWeekend = (date) => {
+  if (!types.isDate(date)) throw new TypeError('isWeekend: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('isWeekend: date must be a valid Date');
+  const day = date.getUTCDay(); // 0 is Sunday, 6 is Saturday
+  return day === 0 || day === 6;
+};
+
+/**
+ * Returns the start of the week containing date, taking weeks to run from Monday to Sunday in UTC: the
+ * Monday at 00:00:00.000 UTC on or before it. startOfWeek(2024-01-07T23:59:59.999Z), a Sunday, is
+ * 2024-01-01T00:00:00.000Z, and a Monday at exactly midnight is its own week start. The local time zone plays
+ * no part, and a date written with another offset counts as its UTC moment. The given Date is not modified.
+ * @param {Date} date
+ * @returns {Date} a new Date
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is an Invalid Date, or its week starts before the earliest date JavaScript can
+ *   represent (the first few days of year -271821)
+ */
+exports.startOfWeek = (date) => {
+  if (!types.isDate(date)) throw new TypeError('startOfWeek: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('startOfWeek: date must be a valid Date');
+  const sinceMonday = (date.getUTCDay() + 6) % 7; // getUTCDay() is 0 for Sunday, so Monday is 0 and Sunday is 6
+  const start = new Date((Math.floor(date.getTime() / MS_PER_DAY) - sinceMonday) * MS_PER_DAY);
+  if (Number.isNaN(start.getTime())) throw new RangeError('startOfWeek: the start of the week is out of range');
+  return start;
+};
+
+/**
+ * Formats a Date as its UTC calendar date, YYYY-MM-DD: formatIsoDate(new Date("2024-01-06T23:59:59Z")) is
+ * "2024-01-06". The local time zone plays no part, and a date written with another offset counts as its UTC
+ * moment. Years 0-9999 have four digits ("0050-01-01"). Other years use the extended form that
+ * Date.prototype.toISOString uses, a sign and six digits: "+010000-01-01" and "-000001-12-31". Every result is
+ * understood by new Date(...), which reads it back as midnight UTC. The Date is not modified.
+ * @param {Date} date
+ * @returns {string}
+ * @throws {TypeError} if date is not a Date
+ * @throws {RangeError} if date is an Invalid Date
+ */
+exports.formatIsoDate = (date) => {
+  if (!types.isDate(date)) throw new TypeError('formatIsoDate: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('formatIsoDate: date must be a valid Date');
+  const iso = date.toISOString(); // "2024-01-06T12:00:00.000Z", or with a +/-YYYYYY year
+  return iso.slice(0, iso.indexOf('T'));
+};
+
+// YYYY-MM-DD, or the extended form with a sign and six digits for years outside 0-9999.
+const ISO_DATE = /^(?:([0-9]{4})|([+-][0-9]{6}))-([0-9]{2})-([0-9]{2})$/;
+
+/**
+ * Parses a calendar date written as YYYY-MM-DD into a Date at 00:00:00.000 UTC: parseIsoDate("2024-01-06")
+ * is 2024-01-06T00:00:00.000Z. This is the inverse of formatIsoDate, so the extended form it writes for years
+ * outside 0-9999 ("+010000-01-01", "-000001-12-31") is accepted too. The date must exist: months run 1-12 and
+ * the day must fit the month, with leap years counted properly, so "2026-02-30" and "2023-02-29" are errors
+ * (JavaScript's own Date would quietly turn them into March). Nothing else is accepted: no spaces, no time
+ * of day, no missing zeros ("2024-1-6"), no "20240106", and no "-000000" year. Each call returns a new Date.
+ * @param {string} str
+ * @returns {Date} midnight UTC at the start of that date
+ * @throws {TypeError} if str is not a string
+ * @throws {RangeError} if str is not a valid date in that form, or is beyond the range JavaScript dates
+ *   can represent (+275760-09-13 is the last day, -271821-04-20 the first)
+ */
+exports.parseIsoDate = (str) => {
+  if (typeof str !== 'string') throw new TypeError('parseIsoDate: str must be a string');
+  const match = ISO_DATE.exec(str);
+  if (!match || match[2] === '-000000') throw new RangeError(`parseIsoDate: invalid date ${JSON.stringify(str)}`);
+  const year = Number(match[1] ?? match[2]);
+  const month = Number(match[3]);
+  const day = Number(match[4]);
+  const date = new Date(0);
+  date.setUTCFullYear(year, month - 1, day); // unlike the Date constructor, keeps years 0-99 as they are
+  // An impossible day or month rolls over into the next one (or the date is out of range); reading it back catches both.
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+    throw new RangeError(`parseIsoDate: invalid date ${JSON.stringify(str)}`);
+  }
+  return date;
+};
+
+/**
+ * Age in whole years on a given day: how many birthdays someone born on birthDate has had by date.
+ * ageOn(1990-05-15, 2024-05-14) is 33 and ageOn(1990-05-15, 2024-05-15) is 34. Both are read as UTC calendar
+ * dates and the time of day is ignored, so only the day, month and year count. Someone born on February 29
+ * has their birthday on March 1 in years that are not leap years (so they turn 1 on March 1 of the next year,
+ * not February 28). A date before birthDate is an error, since nobody has a negative age. Neither Date is
+ * modified.
+ * @param {Date} birthDate
+ * @param {Date} date the day to work out the age on, not before birthDate
+ * @returns {number} an integer, 0 or more
+ * @throws {TypeError} if birthDate or date is not a Date
+ * @throws {RangeError} if either is an Invalid Date, or date is on an earlier UTC day than birthDate
+ */
+exports.ageOn = (birthDate, date) => {
+  for (const [name, d] of [['birthDate', birthDate], ['date', date]]) {
+    if (!types.isDate(d)) throw new TypeError(`ageOn: ${name} must be a Date`);
+    if (Number.isNaN(d.getTime())) throw new RangeError(`ageOn: ${name} must be a valid Date`);
+  }
+  const [by, bm, bd] = [birthDate.getUTCFullYear(), birthDate.getUTCMonth(), birthDate.getUTCDate()];
+  const [y, m, d] = [date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()];
+  // Months and days compare as plain numbers, so February 29 is "after" February 28 and the birthday of
+  // someone born on it falls on March 1 in a non-leap year.
+  const beforeBirthday = m < bm || (m === bm && d < bd);
+  if (y < by || (y === by && beforeBirthday)) throw new RangeError('ageOn: date must not be before birthDate');
+  return y - by - (beforeBirthday ? 1 : 0);
+};
+
+// Largest first. A month is 30 days and a year 365, so the phrases are approximate for long spans.
+const RELATIVE_UNITS = [
+  ['year', 365 * MS_PER_DAY],
+  ['month', 30 * MS_PER_DAY],
+  ['week', 7 * MS_PER_DAY],
+  ['day', MS_PER_DAY],
+  ['hour', 60 * 60 * 1000],
+  ['minute', 60 * 1000],
+  ['second', 1000],
+];
+
+/**
+ * Describes how far date is from now in words: "3 minutes ago" for the past, "in 2 days" for the future.
+ * It goes by elapsed time, using the largest unit that fits (seconds, minutes, hours, days, weeks, months of
+ * 30 days, years of 365 days) and counting whole units, rounding down: 119 seconds is "1 minute ago" and
+ * 23 hours 59 minutes is "23 hours ago". The number is never 0 or plural for 1 ("1 day ago", "in 1 hour"), and
+ * anything less than a second away, in either direction, is "just now". Neither Date is modified.
+ * @param {Date} date the moment to describe
+ * @param {Date} [now=new Date()] the moment to compare it with; pass one for repeatable results
+ * @returns {string}
+ * @throws {TypeError} if date or now is not a Date
+ * @throws {RangeError} if date or now is an Invalid Date
+ */
+exports.relativeTime = (date, now = new Date()) => {
+  for (const [name, d] of [['date', date], ['now', now]]) {
+    if (!types.isDate(d)) throw new TypeError(`relativeTime: ${name} must be a Date`);
+    if (Number.isNaN(d.getTime())) throw new RangeError(`relativeTime: ${name} must be a valid Date`);
+  }
+  const diff = date.getTime() - now.getTime();
+  const elapsed = Math.abs(diff);
+  const unit = RELATIVE_UNITS.find(([, ms]) => elapsed >= ms);
+  if (!unit) return 'just now';
+  const count = Math.floor(elapsed / unit[1]);
+  const phrase = `${count} ${unit[0]}${count === 1 ? '' : 's'}`;
+  return diff < 0 ? `${phrase} ago` : `in ${phrase}`;
+};
