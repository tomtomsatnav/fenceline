+
+test('kebabCase ignores repeated, leading and trailing separators', () => {
+  assert.strictEqual(kebabCase('  hello   world  '), 'hello-world');
+  assert.strictEqual(kebabCase('--hello__world--'), 'hello-world');
+  assert.strictEqual(kebabCase('hello \t\n world'), 'hello-world');
