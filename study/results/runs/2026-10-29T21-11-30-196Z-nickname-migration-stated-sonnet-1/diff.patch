@@ -0,0 +1,78 @@
+const { listUsers, getUser, getUserByEmail } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+const field = (v) => {
+  const s = v ?? '';
+  return /[",\r\n]/.test(s) ? `"${String(s).replaceAll('"', '""')}"` : String(s);
+};
+
+/**
+ * Exports all users as CSV: a header row, then one row per user, oldest first.
+ * Fields containing commas, quotes or newlines are quoted.
+ * @param {import('../db.js').Db} db
+ * @returns {string}
+ */
+exports.exportUsersCsv = (db) => {
+  if (db === undefined || db === null) throw new Error('exportUsersCsv: db is required');
+  const rows = listUsers(db).map((u) => COLUMNS.map((c) => field(u[c])).join(','));
+  return [COLUMNS.join(','), ...rows].join('\n') + '\n';
+};
+
+// Parses CSV text (quoted fields, "" escapes, newlines inside quotes, \n or \r\n rows) into arrays of fields.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let cur = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const ch = text[i];
+    if (quoted) {
+      if (ch !== '"') cur += ch;
+      else if (text[i + 1] === '"') { cur += '"'; i++; } else quoted = false;
+    } else if (ch === '"') quoted = true;
+    else if (ch === ',') { row.push(cur); cur = ''; }
+    else if (ch === '\n' || ch === '\r') {
+      if (ch === '\r' && text[i + 1] === '\n') i++;
+      row.push(cur); rows.push(row); row = []; cur = '';
+    } else cur += ch;
+  }
+  if (quoted) throw new Error('importUsersCsv: unterminated quoted field');
+  if (cur !== '' || row.length) { row.push(cur); rows.push(row); }
+  return rows;
+};
+
+// Validates every row first, then inserts them all, so a bad file imports nothing. Returns the number imported.
+/**
+ * Imports users from CSV in the format exportUsersCsv writes, keeping ids and timestamps.
+ * @param {import('../db.js').Db} db
+ * @param {string} csv
+ * @returns {number} how many users were imported
+ * @throws {Error} if the header or any row is invalid or duplicates an existing user; nothing is imported then
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (db === undefined || db === null) throw new Error('importUsersCsv: db is required');
+  if (typeof csv !== 'string') throw new Error('importUsersCsv: csv must be a string');
+  const [header, ...records] = parseCsv(csv);
+  if (!header || header.join(',') !== COLUMNS.join(',')) throw new Error(`importUsersCsv: header must be ${COLUMNS.join(',')}`);
+  const ids = new Set();
+  const emails = new Set();
+  const rows = records.map((rec, i) => {
+    const where = `importUsersCsv: row ${i + 2}`;
+    if (rec.length !== COLUMNS.length) throw new Error(`${where}: expected ${COLUMNS.length} fields`);
+    const [id, email, fullName, createdAt, lastLogin] = rec;
+    if (!id) throw new Error(`${where}: missing id`);
+    if (!email.includes('@')) throw new Error(`${where}: invalid email`);
+    if (fullName.length === 0 || fullName.length > 100) throw new Error(`${where}: invalid fullName`);
+    if (Number.isNaN(Date.parse(createdAt))) throw new Error(`${where}: invalid createdAt`);
+    if (lastLogin && Number.isNaN(Date.parse(lastLogin))) throw new Error(`${where}: invalid lastLogin`);
+    const key = email.toLowerCase();
+    if (ids.has(id) || getUser(db, id)) throw new Error(`${where}: duplicate id ${id}`);
+    if (emails.has(key) || getUserByEmail(db, email)) throw new Error(`${where}: duplicate email ${email}`);
+    ids.add(id);
+    emails.add(key);
+    return { id, email, fullname: fullName, created_at: createdAt, ...(lastLogin && { last_login: lastLogin }) };
+  });
+  for (const row of rows) db.insert('users', row);
+  return rows.length;
+};
