+exports.mean = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('mean: xs must be an array');
+  const n = xs.length;
+  for (let i = 0; i < n; i++) {
+    if (typeof xs[i] !== 'number') throw new TypeError(`mean: item ${i} must be a number`);
+  }
+  if (n === 0) return NaN;
+  if (!xs.every(Number.isFinite)) return xs.reduce((a, b) => a + b, 0) / n;
+  const sum = compensatedSum(xs);
+  return Number.isFinite(sum) ? sum / n : compensatedSum(xs.map((x) => x / n)); // sum overflowed: divide first
+};
+
+// Validates an array of numbers and returns a sorted copy (NaN, if any, sorts last).
+const sortedCopy = (name, xs) => {
+  if (!Array.isArray(xs)) throw new TypeError(`${name}: xs must be an array`);
+  for (let i = 0; i < xs.length; i++) {
+    if (typeof xs[i] !== 'number') throw new TypeError(`${name}: item ${i} must be a number`);
+  }
+  return [...xs].sort((a, b) => (a < b ? -1 : a > b ? 1 : a === a ? (b === b ? 0 : -1) : b === b ? 1 : 0));
