+  assert.strictEqual(getPath({ a: { '': 2 } }, 'a.'), 2);
+  assert.strictEqual(getPath({ a: { '': { b: 3 } } }, 'a..b'), 3);
+  assert.strictEqual(getPath({ a: 1 }, '', 'none'), 'none');
+  assert.strictEqual(getPath({ a: { b: 1 } }, '.a', 'none'), 'none');
+});
+
+test('getPath has no bracket syntax and treats numbers in strings as plain keys', () => {
+  assert.strictEqual(getPath({ list: [1] }, 'list[0]', 'none'), 'none');
+  assert.strictEqual(getPath({ 'list[0]': 'literal' }, 'list[0]'), 'literal');
+  assert.strictEqual(getPath({ 1: 'one' }, '1'), 'one');
+});
+
+test('getPath accepts an array of keys, which can contain dots', () => {
+  const obj = { 'a.b': 1, a: { b: 2 }, list: [{ id: 'x' }] };
+  assert.strictEqual(getPath(obj, ['a.b']), 1);
+  assert.strictEqual(getPath(obj, 'a.b'), 2);
+  assert.strictEqual(getPath(obj, ['a', 'b']), 2);
+  assert.strictEqual(getPath(obj, ['list', 0, 'id']), 'x');
+  assert.strictEqual(getPath(obj, ['list', '0', 'id']), 'x');
+  assert.strictEqual(getPath(obj, ['a', 'missing'], 'none'), 'none');
+  assert.strictEqual(getPath({ '': 1 }, ['']), 1);
+});
+
+test('getPath with an empty array returns the object itself', () => {
+  const obj = { a: 1 };
+  assert.strictEqual(getPath(obj, []), obj);
+  assert.strictEqual(getPath(null, []), null);
+  assert.strictEqual(getPath(5, []), 5);
+});
+
+test('getPath accepts symbol keys in an array path', () => {
+  const s = Symbol('s');
+  assert.strictEqual(getPath({ [s]: { x: 1 } }, [s, 'x']), 1);
+  assert.strictEqual(getPath({ x: 1 }, [s], 'none'), 'none');
+});
+
+test('getPath works on null-prototype objects and functions', () => {
+  const bare = Object.create(null);
+  bare.a = { b: 1 };
+  assert.strictEqual(getPath(bare, 'a.b'), 1);
+  assert.strictEqual(getPath(bare, 'toString', 'none'), 'none');
+  const fn = () => {};
+  fn.config = { debug: true };
+  assert.strictEqual(getPath({ fn }, 'fn.config.debug'), true);
+  assert.strictEqual(getPath(fn, 'name'), 'fn');
+});
+
+test('getPath reads a getter', () => {
+  let reads = 0;
+  const obj = {};
+  Object.defineProperty(obj, 'computed', { get() { reads++; return { value: 42 }; }, enumerable: true });
+  assert.strictEqual(getPath(obj, 'computed.value'), 42);
+  assert.strictEqual(reads, 1);
+});
+
+test('getPath does not modify the object or the path array', () => {
+  const obj = { a: { b: [1, 2] } };
+  const path = ['a', 'b', 1];
+  getPath(obj, path);
+  getPath(obj, 'a.b.5', 'x');
+  assert.deepStrictEqual(obj, { a: { b: [1, 2] } });
+  assert.deepStrictEqual(path, ['a', 'b', 1]);
+});
+
+test('getPath follows very long paths', () => {
+  let nested = { leaf: 'found' };
+  for (let i = 0; i < 100000; i++) nested = { child: nested };
+  assert.strictEqual(getPath(nested, `${'child.'.repeat(100000)}leaf`), 'found');
+  assert.strictEqual(getPath(nested, [...Array(100000).fill('child'), 'leaf']), 'found');
+  assert.strictEqual(getPath(nested, `${'child.'.repeat(100001)}leaf`, 'none'), 'none');
+});
+
+test('getPath throws a TypeError when path is not a string or an array', () => {
+  for (const v of [undefined, null, 5, {}, true, Symbol('s'), 1n, new String('a')]) assert.throws(() => getPath({ a: 1 }, v), TypeError);
+});
+
+test('getPath throws a TypeError for an array path item that is not a string, number or symbol', () => {
+  for (const v of [undefined, null, true, {}, ['a'], 1n, () => 'a']) assert.throws(() => getPath({ a: 1 }, ['a', v]), TypeError);
+  assert.throws(() => getPath({ a: 1 }, [, 'a']), TypeError); // eslint-disable-line no-sparse-arrays
+  assert.throws(() => getPath(null, [null]), TypeError); // a bad path is an error even when there is nothing to read
+});
