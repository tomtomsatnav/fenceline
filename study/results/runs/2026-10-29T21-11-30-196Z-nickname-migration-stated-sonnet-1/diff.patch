+});
+
+test('camelCase ignores repeated, leading and trailing separators', () => {
+  assert.strictEqual(camelCase('  hello   world  '), 'helloWorld');
+  assert.strictEqual(camelCase('--hello__world--'), 'helloWorld');
+  assert.strictEqual(camelCase('hello \t\n world'), 'helloWorld');
+});
+
+test('camelCase normalizes case', () => {
+  assert.strictEqual(camelCase('HELLO WORLD'), 'helloWorld');
+  assert.strictEqual(camelCase('Hello World'), 'helloWorld');
+});
+
+test('camelCase is idempotent and splits existing case boundaries', () => {
+  assert.strictEqual(camelCase('helloWorld'), 'helloWorld');
+  assert.strictEqual(camelCase('HelloWorld'), 'helloWorld');
+  assert.strictEqual(camelCase('XMLHttpRequest'), 'xmlHttpRequest');
+});
+
+test('camelCase handles single words, empty input and no word characters', () => {
+  assert.strictEqual(camelCase('hello'), 'hello');
+  assert.strictEqual(camelCase('Hello'), 'hello');
+  assert.strictEqual(camelCase(''), '');
+  assert.strictEqual(camelCase('   '), '');
+  assert.strictEqual(camelCase('-_-'), '');
