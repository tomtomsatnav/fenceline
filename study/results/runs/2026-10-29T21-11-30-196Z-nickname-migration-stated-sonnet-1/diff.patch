+
+test('countWords treats punctuation as separators', () => {
+  assert.strictEqual(countWords('Hello, world!'), 2);
+  assert.strictEqual(countWords('well-known snake_case'), 4);
+  assert.strictEqual(countWords("don't"), 2);
+  assert.strictEqual(countWords('a...b'), 2);
