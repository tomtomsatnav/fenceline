+ * NaN in the input, because the numbers cannot be put in order. Infinities sort as expected, and a mean of
+ * +Infinity and -Infinity is NaN. The two middle values are averaged like mean does, so huge finite numbers
+ * do not overflow. The input is not modified.
+ * @param {number[]} xs
+ * @returns {number}
+ * @throws {TypeError} if xs is not an array, or has an item that is not a number (a hole counts as undefined)
+ */
+exports.median = (xs) => {
+  const sorted = sortedCopy('median', xs);
+  const n = sorted.length;
+  if (n === 0 || Number.isNaN(sorted[n - 1])) return NaN;
+  const mid = n >> 1;
+  return n % 2 ? sorted[mid] : exports.mean([sorted[mid - 1], sorted[mid]]);
