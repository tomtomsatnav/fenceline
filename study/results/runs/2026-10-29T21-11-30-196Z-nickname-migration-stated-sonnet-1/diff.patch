+/**
+ * Splits an array into consecutive chunks of length n; the last chunk may be shorter.
+ * The input is not modified and the chunks are new arrays (the elements themselves are not copied).
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n chunk length: a positive integer, or Infinity for a single chunk
+ * @returns {T[][]} the chunks; empty if xs is empty
+ * @throws {TypeError} if xs is not an array
+ * @throws {RangeError} if n is not a positive integer or Infinity
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk: xs must be an array');
+  if (n !== Infinity && !(Number.isInteger(n) && n >= 1)) throw new RangeError('chunk: n must be a positive integer');
+  const chunks = [];
+  for (let i = 0; i < xs.length; i += n) chunks.push(xs.slice(i, i + n));
+  return chunks;
+};
+
+/**
+ * Keeps the first item for each key, in the original order: uniqueBy(users, (u) => u.email).
+ * Keys are compared like Set members (SameValueZero), so NaN equals NaN, 0 equals -0, and objects match
+ * only by identity. keyFn is called once per item, in order, with (item, index). The input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => unknown} keyFn
+ * @returns {T[]} a new array
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('uniqueBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('uniqueBy: keyFn must be a function');
+  const seen = new Set();
+  return xs.filter((x, i) => {
+    const key = keyFn(x, i);
+    if (seen.has(key)) return false;
+    seen.add(key);
+    return true;
+  });
+};
+
+/**
+ * Groups items into arrays by key: groupBy([1, 2, 3], (n) => n % 2 ? "odd" : "even") is
+ * { odd: [1, 3], even: [2] }. Within a group items keep their original order. Keys become property keys
+ * as usual, so 1 and "1" share a group, and integer-like keys come first in ascending order when enumerated.
+ * Any key is safe, including "__proto__" and "constructor": each becomes an ordinary own property.
+ * keyFn is called once per item, in order, with (item, index). The input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => PropertyKey} keyFn
+ * @returns {Record<PropertyKey, T[]>} a new plain object; empty if xs is empty
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy: keyFn must be a function');
+  const groups = {};
+  xs.forEach((x, i) => {
+    const key = keyFn(x, i);
+    if (Object.hasOwn(groups, key)) groups[key].push(x);
+    else Object.defineProperty(groups, key, { value: [x], writable: true, enumerable: true, configurable: true });
+  });
+  return groups;
+};
+
+/**
+ * Splits an array in two by a predicate: partition([1, 2, 3, 4], (n) => n % 2 === 0) is [[2, 4], [1, 3]].
+ * Items are matched by truthiness of pred's result and keep their original order in both arrays.
+ * pred is called once per item, in order, with (item, index). The input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => unknown} pred
+ * @returns {[T[], T[]]} the items for which pred is truthy, then the rest; two new arrays
+ * @throws {TypeError} if xs is not an array or pred is not a function
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition: xs must be an array');
+  if (typeof pred !== 'function') throw new TypeError('partition: pred must be a function');
+  const matching = [];
+  const notMatching = [];
+  xs.forEach((x, i) => (pred(x, i) ? matching : notMatching).push(x));
+  return [matching, notMatching];
+};
+
+/**
+ * Pairs up items by position: zip([1, 2, 3], ["a", "b"]) is [[1, "a"], [2, "b"]].
+ * The result is as long as the shorter array, so extra items in the longer one are dropped.
+ * The inputs are not modified, and the items themselves are not copied.
+ * @template A, B
+ * @param {A[]} a
+ * @param {B[]} b
+ * @returns {[A, B][]} new pairs; empty if either array is empty
+ * @throws {TypeError} if a or b is not an array
+ */
+exports.zip = (a, b) => {
+  if (!Array.isArray(a)) throw new TypeError('zip: a must be an array');
+  if (!Array.isArray(b)) throw new TypeError('zip: b must be an array');
+  const length = Math.min(a.length, b.length);
+  const pairs = [];
+  for (let i = 0; i < length; i++) pairs.push([a[i], b[i]]);
+  return pairs;
+};
+
+/**
+ * Numbers from start up to but not including end, stepping by step: range(0, 5) is [0, 1, 2, 3, 4] and
+ * range(5, 0, -2) is [5, 3, 1]. If step points away from end (or start equals end) the result is empty.
+ * Each value is computed as start + i * step, so fractional steps do not accumulate error, though they can
+ * still show ordinary floating-point noise (range(0, 1, 0.1)[3] is 0.30000000000000004).
+ * @param {number} start first value
+ * @param {number} end limit, never included
+ * @param {number} [step=1] non-zero; negative to count down
+ * @returns {number[]}
+ * @throws {TypeError} if start, end or step is not a number
+ * @throws {RangeError} if any of them is NaN or infinite, step is 0, or the result would be longer than an array can be
+ */
+exports.range = (start, end, step = 1) => {
+  for (const [name, v] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof v !== 'number') throw new TypeError(`range: ${name} must be a number`);
+    if (!Number.isFinite(v)) throw new RangeError(`range: ${name} must be finite`);
+  }
+  if (step === 0) throw new RangeError('range: step must not be 0');
+  const count = Math.max(0, Math.ceil((end - start) / step));
+  if (count > 2 ** 32 - 1) throw new RangeError('range: too many values');
+  return Array.from({ length: count }, (_, i) => start + i * step);
+};
+
+/**
+ * Flattens arbitrarily nested arrays into one array, in depth-first order: flattenDeep([1, [2, [3, [4]]]])
+ * is [1, 2, 3, 4]. Only real arrays are flattened; strings, array-likes and other objects are kept as
+ * items. Holes in sparse arrays are skipped. Nesting depth is not limited by the call stack. The same array
+ * may appear more than once, but an array that contains itself (directly or not) throws. The input is not
+ * modified.
+ * @param {unknown[]} xs
+ * @returns {unknown[]} a new, flat array
+ * @throws {TypeError} if xs is not an array, or the nesting is circular
+ */
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep: xs must be an array');
+  const out = [];
+  const path = new Set([xs]); // arrays currently being walked, to catch cycles
+  const stack = [[xs, 0]];
+  while (stack.length) {
+    const frame = stack[stack.length - 1];
+    const [arr, i] = frame;
+    if (i >= arr.length) {
+      path.delete(arr);
+      stack.pop();
+      continue;
+    }
+    frame[1]++;
+    if (!(i in arr)) continue;
+    const item = arr[i];
+    if (!Array.isArray(item)) out.push(item);
+    else if (path.has(item)) throw new TypeError('flattenDeep: xs contains a circular reference');
+    else {
+      path.add(item);
+      stack.push([item, 0]);
+    }
+  }
+  return out;
+};
+
+// Orders keys of different types: numbers (incl. bigints), strings, booleans, dates, null, then undefined.
+const KEY_RANK = { number: 0, bigint: 0, string: 1, boolean: 2 };
+
+// Turns a key into { rank, value } so that keys compare with rank first, then value.
+const sortKey = (key) => {
+  if (key === undefined) return { rank: 5 };
+  if (key === null) return { rank: 4 };
+  if (key instanceof Date) return { rank: 3, value: key.getTime() };
+  const rank = KEY_RANK[typeof key];
+  if (rank === undefined) throw new TypeError('sortBy: keys must be numbers, bigints, strings, booleans, dates, null or undefined');
+  return { rank, value: rank === 2 ? Number(key) : key };
+};
+
+const compareKeys = (a, b) => {
+  if (a.rank !== b.rank) return a.rank - b.rank;
+  if (a.rank >= 4) return 0;
+  const aNaN = a.value !== a.value; // NaN (and invalid dates) sort after every other value of their type
+  const bNaN = b.value !== b.value;
+  if (aNaN || bNaN) return aNaN - bNaN;
+  return a.value < b.value ? -1 : a.value > b.value ? 1 : 0;
+};
+
+/**
+ * Returns a new array sorted ascending by key, leaving xs untouched: sortBy(users, (u) => u.name).
+ * The sort is stable: items with equal keys keep their original order. keyFn is called once per item,
+ * in order, with (item, index). Keys may be numbers, bigints, strings, booleans, Dates, null or undefined;
+ * anything else throws. Within a type, numbers and dates sort by value, strings by UTF-16 code unit
+ * (not by locale), and false before true. NaN and invalid dates sort after the other values of their type.
+ * Mixed types sort in this order: numbers, strings, booleans, dates, null, undefined. Holes in sparse
+ * arrays are skipped. To sort descending, use a negated number key or reverse the result.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => number|bigint|string|boolean|Date|null|undefined} keyFn
+ * @returns {T[]} a new array
+ * @throws {TypeError} if xs is not an array, keyFn is not a function, or a key is of an unsupported type
+ */
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('sortBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('sortBy: keyFn must be a function');
+  const entries = [];
+  xs.forEach((item, i) => entries.push({ item, key: sortKey(keyFn(item, i)), i }));
+  entries.sort((a, b) => compareKeys(a.key, b.key) || a.i - b.i);
+  return entries.map((e) => e.item);
+};
+
+/**
+ * Returns one item chosen uniformly at random, or undefined if xs is empty (rng is not called then).
+ * The item at index floor(rng() * xs.length) is returned, so a seeded rng gives repeatable picks.
+ * The input is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {() => number} [rng=Math.random] returns a number from 0 up to but not including 1
+ * @returns {T|undefined}
