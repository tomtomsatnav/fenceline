+});
+
+test('padCenter throws for bad arguments', () => {
+  for (const v of [undefined, null, 42]) assert.throws(() => padCenter(v, 5), TypeError);
+  for (const ch of [null, 1]) assert.throws(() => padCenter('a', 5, ch), TypeError);
+  for (const w of [-1, 1.5, NaN, Infinity, undefined, '5']) assert.throws(() => padCenter('a', w), RangeError);
+  for (const ch of ['', 'ab']) assert.throws(() => padCenter('a', 5, ch), RangeError);
+});
+
+test('countWords counts words separated by whitespace', () => {
+  assert.strictEqual(countWords('hello'), 1);
+  assert.strictEqual(countWords('hello world'), 2);
+  assert.strictEqual(countWords('the quick brown fox'), 4);
