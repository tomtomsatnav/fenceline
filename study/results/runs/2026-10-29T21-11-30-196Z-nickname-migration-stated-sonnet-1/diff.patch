+  assert.strictEqual(wrap('élan vital', 4), 'élan\nvital');
+});
+
+test('wrap throws for bad arguments', () => {
+  for (const v of [undefined, null, 42, {}]) assert.throws(() => wrap(v, 10), TypeError);
+  for (const w of [0, -1, 1.5, NaN, undefined, null, '10', -Infinity]) assert.throws(() => wrap('a b', w), RangeError);
+});
+
+test('template fills placeholders', () => {
+  assert.strictEqual(template('Hi {name}', { name: 'Ada' }), 'Hi Ada');
+  assert.strictEqual(template('{greeting}, {name}!', { greeting: 'Hello', name: 'Ada' }), 'Hello, Ada!');
+});
+
+test('template fills a repeated placeholder everywhere', () => {
+  assert.strictEqual(template('{x}{x}-{x}', { x: 'ab' }), 'abab-ab');
+});
+
+test('template leaves unknown placeholders as they are', () => {
+  assert.strictEqual(template('Hi {name}, {unknown}', { name: 'Ada' }), 'Hi Ada, {unknown}');
+  assert.strictEqual(template('Hi {name}'), 'Hi {name}');
+  assert.strictEqual(template('Hi {name}', {}), 'Hi {name}');
+  assert.strictEqual(template('Hi {name}', { name: undefined }), 'Hi {name}');
+});
+
+test('template ignores inherited properties', () => {
+  assert.strictEqual(template('{constructor} {toString} {__proto__}', {}), '{constructor} {toString} {__proto__}');
+  assert.strictEqual(template('{a}', Object.create({ a: 'inherited' })), '{a}');
