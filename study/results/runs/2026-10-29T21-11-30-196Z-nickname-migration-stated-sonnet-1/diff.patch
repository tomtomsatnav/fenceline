+
+test('initials returns an empty string when there are no words', () => {
+  assert.strictEqual(initials(''), '');
+  assert.strictEqual(initials('   '), '');
+  assert.strictEqual(initials('--- ...'), '');
+});
+
+test('initials handles digits, accents, combining marks and non-Latin scripts', () => {
+  assert.strictEqual(initials('Room 101'), 'R1');
+  assert.strictEqual(initials('élan vital'), 'ÉV');
+  assert.strictEqual(initials('école normale'), 'ÉN');
+  assert.strictEqual(initials('日本語 テキスト'), '日テ');
+});
+
+test('initials throws a TypeError for non-strings', () => {
+  for (const v of [undefined, null, 42, {}, ['a b']]) assert.throws(() => initials(v), TypeError);
+});
+
+test('reverseWords reverses the order of the words', () => {
+  assert.strictEqual(reverseWords('one two three'), 'three two one');
+  assert.strictEqual(reverseWords('hello world'), 'world hello');
+});
+
+test('reverseWords leaves a single word unchanged', () => {
+  assert.strictEqual(reverseWords('hello'), 'hello');
+});
+
+test('reverseWords keeps single spaces, dropping extra whitespace', () => {
+  assert.strictEqual(reverseWords('  one   two  three  '), 'three two one');
+  assert.strictEqual(reverseWords('one\ttwo\nthree\r\nfour'), 'four three two one');
+  assert.strictEqual(reverseWords('one two'), 'two one');
+});
+
+test('reverseWords keeps punctuation attached to its word', () => {
+  assert.strictEqual(reverseWords('Hello, world!'), 'world! Hello,');
