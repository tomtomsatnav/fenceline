+exports.percentile = (xs, p) => {
+  const sorted = sortedCopy('percentile', xs);
+  if (typeof p !== 'number') throw new TypeError('percentile: p must be a number');
+  if (!(p >= 0 && p <= 100)) throw new RangeError('percentile: p must be from 0 to 100');
+  const n = sorted.length;
+  if (n === 0 || Number.isNaN(sorted[n - 1])) return NaN;
+  const rank = (p * (n - 1)) / 100; // multiplied first so whole ranks come out exact
+  const lo = Math.floor(rank);
+  const hi = Math.ceil(rank);
+  const frac = rank - lo;
+  const a = sorted[lo];
+  const b = sorted[hi];
+  if (frac === 0 || a === b) return a;
+  const gap = b - a;
+  const value = Number.isFinite(gap) ? a + gap * frac : a * (1 - frac) + b * frac; // second form copes with infinite gaps
+  return Math.min(Math.max(value, a), b); // keep rounding from stepping outside the two neighbours
+};
+
