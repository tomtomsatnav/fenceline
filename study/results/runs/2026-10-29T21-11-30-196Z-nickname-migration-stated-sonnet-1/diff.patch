+const compensatedSum = (xs) => {
+  let sum = 0;
+  let lost = 0;
+  for (const x of xs) {
+    const t = sum + x;
+    lost += Math.abs(sum) >= Math.abs(x) ? (sum - t) + x : (x - t) + sum;
+    sum = t;
+  }
+  return sum + lost;
+};
+
+/**
+ * Arithmetic mean of an array of numbers: mean([1, 2, 3, 4]) is 2.5. An empty array gives NaN.
+ * The sum is compensated, so rounding error does not pile up (the mean of ten 0.1s is exactly 0.1, and
+ * mean([1e16, 1, -1e16]) is a third, not 0), and it does not overflow when the numbers are finite but huge
+ * (the mean of [Number.MAX_VALUE, Number.MAX_VALUE] is Number.MAX_VALUE). NaN or an infinity in the input
+ * gives the same result as plain addition would: NaN, or the infinity if there is only one kind.
