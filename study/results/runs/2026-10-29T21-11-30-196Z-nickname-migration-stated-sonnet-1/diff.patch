+
+test('camelCase keeps digits and handles non-ASCII letters', () => {
+  assert.strictEqual(camelCase('version 2 beta'), 'version2Beta');
+  assert.strictEqual(camelCase('hello2world'), 'hello2World');
+  assert.strictEqual(camelCase('élan vital'), 'élanVital');
+});
+
+test('camelCase throws a TypeError for non-strings', () => {
+  for (const v of [undefined, null, 42, {}, ['a b']]) assert.throws(() => camelCase(v), TypeError);
+});
+
+test('kebabCase converts camelCase and spaced words', () => {
+  assert.strictEqual(kebabCase('helloWorld'), 'hello-world');
