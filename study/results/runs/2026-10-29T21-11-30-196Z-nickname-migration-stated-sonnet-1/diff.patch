+/**
+ * Name to show for a user: the fullName, or the part of the email before "@" when fullName is empty.
+ * @param {{ fullName?: string|null, email: string }} user
+ * @returns {string}
+ */
+exports.displayName = (user) => {
+  const name = typeof user.fullName === 'string' ? user.fullName.trim() : '';
+  if (name) return user.fullName;
+  return user.email.split('@')[0];
+};
