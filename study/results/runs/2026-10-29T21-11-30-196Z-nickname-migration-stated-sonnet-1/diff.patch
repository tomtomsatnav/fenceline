+
+test('countWords treats runs of whitespace as one separator', () => {
+  assert.strictEqual(countWords('  hello   world  '), 2);
+  assert.strictEqual(countWords('hello\t\nworld\r\n again'), 3);
+  assert.strictEqual(countWords('hello world'), 2);
