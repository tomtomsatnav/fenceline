+  if (typeof str !== 'string') throw new TypeError('initials: str must be a string');
+  return (str.match(COUNT_WORD) ?? [])
+    .map((w) => segmenter.segment(w)[Symbol.iterator]().next().value.segment.toUpperCase())
+    .join('');
+};
+
+/**
+ * Reverses the order of the words in a sentence: reverseWords("one two three") is "three two one".
+ * Here a word is anything between whitespace, so punctuation stays attached to its word
+ * ("Hello, world!" gives "world! Hello,"). Words are joined by single spaces, and leading, trailing
+ * and repeated whitespace is dropped.
+ * @param {string} str
+ * @returns {string} the words in reverse order; empty if str has no non-whitespace characters
+ * @throws {TypeError} if str is not a string
+ */
+exports.reverseWords = (str) => {
+  if (typeof str !== 'string') throw new TypeError('reverseWords: str must be a string');
+  return str.split(/\s+/).filter(Boolean).reverse().join(' ');
+};
+
+/**
+ * Tells whether a string reads the same backwards, ignoring case and everything that is not a letter
+ * or digit (spaces, punctuation, symbols, emoji). Accented letters compare equal however they are encoded,
+ * and a letter and its accent are never separated. A string with no letters or digits counts as a palindrome.
+ * @param {string} str
+ * @returns {boolean}
+ * @throws {TypeError} if str is not a string
+ */
+exports.isPalindrome = (str) => {
+  if (typeof str !== 'string') throw new TypeError('isPalindrome: str must be a string');
+  const kept = str.normalize('NFC').toLowerCase().replace(/[^\p{L}\p{N}\p{M}]+/gu, '');
+  const chars = Array.from(segmenter.segment(kept), (x) => x.segment);
+  return chars.every((c, i) => c === chars[chars.length - 1 - i]);
+};
+
+const length = (s) => Array.from(segmenter.segment(s)).length;
+
+/**
+ * Inserts line breaks so no line is longer than width, breaking only between words (words are separated
+ * by whitespace). Lines are filled greedily and joined with "\n". Existing line breaks are kept, so blank
+ * lines and paragraphs survive, but runs of spaces and tabs within a line become one space and lines are
+ * trimmed. A word longer than width is never split: it gets a line to itself and overflows. Length is counted
+ * in user-perceived characters, as in truncate.
+ * @param {string} text
+ * @param {number} width maximum line length: a positive integer, or Infinity to only normalize spacing
+ * @returns {string}
+ * @throws {TypeError} if text is not a string
+ * @throws {RangeError} if width is not a positive integer or Infinity
+ */
+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new TypeError('wrap: text must be a string');
+  if (width !== Infinity && !(Number.isInteger(width) && width >= 1)) throw new RangeError('wrap: width must be a positive integer');
+  return text
+    .split(/\r\n|\r|\n/)
+    .flatMap((paragraph) => {
+      const lines = [];
+      let line = '';
+      let lineLength = 0;
+      for (const word of paragraph.split(/\s+/).filter(Boolean)) {
+        const wordLength = length(word);
+        if (line && lineLength + 1 + wordLength <= width) {
+          line += ` ${word}`;
+          lineLength += 1 + wordLength;
+        } else {
+          if (line) lines.push(line);
+          line = word;
+          lineLength = wordLength;
+        }
+      }
+      lines.push(line);
+      return lines;
+    })
+    .join('\n');
+};
+
+// A placeholder is a name in braces; the name has no braces or whitespace, so "{}" and "{a b}" are left alone.
+const PLACEHOLDER = /\{([^{}\s]+)\}/g;
+
+/**
+ * Fills {placeholders} in a string from an object: template("Hi {name}", { name: "Ada" }) is "Hi Ada".
+ * A placeholder is replaced only when values has that key as its own property and the value is not
+ * undefined; otherwise it is left exactly as written. Other values are converted with String(), so
+ * null gives "null". Substitution is a single pass: replaced text is not searched again, and special
+ * replacement patterns such as "$&" in a value are inserted literally.
+ * @param {string} str
+ * @param {Record<string, unknown>} [values]
+ * @returns {string}
+ * @throws {TypeError} if str is not a string, or values is not an object
+ */
+exports.template = (str, values = {}) => {
+  if (typeof str !== 'string') throw new TypeError('template: str must be a string');
+  if (values === null || typeof values !== 'object') throw new TypeError('template: values must be an object');
+  return str.replace(PLACEHOLDER, (match, key) =>
+    Object.hasOwn(values, key) && values[key] !== undefined ? String(values[key]) : match);
+};
diff --git a/test/export.test.js b/test/export.test.js
