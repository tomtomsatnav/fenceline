+  assert.deepStrictEqual(ymd(addDays(new Date(2024, 11, 31), 1)), [2025, 1, 1]);
+  assert.deepStrictEqual(ymd(addDays(new Date(2024, 2, 1), -1)), [2024, 2, 29]);
