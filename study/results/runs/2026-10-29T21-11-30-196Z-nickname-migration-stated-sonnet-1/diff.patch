+
+test('wrap collapses repeated whitespace and trims lines', () => {
+  assert.strictEqual(wrap('  aa   bb \t cc  ', 5), 'aa bb\ncc');
+});
+
+test('wrap keeps existing line breaks and blank lines', () => {
