+  assert.strictEqual(truncate('éééé', 3), 'éé…');
+  assert.strictEqual(truncate('👨‍👩‍👧 family', 3), '👨‍👩‍👧 …');
+});
+
+test('truncate throws for bad arguments', () => {
+  for (const v of [undefined, null, 42, {}]) assert.throws(() => truncate(v, 3), TypeError);
+  for (const n of [-1, 1.5, NaN, undefined, null, '3', -Infinity]) assert.throws(() => truncate('hello', n), RangeError);
+});
+
+test('padCenter centres with spaces by default', () => {
+  assert.strictEqual(padCenter('abc', 7), '  abc  ');
+  assert.strictEqual(padCenter('ab', 6), '  ab  ');
+});
+
+test('padCenter puts the extra character on the right when the padding is odd', () => {
+  assert.strictEqual(padCenter('abc', 6), ' abc  ');
+  assert.strictEqual(padCenter('a', 2), 'a ');
+  assert.strictEqual(padCenter('abc', 6, '*'), '*abc**');
+});
+
+test('padCenter uses the given padding character', () => {
+  assert.strictEqual(padCenter('hi', 6, '-'), '--hi--');
