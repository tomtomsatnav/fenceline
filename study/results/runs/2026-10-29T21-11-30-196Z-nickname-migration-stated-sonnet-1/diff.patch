+    if (kind === 2) return [true, false][random(2)];
+    if (kind === 3) return null;
+    if (kind <= 5) return Array.from({ length: random(3) }, () => value(depth + 1));
+    const o = {};
+    for (let i = random(3); i > 0; i--) o[['x', 'y', 'z'][random(3)]] = value(depth + 1);
+    return o;
