+
+/**
+ * Finds a user by email, ignoring case.
+ * @param {import('../db.js').Db} db
+ * @param {string} email
+ * @returns {User|null} the user, or null if there is none or email is not a string
+ */
+exports.getUserByEmail = (db, email) => {
+  if (typeof email !== 'string') return null;
+  const needle = email.toLowerCase();
+  const r = db.find('users', (u) => typeof u.email === 'string' && u.email.toLowerCase() === needle);
+  return r ? fromRow(r) : null;
+};
+
+/**
+ * Lists users, oldest first.
+ * @param {import('../db.js').Db} db
+ * @param {{ limit?: number, offset?: number }} [page] limit defaults to no limit, offset to 0
+ * @returns {User[]}
+ * @throws {Error} if limit or offset is negative or not an integer
+ */
+exports.listUsers = (db, { limit = Infinity, offset = 0 } = {}) => {
+  if (!(limit === Infinity || Number.isInteger(limit)) || limit < 0) throw new Error('Invalid limit');
+  if (!Number.isInteger(offset) || offset < 0) throw new Error('Invalid offset');
+  const sorted = db.all('users').map(fromRow).sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));
+  return sorted.slice(offset, limit === Infinity ? undefined : offset + limit);
 };
+
+/**
+ * Counts all users.
+ * @param {import('../db.js').Db} db
+ * @returns {number}
+ */
+exports.countUsers = (db) => db.all('users').length;
+
+/**
+ * Sets a user's last login time.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {Date|string|number} [when] defaults to now
+ * @returns {User|null} the updated user, or null if there is no such user
+ */
+exports.recordLogin = (db, id, when = new Date()) => {
+  const changes = toRow({ lastLogin: new Date(when).toISOString() });
+  if (!db.update('users', (u) => u.id === id, changes)) return null;
+  return exports.getUser(db, id);
+};
+
+/**
+ * Changes only the fields given.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {{ email?: string, fullName?: string }} [changes]
+ * @returns {User|null} the updated user, or null if there is no such user
+ * @throws {Error} if email or fullName is invalid, or the email belongs to another user
+ */
+exports.updateUser = (db, id, { email, fullName } = {}) => {
+  if (!exports.getUser(db, id)) return null;
+  if (email !== undefined) {
+    if (typeof email !== 'string' || !email.includes('@')) throw new Error('Invalid email: missing "@"');
+    const owner = exports.getUserByEmail(db, email);
+    if (owner && owner.id !== id) throw new Error(`Duplicate email: ${email}`);
+  }
+  if (fullName !== undefined) assertName('fullName', fullName);
+  db.update('users', (u) => u.id === id, toRow({ email, fullName }));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Removes a user.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
