+/**
+ * Limits x to the range lo..hi (both included): clamp(15, 0, 10) is 10 and clamp(-3, 0, 10) is 0.
+ * The bounds may be infinite, e.g. clamp(x, 0, Infinity) only enforces a minimum. x may be infinite too.
+ * A NaN x gives NaN, so the problem stays visible instead of turning into a bound.
+ * @param {number} x
+ * @param {number} lo lower bound; not NaN, and not greater than hi
+ * @param {number} hi upper bound; not NaN
+ * @returns {number} lo if x < lo, hi if x > hi, otherwise x
+ * @throws {TypeError} if x, lo or hi is not a number
+ * @throws {RangeError} if lo or hi is NaN, or lo is greater than hi
+ */
+exports.clamp = (x, lo, hi) => {
+  for (const [name, v] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof v !== 'number') throw new TypeError(`clamp: ${name} must be a number`);
+  }
+  if (Number.isNaN(lo) || Number.isNaN(hi)) throw new RangeError('clamp: lo and hi must not be NaN');
+  if (lo > hi) throw new RangeError('clamp: lo must not be greater than hi');
+  return Math.max(lo, Math.min(x, hi));
+};
+
+// Moves the decimal point of x by `by` places (x * 10 ** by) through exponent notation, which avoids the
+// rounding error a multiplication would add: shift(1.005, 2) is exactly 100.5, while 1.005 * 100 is 100.49999999999999.
+const shift = (x, by) => {
+  const [mantissa, exponent] = x.toExponential().split('e');
+  return Number(`${mantissa}e${Number(exponent) + by}`);
+};
+
+/**
+ * Rounds x to the given number of decimal places, with halves rounded away from zero:
+ * roundTo(2.5, 0) is 3, roundTo(-2.5, 0) is -3, roundTo(1.005, 2) is 1.01.
+ * Rounding follows the decimal digits of x as JavaScript prints them, not its exact binary value, so
+ * 1.005 rounds to 1.01 (plain Math.round(x * 100) / 100 gives 1). Negative places round to tens, hundreds,
+ * and so on: roundTo(1250, -2) is 1300. NaN and the infinities are returned unchanged, and a result of -0 is
+ * returned as 0.
+ * @param {number} x
+ * @param {number} [places=0] an integer; may be negative
+ * @returns {number}
+ * @throws {TypeError} if x or places is not a number
+ * @throws {RangeError} if places is not an integer
+ */
+exports.roundTo = (x, places = 0) => {
+  if (typeof x !== 'number') throw new TypeError('roundTo: x must be a number');
+  if (typeof places !== 'number') throw new TypeError('roundTo: places must be a number');
+  if (!Number.isInteger(places)) throw new RangeError('roundTo: places must be an integer');
+  if (!Number.isFinite(x)) return x;
+  const shifted = shift(Math.abs(x), places);
+  if (!Number.isFinite(shifted)) return x; // x has no digits that far out, so there is nothing to round
+  const result = Math.sign(x) * shift(Math.round(shifted), -places);
+  return result === 0 ? 0 : result;
