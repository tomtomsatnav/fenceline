+
+test('countWords returns 0 when there are no words', () => {
+  assert.strictEqual(countWords(''), 0);
+  assert.strictEqual(countWords('   \n\t'), 0);
+  assert.strictEqual(countWords('... --- !!!'), 0);
+});
+
+test('countWords counts digits, non-ASCII letters and combining marks', () => {
+  assert.strictEqual(countWords('version 2 beta 3.5'), 5);
