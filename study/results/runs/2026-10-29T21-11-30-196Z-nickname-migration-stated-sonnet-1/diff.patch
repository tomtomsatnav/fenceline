index 0000000..d0b27a3
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,80 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+const HEADER = 'id,email,fullName,createdAt,lastLogin';
+const add = (db, id, email, fullname, created_at, last_login) =>
+  db.insert('users', { id, email, fullname, created_at, ...(last_login && { last_login }) });
+
+test('exportUsersCsv with no users is just the header', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), `${HEADER}\n`);
+});
+
+test('exportUsersCsv writes one row per user, oldest first, empty for no login', () => {
+  const db = migrate(new Db());
+  add(db, 'b', 'bob@example.com', 'Bob', '2024-02-01T00:00:00.000Z', '2024-03-01T00:00:00.000Z');
+  add(db, 'a', 'ada@example.com', 'Ada', '2024-01-01T00:00:00.000Z');
+  assert.strictEqual(exportUsersCsv(db), [
+    HEADER,
+    'a,ada@example.com,Ada,2024-01-01T00:00:00.000Z,',
+    'b,bob@example.com,Bob,2024-02-01T00:00:00.000Z,2024-03-01T00:00:00.000Z',
+    '',
+  ].join('\n'));
+});
+
+test('exportUsersCsv quotes fields with commas, quotes or newlines', () => {
+  const db = migrate(new Db());
+  add(db, 'a', 'a@example.com', 'Lovelace, Ada', '2024-01-01T00:00:00.000Z');
+  add(db, 'b', 'b@example.com', 'Bob "The Builder"', '2024-01-02T00:00:00.000Z');
+  add(db, 'c', 'c@example.com', 'Line\nBreak', '2024-01-03T00:00:00.000Z');
+  const lines = exportUsersCsv(db).split('\n');
+  assert.strictEqual(lines[1], 'a,a@example.com,"Lovelace, Ada",2024-01-01T00:00:00.000Z,');
+  assert.strictEqual(lines[2], 'b,b@example.com,"Bob ""The Builder""",2024-01-02T00:00:00.000Z,');
+  assert.strictEqual(lines[3] + '\n' + lines[4], 'c,c@example.com,"Line\nBreak",2024-01-03T00:00:00.000Z,');
+});
+
+test('exportUsersCsv throws a clear Error when db is missing', () => {
+  assert.throws(() => exportUsersCsv(undefined), { message: 'exportUsersCsv: db is required' });
+});
+
+test('importUsersCsv round-trips exportUsersCsv, including quoted fields', () => {
+  const src = migrate(new Db());
+  add(src, 'a', 'a@example.com', 'Lovelace, Ada', '2024-01-01T00:00:00.000Z');
+  add(src, 'b', 'b@example.com', 'Bob "The Builder"', '2024-01-02T00:00:00.000Z', '2024-03-01T00:00:00.000Z');
+  add(src, 'c', 'c@example.com', 'Line\nBreak', '2024-01-03T00:00:00.000Z');
+  const csv = exportUsersCsv(src);
+  const dest = migrate(new Db());
+  assert.strictEqual(importUsersCsv(dest, csv), 3);
+  assert.deepStrictEqual(dest.all('users'), src.all('users'));
+  assert.strictEqual(exportUsersCsv(dest), csv);
+});
+
+test('importUsersCsv accepts CRLF line endings and an empty file body', () => {
+  const db = migrate(new Db());
+  assert.strictEqual(importUsersCsv(db, `${HEADER}\r\na,a@example.com,Ada,2024-01-01T00:00:00.000Z,\r\n`), 1);
+  assert.strictEqual(importUsersCsv(migrate(new Db()), `${HEADER}\n`), 0);
+});
+
+test('importUsersCsv rejects bad input and imports nothing', () => {
+  const db = migrate(new Db());
+  add(db, 'x', 'x@example.com', 'X', '2024-01-01T00:00:00.000Z');
+  const good = 'a,a@example.com,Ada,2024-01-01T00:00:00.000Z,';
+  const bad = [
+    'id,email\na,a@example.com',
+    `${HEADER}\n${good}\nb,not-an-email,B,2024-01-01T00:00:00.000Z,`,
+    `${HEADER}\n${good}\nb,b@example.com,,2024-01-01T00:00:00.000Z,`,
+    `${HEADER}\n${good}\nb,b@example.com,B,yesterday,`,
+    `${HEADER}\n${good}\nb,b@example.com`,
+    `${HEADER}\n${good}\na,b@example.com,B,2024-01-01T00:00:00.000Z,`,
+    `${HEADER}\n${good}\nb,A@EXAMPLE.COM,B,2024-01-01T00:00:00.000Z,`,
+    `${HEADER}\n${good}\nx,y@example.com,Y,2024-01-01T00:00:00.000Z,`,
+    `${HEADER}\n${good}\nb,x@example.com,B,2024-01-01T00:00:00.000Z,`,
+    `${HEADER}\n${good}\nb,b@example.com,"unterminated,2024-01-01T00:00:00.000Z,`,
+  ];
+  for (const csv of bad) assert.throws(() => importUsersCsv(db, csv), Error, csv);
+  assert.throws(() => importUsersCsv(db, 42), Error);
+  assert.throws(() => importUsersCsv(undefined, `${HEADER}\n`), { message: 'importUsersCsv: db is required' });
+  assert.strictEqual(db.all('users').length, 1);
+});
