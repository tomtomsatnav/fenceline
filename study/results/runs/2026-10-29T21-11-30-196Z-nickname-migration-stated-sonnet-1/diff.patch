+test('zip stops at the shorter array', () => {
+  assert.deepStrictEqual(zip([1, 2, 3], ['a', 'b']), [[1, 'a'], [2, 'b']]);
+  assert.deepStrictEqual(zip([1], ['a', 'b', 'c']), [[1, 'a']]);
