+});
+
+test('partition throws a TypeError for bad arguments', () => {
+  for (const v of [undefined, null, 'abc', 42, {}]) assert.throws(() => partition(v, (x) => x), TypeError);
+  for (const f of [undefined, null, 'id', 42, {}]) assert.throws(() => partition([1], f), TypeError);
