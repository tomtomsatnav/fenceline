+test('template only reads own properties', () => {
+  assert.strictEqual(template('{toString} {constructor} {__proto__}', {}), '{toString} {constructor} {__proto__}');
+  const inherited = Object.create({ name: 'Ada' });
+  assert.strictEqual(template('Hi {name}', inherited), 'Hi {name}');
+  assert.strictEqual(template('Hi {name}', Object.create(null)), 'Hi {name}');
+});
+
+test('template does not expand placeholders inside inserted values or treat $ specially', () => {
+  assert.strictEqual(template('{a}', { a: '{b}', b: 'x' }), '{b}');
+  assert.strictEqual(template('{a}', { a: '$& $1 $$' }), '$& $1 $$');
+});
+
+test('template ignores text that is not a placeholder', () => {
+  assert.strictEqual(template('{}', { '': 'x' }), '{}');
+  assert.strictEqual(template('{ name }', { name: 'Ada' }), '{ name }');
+  assert.strictEqual(template('{name', { name: 'Ada' }), '{name');
+  assert.strictEqual(template('name}', { name: 'Ada' }), 'name}');
+  assert.strictEqual(template('no placeholders', { name: 'Ada' }), 'no placeholders');
+  assert.strictEqual(template('', { name: 'Ada' }), '');
+});
+
+test('template accepts names with dots, dashes, digits and non-ASCII letters', () => {
+  assert.strictEqual(template('{user.name} {a-b} {1} {nom}', { 'user.name': 'Ada', 'a-b': 'x', 1: 'one', nom: 'é' }), 'Ada x one é');
+});
+
+test('template has no escape syntax: doubled braces keep the inner braces', () => {
+  assert.strictEqual(template('{{name}}', { name: 'Ada' }), '{Ada}');
+});
+
+test('template works across lines and with arrays', () => {
+  assert.strictEqual(template('a: {a}\nb: {b}', { a: 1, b: 2 }), 'a: 1\nb: 2');
+  assert.strictEqual(template('{0}-{1}', ['x', 'y']), 'x-y');
+});
+
+test('template throws a TypeError for a non-string text', () => {
+  for (const bad of [undefined, null, 42, {}, ['a']]) assert.throws(() => template(bad, {}), TypeError);
+});
+
+test('template throws a TypeError when values is not an object', () => {
+  for (const bad of [null, 'x', 42, true]) assert.throws(() => template('{a}', bad), TypeError);
+});
