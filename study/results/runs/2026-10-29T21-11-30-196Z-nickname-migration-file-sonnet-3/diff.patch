+// numbers and bigints, strings, booleans, valid Dates, null, then everything else (NaN, objects,
+// symbols, invalid Dates), then undefined.
+const sortSlot = (key) => {
+  if (typeof key === 'number') return Number.isNaN(key) ? [5, 0] : [0, key];
+  if (typeof key === 'bigint') return [0, key];
+  if (typeof key === 'string') return [1, key];
+  if (typeof key === 'boolean') return [2, key];
+  if (key instanceof Date) return Number.isNaN(key.getTime()) ? [5, 0] : [3, key.getTime()];
+  if (key === null) return [4, 0];
+  if (key === undefined) return [6, 0];
+  return [5, 0];
+};
