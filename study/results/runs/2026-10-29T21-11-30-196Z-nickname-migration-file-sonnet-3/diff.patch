index 0000000..f59da91
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,80 @@
+const { listUsers, insertUser, deleteUser } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quote a field only when it contains a comma, quote or line break; double any quotes inside.
+const csvField = (value) => {
+  const s = value === null || value === undefined ? '' : String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replaceAll('"', '""')}"` : s;
+};
+
+/**
+ * Export every user as CSV: a header row, then one row per user, oldest first. Fields containing a
+ * comma, quote or line break are quoted. Lines end with "\n", including the last.
+ * @param {import('../db.js').Db} db
+ * @returns {string}
+ * @throws {Error} if db is missing
+ */
+exports.exportUsersCsv = (db) => {
+  if (db === undefined || db === null) throw new Error('exportUsersCsv: db is required');
+  const lines = [COLUMNS, ...listUsers(db).map((u) => COLUMNS.map((c) => u[c]))];
+  return lines.map((fields) => fields.map(csvField).join(',')).join('\n') + '\n';
+};
+
+// Splits CSV text into records of fields, honouring quoted fields (commas, line breaks, "" escapes).
+const parseCsv = (text) => {
+  const records = [];
+  let fields = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const ch = text[i];
+    if (quoted) {
+      if (ch !== '"') field += ch;
+      else if (text[i + 1] === '"') { field += '"'; i++; }
+      else quoted = false;
+    } else if (ch === '"') quoted = true;
+    else if (ch === ',') { fields.push(field); field = ''; }
+    else if (ch === '\n' || ch === '\r') {
+      if (ch === '\r' && text[i + 1] === '\n') i++;
+      fields.push(field);
+      records.push(fields);
+      fields = [];
+      field = '';
+    } else field += ch;
+  }
+  if (quoted) throw new Error('Invalid CSV: unterminated quoted field');
+  if (field !== '' || fields.length > 0) { fields.push(field); records.push(fields); }
+  return records;
+};
+
+/**
+ * Inverse of exportUsersCsv: import users from CSV, keeping each row's id, createdAt and lastLogin.
+ * All-or-nothing: if a row is rejected, rows already imported are removed and the error is rethrown.
+ * @param {import('../db.js').Db} db
+ * @param {string} csv text with the header written by exportUsersCsv
+ * @returns {Array<object>} the imported users, in file order
+ * @throws {Error} if db is missing, csv is not a string, the header or a row is malformed, or a
+ *   row fails the same validation as insertUser
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (db === undefined || db === null) throw new Error('importUsersCsv: db is required');
+  if (typeof csv !== 'string') throw new Error('importUsersCsv: csv must be a string');
+  const [header, ...rows] = parseCsv(csv);
+  if (!header || header.join(',') !== COLUMNS.join(',')) {
+    throw new Error(`Invalid CSV header: expected ${COLUMNS.join(',')}`);
+  }
+  const users = rows.map((fields, i) => {
+    if (fields.length !== COLUMNS.length) throw new Error(`Invalid CSV row ${i + 1}: expected ${COLUMNS.length} fields`);
+    const user = Object.fromEntries(COLUMNS.map((c, j) => [c, fields[j]]));
+    return { ...user, lastLogin: user.lastLogin === '' ? undefined : user.lastLogin };
+  });
+  const imported = [];
+  try {
+    for (const user of users) imported.push(insertUser(db, user));
+  } catch (err) {
+    for (const u of imported) deleteUser(db, u.id);
+    throw err;
+  }
+  return imported;
+};
