+    const [rankA, valueA] = a.slot;
+    const [rankB, valueB] = b.slot;
+    if (rankA !== rankB) return rankA - rankB;
+    if (rankA <= 3 && valueA !== valueB) return valueA < valueB ? -1 : 1;
