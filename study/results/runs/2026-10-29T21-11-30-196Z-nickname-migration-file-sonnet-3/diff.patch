+const { isDate } = require('node:util').types;
+
+/**
+ * A new Date n calendar days after date (before it, if n is negative), keeping the time of day.
+ * Days are counted on the local calendar, so "tomorrow at 09:00" stays 09:00 across a daylight saving
+ * change even though that day is 23 or 25 hours long; if the same local time does not exist on the
+ * target day (it falls in the skipped hour), the result is moved forward past the gap. Month and year
+ * ends roll over as expected (January 31 plus 1 is February 1) and leap days are counted. date is not
+ * modified.
+ * @param {Date} date
+ * @param {number} n a whole number of days; may be negative or 0
+ * @returns {Date} a new Date
+ * @throws {TypeError} if date is not a Date, or n is not a number (timestamps and numeric strings are
+ *   not converted)
+ * @throws {RangeError} if date is an Invalid Date, n is not an integer, or the result is outside the
+ *   range JavaScript dates can represent
+ */
+exports.addDays = (date, n) => {
+  if (!isDate(date)) throw new TypeError('addDays: date must be a Date');
+  if (typeof n !== 'number') throw new TypeError('addDays: n must be a number');
+  if (Number.isNaN(date.getTime())) throw new RangeError('addDays: date is invalid');
+  if (!Number.isInteger(n)) throw new RangeError('addDays: n must be an integer');
+  const result = new Date(date.getTime());
+  result.setDate(result.getDate() + n);
+  if (Number.isNaN(result.getTime())) throw new RangeError('addDays: result is outside the supported date range');
+  return result;
+};
+
+const MS_PER_DAY = 86400000;
+
+/**
+ * Whole days from a to b, counted on the UTC calendar and ignoring time of day: the number of UTC
+ * midnights crossed. 23:59 on one day and 00:01 on the next are 1 day apart, while 00:00 and 23:59 on
+ * the same day are 0. The result is positive when b is later than a, negative when it is earlier, and
+ * 0 when both fall on the same UTC day. The local time zone and daylight saving never matter, so the
+ * same two instants always give the same answer. Neither date is modified.
+ * @param {Date} a
+ * @param {Date} b
