+ * two middle values; NaN for an empty array. xs is not modified (a sorted copy is used). The mean of
+ * the two middle values cannot overflow: median([1e308, 1e308]) is 1e308. Any NaN item gives NaN, since
+ * NaN has no place in an order. Infinities sort as usual, so median([1, 2, Infinity]) is 2, and
+ * Infinity with -Infinity in the middle gives NaN, as in mean.
+ * @param {number[]} xs
+ * @returns {number}
+ * @throws {TypeError} if xs is not an array, or any item is not a number (including a hole in a
+ *   sparse array); numeric strings and BigInts are not converted
+ */
+exports.median = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('median: xs must be an array');
+  for (let i = 0; i < xs.length; i++) {
+    if (typeof xs[i] !== 'number') throw new TypeError(`median: item ${i} must be a number`);
+  }
