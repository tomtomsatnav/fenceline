index 0000000..4f9293f
--- /dev/null
+++ b/README.md
@@ -0,0 +1,58 @@
+## Users API
+
+Functions in `src/api/`. Every function in `users.js` takes `db` first and throws an `Error` such as
+`getUser: db is required` if it is `undefined` or `null`. `exportUsersCsv` and `importUsersCsv` do the same.
+
+A **user** is `{ id, email, fullName, createdAt, lastLogin }`. `createdAt` and `lastLogin` are ISO
+timestamps, and `lastLogin` is `null` until a login is recorded.
+
+Validation, wherever a user is created or changed:
+
+- `email` must be a string containing `@` and must not match another user's email, ignoring case.
+- `fullName` must be a non-empty string (not just spaces) of at most 100 characters.
+
+### `src/api/users.js`
+
+| Function | Returns | Notes |
+| --- | --- | --- |
+| `createUser(db, { email, fullName })` | the new user | Generates the `id` and sets `createdAt` to now. Throws if validation fails. |
+| `insertUser(db, user)` | the stored user | Like `createUser`, but stores the `id`, `createdAt` and `lastLogin` you give it. Used by `importUsersCsv`. |
+| `getUser(db, id)` | user, or `null` | |
+| `getUserByEmail(db, email)` | user, or `null` | Ignores case. A non-string `email` returns `null`. |
+| `listUsers(db, { limit, offset })` | array of users | Oldest first by `createdAt`. `offset` defaults to 0, `limit` to no limit. Throws if either is not a non-negative integer. |
+| `searchUsers(db, query)` | array of users | Users whose `fullName` or `email` contains `query`, ignoring case, oldest first. An empty string matches everyone; a non-string returns `[]`. |
+| `countUsers(db)` | number | |
+| `updateUser(db, id, { email, fullName })` | the updated user, or `null` | Changes only the fields you pass. Throws, and writes nothing, if a new value is invalid. A user may resubmit their own email. |
+| `recordLogin(db, id, when)` | the updated user, or `null` | Sets `lastLogin`. `when` is a `Date` or an ISO string and defaults to now. |
+| `deleteUser(db, id)` | `true`, or `false` if there was no such user | |
+
+### `src/api/export.js`
+
+| Function | Returns | Notes |
+| --- | --- | --- |
+| `exportUsersCsv(db)` | string | Header row `id,email,fullName,createdAt,lastLogin`, then one row per user, oldest first. Fields containing a comma, quote or line break are quoted, and quotes inside them are doubled. Lines end with `\n`, including the last. |
+| `importUsersCsv(db, csv)` | array of imported users | Inverse of `exportUsersCsv`. Keeps each row's `id`, `createdAt` and `lastLogin`, and accepts `\n` or `\r\n` line endings. Throws on a wrong header, a row with the wrong number of fields, an unterminated quote, or a row that fails validation. All-or-nothing: users already imported are removed before the error is rethrown. |
+
+### `src/api/format.js`
+
+| Function | Returns | Notes |
+| --- | --- | --- |
+| `displayName(user)` | string | The user's `fullName`, or the part of their `email` before the first `@` when `fullName` is missing or blank. |
+
+### Example
+
+```js
+const { Db } = require('./src/db.js');
+const { migrate } = require('./src/migrate.js');
+const { createUser, updateUser, listUsers, searchUsers } = require('./src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('./src/api/export.js');
+
+const db = migrate(new Db());
+const ada = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+updateUser(db, ada.id, { fullName: 'Ada King' });
+listUsers(db, { limit: 10 });
+searchUsers(db, 'king');
+
+const csv = exportUsersCsv(db);
+importUsersCsv(migrate(new Db()), csv);
+```
