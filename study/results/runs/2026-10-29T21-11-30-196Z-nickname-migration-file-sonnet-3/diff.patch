+ * calendar and ignoring time of day. Someone born 2000-03-09 is 23 on 2024-03-08 and 24 on 2024-03-09.
+ * A birthday on 29 February is reached on 1 March in years that have no 29 February (the rule in the UK
+ * and most of Europe): someone born 2000-02-29 is 22 on 2023-02-28, turns 23 on 2023-03-01, and turns 24
+ * on 2024-02-29. The local time zone is ignored. Neither date is modified.
+ * @param {Date} birthDate
+ * @param {Date} date the day to measure the age on
+ * @returns {number} an integer, 0 or more
+ * @throws {TypeError} if birthDate or date is not a Date (timestamps and strings are not converted)
+ * @throws {RangeError} if either is an Invalid Date, or date falls on an earlier UTC day than birthDate
+ */
+exports.ageOn = (birthDate, date) => {
+  for (const [name, value] of [['birthDate', birthDate], ['date', date]]) {
+    if (!isDate(value)) throw new TypeError(`ageOn: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`ageOn: ${name} is invalid`);
+  }
+  if (exports.daysBetween(birthDate, date) < 0) throw new RangeError('ageOn: date is before birthDate');
+  const beforeBirthday =
+    date.getUTCMonth() < birthDate.getUTCMonth() ||
+    (date.getUTCMonth() === birthDate.getUTCMonth() && date.getUTCDate() < birthDate.getUTCDate());
+  return date.getUTCFullYear() - birthDate.getUTCFullYear() - (beforeBirthday ? 1 : 0);
+};
+
+const RELATIVE_TIME = new Intl.RelativeTimeFormat('en', { numeric: 'always' });
