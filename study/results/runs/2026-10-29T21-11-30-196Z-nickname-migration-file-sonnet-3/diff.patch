+// Every array and object reachable from `value`, so tests can check that nothing is shared with a clone.
+const containers = (value) => {
+  const seen = new Set();
+  const walk = [value];
+  while (walk.length > 0) {
+    const item = walk.pop();
+    if (item === null || typeof item !== 'object' || seen.has(item)) continue;
+    seen.add(item);
+    for (const key of Reflect.ownKeys(item)) if (Object.prototype.propertyIsEnumerable.call(item, key)) walk.push(item[key]);
+  }
+  return seen;
+};
