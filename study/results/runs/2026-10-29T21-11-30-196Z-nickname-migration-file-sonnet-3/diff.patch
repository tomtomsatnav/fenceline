+ * @param {import('../db.js').Db} db
+ * @param {{ id: string, email: string, fullName: string, createdAt: string, lastLogin?: string }} user
+ * @returns {object} the stored user
+ * @throws {Error} if db is missing, the email lacks "@" or duplicates another user's (case-insensitive),
+ *   or fullName is not a non-empty string of at most 100 characters
