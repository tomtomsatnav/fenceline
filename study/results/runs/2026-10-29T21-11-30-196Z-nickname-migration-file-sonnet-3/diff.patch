+
+test('formatBytes moves up a unit when rounding reaches 1024', () => {
+  assert.strictEqual(formatBytes(1024 * 1024 - 1), '1 MB');
+  assert.strictEqual(formatBytes(1024 ** 3 - 1), '1 GB');
+  assert.strictEqual(formatBytes(1024 ** 4 - 1), '1 TB');
+  assert.strictEqual(formatBytes(1024 * 1023.94), '1023.9 KB');
+  assert.strictEqual(formatBytes(1024 * 1023.95), '1 MB');
