+const test = require('node:test');
+const assert = require('node:assert');
+const { clamp } = require('../src/lib/numbers.js');
+
+test('clamp returns x when it is within the range', () => {
+  assert.strictEqual(clamp(5, 0, 10), 5);
+  assert.strictEqual(clamp(0.5, 0, 1), 0.5);
+  assert.strictEqual(clamp(-3, -10, -1), -3);
+});
+
+test('clamp returns lo when x is below the range', () => {
+  assert.strictEqual(clamp(-5, 0, 10), 0);
+  assert.strictEqual(clamp(-0.1, 0, 1), 0);
+  assert.strictEqual(clamp(-100, -10, -1), -10);
+});
+
+test('clamp returns hi when x is above the range', () => {
+  assert.strictEqual(clamp(15, 0, 10), 10);
+  assert.strictEqual(clamp(1.1, 0, 1), 1);
+  assert.strictEqual(clamp(0, -10, -1), -1);
+});
+
+test('clamp includes both bounds', () => {
+  assert.strictEqual(clamp(0, 0, 10), 0);
+  assert.strictEqual(clamp(10, 0, 10), 10);
+});
+
+test('clamp allows lo equal to hi', () => {
+  assert.strictEqual(clamp(5, 3, 3), 3);
+  assert.strictEqual(clamp(1, 3, 3), 3);
+  assert.strictEqual(clamp(3, 3, 3), 3);
+});
+
+test('clamp supports infinite bounds for a one-sided limit', () => {
+  assert.strictEqual(clamp(-1e300, 0, Infinity), 0);
+  assert.strictEqual(clamp(1e300, 0, Infinity), 1e300);
+  assert.strictEqual(clamp(1e300, -Infinity, 10), 10);
+  assert.strictEqual(clamp(-1e300, -Infinity, 10), -1e300);
+  assert.strictEqual(clamp(5, -Infinity, Infinity), 5);
+});
+
+test('clamp clamps infinite x to the bounds', () => {
+  assert.strictEqual(clamp(Infinity, 0, 10), 10);
+  assert.strictEqual(clamp(-Infinity, 0, 10), 0);
+  assert.strictEqual(clamp(Infinity, 0, Infinity), Infinity);
+});
+
+test('clamp returns NaN for a NaN x', () => {
+  assert.ok(Number.isNaN(clamp(NaN, 0, 10)));
+});
+
+test('clamp keeps the sign of zero when x is in range', () => {
+  assert.ok(Object.is(clamp(-0, -1, 1), -0));
+  assert.ok(Object.is(clamp(0, -1, 1), 0));
+  assert.ok(Object.is(clamp(-5, 0, 1), 0));
+});
+
+test('clamp works with fractional and very small values', () => {
+  assert.strictEqual(clamp(0.1 + 0.2, 0, 0.3), 0.3);
+  assert.strictEqual(clamp(Number.MIN_VALUE, 0, 1), Number.MIN_VALUE);
+  assert.strictEqual(clamp(Number.MAX_VALUE, 0, 1), 1);
+});
+
+test('clamp throws a RangeError when lo is greater than hi', () => {
+  assert.throws(() => clamp(5, 10, 0), RangeError);
+  assert.throws(() => clamp(5, 1, -1), RangeError);
+  assert.throws(() => clamp(5, Infinity, 0), RangeError);
+  assert.throws(() => clamp(NaN, 10, 0), RangeError);
