+/**
+ * Split an array into consecutive chunks of length n; the last chunk is shorter when the length of xs
+ * is not a multiple of n. Order is kept, xs is not modified, and each chunk is a new array (its
+ * elements are not copied).
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n chunk length, a positive integer
+ * @returns {T[][]} [] if xs is empty
+ * @throws {TypeError} if xs is not an array
+ * @throws {RangeError} if n is not a positive integer
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk: xs must be an array');
+  if (!(Number.isInteger(n) && n > 0)) throw new RangeError('chunk: n must be a positive integer');
+  const chunks = [];
+  for (let i = 0; i < xs.length; i += n) chunks.push(xs.slice(i, i + n));
+  return chunks;
+};
+
+/**
+ * Keep the first item for each key, in the original order. keyFn(item, index) is called once per
+ * item. Keys are compared as in a Set (SameValueZero): 1 and "1" differ, NaN equals NaN, and objects
+ * match only by identity. xs is not modified. A hole in a sparse array is treated as undefined.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => unknown} keyFn
+ * @returns {T[]} a new array; [] if xs is empty
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('uniqueBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('uniqueBy: keyFn must be a function');
+  const seen = new Set();
+  const kept = [];
+  for (let i = 0; i < xs.length; i++) {
+    const key = keyFn(xs[i], i);
+    if (!seen.has(key)) {
+      seen.add(key);
+      kept.push(xs[i]);
+    }
+  }
+  return kept;
+};
+
+/**
+ * Group items by key: returns a plain object whose properties are arrays of the items that share a
+ * key, each in original order. keyFn(item, index) is called once per item, and its result is used as a
+ * property key, so it is converted to a string (a symbol stays a symbol): 1 and "1" share a group,
+ * and null groups under "null". Keys such as "__proto__" and "constructor" are ordinary own
+ * properties. Property order follows JavaScript's rules: integer-like keys ascending, then the
+ * others in order of first appearance. xs is not modified.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => unknown} keyFn
+ * @returns {Object<string, T[]>} {} if xs is empty
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy: xs must be an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy: keyFn must be a function');
+  const groups = {};
+  for (let i = 0; i < xs.length; i++) {
+    const raw = keyFn(xs[i], i);
+    const key = typeof raw === 'symbol' ? raw : String(raw);
+    if (Object.hasOwn(groups, key)) groups[key].push(xs[i]);
+    else Object.defineProperty(groups, key, { value: [xs[i]], writable: true, enumerable: true, configurable: true });
+  }
+  return groups;
+};
+
+/**
+ * Split an array in two: the items for which pred is truthy, and the rest. Each part keeps the
+ * original order, every item lands in exactly one part, and pred(item, index) is called once per
+ * item. xs is not modified. A hole in a sparse array is treated as undefined.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => unknown} pred any truthy result counts as a match
+ * @returns {[T[], T[]]} [matching, notMatching]; [[], []] if xs is empty
+ * @throws {TypeError} if xs is not an array or pred is not a function
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition: xs must be an array');
+  if (typeof pred !== 'function') throw new TypeError('partition: pred must be a function');
+  const matching = [];
+  const notMatching = [];
+  for (let i = 0; i < xs.length; i++) (pred(xs[i], i) ? matching : notMatching).push(xs[i]);
+  return [matching, notMatching];
+};
+
+/**
+ * Pair up items from two arrays by position: [[a[0], b[0]], [a[1], b[1]], ...]. Stops at the end of
+ * the shorter array, so extra items in the longer one are dropped. Neither input is modified. A hole
+ * in a sparse array is treated as undefined.
+ * @template A, B
+ * @param {A[]} a
+ * @param {B[]} b
+ * @returns {Array<[A, B]>} [] if either array is empty
+ * @throws {TypeError} if a or b is not an array
+ */
+exports.zip = (a, b) => {
+  if (!Array.isArray(a)) throw new TypeError('zip: a must be an array');
+  if (!Array.isArray(b)) throw new TypeError('zip: b must be an array');
+  const length = Math.min(a.length, b.length);
+  const pairs = [];
+  for (let i = 0; i < length; i++) pairs.push([a[i], b[i]]);
+  return pairs;
+};
+
+/**
+ * Numbers from start up to but not including end, stepping by step: range(0, 5) is [0, 1, 2, 3, 4]
+ * and range(5, 0, -2) is [5, 3, 1]. A step that points away from end gives [] (range(0, 5, -1)), as
+ * does start equal to end. Each value is computed as start + i * step rather than by repeated
+ * addition, so fractional steps do not accumulate rounding error.
+ * @param {number} start
+ * @param {number} end exclusive
+ * @param {number} [step] defaults to 1; may be negative or fractional, but not 0
+ * @returns {number[]}
+ * @throws {TypeError} if start, end or step is not a number
+ * @throws {RangeError} if start or end is not finite, step is 0 or not finite, or the result would
+ *   have more than 2**32 - 1 items
+ */
+exports.range = (start, end, step = 1) => {
+  for (const [name, value] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof value !== 'number') throw new TypeError(`range: ${name} must be a number`);
+    if (!Number.isFinite(value)) throw new RangeError(`range: ${name} must be finite`);
+  }
+  if (step === 0) throw new RangeError('range: step must not be 0');
+  const count = Math.max(0, Math.ceil((end - start) / step));
+  if (count > 2 ** 32 - 1) throw new RangeError('range: too many items');
+  const values = [];
+  for (let i = 0; i < count; i++) values.push(start + i * step);
+  return values;
+};
+
+/**
+ * Flatten arbitrarily nested arrays into one flat array, keeping left-to-right order:
+ * flattenDeep([1, [2, [3, [4]], 5]]) is [1, 2, 3, 4, 5]. Only real arrays are flattened, so strings,
+ * array-likes, Sets and typed arrays stay as items. Empty nested arrays vanish, and a hole in a sparse
+ * array becomes undefined. Nesting depth is not limited by the call stack. The input is not modified.
+ * @param {Array<unknown>} xs
+ * @returns {unknown[]} a new array; [] if xs is empty
+ * @throws {TypeError} if xs is not an array, or an array contains itself (directly or deeper)
+ */
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep: xs must be an array');
+  const out = [];
+  const active = new Set([xs]);
+  const stack = [xs[Symbol.iterator]()];
+  const owners = [xs];
+  while (stack.length > 0) {
+    const { done, value } = stack[stack.length - 1].next();
+    if (done) {
+      stack.pop();
+      active.delete(owners.pop());
+    } else if (Array.isArray(value)) {
+      if (active.has(value)) throw new TypeError('flattenDeep: xs contains a circular reference');
+      active.add(value);
+      owners.push(value);
+      stack.push(value[Symbol.iterator]());
+    } else out.push(value);
+  }
+  return out;
+};
+
