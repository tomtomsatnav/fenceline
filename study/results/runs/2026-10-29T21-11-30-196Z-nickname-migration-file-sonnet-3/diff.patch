+  if (typeof keyFn !== 'function') throw new TypeError('sortBy: keyFn must be a function');
+  const entries = [];
+  for (let i = 0; i < xs.length; i++) entries.push({ item: xs[i], slot: sortSlot(keyFn(xs[i], i)), index: i });
