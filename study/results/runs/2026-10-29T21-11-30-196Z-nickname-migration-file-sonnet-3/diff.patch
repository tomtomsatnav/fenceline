+  assert.strictEqual(formatBytes(1024 ** 4), '1 TB');
+});
+
+test('formatBytes shows plain bytes below 1024', () => {
+  assert.strictEqual(formatBytes(0), '0 B');
+  assert.strictEqual(formatBytes(1), '1 B');
+  assert.strictEqual(formatBytes(500), '500 B');
+  assert.strictEqual(formatBytes(1023), '1023 B');
+});
+
+test('formatBytes uses each unit at its boundary', () => {
+  assert.strictEqual(formatBytes(1025), '1 KB');
+  assert.strictEqual(formatBytes(1024 * 1024 - 1024), '1023 KB');
+  assert.strictEqual(formatBytes(1024 ** 2 + 1024 ** 2 / 2), '1.5 MB');
+  assert.strictEqual(formatBytes(1024 ** 3 * 2.5), '2.5 GB');
+  assert.strictEqual(formatBytes(1024 ** 4 * 1.25), '1.3 TB');
+});
+
+test('formatBytes keeps at most one decimal, rounding half away from zero', () => {
+  assert.strictEqual(formatBytes(1024 * 1.04), '1 KB');
+  assert.strictEqual(formatBytes(1024 * 1.05), '1.1 KB');
+  assert.strictEqual(formatBytes(1024 * 1.949), '1.9 KB');
+  assert.strictEqual(formatBytes(1024 * 1.95), '2 KB');
+  assert.strictEqual(formatBytes(1024 * 10.25), '10.3 KB');
+});
+
+test('formatBytes drops a trailing ".0"', () => {
+  assert.strictEqual(formatBytes(2048), '2 KB');
+  assert.strictEqual(formatBytes(1024 * 1.99), '2 KB');
+  assert.strictEqual(formatBytes(3 * 1024 ** 3), '3 GB');
