+// Largest first; a gap of at least `ms` uses that unit. A month is a twelfth of a 365-day year, so 12
+// of them never show up before a full year does.
+const RELATIVE_UNITS = [
+  ['year', 365 * MS_PER_DAY],
+  ['month', (365 * MS_PER_DAY) / 12],
+  ['week', 7 * MS_PER_DAY],
+  ['day', MS_PER_DAY],
+  ['hour', 3600000],
+  ['minute', 60000],
+  ['second', 1000],
+];
+
+/**
+ * Describe date relative to now in English: "3 minutes ago", "in 2 days", "1 hour ago", or "just now"
+ * for a gap under one second in either direction. The gap is elapsed time, not calendar days, and it
+ * is rounded down to the largest whole unit that fits: 59 minutes 59 seconds is "59 minutes ago", 90
+ * minutes is "1 hour ago". Units are seconds, minutes, hours, days (24 hours), weeks (7 days), months
+ * (a twelfth of a 365-day year, about 30.4 days) and years (365 days), so 28 to 30 days reads as "4
+ * weeks" and 365 days as "1 year". A gap in the past reads "N units ago" and one in the future "in N
+ * units"; the unit is singular only for exactly 1. Large numbers get thousands separators ("in 1,000
+ * years"). The time zone does not matter, since it only looks at the two instants. Neither date is
+ * modified.
+ * @param {Date} date the moment to describe
+ * @param {Date} [now] the moment to compare with; defaults to the current time
+ * @returns {string}
+ * @throws {TypeError} if date or now is not a Date (timestamps and strings are not converted)
+ * @throws {RangeError} if date or now is an Invalid Date
+ */
+exports.relativeTime = (date, now = new Date()) => {
+  for (const [name, value] of [['date', date], ['now', now]]) {
+    if (!isDate(value)) throw new TypeError(`relativeTime: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`relativeTime: ${name} is invalid`);
+  }
+  const gap = date.getTime() - now.getTime(); // negative when date is in the past
+  const size = Math.abs(gap);
+  const unit = RELATIVE_UNITS.find(([, ms]) => size >= ms);
+  if (!unit) return 'just now';
+  const count = Math.floor(size / unit[1]);
+  return RELATIVE_TIME.format(gap < 0 ? -count : count, unit[0]);
+};
