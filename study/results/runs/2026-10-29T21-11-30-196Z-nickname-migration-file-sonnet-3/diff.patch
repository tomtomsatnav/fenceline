+/**
+ * Name to show for a user: their fullName, or the part of their email before the first "@"
+ * when fullName is missing, blank or not a string.
+ * @param {{ fullName?: string|null, email: string }} user
+ * @returns {string}
+ */
+exports.displayName = (user) => {
+  const { fullName, email } = user;
+  if (typeof fullName === 'string' && fullName.trim() !== '') return fullName;
+  return String(email).split('@')[0];
+};
