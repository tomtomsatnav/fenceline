+  let max = -Infinity;
+  let allFinite = true;
+  for (let i = 0; i < xs.length; i++) {
+    if (typeof xs[i] !== 'number') throw new TypeError(`mean: item ${i} must be a number`);
+    allFinite = allFinite && Number.isFinite(xs[i]);
+    if (xs[i] < min) min = xs[i];
+    if (xs[i] > max) max = xs[i];
+  }
