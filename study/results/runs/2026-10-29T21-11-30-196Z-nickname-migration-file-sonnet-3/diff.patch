+// Database rows use snake_case columns; user objects use camelCase fields.
+const fromRow = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null, nickname: r.nickname ?? null });
+
+// Accepts any subset of user fields and returns only those as row columns.
+const toRow = ({ id, email, fullName, createdAt, lastLogin, nickname }) => {
+  const row = { id, email, fullname: fullName, created_at: createdAt, last_login: lastLogin, nickname };
