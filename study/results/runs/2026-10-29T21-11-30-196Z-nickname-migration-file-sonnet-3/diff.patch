+  const sorted = Float64Array.from(xs).sort();
+  const mid = sorted.length >> 1;
+  if (sorted.length % 2 === 1) return sorted[mid];
+  const lower = sorted[mid - 1];
+  const upper = sorted[mid];
+  if (lower === upper) return lower;
+  const sum = lower + upper;
+  return Number.isFinite(sum) || !Number.isFinite(lower) || !Number.isFinite(upper) ? sum / 2 : lower / 2 + upper / 2;
+};
+
+/**
+ * The p-th percentile of an array of numbers, by linear interpolation between the closest ranks (the
+ * "inclusive" method, as in numpy's default and Excel's PERCENTILE.INC): the sorted values sit at
+ * p = 0, 100 / (n - 1), ..., 100, and values in between are interpolated. So percentile(xs, 0) is the
+ * smallest, percentile(xs, 100) the largest, and percentile(xs, 50) equals the median. NaN for an
