+  // cannot sum past the largest double through rounding) and undo the extra factor of 2 at the end.
+  const result = Number.isFinite(total) ? total / xs.length : compensatedSum(xs, 2 * xs.length) * 2;
+  // The mean of finite numbers lies between the smallest and the largest; rounding must not leave it.
+  return Math.min(Math.max(result, min), max);
