+
+/**
+ * Centre s in a field of the given width by padding both sides with ch. When the padding cannot be
+ * split evenly, the extra character goes on the right. Characters are counted as code points.
+ * @param {string} s
+ * @param {number} width a non-negative integer
+ * @param {string} [ch] the padding character, exactly one character; defaults to a space
+ * @returns {string} s unchanged if it is already width characters or longer (it is never truncated)
+ * @throws {TypeError} if s is not a string
+ * @throws {RangeError} if width is not a non-negative integer, or ch is not exactly one character
+ */
+exports.padCenter = (s, width, ch = ' ') => {
+  if (typeof s !== 'string') throw new TypeError('padCenter: s must be a string');
+  if (!(Number.isInteger(width) && width >= 0)) throw new RangeError('padCenter: width must be a non-negative integer');
+  if (typeof ch !== 'string' || Array.from(ch).length !== 1) {
+    throw new RangeError('padCenter: ch must be exactly one character');
+  }
+  const total = width - Array.from(s).length;
+  if (total <= 0) return s;
+  const left = Math.floor(total / 2);
+  return ch.repeat(left) + s + ch.repeat(total - left);
+};
+
+/**
+ * Count the words in s. A word is a run of letters and digits; whitespace and punctuation (including
+ * apostrophes and hyphens) separate words, so "don't" counts as 2 and "well-known" as 2. Case changes
+ * do not split a word, so "helloWorld" is 1.
+ * @param {string} s
+ * @returns {number} 0 if s has no letters or digits
+ * @throws {TypeError} if s is not a string
+ */
+exports.countWords = (s) => {
+  if (typeof s !== 'string') throw new TypeError('countWords: s must be a string');
+  return (s.match(/[\p{L}\p{N}]+/gu) ?? []).length;
+};
+
+/**
+ * Initials of the words in s, uppercased: "Ada King Lovelace" gives "AKL". A word is a run of letters
+ * and digits; whitespace, hyphens and other punctuation separate words, but an apostrophe inside a
+ * word does not, so "Mary-Jane O'Brien" gives "MJO". Case changes do not split a word.
+ * @param {string} s
+ * @returns {string} "" if s has no letters or digits
+ * @throws {TypeError} if s is not a string
+ */
+exports.initials = (s) => {
+  if (typeof s !== 'string') throw new TypeError('initials: s must be a string');
+  const words = s.match(/[\p{L}\p{N}]+(?:['’][\p{L}\p{N}]+)*/gu) ?? [];
+  return words.map((w) => Array.from(w)[0].toUpperCase()).join('');
+};
+
+/**
+ * Reverse the order of the words in a sentence, joined by single spaces. Words are runs of
+ * non-whitespace, so punctuation stays attached to its word ("Hello, world!" gives "world! Hello,").
+ * Runs of any whitespace, including tabs and line breaks, become one space, and leading and trailing
+ * whitespace is dropped.
+ * @param {string} s
+ * @returns {string} "" if s is empty or only whitespace
+ * @throws {TypeError} if s is not a string
+ */
+exports.reverseWords = (s) => {
+  if (typeof s !== 'string') throw new TypeError('reverseWords: s must be a string');
+  return s.split(/\s+/).filter(Boolean).reverse().join(' ');
+};
+
+/**
+ * Whether s reads the same backwards, comparing only its letters and digits and ignoring case.
+ * Spaces and punctuation are ignored, so "A man, a plan, a canal: Panama" is a palindrome. Accents
+ * are significant ("é" is not "e"). A string with no letters or digits is trivially a palindrome.
+ * @param {string} s
+ * @returns {boolean}
+ * @throws {TypeError} if s is not a string
+ */
+exports.isPalindrome = (s) => {
+  if (typeof s !== 'string') throw new TypeError('isPalindrome: s must be a string');
+  const chars = Array.from((s.match(/[\p{L}\p{N}]+/gu) ?? []).join('').toLowerCase());
+  return chars.every((c, i) => c === chars[chars.length - 1 - i]);
+};
+
+/**
+ * Wrap text so no line is longer than width, breaking only between words. Words are runs of
+ * characters other than spaces and tabs, and each line is filled greedily. Existing line breaks are
+ * kept (blank lines too, "\r\n" becomes "\n"), and each line is wrapped on its own. Runs of spaces and
+ * tabs collapse to one space, and lines get no leading or trailing spaces. A word longer than width is
+ * never split: it gets a line to itself and overflows. A non-breaking space does not separate words.
+ * Lengths are counted in code points.
+ * @param {string} text
+ * @param {number} width a positive integer
+ * @returns {string}
+ * @throws {TypeError} if text is not a string
+ * @throws {RangeError} if width is not a positive integer
+ */
+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new TypeError('wrap: text must be a string');
+  if (!(Number.isInteger(width) && width > 0)) throw new RangeError('wrap: width must be a positive integer');
+  const len = (s) => Array.from(s).length;
+  return text.split(/\r?\n/).flatMap((line) => {
+    const out = [];
+    let current = '';
+    for (const word of line.split(/[ \t]+/).filter(Boolean)) {
+      if (current === '') current = word;
+      else if (len(current) + 1 + len(word) <= width) current += ` ${word}`;
+      else {
+        out.push(current);
+        current = word;
+      }
+    }
+    out.push(current);
+    return out;
+  }).join('\n');
+};
+
+/**
+ * Fill {placeholders} in text from values: template("Hi {name}", { name: "Ada" }) gives "Hi Ada".
+ * A placeholder is a name in braces, with no braces inside. It is left as it is when values has no
+ * own property of that name (so "{toString}" is never filled) or the value is null or undefined.
+ * Other values are converted with String(). Names are matched exactly (so "{ name }" is not "{name}"),
+ * and filled-in text is never scanned again, so a value containing "{other}" is inserted literally.
+ * There is no escape syntax: "{{name}}" becomes "{Ada}".
+ * @param {string} text
+ * @param {object} [values] defaults to {}
+ * @returns {string}
+ * @throws {TypeError} if text is not a string, or values is not an object
+ */
+exports.template = (text, values = {}) => {
+  if (typeof text !== 'string') throw new TypeError('template: text must be a string');
+  if (typeof values !== 'object' || values === null) throw new TypeError('template: values must be an object');
+  return text.replace(/\{([^{}]+)\}/g, (placeholder, name) => {
+    const value = Object.hasOwn(values, name) ? values[name] : undefined;
+    return value === undefined || value === null ? placeholder : String(value);
+  });
+};
diff --git a/test/export.test.js b/test/export.test.js
new file mode 100644
index 0000000..f760d8f
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,87 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+const insert = (db, id, email, fullname, created_at, last_login) =>
+  db.insert('users', { id, email, fullname, created_at, ...(last_login && { last_login }) });
+
+test('exportUsersCsv writes a header row, then users oldest first', () => {
+  const db = migrate(new Db());
+  insert(db, 'b', 'grace@example.com', 'Grace Hopper', '2024-02-01T00:00:00.000Z', '2024-05-01T00:00:00.000Z');
+  insert(db, 'a', 'ada@example.com', 'Ada Lovelace', '2024-01-01T00:00:00.000Z');
+  assert.strictEqual(
+    exportUsersCsv(db),
+    [
+      'id,email,fullName,createdAt,lastLogin',
+      'a,ada@example.com,Ada Lovelace,2024-01-01T00:00:00.000Z,',
+      'b,grace@example.com,Grace Hopper,2024-02-01T00:00:00.000Z,2024-05-01T00:00:00.000Z',
+      '',
+    ].join('\n'),
+  );
+});
+
+test('exportUsersCsv quotes fields with commas, quotes or line breaks', () => {
+  const db = migrate(new Db());
+  insert(db, 'a', 'a@example.com', 'Lovelace, Ada', '2024-01-01T00:00:00.000Z');
+  insert(db, 'b', 'b@example.com', 'Grace "Amazing" Hopper', '2024-02-01T00:00:00.000Z');
+  insert(db, 'c', 'c@example.com', 'Two\nLines', '2024-03-01T00:00:00.000Z');
+  const lines = exportUsersCsv(db).split('\n');
+  assert.strictEqual(lines[1], 'a,a@example.com,"Lovelace, Ada",2024-01-01T00:00:00.000Z,');
+  assert.strictEqual(lines[2], 'b,b@example.com,"Grace ""Amazing"" Hopper",2024-02-01T00:00:00.000Z,');
+  assert.strictEqual(lines[3] + '\n' + lines[4], 'c,c@example.com,"Two\nLines",2024-03-01T00:00:00.000Z,');
+});
+
+test('exportUsersCsv with no users is just the header', () => {
+  const db = migrate(new Db());
+  assert.strictEqual(exportUsersCsv(db), 'id,email,fullName,createdAt,lastLogin\n');
+});
+
+test('exportUsersCsv throws a clear Error when db is missing', () => {
+  assert.throws(() => exportUsersCsv(undefined), { message: 'exportUsersCsv: db is required' });
+});
+
+test('importUsersCsv round-trips exportUsersCsv', () => {
+  const src = migrate(new Db());
+  insert(src, 'a', 'a@example.com', 'Lovelace, Ada', '2024-01-01T00:00:00.000Z', '2024-06-01T00:00:00.000Z');
+  insert(src, 'b', 'b@example.com', 'Grace "Amazing" Hopper', '2024-02-01T00:00:00.000Z');
+  insert(src, 'c', 'c@example.com', 'Two\nLines', '2024-03-01T00:00:00.000Z');
+  const csv = exportUsersCsv(src);
+
+  const dest = migrate(new Db());
+  const imported = importUsersCsv(dest, csv);
+  assert.strictEqual(imported.length, 3);
+  assert.strictEqual(exportUsersCsv(dest), csv);
+  assert.deepStrictEqual(dest.all('users'), src.all('users'));
+});
+
+test('importUsersCsv accepts CRLF line endings and a missing final newline', () => {
+  const db = migrate(new Db());
+  const csv = 'id,email,fullName,createdAt,lastLogin\r\na,a@example.com,Ada,2024-01-01T00:00:00.000Z,';
+  assert.strictEqual(importUsersCsv(db, csv).length, 1);
+});
+
+test('importUsersCsv rejects a wrong header or malformed row without importing anything', () => {
+  const db = migrate(new Db());
+  assert.throws(() => importUsersCsv(db, 'id,email\na,a@example.com\n'), Error);
+  assert.throws(() => importUsersCsv(db, 'id,email,fullName,createdAt,lastLogin\na,a@example.com\n'), Error);
+  assert.throws(() => importUsersCsv(db, 'id,email,fullName,createdAt,lastLogin\na,"a@example.com,Ada,t,\n'), Error);
+  assert.strictEqual(db.all('users').length, 0);
+});
+
+test('importUsersCsv rolls back when a later row is invalid', () => {
+  const db = migrate(new Db());
+  const csv = [
+    'id,email,fullName,createdAt,lastLogin',
+    'a,a@example.com,Ada,2024-01-01T00:00:00.000Z,',
+    'b,not-an-email,Grace,2024-02-01T00:00:00.000Z,',
+    '',
+  ].join('\n');
+  assert.throws(() => importUsersCsv(db, csv), Error);
+  assert.strictEqual(db.all('users').length, 0);
+});
+
+test('importUsersCsv throws a clear Error when db is missing', () => {
+  assert.throws(() => importUsersCsv(undefined, ''), { message: 'importUsersCsv: db is required' });
+});
