+  if (typeof rng !== 'function') throw new TypeError('sample: rng must be a function');
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new RangeError('sample: rng must return a number in [0, 1)');
+  return xs[Math.floor(r * xs.length)];
+};
+
+/**
+ * Every run of n consecutive items, as overlapping windows moving one item at a time:
+ * windowed([1, 2, 3, 4], 2) is [[1, 2], [2, 3], [3, 4]]. An array of length L gives L - n + 1 windows,
+ * so [] when n is larger than the array (no partial windows) or the array is empty. Each window is a
+ * new array of the original items, and xs is not modified. A hole in a sparse array is treated as
+ * undefined.
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n window length, a positive integer
+ * @returns {T[][]}
+ * @throws {TypeError} if xs is not an array
+ * @throws {RangeError} if n is not a positive integer
+ */
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed: xs must be an array');
+  if (!(Number.isInteger(n) && n > 0)) throw new RangeError('windowed: n must be a positive integer');
+  const windows = [];
+  for (let i = 0; i + n <= xs.length; i++) {
+    const window = [];
+    for (let j = 0; j < n; j++) window.push(xs[i + j]);
+    windows.push(window);
+  }
+  return windows;
+};
