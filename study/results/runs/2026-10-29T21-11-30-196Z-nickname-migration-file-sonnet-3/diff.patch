+const test = require('node:test');
+const assert = require('node:assert');
+const { displayName } = require('../src/api/format.js');
+
+test('displayName returns the fullName when present', () => {
+  assert.strictEqual(displayName({ fullName: 'Ada Lovelace', email: 'ada@example.com' }), 'Ada Lovelace');
+});
+
+test('displayName falls back to the email local part when fullName is empty', () => {
+  assert.strictEqual(displayName({ fullName: '', email: 'ada@example.com' }), 'ada');
+  assert.strictEqual(displayName({ fullName: '   ', email: 'ada@example.com' }), 'ada');
+  assert.strictEqual(displayName({ fullName: null, email: 'ada@example.com' }), 'ada');
+  assert.strictEqual(displayName({ email: 'ada@example.com' }), 'ada');
+});
+
+test('displayName splits the email at the first "@"', () => {
+  assert.strictEqual(displayName({ fullName: '', email: 'a@b@example.com' }), 'a');
+});
diff --git a/test/lib-arrays.test.js b/test/lib-arrays.test.js
