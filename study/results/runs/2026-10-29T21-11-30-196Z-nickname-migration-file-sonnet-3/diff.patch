+ */
 exports.getUser = (db, id) => {
   const r = db.find('users', (u) => u.id === id);
-  if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return r ? fromRow(r) : null;
+};
+
+/**
+ * Look a user up by email, ignoring case.
+ * @param {import('../db.js').Db} db
+ * @param {string} email
+ * @returns {object|null} the user, or null if there is none (or email is not a string)
+ */
+exports.getUserByEmail = (db, email) => {
+  if (typeof email !== 'string') return null;
+  const wanted = email.toLowerCase();
+  const r = db.find('users', (u) => typeof u.email === 'string' && u.email.toLowerCase() === wanted);
+  return r ? fromRow(r) : null;
+};
+
+/**
+ * Set a user's lastLogin.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {Date|string} [when] defaults to now; a Date is stored as an ISO string
+ * @returns {object|null} the updated user, or null if there is none
+ */
+exports.recordLogin = (db, id, when = new Date()) => {
+  const lastLogin = when instanceof Date ? when.toISOString() : when;
+  db.update('users', (u) => u.id === id, toRow({ lastLogin }));
+  return exports.getUser(db, id);
 };
+
+/**
+ * Change only the fields given; omitted fields keep their values. Nothing is written if validation fails.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {{ email?: string, fullName?: string }} [changes]
+ * @returns {object|null} the updated user, or null if there is none
+ * @throws {Error} if a new email lacks "@" or duplicates another user's, or a new fullName is invalid
+ */
+exports.updateUser = (db, id, { email, fullName } = {}) => {
+  if (!exports.getUser(db, id)) return null;
+  if (email !== undefined) {
+    if (typeof email !== 'string' || !email.includes('@')) throw new Error('Invalid email: missing "@"');
+    const existing = exports.getUserByEmail(db, email);
+    if (existing && existing.id !== id) throw new Error(`Duplicate email: ${email}`);
+  }
+  if (fullName !== undefined) checkFullName(fullName);
+  db.update('users', (u) => u.id === id, toRow({ email, fullName }));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Find users whose fullName or email contains the query, ignoring case.
+ * @param {import('../db.js').Db} db
+ * @param {string} query an empty string matches every user
+ * @returns {Array<object>} matches oldest first; empty if query is not a string
+ */
+exports.searchUsers = (db, query) => {
+  if (typeof query !== 'string') return [];
+  const q = query.toLowerCase();
+  const has = (s) => typeof s === 'string' && s.toLowerCase().includes(q);
+  return exports.listUsers(db).filter((u) => has(u.fullName) || has(u.email));
+};
+
+/**
+ * Remove a user.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @returns {boolean} true if a user was removed, false if there was none
+ */
+exports.deleteUser =(db, id) => db.delete('users', (u) => u.id === id) > 0;
+
+/**
+ * Count the stored users.
+ * @param {import('../db.js').Db} db
+ * @returns {number}
+ */
+exports.countUsers =(db) => db.all('users').length;
+
+/**
+ * List users sorted by createdAt, oldest first, optionally one page at a time.
+ * @param {import('../db.js').Db} db
+ * @param {{ limit?: number, offset?: number }} [page] limit defaults to no limit, offset to 0
+ * @returns {Array<object>}
+ * @throws {Error} if limit or offset is not a non-negative integer
+ */
+exports.listUsers = (db, { limit, offset = 0 } = {}) => {
+  const valid = (n) => Number.isInteger(n) && n >= 0;
+  if (!valid(offset)) throw new Error('Invalid offset: must be a non-negative integer');
+  if (limit !== undefined && !valid(limit)) throw new Error('Invalid limit: must be a non-negative integer');
+  const users = db.all('users').sort((a, b) => a.created_at.localeCompare(b.created_at)).map(fromRow);
+  return users.slice(offset, limit === undefined ? undefined : offset + limit);
+};
+
+// Every exported function takes db first; fail clearly instead of with a TypeError deep inside.
+for (const name of Object.keys(exports)) {
+  const fn = exports[name];
+  exports[name] = (db, ...args) => {
+    if (db === undefined || db === null) throw new Error(`${name}: db is required`);
+    return fn(db, ...args);
+  };
+}
