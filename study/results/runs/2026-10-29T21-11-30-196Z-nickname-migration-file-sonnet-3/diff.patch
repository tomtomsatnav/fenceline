+/**
+ * Limit x to the range from lo to hi, both inclusive: x if it is within the range, otherwise the
+ * nearer bound. lo and hi may be -Infinity and Infinity for a one-sided limit, and lo may equal hi.
+ * A bound is never swapped for you: lo greater than hi is an error. x itself may be anything numeric,
+ * including Infinity, which clamps to hi. NaN has no place in the range, so clamp(NaN, lo, hi) is NaN.
+ * @param {number} x
+ * @param {number} lo lower bound
+ * @param {number} hi upper bound
+ * @returns {number}
+ * @throws {TypeError} if x, lo or hi is not a number
+ * @throws {RangeError} if lo or hi is NaN, or lo is greater than hi
+ */
+exports.clamp = (x, lo, hi) => {
+  for (const [name, value] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof value !== 'number') throw new TypeError(`clamp: ${name} must be a number`);
+  }
+  if (Number.isNaN(lo) || Number.isNaN(hi)) throw new RangeError('clamp: lo and hi must not be NaN');
+  if (lo > hi) throw new RangeError('clamp: lo must not be greater than hi');
+  if (x < lo) return lo;
+  if (x > hi) return hi;
+  return x;
+};
+
+// Move the decimal point of x by n places using its decimal text, so no binary rounding creeps in.
+const shiftDecimal = (x, n) => {
+  const [mantissa, exponent = '0'] = String(x).split('e');
+  return Number(`${mantissa}e${Number(exponent) + n}`);
+};
+
+/**
+ * Round x to the given number of decimal places, rounding halves away from zero: roundTo(2.5, 0) is 3
+ * and roundTo(-2.5, 0) is -3. Ties are decided on the decimal value as written, not on its binary
+ * approximation, so roundTo(1.005, 2) is 1.01 (Math.round(1.005 * 100) / 100 gives 1). Negative places
+ * round to the left of the point: roundTo(1250, -2) is 1300. NaN and the infinities are returned
+ * unchanged. A result of zero is always +0, never -0, so roundTo(-0.4, 0) is 0.
+ * @param {number} x
+ * @param {number} [places] an integer; defaults to 0
+ * @returns {number}
+ * @throws {TypeError} if x or places is not a number
+ * @throws {RangeError} if places is not an integer
+ */
+exports.roundTo = (x, places = 0) => {
+  if (typeof x !== 'number') throw new TypeError('roundTo: x must be a number');
+  if (typeof places !== 'number') throw new TypeError('roundTo: places must be a number');
+  if (!Number.isInteger(places)) throw new RangeError('roundTo: places must be an integer');
+  if (!Number.isFinite(x)) return x;
+  const shifted = shiftDecimal(Math.abs(x), places);
+  if (!Number.isFinite(shifted)) return x; // too many places to matter: x has no digits that far out
+  const rounded = shiftDecimal(Math.round(shifted), -places);
+  const result = x < 0 ? -rounded : rounded;
+  return result === 0 ? 0 : result;
+};
+
+// Sum of finite numbers with Neumaier compensation, so many small terms don't lose their low bits.
+const compensatedSum = (values, scale = 1) => {
+  let sum = 0;
+  let compensation = 0;
+  for (const value of values) {
+    const x = value / scale;
+    const t = sum + x;
+    compensation += Math.abs(sum) >= Math.abs(x) ? (sum - t) + x : (x - t) + sum;
+    sum = t;
+  }
+  return sum + compensation;
+};
+
+/**
+ * Arithmetic mean of an array of numbers; NaN for an empty array. Finite values are summed with
+ * compensation, so the result is more accurate than a plain sum / length, and a sum that would
+ * overflow does not ruin the mean: mean([1e308, 1e308]) is 1e308. The result is always within the
+ * range of the values, so the mean of equal values is exactly that value. NaN and infinities behave as in
+ * ordinary arithmetic: any NaN gives NaN, Infinity with finite values gives Infinity, and Infinity
+ * with -Infinity gives NaN. xs is not modified.
+ * @param {number[]} xs
+ * @returns {number}
+ * @throws {TypeError} if xs is not an array, or any item is not a number (including a hole in a
+ *   sparse array); numeric strings and BigInts are not converted
+ */
+exports.mean = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('mean: xs must be an array');
