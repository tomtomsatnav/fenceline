+const checkNumbers = (name, xs) => {
+  if (!Array.isArray(xs)) throw new TypeError(`${name} expects an array`);
+  for (const x of xs) {
+    if (typeof x !== 'number') throw new TypeError(`${name} expects every item to be a number`);
+  }
+};
+
+// Arithmetic mean of the numbers in xs. An empty array gives NaN. Any NaN item makes the result NaN.
+exports.mean = (xs) => {
+  checkNumbers('mean', xs);
+  let sum = 0;
+  for (const x of xs) sum += x;
+  return sum / xs.length;
+};
+
+// A sorted copy of the numbers. Uses < and > rather than subtraction, which gives NaN for Infinity - Infinity.
+const sortedCopy = (xs) => [...xs].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+
+// Population standard deviation: the square root of the mean of the squared differences from the mean. Divides by n, not n - 1.
+// An empty array gives NaN. Any NaN or infinite item gives NaN, since the mean or a difference from it is then not a number.
+exports.stdDev = (xs) => {
+  checkNumbers('stdDev', xs);
+  if (xs.length === 0) return NaN;
+  const m = exports.mean(xs);
+  const sumOfSquares = xs.reduce((sum, x) => sum + (x - m) ** 2, 0);
+  return Math.sqrt(sumOfSquares / xs.length);
+};
+
+// Middle value of the sorted numbers, or the average of the two middle values for an even count.
+// An empty array gives NaN. Sorts a copy, so xs is not changed.
+exports.median = (xs) => {
+  checkNumbers('median', xs);
+  if (xs.length === 0 || xs.some(Number.isNaN)) return NaN;
+  const sorted = sortedCopy(xs);
+  const mid = Math.floor(sorted.length / 2);
+  if (sorted.length % 2 === 1) return sorted[mid];
+  return (sorted[mid - 1] + sorted[mid]) / 2;
+};
+
+// Value at percentile p (0 to 100) by linear interpolation between the two nearest sorted values.
+// An empty array gives NaN. Sorts a copy, so xs is not changed.
+exports.percentile = (xs, p) => {
+  checkNumbers('percentile', xs);
+  if (typeof p !== 'number') throw new TypeError('percentile expects a number for p');
+  if (!(p >= 0 && p <= 100)) throw new RangeError('percentile expects p between 0 and 100');
+  if (xs.length === 0 || xs.some(Number.isNaN)) return NaN;
+  const sorted = sortedCopy(xs);
+  const rank = (p * (sorted.length - 1)) / 100;
+  const lo = Math.floor(rank);
+  const hi = Math.ceil(rank);
+  if (lo === hi || sorted[lo] === sorted[hi]) return sorted[lo];
+  return sorted[lo] + (sorted[hi] - sorted[lo]) * (rank - lo);
+};
