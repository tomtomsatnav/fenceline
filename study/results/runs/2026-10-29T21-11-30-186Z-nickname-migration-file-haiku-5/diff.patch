+
+test('commonPrefix does not depend on the order of the strings', () => {
+  assert.strictEqual(commonPrefix(['flow', 'flight', 'flower']), commonPrefix(['flower', 'flight', 'flow']));
+});
+
+test('commonPrefix is case-sensitive', () => {
+  assert.strictEqual(commonPrefix(['Ab', 'ab']), '');
+  assert.strictEqual(commonPrefix(['Abc', 'Abd']), 'Ab');
