+// Each unit at most once, largest first, with whole numbers only. At least one part is required.
+const DURATION = /^(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/;
+const SECONDS = { d: 86400, h: 3600, m: 60, s: 1 };
