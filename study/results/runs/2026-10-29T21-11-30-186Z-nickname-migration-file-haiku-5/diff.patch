+// Every run of n consecutive items, in order. Each window is a new array. Fewer than n items gives [].
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed expects an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('windowed expects a positive integer size');
+  const windows = [];
+  for (let i = 0; i + n <= xs.length; i++) windows.push(xs.slice(i, i + n));
+  return windows;
+};
+
+// Returns one item chosen at random, or undefined for an empty array. rng must return a number in [0, 1).
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new TypeError('sample expects an array');
+  if (typeof rng !== 'function') throw new TypeError('sample expects a random number function');
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new RangeError('sample expects rng to return a number in [0, 1)');
+  return xs[Math.floor(r * xs.length)];
+};
+
+// Returns a new array sorted by keyFn, keeping equal keys in their original order (sort is stable).
+// Keys are compared with < and >, so numbers, strings and dates work. A key that is null, undefined or NaN throws.
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('sortBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('sortBy expects a key function');
+  const keyed = [];
+  for (const x of xs) {
+    const key = keyFn(x);
+    if (key === undefined || key === null || Number.isNaN(key)) throw new TypeError(`sortBy cannot sort by key: ${key}`);
+    keyed.push({ x, key });
+  }
+  keyed.sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0));
+  return keyed.map(({ x }) => x);
+};
+
+// Flattens arrays nested to any depth into one array, in order. Empty holes in a sparse array are skipped, as Array#flat does.
+// Uses an explicit stack rather than recursion, so very deep nesting does not overflow the call stack.
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep expects an array');
+  const out = [];
+  const stack = [{ items: xs, i: 0 }];
+  // The arrays currently open on the stack, to catch an array that contains itself.
+  const open = new Set([xs]);
+  while (stack.length > 0) {
+    const top = stack[stack.length - 1];
+    if (top.i >= top.items.length) {
+      open.delete(top.items);
+      stack.pop();
+      continue;
+    }
+    const present = top.i in top.items;
+    const x = top.items[top.i++];
+    if (!present) continue;
+    if (Array.isArray(x)) {
+      if (open.has(x)) throw new TypeError('flattenDeep cannot flatten an array that contains itself');
+      open.add(x);
+      stack.push({ items: x, i: 0 });
+    } else {
+      out.push(x);
+    }
+  }
+  return out;
+};
+
+// Numbers from start up to but not including end, stepping by step. A negative step counts down.
+// Each value is start + i * step, rather than adding step repeatedly, so floating-point error does not build up.
+exports.range = (start, end, step = 1) => {
+  for (const [name, value] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof value !== 'number') throw new TypeError(`range expects a number for ${name}`);
+    if (!Number.isFinite(value)) throw new RangeError(`range expects a finite number for ${name}`);
+  }
+  if (step === 0) throw new RangeError('range expects a step other than 0');
+  const count = Math.max(0, Math.ceil((end - start) / step));
+  return Array.from({ length: count }, (_, i) => start + i * step);
+};
+
+// Pairs items by position, stopping at the shorter array. Extra items in the longer array are dropped.
+exports.zip = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new TypeError('zip expects two arrays');
+  const length = Math.min(a.length, b.length);
+  const pairs = [];
+  for (let i = 0; i < length; i++) pairs.push([a[i], b[i]]);
+  return pairs;
+};
+
+// Splits xs into [items where pred is true, items where it is false], each in the original order.
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition expects an array');
+  if (typeof pred !== 'function') throw new TypeError('partition expects a predicate function');
+  const matching = [];
+  const notMatching = [];
+  for (const x of xs) (pred(x) ? matching : notMatching).push(x);
+  return [matching, notMatching];
+};
+
+// The item whose key is largest, or undefined for an empty array. Keys are compared with >, as in sortBy, and a key that is
+// null, undefined or NaN throws. When keys tie, the first item wins.
+exports.maxBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('maxBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('maxBy expects a key function');
+  let best;
+  let bestKey;
+  let found = false;
+  for (const x of xs) {
+    const key = keyFn(x);
+    if (key === undefined || key === null || Number.isNaN(key)) throw new TypeError(`maxBy cannot compare key: ${key}`);
+    if (!found || key > bestKey) {
+      best = x;
+      bestKey = key;
+      found = true;
+    }
+  }
+  return best;
+};
+
+// How many items give each key, as an object. Keys are converted with String, as in groupBy, so 1 and '1' share a count.
+exports.countBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('countBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('countBy expects a key function');
+  const counts = {};
+  for (const x of xs) {
+    const key = String(keyFn(x));
+    const current = Object.hasOwn(counts, key) ? counts[key] : 0;
+    // defineProperty, not assignment, so a key such as "__proto__" becomes an ordinary property.
+    Object.defineProperty(counts, key, { value: current + 1, enumerable: true, writable: true, configurable: true });
+  }
+  return counts;
+};
+
+// Object keys are strings, so keyFn's result is converted with String. Items keep their original order within each group.
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy expects a key function');
+  const groups = {};
+  for (const x of xs) {
+    const key = String(keyFn(x));
+    // defineProperty, not assignment, so a key such as "__proto__" becomes an ordinary property.
+    if (!Object.hasOwn(groups, key)) Object.defineProperty(groups, key, { value: [], enumerable: true, writable: true, configurable: true });
+    groups[key].push(x);
+  }
+  return groups;
+};
+
+// A new array with the items moved k places to the left, so the first k items go to the end. A negative k rotates right.
+// k wraps around the length, so rotate(xs, xs.length) is a copy of xs. An empty array gives [].
+exports.rotate = (xs, k) => {
+  if (!Array.isArray(xs)) throw new TypeError('rotate expects an array');
+  if (!Number.isSafeInteger(k)) throw new RangeError('rotate expects an integer number of places');
+  const n = xs.length;
+  if (n === 0) return [];
+  const shift = ((k % n) + n) % n;
+  return [...xs.slice(shift), ...xs.slice(0, shift)];
+};
+
+// The items that appear in every array, in the order of the first array. Matching is SameValueZero, as in difference.
+// Duplicates in the first array are kept. With one array this is a copy of it.
+exports.intersection = (...arrays) => {
+  if (arrays.length === 0) throw new RangeError('intersection expects at least one array');
+  if (!arrays.every((a) => Array.isArray(a))) throw new TypeError('intersection expects arrays');
+  const [first, ...rest] = arrays;
+  const sets = rest.map((a) => new Set(a));
+  return first.filter((x) => sets.every((set) => set.has(x)));
+};
+
+// The items of a that are not in b, in the order of a. Items are matched with SameValueZero, as Set does, so objects match
+// only themselves. Duplicates in a are all kept unless b contains them.
+exports.difference = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new TypeError('difference expects two arrays');
+  const exclude = new Set(b);
+  return a.filter((x) => !exclude.has(x));
+};
+
+// Keeps the first item for each key, in the original order. Keys are compared with SameValueZero, as Set does.
+exports.uniqueBy = (xs, keyFn) => {
