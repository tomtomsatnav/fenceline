+// 8-4-4-4-12 hex digits, with version 1 to 5 in the first digit of the third group and RFC 4122 variant bits (8, 9, a or b) in the fourth.
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+// True for a UUID in the RFC 4122 form, of version 1 to 5, in either letter case. Rejects the nil UUID, braces, a urn: prefix
+// and a missing or extra hyphen. Versions 6 to 8 come from the later RFC 9562, so they are rejected.
+exports.isUuid = (text) => {
+  if (typeof text !== 'string') throw new TypeError('isUuid expects a string');
+  return UUID.test(text);
+};
+
+// True for a password of at least 12 characters that has a lower-case letter, an upper-case letter, a digit and a symbol
+// (punctuation or a symbol character such as $ or +). Spaces are not symbols. Length counts characters, not UTF-16 units.
+exports.isStrongPassword = (text) => {
+  if (typeof text !== 'string') throw new TypeError('isStrongPassword expects a string');
+  if (Array.from(text).length < 12) return false;
+  return /\p{Ll}/u.test(text) && /\p{Lu}/u.test(text) && /\p{Nd}/u.test(text) && /[\p{P}\p{S}]/u.test(text);
+};
