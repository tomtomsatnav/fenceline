+  if (exports.getUserByEmail(db, user.email)) throw new Error(`email already in use: ${user.email}`);
+  checkFullName(user.fullName);
+  if (exports.getUser(db, user.id)) throw new Error(`user id already in use: ${user.id}`);
+  db.insert('users', toRow(user));
+  return exports.getUser(db, user.id);
+};
+
+/**
+ * Find a user by id.
+ * @param {Db} db
+ * @param {string} id
+ * @returns {object | null} the user, or null if none has that id
+ */
 exports.getUser = (db, id) => {
+  requireDb(db);
   const r = db.find('users', (u) => u.id === id);
   if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return fromRow(r);
