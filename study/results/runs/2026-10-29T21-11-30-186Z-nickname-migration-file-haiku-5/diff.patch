+// A small set of common ISO 4217 currency codes. It is not the full list of currencies.
+const COMMON_CURRENCIES = new Set([
+  'USD', 'EUR', 'GBP', 'JPY', 'CHF', 'CAD', 'AUD', 'NZD', 'CNY', 'HKD',
+  'SGD', 'SEK', 'NOK', 'DKK', 'INR', 'BRL', 'MXN', 'ZAR', 'KRW', 'PLN',
+]);
+
+// True for an upper-case three-letter code from the COMMON_CURRENCIES list. Codes not in the list are rejected, even if valid ISO 4217.
+exports.isIsoCurrency = (text) => {
+  if (typeof text !== 'string') throw new TypeError('isIsoCurrency expects a string');
+  return COMMON_CURRENCIES.has(text);
+};
