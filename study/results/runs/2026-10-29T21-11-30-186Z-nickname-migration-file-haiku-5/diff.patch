+/**
+ * Name to show for a user: the full name, or the part of the email before "@" if there is no full name.
+ * @param {{ email: string, fullName: string | null }} user
+ * @returns {string}
+ */
+exports.displayName = (user) => {
+  if (user.fullName?.trim()) return user.fullName;
+  return user.email.split('@')[0];
+};
