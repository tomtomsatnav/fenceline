+const checkSupported = (v) => {
+  if (v === null || v === undefined) return;
+  if (typeof v === 'number' || typeof v === 'string' || typeof v === 'boolean') return;
+  if (typeof v === 'object' && (Array.isArray(v) || isPlainObject(v))) return;
+  throw new TypeError(`deepEqual cannot compare a value of this kind: ${typeof v}`);
+};
