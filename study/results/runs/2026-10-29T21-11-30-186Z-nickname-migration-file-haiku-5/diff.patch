+    url = new URL(text);
+  } catch {
+    return false;
+  }
+  return (url.protocol === 'http:' || url.protocol === 'https:') && url.hostname !== '';
+};
+
+// Characters allowed in an unquoted local part, with dots between runs of them and no leading, trailing or doubled dot.
+const LOCAL_PART = /^[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*$/;
+// One domain label: letters, digits and hyphens, not starting or ending with a hyphen, at most 63 characters.
+const DOMAIN_LABEL = /^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$/;
+// The top-level domain is letters only, at least two of them.
+const TOP_LEVEL = /^[A-Za-z]{2,}$/;
+
+// A reasonable email check, not a full RFC 5322 parser. Requires exactly one "@", a local part of up to 64 characters, a domain
+// with at least one dot, and a letters-only top-level domain. Spaces are rejected, and so are non-ASCII letters and quoted local parts.
+exports.isEmail = (text) => {
+  if (typeof text !== 'string') throw new TypeError('isEmail expects a string');
+  if (text.length > 254) return false;
+  const parts = text.split('@');
+  if (parts.length !== 2) return false;
+  const [local, domain] = parts;
+  if (local.length > 64 || !LOCAL_PART.test(local)) return false;
+  const labels = domain.split('.');
+  if (labels.length < 2 || !labels.every((label) => DOMAIN_LABEL.test(label))) return false;
+  return TOP_LEVEL.test(labels[labels.length - 1]);
+};
diff --git a/test/export.test.js b/test/export.test.js
new file mode 100644
index 0000000..f1fa499
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,65 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { createUser, recordLogin, listUsers, countUsers } = require('../src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+test('exports a header row and one row per user', () => {
+  const db = migrate(new Db());
+  const ada = createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  recordLogin(db, ada.id, '2025-03-04T05:06:07.000Z');
+  createUser(db, { email: 'grace@example.com', fullName: 'Grace Hopper' });
+  const [header, first, second] = exportUsersCsv(db).split('\n');
+  assert.strictEqual(header, 'id,email,fullName,createdAt,lastLogin');
+  assert.strictEqual(first, `${ada.id},ada@example.com,Ada Lovelace,${ada.createdAt},2025-03-04T05:06:07.000Z`);
+  assert.ok(second.includes(',grace@example.com,Grace Hopper,'));
+  assert.ok(second.endsWith(','));
+});
+
+test('quotes fields that contain commas, quotes, or line breaks', () => {
+  const db = migrate(new Db());
+  const u = createUser(db, { email: 'ada@example.com', fullName: 'Lovelace, "Ada"\nKing' });
+  assert.strictEqual(
+    exportUsersCsv(db),
+    `id,email,fullName,createdAt,lastLogin\n${u.id},ada@example.com,"Lovelace, ""Ada""\nKing",${u.createdAt},\n`
+  );
+});
+
+test('exports every user, not just the first page', () => {
+  const db = migrate(new Db());
+  for (let i = 0; i < 60; i++) createUser(db, { email: `user${i}@example.com`, fullName: `User ${i}` });
+  const csv = exportUsersCsv(db);
+  assert.strictEqual(csv.trimEnd().split('\n').length, 61);
+});
+
+test('exports only the header when there are no users', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), 'id,email,fullName,createdAt,lastLogin\n');
+});
+
+test('importing an export restores the same users', () => {
+  const source = migrate(new Db());
+  const ada = createUser(source, { email: 'ada@example.com', fullName: 'Lovelace, "Ada"\nKing' });
+  recordLogin(source, ada.id, '2025-03-04T05:06:07.000Z');
+  createUser(source, { email: 'grace@example.com', fullName: 'Grace Hopper' });
+  const csv = exportUsersCsv(source);
+
+  const target = migrate(new Db());
+  assert.strictEqual(importUsersCsv(target, csv), 2);
+  assert.deepStrictEqual(listUsers(target), listUsers(source));
+  assert.strictEqual(exportUsersCsv(target), csv);
+});
+
+test('a failed import removes the users it had already added', () => {
+  const db = migrate(new Db());
+  const header = 'id,email,fullName,createdAt,lastLogin';
+  const csv = `${header}\n` +
+    'id-1,ada@example.com,Ada Lovelace,2024-01-01T00:00:00.000Z,\n' +
+    'id-2,grace@example.com,,2024-01-02T00:00:00.000Z,\n';
+  assert.throws(() => importUsersCsv(db, csv), Error);
+  assert.strictEqual(countUsers(db), 0);
+});
+
+test('import rejects a CSV with the wrong header', () => {
+  assert.throws(() => importUsersCsv(migrate(new Db()), 'name,email\nAda,ada@example.com\n'), Error);
+});
