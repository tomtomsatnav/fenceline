+test('clamp returns x when it is already inside the range', () => {
+  assert.strictEqual(clamp(5, 0, 10), 5);
+  assert.strictEqual(clamp(-2, -5, 0), -2);
+});
+
+test('clamp returns lo when x is below the range', () => {
+  assert.strictEqual(clamp(-3, 0, 10), 0);
+});
+
+test('clamp returns hi when x is above the range', () => {
+  assert.strictEqual(clamp(42, 0, 10), 10);
+});
+
+test('clamp keeps values exactly on the bounds', () => {
+  assert.strictEqual(clamp(0, 0, 10), 0);
+  assert.strictEqual(clamp(10, 0, 10), 10);
+});
+
+test('clamp with lo equal to hi always returns that value', () => {
+  assert.strictEqual(clamp(1, 4, 4), 4);
+  assert.strictEqual(clamp(9, 4, 4), 4);
+});
+
+test('clamp works with fractional and negative numbers', () => {
+  assert.strictEqual(clamp(0.75, 0.2, 0.5), 0.5);
+  assert.strictEqual(clamp(-0.5, -1.5, -0.25), -0.5);
+});
+
+test('clamp accepts infinite bounds', () => {
+  assert.strictEqual(clamp(5, -Infinity, Infinity), 5);
+  assert.strictEqual(clamp(5, 0, Infinity), 5);
+  assert.strictEqual(clamp(-5, 0, Infinity), 0);
+  assert.strictEqual(clamp(Infinity, 0, 10), 10);
+});
+
+test('clamp throws when lo is greater than hi', () => {
