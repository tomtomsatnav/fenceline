+const test = require('node:test');
+const assert = require('node:assert');
+const { pick, omit, deepEqual, deepClone, getPath, setPath, mergeDeep, invert, flattenKeys, unflattenKeys, mapValues } = require('../src/lib/objects.js');
+
+test('pick returns an object with only the listed keys', () => {
+  assert.deepStrictEqual(pick({ a: 1, b: 2, c: 3 }, ['a', 'c']), { a: 1, c: 3 });
+});
+
+test('pick skips keys the object does not have, without adding them as undefined', () => {
+  const result = pick({ a: 1 }, ['a', 'missing']);
+  assert.deepStrictEqual(result, { a: 1 });
+  assert.strictEqual(Object.hasOwn(result, 'missing'), false);
+});
+
+test('pick returns an empty object for an empty key list', () => {
+  assert.deepStrictEqual(pick({ a: 1 }, []), {});
+});
+
+test('pick returns an empty object when none of the keys exist', () => {
+  assert.deepStrictEqual(pick({ a: 1 }, ['x', 'y']), {});
+});
+
+test('pick keeps the order of the keys list', () => {
+  assert.deepStrictEqual(Object.keys(pick({ a: 1, b: 2, c: 3 }, ['c', 'a'])), ['c', 'a']);
+});
+
+test('pick keeps each key once when a key is listed twice', () => {
+  assert.deepStrictEqual(Object.keys(pick({ a: 1 }, ['a', 'a'])), ['a']);
+});
+
+test('pick keeps falsy values, including null, undefined and zero', () => {
+  assert.deepStrictEqual(pick({ a: 0, b: '', c: null, d: undefined, e: false }, ['a', 'b', 'c', 'd', 'e']),
+    { a: 0, b: '', c: null, d: undefined, e: false });
+  assert.strictEqual(Object.hasOwn(pick({ d: undefined }, ['d']), 'd'), true);
+});
+
+test('pick returns a new object and does not change the input', () => {
+  const obj = { a: 1, b: 2 };
+  const result = pick(obj, ['a']);
+  assert.notStrictEqual(result, obj);
+  result.a = 99;
+  assert.deepStrictEqual(obj, { a: 1, b: 2 });
+});
+
+test('pick copies nested values by reference', () => {
+  const nested = { x: 1 };
+  const result = pick({ n: nested }, ['n']);
+  assert.strictEqual(result.n, nested);
+});
+
+test('pick does not pick up inherited properties', () => {
+  const proto = { inherited: 1 };
+  const obj = Object.create(proto);
+  obj.own = 2;
+  assert.deepStrictEqual(pick(obj, ['inherited', 'own']), { own: 2 });
+});
+
+test('pick keeps a key named __proto__ as an ordinary property', () => {
+  const obj = JSON.parse('{"__proto__": 1, "a": 2}');
+  const result = pick(obj, ['__proto__']);
+  assert.strictEqual(Object.getPrototypeOf(result), Object.prototype);
+  assert.strictEqual(Object.getOwnPropertyDescriptor(result, '__proto__').value, 1);
+});
+
+test('pick works with symbol keys', () => {
+  const sym = Symbol('id');
+  const obj = { [sym]: 7, other: 1 };
+  assert.strictEqual(pick(obj, [sym])[sym], 7);
+});
+
+test('omit returns an object without the listed keys', () => {
+  assert.deepStrictEqual(omit({ a: 1, b: 2, c: 3 }, ['b']), { a: 1, c: 3 });
+});
+
+test('omit ignores keys the object does not have', () => {
+  assert.deepStrictEqual(omit({ a: 1 }, ['missing']), { a: 1 });
+});
+
+test('omit with an empty key list returns a copy of every property', () => {
+  assert.deepStrictEqual(omit({ a: 1, b: 2 }, []), { a: 1, b: 2 });
+});
+
+test('omit returns an empty object when every key is omitted', () => {
+  assert.deepStrictEqual(omit({ a: 1, b: 2 }, ['a', 'b']), {});
+});
+
+test('omit keeps falsy values', () => {
+  assert.deepStrictEqual(omit({ a: 0, b: '', c: null, d: undefined, e: false, f: 1 }, ['f']),
+    { a: 0, b: '', c: null, d: undefined, e: false });
