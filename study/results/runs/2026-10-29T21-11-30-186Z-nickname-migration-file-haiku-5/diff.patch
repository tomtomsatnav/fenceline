+// Words are runs of letters or digits, so spaces, hyphens, underscores and other punctuation all separate them.
+exports.camelCase = (text) => {
+  if (typeof text !== 'string') throw new TypeError('camelCase expects a string');
+  const words = text.split(/[^\p{L}\p{N}]+/u).filter((w) => w !== '').map((w) => w.toLowerCase());
+  return words.map((w, i) => (i === 0 ? w : w[0].toUpperCase() + w.slice(1))).join('');
+};
+
+// Centres s in a field of the given width. An odd gap puts the extra fill character on the right.
+// Replaces each {key} with values[key]. Placeholders with no value are left as they are.
+// Substituted text is not scanned again, so a value that contains "{...}" is inserted literally.
+exports.template = (text, values) => {
+  if (typeof text !== 'string') throw new TypeError('template expects a string');
+  if (values === null || typeof values !== 'object') throw new TypeError('template expects an object of values');
+  return text.replace(/\{([^{}]+)\}/g, (placeholder, key) => {
+    const value = Object.hasOwn(values, key) ? values[key] : undefined;
+    return value === undefined ? placeholder : String(value);
+  });
