new file mode 100644
index 0000000..7194209
--- /dev/null
+++ b/README.md
@@ -0,0 +1,71 @@
+# app
+
+## Users API
+
+The functions in `src/api/` work on an in-memory `Db` (`src/db.js`) that has been set up by `migrate()` (`src/migrate.js`). Every function throws `Error('db is required')` if `db` is missing. Users are returned as plain objects:
+
+```js
+{ id, email, fullName, createdAt, lastLogin }
+```
+
+`createdAt` and `lastLogin` are ISO 8601 strings. `lastLogin` is `null` until `recordLogin` is called.
+
+Emails must contain `@`, and are unique ignoring case. `fullName` must be a non-empty string of at most 100 characters.
+
+### `src/api/users.js`
+
+#### `createUser(db, { email, fullName })`
+
+Creates a user with a new id and the current time as `createdAt`. Returns the created user. Throws if the email has no `@`, is already in use (ignoring case), or `fullName` is invalid.
+
+#### `restoreUser(db, user)`
+
+Adds a user that already has its `id`, `createdAt`, and `lastLogin`, such as one read back from an export. Returns the restored user. Throws if the email is invalid or in use, the id is in use, or `fullName` is invalid.
+
+#### `getUser(db, id)`
+
+Returns the user with that id, or `null` if there is none.
+
+#### `getUserByEmail(db, email)`
+
+Returns the user with that email, ignoring case, or `null` if there is none.
+
+#### `countUsers(db)`
+
+Returns the number of users.
+
+#### `updateUser(db, id, { email, fullName })`
+
+Changes the fields given and leaves the others as they are. Returns the updated user, or `null` if there is no user with that id. Throws if the new email is invalid or used by another user, or the new `fullName` is invalid.
+
+#### `searchUsers(db, query)`
+
+Returns the users whose `fullName` or `email` contains `query`, ignoring case. Oldest first.
+
+#### `deleteUser(db, id)`
+
+Deletes the user with that id. Returns `true` if a user was deleted, `false` if there was none.
+
+#### `recordLogin(db, id, when)`
+
+Sets the user's `lastLogin`. `when` can be anything `new Date()` accepts and defaults to now. Returns the updated user, or `null` if there is no user with that id.
+
+#### `listUsers(db, { limit, offset })`
+
+Returns users sorted by `createdAt`, oldest first, one page at a time. `limit` defaults to 50 and `offset` to 0.
+
+### `src/api/export.js`
+
+#### `exportUsersCsv(db)`
+
+Returns every user as CSV text: a header row (`id,email,fullName,createdAt,lastLogin`), then one row per user, oldest first. Fields containing a comma, a quote, or a line break are quoted, with inner quotes doubled. Lines end in `\n`, and the text ends with a newline.
+
+#### `importUsersCsv(db, csv)`
+
+Adds the users in CSV made by `exportUsersCsv`, keeping their ids and timestamps. Returns how many users were added. If any row is invalid, the users added so far are removed and the error is thrown again. Throws if the header is wrong or a row is malformed.
+
+### `src/api/format.js`
+
+#### `displayName(user)`
+
+Returns `user.fullName` if it contains text, otherwise the part of the email before `@`.
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..eabce5e
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,87 @@
+const { listUsers, restoreUser, deleteUser } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quote a field when it contains a comma, a quote, or a line break; double any quotes inside it.
+const csvField = (value) => {
+  if (value === null || value === undefined) return '';
+  const s = String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * Export every user as CSV: a header row, then one row per user, oldest first.
+ * @param {Db} db
+ * @returns {string} CSV text ending in a newline
+ */
+exports.exportUsersCsv = (db) => {
+  // limit: Infinity so every user is exported, not just the first page.
+  const users = listUsers(db, { limit: Infinity });
+  const lines = [COLUMNS.join(','), ...users.map((u) => COLUMNS.map((c) => csvField(u[c])).join(','))];
+  return lines.join('\n') + '\n';
+};
+
+// Split CSV text into rows of fields, honouring quoted fields that contain commas, quotes, or line breaks.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const ch = text[i];
+    if (quoted) {
+      if (ch === '"' && text[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else if (ch === '"') {
+        quoted = false;
+      } else {
+        field += ch;
+      }
+    } else if (ch === '"') {
+      quoted = true;
+    } else if (ch === ',') {
+      row.push(field);
+      field = '';
+    } else if (ch === '\n' || ch === '\r') {
+      if (ch === '\r' && text[i + 1] === '\n') i++;
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+    } else {
+      field += ch;
+    }
+  }
+  if (field !== '' || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+  return rows.filter((r) => !(r.length === 1 && r[0] === ''));
+};
+
+/**
+ * Add the users in a CSV made by exportUsersCsv, keeping their ids and timestamps.
+ * If any row is invalid, the users added so far are removed again.
+ * @param {Db} db
+ * @param {string} csv
+ * @returns {number} how many users were added
+ * @throws {Error} if the header is wrong, a row is malformed, or a user fails validation
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (!db) throw new Error('db is required');
+  const [header, ...rows] = parseCsv(csv);
+  if (header?.join(',') !== COLUMNS.join(',')) throw new Error(`unexpected CSV header: ${header}`);
+  const added = [];
+  try {
+    rows.forEach((fields, i) => {
+      if (fields.length !== COLUMNS.length) throw new Error(`row ${i + 1} has ${fields.length} fields, expected ${COLUMNS.length}`);
+      const [id, email, fullName, createdAt, lastLogin] = fields;
+      added.push(restoreUser(db, { id, email, fullName, createdAt, lastLogin: lastLogin === '' ? null : lastLogin }).id);
+    });
+  } catch (err) {
+    for (const id of added) deleteUser(db, id);
+    throw err;
+  }
+  return added.length;
+};
