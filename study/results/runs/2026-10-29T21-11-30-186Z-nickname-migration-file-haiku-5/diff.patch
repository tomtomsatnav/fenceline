+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new TypeError('wrap expects a string');
+  if (!Number.isInteger(width) || width < 1) throw new RangeError('wrap expects a positive integer width');
+  const lines = [];
+  let line = '';
+  for (const word of text.split(/\s+/).filter((w) => w !== '')) {
+    if (line === '') {
+      line = word;
+    } else if (Array.from(line).length + 1 + Array.from(word).length <= width) {
+      line += ' ' + word;
+    } else {
+      lines.push(line);
+      line = word;
+    }
+  }
+  if (line !== '') lines.push(line);
+  return lines.join('\n');
+};
+
+// Only letters and digits are compared, ignoring case. NFC first, so accents written as separate marks reverse correctly.
+exports.isPalindrome = (text) => {
+  if (typeof text !== 'string') throw new TypeError('isPalindrome expects a string');
+  const chars = Array.from(text.normalize('NFC').toLowerCase().replace(/[^\p{L}\p{N}]/gu, ''));
+  return chars.join('') === chars.slice().reverse().join('');
