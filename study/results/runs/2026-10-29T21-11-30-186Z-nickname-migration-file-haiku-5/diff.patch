+// Total seconds in a duration such as "1d2h30m15s". Units are d, h, m and s, lower case, each at most once, in that order.
+// Spaces, signs, decimals and a bare number with no unit are rejected, as is an empty string or a total that is not a safe integer.
+exports.parseDuration = (text) => {
+  if (typeof text !== 'string') throw new TypeError('parseDuration expects a string');
