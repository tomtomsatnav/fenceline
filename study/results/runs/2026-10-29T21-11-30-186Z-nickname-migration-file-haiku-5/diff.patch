+
+/**
+ * Find a user by email, ignoring case.
+ * @param {Db} db
+ * @param {string} email
+ * @returns {object | null} the user, or null if none has that email
+ */
+exports.getUserByEmail = (db, email) => {
+  requireDb(db);
+  const r = db.find('users', (u) => u.email.toLowerCase() === email.toLowerCase());
+  if (!r) return null;
+  return fromRow(r);
+};
+
+/**
+ * Count all users.
+ * @param {Db} db
+ * @returns {number}
+ */
+exports.countUsers = (db) => {
+  requireDb(db);
+  return db.all('users').length;
+};
+
+/**
+ * Change the given fields of a user. Fields that are undefined are left as they are.
+ * @param {Db} db
+ * @param {string} id
+ * @param {{ email?: string, fullName?: string }} changes
+ * @returns {object | null} the updated user, or null if none has that id
+ * @throws {Error} if the new email is invalid or used by another user, or the new fullName is invalid
+ */
+exports.updateUser = (db, id, { email, fullName }) => {
+  requireDb(db);
+  const changes = {};
+  if (email !== undefined) {
+    if (!email?.includes('@')) throw new Error(`invalid email: ${email}`);
+    const other = exports.getUserByEmail(db, email);
+    if (other && other.id !== id) throw new Error(`email already in use: ${email}`);
+    changes.email = email;
+  }
+  if (fullName !== undefined) {
+    checkFullName(fullName);
+    changes.fullName = fullName;
+  }
+  db.update('users', (u) => u.id === id, toRow(changes));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Find users whose full name or email contains the query, ignoring case. Oldest first.
+ * @param {Db} db
+ * @param {string} query
+ * @returns {object[]}
+ */
+exports.searchUsers = (db, query) => {
+  requireDb(db);
+  const q = query.toLowerCase();
+  return sortedUsers(db).filter((u) => [u.fullName, u.email].some((f) => f?.toLowerCase().includes(q)));
+};
+
+/**
+ * Delete a user by id.
+ * @param {Db} db
+ * @param {string} id
+ * @returns {boolean} true if a user was deleted, false if none had that id
+ */
+exports.deleteUser = (db, id) => {
+  requireDb(db);
+  return db.delete('users', (u) => u.id === id) > 0;
+};
+
+/**
+ * Set a user's lastLogin.
+ * @param {Db} db
+ * @param {string} id
+ * @param {Date | string | number} [when] anything `new Date()` accepts; defaults to now
+ * @returns {object | null} the updated user, or null if none has that id
+ */
+exports.recordLogin = (db, id, when) => {
+  requireDb(db);
+  db.update('users', (u) => u.id === id, toRow({ lastLogin: new Date(when ?? Date.now()).toISOString() }));
+  return exports.getUser(db, id);
+};
+
+const sortedUsers = (db) => db.all('users').map(fromRow).sort((a, b) => a.createdAt.localeCompare(b.createdAt));
+
+/**
+ * List users sorted by createdAt, oldest first, one page at a time.
+ * @param {Db} db
+ * @param {{ limit?: number, offset?: number }} [page] defaults to the first 50 users
+ * @returns {object[]}
+ */
+exports.listUsers = (db, { limit = 50, offset = 0 } = {}) => {
+  requireDb(db);
+  return sortedUsers(db).slice(offset, offset + limit);
 };
+
+// User fields to table columns. Fields left undefined are omitted, so they are not written.
+const toRow = (user) => Object.fromEntries(
+  Object.entries({ id: user.id, email: user.email, fullname: user.fullName, nickname: user.nickname, created_at: user.createdAt, last_login: user.lastLogin })
+    .filter(([, v]) => v !== undefined)
+);
+
+// Table row to user object.
+const fromRow = (r) => ({
+  id: r.id,
+  email: r.email,
+  fullName: r.fullname,
+  nickname: r.nickname ?? null,
+  createdAt: r.created_at,
+  lastLogin: r.last_login ?? null,
+});
