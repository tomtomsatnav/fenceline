+test('levenshtein gives the known distances for classic pairs', () => {
+  assert.strictEqual(levenshtein('kitten', 'sitting'), 3);
+  assert.strictEqual(levenshtein('flaw', 'lawn'), 2);
+});
+
+test('levenshtein is 0 for identical strings', () => {
+  assert.strictEqual(levenshtein('abc', 'abc'), 0);
+  assert.strictEqual(levenshtein('', ''), 0);
+});
+
+test('levenshtein counts a single substitution, insertion, or deletion as one', () => {
+  assert.strictEqual(levenshtein('a', 'b'), 1);
+  assert.strictEqual(levenshtein('ab', 'abc'), 1);
+  assert.strictEqual(levenshtein('abc', 'ab'), 1);
+});
+
+test('levenshtein of an empty string is the length of the other string', () => {
+  assert.strictEqual(levenshtein('', 'abc'), 3);
+  assert.strictEqual(levenshtein('abc', ''), 3);
+});
+
+test('levenshtein is symmetric', () => {
+  assert.strictEqual(levenshtein('sunday', 'saturday'), levenshtein('saturday', 'sunday'));
+  assert.strictEqual(levenshtein('sunday', 'saturday'), 3);
+});
+
+test('levenshtein is case-sensitive', () => {
+  assert.strictEqual(levenshtein('A', 'a'), 1);
+});
+
+test('levenshtein counts a transposition as two edits', () => {
+  assert.strictEqual(levenshtein('ab', 'ba'), 2);
+});
+
+test('levenshtein counts completely different strings by the longer length', () => {
+  assert.strictEqual(levenshtein('abc', 'xyz'), 3);
+  assert.strictEqual(levenshtein('ab', 'xyzw'), 4);
+});
+
