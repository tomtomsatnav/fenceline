+  assert.throws(() => padCenter('x', 5, ''), RangeError);
+  assert.throws(() => padCenter('x', 5, 'ab'), RangeError);
+  assert.throws(() => padCenter('x', -1), RangeError);
+  assert.throws(() => padCenter('x', 2.5), RangeError);
+});
