+test('commonPrefix finds the longest shared start', () => {
+  assert.strictEqual(commonPrefix(['flower', 'flow', 'flight']), 'fl');
+  assert.strictEqual(commonPrefix(['interview', 'internet', 'interval']), 'inter');
+});
+
+test('commonPrefix does not depend on the order of the strings', () => {
+  assert.strictEqual(commonPrefix(['flight', 'flow', 'flower']), 'fl');
+});
+
+test('commonPrefix is empty when the strings share no start', () => {
+  assert.strictEqual(commonPrefix(['dog', 'racecar', 'car']), '');
+  assert.strictEqual(commonPrefix(['', 'abc']), '');
+});
+
+test('commonPrefix of an empty array is an empty string', () => {
+  assert.strictEqual(commonPrefix([]), '');
+});
+
+test('commonPrefix of one string is that string', () => {
+  assert.strictEqual(commonPrefix(['abc']), 'abc');
+});
+
+test('commonPrefix returns the shorter string when it is a prefix of the others', () => {
+  assert.strictEqual(commonPrefix(['abc', 'ab']), 'ab');
+  assert.strictEqual(commonPrefix(['abc', 'abc']), 'abc');
+});
+
+test('commonPrefix is case-sensitive', () => {
+  assert.strictEqual(commonPrefix(['Apple', 'apple']), '');
+});
+
+test('commonPrefix never splits an emoji in half', () => {
