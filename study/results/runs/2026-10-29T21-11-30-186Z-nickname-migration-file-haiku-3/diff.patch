+/**
+ * Numbers from start up to but not including end, going up by step or down by a negative step.
+ * Each value is start + i * step, so floating-point steps do not accumulate error.
+ * @param {number} start
+ * @param {number} end Exclusive bound.
+ * @param {number} [step=1] Must not be 0.
+ * @returns {number[]} The numbers in order; [] when end is not reached in the direction of step.
+ * @throws {TypeError} If start, end, or step is not a number.
+ * @throws {RangeError} If a value is NaN or infinite, or step is 0.
+ */
+exports.range = (start, end, step = 1) => {
+  for (const [name, value] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof value !== 'number') throw new TypeError(`range expects a number for ${name}`);
+    if (!Number.isFinite(value)) throw new RangeError(`range expects a finite number for ${name}`);
+  }
+  if (step === 0) throw new RangeError('range step must not be 0');
+  const count = Math.max(0, Math.ceil((end - start) / step));
+  const out = [];
+  for (let i = 0; i < count; i++) out.push(start + i * step);
+  return out;
+};
