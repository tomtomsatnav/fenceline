+/**
+ * Splits an array into consecutive arrays of length n. The last chunk may be shorter.
+ * The input is not modified.
+ * @param {Array} xs
+ * @param {number} n Chunk length, a positive integer.
+ * @returns {Array[]} The chunks in order; [] for an empty array.
+ * @throws {TypeError} If xs is not an array.
+ * @throws {RangeError} If n is not a positive integer.
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk expects an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('chunk expects a positive integer size');
+  const out = [];
+  for (let i = 0; i < xs.length; i += n) out.push(xs.slice(i, i + n));
+  return out;
+};
+
+/**
+ * Groups items into arrays keyed by keyFn. Each group keeps the items' original order.
+ * Keys are converted to strings, as object keys are, so 1 and '1' share a group.
+ * The input is not modified.
+ * @param {Array} xs
+ * @param {function(*): *} keyFn Returns the group for an item; called once per item.
+ * @returns {Object<string, Array>} One array per distinct key, in order of first appearance.
+ * @throws {TypeError} If xs is not an array or keyFn is not a function.
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy expects a key function');
+  const out = {};
+  for (const x of xs) {
+    const key = String(keyFn(x));
+    if (!Object.prototype.hasOwnProperty.call(out, key)) {
+      // defineProperty rather than assignment, so a key such as "__proto__" becomes an ordinary property.
+      Object.defineProperty(out, key, { value: [], enumerable: true, writable: true, configurable: true });
+    }
+    out[key].push(x);
+  }
+  return out;
+};
+
+/**
+ * Keeps the first item for each key, in their original order. Keys are compared as Set does
+ * (SameValueZero), so objects match only themselves and NaN matches NaN. The input is not modified.
+ * @param {Array} xs
+ * @param {function(*): *} keyFn Returns the key for an item; called once per item.
+ * @returns {Array} The items whose key had not been seen before.
+ * @throws {TypeError} If xs is not an array or keyFn is not a function.
+ */
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('uniqueBy expects an array');
+  if (typeof keyFn !== 'function') throw new TypeError('uniqueBy expects a key function');
+  const seen = new Set();
+  const out = [];
+  for (const x of xs) {
+    const key = keyFn(x);
+    if (seen.has(key)) continue;
+    seen.add(key);
+    out.push(x);
+  }
+  return out;
+};
+
+/**
+ * Splits items into those that match pred and those that do not, keeping their original order.
+ * The input is not modified.
+ * @param {Array} xs
+ * @param {function(*): *} pred Called once per item; its result is read for truthiness.
+ * @returns {[Array, Array]} [matching, notMatching].
+ * @throws {TypeError} If xs is not an array or pred is not a function.
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition expects an array');
+  if (typeof pred !== 'function') throw new TypeError('partition expects a predicate function');
+  const matching = [];
+  const notMatching = [];
+  for (const x of xs) {
+    (pred(x) ? matching : notMatching).push(x);
+  }
+  return [matching, notMatching];
+};
+
+/**
+ * Pairs up the items of two arrays by position. The result is as long as the shorter array,
+ * so any extra items in the longer one are dropped. The inputs are not modified.
+ * @param {Array} a
+ * @param {Array} b
+ * @returns {Array[]} Pairs [a[i], b[i]] for each index i below the shorter length.
+ * @throws {TypeError} If a or b is not an array.
+ */
+/**
+ * The items of a that are not in b, in their original order. Membership is tested as Set does
+ * (SameValueZero), so NaN matches NaN and objects match only themselves. Duplicates in a are all
+ * kept. Neither input is modified.
+ * @param {Array} a
+ * @param {Array} b
+ * @returns {Array} A new array.
+ * @throws {TypeError} If a or b is not an array.
+ */
+exports.difference = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new TypeError('difference expects two arrays');
+  const exclude = new Set(b);
+  const out = [];
+  for (const item of a) {
+    if (!exclude.has(item)) out.push(item);
+  }
+  return out;
+};
+
+/**
+ * The distinct items that appear in every one of the given arrays. The result follows the order of
+ * the first array. Membership is tested as Set does (SameValueZero). No input is modified.
+ * @param {...Array} arrays At least one array.
+ * @returns {Array} A new array with no duplicates.
+ * @throws {RangeError} If no arrays are given.
+ * @throws {TypeError} If any argument is not an array.
+ */
+exports.intersection = (...arrays) => {
+  if (arrays.length === 0) throw new RangeError('intersection needs at least one array');
+  for (const arr of arrays) {
+    if (!Array.isArray(arr)) throw new TypeError('intersection expects arrays');
+  }
+  const [first, ...rest] = arrays;
+  const others = rest.map((arr) => new Set(arr));
+  const seen = new Set();
+  const out = [];
+  for (const item of first) {
+    if (seen.has(item)) continue;
+    seen.add(item);
+    if (others.every((set) => set.has(item))) out.push(item);
+  }
+  return out;
+};
+
+/**
+ * Rotates an array left by k places: rotate([1, 2, 3], 1) is [2, 3, 1]. A negative k rotates right.
+ * k wraps around, so k equal to the length gives a copy. The input is not modified.
+ * @param {Array} xs
+ * @param {number} k A whole number of places.
+ * @returns {Array} A new array; [] for an empty input.
+ * @throws {TypeError} If xs is not an array, or k is not a number.
+ * @throws {RangeError} If k is not a whole number.
+ */
+exports.rotate = (xs, k) => {
+  if (!Array.isArray(xs)) throw new TypeError('rotate expects an array');
+  if (typeof k !== 'number') throw new TypeError('rotate expects a number of places');
+  if (!Number.isInteger(k)) throw new RangeError('rotate expects a whole number of places');
+  if (xs.length === 0) return [];
+  // Reduce k to the range 0 to length - 1, so that a negative k rotates right.
+  const shift = ((k % xs.length) + xs.length) % xs.length;
+  return [...xs.slice(shift), ...xs.slice(0, shift)];
+};
+
+/**
+ * Counts the items in each group, where keyFn gives the group. Keys are converted to strings, as
+ * object keys are, so 1 and '1' share a count. The input is not modified.
+ * @param {Array} xs
+ * @param {function(*): *} keyFn Returns the group for an item; called once per item.
