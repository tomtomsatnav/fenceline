diff --git a/README.md b/README.md
new file mode 100644
index 0000000..b018c2f
--- /dev/null
+++ b/README.md
@@ -0,0 +1,87 @@
+# app
+
+## Users API
+
+The functions below live in `src/api/`. Each takes an in-memory `Db` (see `src/db.js`) as its first argument, with the database set up by `migrate` (see `src/migrate.js`). Every function throws `Error('db is required')` when `db` is missing.
+
+A user object has this shape:
+
+```js
+{ id, email, fullName, createdAt, lastLogin }
+```
+
+`createdAt` is an ISO 8601 string. `lastLogin` is an ISO 8601 string or `null`.
+
+### `src/api/users.js`
+
+#### `createUser(db, { email, fullName })`
+
+Creates a user with a new random id and the current time as `createdAt`. Returns the created user.
+
+Throws if the email has no `@` or is already in use (ignoring case), or if `fullName` is blank or longer than 100 characters.
+
+#### `updateUser(db, id, { email, fullName })`
+
+Changes the email and/or name of a user. A field that is `undefined` is left unchanged. Returns the updated user.
+
+Throws if no user has this `id`, or if a given email or name is invalid. The same email rules as `createUser` apply, and a user may keep their own email in a different case.
+
+#### `getUser(db, id)`
+
+Returns the user with this `id`, or `null` if there is none.
+
+#### `getUserByEmail(db, email)`
+
+Returns the user with this email, ignoring case, or `null` if there is none.
+
+#### `recordLogin(db, id, when = new Date())`
+
+Sets the user's `lastLogin` to `when`, a `Date` or a date string. Returns the updated user.
+
+Throws if no user has this `id`.
+
+#### `searchUsers(db, query)`
+
+Returns the users whose `fullName` or `email` contains `query`, ignoring case, oldest first. An empty `query` matches every user.
+
+#### `deleteUser(db, id)`
+
+Removes the user with this `id`. Returns `true` if a user was removed, `false` if none had this `id`.
+
+#### `countUsers(db)`
+
+Returns the number of users.
+
+#### `listUsers(db, { limit = 50, offset = 0 } = {})`
+
+Returns one page of users, oldest first. `limit` is the maximum number to return, and `offset` is the number to skip.
+
+#### `checkDb(db)`
+
+Throws `Error('db is required')` unless `db` is given. The other functions call it first.
+
+#### `checkEmail(db, email, ownId)`
+
+Throws unless `email` contains `@` and no user other than `ownId` already has it. Pass `null` for `ownId` when creating a user.
+
+#### `checkFullName(fullName)`
+
+Throws unless `fullName` is a non-blank string of at most 100 characters.
+
+### `src/api/format.js`
+
+#### `displayName(user)`
+
+Returns `user.fullName` when it is not blank. Otherwise returns the part of `user.email` before the `@`.
+
+### `src/api/export.js`
+
+#### `exportUsersCsv(db)`
+
+Returns every user as CSV text. The first row is the header `id,email,fullName,createdAt,lastLogin`. Fields that contain a comma, a double quote, or a line break are wrapped in double quotes, with inner quotes doubled. A missing `lastLogin` is an empty field. The text ends with a newline.
+
+#### `importUsersCsv(db, csv)`
+
+Adds the users in CSV text produced by `exportUsersCsv`, keeping their ids, timestamps, and last-login times. Returns the number of users added.
+
+The whole file is checked before anything is written. The import throws if the header is wrong, a row has the wrong number of fields, an id or email is already in use (including repeats within the file), a name or email breaks the rules above, or a timestamp cannot be parsed.
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..0a10b57
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,98 @@
+const { listUsers, getUser, checkDb, checkEmail, checkFullName } = require('./users.js');
+
+const COLUMNS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quotes a CSV field when it contains a comma, a quote, or a line break; null becomes an empty field.
+const csvField = (value) => {
+  if (value === null || value === undefined) return '';
+  const s = String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * Writes all users as CSV: a header row, then one row per user, oldest first.
+ * @param {import('../db.js').Db} db
+ * @returns {string} CSV text ending with a newline.
+ * @throws {Error} If db is missing.
+ */
+exports.exportUsersCsv = (db) => {
+  const users = listUsers(db, { limit: Infinity });
+  const lines = [COLUMNS.join(','), ...users.map((u) => COLUMNS.map((c) => csvField(u[c])).join(','))];
+  return lines.join('\n') + '\n';
+};
+
+// Parses CSV text into rows of fields, handling quoted fields, doubled quotes, and line breaks inside quotes.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c === '"' && text[i + 1] === '"') {
+        field += '"';
+        i++;
+      } else if (c === '"') {
+        quoted = false;
+      } else {
+        field += c;
+      }
+    } else if (c === '"') {
+      quoted = true;
+    } else if (c === ',') {
+      row.push(field);
+      field = '';
+    } else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+    } else {
+      field += c;
+    }
+  }
+  if (field !== '' || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+  return rows.filter((r) => !(r.length === 1 && r[0] === ''));
+};
+
+/**
+ * Adds the users in CSV made by exportUsersCsv. Every row is checked before any is written.
+ * @param {import('../db.js').Db} db
+ * @param {string} csv
+ * @returns {number} The number of users added.
+ * @throws {Error} If db is missing, the header is wrong, or any row is invalid or duplicates an existing user.
+ */
+exports.importUsersCsv = (db, csv) => {
+  checkDb(db);
+  const [header, ...body] = parseCsv(csv);
+  if (!header || header.join(',') !== COLUMNS.join(',')) throw new Error('unexpected CSV header');
+
+  const rows = body.map((fields, i) => {
+    if (fields.length !== COLUMNS.length) throw new Error(`row ${i + 2} has ${fields.length} fields, expected ${COLUMNS.length}`);
+    const [id, email, fullName, createdAt, lastLogin] = fields;
+    return { id, email, fullName, createdAt, lastLogin: lastLogin === '' ? null : lastLogin };
+  });
+
+  const seenIds = new Set();
+  const seenEmails = new Set();
+  for (const r of rows) {
+    if (!r.id || seenIds.has(r.id) || getUser(db, r.id)) throw new Error(`id already in use: ${r.id}`);
+    seenIds.add(r.id);
+    checkEmail(db, r.email, null);
+    if (seenEmails.has(r.email.toLowerCase())) throw new Error(`email already in use: ${r.email}`);
+    seenEmails.add(r.email.toLowerCase());
+    checkFullName(r.fullName);
+    if (Number.isNaN(Date.parse(r.createdAt))) throw new Error(`invalid createdAt for ${r.id}: ${r.createdAt}`);
+    if (r.lastLogin !== null && Number.isNaN(Date.parse(r.lastLogin))) throw new Error(`invalid lastLogin for ${r.id}: ${r.lastLogin}`);
+  }
+
+  for (const r of rows) {
+    db.insert('users', { id: r.id, email: r.email, fullname: r.fullName, created_at: r.createdAt, last_login: r.lastLogin });
+  }
+  return rows.length;
+};
diff --git a/src/api/format.js b/src/api/format.js
new file mode 100644
