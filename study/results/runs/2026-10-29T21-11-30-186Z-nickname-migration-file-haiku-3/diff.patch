+  const birthMonth = birthDate.getUTCMonth();
+  let birthDay = birthDate.getUTCDate();
+  let monthOfBirthday = birthMonth;
+  if (birthMonth === 1 && birthDay === 29 && !isLeapYear(year)) {
+    monthOfBirthday = 2;
+    birthDay = 1;
+  }
+  const dayOfYear = date.getUTCMonth() * 100 + date.getUTCDate();
+  const birthdayOfYear = monthOfBirthday * 100 + birthDay;
