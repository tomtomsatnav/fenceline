+  if (typeof fullName !== 'string' || fullName.trim() === '') throw new Error('fullName must be a non-empty string');
+  if (fullName.length > 100) throw new Error('fullName must be at most 100 characters');
+};
+
+// Maps the fields a caller gave into database columns, leaving out any that were not given.
+const toRow = ({ email, fullName, nickname }) => {
+  const row = {};
+  if (email !== undefined) row.email = email;
+  if (fullName !== undefined) row.fullname = fullName;
+  if (nickname !== undefined) row.nickname = nickname;
+  return row;
+};
+
+exports.checkDb = checkDb;
+exports.checkEmail = checkEmail;
+exports.checkFullName = checkFullName;
+
+const fromRow = (r) => ({
+  id: r.id,
+  email: r.email,
+  fullName: r.fullname,
+  createdAt: r.created_at,
+  lastLogin: r.last_login ?? null,
+  nickname: r.nickname ?? null,
+});
