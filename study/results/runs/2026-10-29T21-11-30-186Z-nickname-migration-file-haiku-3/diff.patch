+// Splits a string into lowercase words. Splits on any run of non-letter, non-digit characters
+// and on a lowercase-to-uppercase boundary, so "helloWorld" and "hello_world" both give ["hello", "world"].
+const splitWords = (s) => {
+  if (typeof s !== 'string') throw new TypeError('expected a string');
