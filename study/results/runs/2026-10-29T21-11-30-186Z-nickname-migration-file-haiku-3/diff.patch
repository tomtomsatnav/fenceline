+
+/**
+ * Finds a user by email, ignoring case.
+ * @param {import('../db.js').Db} db
+ * @param {string} email
+ * @returns {object|null} The user, or null if none has this email.
+ * @throws {Error} If db is missing.
+ */
+exports.getUserByEmail = (db, email) => {
+  checkDb(db);
+  const r = db.find('users', (u) => u.email.toLowerCase() === email.toLowerCase());
+  if (!r) return null;
+  return fromRow(r);
+};
+
+/**
+ * Sets a user's lastLogin.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @param {Date|string} [when=new Date()] The login time.
+ * @returns {object} The updated user.
+ * @throws {Error} If db is missing or no user has this id.
+ */
+exports.recordLogin = (db, id, when = new Date()) => {
+  checkDb(db);
+  if (!exports.getUser(db, id)) throw new Error(`no user with id: ${id}`);
+  db.update('users', (u) => u.id === id, { last_login: new Date(when).toISOString() });
+  return exports.getUser(db, id);
+};
+
+/**
+ * Finds users whose fullName or email contains the query, ignoring case.
+ * @param {import('../db.js').Db} db
+ * @param {string} query
+ * @returns {object[]} Matching users, oldest first.
+ * @throws {Error} If db is missing.
+ */
+exports.searchUsers = (db, query) => {
+  checkDb(db);
+  const q = query.toLowerCase();
+  return exports.listUsers(db).filter((u) => u.fullName.toLowerCase().includes(q) || u.email.toLowerCase().includes(q));
+};
+
+/**
+ * Removes a user.
+ * @param {import('../db.js').Db} db
+ * @param {string} id
+ * @returns {boolean} true if a user was removed, false if no user has this id.
+ * @throws {Error} If db is missing.
+ */
+exports.deleteUser = (db, id) => {
+  checkDb(db);
+  return db.remove('users', (u) => u.id === id) > 0;
+};
+
+/**
+ * Counts all users.
+ * @param {import('../db.js').Db} db
+ * @returns {number}
+ * @throws {Error} If db is missing.
+ */
+exports.countUsers = (db) => {
+  checkDb(db);
+  return db.all('users').length;
 };
+
+/**
+ * Lists users, oldest first, one page at a time.
+ * @param {import('../db.js').Db} db
+ * @param {{ limit?: number, offset?: number }} [options]
+ * @param {number} [options.limit=50] Maximum number of users to return.
+ * @param {number} [options.offset=0] Number of users to skip.
+ * @returns {object[]}
+ * @throws {Error} If db is missing.
+ */
+exports.listUsers = (db, { limit = 50, offset = 0 } = {}) => {
+  checkDb(db);
+  return db.all('users').map(fromRow).sort((a, b) => a.createdAt.localeCompare(b.createdAt)).slice(offset, offset + limit);
+};
+
+/**
+ * Throws unless a database was passed in.
+ * @param {import('../db.js').Db} db
+ * @throws {Error} If db is missing.
+ */
+const checkDb = (db) => {
+  if (!db) throw new Error('db is required');
+};
+
+/**
+ * Throws unless the email has an "@" and no other user already has it.
+ * @param {import('../db.js').Db} db
+ * @param {string} email
+ * @param {string|null} ownId Id of the user being changed, or null when creating one.
+ * @throws {Error} If the email is invalid or in use by another user.
+ */
+const checkEmail = (db, email, ownId) => {
+  if (!email.includes('@')) throw new Error(`invalid email: ${email}`);
