+  assert.throws(() => invert({ a: undefined }), TypeError);
+  assert.throws(() => invert({ a: { b: 1 } }), TypeError);
+  assert.throws(() => invert({ a: [1] }), TypeError);
+  assert.throws(() => invert({ a: Symbol('s') }), TypeError);
+});
+
