+// The UTC midnight that starts the UTC calendar day of date, as a timestamp.
+// setUTCFullYear is used rather than Date.UTC, which maps years 0 to 99 to 1900 to 1999.
+const utcDayStart = (date) => {
+  const midnight = new Date(0);
+  midnight.setUTCFullYear(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate());
+  return midnight.getTime();
+};
+
+/**
+ * The number of whole UTC calendar days from one date to another, ignoring the time of day.
+ * The result is positive when to is a later day than from, and negative when it is earlier.
+ * @param {Date} from
+ * @param {Date} to
+ * @returns {number} An integer.
+ * @throws {TypeError} If from or to is not a Date.
+ * @throws {RangeError} If from or to is an invalid Date.
+ */
+exports.daysBetween = (from, to) => {
+  for (const date of [from, to]) {
+    if (!(date instanceof Date)) throw new TypeError('daysBetween expects two Dates');
+    if (Number.isNaN(date.getTime())) throw new RangeError('daysBetween expects valid Dates');
+  }
