+    .sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0))
+    .map(({ item }) => item);
+};
+
+/**
+ * Picks one item at random. Each item has an equal chance, given an rng that is uniform on [0, 1).
+ * The input is not modified.
+ * @param {Array} xs
+ * @param {function(): number} [rng=Math.random] Returns a number in [0, 1); injectable for tests.
+ * @returns {*} One item, or undefined for an empty array (rng is not called then).
+ * @throws {TypeError} If xs is not an array or rng is not a function.
+ * @throws {RangeError} If rng returns something other than a number in [0, 1).
+ */
