+  const sorted = sortedNumbers(xs, 'median');
+  if (sorted.length === 0 || sorted.some(Number.isNaN)) return NaN;
+  const mid = sorted.length / 2;
+  if (sorted.length % 2 === 1) return sorted[Math.floor(mid)];
+  // Halve each middle value before adding, so two very large values cannot overflow to Infinity.
+  return sorted[mid - 1] / 2 + sorted[mid] / 2;
