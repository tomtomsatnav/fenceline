+/**
+ * Returns every run of n consecutive items, overlapping, in order.
+ * The input is not modified.
+ * @param {Array} xs
+ * @param {number} n Window size, a positive integer.
+ * @returns {Array[]} Each window as a new array; [] when n is larger than the array.
+ * @throws {TypeError} If xs is not an array.
+ * @throws {RangeError} If n is not a positive integer.
+ */
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed expects an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('windowed expects a positive integer size');
+  const out = [];
