+/**
+ * Returns a new Date n calendar days after date (before it when n is negative). Days are counted in
+ * local time, so the time of day is kept and month, year, and leap-day boundaries are handled.
+ * The input is not modified.
+ * @param {Date} date
+ * @param {number} n A whole number of days, which may be negative.
+ * @returns {Date}
+ * @throws {TypeError} If date is not a Date, or n is not a number.
+ * @throws {RangeError} If date is invalid, n is not an integer, or the result is out of range.
+ */
+exports.addDays = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError('addDays expects a Date');
+  if (typeof n !== 'number') throw new TypeError('addDays expects a number of days');
+  if (Number.isNaN(date.getTime())) throw new RangeError('addDays expects a valid Date');
+  if (!Number.isInteger(n)) throw new RangeError('addDays expects a whole number of days');
+  const out = new Date(date.getTime());
+  out.setDate(out.getDate() + n);
+  if (Number.isNaN(out.getTime())) throw new RangeError('addDays result is out of the Date range');
+  return out;
+};
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
