+ * percentile(xs, 0) is the minimum, percentile(xs, 50) the median, and percentile(xs, 100) the maximum.
+ * The array is not modified.
+ * @param {number[]} xs
+ * @param {number} p A percentage from 0 to 100.
+ * @returns {number} The interpolated value; NaN for an empty array or one that contains NaN.
+ * @throws {TypeError} If p is not a number, or xs is not an array of numbers.
+ * @throws {RangeError} If p is outside 0 to 100.
+ */
+exports.percentile = (xs, p) => {
+  if (typeof p !== 'number') throw new TypeError('percentile expects a number for p');
+  if (!(p >= 0 && p <= 100)) throw new RangeError('percentile expects p between 0 and 100');
+  const sorted = sortedNumbers(xs, 'percentile');
+  if (sorted.length === 0 || sorted.some(Number.isNaN)) return NaN;
+  const rank = (p / 100) * (sorted.length - 1);
+  const lo = Math.floor(rank);
+  const hi = Math.ceil(rank);
+  if (lo === hi) return sorted[lo];
+  const fraction = rank - lo;
+  return sorted[lo] * (1 - fraction) + sorted[hi] * fraction;
+};
+
+const BYTE_UNITS = ['B', 'KB', 'MB', 'GB', 'TB'];
+
+/**
+ * Formats a byte count in binary units (1 KB = 1024 B). Bytes are shown as whole numbers and larger
+ * units to one decimal place, with a trailing ".0" dropped; values above the largest unit stay in TB.
