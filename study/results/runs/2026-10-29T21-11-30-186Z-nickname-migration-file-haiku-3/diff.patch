+  assert.throws(() => chunk(null, 2), TypeError);
+  assert.throws(() => chunk([1, 2], 0), RangeError);
+  assert.throws(() => chunk([1, 2], -1), RangeError);
+  assert.throws(() => chunk([1, 2], 1.5), RangeError);
+  assert.throws(() => chunk([1, 2], '2'), RangeError);
+});
