+/**
+ * Limits x to the range from lo to hi, both included.
+ * @param {number} x
+ * @param {number} lo Lower bound; may be -Infinity.
+ * @param {number} hi Upper bound; may be Infinity, and must not be less than lo.
+ * @returns {number} x, or lo or hi if x is outside the range. NaN if x is NaN.
+ * @throws {TypeError} If x, lo, or hi is not a number.
+ * @throws {RangeError} If a bound is NaN, or lo is greater than hi.
+ */
+exports.clamp = (x, lo, hi) => {
+  for (const [name, value] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof value !== 'number') throw new TypeError(`clamp expects a number for ${name}`);
+  }
+  if (Number.isNaN(lo) || Number.isNaN(hi)) throw new RangeError('clamp bounds must not be NaN');
+  if (lo > hi) throw new RangeError('clamp expects lo to be no greater than hi');
+  return Math.min(Math.max(x, lo), hi);
+};
+
+// Multiplies x by 10^k by moving the decimal point in its text form, so 1.005 shifts to 100.5 exactly.
+const shiftDecimal = (x, k) => {
+  const [mantissa, exponent = '0'] = String(x).split('e');
+  return Number(`${mantissa}e${Number(exponent) + k}`);
+};
+
+/**
+ * Rounds x to a number of decimal places, halves rounded away from zero. Works on the decimal text
+ * of x, so 1.005 rounds to 1.01 as written. A negative places rounds to tens, hundreds, and so on.
+ * @param {number} x
+ * @param {number} places Decimal places; an integer, which may be negative.
+ * @returns {number} The rounded value; NaN and Infinity are returned unchanged.
+ * @throws {TypeError} If x or places is not a number.
+ * @throws {RangeError} If places is not an integer.
+ */
+exports.roundTo = (x, places) => {
+  if (typeof x !== 'number') throw new TypeError('roundTo expects a number for x');
+  if (typeof places !== 'number') throw new TypeError('roundTo expects a number for places');
+  if (!Number.isInteger(places)) throw new RangeError('roundTo expects an integer number of places');
+  if (!Number.isFinite(x)) return x;
+  const rounded = shiftDecimal(Math.round(shiftDecimal(Math.abs(x), places)), -places);
+  const signed = x < 0 ? -rounded : rounded;
+  return signed === 0 ? 0 : signed;
+};
+
+/**
+ * The arithmetic mean of an array of numbers. The array is not modified.
+ * @param {number[]} xs
+ * @returns {number} The sum divided by the length; NaN for an empty array.
+ * @throws {TypeError} If xs is not an array, or it contains a value that is not a number.
+ */
+exports.mean = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('mean expects an array');
+  if (xs.length === 0) return NaN;
+  let sum = 0;
+  for (const x of xs) {
+    if (typeof x !== 'number') throw new TypeError('mean expects an array of numbers');
+    sum += x;
+  }
+  return sum / xs.length;
+};
+
+// Checks that xs is an array of numbers, and returns a sorted copy of it.
+const sortedNumbers = (xs, name) => {
+  if (!Array.isArray(xs)) throw new TypeError(`${name} expects an array`);
+  for (const x of xs) {
+    if (typeof x !== 'number') throw new TypeError(`${name} expects an array of numbers`);
+  }
+  return [...xs].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+};
