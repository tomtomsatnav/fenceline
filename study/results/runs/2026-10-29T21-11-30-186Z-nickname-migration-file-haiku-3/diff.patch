+
+test('addDays crosses month boundaries', () => {
+  assert.deepStrictEqual(addDays(new Date(2024, 0, 31), 1), new Date(2024, 1, 1));
+  assert.deepStrictEqual(addDays(new Date(2024, 2, 1), -1), new Date(2024, 1, 29));
