+  assert.strictEqual(maxBy(people, (p) => p.score), people[1]);
+});
+
+test('maxBy compares numbers as numbers and strings as strings', () => {
+  assert.strictEqual(maxBy([3, 10, 9], (x) => x), 10);
+  assert.strictEqual(maxBy(['pear', 'apple', 'zoo'], (s) => s), 'zoo');
+  assert.strictEqual(maxBy([-5, -2, -9], (x) => x), -2);
+});
+
+test('maxBy of an empty array is undefined', () => {
+  assert.strictEqual(maxBy([], (x) => x), undefined);
+});
+
+test('maxBy of a single item is that item', () => {
+  assert.strictEqual(maxBy(['only'], (x) => x), 'only');
+});
+
+test('maxBy returns the first item when several share the largest key', () => {
+  const xs = [
+    { id: 1, v: 5 },
+    { id: 2, v: 5 },
+  ];
+  assert.strictEqual(maxBy(xs, (x) => x.v), xs[0]);
+});
+
+test('maxBy skips items whose key is undefined or NaN', () => {
+  assert.deepStrictEqual(maxBy([{ v: undefined }, { v: 1 }], (o) => o.v), { v: 1 });
+  assert.deepStrictEqual(maxBy([{ v: NaN }, { v: 2 }], (o) => o.v), { v: 2 });
+  assert.strictEqual(maxBy([{ v: NaN }], (o) => o.v), undefined);
+});
+
+test('maxBy returns the item itself, not its key', () => {
+  const item = { v: 1 };
+  assert.strictEqual(maxBy([item], (o) => o.v), item);
+});
+
+test('maxBy calls keyFn once per item and does not modify the input', () => {
+  const xs = [3, 1, 2];
+  let calls = 0;
+  maxBy(xs, (x) => {
+    calls++;
+    return x;
+  });
+  assert.strictEqual(calls, 3);
+  assert.deepStrictEqual(xs, [3, 1, 2]);
+});
+
+test('maxBy throws a TypeError for a non-array or a non-function key', () => {
+  assert.throws(() => maxBy('abc', (x) => x), TypeError);
+  assert.throws(() => maxBy([1], 'id'), TypeError);
+});
+
+test('chunk throws for a non-array or an invalid size', () => {
