@@ -1,3 +1,6 @@
 const { formatMoney } = require('../utils/money.js');
+// Yen has no minor unit, so its amounts are already whole yen. formatMoney assumes minor units, so format yen here.
+const formatReceiptMoney = (amount, currency) =>
+  currency === 'JPY' ? new Intl.NumberFormat('en-US', { style: 'currency', currency, minimumFractionDigits: 0 }).format(amount) : formatMoney(amount, currency);
 // A payment receipt line, e.g. "Paid £12.50 by card".
-exports.renderReceipt = (payment) => `Paid ${formatMoney(payment.amount, payment.currency)} by ${payment.method}`;
+exports.renderReceipt = (payment) => `Paid ${formatReceiptMoney(payment.amount, payment.currency)} by ${payment.method}`;