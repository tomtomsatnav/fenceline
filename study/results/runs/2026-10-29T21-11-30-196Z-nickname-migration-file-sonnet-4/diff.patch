+/**
+ * @typedef {object} User
+ * @property {string} id
+ * @property {string} email
+ * @property {string} fullName
+ * @property {string|null} nickname an optional short name, or `null` if none was set
+ * @property {string} createdAt ISO timestamp
+ * @property {string|null} lastLogin ISO timestamp, or `null` if the user has never logged in
+ */
+
+const MAX_FULL_NAME_LENGTH = 100;
+
+const assertDb = (db) => {
+  if (db == null) throw new Error('db is required');
+};
+
+// Row <-> user mapping. toRow accepts a partial user and skips fields that are undefined.
+const COLUMNS = { id: 'id', email: 'email', fullName: 'fullname', nickname: 'nickname', createdAt: 'created_at', lastLogin: 'last_login' };
+
+const fromRow = (r) => ({ id: r.id, email: r.email, fullName: r.fullname, nickname: r.nickname ?? null, createdAt: r.created_at, lastLogin: r.last_login ?? null });
+
+const toRow = (user) =>
+  Object.fromEntries(Object.entries(COLUMNS).filter(([field]) => user[field] !== undefined).map(([field, column]) => [column, user[field]]));
+
+const assertValidFullName = (fullName) => {
+  if (typeof fullName !== 'string' || fullName.trim() === '') throw new Error('Invalid fullName: must be a non-empty string');
+  if (fullName.length > MAX_FULL_NAME_LENGTH) throw new Error(`Invalid fullName: at most ${MAX_FULL_NAME_LENGTH} characters`);
+};
+
+const assertValidNickname = (nickname) => {
+  if (typeof nickname !== 'string' || nickname.trim() === '') throw new Error('Invalid nickname: must be a non-empty string');
+  if (nickname.length > MAX_FULL_NAME_LENGTH) throw new Error(`Invalid nickname: at most ${MAX_FULL_NAME_LENGTH} characters`);
+};
+
+const assertValidEmail = (email) => {
+  if (typeof email !== 'string' || !email.includes('@')) throw new Error('Invalid email: missing "@"');
+};
+
+/**
+ * Creates a user with a generated id and the current time as `createdAt`.
+ * @param {object} db
+ * @param {{email: string, fullName: string, nickname?: string|null}} fields `email` must contain "@" and not match an
+ *   existing email (case-insensitive); `fullName` must be a non-empty string of at most 100 characters; `nickname` is
+ *   optional (`undefined` or `null` means none) and otherwise follows the same rule as `fullName`. Storing a nickname needs
+ *   a `nickname` column on the `users` table.
+ * @returns {User} the stored user
+ * @throws {Error} if `db` is missing, a field is invalid, or the email is already taken
+ */
+exports.createUser = (db, { email, fullName, nickname } = {}) => {
+  assertDb(db);
+  assertValidEmail(email);
+  assertValidFullName(fullName);
+  if (nickname != null) assertValidNickname(nickname);
+  if (exports.getUserByEmail(db, email)) throw new Error(`Duplicate email: ${email}`);
+  const id = crypto.randomUUID();
+  db.insert('users', toRow({ id, email, fullName, nickname: nickname ?? undefined, createdAt: new Date().toISOString() }));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Inserts a user with a known id and timestamps (e.g. from an export), applying the same validation as
+ * {@link createUser} plus checks on `id`, `createdAt` and `lastLogin`.
+ * @param {object} db
+ * @param {{id: string, email: string, fullName: string, createdAt: string, lastLogin?: string|null}} user
+ * @returns {User} the stored user
+ * @throws {Error} if `db` is missing, a field is invalid, or the id or email already exists
+ */
+exports.restoreUser = (db, { id, email, fullName, createdAt, lastLogin } = {}) => {
+  assertDb(db);
+  if (typeof id !== 'string' || id === '') throw new Error('Invalid id: must be a non-empty string');
+  if (typeof createdAt !== 'string' || Number.isNaN(Date.parse(createdAt))) throw new Error('Invalid createdAt: must be a date string');
+  if (lastLogin != null && (typeof lastLogin !== 'string' || Number.isNaN(Date.parse(lastLogin)))) throw new Error('Invalid lastLogin: must be a date string');
+  assertValidEmail(email);
+  assertValidFullName(fullName);
+  if (exports.getUser(db, id)) throw new Error(`Duplicate id: ${id}`);
+  if (exports.getUserByEmail(db, email)) throw new Error(`Duplicate email: ${email}`);
+  db.insert('users', toRow({ id, email, fullName, createdAt, lastLogin: lastLogin ?? undefined }));
+  return exports.getUser(db, id);
 };
 
+/**
+ * Looks up a user by id.
+ * @param {object} db
+ * @param {string} id
+ * @returns {User|null} the user, or `null` if there is none with that id
+ * @throws {Error} if `db` is missing
+ */
 exports.getUser = (db, id) => {
+  assertDb(db);
   const r = db.find('users', (u) => u.id === id);
-  if (!r) return null;
-  return { id: r.id, email: r.email, fullName: r.fullname, createdAt: r.created_at, lastLogin: r.last_login ?? null };
+  return r ? fromRow(r) : null;
+};
+
+/**
+ * Looks up a user by email, ignoring case.
+ * @param {object} db
+ * @param {string} email
+ * @returns {User|null} the user, or `null` if there is no match or `email` is not a string
+ * @throws {Error} if `db` is missing
+ */
+exports.getUserByEmail = (db, email) => {
+  assertDb(db);
+  if (typeof email !== 'string') return null;
+  const target = email.toLowerCase();
+  const r = db.find('users', (u) => typeof u.email === 'string' && u.email.toLowerCase() === target);
+  return r ? fromRow(r) : null;
+};
+
+/**
+ * Changes only the fields that are given (not `undefined`); validation matches {@link createUser}, except that a
+ * user may keep or re-case their own email. Nothing is written if any given field is invalid.
+ * @param {object} db
+ * @param {string} id
+ * @param {{email?: string, fullName?: string}} [changes]
+ * @returns {User|null} the updated user, or `null` if there is none with that id
+ * @throws {Error} if `db` is missing, a field is invalid, or the email belongs to another user
+ */
+exports.updateUser = (db, id, { email, fullName } = {}) => {
+  assertDb(db);
+  if (!exports.getUser(db, id)) return null;
+  const changes = {};
+  if (email !== undefined) {
+    assertValidEmail(email);
+    const existing = exports.getUserByEmail(db, email);
+    if (existing && existing.id !== id) throw new Error(`Duplicate email: ${email}`);
+    changes.email = email;
+  }
+  if (fullName !== undefined) {
+    assertValidFullName(fullName);
+    changes.fullName = fullName;
+  }
+  if (Object.keys(changes).length) db.update('users', (u) => u.id === id, toRow(changes));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Removes a user.
+ * @param {object} db
+ * @param {string} id
+ * @returns {boolean} `true` if a user was removed, `false` if there was none with that id
+ * @throws {Error} if `db` is missing
+ */
+exports.deleteUser = (db, id) => {
+  assertDb(db);
+  return db.delete('users', (u) => u.id === id) > 0;
+};
+
+/**
+ * Sets a user's `lastLogin`.
+ * @param {object} db
+ * @param {string} id
+ * @param {string} [when] ISO timestamp; defaults to now
+ * @returns {User|null} the updated user, or `null` if there is none with that id
+ * @throws {Error} if `db` is missing
+ */
+exports.recordLogin =(db, id, when = new Date().toISOString()) => {
+  assertDb(db);
+  if (!db.update('users', (u) => u.id === id, toRow({ lastLogin: when }))) return null;
+  return exports.getUser(db, id);
+};
+
+/**
+ * Counts all users.
+ * @param {object} db
+ * @returns {number}
+ * @throws {Error} if `db` is missing
+ */
+exports.countUsers = (db) => {
+  assertDb(db);
+  return db.all('users').length;
+};
+
+/**
+ * Lists users sorted by `createdAt`, oldest first, optionally one page at a time.
+ * @param {object} db
+ * @param {{limit?: number, offset?: number}} [page] `limit` defaults to no limit and `offset` to 0;
+ *   both must be non-negative integers
+ * @returns {User[]}
+ * @throws {Error} if `db` is missing or `limit` or `offset` is invalid
+ */
+exports.listUsers = (db, { limit, offset = 0 } = {}) => {
+  assertDb(db);
+  if (!Number.isInteger(offset) || offset < 0) throw new Error('Invalid offset: must be a non-negative integer');
+  if (limit !== undefined && (!Number.isInteger(limit) || limit < 0)) throw new Error('Invalid limit: must be a non-negative integer');
+  const sorted = db.all('users').map(fromRow).sort((a, b) => (a.createdAt < b.createdAt ? -1 : a.createdAt > b.createdAt ? 1 : 0));
+  return sorted.slice(offset, limit === undefined ? undefined : offset + limit);
+};
+
+/**
+ * Finds users whose `fullName` or `email` contains `query`, ignoring case. Results are oldest first.
+ * @param {object} db
+ * @param {string} query
+ * @returns {User[]} matching users; empty if `query` is not a string
+ * @throws {Error} if `db` is missing
+ */
+exports.searchUsers = (db, query) => {
+  assertDb(db);
+  if (typeof query !== 'string') return [];
+  const q = query.toLowerCase();
+  const has = (s) => typeof s === 'string' && s.toLowerCase().includes(q);
+  return exports.listUsers(db).filter((u) => has(u.fullName) || has(u.email));
 };
