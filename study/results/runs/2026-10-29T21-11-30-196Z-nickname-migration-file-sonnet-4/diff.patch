+const test = require('node:test');
+const assert = require('node:assert');
+const { displayName } = require('../src/api/format.js');
+
+test('displayName returns the fullName when present', () => {
+  assert.strictEqual(displayName({ fullName: 'Ada Lovelace', email: 'ada@example.com' }), 'Ada Lovelace');
+});
+
+test('displayName falls back to the part of the email before "@"', () => {
+  for (const fullName of ['', '   ', null, undefined]) {
+    assert.strictEqual(displayName({ fullName, email: 'ada@example.com' }), 'ada', String(fullName));
+  }
+  assert.strictEqual(displayName({ email: 'grace@navy.mil' }), 'grace');
+});
+
+test('displayName splits on the first "@" only', () => {
+  assert.strictEqual(displayName({ fullName: '', email: 'a@b@c.com' }), 'a');
+});
diff --git a/test/lib-arrays.test.js b/test/lib-arrays.test.js
