+ * initials('  ada   lovelace ') // 'AL'
+ * @param {string} str
+ * @returns {string} the initials; empty if `str` has no letters or digits
+ * @throws {TypeError} if `str` is not a string
+ */
+exports.initials = (str) => {
+  if (typeof str !== 'string') throw new TypeError('initials expects a string');
+  return str
+    .replace(/['’]/g, '')
+    .split(/[^\p{L}\p{N}\p{M}]+/u)
+    .filter(Boolean)
+    .map((word) => graphemes.segment(word)[Symbol.iterator]().next().value.segment.toUpperCase())
+    .join('');
+};
+
+/**
+ * Reverses the order of the words in a sentence, joining them with single spaces. A word is a run of non-whitespace
+ * characters, so punctuation stays attached to its word and the words themselves are not changed. Leading, trailing
+ * and repeated whitespace (including tabs and newlines) is dropped.
+ *
+ * reverseWords('the quick brown fox') // 'fox brown quick the'
+ * reverseWords('Hello,   world!')     // 'world! Hello,'
+ * @param {string} str
+ * @returns {string} the words in reverse order; empty if `str` is empty or only whitespace
+ * @throws {TypeError} if `str` is not a string
+ */
+exports.reverseWords = (str) => {
+  if (typeof str !== 'string') throw new TypeError('reverseWords expects a string');
+  return str.split(/\s+/u).filter(Boolean).reverse().join(' ');
+};
+
+/**
+ * Whether a string reads the same backwards, ignoring case, spaces and punctuation: only letters and digits are
+ * compared. Accents are kept (so "é" and "e" differ) but composed and decomposed forms of the same letter are equal,
+ * and a letter with a combining accent is reversed as one unit. A string with no letters or digits (including the
+ * empty string) is trivially a palindrome.
+ *
+ * isPalindrome('A man, a plan, a canal: Panama') // true
+ * isPalindrome('hello')                          // false
+ * @param {string} str
+ * @returns {boolean}
+ * @throws {TypeError} if `str` is not a string
+ */
+exports.isPalindrome = (str) => {
+  if (typeof str !== 'string') throw new TypeError('isPalindrome expects a string');
+  const kept = str.normalize('NFC').replace(/[^\p{L}\p{N}\p{M}]+/gu, '').toLowerCase();
+  const chars = Array.from(graphemes.segment(kept), (seg) => seg.segment);
+  return chars.every((c, i) => c === chars[chars.length - 1 - i]);
+};
+
+const graphemeLength = (s) => Array.from(graphemes.segment(s)).length;
+
+const wrapLine = (line, width) => {
+  const lines = [];
+  let current = '';
+  let currentLength = 0;
+  for (const word of line.split(/\s+/u).filter(Boolean)) {
+    const length = graphemeLength(word);
+    if (currentLength === 0) {
+      current = word;
+      currentLength = length;
+    } else if (currentLength + 1 + length <= width) {
+      current += ` ${word}`;
+      currentLength += 1 + length;
+    } else {
+      lines.push(current);
+      current = word;
+      currentLength = length;
+    }
+  }
+  lines.push(current);
+  return lines;
+};
+
+/**
+ * Inserts line breaks ("\n") so that no line is longer than `width` characters, breaking only between words. A word is
+ * a run of non-whitespace characters. Lines are filled greedily; spaces and tabs between words become a single space,
+ * and spaces at the start and end of a line are dropped. Line breaks already in `text` are kept (as "\n"), so blank
+ * lines and paragraphs survive and each line is wrapped on its own. Characters are counted as in {@link truncate}.
+ *
+ * A word longer than `width` is never split: it goes on a line of its own, which is then longer than `width`.
+ *
+ * wrap('the quick brown fox', 10) // 'the quick\nbrown fox'
+ * @param {string} text
+ * @param {number} width a positive integer, or `Infinity` to only normalize whitespace
+ * @returns {string}
+ * @throws {TypeError} if `text` is not a string or `width` is not a number
+ * @throws {RangeError} if `width` is not a positive integer or `Infinity`
+ */
+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new TypeError('wrap expects a string');
+  if (typeof width !== 'number') throw new TypeError('wrap expects width to be a number');
+  if (width !== Infinity && (!Number.isInteger(width) || width < 1)) throw new RangeError('wrap expects width to be a positive integer');
+  return text.split(/\r\n|[\r\n]/).flatMap((line) => wrapLine(line, width)).join('\n');
+};
+
+/**
+ * Fills `{placeholders}` in a string from an object. A placeholder is a name in single braces, made of letters, digits,
+ * "_", "$" and "-" (no spaces, so "{ name }" and JSON such as '{"a": 1}' are left alone). Values are converted with
+ * `String`. Placeholders with no matching value are left exactly as written: that includes names the object does not
+ * have itself (inherited names like "{toString}" are not looked up) and values that are `undefined` or `null`.
+ * Substitution is a single pass, so a value containing "{other}" is inserted as is and never expanded again, and
+ * special replacement patterns such as "$&" in a value have no effect. There is no escape syntax for literal braces.
+ *
+ * template('Hi {name}', { name: 'Ada' })       // 'Hi Ada'
+ * template('{a} and {b}', { a: 1 })            // '1 and {b}'
+ * @param {string} str
+ * @param {object} [values] defaults to no values
+ * @returns {string}
+ * @throws {TypeError} if `str` is not a string, or `values` is given but is not an object
+ */
+exports.template = (str, values = {}) => {
+  if (typeof str !== 'string') throw new TypeError('template expects a string');
+  if (typeof values !== 'object' || values === null) throw new TypeError('template expects values to be an object');
+  return str.replace(/\{([\p{L}\p{N}_$-]+)\}/gu, (placeholder, name) =>
+    Object.hasOwn(values, name) && values[name] != null ? String(values[name]) : placeholder);
+};
diff --git a/test/export.test.js b/test/export.test.js
new file mode 100644
index 0000000..45e7825
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,96 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { createUser, recordLogin, listUsers, countUsers } = require('../src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+const HEADER = 'id,email,fullName,createdAt,lastLogin';
+const insert = (db, id, fullname, created_at, extra = {}) =>
+  db.insert('users', { id, email: `${id}@example.com`, fullname, created_at, ...extra });
+
+test('exportUsersCsv with no users is just the header row', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), `${HEADER}\n`);
+});
+
+test('exportUsersCsv writes one row per user, oldest first, with empty lastLogin as blank', () => {
+  const db = migrate(new Db());
+  insert(db, 'b', 'Bob', '2024-02-01T00:00:00.000Z', { last_login: '2024-05-01T00:00:00.000Z' });
+  insert(db, 'a', 'Alice', '2024-01-01T00:00:00.000Z');
+  assert.strictEqual(
+    exportUsersCsv(db),
+    [
+      HEADER,
+      'a,a@example.com,Alice,2024-01-01T00:00:00.000Z,',
+      'b,b@example.com,Bob,2024-02-01T00:00:00.000Z,2024-05-01T00:00:00.000Z',
+      '',
+    ].join('\n'),
+  );
+});
+
+test('exportUsersCsv quotes fields containing commas, quotes or newlines', () => {
+  const db = migrate(new Db());
+  insert(db, 'a', 'Lovelace, Ada', '2024-01-01T00:00:00.000Z');
+  insert(db, 'b', 'Bob "The Builder" Smith', '2024-02-01T00:00:00.000Z');
+  insert(db, 'c', 'Line\nBreak', '2024-03-01T00:00:00.000Z');
+  assert.strictEqual(
+    exportUsersCsv(db),
+    [
+      HEADER,
+      'a,a@example.com,"Lovelace, Ada",2024-01-01T00:00:00.000Z,',
+      'b,b@example.com,"Bob ""The Builder"" Smith",2024-02-01T00:00:00.000Z,',
+      'c,c@example.com,"Line\nBreak",2024-03-01T00:00:00.000Z,',
+      '',
+    ].join('\n'),
+  );
+});
+
+test('exportUsersCsv throws when db is missing', () => {
+  assert.throws(() => exportUsersCsv(undefined), /db is required/);
+});
+
+test('importUsersCsv round-trips exportUsersCsv, including awkward fields', () => {
+  const src = migrate(new Db());
+  const ada = createUser(src, { email: 'ada@example.com', fullName: 'Lovelace, Ada' });
+  createUser(src, { email: 'bob@example.com', fullName: 'Bob "The Builder" Smith' });
+  insert(src, 'c', 'Line\nBreak\r\nCRLF', '2030-01-01T00:00:00.000Z');
+  recordLogin(src, ada.id, '2024-05-01T12:00:00.000Z');
+  const csv = exportUsersCsv(src);
+
+  const dest = migrate(new Db());
+  const imported = importUsersCsv(dest, csv);
+  assert.deepStrictEqual(listUsers(dest), listUsers(src));
+  assert.deepStrictEqual(imported, listUsers(dest));
+  assert.strictEqual(exportUsersCsv(dest), csv);
+});
+
+test('importUsersCsv accepts \\r\\n line endings and an empty export', () => {
+  const src = migrate(new Db());
+  createUser(src, { email: 'ada@example.com', fullName: 'Ada' });
+  const dest = migrate(new Db());
+  importUsersCsv(dest, exportUsersCsv(src).replace(/\n/g, '\r\n'));
+  assert.deepStrictEqual(listUsers(dest), listUsers(src));
+  assert.deepStrictEqual(importUsersCsv(migrate(new Db()), exportUsersCsv(migrate(new Db()))), []);
+});
+
+test('importUsersCsv rejects bad input and imports nothing', () => {
+  const db = migrate(new Db());
+  const good = 'a,a@example.com,Alice,2024-01-01T00:00:00.000Z,';
+  const cases = {
+    'wrong header': 'id,email\na,a@example.com\n',
+    'empty input': '',
+    'short row': `${HEADER}\n${good}\nb,b@example.com,Bob\n`,
+    'bad email': `${HEADER}\n${good}\nb,not-an-email,Bob,2024-02-01T00:00:00.000Z,\n`,
+    'duplicate email': `${HEADER}\n${good}\nb,A@example.com,Bob,2024-02-01T00:00:00.000Z,\n`,
+    'duplicate id': `${HEADER}\n${good}\na,b@example.com,Bob,2024-02-01T00:00:00.000Z,\n`,
+    'bad date': `${HEADER}\n${good}\nb,b@example.com,Bob,yesterday,\n`,
+    'unterminated quote': `${HEADER}\n${good}\nb,b@example.com,"Bob,2024-02-01T00:00:00.000Z,\n`,
+  };
+  for (const [name, csv] of Object.entries(cases)) {
+    assert.throws(() => importUsersCsv(db, csv), Error, name);
+    assert.strictEqual(countUsers(db), 0, `${name}: nothing should remain imported`);
+  }
+  assert.throws(() => importUsersCsv(db, `${HEADER}\n${good}\nb,b@example.com,Bob,bad,\n`), /row 3/);
+  assert.throws(() => importUsersCsv(undefined, ''), /db is required/);
+  assert.throws(() => importUsersCsv(db, undefined), Error);
+});
