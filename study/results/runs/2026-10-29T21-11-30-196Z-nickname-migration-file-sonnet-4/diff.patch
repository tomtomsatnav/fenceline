diff --git a/README.md b/README.md
new file mode 100644
index 0000000..93c6b35
--- /dev/null
+++ b/README.md
@@ -0,0 +1,54 @@
+## Users API
+
+The functions in `src/api/` take a `db` (the in-memory `Db` from `src/db.js`, after `migrate`) as their first argument.
+Every function in `users.js` and `export.js` throws `Error('db is required')` if `db` is `null` or `undefined`.
+Invalid input throws an `Error`.
+
+```js
+const { Db } = require('./src/db.js');
+const { migrate } = require('./src/migrate.js');
+const { createUser, listUsers } = require('./src/api/users.js');
+
+const db = migrate(new Db());
+createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+listUsers(db); // [{ id, email, fullName, createdAt, lastLogin }]
+```
+
+### User object
+
+| Field       | Type             | Notes                                           |
+| ----------- | ---------------- | ----------------------------------------------- |
+| `id`        | string           | Generated UUID                                  |
+| `email`     | string           | Contains `@`; unique, compared case-insensitively |
+| `fullName`  | string           | Non-empty, at most 100 characters               |
+| `nickname`  | string \| `null` | Optional; `null` if not set. Same rules as `fullName` |
+| `createdAt` | string           | ISO timestamp                                   |
+| `lastLogin` | string \| `null` | ISO timestamp, `null` until a login is recorded |
+
+### `src/api/users.js`
+
+| Function | Description |
+| --- | --- |
+| `createUser(db, { email, fullName, nickname? })` | Creates a user with a generated id and `createdAt` of now. Throws if the email has no `@`, is already taken, or `fullName` or `nickname` is invalid. `nickname` is optional (`undefined` or `null` means none) and needs a `nickname` column on the `users` table. Returns the user. |
+| `restoreUser(db, { id, email, fullName, createdAt, lastLogin })` | Inserts a user with a known id and timestamps (used by CSV import). Same validation as `createUser`, plus a unique non-empty `id` and valid date strings (`lastLogin` may be `null`/omitted). Returns the user. |
+| `getUser(db, id)` | Returns the user, or `null` if there is none with that id. |
+| `getUserByEmail(db, email)` | Finds a user by email, ignoring case. Returns the user, or `null`. |
+| `updateUser(db, id, { email, fullName })` | Changes only the fields given (not `undefined`). Validates like `createUser`; a user may keep or re-case their own email, but not take another user's. Nothing is written if any field is invalid. Returns the updated user, or `null` for an unknown id. |
+| `deleteUser(db, id)` | Removes the user. Returns `true`, or `false` if there was none with that id. |
+| `recordLogin(db, id, when?)` | Sets `lastLogin` (`when` is an ISO timestamp, default now). Returns the updated user, or `null` for an unknown id. |
+| `countUsers(db)` | Returns the number of users. |
+| `listUsers(db, { limit, offset }?)` | Returns users sorted by `createdAt`, oldest first. `offset` defaults to `0`, `limit` to no limit; both must be non-negative integers. |
+| `searchUsers(db, query)` | Returns users whose `fullName` or `email` contains `query`, ignoring case, oldest first. Returns `[]` if `query` is not a string. |
+
+### `src/api/export.js`
+
+| Function | Description |
+| --- | --- |
+| `exportUsersCsv(db)` | Returns CSV text: a header row `id,email,fullName,createdAt,lastLogin`, then one row per user, oldest first. Fields containing commas, quotes or line breaks are quoted. Rows end with `\n`. A `null` `lastLogin` is written as an empty field. |
+| `importUsersCsv(db, csv)` | Inverse of `exportUsersCsv`: imports users from its output, keeping ids and timestamps, and returns them. Accepts `\n` or `\r\n` line endings. All-or-nothing: if the header is wrong or any row is invalid (including a duplicate id or email), nothing is imported and the error names the row. |
+
+### `src/api/format.js`
+
+| Function | Description |
+| --- | --- |
+| `displayName(user)` | Returns `user.fullName`, or the part of `user.email` before the first `@` when `fullName` is missing or blank. |
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..bf79fc3
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,86 @@
+const { listUsers, restoreUser, deleteUser } = require('./users.js');
+
+const FIELDS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+const quote = (value) => {
+  const s = value == null ? '' : String(value);
+  return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+
+/**
+ * Exports all users as CSV: a header row (`id,email,fullName,createdAt,lastLogin`), then one row per user, oldest
+ * first. Fields containing commas, quotes or line breaks are quoted; rows end with "\n".
+ * @param {object} db
+ * @returns {string}
+ * @throws {Error} if `db` is missing
+ */
+exports.exportUsersCsv = (db) => {
+  const lines = [FIELDS, ...listUsers(db).map((u) => FIELDS.map((f) => u[f]))];
+  return lines.map((cells) => cells.map(quote).join(',')).join('\n') + '\n';
+};
+
+// Parses CSV text into an array of rows of strings. Handles quoted fields, "" escapes, and \n or \r\n line breaks.
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let inQuotes = false;
+  let sawContent = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (inQuotes) {
+      if (c !== '"') field += c;
+      else if (text[i + 1] === '"') { field += '"'; i++; }
+      else inQuotes = false;
+    } else if (c === '"' && field === '') {
+      inQuotes = true;
+      sawContent = true;
+    } else if (c === ',') {
+      row.push(field);
+      field = '';
+      sawContent = true;
+    } else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      if (sawContent || field !== '') rows.push([...row, field]);
+      row = [];
+      field = '';
+      sawContent = false;
+    } else {
+      field += c;
+    }
+  }
+  if (inQuotes) throw new Error('Invalid CSV: unterminated quoted field');
+  if (sawContent || field !== '') rows.push([...row, field]);
+  return rows;
+};
+
+/**
+ * Imports users from CSV text produced by {@link exportUsersCsv}, keeping ids and timestamps. All-or-nothing: if
+ * any row is invalid, users already imported by this call are removed again.
+ * @param {object} db
+ * @param {string} csv
+ * @returns {import('./users.js').User[]} the imported users, in file order
+ * @throws {Error} if `db` is missing, the header is wrong, or a row is invalid (the message names the row)
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (db == null) throw new Error('db is required');
+  if (typeof csv !== 'string') throw new Error('csv must be a string');
+  const [header, ...rows] = parseCsv(csv);
+  if (!header || header.join(',') !== FIELDS.join(',')) throw new Error(`Invalid CSV header: expected ${FIELDS.join(',')}`);
+  const imported = [];
+  try {
+    rows.forEach((cells, i) => {
+      if (cells.length !== FIELDS.length) throw new Error(`Invalid CSV row ${i + 2}: expected ${FIELDS.length} fields, got ${cells.length}`);
+      const [id, email, fullName, createdAt, lastLogin] = cells;
+      try {
+        imported.push(restoreUser(db, { id, email, fullName, createdAt, lastLogin: lastLogin === '' ? null : lastLogin }));
+      } catch (e) {
+        throw new Error(`Invalid CSV row ${i + 2}: ${e.message}`);
+      }
+    });
+  } catch (e) {
+    for (const u of imported) deleteUser(db, u.id);
+    throw e;
+  }
+  return imported;
+};
diff --git a/src/api/format.js b/src/api/format.js
new file mode 100644
