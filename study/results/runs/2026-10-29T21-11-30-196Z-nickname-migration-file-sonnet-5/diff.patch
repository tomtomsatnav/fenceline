+/**
+ * Returns a new Date n days after the given one (before it, if n is negative). Days are calendar days in UTC, so the
+ * time of day is kept, month and year ends and leap days are handled, and daylight saving time in the local time
+ * zone makes no difference. The given Date is not changed.
+ * @param {Date} date a valid Date
+ * @param {number} n a whole number of days; may be negative or 0
+ * @returns {Date} e.g. addDays(new Date('2024-02-28T10:00:00Z'), 2) is 2024-03-01T10:00:00Z (2024 is a leap year)
+ * @throws {TypeError} if date is not a Date, or n is not a number
+ * @throws {RangeError} if date is an invalid Date, n is not a whole number (this includes NaN and Infinity),
+ *   or the result is outside the range a Date can hold
+ */
+exports.addDays = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError('addDays: date must be a Date');
+  if (typeof n !== 'number') throw new TypeError('addDays: n must be a number');
+  if (Number.isNaN(date.getTime())) throw new RangeError('addDays: date is an invalid Date');
+  if (!Number.isInteger(n)) throw new RangeError('addDays: n must be a whole number');
+  const result = new Date(date.getTime());
+  result.setUTCDate(result.getUTCDate() + n);
+  if (Number.isNaN(result.getTime())) throw new RangeError('addDays: the result is outside the range of a Date');
+  return result;
+};
+
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+/**
+ * The number of calendar days from one date to another, ignoring the time of day. Days are UTC days, so
+ * 2024-03-10T23:59Z to 2024-03-11T00:01Z is 1 day, even though only two minutes pass, and the local time zone
+ * (and its daylight saving changes) makes no difference. The result is negative when `to` is before `from`.
+ * Neither Date is changed.
+ * @param {Date} from a valid Date
+ * @param {Date} to a valid Date
+ * @returns {number} a whole number, e.g. daysBetween(new Date('2024-02-28T08:00:00Z'), new Date('2024-03-01T20:00:00Z')) is 2; never -0
+ * @throws {TypeError} if from or to is not a Date
+ * @throws {RangeError} if from or to is an invalid Date
+ */
+exports.daysBetween = (from, to) => {
+  for (const [name, value] of [['from', from], ['to', to]]) {
+    if (!(value instanceof Date)) throw new TypeError(`daysBetween: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`daysBetween: ${name} is an invalid Date`);
+  }
