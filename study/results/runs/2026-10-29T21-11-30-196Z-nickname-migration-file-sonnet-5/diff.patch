+++ b/src/lib/strings.js
@@ -0,0 +1,173 @@
+// Lowercase words of str; separated by whitespace, hyphens or underscores, or by a change of case.
+const words = (str, name) => {
+  if (typeof str !== 'string') throw new TypeError(`${name}: expected a string`);
+  return str
+    .replace(/([a-z0-9])([A-Z])/g, '$1 $2')
+    .replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2')
+    .split(/[\s_-]+/)
+    .filter(Boolean)
+    .map((w) => w.toLowerCase());
+};
+
+/**
+ * Converts a string to camelCase. Words are separated by whitespace, hyphens or underscores, or by a change of
+ * case in the input ("helloWorld" stays as is). Leading, trailing and repeated separators are ignored.
+ * @param {string} str
+ * @returns {string} e.g. "hello world", "hello-world" and "hello_world" all give "helloWorld"; "" if there are no words
+ * @throws {TypeError} if str is not a string
+ */
+exports.camelCase = (str) =>
+  words(str, 'camelCase').map((w, i) => (i === 0 ? w : w[0].toUpperCase() + w.slice(1))).join('');
+
+/**
+ * Converts a string to kebab-case, splitting words the same way as camelCase.
+ * @param {string} str
+ * @returns {string} e.g. "helloWorld" and "Hello World" both give "hello-world"; "" if there are no words
+ * @throws {TypeError} if str is not a string
+ */
+exports.kebabCase = (str) => words(str, 'kebabCase').join('-');
+
+/**
+ * Shortens a string to at most n characters, ending in "…" (which counts towards n) when anything was cut.
+ * Characters are counted as code points, so an emoji is never split in half.
+ * @param {string} s
+ * @param {number} n maximum length of the result; a non-negative integer
+ * @returns {string} s unchanged if it already fits; "" if n is 0
+ * @throws {TypeError} if s is not a string
+ * @throws {RangeError} if n is not a non-negative integer
+ */
+exports.truncate = (s, n) => {
+  if (typeof s !== 'string') throw new TypeError('truncate: expected a string');
+  if (!Number.isInteger(n) || n < 0) throw new RangeError('truncate: n must be a non-negative integer');
+  const chars = Array.from(s);
+  if (chars.length <= n) return s;
+  return n === 0 ? '' : `${chars.slice(0, n - 1).join('')}…`;
+};
+
+/**
+ * Centres a string in a field of the given width. When the padding is odd, the extra character goes on the right.
+ * Characters are counted as code points, like in truncate.
+ * @param {string} s
+ * @param {number} width total length of the result; a non-negative integer
+ * @param {string} [ch] the padding character, a single character; defaults to a space
+ * @returns {string} s unchanged if it is already at least width long (it is never cut)
+ * @throws {TypeError} if s or ch is not a string
+ * @throws {RangeError} if width is not a non-negative integer, or ch is not exactly one character
+ */
+exports.padCenter = (s, width, ch = ' ') => {
+  if (typeof s !== 'string') throw new TypeError('padCenter: expected a string');
+  if (!Number.isInteger(width) || width < 0) throw new RangeError('padCenter: width must be a non-negative integer');
+  if (typeof ch !== 'string') throw new TypeError('padCenter: ch must be a string');
+  if (Array.from(ch).length !== 1) throw new RangeError('padCenter: ch must be exactly one character');
+  const total = width - Array.from(s).length;
+  if (total <= 0) return s;
+  const left = Math.floor(total / 2);
+  return ch.repeat(left) + s + ch.repeat(total - left);
+};
+
+/**
+ * Counts the words in a string. A word is a run of letters, digits and combining marks (any language);
+ * everything else, such as whitespace, punctuation and symbols, separates words. So "don't" and "e-mail" are two words.
+ * @param {string} str
+ * @returns {number} 0 if there are no words
+ * @throws {TypeError} if str is not a string
+ */
+exports.countWords = (str) => {
+  if (typeof str !== 'string') throw new TypeError('countWords: expected a string');
+  return (str.match(/[\p{L}\p{N}\p{M}]+/gu) ?? []).length;
+};
+
+/**
+ * The upper-case first letters of the words in a name. Words are separated by whitespace or hyphens, so
+ * "Mary-Jane" gives "MJ" but "O'Brien" is one word. Leading punctuation and words with no letter or digit are skipped.
+ * @param {string} str
+ * @returns {string} e.g. "Ada King Lovelace" gives "AKL"; "" if there are no words
+ * @throws {TypeError} if str is not a string
+ */
+exports.initials = (str) => {
+  if (typeof str !== 'string') throw new TypeError('initials: expected a string');
+  return str
+    .split(/[\s-]+/)
+    .map((word) => word.match(/[\p{L}\p{N}]\p{M}*/u)?.[0] ?? '')
+    .join('')
+    .toUpperCase();
+};
+
+/**
+ * Reverses the order of the words in a sentence and joins them with single spaces. A word is a run of
+ * non-whitespace characters, so punctuation stays attached to its word: "Hi, Bob!" gives "Bob! Hi,".
+ * Leading, trailing and repeated whitespace (including tabs and newlines) is dropped.
+ * @param {string} str
+ * @returns {string} e.g. "one two three" gives "three two one"; "" if there are no words
+ * @throws {TypeError} if str is not a string
+ */
+exports.reverseWords = (str) => {
+  if (typeof str !== 'string') throw new TypeError('reverseWords: expected a string');
+  return str.split(/\s+/).filter(Boolean).reverse().join(' ');
+};
+
+/**
+ * Whether a string reads the same backwards, looking only at its letters and digits (any language) and
+ * ignoring case. Spaces, punctuation and symbols are skipped. Accents count: "é" is not "e".
+ * @param {string} str
+ * @returns {boolean} true for "A man, a plan, a canal: Panama"; also true when there are no letters or digits
+ * @throws {TypeError} if str is not a string
+ */
+exports.isPalindrome = (str) => {
+  if (typeof str !== 'string') throw new TypeError('isPalindrome: expected a string');
+  const chars = str.normalize('NFC').toLowerCase().match(/[\p{L}\p{N}]/gu) ?? [];
+  return chars.every((c, i) => c === chars[chars.length - 1 - i]);
+};
+
+/**
+ * Wraps text so that no line is longer than width, breaking only between words. Each line of the input is
+ * wrapped on its own, so existing line breaks (and blank lines) are kept; within a line, runs of whitespace
+ * become a single space and leading/trailing whitespace is dropped. Lengths are counted in code points.
+ * A word longer than width is never split: it sits on a line of its own, which is longer than width.
+ * @param {string} text
+ * @param {number} width maximum line length; a positive integer
+ * @returns {string} lines joined with "\n" ("\r\n" in the input also counts as a line break)
+ * @throws {TypeError} if text is not a string
+ * @throws {RangeError} if width is not a positive integer
+ */
+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new TypeError('wrap: expected a string');
+  if (!Number.isInteger(width) || width < 1) throw new RangeError('wrap: width must be a positive integer');
+  const out = [];
+  for (const line of text.split(/\r?\n/)) {
+    let current = '';
+    let currentLength = 0;
+    for (const word of line.split(/\s+/).filter(Boolean)) {
+      const wordLength = Array.from(word).length;
+      if (currentLength > 0 && currentLength + 1 + wordLength <= width) {
+        current += ` ${word}`;
+        currentLength += 1 + wordLength;
+      } else {
+        if (currentLength > 0) out.push(current);
+        current = word;
+        currentLength = wordLength;
+      }
+    }
+    out.push(current);
+  }
+  return out.join('\n');
+};
+
+/**
+ * Fills {placeholders} in a string from an object. A placeholder is a name of letters, digits and underscores in
+ * braces. Placeholders with no value are left as they are, as are names that only exist on the prototype
+ * (like {toString}). A value of undefined or null counts as no value; anything else is converted with String(),
+ * so 0 and false are filled in. Values are inserted as is: they are not searched for placeholders themselves.
+ * @param {string} str
+ * @param {Record<string, unknown>} [values]
+ * @returns {string} e.g. template("Hi {name}", { name: "Ada" }) gives "Hi Ada"
+ * @throws {TypeError} if str is not a string or values is not an object
+ */
+exports.template = (str, values = {}) => {
+  if (typeof str !== 'string') throw new TypeError('template: expected a string');
+  if (typeof values !== 'object' || values === null) throw new TypeError('template: values must be an object');
+  return str.replace(/\{(\w+)\}/g, (placeholder, name) => {
+    const value = Object.hasOwn(values, name) ? values[name] : undefined;
+    return value === undefined || value === null ? placeholder : String(value);
+  });
+};
diff --git a/test/export.test.js b/test/export.test.js
new file mode 100644
index 0000000..261fa55
