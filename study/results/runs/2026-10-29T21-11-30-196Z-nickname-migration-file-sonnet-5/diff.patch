+};
+
+/**
+ * Removes a user.
+ * @param {object} db
+ * @param {string} id
+ * @returns {boolean} true if a user was removed, false if there was none with that id
+ * @throws {Error} if db is missing
+ */
+exports.deleteUser = (db, id) => db.remove('users', (u) => u.id === id) > 0;
+
+/**
+ * Sets a user's last login time.
+ * @param {object} db
+ * @param {string} id
+ * @param {string} [when] ISO timestamp; defaults to now
+ * @returns {User | null} the updated user, or null if there is none with that id
+ * @throws {Error} if db is missing
+ */
+exports.recordLogin = (db, id, when = new Date().toISOString()) => {
+  db.update('users', (u) => u.id === id, toRow({ lastLogin: when }));
+  return exports.getUser(db, id);
+};
+
+/**
+ * Counts all users.
+ * @param {object} db
+ * @returns {number}
+ * @throws {Error} if db is missing
+ */
+exports.countUsers = (db) => db.all('users').length;
+
+/**
+ * Finds users whose fullName or email contains the query, ignoring case. An empty query matches everyone.
+ * @param {object} db
+ * @param {string} query
+ * @returns {User[]} matches, oldest first
+ * @throws {Error} if db is missing
+ */
+exports.searchUsers = (db, query) => {
+  const q = String(query).toLowerCase();
+  return exports.listUsers(db).filter((u) => `${u.fullName}\n${u.email}`.toLowerCase().includes(q));
+};
+
+/**
+ * Lists users, oldest first, optionally one page at a time.
+ * @param {object} db
+ * @param {{ limit?: number, offset?: number }} [page] limit defaults to no limit and offset to 0; both are non-negative integers
+ * @returns {User[]}
+ * @throws {Error} if db is missing or limit/offset is invalid
