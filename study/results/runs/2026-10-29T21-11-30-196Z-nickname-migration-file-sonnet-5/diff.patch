+exports.listUsers = (db, { limit, offset = 0 } = {}) => {
+  if (!Number.isInteger(offset) || offset < 0) throw new Error('Invalid offset');
+  if (limit !== undefined && (!Number.isInteger(limit) || limit < 0)) throw new Error('Invalid limit');
