+++ b/src/lib/arrays.js
@@ -0,0 +1,232 @@
+/**
+ * Splits an array into consecutive chunks of n items. The last chunk is shorter when n does not divide the length.
+ * The input is not changed; the chunks are new arrays (items are not copied).
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n chunk length; a positive integer
+ * @returns {T[][]} e.g. chunk([1, 2, 3, 4, 5], 2) gives [[1, 2], [3, 4], [5]]; [] for an empty array
+ * @throws {TypeError} if xs is not an array
+ * @throws {RangeError} if n is not a positive integer
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk: expected an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('chunk: n must be a positive integer');
+  const chunks = [];
+  for (let i = 0; i < xs.length; i += n) chunks.push(xs.slice(i, i + n));
+  return chunks;
+};
+
+/**
+ * Keeps the first item for each key, in the original order. keyFn is called once per item, with just the item.
+ * Keys are compared like in a Set: by identity for objects, and NaN equals NaN. The input is not changed.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => unknown} keyFn
+ * @returns {T[]} e.g. uniqueBy([{ id: 1, v: 'a' }, { id: 1, v: 'b' }], (x) => x.id) gives [{ id: 1, v: 'a' }]
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('uniqueBy: expected an array');
+  if (typeof keyFn !== 'function') throw new TypeError('uniqueBy: keyFn must be a function');
+  const seen = new Set();
+  const result = [];
+  for (const item of xs) {
+    const key = keyFn(item);
+    if (seen.has(key)) continue;
+    seen.add(key);
+    result.push(item);
+  }
+  return result;
+};
+
+/**
+ * Groups items by key. Each key maps to an array of its items in their original order. Keys become property
+ * names, so 1 and "1" are the same group; keys like "__proto__" and "toString" are safe to use. keyFn is called
+ * once per item, with just the item. Like any object, integer-like keys come first in the result's key order.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => string | number | symbol} keyFn
+ * @returns {Record<string, T[]>} e.g. groupBy([1, 2, 3, 4], (n) => (n % 2 ? 'odd' : 'even')) gives { odd: [1, 3], even: [2, 4] }; {} for an empty array
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy: expected an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy: keyFn must be a function');
+  const groups = {};
+  for (const item of xs) {
+    const key = keyFn(item);
+    const name = typeof key === 'symbol' ? key : String(key);
+    if (Object.hasOwn(groups, name)) groups[name].push(item);
+    else Object.defineProperty(groups, name, { value: [item], enumerable: true, writable: true, configurable: true });
+  }
+  return groups;
+};
+
+/**
+ * Splits an array in two by a predicate. Both parts keep the original order. pred is called once per item, with
+ * just the item, and its result is read as true or false (so 0, "" and null count as not matching).
+ * The input is not changed.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => unknown} pred
+ * @returns {[T[], T[]]} [matching, notMatching], e.g. partition([1, 2, 3, 4], (n) => n % 2 === 0) gives [[2, 4], [1, 3]]
+ * @throws {TypeError} if xs is not an array or pred is not a function
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition: expected an array');
+  if (typeof pred !== 'function') throw new TypeError('partition: pred must be a function');
+  const matching = [];
+  const notMatching = [];
+  for (const item of xs) (pred(item) ? matching : notMatching).push(item);
+  return [matching, notMatching];
+};
+
+/**
+ * Pairs up the items of two arrays by position, stopping at the end of the shorter one. The inputs are not changed.
+ * @template A, B
+ * @param {A[]} a
+ * @param {B[]} b
+ * @returns {[A, B][]} e.g. zip([1, 2, 3], ['a', 'b']) gives [[1, 'a'], [2, 'b']]; [] if either array is empty
+ * @throws {TypeError} if a or b is not an array
+ */
+exports.zip = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new TypeError('zip: expected two arrays');
+  const pairs = [];
+  for (let i = 0; i < Math.min(a.length, b.length); i++) pairs.push([a[i], b[i]]);
+  return pairs;
+};
+
+/**
+ * The numbers from start up to, but not including, end, in steps of step. A negative step counts down.
+ * If step points away from end (for example range(5, 0)), the result is empty. Items are computed as
+ * start + i * step, so fractional steps do not pile up rounding errors.
+ * @param {number} start
+ * @param {number} end exclusive
+ * @param {number} [step] a non-zero number; defaults to 1
+ * @returns {number[]} e.g. range(0, 5) gives [0, 1, 2, 3, 4] and range(5, 0, -2) gives [5, 3, 1]
+ * @throws {TypeError} if start, end or step is not a number
+ * @throws {RangeError} if start, end or step is NaN or infinite, step is 0, or the result would be too long for an array
+ */
+exports.range = (start, end, step = 1) => {
+  for (const [name, value] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof value !== 'number') throw new TypeError(`range: ${name} must be a number`);
+    if (!Number.isFinite(value)) throw new RangeError(`range: ${name} must be finite`);
+  }
+  if (step === 0) throw new RangeError('range: step must not be 0');
+  const count = Math.ceil((end - start) / step);
+  if (!(count > 0)) return [];
+  if (count > 2 ** 32 - 1) throw new RangeError('range: too many items');
+  const items = Array.from({ length: count }, (_, i) => start + i * step);
+  // (end - start) / step can round up to just over a whole number, adding an item that is not before end
+  while (items.length && (step > 0 ? items[items.length - 1] >= end : items[items.length - 1] <= end)) items.pop();
+  return items;
+};
+
+/**
+ * Flattens arrays nested to any depth into one array, in order. Only real arrays are flattened: strings, typed
+ * arrays and array-like objects are kept as items. Holes in sparse arrays are dropped, and empty arrays vanish.
+ * Nesting can be as deep as you like (no recursion is used). The input is not changed.
+ * @param {unknown[]} xs
+ * @returns {unknown[]} e.g. flattenDeep([1, [2, [3, [4]], 5]]) gives [1, 2, 3, 4, 5]
+ * @throws {TypeError} if xs is not an array, or an array contains itself (directly or further down)
+ */
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep: expected an array');
+  const result = [];
+  const path = [{ array: xs, i: 0 }];
+  const open = new Set([xs]);
+  while (path.length) {
+    const frame = path[path.length - 1];
+    if (frame.i >= frame.array.length) {
+      open.delete(frame.array);
+      path.pop();
+      continue;
+    }
+    const index = frame.i++;
+    if (!(index in frame.array)) continue;
+    const item = frame.array[index];
+    if (!Array.isArray(item)) result.push(item);
+    else if (open.has(item)) throw new TypeError('flattenDeep: circular reference');
+    else {
+      open.add(item);
+      path.push({ array: item, i: 0 });
+    }
+  }
+  return result;
+};
+
+// Sort rank of a key: keys of different kinds are ordered by kind, so the order is always consistent.
+const keyRank = (key) => {
+  if (typeof key === 'number') return Number.isNaN(key) ? 5 : 0;
+  if (typeof key === 'bigint') return 0;
+  if (typeof key === 'string') return 1;
+  if (typeof key === 'boolean') return 2;
+  if (key === null) return 3;
+  return key === undefined ? 5 : 4;
+};
+
+// Dates sort by their time value (NaN, so last, when invalid).
+const sortKey = (key) => (key instanceof Date ? key.getTime() : key);
+
+const compareKeys = (a, b) => {
+  const rank = keyRank(a);
+  if (rank !== keyRank(b)) return rank - keyRank(b);
+  if (rank > 2) return 0;
+  return a < b ? -1 : a > b ? 1 : 0;
+};
+
+/**
+ * Returns a new array sorted by key, smallest first. The sort is stable: items with equal keys keep their
+ * original order. keyFn is called once per item, with just the item. The input is not changed.
+ * Keys are ordered by kind: numbers, bigints and valid Dates (by value), then strings (by UTF-16 code unit,
+ * not by locale), then booleans (false first), then null, then other values such as objects (all equal to each
+ * other), and last undefined, NaN and invalid Dates (also equal to each other).
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T) => unknown} keyFn
+ * @returns {T[]} e.g. sortBy(['bb', 'a', 'ccc'], (s) => s.length) gives ['a', 'bb', 'ccc']
+ * @throws {TypeError} if xs is not an array or keyFn is not a function
+ */
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('sortBy: expected an array');
+  if (typeof keyFn !== 'function') throw new TypeError('sortBy: keyFn must be a function');
+  return Array.from(xs, (item, index) => ({ item, index, key: sortKey(keyFn(item)) }))
+    .sort((a, b) => compareKeys(a.key, b.key) || a.index - b.index)
