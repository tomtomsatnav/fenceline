+  const seconds = Math.floor(Math.abs(difference) / 1000);
+  if (seconds < 5) return 'just now';
+  const days = Math.floor(seconds / 86400);
+  const [count, unit] = seconds < 60 ? [seconds, 'second']
+    : seconds < 3600 ? [Math.floor(seconds / 60), 'minute']
+    : seconds < 86400 ? [Math.floor(seconds / 3600), 'hour']
+    : days < 7 ? [days, 'day']
+    : days < 30 ? [Math.floor(days / 7), 'week']
+    : days < 360 ? [Math.floor(days / 30), 'month']
+    : [Math.max(1, Math.floor(days / 365)), 'year'];
+  const text = `${count} ${unit}${count === 1 ? '' : 's'}`;
+  return difference < 0 ? `${text} ago` : `in ${text}`;
+};
