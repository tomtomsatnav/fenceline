+
+const BYTE_UNITS = ['B', 'KB', 'MB', 'GB', 'TB'];
+
+/**
+ * Formats a number of bytes for people to read, using units of 1024: B, KB, MB, GB and TB. The number is shown
+ * with at most one decimal place (half away from zero), and a ".0" is left off: 1536 gives "1.5 KB" and 1024 gives
+ * "1 KB". A number that rounds up to 1024 moves to the next unit, so 1048575 gives "1 MB", not "1024 KB". There is
+ * nothing above TB, so 1024 TB stays "1024 TB". A negative number (a difference in size) gets a leading "-".
+ * @param {number} bytes a finite number; it does not have to be a whole number
+ * @returns {string} e.g. formatBytes(0) gives "0 B", formatBytes(500) gives "500 B" and formatBytes(1536) gives "1.5 KB"
+ * @throws {TypeError} if bytes is not a number
+ * @throws {RangeError} if bytes is NaN or infinite
+ */
+exports.formatBytes = (bytes) => {
+  if (typeof bytes !== 'number') throw new TypeError('formatBytes: bytes must be a number');
+  if (!Number.isFinite(bytes)) throw new RangeError('formatBytes: bytes must be finite');
+  let value = Math.abs(bytes);
+  let unit = 0;
+  let rounded = exports.roundTo(value, 1);
+  while (rounded >= 1024 && unit < BYTE_UNITS.length - 1) {
+    value /= 1024;
+    unit++;
+    rounded = exports.roundTo(value, 1);
+  }
+  return `${bytes < 0 && rounded !== 0 ? '-' : ''}${rounded} ${BYTE_UNITS[unit]}`;
