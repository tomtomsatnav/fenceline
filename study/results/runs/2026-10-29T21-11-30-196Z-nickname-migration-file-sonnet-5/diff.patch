+ * The input is not changed; each window is a new array (items are not copied).
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n window length; a positive integer
+ * @returns {T[][]} e.g. windowed([1, 2, 3, 4], 2) gives [[1, 2], [2, 3], [3, 4]]; [] if n is more than the length
+ * @throws {TypeError} if xs is not an array
+ * @throws {RangeError} if n is not a positive integer
+ */
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed: expected an array');
+  if (!Number.isInteger(n) || n < 1) throw new RangeError('windowed: n must be a positive integer');
+  const windows = [];
+  for (let i = 0; i + n <= xs.length; i++) windows.push(xs.slice(i, i + n));
+  return windows;
+};
