+  const merged = new Map(); // a merged pair, so that cycles and shared parts are merged only once
+  const pending = [];
+  const mergePair = (x, y) => {
+    let result = merged.get(x)?.get(y);
+    if (result === undefined) {
+      result = {};
+      if (!merged.has(x)) merged.set(x, new Map());
+      merged.get(x).set(y, result);
