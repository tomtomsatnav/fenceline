+  checkObjectAndKeys('pick', obj, keys);
+  const result = {};
+  for (const key of keys) if (Object.hasOwn(obj, key)) setOwn(result, key, obj[key]);
+  return result;
+};
+
+/**
+ * Returns a new object with the own enumerable properties of obj, except the listed keys (as for an object spread,
+ * inherited properties are not copied). Keys that obj does not have are ignored. The values are not copied: objects
+ * inside are shared with obj, and a getter is read once and its value copied. Properties keep the order they have in
+ * obj. Number keys match their string form, so 1 omits "1". Repeated keys are harmless, a property named "__proto__"
