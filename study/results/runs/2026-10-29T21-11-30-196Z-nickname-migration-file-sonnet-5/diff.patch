+++ b/test/export.test.js
@@ -0,0 +1,79 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { createUser, listUsers, recordLogin } = require('../src/api/users.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+
+const insert = (db, id, fullname, created_at, extra = {}) =>
+  db.insert('users', { id, email: `${id}@example.com`, fullname, created_at, ...extra });
+
+test('exportUsersCsv with no users is just the header', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), 'id,email,fullName,createdAt,lastLogin\n');
+});
+
+test('exportUsersCsv writes one row per user, oldest first', () => {
+  const db = migrate(new Db());
+  insert(db, 'b', 'Grace Hopper', '2024-02-01T00:00:00.000Z', { last_login: '2024-03-01T00:00:00.000Z' });
+  insert(db, 'a', 'Ada Lovelace', '2024-01-01T00:00:00.000Z');
+  assert.strictEqual(
+    exportUsersCsv(db),
+    [
+      'id,email,fullName,createdAt,lastLogin',
+      'a,a@example.com,Ada Lovelace,2024-01-01T00:00:00.000Z,',
+      'b,b@example.com,Grace Hopper,2024-02-01T00:00:00.000Z,2024-03-01T00:00:00.000Z',
+      '',
+    ].join('\n'),
+  );
+});
+
+test('exportUsersCsv quotes fields with commas, quotes or newlines', () => {
+  const db = migrate(new Db());
+  insert(db, 'a', 'Lovelace, Ada', '2024-01-01T00:00:00.000Z');
+  insert(db, 'b', 'Ada "Countess" King', '2024-01-02T00:00:00.000Z');
+  insert(db, 'c', 'Two\nLines', '2024-01-03T00:00:00.000Z');
+  const lines = exportUsersCsv(db).split('\n');
+  assert.strictEqual(lines[1], 'a,a@example.com,"Lovelace, Ada",2024-01-01T00:00:00.000Z,');
+  assert.strictEqual(lines[2], 'b,b@example.com,"Ada ""Countess"" King",2024-01-02T00:00:00.000Z,');
+  assert.strictEqual(lines[3] + '\n' + lines[4], 'c,c@example.com,"Two\nLines",2024-01-03T00:00:00.000Z,');
+});
+
+test('exportUsersCsv throws a clear Error when db is missing', () => {
+  assert.throws(() => exportUsersCsv(undefined), { message: 'exportUsersCsv: db is required' });
+});
+
+test('importUsersCsv round-trips exportUsersCsv', () => {
+  const source = migrate(new Db());
+  const ada = createUser(source, { email: 'ada@example.com', fullName: 'Lovelace, Ada "Countess"' });
+  createUser(source, { email: 'grace@example.com', fullName: 'Grace\nHopper' });
+  recordLogin(source, ada.id, '2024-05-01T12:00:00.000Z');
+  const csv = exportUsersCsv(source);
+
+  const target = migrate(new Db());
+  assert.strictEqual(importUsersCsv(target, csv), 2);
+  assert.deepStrictEqual(listUsers(target), listUsers(source));
+  assert.strictEqual(exportUsersCsv(target), csv);
+});
+
+test('importUsersCsv accepts CRLF line endings and an empty export', () => {
+  const db = migrate(new Db());
+  assert.strictEqual(importUsersCsv(db, 'id,email,fullName,createdAt,lastLogin\n'), 0);
+  const csv = 'id,email,fullName,createdAt,lastLogin\r\nu1,u1@example.com,U One,2024-01-01T00:00:00.000Z,\r\n';
+  assert.strictEqual(importUsersCsv(db, csv), 1);
+  assert.strictEqual(listUsers(db)[0].fullName, 'U One');
+});
+
+test('importUsersCsv rejects bad input and imports nothing', () => {
+  const db = migrate(new Db());
+  createUser(db, { email: 'ada@example.com', fullName: 'Ada Lovelace' });
+  const head = 'id,email,fullName,createdAt,lastLogin\n';
+  const good = 'u1,u1@example.com,U One,2024-01-01T00:00:00.000Z,\n';
+  assert.throws(() => importUsersCsv(db, 'id,email\n'), Error);
+  assert.throws(() => importUsersCsv(db, head + good + 'u2,only,three\n'), Error);
+  assert.throws(() => importUsersCsv(db, head + good + 'u2,nope,U Two,2024-01-01T00:00:00.000Z,\n'), Error);
+  assert.throws(() => importUsersCsv(db, head + good + 'u1,u3@example.com,U Three,2024-01-01T00:00:00.000Z,\n'), Error);
+  assert.throws(() => importUsersCsv(db, head + good + 'u4,ADA@example.com,Dup,2024-01-01T00:00:00.000Z,\n'), Error);
+  assert.throws(() => importUsersCsv(db, head + 'u5,u5@example.com,"open,2024-01-01T00:00:00.000Z,\n'), Error);
+  assert.strictEqual(listUsers(db).length, 1);
+  assert.throws(() => importUsersCsv(undefined, head), { message: 'importUsersCsv: db is required' });
+});
