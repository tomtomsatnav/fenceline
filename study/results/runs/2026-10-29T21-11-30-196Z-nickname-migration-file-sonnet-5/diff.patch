+
+test('wrap breaks lines between words so none is longer than width', () => {
+  assert.strictEqual(wrap('the quick brown fox jumps', 10), 'the quick\nbrown fox\njumps');
+  assert.strictEqual(wrap('aaa bbb ccc', 7), 'aaa bbb\nccc');
+  const wrapped = wrap('lorem ipsum dolor sit amet consectetur adipiscing elit', 15);
+  for (const line of wrapped.split('\n')) assert.ok(line.length <= 15, line);
+  assert.strictEqual(wrapped.replace(/\n/g, ' '), 'lorem ipsum dolor sit amet consectetur adipiscing elit');
+});
+
+test('wrap fills each line as much as it can', () => {
+  assert.strictEqual(wrap('aaa bbb', 7), 'aaa bbb');
+  assert.strictEqual(wrap('aaa bbb', 6), 'aaa\nbbb');
+  assert.strictEqual(wrap('a b c d e f', 3), 'a b\nc d\ne f');
+  assert.strictEqual(wrap('one two three', 100), 'one two three');
+});
+
+test('wrap never splits a word, even one longer than width', () => {
+  assert.strictEqual(wrap('a extraordinarily b', 5), 'a\nextraordinarily\nb');
+  assert.strictEqual(wrap('supercalifragilistic', 5), 'supercalifragilistic');
+  assert.strictEqual(wrap('ab cd', 1), 'ab\ncd');
+});
+
+test('wrap keeps existing line breaks and blank lines', () => {
+  assert.strictEqual(wrap('aaa bbb\nccc ddd', 7), 'aaa bbb\nccc ddd');
+  assert.strictEqual(wrap('aaa bbb ccc\nddd', 7), 'aaa bbb\nccc\nddd');
+  assert.strictEqual(wrap('para one\n\npara two', 20), 'para one\n\npara two');
+  assert.strictEqual(wrap('aaa\r\nbbb', 20), 'aaa\nbbb');
+  assert.strictEqual(wrap('trailing\n', 20), 'trailing\n');
+});
+
+test('wrap collapses extra whitespace within a line', () => {
+  assert.strictEqual(wrap('  aaa    bbb\tccc  ', 20), 'aaa bbb ccc');
+  assert.strictEqual(wrap('aaa     bbb', 3), 'aaa\nbbb');
+});
+
+test('wrap handles empty input and counts code points', () => {
+  assert.strictEqual(wrap('', 10), '');
+  assert.strictEqual(wrap('   ', 10), '');
+  assert.strictEqual(wrap('😀😀 😀😀', 5), '😀😀 😀😀');
+  assert.strictEqual(wrap('😀😀 😀😀', 4), '😀😀\n😀😀');
+  assert.strictEqual(wrap('привет мир', 6), 'привет\nмир');
+});
+
+test('wrap throws on bad arguments', () => {
+  for (const bad of [undefined, null, 42, {}]) assert.throws(() => wrap(bad, 10), TypeError);
+  for (const bad of [0, -1, 1.5, NaN, Infinity, '10', undefined]) assert.throws(() => wrap('text', bad), RangeError);
+});
+
+test('template fills placeholders from the values', () => {
+  assert.strictEqual(template('Hi {name}', { name: 'Ada' }), 'Hi Ada');
+  assert.strictEqual(template('{greeting}, {name}!', { greeting: 'Hello', name: 'Ada' }), 'Hello, Ada!');
+  assert.strictEqual(template('{a}{b}{c}', { a: 1, b: 2, c: 3 }), '123');
+  assert.strictEqual(template('{x} and {x} again', { x: 'one' }), 'one and one again');
+  assert.strictEqual(template('{item_1} / {Item2}', { item_1: 'a', Item2: 'b' }), 'a / b');
+});
+
+test('template leaves unknown placeholders as they are', () => {
+  assert.strictEqual(template('Hi {name}', {}), 'Hi {name}');
+  assert.strictEqual(template('Hi {name}'), 'Hi {name}');
+  assert.strictEqual(template('{a} {b}', { a: 'x' }), 'x {b}');
+  assert.strictEqual(template('Hi {name}', { other: 'Ada' }), 'Hi {name}');
+});
+
+test('template ignores prototype properties', () => {
+  assert.strictEqual(template('{toString} {constructor} {__proto__}', {}), '{toString} {constructor} {__proto__}');
+  assert.strictEqual(template('{name}', Object.create({ name: 'inherited' })), '{name}');
+});
+
+test('template fills falsy values but leaves undefined and null placeholders', () => {
+  assert.strictEqual(template('{n} {b} {s}', { n: 0, b: false, s: '' }), '0 false ');
+  assert.strictEqual(template('{a} {b}', { a: undefined, b: null }), '{a} {b}');
+  assert.strictEqual(template('{n}', { n: 12.5 }), '12.5');
+  assert.strictEqual(template('{list}', { list: [1, 2] }), '1,2');
+});
+
+test('template inserts values as is', () => {
+  assert.strictEqual(template('{a}', { a: '$& $1 $$' }), '$& $1 $$');
+  assert.strictEqual(template('{a} {b}', { a: '{b}', b: 'x' }), '{b} x');
+});
+
+test('template ignores text that is not a placeholder', () => {
+  assert.strictEqual(template('no placeholders', { a: 1 }), 'no placeholders');
+  assert.strictEqual(template('', { a: 1 }), '');
+  assert.strictEqual(template('{}', { a: 1 }), '{}');
+  assert.strictEqual(template('{ a }', { a: 1 }), '{ a }');
+  assert.strictEqual(template('{a-b} {a.b}', { 'a-b': 1, 'a.b': 2 }), '{a-b} {a.b}');
+  assert.strictEqual(template('{a', { a: 1 }), '{a');
+  assert.strictEqual(template('a}', { a: 1 }), 'a}');
+  assert.strictEqual(template('{{a}}', { a: 1 }), '{1}');
+  assert.strictEqual(template('{a}\n{a}', { a: 'é' }), 'é\né');
+});
+
+test('template throws a TypeError for bad arguments', () => {
+  for (const bad of [undefined, null, 42, {}]) assert.throws(() => template(bad, {}), TypeError);
+  for (const bad of [null, 'text', 42, true]) assert.throws(() => template('{a}', bad), TypeError);
+});
