+test('toRoman gives a valid, distinct numeral that converts back, for every number from 1 to 3999', () => {
+  const values = { I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000 };
+  const parse = (roman) => [...roman].reduce((total, ch, i) => {
+    const v = values[ch];
+    return total + (v < values[roman[i + 1]] ? -v : v);
+  }, 0);
+  const valid = /^M{0,3}(CM|CD|D?C{0,3})(XC|XL|L?X{0,3})(IX|IV|V?I{0,3})$/;
+  const seen = new Set();
+  for (let n = 1; n <= 3999; n++) {
+    const roman = toRoman(n);
+    assert.ok(valid.test(roman), `${n}: ${roman}`);
+    assert.strictEqual(parse(roman), n, `${n}: ${roman}`);
+    seen.add(roman);
+  }
+  assert.strictEqual(seen.size, 3999);
+});
