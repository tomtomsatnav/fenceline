+/**
+ * Describes a date relative to now in English: "3 minutes ago", "in 2 days", "just now". The difference is rounded
+ * down to the largest unit that fits, so 3 minutes 59 seconds is "3 minutes". Units have fixed lengths, so the local
+ * time zone and daylight saving make no difference: a day is 24 hours, a week 7 days, a month 30 days, a year 365 days.
+ *
+ * - under 5 seconds either way: "just now"
+ * - under 1 minute: seconds; under 1 hour: minutes; under 1 day: hours
+ * - under 1 week: days; under 30 days: weeks; under 360 days: months (up to "11 months"); then years (at least 1)
+ *
+ * One of a unit is singular ("1 hour ago", "in 1 day").
+ * @param {Date} date a valid Date
+ * @param {Date} [now] a valid Date to compare with; defaults to the current time
+ * @returns {string} e.g. "3 minutes ago" for a past date and "in 2 days" for a future one
+ * @throws {TypeError} if date or now is not a Date
+ * @throws {RangeError} if date or now is an invalid Date
+ */
+exports.relativeTime = (date, now = new Date()) => {
+  for (const [name, value] of [['date', date], ['now', now]]) {
+    if (!(value instanceof Date)) throw new TypeError(`relativeTime: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`relativeTime: ${name} is an invalid Date`);
+  }
