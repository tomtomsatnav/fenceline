new file mode 100644
index 0000000..4139a6f
--- /dev/null
+++ b/README.md
@@ -0,0 +1,46 @@
+# Project
+
+## Users API
+
+All functions take the database as their first argument (`db`) and throw an `Error` such as `getUser: db is required` if it is missing.
+
+A **user** is `{ id, email, fullName, nickname, createdAt, lastLogin }`. `createdAt` and `lastLogin` are ISO timestamps, and `lastLogin` is `null` until a login is recorded. `nickname` is optional and `null` when not set; it needs the `nickname` column in the `users` table (a migration).
+
+### `src/api/users.js`
+
+```js
+const users = require('./src/api/users.js');
+```
+
+| Function | Returns | Notes |
+| --- | --- | --- |
+| `createUser(db, { email, fullName, nickname })` | the new user | Generates the id and `createdAt`. Throws if `email` has no `"@"` or is already used (ignoring case), or if `fullName` is not a string of 1-100 characters. |
+| `getUser(db, id)` | user, or `null` | |
+| `getUserByEmail(db, email)` | user, or `null` | Case-insensitive. |
+| `updateUser(db, id, { email, fullName })` | the updated user, or `null` if there is no such user | Changes only the fields given. New values are validated like in `createUser`; a user may keep their own email. Nothing changes if validation fails. |
+| `deleteUser(db, id)` | `true` if a user was removed, `false` if there was none | |
+| `recordLogin(db, id, when)` | the updated user, or `null` if there is no such user | Sets `lastLogin`. `when` is an ISO timestamp and defaults to now. |
+| `countUsers(db)` | number | |
+| `searchUsers(db, query)` | array of users | Matches a substring of `fullName` or `email`, ignoring case. An empty query matches everyone. Oldest first. |
+| `listUsers(db, { limit, offset })` | array of users, oldest first | `limit` defaults to no limit and `offset` to `0`. Both must be non-negative integers, or it throws. |
+
+### `src/api/export.js`
+
+```js
+const { exportUsersCsv, importUsersCsv } = require('./src/api/export.js');
+```
+
+| Function | Returns | Notes |
+| --- | --- | --- |
+| `exportUsersCsv(db)` | CSV string | Header row `id,email,fullName,createdAt,lastLogin`, then one row per user, oldest first. Fields containing commas, quotes or newlines are quoted. Every line ends with `\n`. |
+| `importUsersCsv(db, csv)` | number of users imported | The inverse of `exportUsersCsv`; keeps each user's `id`, `createdAt` and `lastLogin`. Every row is checked before any is inserted, so a bad file imports nothing. Throws on a wrong header, a row with the wrong number of fields, an email without `"@"`, or an `id` or `email` (ignoring case) that is duplicated in the file or already in the database. |
+
+### `src/api/format.js`
+
+```js
+const { displayName } = require('./src/api/format.js');
+```
+
+| Function | Returns | Notes |
+| --- | --- | --- |
+| `displayName(user)` | string | The user's `fullName`, or the part of the email before `"@"` when `fullName` is empty. |
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..c72a924
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,79 @@
+const { getUserByEmail, getUser, listUsers } = require('./users.js');
+
+const FIELDS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+const csvField = (value) => {
+  const s = value ?? '';
+  return /[",\r\n]/.test(s) ? `"${String(s).replace(/"/g, '""')}"` : String(s);
+};
+
+/**
+ * Exports all users as CSV: a header row (id,email,fullName,createdAt,lastLogin) plus one row per user, oldest first.
+ * Fields containing commas, quotes or newlines are quoted. Every line ends with "\n".
+ * @param {object} db
+ * @returns {string}
+ * @throws {Error} if db is missing
+ */
+exports.exportUsersCsv = (db) => {
+  if (!db) throw new Error('exportUsersCsv: db is required');
+  const rows = listUsers(db).map((u) => FIELDS.map((f) => csvField(u[f])).join(','));
+  return [FIELDS.join(','), ...rows].map((line) => `${line}\n`).join('');
+};
+
+// Splits CSV text into records of fields, undoing the quoting done by csvField.
+const parseCsv = (text) => {
+  const records = [];
+  let record = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c !== '"') field += c;
+      else if (text[i + 1] === '"') { field += '"'; i++; }
+      else quoted = false;
+    } else if (c === '"') quoted = true;
+    else if (c === ',') { record.push(field); field = ''; }
+    else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      record.push(field);
+      records.push(record);
+      record = [];
+      field = '';
+    } else field += c;
+  }
+  if (quoted) throw new Error('importUsersCsv: unterminated quoted field');
+  if (field !== '' || record.length) { record.push(field); records.push(record); }
+  return records;
+};
+
+/**
+ * Inverse of exportUsersCsv: keeps each user's id, createdAt and lastLogin.
+ * Every row is checked before any is inserted, so a bad file imports nothing.
+ * @param {object} db
+ * @param {string} csv in the format exportUsersCsv writes
+ * @returns {number} how many users were imported
+ * @throws {Error} if db is missing, the header or a row is malformed, or an id or email is already taken
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (!db) throw new Error('importUsersCsv: db is required');
+  const [header, ...records] = parseCsv(String(csv));
+  if (!header || header.join(',') !== FIELDS.join(',')) throw new Error(`importUsersCsv: header must be ${FIELDS.join(',')}`);
+  const ids = new Set();
+  const emails = new Set();
+  const rows = records.map((record, i) => {
+    const line = i + 2;
+    if (record.length !== FIELDS.length) throw new Error(`importUsersCsv: line ${line} has ${record.length} fields, expected ${FIELDS.length}`);
+    const [id, email, fullName, createdAt, lastLogin] = record;
+    if (!email.includes('@')) throw new Error(`importUsersCsv: line ${line} has an invalid email`);
+    if (ids.has(id) || getUser(db, id)) throw new Error(`importUsersCsv: line ${line} duplicates id ${id}`);
+    if (emails.has(email.toLowerCase()) || getUserByEmail(db, email)) throw new Error(`importUsersCsv: line ${line} duplicates email ${email}`);
+    ids.add(id);
+    emails.add(email.toLowerCase());
+    const row = { id, email, fullname: fullName, created_at: createdAt };
+    if (lastLogin !== '') row.last_login = lastLogin;
+    return row;
+  });
+  for (const row of rows) db.insert('users', row);
+  return rows.length;
+};
