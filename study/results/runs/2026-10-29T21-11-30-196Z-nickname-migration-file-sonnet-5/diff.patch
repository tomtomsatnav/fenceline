+const checkObjectAndKeys = (name, obj, keys) => {
+  if ((typeof obj !== 'object' && typeof obj !== 'function') || obj === null) throw new TypeError(`${name}: obj must be an object`);
+  if (!Array.isArray(keys)) throw new TypeError(`${name}: keys must be an array`);
+  for (let i = 0; i < keys.length; i++) {
+    const type = typeof keys[i];
+    if (type !== 'string' && type !== 'number' && type !== 'symbol') {
+      throw new TypeError(`${name}: key ${i} must be a string, number or symbol`);
+    }
+  }
+};
