+  let total = 0;
+  for (const [value, symbol] of ROMAN_NUMERALS) {
+    while (rest.startsWith(symbol)) {
+      total += value;
+      rest = rest.slice(symbol.length);
+    }
+  }
+  // reading greedily accepts some bad forms (like "IIII"), so check that the number writes back the same way
+  if (rest !== '' || total < 1 || total > 3999 || exports.toRoman(total) !== roman) {
+    throw new SyntaxError(`fromRoman: invalid Roman numeral ${JSON.stringify(roman)}`);
+  }
+  return total;
+};
