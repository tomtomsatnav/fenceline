+  assert.strictEqual(reverseWords(reverseWords('  one   two three ')), 'one two three');
+});
+
+test('reverseWords throws a TypeError for non-strings', () => {
+  for (const bad of [undefined, null, 42, {}, ['a']]) {
+    assert.throws(() => reverseWords(bad), TypeError);
+  }
+});
+
+test('isPalindrome is true for strings that read the same backwards', () => {
+  assert.strictEqual(isPalindrome('racecar'), true);
+  assert.strictEqual(isPalindrome('abba'), true);
+  assert.strictEqual(isPalindrome('level'), true);
+  assert.strictEqual(isPalindrome('12321'), true);
+});
+
+test('isPalindrome is false for strings that do not', () => {
+  assert.strictEqual(isPalindrome('hello'), false);
+  assert.strictEqual(isPalindrome('ab'), false);
+  assert.strictEqual(isPalindrome('12345'), false);
+  assert.strictEqual(isPalindrome('racecars'), false);
+});
+
+test('isPalindrome ignores case, spaces and punctuation', () => {
+  assert.strictEqual(isPalindrome('Racecar'), true);
+  assert.strictEqual(isPalindrome('A man, a plan, a canal: Panama'), true);
+  assert.strictEqual(isPalindrome("Madam, I'm Adam"), true);
+  assert.strictEqual(isPalindrome('Was it a car or a cat I saw?'), true);
+  assert.strictEqual(isPalindrome('No lemon, no melon!'), true);
+  assert.strictEqual(isPalindrome('not, a palindrome.'), false);
+});
+
+test('isPalindrome handles empty input and strings with nothing to compare', () => {
+  assert.strictEqual(isPalindrome(''), true);
+  assert.strictEqual(isPalindrome('   '), true);
+  assert.strictEqual(isPalindrome('?!., -'), true);
+  assert.strictEqual(isPalindrome('x'), true);
+  assert.strictEqual(isPalindrome(' x '), true);
+});
+
+test('isPalindrome handles non-English text', () => {
+  assert.strictEqual(isPalindrome('А роза упала на лапу Азора'), true);
+  assert.strictEqual(isPalindrome('été'), true);
+  assert.strictEqual(isPalindrome('e\u0301te\u0301'), true);
+  assert.strictEqual(isPalindrome('été'), isPalindrome('e\u0301te\u0301'));
+  assert.strictEqual(isPalindrome('eté'), false);
+  assert.strictEqual(isPalindrome('日本日'), true);
+  assert.strictEqual(isPalindrome('😀a😀'), true);
+});
