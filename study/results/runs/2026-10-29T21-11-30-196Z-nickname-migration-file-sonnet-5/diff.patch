+  const sorted = [...xs].sort(ascending);
+  const rank = (p * (sorted.length - 1)) / 100;
+  const lower = sorted[Math.floor(rank)];
+  const upper = sorted[Math.ceil(rank)];
+  const fraction = rank - Math.floor(rank);
+  if (fraction === 0) return lower;
+  // upper - lower can overflow (or be infinite), so weigh the two items instead in that case
+  return Number.isFinite(upper - lower) ? lower + (upper - lower) * fraction : lower * (1 - fraction) + upper * fraction;
