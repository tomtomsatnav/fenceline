+const preciseSum = (xs) => {
+  let sum = 0;
+  let compensation = 0;
+  for (const x of xs) {
+    const t = sum + x;
+    compensation += Math.abs(sum) >= Math.abs(x) ? sum - t + x : x - t + sum;
+    sum = t;
+  }
+  return sum + compensation;
