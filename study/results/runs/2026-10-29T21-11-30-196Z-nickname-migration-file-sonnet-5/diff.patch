+/**
+ * Limits x to the range from lo to hi, both included: lo if x is below it, hi if x is above it, otherwise x.
+ * lo and hi may be infinite to leave one side open. A NaN x gives NaN.
+ * @param {number} x
+ * @param {number} lo
+ * @param {number} hi must not be less than lo
+ * @returns {number} e.g. clamp(15, 0, 10) gives 10 and clamp(-5, 0, 10) gives 0
+ * @throws {TypeError} if x, lo or hi is not a number
+ * @throws {RangeError} if lo or hi is NaN, or lo is greater than hi
+ */
+exports.clamp = (x, lo, hi) => {
+  for (const [name, value] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof value !== 'number') throw new TypeError(`clamp: ${name} must be a number`);
+  }
+  if (Number.isNaN(lo) || Number.isNaN(hi)) throw new RangeError('clamp: lo and hi must not be NaN');
+  if (lo > hi) throw new RangeError('clamp: lo must not be greater than hi');
+  return x < lo ? lo : x > hi ? hi : x;
+};
+
+/**
+ * Rounds x to the given number of decimal places, with halves rounded away from zero (2.5 gives 3, -2.5 gives -3).
+ * The number is rounded as it is written, so roundTo(1.005, 2) gives 1.01, where x.toFixed(2) and Math.round(x * 100) / 100
+ * give 1 because of binary rounding error. Negative places round to tens, hundreds, and so on. The result is never -0.
+ * NaN and infinite values, and numbers too large to have decimals, are returned as they are.
+ * @param {number} x
+ * @param {number} [places] an integer, positive or negative; defaults to 0
+ * @returns {number} e.g. roundTo(3.14159, 2) gives 3.14 and roundTo(1250, -2) gives 1300
+ * @throws {TypeError} if x or places is not a number
+ * @throws {RangeError} if places is not an integer
+ */
+exports.roundTo = (x, places = 0) => {
+  if (typeof x !== 'number') throw new TypeError('roundTo: x must be a number');
+  if (typeof places !== 'number') throw new TypeError('roundTo: places must be a number');
+  if (!Number.isInteger(places)) throw new RangeError('roundTo: places must be an integer');
+  if (!Number.isFinite(x)) return x;
+  // Shift the decimal point in the number's shortest written form, so no binary rounding error is introduced.
+  const [mantissa, exponent = '0'] = String(Math.abs(x)).split('e');
+  const shifted = Number(`${mantissa}e${Number(exponent) + places}`);
+  if (!Number.isFinite(shifted) || shifted >= 2 ** 53) return x;
+  const rounded = Math.round(shifted);
+  if (rounded === 0) return 0;
+  const result = Number(`${rounded}e${-places}`);
+  return x < 0 ? -result : result;
+};
+
+const checkNumbers = (name, xs) => {
+  if (!Array.isArray(xs)) throw new TypeError(`${name}: expected an array`);
+  for (let i = 0; i < xs.length; i++) {
+    if (typeof xs[i] !== 'number') throw new TypeError(`${name}: item ${i} is not a number`);
+  }
+};
