+ * largest inputs take a fraction of a second.
+ * @param {number} n
+ * @returns {boolean} e.g. isPrime(7) is true; isPrime(1), isPrime(9) and isPrime(-7) are false
+ * @throws {TypeError} if n is not a number
+ */
+exports.isPrime = (n) => {
+  if (typeof n !== 'number') throw new TypeError('isPrime: n must be a number');
+  if (!Number.isInteger(n) || n < 2) return false;
+  if (n < 4) return true;
+  if (n % 2 === 0 || n % 3 === 0) return false;
+  if (n > Number.MAX_SAFE_INTEGER) return false;
+  // every prime above 3 is 6k - 1 or 6k + 1
+  for (let i = 5; i * i <= n; i += 6) {
+    if (n % i === 0 || n % (i + 2) === 0) return false;
+  }
+  return true;
+};
+
