+/**
+ * The name to show for a user: their fullName, or the part of the email before "@" when fullName is empty.
+ * @param {{ fullName?: string | null, email: string }} user
+ * @returns {string}
+ */
+exports.displayName = (user) => user.fullName || user.email.split('@')[0];
