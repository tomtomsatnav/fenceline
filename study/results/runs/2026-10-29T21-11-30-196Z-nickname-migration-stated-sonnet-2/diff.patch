+  assert.deepStrictEqual(partition([1, 2, 3], () => false), [[], [1, 2, 3]]);
+});
+
+test('partition treats truthy and falsy predicate results as matching and not matching', () => {
+  assert.deepStrictEqual(partition([0, 1, '', 'a', null, {}, NaN], (x) => x), [[1, 'a', {}], [0, '', null, NaN]]);
+  assert.deepStrictEqual(partition([1, 2, 3], (n) => (n > 1 ? 'yes' : 0)), [[2, 3], [1]]);
+});
+
+test('partition returns new arrays holding the same items, and does not change its input', () => {
+  const a = { id: 1 };
