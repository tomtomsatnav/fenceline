+// Sum of finite numbers with Neumaier's compensation, which keeps the low-order bits a plain running sum loses
+// (a naive 1e16 + 1 - 1e16 gives 0, this gives 1).
+const compensatedSum = (values) => {
+  let sum = 0;
+  let compensation = 0;
+  for (const v of values) {
+    const t = sum + v;
+    compensation += Math.abs(sum) >= Math.abs(v) ? (sum - t) + v : (v - t) + sum;
+    sum = t;
+  }
+  return sum + compensation;
+};
+
+/**
+ * The arithmetic mean of an array of numbers: mean([1, 2, 3, 4]) is 2.5. An empty array gives NaN, since there
