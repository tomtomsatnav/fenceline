+ * @returns {Date}
+ * @throws {TypeError} If date is not a Date.
+ * @throws {RangeError} If date is an Invalid Date, or its week starts before the earliest Date.
+ */
+exports.startOfWeek = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('startOfWeek: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('startOfWeek: date is invalid');
+  const days = Math.floor(date.getTime() / MS_PER_DAY); // whole days since 1 January 1970, a Thursday
+  const sinceMonday = (((days + 3) % 7) + 7) % 7; // 0 on Monday ... 6 on Sunday
+  const start = new Date((days - sinceMonday) * MS_PER_DAY);
+  if (Number.isNaN(start.getTime())) throw new RangeError('startOfWeek: the week starts before the earliest Date');
+  return start;
+};
+
+/**
+ * Formats the UTC calendar day of date as YYYY-MM-DD, ignoring the time of day: formatIsoDate of
+ * 2024-05-10T23:59:59.999Z is "2024-05-10". Month and day always have two digits and the year at least four, so
+ * year 5 is "0005-01-01". Years outside 0000 to 9999 use the extended ISO 8601 form that toISOString and
+ * Date.parse understand, a sign and six digits: "+010000-01-01" and "-000001-12-31". The text parses back, via
+ * new Date(text), to midnight UTC of that day. It does not depend on the local time zone. date is not changed.
+ * @param {Date} date
+ * @returns {string}
