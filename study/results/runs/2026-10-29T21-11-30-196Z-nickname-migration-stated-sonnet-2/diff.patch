+
+// YYYY-MM-DD, or the extended form with a sign and six digits for years outside 0000 to 9999.
+const ISO_DATE = /^(\d{4}|[+-]\d{6})-(\d{2})-(\d{2})$/;
+
+/**
+ * Parses a calendar date written as YYYY-MM-DD into a Date at 00:00:00.000 UTC on that day, the inverse of
+ * formatIsoDate: parseIsoDate("2024-05-10") is 2024-05-10T00:00:00.000Z. The year may also be written in the
+ * extended form formatIsoDate produces for years outside 0000 to 9999, a sign and six digits ("+010000-01-01",
+ * "-000001-12-31"); "-000000" is not allowed. The text must be exactly that, with no spaces, no time and no
+ * other layout ("2024-5-1", "2024/05/10" and "2024-05-10T00:00:00Z" are all rejected), and the day must really
+ * exist, following the Gregorian leap-year rules for every year: "2024-02-29" is fine, "2023-02-29",
+ * "2026-02-30", "2024-13-01" and "2024-04-31" are not. The result does not depend on the local time zone.
+ * @param {string} text
+ * @returns {Date}
+ * @throws {TypeError} If text is not a string.
+ * @throws {SyntaxError} If text is not in the YYYY-MM-DD (or extended-year) layout.
+ * @throws {RangeError} If the layout is right but the date does not exist, or is beyond the range of a Date.
+ */
+exports.parseIsoDate = (text) => {
+  if (typeof text !== 'string') throw new TypeError('parseIsoDate: text must be a string');
+  const match = ISO_DATE.exec(text);
+  if (!match || text.startsWith('-000000')) throw new SyntaxError(`parseIsoDate: not a YYYY-MM-DD date: ${JSON.stringify(text)}`);
+  const [year, month, day] = match.slice(1).map(Number);
+  const date = new Date(0); // not Date.UTC, which reads years 0-99 as 1900-1999
+  date.setUTCFullYear(year, month - 1, day);
+  // An impossible day or month does not fail, it rolls over (30 February becomes 2 March), so compare to catch it.
+  if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+    throw new RangeError(`parseIsoDate: no such date: ${text}`);
+  }
+  return date;
+};
+
+/**
+ * A person's age in whole years on a given day: ageOn(new Date("1990-05-10"), new Date("2024-05-09")) is 33, and
+ * 34 the day after. Like the other UTC functions here it compares UTC calendar days and ignores the time of day,
+ * so it does not depend on the local time zone: a birth date and a date on the same UTC day give 0, and a
+ * birthday starts at 00:00 UTC. Someone born on 29 February has their birthday on 1 March in years that have
+ * no 29 February (so born 2000-02-29, they are 0 on 2001-02-28 and 1 on 2001-03-01). Neither Date is changed.
+ * @param {Date} birthDate
+ * @param {Date} date The day to work out the age on; it must not be an earlier UTC day than birthDate.
+ * @returns {number} A whole number of years, 0 or more.
+ * @throws {TypeError} If birthDate or date is not a Date.
+ * @throws {RangeError} If either is an Invalid Date, or date is on an earlier UTC day than birthDate.
+ */
+exports.ageOn = (birthDate, date) => {
+  for (const [name, value] of [['birthDate', birthDate], ['date', date]]) {
+    if (!(value instanceof Date)) throw new TypeError(`ageOn: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`ageOn: ${name} is invalid`);
+  }
+  if (exports.daysBetween(birthDate, date) < 0) throw new RangeError('ageOn: date is before birthDate');
+  const years = date.getUTCFullYear() - birthDate.getUTCFullYear();
+  // Whether this year's birthday has come yet, comparing (month, day); 29 February sorts before 1 March.
+  const birthday = [birthDate.getUTCMonth(), birthDate.getUTCDate()];
+  const today = [date.getUTCMonth(), date.getUTCDate()];
+  const reached = today[0] > birthday[0] || (today[0] === birthday[0] && today[1] >= birthday[1]);
+  return reached ? years : years - 1;
+};
+
+// Units from largest to smallest, in milliseconds. A month is taken as 30 days and a year as 365.
+const RELATIVE_UNITS = [
+  ['year', 365 * MS_PER_DAY],
+  ['month', 30 * MS_PER_DAY],
+  ['day', MS_PER_DAY],
+  ['hour', 3600000],
+  ['minute', 60000],
+  ['second', 1000],
+];
+
+/**
+ * Describes how far date is from now in English, as a person would: "3 minutes ago", "in 2 days", "1 hour ago".
+ * It measures elapsed time, not calendar days, and shows the largest unit that fits, rounded down: 119 seconds is
+ * "1 minute ago", 47 hours is "1 day ago". Units are seconds (from 1 s), minutes, hours, days, months of 30 days
+ * (from 30 days) and years of 365 days (from 365 days), with "1 minute" singular and "2 minutes" plural. A
+ * difference of less than a second either way, including date equal to now, is "just now". Past times read
+ * "N units ago" and future ones "in N units". now defaults to the current time, and neither Date is changed.
+ * @param {Date} date
+ * @param {Date} [now=new Date()]
+ * @returns {string}
+ * @throws {TypeError} If date or now is not a Date.
+ * @throws {RangeError} If date or now is an Invalid Date.
+ */
+exports.relativeTime = (date, now = new Date()) => {
+  for (const [name, value] of [['date', date], ['now', now]]) {
+    if (!(value instanceof Date)) throw new TypeError(`relativeTime: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`relativeTime: ${name} is invalid`);
+  }
+  const difference = date.getTime() - now.getTime(); // negative for the past
+  const elapsed = Math.abs(difference);
+  const unit = RELATIVE_UNITS.find(([, ms]) => elapsed >= ms);
+  if (!unit) return 'just now';
+  const count = Math.floor(elapsed / unit[1]);
+  const phrase = `${count} ${unit[0]}${count === 1 ? '' : 's'}`;
+  return difference < 0 ? `${phrase} ago` : `in ${phrase}`;
+};
