+ * @throws {RangeError} If date is an Invalid Date.
+ */
+exports.formatIsoDate = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('formatIsoDate: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('formatIsoDate: date is invalid');
+  const iso = date.toISOString(); // e.g. 2024-05-10T12:00:00.000Z
+  return iso.slice(0, iso.indexOf('T'));
