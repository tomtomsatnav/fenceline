new file mode 100644
index 0000000..9aabc9b
--- /dev/null
+++ b/README.md
@@ -0,0 +1,43 @@
+# Users API
+
+Functions in `src/api/` for managing users in the in-memory `Db`. Every function takes `db` as its first argument and throws an `Error` if it is missing.
+
+A **user** looks like this:
+
+```js
+{ id, email, fullName, createdAt, lastLogin, nickname } // createdAt / lastLogin are ISO timestamps; lastLogin is null until a login is recorded; nickname is null when not set
+```
+
+Errors are plain `Error`s. "Not found" is reported with `null` or `false`, not an exception.
+
+## `src/api/users.js`
+
+| Function | Description |
+| --- | --- |
+| `createUser(db, { email, fullName, nickname })` | Creates a user with a generated id and the current time as `createdAt`. `nickname` is optional (1–100 characters when given; `null` when not set). Returns the user. Throws if `email` has no `"@"` or is already taken (compared case-insensitively), or if `fullName` is not a non-empty string of at most 100 characters. |
+| `getUser(db, id)` | Returns the user with that id, or `null`. |
+| `getUserByEmail(db, email)` | Returns the user with that email, ignoring case, or `null`. |
+| `listUsers(db, { limit, offset })` | Returns users oldest first. `offset` defaults to 0 and `limit` to no cap, so `listUsers(db)` returns everyone. Throws if either is negative or not an integer. |
+| `searchUsers(db, query)` | Returns users whose `fullName` or `email` contains `query`, ignoring case, oldest first. An empty query matches everyone. |
+| `countUsers(db)` | Returns the number of users. |
+| `updateUser(db, id, { email, fullName })` | Changes only the fields given and returns the updated user, or `null` if there is no such user. The same rules as `createUser` apply; a user may keep their own email. A rejected update changes nothing. |
+| `recordLogin(db, id, when)` | Sets `lastLogin` (`when` is an ISO timestamp, default now). Returns the updated user, or `null` if there is no such user. |
+| `deleteUser(db, id)` | Removes the user. Returns `true`, or `false` if there was no such user. |
+| `insertUser(db, user)` | Inserts a complete user, keeping its `id`, `createdAt` and `lastLogin`. Used for imports. Same checks as `createUser`, plus the id must be unused. |
+
+## `src/api/export.js`
+
+| Function | Description |
+| --- | --- |
+| `exportUsersCsv(db)` | Returns all users as CSV: the header `id,email,fullName,createdAt,lastLogin`, then one row per user, oldest first, lines joined with `\n`. Fields containing a comma, quote or newline are quoted, with embedded quotes doubled. An unset `lastLogin` is an empty field. |
+| `importUsersCsv(db, csv)` | The inverse of `exportUsersCsv`. Inserts each row as a user and returns them. Throws on a wrong header, a row with the wrong number of fields, an unterminated quote, or an invalid or duplicate user. Rows are inserted in order, so an invalid row throws after the rows before it were already imported. |
+
+## `src/api/format.js`
+
+| Function | Description |
+| --- | --- |
+| `displayName(user)` | Returns `user.fullName`, or the part of the email before `"@"` when `fullName` is empty. |
+
+## Tests
+
+`npm test`
diff --git a/src/api/export.js b/src/api/export.js
new file mode 100644
index 0000000..313f019
--- /dev/null
+++ b/src/api/export.js
@@ -0,0 +1,66 @@
+const { insertUser, listUsers } = require('./users.js');
+
+const FIELDS = ['id', 'email', 'fullName', 'createdAt', 'lastLogin'];
+
+// Quotes a field containing a comma, quote or newline; embedded quotes are doubled.
+const csvField = (value) => {
+  const s = value ?? '';
+  return /[",\r\n]/.test(s) ? `"${String(s).replace(/"/g, '""')}"` : String(s);
+};
+
+/**
+ * Exports all users as CSV: a header row plus one row per user, oldest first, lines joined with "\n".
+ * Fields containing a comma, quote or newline are quoted, with embedded quotes doubled.
+ * @param {object} db
+ * @returns {string}
+ * @throws {Error} If db is missing.
+ */
+exports.exportUsersCsv = (db) =>
+  [FIELDS, ...listUsers(db).map((u) => FIELDS.map((f) => u[f]))].map((row) => row.map(csvField).join(',')).join('\n');
+
+// Splits CSV text into rows of fields, undoing csvField's quoting (quoted fields may hold commas, quotes, newlines).
+const parseCsv = (text) => {
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c !== '"') field += c;
+      else if (text[i + 1] === '"') { field += '"'; i++; }
+      else quoted = false;
+    } else if (c === '"') quoted = true;
+    else if (c === ',') { row.push(field); field = ''; }
+    else if (c === '\n' || c === '\r') {
+      if (c === '\r' && text[i + 1] === '\n') i++;
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+    } else field += c;
+  }
+  if (quoted) throw new Error('Invalid CSV: unterminated quote');
+  if (field !== '' || row.length) { row.push(field); rows.push(row); }
+  return rows;
+};
+
+/**
+ * Inverse of exportUsersCsv: inserts each row as a user, keeping its id and timestamps.
+ * Rows are inserted in order, so an invalid row throws after the rows before it were already imported.
+ * @param {object} db
+ * @param {string} csv Text with the header id,email,fullName,createdAt,lastLogin.
+ * @returns {import('./users.js').User[]} The imported users.
+ * @throws {Error} If db is missing, the CSV is malformed, or a row is not a valid new user.
+ */
+exports.importUsersCsv = (db, csv) => {
+  if (!db) throw new Error('importUsersCsv: db is required');
+  const [header, ...rows] = parseCsv(String(csv));
+  if (!header || header.join(',') !== FIELDS.join(',')) throw new Error(`Invalid CSV: header must be ${FIELDS.join(',')}`);
+  return rows.map((fields, i) => {
+    if (fields.length !== FIELDS.length) throw new Error(`Invalid CSV: row ${i + 1} has ${fields.length} fields`);
+    const user = Object.fromEntries(FIELDS.map((f, j) => [f, fields[j]]));
+    if (user.lastLogin === '') delete user.lastLogin;
+    return insertUser(db, user);
+  });
+};
