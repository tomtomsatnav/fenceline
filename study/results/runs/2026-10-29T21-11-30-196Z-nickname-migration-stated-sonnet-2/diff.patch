+test('listUsers paginates with limit and offset', () => {
+  const db = migrate(new Db());
+  for (const n of [3, 1, 4, 2, 5]) {
+    db.insert('users', { id: `${n}`, email: `${n}@example.com`, fullname: `${n}`, created_at: `2024-01-0${n}T00:00:00.000Z` });
+  }
+  const ids = (opts) => listUsers(db, opts).map((u) => u.id);
+  assert.deepStrictEqual(ids(), ['1', '2', '3', '4', '5']);
+  assert.deepStrictEqual(ids({ limit: 2 }), ['1', '2']);
+  assert.deepStrictEqual(ids({ limit: 2, offset: 2 }), ['3', '4']);
+  assert.deepStrictEqual(ids({ offset: 3 }), ['4', '5']);
+  assert.deepStrictEqual(ids({ limit: 2, offset: 4 }), ['5']);
+  assert.deepStrictEqual(ids({ limit: 0 }), []);
+  assert.deepStrictEqual(ids({ offset: 10 }), []);
+});
