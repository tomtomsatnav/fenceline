+// Checks the arguments shared by pick and omit.
+const assertArguments = (name, obj, keys) => {
+  if (typeof obj !== 'object' || obj === null) throw new TypeError(`${name}: obj must be an object`);
+  if (!Array.isArray(keys)) throw new TypeError(`${name}: keys must be an array`);
+  for (const key of keys) {
+    if (typeof key !== 'string' && typeof key !== 'number' && typeof key !== 'symbol') {
+      throw new TypeError(`${name}: each key must be a string, number or symbol`);
+    }
+  }
+};
+
+// defineProperty, not assignment, so that a key like "__proto__" cannot change the object's prototype.
+const setOwn = (target, key, value) => {
+  Object.defineProperty(target, key, { value, writable: true, enumerable: true, configurable: true });
+};
+
+/**
+ * Returns a new object holding only the listed keys of obj: pick({ a: 1, b: 2, c: 3 }, ["a", "c"]) is
+ * { a: 1, c: 3 }. Keys may be strings, numbers (which become strings, as in any property access) or symbols. A key
+ * obj does not have as an own property is left out rather than set to undefined, so inherited properties
+ * (including "toString" and "constructor") are never picked, while an own property whose value is undefined is
+ * kept. Own non-enumerable properties can be picked, and come out as ordinary properties; getters are read and
+ * their value copied. The values are copied as they are, not cloned, so nested objects are shared. Keys come out
+ * in the order the object lists them (integer-like ones first, as always), listing a key twice is harmless, and
+ * a key such as "__proto__" becomes an ordinary own property of the result. obj is not changed.
+ * @param {object} obj
+ * @param {Array<string|number|symbol>} keys
+ * @returns {object} A plain object.
+ * @throws {TypeError} If obj is not an object (null, a string, a number, ... are rejected), keys is not an array
+ *   (a single string is not accepted), or a key is not a string, number or symbol.
+ */
+exports.pick = (obj, keys) => {
+  assertArguments('pick', obj, keys);
+  const picked = {};
+  for (const key of keys) {
+    if (Object.hasOwn(obj, key)) setOwn(picked, key, obj[key]);
+  }
+  return picked;
+};
+
+/**
+ * Returns a new object with everything in obj except the listed keys: omit({ a: 1, b: 2, c: 3 }, ["b"]) is
+ * { a: 1, c: 3 }. It copies obj's own enumerable properties, string and symbol keys alike, like the spread
+ * syntax does, so inherited properties and non-enumerable ones (such as an array's length) are not included, and
+ * getters are read and their values copied (the getters of omitted keys are not called). Keys may be strings,
+ * numbers (which become strings) or symbols, and ones obj does not have, or listed twice, are harmless. The
+ * values are copied as they are, not cloned, so nested objects are shared, and the result is a plain object
+ * whose keys come in obj's order. A key such as "__proto__" that obj owns as data is copied like any other, never
+ * changing the result's prototype. obj is not changed.
+ * @param {object} obj
+ * @param {Array<string|number|symbol>} keys
+ * @returns {object} A plain object.
+ * @throws {TypeError} If obj is not an object (null, a string, a number, ... are rejected), keys is not an array
+ *   (a single string is not accepted), or a key is not a string, number or symbol.
+ */
+exports.omit = (obj, keys) => {
+  assertArguments('omit', obj, keys);
+  const omitted = new Set(keys.map((key) => (typeof key === 'symbol' ? key : String(key)))); // 1 and "1" are the same key
+  const rest = {};
+  const own = [...Object.keys(obj), ...Object.getOwnPropertySymbols(obj).filter((s) => Object.prototype.propertyIsEnumerable.call(obj, s))];
+  for (const key of own) {
+    if (!omitted.has(key)) setOwn(rest, key, obj[key]);
+  }
+  return rest;
+};
+
+// Which kind of value x is, for deepEqual and deepClone; any other kind of value is an error for them.
+const kindOf = (x, name) => {
+  if (x === null) return 'null';
+  if (Array.isArray(x)) return 'array';
+  const type = typeof x;
+  if (type === 'number' || type === 'string' || type === 'boolean' || type === 'undefined') return type;
+  if (type === 'object') {
+    const proto = Object.getPrototypeOf(x);
+    if (proto === Object.prototype || proto === null) return 'object';
+  }
+  throw new TypeError(`${name}: unsupported value, a ${type === 'object' ? 'non-plain object' : type}`);
+};
+
+// The own enumerable keys of a plain object, strings and symbols.
+const ownKeys = (x) => [
+  ...Object.keys(x),
+  ...Object.getOwnPropertySymbols(x).filter((s) => Object.prototype.propertyIsEnumerable.call(x, s)),
+];
+
+/**
+ * Whether a and b are deeply equal: the same numbers, strings, booleans, null and undefined, and plain objects
+ * and arrays that hold deeply equal values under the same keys or indexes. Plain objects are those made by
+ * {}, new Object or Object.create(null); key order does not matter, and own enumerable string and symbol keys
+ * count. Arrays must have the same length and equal items in the same order, holes read as undefined, and
+ * properties other than the indexes are ignored. Numbers are compared like Set values, so NaN equals NaN and 0
+ * equals -0. A value of another kind than the above, such as a function, symbol, bigint, Date, Map, Set,
+ * RegExp, class instance, or boxed primitive, is an error rather than a guess, but only when the comparison
+ * reaches it, since it stops at the first difference. The same object appearing twice (not inside itself) is
+ * fine; a structure that contains itself is an error, even compared with itself. Nesting depth is not limited by
+ * the call stack. Neither argument is changed.
+ * @param {*} a
+ * @param {*} b
+ * @returns {boolean}
+ * @throws {TypeError} If a value of an unsupported kind is compared.
+ * @throws {RangeError} If a or b contains itself.
+ */
+exports.deepEqual = (a, b) => {
+  const ancestorsA = new Set(); // the containers currently being walked on each side, to catch cycles
+  const ancestorsB = new Set();
+  const stack = []; // each frame: two containers being compared, their keys (null for an array), and a position
+  let equal = true;
+
+  // Compares x and y one level: finishes primitives, and for containers checks the shape and pushes a frame.
+  const visit = (x, y) => {
+    const kind = kindOf(x, 'deepEqual');
+    if (kind !== kindOf(y, 'deepEqual')) return false;
+    if (kind === 'number') return x === y || (x !== x && y !== y); // eslint-disable-line no-self-compare
+    if (kind !== 'array' && kind !== 'object') return x === y;
+    if (ancestorsA.has(x) || ancestorsB.has(y)) throw new RangeError('deepEqual: circular structure');
+    let keys = null;
+    let length;
+    if (kind === 'array') {
+      length = x.length;
+      if (length !== y.length) return false;
+    } else {
+      keys = ownKeys(x);
+      length = keys.length;
+      if (length !== ownKeys(y).length || !keys.every((k) => Object.prototype.propertyIsEnumerable.call(y, k))) return false;
+    }
+    ancestorsA.add(x);
+    ancestorsB.add(y);
+    stack.push({ x, y, keys, length, i: 0 });
+    return true;
+  };
+
+  equal = visit(a, b);
+  while (equal && stack.length > 0) {
+    const frame = stack[stack.length - 1];
+    if (frame.i >= frame.length) {
+      ancestorsA.delete(frame.x);
+      ancestorsB.delete(frame.y);
+      stack.pop();
+    } else {
+      const key = frame.keys ? frame.keys[frame.i] : frame.i;
+      frame.i++;
+      equal = visit(frame.x[key], frame.y[key]);
+    }
+  }
+  return equal;
+};
+
+/**
+ * A deep copy of plain objects and arrays: no object or array in the result is shared with value, however deep, so
+ * changing the copy never changes the original. Numbers, strings, booleans, null and undefined are copied as they
+ * are (-0 and NaN included). Plain objects are those made by {}, new Object or Object.create(null), and an object
+ * with no prototype gets a copy with none. Own enumerable string and symbol keys are copied, getters are read and
+ * their values copied, and non-enumerable properties are left out. The copy's properties are all ordinary
+ * writable ones, so a frozen original gives a copy that can be changed. Arrays keep their length and any holes,
+ * and only their indexes are copied, not other properties set on them; an array subclass gives a plain Array.
+ * A reference to the same object or array in several places stays a single shared copy in the result, and
+ * a structure that contains itself is copied too, with the copy containing itself in the same way. Any other kind of value, such as a function,
+ * symbol, bigint, Date, Map, Set, RegExp, class instance, or boxed primitive, is an error rather than a half copy.
+ * Nesting depth is not limited by the call stack. value is not changed.
+ * @template T
+ * @param {T} value
+ * @returns {T}
+ * @throws {TypeError} If value, or anything inside it, is of an unsupported kind.
+ */
+exports.deepClone = (value) => {
+  const clones = new Map(); // original container -> its copy, so shared references and cycles come out the same
+  const stack = []; // containers whose contents still have to be copied: { source, target, keys, i }
+
+  const copy = (x) => {
+    const kind = kindOf(x, 'deepClone');
+    if (kind !== 'array' && kind !== 'object') return x;
+    if (clones.has(x)) return clones.get(x);
+    let target;
+    let keys;
+    if (kind === 'array') {
+      target = new Array(x.length);
+      keys = Object.keys(x).filter((key) => /^(?:0|[1-9]\d*)$/.test(key) && Number(key) < x.length); // indexes, not other properties
+    } else {
+      target = Object.getPrototypeOf(x) === null ? Object.create(null) : {};
+      keys = ownKeys(x);
+    }
+    clones.set(x, target);
+    stack.push({ source: x, target, keys, i: 0 });
+    return target;
+  };
+
+  const result = copy(value);
+  while (stack.length > 0) {
+    const frame = stack[stack.length - 1];
+    if (frame.i >= frame.keys.length) {
+      stack.pop();
+    } else {
+      const key = frame.keys[frame.i++];
+      setOwn(frame.target, key, copy(frame.source[key]));
+    }
+  }
+  return result;
+};
