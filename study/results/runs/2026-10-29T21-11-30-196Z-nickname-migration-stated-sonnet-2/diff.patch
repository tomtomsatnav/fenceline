+// Lowercase words of str: split on any run of characters that are not letters or digits and on case changes
+// (lower-to-upper, and the last capital of an acronym before a lowercase letter).
+const words = (str, name) => {
+  if (typeof str !== 'string') throw new TypeError(`${name}: expected a string`);
+  return str
+    .replace(/(\p{Ll}|\p{N})(\p{Lu})/gu, '$1 $2')
+    .replace(/(\p{Lu}+)(\p{Lu}\p{Ll})/gu, '$1 $2')
+    .split(/[^\p{L}\p{N}]+/u)
+    .filter(Boolean)
+    .map((w) => w.toLowerCase());
+};
+
+/**
+ * Converts text to camelCase. Words are split on any run of characters that are not letters or digits
+ * (spaces, "-", "_", ...) and on lower-to-upper case changes, so "helloWorld" is unchanged and "HELLO WORLD"
+ * becomes "helloWorld". Text with no words gives "".
+ * @param {string} str
+ * @returns {string}
+ * @throws {TypeError} If str is not a string.
+ */
+exports.camelCase = (str) =>
+  words(str, 'camelCase').map((w, i) => (i === 0 ? w : w[0].toUpperCase() + w.slice(1))).join('');
+
+/**
+ * Converts text to kebab-case, splitting words the same way as camelCase: "helloWorld", "Hello World" and
+ * "hello_world" all become "hello-world". Text with no words gives "".
+ * @param {string} str
+ * @returns {string}
+ * @throws {TypeError} If str is not a string.
+ */
+exports.kebabCase = (str) => words(str, 'kebabCase').join('-');
+
+/**
+ * Shortens str to at most n characters (counted as Unicode code points, so emoji are never split). When
+ * anything is cut, the result ends in "…", which counts toward n: truncate("hello world", 8) is "hello w…".
+ * A str that already fits is returned unchanged; n of 0 gives "" and n of 1 gives just "…".
+ * @param {string} str
+ * @param {number} n A non-negative integer, or Infinity.
+ * @returns {string}
+ * @throws {TypeError} If str is not a string.
+ * @throws {RangeError} If n is negative, fractional or not a number.
+ */
+exports.truncate = (str, n) => {
+  if (typeof str !== 'string') throw new TypeError('truncate: expected a string');
+  if (n !== Infinity && (!Number.isInteger(n) || n < 0)) throw new RangeError('truncate: n must be a non-negative integer');
+  const chars = Array.from(str);
+  if (chars.length <= n) return str;
+  return n === 0 ? '' : `${chars.slice(0, n - 1).join('')}…`;
+};
+
+/**
+ * Centres str in a field of width characters (counted as Unicode code points) by padding both sides with ch.
+ * When the padding is odd the extra character goes on the right: padCenter("ab", 5) is " ab  ". A str that is
+ * already width characters or longer is returned unchanged.
+ * @param {string} str
+ * @param {number} width A non-negative integer.
+ * @param {string} [ch=" "] Exactly one character.
+ * @returns {string}
+ * @throws {TypeError} If str or ch is not a string.
+ * @throws {RangeError} If width is not a non-negative integer, or ch is not exactly one character.
+ */
+exports.padCenter = (str, width, ch = ' ') => {
+  if (typeof str !== 'string') throw new TypeError('padCenter: expected a string');
+  if (typeof ch !== 'string') throw new TypeError('padCenter: ch must be a string');
+  if (!Number.isInteger(width) || width < 0) throw new RangeError('padCenter: width must be a non-negative integer');
+  if (Array.from(ch).length !== 1) throw new RangeError('padCenter: ch must be exactly one character');
+  const total = width - Array.from(str).length;
+  if (total <= 0) return str;
+  const left = Math.floor(total / 2);
+  return ch.repeat(left) + str + ch.repeat(total - left);
+};
+
+// Words of str as written: runs of letters, digits and combining marks, split on everything else.
+const tokens = (str) => str.split(/[^\p{L}\p{N}\p{M}]+/u).filter(Boolean);
+
+/**
+ * Counts the words in str. Any run of characters that are not letters, digits or combining marks (whitespace,
+ * punctuation, symbols, "_") separates words, so "don't" is two words and "well-known" is two; case changes do
+ * not, so "helloWorld" is one. Text with no words gives 0.
+ * @param {string} str
+ * @returns {number}
+ * @throws {TypeError} If str is not a string.
+ */
+exports.countWords = (str) => {
+  if (typeof str !== 'string') throw new TypeError('countWords: expected a string');
+  return tokens(str).length;
+};
+
+/**
+ * Upper-case first letters of the words in str, split the same way as countWords: initials("Ada King Lovelace")
+ * is "AKL", and "Mary-Jane O'Brien" gives "MJOB". A digit counts as a first character; the first character is a
+ * whole code point plus any accents that follow it, so a letter outside the basic range or an accented one is never cut. Text with no words gives "".
+ * @param {string} str
+ * @returns {string}
+ * @throws {TypeError} If str is not a string.
+ */
+exports.initials = (str) => {
+  if (typeof str !== 'string') throw new TypeError('initials: expected a string');
+  return tokens(str).map((w) => w.match(/^.\p{M}*/su)[0].toUpperCase()).join('');
+};
+
+/**
+ * Reverses the order of the words in str and joins them with single spaces: reverseWords("one two three") is
+ * "three two one". Here a word is any run of non-whitespace, so punctuation stays attached to its word
+ * ("Hello, world!" becomes "world! Hello,") and leading, trailing and repeated whitespace is dropped. Text
+ * with no words gives "".
+ * @param {string} str
+ * @returns {string}
+ * @throws {TypeError} If str is not a string.
+ */
+exports.reverseWords = (str) => {
+  if (typeof str !== 'string') throw new TypeError('reverseWords: expected a string');
+  return str.split(/\s+/u).filter(Boolean).reverse().join(' ');
+};
+
+/**
+ * True when str reads the same backwards, looking only at letters and digits and ignoring case:
+ * "A man, a plan, a canal: Panama" is a palindrome. Accented letters are compared in composed form, so
+ * "é" written with a separate accent matches a plain "é". Text with no letters or digits (including "")
+ * reads the same backwards trivially, so it is a palindrome.
+ * @param {string} str
+ * @returns {boolean}
+ * @throws {TypeError} If str is not a string.
+ */
+exports.isPalindrome = (str) => {
+  if (typeof str !== 'string') throw new TypeError('isPalindrome: expected a string');
+  const chars = Array.from(str.normalize('NFC').replace(/[^\p{L}\p{N}]+/gu, '').toLowerCase());
+  return chars.every((c, i) => c === chars[chars.length - 1 - i]);
+};
+
+/**
+ * Wraps text so no line is longer than width characters (counted as Unicode code points), breaking only
+ * between words. A word is a run of non-whitespace, so punctuation stays attached to its word. Lines are
+ * filled greedily and joined with "\n"; spaces between words become single spaces and leading and trailing
+ * spaces are dropped. Existing line breaks are kept, so each line of text is wrapped on its own and blank
+ * lines survive. A word longer than width is never split: it gets a line to itself and that line is too long.
+ * @param {string} text
+ * @param {number} width A positive integer, or Infinity (no wrapping).
+ * @returns {string}
+ * @throws {TypeError} If text is not a string.
+ * @throws {RangeError} If width is not a positive integer or Infinity.
+ */
+exports.wrap = (text, width) => {
+  if (typeof text !== 'string') throw new TypeError('wrap: expected a string');
+  if (width !== Infinity && (!Number.isInteger(width) || width < 1)) throw new RangeError('wrap: width must be a positive integer');
+  return text
+    .split(/\r\n|\r|\n/)
+    .flatMap((line) => {
+      const lines = [];
+      let current = '';
+      let length = 0;
+      for (const word of line.split(/\s+/u).filter(Boolean)) {
+        const wordLength = Array.from(word).length;
+        if (length > 0 && length + 1 + wordLength <= width) {
+          current += ` ${word}`;
+          length += 1 + wordLength;
+        } else {
+          if (length > 0) lines.push(current);
+          current = word;
+          length = wordLength;
+        }
+      }
+      lines.push(current);
+      return lines;
+    })
+    .join('\n');
+};
+
+/**
+ * Fills {placeholders} in str from values: template("Hi {name}", { name: "Ada" }) is "Hi Ada". A placeholder is
+ * a name of letters, digits and "_" in braces, with nothing else inside, so "{ name }" and "{}" are plain text.
+ * Placeholders with no value are left as they are; a value of null or undefined counts as no value. Other
+ * values are converted with String(), so 0 and false are filled in. Only the object's own properties are
+ * used ("{toString}" stays as written) and filled-in values are inserted as they are, never expanded again.
+ * @param {string} str
+ * @param {object} [values={}]
+ * @returns {string}
+ * @throws {TypeError} If str is not a string, or values is not an object.
+ */
+exports.template = (str, values = {}) => {
+  if (typeof str !== 'string') throw new TypeError('template: expected a string');
+  if (typeof values !== 'object' || values === null) throw new TypeError('template: values must be an object');
+  return str.replace(/\{(\w+)\}/g, (placeholder, key) => {
+    const value = Object.hasOwn(values, key) ? values[key] : undefined;
+    return value === undefined || value === null ? placeholder : String(value);
+  });
+};
diff --git a/test/export.test.js b/test/export.test.js
new file mode 100644
index 0000000..a9c33cb
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,70 @@
+const test = require('node:test');
+const assert = require('node:assert');
+const { Db } = require('../src/db.js');
+const { migrate } = require('../src/migrate.js');
+const { exportUsersCsv, importUsersCsv } = require('../src/api/export.js');
+const { listUsers } = require('../src/api/users.js');
+
+const HEADER = 'id,email,fullName,createdAt,lastLogin';
+const insert = (db, id, email, fullname, created_at, last_login) =>
+  db.insert('users', { id, email, fullname, created_at, ...(last_login && { last_login }) });
+
+test('exportUsersCsv returns only the header when there are no users', () => {
+  assert.strictEqual(exportUsersCsv(migrate(new Db())), HEADER);
+});
+
+test('exportUsersCsv writes one row per user, oldest first, with empty lastLogin', () => {
+  const db = migrate(new Db());
+  insert(db, '2', 'grace@example.com', 'Grace Hopper', '2024-02-01T00:00:00.000Z', '2024-03-01T00:00:00.000Z');
+  insert(db, '1', 'ada@example.com', 'Ada Lovelace', '2024-01-01T00:00:00.000Z');
+  assert.strictEqual(exportUsersCsv(db), [
+    HEADER,
+    '1,ada@example.com,Ada Lovelace,2024-01-01T00:00:00.000Z,',
+    '2,grace@example.com,Grace Hopper,2024-02-01T00:00:00.000Z,2024-03-01T00:00:00.000Z',
+  ].join('\n'));
+});
+
+test('exportUsersCsv quotes fields containing commas or quotes', () => {
+  const db = migrate(new Db());
+  insert(db, '1', 'a@example.com', 'Lovelace, Ada', '2024-01-01T00:00:00.000Z');
+  insert(db, '2', 'b@example.com', 'Bob "Bobby" Smith', '2024-01-02T00:00:00.000Z');
+  const lines = exportUsersCsv(db).split('\n');
+  assert.strictEqual(lines[1], '1,a@example.com,"Lovelace, Ada",2024-01-01T00:00:00.000Z,');
+  assert.strictEqual(lines[2], '2,b@example.com,"Bob ""Bobby"" Smith",2024-01-02T00:00:00.000Z,');
+});
+
+test('exportUsersCsv throws when db is missing', () => {
+  assert.throws(() => exportUsersCsv(undefined), Error);
+});
+
+test('importUsersCsv round-trips exportUsersCsv, including quoted fields', () => {
+  const src = migrate(new Db());
+  insert(src, '1', 'a@example.com', 'Lovelace, Ada', '2024-01-01T00:00:00.000Z');
+  insert(src, '2', 'b@example.com', 'Bob "Bobby" Smith', '2024-01-02T00:00:00.000Z', '2024-03-01T00:00:00.000Z');
+  insert(src, '3', 'c@example.com', 'Multi\nLine', '2024-01-03T00:00:00.000Z');
+  const csv = exportUsersCsv(src);
+
+  const dst = migrate(new Db());
+  const imported = importUsersCsv(dst, csv);
+  assert.strictEqual(imported.length, 3);
+  assert.deepStrictEqual(listUsers(dst), listUsers(src));
+  assert.strictEqual(exportUsersCsv(dst), csv);
+});
+
+test('importUsersCsv accepts an empty export and CRLF line endings', () => {
+  const db = migrate(new Db());
+  assert.deepStrictEqual(importUsersCsv(db, HEADER), []);
+  importUsersCsv(db, `${HEADER}\r\n1,a@example.com,Ada,2024-01-01T00:00:00.000Z,\r\n`);
+  assert.strictEqual(listUsers(db).length, 1);
+});
+
+test('importUsersCsv rejects a bad header, bad row or duplicate', () => {
+  const db = migrate(new Db());
+  assert.throws(() => importUsersCsv(db, 'id,email\n1,a@example.com'), Error);
+  assert.throws(() => importUsersCsv(db, `${HEADER}\n1,a@example.com`), Error);
+  assert.throws(() => importUsersCsv(db, `${HEADER}\n1,nope,Ada,2024-01-01T00:00:00.000Z,`), Error);
+  assert.throws(() => importUsersCsv(db, `${HEADER}\n1,a@example.com,"Ada,2024-01-01T00:00:00.000Z,`), Error);
+  const row = '1,a@example.com,Ada,2024-01-01T00:00:00.000Z,';
+  assert.throws(() => importUsersCsv(db, `${HEADER}\n${row}\n${row}`), Error);
+  assert.throws(() => importUsersCsv(undefined, HEADER), Error);
+});
