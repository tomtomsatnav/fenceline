+ * sum too big for a double is avoided, so mean([Number.MAX_VALUE, Number.MAX_VALUE]) is Number.MAX_VALUE (when that rescaling is needed, the
+ * result can be off by one unit in the last place). NaN
+ * and infinite values behave as in plain arithmetic: any NaN gives NaN, [Infinity, 1] gives Infinity and
+ * [Infinity, -Infinity] gives NaN. xs is not changed.
+ * @param {number[]} xs
+ * @returns {number}
+ * @throws {TypeError} If xs is not an array or an item is not a number (holes in a sparse array count as undefined).
+ */
+exports.mean = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('mean: expected an array');
+  const values = Array.from(xs);
+  values.forEach((v, i) => {
+    if (typeof v !== 'number') throw new TypeError(`mean: item ${i} is not a number`);
+  });
+  if (values.length === 0) return NaN;
+  if (!values.every(Number.isFinite)) return values.reduce((a, b) => a + b, 0) / values.length;
+  const sum = compensatedSum(values);
+  if (Number.isFinite(sum)) return sum / values.length;
+  // The sum overflowed. Scale every value down by a power of two at least n, which is exact and keeps the sum
+  // within range, average that, then scale back up (also exact).
+  let scale = 1;
+  while (scale < values.length) scale *= 2;
+  return (compensatedSum(values.map((v) => v / scale)) / values.length) * scale;
+};
+
+/**
+ * The median of an array of numbers: the middle value once sorted, or the mean of the two middle values when
+ * there is an even number of them. median([3, 1, 2]) is 2 and median([4, 1, 3, 2]) is 2.5. An empty array gives
+ * NaN, and so does any array containing NaN, because it cannot be put in order. Infinite values sort at the
+ * ends like any other numbers: median([-Infinity, 1, 2]) is 1, and averaging two middles that are
+ * -Infinity and Infinity gives NaN. Averaging two huge middle values does not overflow. xs is not changed.
+ * @param {number[]} xs
+ * @returns {number}
+ * @throws {TypeError} If xs is not an array or an item is not a number (holes in a sparse array count as undefined).
+ */
+exports.median = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('median: expected an array');
+  const values = Array.from(xs);
+  values.forEach((v, i) => {
+    if (typeof v !== 'number') throw new TypeError(`median: item ${i} is not a number`);
+  });
+  if (values.length === 0 || values.some(Number.isNaN)) return NaN;
+  values.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0)); // a - b would give NaN for two equal infinities
+  const mid = values.length >> 1;
+  if (values.length % 2 === 1) return values[mid];
+  const [lo, hi] = [values[mid - 1], values[mid]];
+  const sum = lo + hi;
+  if (Number.isFinite(lo) && Number.isFinite(hi) && !Number.isFinite(sum)) return lo / 2 + hi / 2; // sum overflowed
+  return sum / 2;
+};
+
+/**
+ * The p-th percentile of an array of numbers by linear interpolation between the closest ranks, the method
+ * of Excel's PERCENTILE.INC and NumPy's default: with the values sorted, p = 0 is the smallest, p = 100 the
+ * largest and p = 50 the median, and in between the result is interpolated between the two neighbouring values
+ * (percentile([1, 2, 3, 4], 25) is 1.75). It is always between the smallest and largest value, and with one value it
+ * is that value. An empty array gives NaN, and so does any array containing NaN. Infinite values behave as in
+ * median: they sort to the ends, and interpolating between -Infinity and Infinity gives NaN. Interpolating
+ * between huge values does not overflow. xs is not changed.
+ * @param {number[]} xs
+ * @param {number} p From 0 to 100, both included.
+ * @returns {number}
+ * @throws {TypeError} If xs is not an array, an item is not a number (holes in a sparse array count as
+ *   undefined), or p is not a number.
+ * @throws {RangeError} If p is NaN or outside 0 to 100.
+ */
+exports.percentile = (xs, p) => {
+  if (!Array.isArray(xs)) throw new TypeError('percentile: expected an array');
+  if (typeof p !== 'number') throw new TypeError('percentile: p must be a number');
+  if (!(p >= 0 && p <= 100)) throw new RangeError('percentile: p must be from 0 to 100');
+  const values = Array.from(xs);
+  values.forEach((v, i) => {
+    if (typeof v !== 'number') throw new TypeError(`percentile: item ${i} is not a number`);
+  });
+  if (values.length === 0 || values.some(Number.isNaN)) return NaN;
+  values.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+  const rank = Math.min((p * (values.length - 1)) / 100, values.length - 1); // multiply first: 30 * 10 / 100 is exact, 0.3 * 10 may not be
+  const [lo, hi] = [values[Math.floor(rank)], values[Math.ceil(rank)]];
+  const fraction = rank - Math.floor(rank);
+  if (fraction === 0 || lo === hi) return lo;
+  const gap = hi - lo;
+  return Number.isFinite(gap) ? lo + gap * fraction : lo * (1 - fraction) + hi * fraction; // the second form copes with infinities and a gap that overflows
+};
+
+const BYTE_UNITS = ['B', 'KB', 'MB', 'GB', 'TB'];
+
+/**
+ * Formats a number of bytes with the largest fitting unit, using 1024 per step: formatBytes(1536) is "1.5 KB".
+ * Units are B, KB, MB, GB and TB. The number is rounded to one decimal place (halves away from zero, see
+ * roundTo) and a trailing ".0" is dropped, so 1024 is "1 KB", and a value that rounds up to the next unit is
+ * shown in that unit: formatBytes(1048575) is "1 MB", not "1024 KB". Negative values (such as a size change)
+ * keep their sign, except when they round to zero: formatBytes(-0.01) is "0 B". There is no unit above TB, so
+ * larger values stay in TB (formatBytes(2 ** 50) is "1024 TB") and astronomically large ones print in
+ * JavaScript's exponent notation.
+ * @param {number} bytes
+ * @returns {string}
+ * @throws {TypeError} If bytes is not a number.
+ * @throws {RangeError} If bytes is NaN or infinite.
+ */
+exports.formatBytes = (bytes) => {
+  if (typeof bytes !== 'number') throw new TypeError('formatBytes: bytes must be a number');
+  if (!Number.isFinite(bytes)) throw new RangeError('formatBytes: bytes must be finite');
+  const last = BYTE_UNITS.length - 1;
+  let value = Math.abs(bytes);
+  let unit = 0;
+  while (value >= 1024 && unit < last) {
+    value /= 1024;
+    unit++;
+  }
+  let rounded = exports.roundTo(value, 1);
+  if (rounded >= 1024 && unit < last) { // e.g. 1023.96 KB rounds to 1024: show it as 1 MB
+    rounded = exports.roundTo(value / 1024, 1);
+    unit++;
+  }
+  return `${bytes < 0 && rounded !== 0 ? '-' : ''}${rounded} ${BYTE_UNITS[unit]}`;
+};
+
+/**
+ * True when n is a prime number: an integer greater than 1 whose only divisors are 1 and itself. Anything else
+ * is false, not an error: 0, 1, negative numbers, fractions, NaN and the infinities. Every number above
+ * Number.MAX_SAFE_INTEGER (2 ** 53 - 1) is an even integer in floating point, so it is false without any
+ * work; the largest prime that can be found is therefore 2 ** 53 - 111. Checking numbers near that limit takes
+ * about a tenth of a second, as the divisors are tried up to the square root.
+ * @param {number} n
+ * @returns {boolean}
+ * @throws {TypeError} If n is not a number.
+ */
+exports.isPrime = (n) => {
+  if (typeof n !== 'number') throw new TypeError('isPrime: n must be a number');
+  if (!Number.isInteger(n) || n < 2 || n > Number.MAX_SAFE_INTEGER) return false;
+  if (n < 4) return true; // 2 and 3
+  if (n % 2 === 0 || n % 3 === 0) return false;
+  for (let i = 5; i * i <= n; i += 6) { // every prime above 3 is 6k - 1 or 6k + 1
+    if (n % i === 0 || n % (i + 2) === 0) return false;
+  }
+  return true;
+};
+
+/**
+ * The greatest common divisor of two integers: the largest positive integer that divides both, so gcd(12, 18) is
+ * 6. The signs are ignored (gcd(-12, 18) is 6), anything divides 0 so gcd(n, 0) is the size of n, and by the usual
+ * convention gcd(0, 0) is 0. The result is never negative and never -0. Works for any finite integers, even
+ * beyond Number.MAX_SAFE_INTEGER, where the remainders are still exact.
+ * @param {number} a
+ * @param {number} b
+ * @returns {number}
+ * @throws {TypeError} If a or b is not a number.
+ * @throws {RangeError} If a or b is not an integer (a fraction, NaN or an infinity).
+ */
+exports.gcd = (a, b) => {
+  for (const [name, value] of [['a', a], ['b', b]]) {
+    if (typeof value !== 'number') throw new TypeError(`gcd: ${name} must be a number`);
+    if (!Number.isInteger(value)) throw new RangeError(`gcd: ${name} must be an integer`);
+  }
+  let [x, y] = [Math.abs(a), Math.abs(b)];
+  while (y !== 0) [x, y] = [y, x % y];
+  return x;
+};
+
+const ROMAN_NUMERALS = [
+  [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'], [100, 'C'], [90, 'XC'],
+  [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
+];
+
+/**
+ * Converts an integer from 1 to 3999 to a Roman numeral in the standard subtractive form: toRoman(4) is "IV",
+ * toRoman(1994) is "MCMXCIV" and toRoman(3999) is "MMMCMXCIX". Roman numerals have no zero, no negatives and no
+ * standard form above 3999, so those throw rather than guess.
+ * @param {number} n An integer from 1 to 3999.
+ * @returns {string}
+ * @throws {TypeError} If n is not a number.
+ * @throws {RangeError} If n is not an integer (a fraction, NaN or an infinity) or is outside 1 to 3999.
+ */
+exports.toRoman = (n) => {
+  if (typeof n !== 'number') throw new TypeError('toRoman: n must be a number');
+  if (!Number.isInteger(n)) throw new RangeError('toRoman: n must be an integer');
+  if (n < 1 || n > 3999) throw new RangeError('toRoman: n must be from 1 to 3999');
+  let rest = n;
+  let roman = '';
+  for (const [value, symbol] of ROMAN_NUMERALS) {
+    roman += symbol.repeat(Math.floor(rest / value));
+    rest %= value;
+  }
+  return roman;
+};
+
+// Exactly the numerals toRoman produces: thousands, hundreds, tens and units, each in its standard form.
+const ROMAN_FORM = /^M{0,3}(CM|CD|D?C{0,3})(XC|XL|L?X{0,3})(IX|IV|V?I{0,3})$/;
+
+/**
+ * Converts a Roman numeral to a number, the inverse of toRoman: fromRoman("MCMXCIV") is 1994. Only the standard
+ * form from "I" (1) to "MMMCMXCIX" (3999) is accepted, in capital letters, so fromRoman(toRoman(n)) is n and
+ * toRoman(fromRoman(s)) is s for every valid s. Everything else throws instead of being guessed at: the empty
+ * string, lowercase ("xiv"), spaces, other letters, a symbol repeated too often ("IIII", "MMMM"), non-standard
+ * subtractions ("IC", "VX", "IL", "XM") and symbols in the wrong order ("IIV").
+ * @param {string} roman
+ * @returns {number} An integer from 1 to 3999.
+ * @throws {TypeError} If roman is not a string.
+ * @throws {SyntaxError} If roman is not a valid Roman numeral in standard form.
+ */
+exports.fromRoman = (roman) => {
+  if (typeof roman !== 'string') throw new TypeError('fromRoman: roman must be a string');
+  if (roman === '' || !ROMAN_FORM.test(roman)) throw new SyntaxError(`fromRoman: not a valid Roman numeral: ${JSON.stringify(roman)}`);
+  let rest = roman;
+  let n = 0;
+  for (const [value, symbol] of ROMAN_NUMERALS) {
+    while (rest.startsWith(symbol)) {
+      n += value;
+      rest = rest.slice(symbol.length);
+    }
+  }
+  return n;
+};
