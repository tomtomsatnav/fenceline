+/**
+ * Limits x to the range from lo to hi, both included: clamp(15, 0, 10) is 10, clamp(-5, 0, 10) is 0, and a
+ * value already in range is returned as it is. lo and hi may be infinite (clamp(x, 0, Infinity) only sets a
+ * floor) and may be equal. A NaN x gives NaN, like Math.min and Math.max; a NaN or reversed range is an error,
+ * rather than a guess at what was meant.
+ * @param {number} x
+ * @param {number} lo
+ * @param {number} hi Not less than lo.
+ * @returns {number}
+ * @throws {TypeError} If x, lo or hi is not a number.
+ * @throws {RangeError} If lo or hi is NaN, or lo is greater than hi.
+ */
+exports.clamp = (x, lo, hi) => {
+  for (const [name, value] of [['x', x], ['lo', lo], ['hi', hi]]) {
+    if (typeof value !== 'number') throw new TypeError(`clamp: ${name} must be a number`);
+  }
+  if (Number.isNaN(lo) || Number.isNaN(hi)) throw new RangeError('clamp: lo and hi must not be NaN');
+  if (lo > hi) throw new RangeError('clamp: lo must not be greater than hi');
+  if (x < lo) return lo;
+  return x > hi ? hi : x;
+};
+
+// n with its decimal point moved k places right (left when k is negative), going through the decimal text so
+// the result is exact for the digits shown; String() may use exponent notation, which is split off and adjusted.
+const shiftDecimal = (n, k) => {
+  const [mantissa, exponent = '0'] = String(n).split('e');
+  return Number(`${mantissa}e${Number(exponent) + k}`);
+};
+
+/**
+ * Rounds x to the given number of decimal places, with halves going away from zero: roundTo(2.5, 0) is 3,
+ * roundTo(-2.5, 0) is -3 and roundTo(1.005, 2) is 1.01. The rounding works on the decimal digits JavaScript
+ * shows for x (its shortest round-trip form), not on the binary value behind them, so 1.005 rounds the way it
+ * reads even though the nearest double is slightly below it; the plain Math.round(x * 100) / 100 gives 1 there.
+ * places defaults to 0 and may be negative to round to tens, hundreds, ...: roundTo(1250, -2) is 1300. NaN and
+ * the infinities come back as they are, and so does any x too large for places to affect it. The result is
+ * never -0: roundTo(-0.001, 2) is 0.
+ * @param {number} x
+ * @param {number} [places=0] An integer.
+ * @returns {number}
+ * @throws {TypeError} If x or places is not a number.
+ * @throws {RangeError} If places is not an integer.
+ */
+exports.roundTo = (x, places = 0) => {
+  if (typeof x !== 'number') throw new TypeError('roundTo: x must be a number');
+  if (typeof places !== 'number') throw new TypeError('roundTo: places must be a number');
+  if (!Number.isInteger(places)) throw new RangeError('roundTo: places must be an integer');
+  if (!Number.isFinite(x)) return x;
+  const shifted = shiftDecimal(Math.abs(x), places);
+  if (!Number.isFinite(shifted)) return x; // x is so large that places digits cannot change it
+  const rounded = shiftDecimal(Math.round(shifted), -places); // Math.round sends halves up, i.e. away from zero for |x|
+  return rounded === 0 ? 0 : Math.sign(x) * rounded;
+};
