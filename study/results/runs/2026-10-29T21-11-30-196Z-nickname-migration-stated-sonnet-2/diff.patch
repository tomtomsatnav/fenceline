+/**
+ * Splits xs into consecutive arrays of n elements; the last one is shorter when n does not divide the length.
+ * chunk([1, 2, 3, 4, 5], 2) is [[1, 2], [3, 4], [5]]. An empty array gives []. The elements are not copied
+ * deeply and xs itself is not changed. Holes in a sparse array come through as undefined.
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n A positive integer, or Infinity (everything in one chunk).
+ * @returns {T[][]}
+ * @throws {TypeError} If xs is not an array.
+ * @throws {RangeError} If n is not a positive integer or Infinity.
+ */
+exports.chunk = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('chunk: expected an array');
+  if (n !== Infinity && (!Number.isInteger(n) || n < 1)) throw new RangeError('chunk: n must be a positive integer');
+  const chunks = [];
+  for (let i = 0; i < xs.length; i += n) chunks.push(Array.from(xs.slice(i, i + n)));
+  return chunks;
+};
+
+/**
+ * Keeps the first item for each key, in the original order: uniqueBy(users, (u) => u.email) drops later users
+ * with an email already seen. Keys are compared like Set values (SameValueZero), so NaN matches NaN, 0 matches
+ * -0, and objects match only the same object. Returns a new array; xs is not changed. Holes in a sparse array
+ * are treated as undefined items.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => *} keyFn Called once per item, in order.
+ * @returns {T[]}
+ * @throws {TypeError} If xs is not an array or keyFn is not a function.
+ */
+exports.uniqueBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('uniqueBy: expected an array');
+  if (typeof keyFn !== 'function') throw new TypeError('uniqueBy: keyFn must be a function');
+  const seen = new Set();
+  const out = [];
+  for (let i = 0; i < xs.length; i++) {
+    const key = keyFn(xs[i], i);
+    if (!seen.has(key)) {
+      seen.add(key);
+      out.push(xs[i]);
+    }
+  }
+  return out;
+};
+
+/**
+ * Groups the items of xs by key: groupBy([1, 2, 3, 4], (n) => n % 2 ? "odd" : "even") is
+ * { odd: [1, 3], even: [2, 4] }. Items keep their original order within each group. Keys become property
+ * names, so they are converted to strings (1 and "1" share a group, an object key becomes "[object Object]")
+ * unless they are symbols; as with any object, integer-like keys are listed first, in numeric order. Keys such
+ * as "__proto__" and "constructor" are ordinary keys. An empty array gives {}. Returns a new object with new
+ * arrays; xs is not changed. Holes in a sparse array are treated as undefined items.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => (string|number|symbol)} keyFn Called once per item, in order.
+ * @returns {Object<string, T[]>}
+ * @throws {TypeError} If xs is not an array or keyFn is not a function.
+ */
+exports.groupBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('groupBy: expected an array');
+  if (typeof keyFn !== 'function') throw new TypeError('groupBy: keyFn must be a function');
+  const groups = {};
+  for (let i = 0; i < xs.length; i++) {
+    const key = keyFn(xs[i], i);
+    if (Object.hasOwn(groups, key)) groups[key].push(xs[i]);
+    else Object.defineProperty(groups, key, { value: [xs[i]], writable: true, enumerable: true, configurable: true });
+  }
+  return groups;
+};
+
+/**
+ * Splits xs in two by a predicate: partition([1, 2, 3, 4], (n) => n % 2 === 0) is [[2, 4], [1, 3]]. An item
+ * matches when pred returns a truthy value. Both arrays keep the original order and are always returned, empty
+ * if nothing falls in them. Returns new arrays holding the same items; xs is not changed. Holes in a sparse
+ * array are treated as undefined items.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => *} pred Called once per item, in order.
+ * @returns {[T[], T[]]} The matching items, then the rest.
+ * @throws {TypeError} If xs is not an array or pred is not a function.
+ */
+exports.partition = (xs, pred) => {
+  if (!Array.isArray(xs)) throw new TypeError('partition: expected an array');
+  if (typeof pred !== 'function') throw new TypeError('partition: pred must be a function');
+  const matching = [];
+  const notMatching = [];
+  for (let i = 0; i < xs.length; i++) (pred(xs[i], i) ? matching : notMatching).push(xs[i]);
+  return [matching, notMatching];
+};
+
+/**
+ * Pairs up the items of a and b by position, stopping at the shorter array: zip([1, 2, 3], ["a", "b"]) is
+ * [[1, "a"], [2, "b"]]. If either array is empty the result is []. Returns new pairs holding the same items;
+ * a and b are not changed. Holes in a sparse array are treated as undefined items.
+ * @template A, B
+ * @param {A[]} a
+ * @param {B[]} b
+ * @returns {[A, B][]}
+ * @throws {TypeError} If a or b is not an array.
+ */
+exports.zip = (a, b) => {
+  if (!Array.isArray(a) || !Array.isArray(b)) throw new TypeError('zip: expected two arrays');
+  const pairs = [];
+  for (let i = 0; i < Math.min(a.length, b.length); i++) pairs.push([a[i], b[i]]);
+  return pairs;
+};
+
+/**
+ * The numbers from start up to but not including end, stepping by step: range(0, 5) is [0, 1, 2, 3, 4] and
+ * range(5, 0, -2) is [5, 3, 1]. A step that points away from end (or start equal to end) gives []. Each value
+ * is computed as start + i * step rather than by repeated addition, so fractional steps do not drift, but they
+ * can still show ordinary floating-point noise: range(0, 0.4, 0.1) ends in 0.30000000000000004.
+ * @param {number} start
+ * @param {number} end Not included.
+ * @param {number} [step=1] Positive to count up, negative to count down; not 0.
+ * @returns {number[]}
+ * @throws {TypeError} If start, end or step is not a number.
+ * @throws {RangeError} If an argument is NaN or infinite, step is 0, or the result would not fit in an array.
+ */
+exports.range = (start, end, step = 1) => {
+  for (const [name, value] of [['start', start], ['end', end], ['step', step]]) {
+    if (typeof value !== 'number') throw new TypeError(`range: ${name} must be a number`);
+    if (!Number.isFinite(value)) throw new RangeError(`range: ${name} must be finite`);
+  }
+  if (step === 0) throw new RangeError('range: step must not be 0');
+  const count = Math.ceil((end - start) / step);
+  if (!(count > 0)) return [];
+  if (count > 2 ** 32 - 1) throw new RangeError('range: too many values');
+  return Array.from({ length: count }, (_, i) => start + i * step);
+};
+
+/**
+ * Flattens arrays nested to any depth into one new array, in order: flattenDeep([1, [2, [3, [4]], 5]]) is
+ * [1, 2, 3, 4, 5]. Only real arrays are opened; strings, array-like objects and everything else are kept as
+ * items. Empty nested arrays disappear. The same array may appear in several places and is flattened each
+ * time, but an array that contains itself (directly or through others) throws. Nesting depth is not limited by
+ * the call stack. xs is not changed. Holes in a sparse array are treated as undefined items.
+ * @param {Array} xs
+ * @returns {Array}
+ * @throws {TypeError} If xs is not an array.
+ * @throws {RangeError} If an array contains itself.
+ */
+exports.flattenDeep = (xs) => {
+  if (!Array.isArray(xs)) throw new TypeError('flattenDeep: expected an array');
+  const out = [];
+  const path = new Set([xs]); // the arrays currently being walked, to catch cycles
+  const stack = [{ arr: xs, i: 0 }];
+  while (stack.length > 0) {
+    const frame = stack[stack.length - 1];
+    if (frame.i >= frame.arr.length) {
+      path.delete(frame.arr);
+      stack.pop();
+      continue;
+    }
+    const item = frame.arr[frame.i++];
+    if (!Array.isArray(item)) out.push(item);
+    else if (path.has(item)) throw new RangeError('flattenDeep: circular array');
+    else {
+      path.add(item);
+      stack.push({ arr: item, i: 0 });
+    }
+  }
+  return out;
+};
+
+// Sort position of a key's kind: numbers, bigints and valid Dates sort together, then strings, then booleans,
+// then anything else (null, objects, ...), and NaN, undefined and invalid Dates come last.
+const keyRank = (key) => {
+  if (key instanceof Date) return Number.isNaN(+key) ? 4 : 0;
+  switch (typeof key) {
+    case 'number': return Number.isNaN(key) ? 4 : 0;
+    case 'bigint': return 0;
+    case 'string': return 1;
+    case 'boolean': return 2;
+    case 'undefined': return 4;
+    default: return 3;
+  }
+};
+
+// Orders two keys of the same rank; keys of kinds that are not comparable (rank 3) tie.
+const compareKeys = (a, b) => {
+  const ra = keyRank(a);
+  const rb = keyRank(b);
+  if (ra !== rb) return ra - rb;
+  if (ra === 3 || ra === 4) return 0;
+  const [x, y] = ra === 0 ? [a instanceof Date ? +a : a, b instanceof Date ? +b : b] : [a, b];
+  if (x < y) return -1;
+  return x > y ? 1 : 0;
+};
+
+/**
+ * Returns a new array with the items of xs ordered by keyFn(item), smallest first: sortBy(users, (u) => u.name).
+ * The sort is stable, so items with equal keys stay in their original order, and xs is not changed. keyFn is
+ * called once per item, in order. Keys are ordered by kind: numbers, bigints and valid Dates (by value, together),
+ * then strings (by UTF-16 code unit, not by locale), then booleans (false first), then all other keys (null,
+ * objects, ...) which tie with each other, then NaN, undefined and invalid Dates last, tied with each other.
+ * Holes in a sparse array are treated as undefined items.
+ * @template T
+ * @param {T[]} xs
+ * @param {(item: T, index: number) => *} keyFn
+ * @returns {T[]}
+ * @throws {TypeError} If xs is not an array or keyFn is not a function.
+ */
+exports.sortBy = (xs, keyFn) => {
+  if (!Array.isArray(xs)) throw new TypeError('sortBy: expected an array');
+  if (typeof keyFn !== 'function') throw new TypeError('sortBy: keyFn must be a function');
+  const entries = Array.from(xs, (item, index) => ({ item, index, key: keyFn(item, index) }));
+  entries.sort((a, b) => compareKeys(a.key, b.key) || a.index - b.index);
+  return entries.map((e) => e.item);
+};
+
+/**
+ * Picks one item of xs at random, each equally likely: sample(["a", "b", "c"]). Returns undefined for an empty
+ * array, without calling rng. Pass your own rng (a function returning a number from 0 up to but not including 1,
+ * like Math.random) to get repeatable picks, e.g. in tests: item i of n is picked when rng() is in
+ * [i / n, (i + 1) / n). rng is called exactly once for a non-empty array. xs is not changed. Holes in a sparse
+ * array are treated as undefined items.
+ * @template T
+ * @param {T[]} xs
+ * @param {() => number} [rng=Math.random]
+ * @returns {T|undefined}
+ * @throws {TypeError} If xs is not an array or rng is not a function.
+ * @throws {RangeError} If rng returns anything but a number from 0 up to but not including 1.
+ */
+exports.sample = (xs, rng = Math.random) => {
+  if (!Array.isArray(xs)) throw new TypeError('sample: expected an array');
+  if (typeof rng !== 'function') throw new TypeError('sample: rng must be a function');
+  if (xs.length === 0) return undefined;
+  const r = rng();
+  if (typeof r !== 'number' || !(r >= 0 && r < 1)) throw new RangeError('sample: rng must return a number from 0 up to but not including 1');
+  return xs[Math.floor(r * xs.length)];
+};
+
+/**
+ * Every run of n consecutive items of xs, sliding one item at a time: windowed([1, 2, 3, 4], 2) is
+ * [[1, 2], [2, 3], [3, 4]]. There are xs.length - n + 1 windows, so an array shorter than n (including an empty
+ * one) gives []. Each window is a new array, and a window of 1 gives one single-item array per item. xs is not
+ * changed. Holes in a sparse array are treated as undefined items.
+ * @template T
+ * @param {T[]} xs
+ * @param {number} n A positive integer, or Infinity (never fits, so the result is []).
+ * @returns {T[][]}
+ * @throws {TypeError} If xs is not an array.
+ * @throws {RangeError} If n is not a positive integer or Infinity.
+ */
+exports.windowed = (xs, n) => {
+  if (!Array.isArray(xs)) throw new TypeError('windowed: expected an array');
+  if (n !== Infinity && (!Number.isInteger(n) || n < 1)) throw new RangeError('windowed: n must be a positive integer');
+  const windows = [];
+  for (let i = 0; i + n <= xs.length; i++) windows.push(Array.from(xs.slice(i, i + n)));
+  return windows;
+};
