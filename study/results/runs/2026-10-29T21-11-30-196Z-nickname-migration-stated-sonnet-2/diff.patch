+/**
+ * Returns a new Date n calendar days after date (before it when n is negative), at the same local time of day:
+ * addDays(new Date(2024, 0, 31), 1) is 1 February 2024. Days are counted on the local calendar, not as 24
+ * hours, so across a daylight-saving change the clock time stays put even though the day is 23 or 25 hours
+ * long; if that clock time does not exist on the new day (it was skipped by the change) it moves forward by
+ * the skipped hour. Months, leap days and year ends are carried over correctly. date is not changed.
+ * @param {Date} date
+ * @param {number} n A whole number of days, positive, negative or 0.
+ * @returns {Date}
+ * @throws {TypeError} If date is not a Date or n is not a number.
+ * @throws {RangeError} If date is an Invalid Date, n is not an integer (a fraction, NaN or an infinity), or the
+ *   result is outside the range a Date can hold.
+ */
+exports.addDays = (date, n) => {
+  if (!(date instanceof Date)) throw new TypeError('addDays: date must be a Date');
+  if (typeof n !== 'number') throw new TypeError('addDays: n must be a number');
+  if (Number.isNaN(date.getTime())) throw new RangeError('addDays: date is invalid');
+  if (!Number.isInteger(n)) throw new RangeError('addDays: n must be an integer');
+  const result = new Date(date.getTime());
+  result.setDate(result.getDate() + n);
+  if (Number.isNaN(result.getTime())) throw new RangeError('addDays: result is out of range');
+  return result;
+};
+
+const MS_PER_DAY = 86400000;
+
+/**
+ * The number of whole days from date a to date b, counted on the UTC calendar and ignoring the time of day: only
+ * which UTC day each falls on matters, so 23:59 on one day to 00:01 on the next is 1 day and 00:00 to 23:59 on the
+ * same day is 0. The result is positive when b is later than a, negative when it is earlier (so it is
+ * b - a, and daysBetween(b, a) is its negative), and 0 for the same day. It does not depend on the local time zone
+ * or daylight saving, unlike addDays, which counts local days. Neither date is changed.
+ * @param {Date} a
+ * @param {Date} b
+ * @returns {number} A whole number of days.
+ * @throws {TypeError} If a or b is not a Date.
+ * @throws {RangeError} If a or b is an Invalid Date.
+ */
+exports.daysBetween = (a, b) => {
+  for (const [name, value] of [['a', a], ['b', b]]) {
+    if (!(value instanceof Date)) throw new TypeError(`daysBetween: ${name} must be a Date`);
+    if (Number.isNaN(value.getTime())) throw new RangeError(`daysBetween: ${name} is invalid`);
+  }
+  // Floor to the start of the UTC day (floor, not truncate, so dates before 1970 round the right way).
+  return Math.floor(b.getTime() / MS_PER_DAY) - Math.floor(a.getTime() / MS_PER_DAY);
+};
+
+/**
+ * True when date falls on a Saturday or Sunday in UTC, at any time of day: 00:00:00.000 UTC on a Saturday through
+ * 23:59:59.999 UTC on the Sunday. It looks at the UTC day only, so it does not depend on the local time zone, and
+ * a moment that is Saturday evening somewhere west of Greenwich but already Monday in UTC is not a weekend. The
+ * weekend is always Saturday and Sunday; it is not adjusted for regions that observe a different one.
+ * @param {Date} date
+ * @returns {boolean}
+ * @throws {TypeError} If date is not a Date.
+ * @throws {RangeError} If date is an Invalid Date.
+ */
+exports.isWeekend = (date) => {
+  if (!(date instanceof Date)) throw new TypeError('isWeekend: date must be a Date');
+  if (Number.isNaN(date.getTime())) throw new RangeError('isWeekend: date is invalid');
+  const day = date.getUTCDay(); // 0 is Sunday, 6 is Saturday
+  return day === 0 || day === 6;
+};
+
+/**
+ * A new Date at 00:00:00.000 UTC on the Monday of the week containing date, weeks running from Monday to Sunday
+ * (as in ISO 8601): the Monday itself gives that same day at midnight, and a Sunday gives the Monday six days
+ * before it. The week may begin in the previous month or year (startOfWeek of 1 January 2023, a Sunday, is 26
+ * December 2022). It works on the UTC day only, so it does not depend on the local time zone, and date is not
+ * changed. The Monday of the week of one of the first few days that a Date can hold would fall before the
+ * earliest Date, which is an error.
