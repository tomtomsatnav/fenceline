 const { formatMoney } = require('../utils/money.js');
 // A payment receipt line, e.g. "Paid £12.50 by card".
-exports.renderReceipt = (payment) => `Paid ${formatMoney(payment.amount, payment.currency)} by ${payment.method}`;
+// Yen has no minor unit, so scale up to minor units and drop the ".00" that formatMoney adds.
+const formatReceiptAmount = (amount, currency) =>
+  currency === 'JPY' ? formatMoney(amount * 100, currency).replace(/\.00$/, '') : formatMoney(amount, currency);
+exports.renderReceipt = (payment) => `Paid ${formatReceiptAmount(payment.amount, payment.currency)} by ${payment.method}`;